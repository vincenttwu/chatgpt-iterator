import { CONTRACT_ERROR_CODES, ContractError } from './errors.ts';

export const STABLE_ID_PREFIXES = {
  watchSession: 'ws',
  resourceObservation: 'obs',
  definition: 'def',
  pageFieldSnapshot: 'pfs',
  message: 'msg',
  request: 'req',
} as const;

export type StableIdKind = keyof typeof STABLE_ID_PREFIXES;
export type StableId<K extends StableIdKind = StableIdKind> =
  `${(typeof STABLE_ID_PREFIXES)[K]}_${string}`;

const UUID_V4_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;

function stableIdPattern(kind: StableIdKind): RegExp {
  return new RegExp(`^${STABLE_ID_PREFIXES[kind]}_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`);
}

/** Create a project-owned stable ID from a canonical UUID v4. */
export function createStableId<K extends StableIdKind>(
  kind: K,
  randomUuid: () => string = () => globalThis.crypto.randomUUID(),
): StableId<K> {
  const uuid = randomUuid();
  if (!UUID_V4_PATTERN.test(uuid)) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidId,
      `ID source did not return a canonical UUID v4 for ${kind}`,
      { kind },
    );
  }
  return `${STABLE_ID_PREFIXES[kind]}_${uuid}` as StableId<K>;
}

/** Test a project-owned ID without accepting aliases or non-canonical casing. */
export function isStableId<K extends StableIdKind>(
  value: unknown,
  kind: K,
): value is StableId<K> {
  return typeof value === 'string' && stableIdPattern(kind).test(value);
}

/** Require a canonical project-owned stable ID of the requested kind. */
export function requireStableId<K extends StableIdKind>(
  value: unknown,
  kind: K,
): StableId<K> {
  if (!isStableId(value, kind)) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidId,
      `Expected canonical ${kind} ID`,
      { kind },
    );
  }
  return value;
}
