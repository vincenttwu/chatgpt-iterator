<file path="src/page-fields/workspace-messages.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  createFailureResponse,
  createRequestEnvelope,
  createSuccessResponse,
  requireJsonObject,
  requireMessageEnvelope,
  requireRevision,
  requireStableId,
  toContractErrorPayload,
  type JsonObject,
  type Revision,
  type StableId,
  type RequestEnvelope,
  type ResponseEnvelope,
} from '../core/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from '../definitions/index.ts';
import type { ChromeRuntimePanelLike } from '../watch/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from './errors.ts';
import type { PageFieldMappingBody, PageFieldSelectorFamily } from './types.ts';
import { requirePageFieldMappingBody } from './validation.ts';
import {
  type DeletePageFieldMappingResult,
  type PageFieldHighlightInput,
  type PageFieldHighlightResult,
  type PageFieldPickInput,
  type PageFieldPickWorkspaceResult,
  type PageFieldTestResult,
  type PageFieldWorkspaceService,
  type PageFieldWorkspaceSnapshot,
  type SavePageFieldMappingInput,
  type SavePageFieldMappingResult,
} from './workspace.ts';

export const PAGE_FIELD_WORKSPACE_OPERATIONS = Object.freeze({
  snapshot: 'pagefields.workspace',
  save: 'pagefields.save',
  test: 'pagefields.test',
  highlight: 'pagefields.highlight',
  pick: 'pagefields.pick',
  clearAssist: 'pagefields.assist.clear',
  delete: 'pagefields.delete',
} as const);

export type PageFieldWorkspaceOperation = typeof PAGE_FIELD_WORKSPACE_OPERATIONS[keyof typeof PAGE_FIELD_WORKSPACE_OPERATIONS];

function requireOnlyKeys(payload: JsonObject, allowed: readonly string[]): void {
  const set = new Set(allowed);
  for (const key of Object.keys(payload)) {
    if (!set.has(key)) throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `Unsupported Page Field workspace field: ${key}`);
  }
}

function requireBoolean(value: unknown, label: string): boolean {
  if (typeof value !== 'boolean') throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be boolean`);
  return value;
}

function requireString(value: unknown, label: string): string {
  if (typeof value !== 'string') throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be a string`);
  return value;
}

function requireMode(value: unknown): 'create' | 'update' {
  if (value !== 'create' && value !== 'update') throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'mode must be create or update');
  return value;
}

function requireSaveInput(payload: JsonObject): SavePageFieldMappingInput {
  const mode = requireMode(payload.mode);
  return {
    mode,
    ...(payload.definitionId === undefined ? {} : { definitionId: requireStableId(payload.definitionId, 'definition') }),
    ...(payload.expectedRevision === undefined ? {} : { expectedRevision: requireRevision(payload.expectedRevision) }),
    name: requireString(payload.name, 'name'),
    enabled: requireBoolean(payload.enabled, 'enabled'),
    body: requirePageFieldMappingBody(payload.body),
  };
}

function requireHighlightInput(payload: JsonObject): PageFieldHighlightInput {
  if (!Number.isSafeInteger(payload.candidateIndex) || (payload.candidateIndex as number) < 0) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'candidateIndex must be a non-negative safe integer');
  }
  return {
    body: requirePageFieldMappingBody(payload.body),
    candidateIndex: payload.candidateIndex as number,
  };
}

function requirePickInput(payload: JsonObject): PageFieldPickInput {
  if (payload.family !== 'css' && payload.family !== 'xpath') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'family must be css or xpath');
  }
  return { family: payload.family as PageFieldSelectorFamily };
}

export class PageFieldWorkspaceMessageRouter {
  readonly #service: PageFieldWorkspaceService;

  constructor(service: PageFieldWorkspaceService) {
    this.#service = service;
  }

  async handle(message: unknown): Promise<ResponseEnvelope> {
    const envelope = requireMessageEnvelope(message);
    if (envelope.kind !== 'request') throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Page Field workspace accepts request envelopes only');
    const request: RequestEnvelope = envelope;
    try {
      const payload = requireJsonObject(request.payload);
      switch (request.operation) {
        case PAGE_FIELD_WORKSPACE_OPERATIONS.snapshot:
          requireOnlyKeys(payload, []);
          return createSuccessResponse(request, await this.#service.snapshot());
        case PAGE_FIELD_WORKSPACE_OPERATIONS.save:
          requireOnlyKeys(payload, ['mode', 'definitionId', 'expectedRevision', 'name', 'enabled', 'body']);
          return createSuccessResponse(request, await this.#service.save(requireSaveInput(payload)));
        case PAGE_FIELD_WORKSPACE_OPERATIONS.delete:
          requireOnlyKeys(payload, ['definitionId', 'expectedRevision']);
          return createSuccessResponse(request, await this.#service.delete({ definitionId: requireStableId(payload.definitionId, 'definition'), expectedRevision: requireRevision(payload.expectedRevision) }));
        case PAGE_FIELD_WORKSPACE_OPERATIONS.test:
          requireOnlyKeys(payload, ['body']);
          return createSuccessResponse(request, await this.#service.test(requirePageFieldMappingBody(payload.body)));
        case PAGE_FIELD_WORKSPACE_OPERATIONS.highlight:
          requireOnlyKeys(payload, ['body', 'candidateIndex']);
          return createSuccessResponse(request, await this.#service.highlight(requireHighlightInput(payload)));
        case PAGE_FIELD_WORKSPACE_OPERATIONS.pick:
          requireOnlyKeys(payload, ['family']);
          return createSuccessResponse(request, await this.#service.pick(requirePickInput(payload)));
        case PAGE_FIELD_WORKSPACE_OPERATIONS.clearAssist:
          requireOnlyKeys(payload, []);
          await this.#service.clearAssist();
          return createSuccessResponse(request, { cleared: true });
        default:
          throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, `Unknown Page Field workspace operation: ${request.operation}`);
      }
    } catch (error) {
      if (error instanceof DefinitionError) {
        return createFailureResponse(request, toContractErrorPayload(new ContractError(
          error.code === DEFINITION_ERROR_CODES.revisionConflict ? CONTRACT_ERROR_CODES.invalidRevision : CONTRACT_ERROR_CODES.invalidArgument,
          error.message,
          { domainCode: error.code },
        )));
      }
      if (error instanceof PageFieldError) {
        return createFailureResponse(request, toContractErrorPayload(new ContractError(
          error.code === PAGE_FIELD_ERROR_CODES.contextStale ? CONTRACT_ERROR_CODES.invalidRevision : CONTRACT_ERROR_CODES.invalidArgument,
          error.message,
          { domainCode: error.code },
        )));
      }
      return createFailureResponse(request, toContractErrorPayload(error));
    }
  }
}

async function responseValue<T>(runtime: ChromeRuntimePanelLike, operation: PageFieldWorkspaceOperation, payload: JsonObject): Promise<T> {
  const request = createRequestEnvelope({ operation, payload });
  const response = requireMessageEnvelope(await runtime.sendMessage(request));
  if (response.kind !== 'response' || response.requestId !== request.requestId || response.operation !== operation) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Page Field workspace response correlation failed');
  }
  if (!response.outcome.ok) throw new ContractError(response.outcome.error.code, response.outcome.error.message, response.outcome.error.details);
  return response.outcome.value as T;
}

export class PageFieldPanelClient {
  readonly #runtime: ChromeRuntimePanelLike;

  constructor(runtime: ChromeRuntimePanelLike) { this.#runtime = runtime; }

  snapshot(): Promise<PageFieldWorkspaceSnapshot> {
    return responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.snapshot, {});
  }

  save(input: SavePageFieldMappingInput): Promise<SavePageFieldMappingResult> {
    return responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.save, input);
  }

  delete(definitionId: StableId<'definition'>, expectedRevision: Revision): Promise<DeletePageFieldMappingResult> {
    return responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.delete, { definitionId, expectedRevision });
  }

  test(body: PageFieldMappingBody): Promise<PageFieldTestResult> {
    return responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.test, { body });
  }

  highlight(input: PageFieldHighlightInput): Promise<PageFieldHighlightResult> {
    return responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.highlight, input);
  }

  pick(input: PageFieldPickInput): Promise<PageFieldPickWorkspaceResult> {
    return responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.pick, input);
  }

  async clearAssist(): Promise<void> {
    await responseValue(this.#runtime, PAGE_FIELD_WORKSPACE_OPERATIONS.clearAssist, {});
  }
}
