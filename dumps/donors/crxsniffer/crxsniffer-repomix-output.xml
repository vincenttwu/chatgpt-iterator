import {
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  requireJsonObject,
  requireStableId,
  type JsonObject,
} from '../core/index.ts';
import { requireIsoTimestamp } from '../persistence/index.ts';
import {
  WATCH_ACTIVE_STATE_SCHEMA_VERSION,
  WATCH_LIFECYCLE_SCHEMA_VERSION,
  type ActiveWatchAuthority,
  type WatchLifecycleState,
  type WatchLifecycleValue,
  type WatchTerminationReason,
} from './types.ts';

const LIFECYCLE_STATES = new Set<WatchLifecycleState>(['watching', 'stopped', 'terminated']);
const TERMINATION_REASONS = new Set<WatchTerminationReason>([
  'user_stop',
  'target_closed',
  'permission_lost',
  'runtime_session_lost',
  'target_unsupported',
  'storage_failure',
]);

function requireTabId(value: unknown): number {
  if (!Number.isSafeInteger(value) || (value as number) < 0) {
    throw new TypeError('tabId must be a non-negative safe integer');
  }
  return value as number;
}

function requireLifecycleState(value: unknown): WatchLifecycleState {
  if (typeof value !== 'string' || !LIFECYCLE_STATES.has(value as WatchLifecycleState)) {
    throw new TypeError('invalid Watch lifecycle state');
  }
  return value as WatchLifecycleState;
}

function requireTerminationReason(value: unknown): WatchTerminationReason {
  if (typeof value !== 'string' || !TERMINATION_REASONS.has(value as WatchTerminationReason)) {
    throw new TypeError('invalid Watch termination reason');
  }
  return value as WatchTerminationReason;
}

export function requireActiveWatchAuthority(value: unknown): ActiveWatchAuthority {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (record.schemaVersion !== WATCH_ACTIVE_STATE_SCHEMA_VERSION) {
    throw new TypeError('unsupported active Watch state schema');
  }
  const normalized: ActiveWatchAuthority = {
    schemaVersion: WATCH_ACTIVE_STATE_SCHEMA_VERSION,
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    tabId: requireTabId(record.tabId),
    startedAt: requireIsoTimestamp(record.startedAt, 'startedAt'),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function requireWatchLifecycleValue(value: unknown): WatchLifecycleValue {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (record.schemaVersion !== WATCH_LIFECYCLE_SCHEMA_VERSION) {
    throw new TypeError('unsupported Watch lifecycle schema');
  }
  const state = requireLifecycleState(record.state);
  const endedAt = record.endedAt === undefined ? undefined : requireIsoTimestamp(record.endedAt, 'endedAt');
  const terminationReason = record.terminationReason === undefined
    ? undefined
    : requireTerminationReason(record.terminationReason);

  if (state === 'watching' && (endedAt !== undefined || terminationReason !== undefined)) {
    throw new TypeError('active Watch lifecycle cannot have terminal fields');
  }
  if (state !== 'watching' && (endedAt === undefined || terminationReason === undefined)) {
    throw new TypeError('terminal Watch lifecycle requires endedAt and terminationReason');
  }

  const normalized: WatchLifecycleValue = {
    schemaVersion: WATCH_LIFECYCLE_SCHEMA_VERSION,
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    tabId: requireTabId(record.tabId),
    state,
    startedAt: requireIsoTimestamp(record.startedAt, 'startedAt'),
    ...(endedAt === undefined ? {} : { endedAt }),
    ...(terminationReason === undefined ? {} : { terminationReason }),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function isSupportedWatchUrl(url: string | undefined): boolean {
  if (url === undefined) return false;
  try {
    const parsed = new URL(url);
    return parsed.protocol === 'http:' || parsed.protocol === 'https:';
  } catch {
    return false;
  }
}

export function lifecycleMetaKey(watchSessionId: string): string {
  return `watch.lifecycle.${watchSessionId}`;
}

export function asJsonObject(value: WatchLifecycleValue | ActiveWatchAuthority): JsonObject {
  return value;
}
