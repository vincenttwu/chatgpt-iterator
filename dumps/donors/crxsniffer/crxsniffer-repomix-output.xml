import {
  registerChromeWatchRuntime,
  type ChromeWatchRuntimeLike,
} from '../src/watch/index.ts';

export default defineBackground(() => {
  if (browser.sidePanel?.setPanelBehavior) {
    void browser.sidePanel.setPanelBehavior({ openPanelOnActionClick: true }).catch(() => {
      console.error('crsniffer: failed to configure Side Panel action behavior');
    });
  }

  const chromeApi = (globalThis as unknown as { chrome: ChromeWatchRuntimeLike }).chrome;
  void registerChromeWatchRuntime(chromeApi).catch((error) => {
    console.error('crsniffer Watch runtime initialization failed', error);
  });
});
