/** Frozen active-session context shown without exposing raw repository records. */
export interface ActiveWatchContext extends JsonObject {
  readonly watchSessionId: StableId<'watchSession'>;
  readonly watchDefinitionId: StableId<'definition'>;
  readonly watchRevision: Revision;
