schema_version: 1
policy_id: early-stage-fast-path
title: Early-Stage Fast Path
status: active

purpose:
  - Keep early product iterations draft-fast while preserving bounded Git history.
  - Spend validation and recovery effort in proportion to behavioral and durability risk.
  - Treat documentation/governance edits as proper iterations without ritual test or verification gates.
  - Keep Library publication lightweight by publishing only one slim portable final ZIP per proper iteration.

authority:
  path: agents/governance/fast-path.yaml
  precedence:
    - This policy overrides ceremony requirements in iteration.md, recovery.md, testing.md, and workflow/iteration.md when an iteration is eligible for fast path.
    - Product/architecture/security constraints still apply; fast path changes ceremony, not product semantics.

activation:
  default_mode: fast_path
  fast_path_default_while:
    project_version_lt: 0.1.0
  normal_flow_eligibility:
    any:
      - first_roadmap_complete: true
      - project_version_gte: 0.1.0
  normal_flow_default_when:
    any:
      - project_version_gte: 0.1.0
      - explicit_user_request: normal
      - release_or_public_promotion: true
      - risk_escalation_requires_normal: true
  interpretation:
    - Completing the first roadmap makes normal flow available; it does not automatically disable fast path before v0.1.0.
    - Before v0.1.0, use fast path unless the user requests normal flow or risk requires escalation.

proper_iteration:
  fast_path_minimum:
    - one bounded Git commit with an intentional message
    - roadmap/version pointer updated when the change consumes a product version or completes a roadmap step
    - user-facing docs updated only when behavior or usage materially changes
  explicitly_not_required:
    - result_plus_seal_commit_pair
    - iteration-manager create/changelog/seal/verify cycle
    - iterations/<slug>/manifest.yaml
    - iterations/<slug>/change.md
    - iterations/<slug>/changes.diff
    - generated root CHANGELOG update on every step
    - pre-change recovery snapshot or bundle
    - promoted recovery snapshot or deterministic ZIP on every step
    - cold extraction or deterministic ZIP reproduction
    - full governance regression suite
    - full product regression suite
    - release summary, handoff, checksum, delta, snapshot metadata, or commit-history sidecar files

risk_classes:
  docs_or_governance:
    examples:
      - markdown/docs wording
      - roadmap text or status pointer
      - governance policy or guide clarification
      - comments and non-executable examples
    required_checks: []
    forbidden_as_default:
      - product_tests
      - governance_tests
      - iteration_replay_verification
      - recovery_verification
      - cold_validation
    note: A docs/governance-only commit is a proper iteration with no tests or verification required.

  scaffold_or_build_config:
    examples:
      - package/toolchain pins
      - manifest/build configuration
      - empty/minimal application shell
      - generated build projection
    required_checks:
      - only the shortest executable build/config/type check that proves the scaffold is usable
    skipped_by_default:
      - broad regression
      - recovery seal
      - cold extraction

  focused_behavior:
    examples:
      - pure domain logic
      - one adapter behavior
      - one UI interaction
    required_checks:
      - focused tests for the changed behavior when such tests exist or are added by the step
    skipped_by_default:
      - unchanged full regression suites
      - recovery seal
      - cold extraction

  elevated_risk:
    triggers:
      - destructive_or_nontrivial_persistence_migration
      - permission_or_CSP_expansion
      - credential_or_secret_handling_change
      - public_protocol_or_schema_compatibility_change
      - irreversible_data_operation
      - security_boundary_change
    required_checks:
      - focused checks for the changed invariant
      - directly dependent regression checks
      - explicit rollback/recovery evidence when durable user state can be harmed
    escalation:
      normal_flow_if:
        - release_or_public_promotion
        - irreversible_migration_without_safe_rollback
        - user_requests_normal

checkpointing:
  phase_checkpoint:
    triggers:
      - roadmap_phase_complete
      - explicit_user_checkpoint_request
    requirements:
      - accumulated focused/regression checks appropriate to the phase
      - reconcile deferred docs/CHANGELOG/iteration summaries if useful
    recovery:
      local_snapshot_or_bundle: optional_by_risk
      deterministic_reproduction: false
      Library_upload: final_slim_zip_only
  roadmap_checkpoint:
    triggers:
      - roadmap_complete
      - pre_release_candidate
    requirements:
      - broader integrated validation appropriate to accumulated product state
      - reconcile roadmap/ADR/docs
    recovery:
      local_snapshot_or_bundle: recommended
      Library_upload: final_slim_zip_only
  release_checkpoint:
    triggers:
      - project_version_gte_0_1_0
      - release_or_public_promotion
    flow: normal

validation_policy:
  principle: validate_changed_risk_not_iteration_ceremony
  docs_only: none
  code_change: focused_first
  phase_boundary: accumulated_regression
  release_boundary: normal_full
  environment_unavailable: deferred_environment
  never_claim_unexecuted_check_as_passed: true

records_policy:
  default: no_new_managed_record
  create_or_revise_only_when:
    - architecture_or_contract_changes
    - roadmap_scope_or_order_changes_materially
    - a durable constraint/finding/deferral is genuinely introduced
  do_not_create_per_step_by_ritual:
    - AUDIT
    - FINDING
    - MATRIX
    - REFERENCE
    - DEFERRAL

research_policy:
  required_when:
    - correctness materially depends on current external APIs/tooling/standards
  skip_when:
    - change is docs-only and does not assert new external facts
    - accepted architecture already answers the question and implementation is not version-sensitive
  donor_check:
    only_when_material: true
    do_not_recopy_unchanged_donor: true

artifact_policy:
  workspace_artifacts:
    keep_in_repo:
      - source
      - tests required by changed behavior
      - roadmap/ADR/docs materially affected
      - reproducible dependency lockfile when dependencies exist
  sidecars:
    default: none
  recovery:
    per_iteration: slim_portable_zip_for_library_transport
    snapshots_and_full_recovery: phase_or_roadmap_checkpoint_only
    portable_bundle_excludes:
      - dumps/donors/**/*.zip
      - iterations/**/changes.diff
    keep_reference_metadata_for_excluded_evidence: true
    compression: deflate

library_policy:
  output_publication:
    required: true
    acceptance_gate: false
    fast_path_default: upload_final_slim_zip
    per_iteration:
      upload: true
      artifacts:
        - final_portable_zip
      exclude_sidecars: true
      exclude_pre_change_bundle: true
      exclude_snapshot_upload: true
    failure_disposition: deferred_environment
  input_lookup:
    allowed_for_material_donor_or_prior_artifact_checks: true
  principle: Publish the one slim final ZIP each iteration, but Library availability must never invalidate an otherwise valid fast-path iteration.

changelog_policy:
  per_fast_iteration: false
  update_when:
    - phase_checkpoint
    - roadmap_checkpoint
    - release_checkpoint
    - user_facing_change_needs_immediate_note

recovery_policy:
  git_is_primary_early_stage_recovery: true
  pre_snapshot_per_iteration: false
  promoted_bundle_per_iteration: slim_portable_zip_for_library
  checkpoint_bundle_when_material: true

exit_conditions:
  fast_path_stops_being_default:
    - project_version_gte: 0.1.0
  fast_path_can_be_disabled_earlier_by:
    - explicit_user_request
    - risk_escalation
</file>

<file path="agents/governance/initialization.md">
# Initialization

This document is the sole governance authority for converting the reusable starter into a new project identity. Initialization is a one-time **starter → project** transition; it is not implementation bootstrapping, dependency setup, recovery sealing, or an ordinary development iteration.

## Purpose

Use initialization when a repository is first created from this starter and must stop identifying operationally as the starter itself.

```bash
python3 agents/scripts/initialization-manager.py status
python3 agents/scripts/initialization-manager.py init --project my-project --version v0.1.0
python3 agents/scripts/initialization-manager.py validate
```

`--project` is a lowercase path-safe slug. `--version` is explicit and uses `vN.N.N`; the manager does not impose `v0.1.0` as a universal initial version. `--title` may be supplied for the README display title.

## Ownership boundary

`initialization-manager.py` owns the one-time **starter identity → project identity** transition.

- `workspace-manager.py` owns complete recoverable project **state** after identity exists.
- `iteration-manager.py` owns reconstructable project **transitions** after initialization.
- `record-manager.py` owns governed record allocation.
- `knowledge-manager.py` owns governed knowledge allocation.

Initialization does not create Git commits, branches, tags, recovery snapshots, or project implementation.

## Field-aware mutation

Initialization is deliberately **not** a global string replacement operation. The manager mutates only declared project-owned identity surfaces:

| Surface | Initialization action |
| --- | --- |
| Root JSON/YAML manifests | Assign project/version, clear predecessor/release artifacts, record initialization provenance. |
| `README.md` | Replace the managed identity block and root display title. |
| `CHANGELOG.md` | Reset the bounded generated project changelog view. |
| `iterations/` | Remove concrete starter iteration ledgers while preserving `iterations/README.md`. |

All other files are preserved byte-for-byte by initialization. Starter-like text in examples, tests, historical reference material, or user content is not rewritten merely because it matches the old project name.

## One-shot state

The root manifest carries `initialization.state`:

- `starter` — initialization is permitted.
- `initialized` — initialization has already completed and `init` must refuse to run again.

A project must never move from `initialized` back to `starter` as part of normal development.

## Provenance

Initialization preserves source provenance rather than pretending the new repository appeared from nowhere. The initialized root manifest records:

```yaml
initialization:
  state: initialized
  source:
    project: <starter-project>
    version: <starter-version>
    tree_sha256: <recovery-safe-source-tree-digest>
  target:
    project: <new-project>
    version: <initial-project-version>
  initialized_at: <UTC timestamp>
```

The managed README identity block also names the starter source. These provenance references are intentionally retained and are not operational project identity.

## History reset

Starter release history is not project history. Initialization therefore clears concrete starter `iterations/*` ledgers and resets root `CHANGELOG.md` to an empty generated project view. Governance, guides and their issued IDs, templates, reusable knowledge examples, managers, tests, workflows, and user-documentation scaffolding remain.

## Directory naming

The manager does not rename the directory containing itself. After successful initialization it prints a recommended workspace name such as:

```text
my-project.v0.1.0
```

Renaming or moving the directory is an external filesystem action and must not be hidden inside identity mutation. Repository managers must treat the root manifest project/version as authoritative after initialization; the workspace directory suffix is only a fallback when no usable manifest identity exists. Therefore a valid initialized project remains operational even when its containing directory still carries the starter name/version.

## Test-state isolation

Initialization changes the legitimate lifecycle state of the live repository. The bundled governance regression suite must therefore remain executable in both an untouched starter and an initialized project.

Tests that specifically exercise the `starter → initialized` transition must create an isolated synthetic starter-state fixture. When the live root is already initialized, that fixture derives the starter project/version identity from `initialization.source` provenance and sets `initialization.state: starter` only inside the disposable fixture.

The live repository must never be reverted from `initialized` to `starter` merely to satisfy tests. Re-initialization of the live project remains an expected refusal. See `TEST-0007` in `agents/guides/testing.md`.

## Validation

`initialization-manager.py validate` checks that:

- JSON and YAML project/version/initialization state agree;
- project and version identities are syntactically valid;
- initialized workspaces retain source project/version/tree provenance;
- initialized workspaces retain their original initialization target even as the current project version later advances;
- the README managed identity block remains present.

Validation is mechanical. It does not certify application correctness or promote a recovery state.
</file>

<file path="agents/governance/iteration.md">
# Iteration Ledger

This document defines the repository contract for minimal, reconstructable implementation iterations. It governs the `iterations/` ledger and `agents/scripts/iteration-manager.py`.

## Authority boundary

This file is the sole repository governance authority for the `iterations/` ledger. Use the singular path `agents/governance/iteration.md`; do not create a competing `iterations.md` contract. The ledger owns reconstructable committed transitions, not complete recovery snapshots. Complete external workspace states are governed by `agents/governance/recovery.md`.

## Fast-path override

When `agents/governance/fast-path.yaml` applies, the Git-backed sealed iteration ledger described below is optional ceremony rather than a per-version requirement. A bounded single Git commit plus the required roadmap/version pointer can constitute a proper fast-path iteration. Result+seal pairs, `changes.diff`, generated root changelog updates, and replay verification are reserved for normal/checkpoint flow unless explicitly requested.

## Purpose

An iteration records **how one committed workspace state became another** without duplicating the workspace. Git remains the source-control system; the iteration ledger is a compact governed history that can validate and reconstruct the effective state transition.

Each iteration stream has an independent semantic version:

```text
iterations/{slug}.v{major}.{minor}.{patch}/
```

Examples:

```text
iterations/testing.v0.0.1/
iterations/testing.v0.1.0/
iterations/storage.v0.0.1/
```

The semantic version belongs to the slug's iteration stream. It is independent from the package or project release version.

## Minimal artifact set

A draft iteration contains two files:

```text
iterations/{slug}.vN.N.N/
├── manifest.yaml
└── change.md
```

A sealed iteration adds the mechanically generated delta:

```text
iterations/{slug}.vN.N.N/
├── manifest.yaml
├── change.md
└── changes.diff
```

Do not add summary, handoff, checkpoint, or evidence files by default. Add another artifact only when it preserves information that cannot be represented cleanly by the manifest, change record, diff, or an existing governed record type.

## Manifest authority

`manifest.yaml` is the iteration identity and lineage record. It declares:

- slug, semantic version, status, summary, and timestamps;
- optional parent iteration identity within the same logical history;
- exact Git base and result commit revisions;
- the `change.md` path and sealed checksum;
- `changes.diff` format, scope, exclusion contract, and checksum;
- generated changelog path, source, fixed retention window, and sealed checksum;
- changelog synchronization guard state;
- verification status and timestamp.

The template is `agents/templates/ITERATION.yaml`. The manager renders concrete manifests mechanically.

## Change record

`change.md` is the durable human-readable description of the iteration. It uses YAML frontmatter plus a small Markdown body. The canonical shape is `agents/templates/CHANGE.md`.

The frontmatter binds the record to exactly one `{slug}.vN.N.N` identity and records a timestamp plus concise summary. The body starts with `# Change` and contains at least:

```text
## Changes
## Validation
```

`change.md` is the complete changelog source of truth for that iteration. Once the iteration is sealed, the manifest stores its SHA-256 and `change.md` MUST NOT be rewritten silently. Correcting a sealed historical record requires an explicit governed correction rather than mutating provenance.

## Bounded root changelog

The repository-root `CHANGELOG.md` is a **generated convenience view**, not the complete history store.

The complete history remains under:

```text
iterations/*/change.md
```

The manager renders root `CHANGELOG.md` from the latest **20** eligible iteration change records. This fixed window keeps the root document small while preserving unlimited history in the ledger.

When a target draft is supplied, that target is always retained in the 20-entry preparation view; the remaining slots are filled by the newest sealed records. Without a target, the view is simply the newest 20 sealed records.

Eligibility is:

- every sealed iteration; plus
- the one target draft explicitly passed to the `changelog` command while preparing it for sealing.

Other drafts are excluded so unfinished work cannot leak into the generated changelog.

Generate the root view for the active draft with:

```bash
python3 agents/scripts/iteration-manager.py changelog testing v0.1.0
```

Regenerate from sealed history only with:

```bash
python3 agents/scripts/iteration-manager.py changelog
```

The renderer orders records by `change.recorded_at`, then iteration identity, newest first. It never deletes or rewrites the underlying `change.md` history merely because an entry falls outside the latest-20 window.

## Changelog seal guard

Before sealing, the target draft's `manifest.yaml`, `change.md`, implementation changes, and generated root `CHANGELOG.md` MUST all be committed in the declared result revision.

`seal` verifies that:

1. the target `change.md` is committed and byte-identical to the working ledger copy;
2. root `CHANGELOG.md` changed from the base revision;
3. the committed root changelog is byte-identical to a deterministic render of all sealed change records plus the target draft, capped at 20 entries;
4. the manifest records the resulting change and changelog SHA-256 values when sealing succeeds.

This is stronger than merely checking that somebody remembered to touch `CHANGELOG.md`: the committed file must actually be the generated view of the governed iteration records.

## Diff contract

`changes.diff` is generated from committed Git objects using an applyable full-index binary-capable diff. The manager uses the equivalent of:

```bash
git diff --binary --full-index --find-renames --no-ext-diff <base>..<result> -- . ':(exclude)iterations/**'
```

The ledger excludes `iterations/**` from the workspace projection. This avoids a self-referential artifact: the manifest, change record, and diff describe the state transition but are not themselves included in the transition they hash and replay.

The generated root `CHANGELOG.md` **is** part of the workspace projection and therefore appears in `changes.diff` when changed.

The invariant is:

```text
base workspace projection
        +
changes.diff
        =
result workspace projection
```

A sealed iteration MUST have a non-empty workspace delta.

## Transition hygiene

Generated runtime/cache state is not governed implementation history. `changes.diff` MUST NOT contain transient paths such as `__pycache__/`, `*.pyc`, `*.pyo`, `.pytest_cache/`, `.mypy_cache/`, `.ruff_cache/`, `.venv/`, or `node_modules/`. The sealed result revision must not track those paths either.

The manager rejects a polluted transition rather than silently excluding cache files from the diff, because silent exclusion would make the committed result and replay projection disagree. If local Git history accidentally captured generated cache state, rebuild or reset the local transition from the last clean base and rerun validation with bytecode/cache generation disabled before sealing. Do not preserve cache churn merely to make the iteration pass.

The root `.gitignore` provides preventive defaults, but ignore rules are not proof: already tracked files remain tracked. Seal and verify therefore enforce the hygiene contract directly against committed Git state.

## Git state contract

Sealing operates only on committed Git revisions. Draft work may occur in a dirty working tree, but `seal` resolves both the base and result to commit objects.

The iteration manager MUST NOT create commits, rewrite branches, merge, rebase, tag, or otherwise make source-control acceptance decisions. It may inspect revisions, render the bounded changelog, generate diffs, validate manifests/change records, and replay/compare the staged Git index used for verification.

## Verification

Verification MUST prove all of the following:

1. the manifest identity matches the directory name;
2. `change.md` is structurally valid and matches its sealed checksum;
3. the result revision contains the same target `change.md`;
4. the result revision's `CHANGELOG.md` is the deterministic latest-20 render for sealed history plus that target iteration;
5. the changelog checksum matches the manifest;
6. the diff checksum matches the manifest;
7. `changes.diff` contains no `iterations/` paths;
8. the diff applies cleanly to the base revision;
9. the resulting Git index projection matches the declared result revision exactly, including tracked path content and file modes;
10. the manifest records a passed verification state.

`git apply --check` is a preflight; the manager then applies the patch to an isolated temporary index and compares it with the result tree. The active working tree is not modified by verification.

## Commands

Create a draft and its `change.md`:

```bash
python3 agents/scripts/iteration-manager.py create testing v0.0.1 --base HEAD --summary "Add test-layer guidance"
```

Edit `change.md`, implement and validate the change, then render the bounded root changelog:

```bash
python3 agents/scripts/iteration-manager.py changelog testing v0.0.1
```

Commit the implementation, draft iteration ledger files, and generated `CHANGELOG.md`, then seal:

```bash
python3 agents/scripts/iteration-manager.py seal testing v0.0.1 --result HEAD
```

Validate all ledger structure:

```bash
python3 agents/scripts/iteration-manager.py validate
```

Re-verify a sealed transition:

```bash
python3 agents/scripts/iteration-manager.py verify testing v0.0.1
```

## Lineage and reconstruction

A slug forms a semantic iteration stream. When no explicit parent is supplied, the manager may infer the highest lower semantic version already present for the same slug. Parent identity is descriptive lineage; replay authority comes from the exact `base_revision` and `result_revision` commit IDs.

Because the diff is stored independently of application language or framework, the mechanism works for mixed repositories and text or binary tracked files. It reconstructs the governed workspace transition, not necessarily every original intermediate Git commit or merge edge.

## Relation to other artifacts

- `change.md` is the durable human description of one iteration.
- `CHANGELOG.md` is the generated latest-20 view of iteration change records.
- `iteration_manifest.*` at repository root describes the packaged starter/release iteration; it is separate from slug-scoped entries under `iterations/`.
- `agents/records/` preserves decisions, plans, evidence, constraints, and audits when those need stable IDs.
- `agents/guides/` holds current known-scope engineering authority.
- `iterations/` preserves reproducible implementation deltas, human change history, and lineage.

Do not use an iteration manifest or `change.md` as a substitute for an ADR, roadmap, audit, finding, or guide rule when that artifact has a distinct durable role.
</file>

