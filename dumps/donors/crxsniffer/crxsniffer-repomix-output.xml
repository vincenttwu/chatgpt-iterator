<file path="src/control-plane/messages.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  createFailureResponse,
  createSuccessResponse,
  freezeJsonValue,
  requireMessageEnvelope,
  requireStableId,
  toContractErrorPayload,
  type JsonObject,
  type RequestEnvelope,
  type ResponseEnvelope,
} from '../core/index.ts';
import {
  RESOURCE_HISTORY_SESSION_LIMIT,
  ResourceHistoryService,
  requireResourceHistoryQuery,
} from '../resources/index.ts';
import { ControlPlaneProjector } from './projector.ts';
import { SettingsService, requireSettingsClearScope, requireSettingsPreferences } from './settings.ts';
import { CONTROL_PLANE_OPERATIONS, CONTROL_PLANE_SCHEMA_VERSION } from './types.ts';
import { requireOptionalTabId, requireRequestSequence } from './validation.ts';

function requireOnlyKeys(payload: JsonObject, allowed: readonly string[]): void {
  const set = new Set(allowed);
  for (const key of Object.keys(payload)) {
    if (!set.has(key)) {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidArgument,
        `unknown control-plane payload field: ${key}`,
        { field: key },
      );
    }
  }
}

function requireOptionalLimit(value: unknown): number {
  if (value === undefined) return RESOURCE_HISTORY_SESSION_LIMIT;
  if (!Number.isSafeInteger(value) || (value as number) < 1 || (value as number) > RESOURCE_HISTORY_SESSION_LIMIT) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidArgument,
      `resource session limit must be 1..${RESOURCE_HISTORY_SESSION_LIMIT}`,
    );
  }
  return value as number;
}

export class ControlPlaneMessageRouter {
  readonly #projector: ControlPlaneProjector;
  readonly #history: ResourceHistoryService | undefined;
  readonly #settings: SettingsService | undefined;

  constructor(projector: ControlPlaneProjector, history?: ResourceHistoryService, settings?: SettingsService) {
    this.#projector = projector;
    this.#history = history;
    this.#settings = settings;
  }

  async handle(value: unknown): Promise<ResponseEnvelope> {
    const envelope = requireMessageEnvelope(value);
    if (envelope.kind !== 'request') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control plane accepts request envelopes only');
    }
    try {
      return await this.#handleRequest(envelope);
    } catch (error) {
      return createFailureResponse(envelope, toContractErrorPayload(error));
    }
  }

  #requireSettings(): SettingsService {
    if (this.#settings === undefined) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'settings are unavailable');
    }
    return this.#settings;
  }

  #requireHistory(): ResourceHistoryService {
    if (this.#history === undefined) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'resource history is unavailable');
    }
    return this.#history;
  }

  async #handleRequest(request: RequestEnvelope): Promise<ResponseEnvelope> {
    switch (request.operation) {
      case CONTROL_PLANE_OPERATIONS.hydrate: {
        requireOnlyKeys(request.payload, ['requestSequence', 'tabId']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        const tabId = requireOptionalTabId(request.payload.tabId);
        return createSuccessResponse(request, await this.#projector.hydrate({
          requestSequence,
          ...(tabId === undefined ? {} : { tabId }),
        }));
      }
      case CONTROL_PLANE_OPERATIONS.resourceSessions: {
        requireOnlyKeys(request.payload, ['requestSequence', 'limit']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        const sessions = await this.#requireHistory().sessions(requireOptionalLimit(request.payload.limit));
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          sessions,
        }));
      }
      case CONTROL_PLANE_OPERATIONS.resourcePage: {
        requireOnlyKeys(request.payload, ['requestSequence', 'query']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        const page = await this.#requireHistory().page(requireResourceHistoryQuery(request.payload.query));
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          page,
        }));
      }
      case CONTROL_PLANE_OPERATIONS.resourceDetail: {
        requireOnlyKeys(request.payload, ['requestSequence', 'observationId']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        const detail = await this.#requireHistory().detail(requireStableId(request.payload.observationId, 'resourceObservation'));
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          found: detail !== undefined,
          ...(detail === undefined ? {} : { detail }),
        }));
      }
      case CONTROL_PLANE_OPERATIONS.settings: {
        requireOnlyKeys(request.payload, ['requestSequence']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          settings: await this.#requireSettings().snapshot(),
        }));
      }
      case CONTROL_PLANE_OPERATIONS.settingsSave: {
        requireOnlyKeys(request.payload, ['requestSequence', 'preferences']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          settings: await this.#requireSettings().savePreferences(requireSettingsPreferences(request.payload.preferences)),
        }));
      }
      case CONTROL_PLANE_OPERATIONS.settingsMaintain: {
        requireOnlyKeys(request.payload, ['requestSequence']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          settings: await this.#requireSettings().maintain(),
        }));
      }
      case CONTROL_PLANE_OPERATIONS.settingsClear: {
        requireOnlyKeys(request.payload, ['requestSequence', 'scope', 'confirmation']);
        const requestSequence = requireRequestSequence(request.payload.requestSequence);
        const scope = requireSettingsClearScope(request.payload.scope);
        const expectedConfirmation = scope === 'history' ? 'clear_history' : 'clear_all_local_data';
        if (request.payload.confirmation !== expectedConfirmation) {
          throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'Settings Clear requires explicit scope confirmation');
        }
        const result = await this.#requireSettings().clear(scope);
        return createSuccessResponse(request, freezeJsonValue({
          schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
          requestSequence,
          settings: result.settings,
          clear: result.clear,
        }));
      }
      default:
        throw new ContractError(
          CONTRACT_ERROR_CODES.invalidArgument,
          `unsupported control-plane operation: ${request.operation}`,
          { operation: request.operation },
        );
    }
  }
}
</file>

<file path="src/control-plane/panel-client.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  createRequestEnvelope,
  requireMessageEnvelope,
  type StableId,
} from '../core/index.ts';
import {
  CONTROL_PLANE_OPERATIONS,
  CONTROL_PLANE_PORT_NAME,
  type ControlPlaneInvalidationHint,
  type HydrationOutcome,
  type PanelConnectionState,
  type ResourceDetailOutcome,
  type ResourcePageInput,
  type ResourcePageOutcome,
  type ResourceSessionsOutcome,
  type SettingsClearInput,
  type SettingsOutcome,
  type SettingsSaveInput,
} from './types.ts';
import {
  requireControlPlaneInvalidationHint,
  requireControlPlaneSnapshot,
  requireResourceDetailResult,
  requireResourcePageResult,
  requireResourceSessionsResult,
  requireSettingsResult,
} from './validation.ts';

export interface ChromeRuntimePortPanelLike {
  readonly name: string;
  postMessage(message: unknown): void;
  disconnect(): void;
  readonly onMessage: {
    addListener(listener: (message: unknown) => void): void;
  };
  readonly onDisconnect: {
    addListener(listener: () => void): void;
  };
}

export interface ChromeRuntimeControlPanelLike {
  sendMessage(message: unknown): Promise<unknown>;
  connect(connectInfo: { name: string }): ChromeRuntimePortPanelLike;
}

export interface ChromeTabsControlPanelLike {
  query(queryInfo: { active: boolean; currentWindow: boolean }): Promise<readonly { id?: number }[]>;
  readonly onActivated?: {
    addListener(listener: (activeInfo: { tabId: number; windowId: number }) => void): void;
    removeListener?(listener: (activeInfo: { tabId: number; windowId: number }) => void): void;
  };
}

export interface ChromeSidePanelControlLike {
  readonly runtime: ChromeRuntimeControlPanelLike;
  readonly tabs: ChromeTabsControlPanelLike;
}

export interface PanelConnectionCallbacks {
  readonly onInvalidation: (hint: ControlPlaneInvalidationHint) => void;
  readonly onStateChange?: (state: PanelConnectionState) => void;
}

export type ReconnectScheduler = (callback: () => void) => void;

const defaultReconnectScheduler: ReconnectScheduler = (callback) => {
  globalThis.setTimeout(callback, 250);
};

/** Reconnectable Port wrapper used only to learn that authoritative state may have changed. */
export class SidePanelConnection {
  readonly #runtime: ChromeRuntimeControlPanelLike;
  readonly #callbacks: PanelConnectionCallbacks;
  readonly #scheduleReconnect: ReconnectScheduler;
  #port: ChromeRuntimePortPanelLike | undefined;
  #stopped = false;
  #reconnectPending = false;
  #generation = 0;

  constructor(
    runtime: ChromeRuntimeControlPanelLike,
    callbacks: PanelConnectionCallbacks,
    scheduleReconnect: ReconnectScheduler = defaultReconnectScheduler,
  ) {
    this.#runtime = runtime;
    this.#callbacks = callbacks;
    this.#scheduleReconnect = scheduleReconnect;
  }

  start(): void {
    if (this.#stopped) return;
    this.#open('connecting');
  }

  stop(): void {
    if (this.#stopped) return;
    this.#stopped = true;
    this.#generation += 1;
    this.#callbacks.onStateChange?.('stopped');
    try {
      this.#port?.disconnect();
    } catch {
      // Port teardown is best effort; it is never authority.
    }
    this.#port = undefined;
  }

  #open(initialState: 'connecting' | 'reconnecting'): void {
    if (this.#stopped) return;
    this.#callbacks.onStateChange?.(initialState);
    const generation = ++this.#generation;
    try {
      const port = this.#runtime.connect({ name: CONTROL_PLANE_PORT_NAME });
      this.#port = port;
      this.#reconnectPending = false;
      port.onMessage.addListener((message) => {
        if (this.#stopped || generation !== this.#generation) return;
        try {
          this.#callbacks.onInvalidation(requireControlPlaneInvalidationHint(message));
        } catch {
          // Malformed latency hints are ignored; one-shot hydration remains correctness authority.
        }
      });
      port.onDisconnect.addListener(() => {
        if (this.#stopped || generation !== this.#generation) return;
        this.#port = undefined;
        this.#schedule();
      });
      this.#callbacks.onStateChange?.('connected');
    } catch {
      this.#schedule();
    }
  }

  #schedule(): void {
    if (this.#stopped || this.#reconnectPending) return;
    this.#reconnectPending = true;
    this.#callbacks.onStateChange?.('reconnecting');
    this.#scheduleReconnect(() => {
      this.#reconnectPending = false;
      if (!this.#stopped) this.#open('reconnecting');
    });
  }
}

/** Bounded Side Panel query client with independent out-of-order response rejection per query lane. */
export class SidePanelControlClient {
  readonly #chrome: ChromeSidePanelControlLike;
  #latestHydrateIssued = 0;
  #latestResourceSessionsIssued = 0;
  #latestResourcePageIssued = 0;
  #latestResourceDetailIssued = 0;
  #latestSettingsIssued = 0;

  constructor(chromeApi: ChromeSidePanelControlLike) {
    this.#chrome = chromeApi;
  }

  async activeTabId(): Promise<number | undefined> {
    const [tab] = await this.#chrome.tabs.query({ active: true, currentWindow: true });
    return typeof tab?.id === 'number' ? tab.id : undefined;
  }

  async hydrate(): Promise<HydrationOutcome> {
    const requestSequence = ++this.#latestHydrateIssued;
    const tabId = await this.activeTabId();
    const request = createRequestEnvelope({
      operation: CONTROL_PLANE_OPERATIONS.hydrate,
      payload: {
        requestSequence,
        ...(tabId === undefined ? {} : { tabId }),
      },
    });
    const response = requireMessageEnvelope(await this.#chrome.runtime.sendMessage(request));
    this.#requireCorrelatedSuccess(response, request.requestId, request.operation);
    if (response.kind !== 'response' || !response.outcome.ok) throw new Error('unreachable');
    const snapshot = requireControlPlaneSnapshot(response.outcome.value);
    if (snapshot.requestSequence !== requestSequence) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control-plane request sequence mismatch');
    }
    if (requestSequence !== this.#latestHydrateIssued) return { applied: false };
    return { applied: true, snapshot };
  }

  async resourceSessions(limit?: number): Promise<ResourceSessionsOutcome> {
    const requestSequence = ++this.#latestResourceSessionsIssued;
    const request = createRequestEnvelope({
      operation: CONTROL_PLANE_OPERATIONS.resourceSessions,
      payload: { requestSequence, ...(limit === undefined ? {} : { limit }) },
    });
    const response = requireMessageEnvelope(await this.#chrome.runtime.sendMessage(request));
    this.#requireCorrelatedSuccess(response, request.requestId, request.operation);
    if (response.kind !== 'response' || !response.outcome.ok) throw new Error('unreachable');
    const result = requireResourceSessionsResult(response.outcome.value);
    if (result.requestSequence !== requestSequence) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'resource session request sequence mismatch');
    }
    if (requestSequence !== this.#latestResourceSessionsIssued) return { applied: false };
    return { applied: true, sessions: result.sessions };
  }

  async resourcePage(query: ResourcePageInput): Promise<ResourcePageOutcome> {
    const requestSequence = ++this.#latestResourcePageIssued;
    const request = createRequestEnvelope({
      operation: CONTROL_PLANE_OPERATIONS.resourcePage,
      payload: { requestSequence, query },
    });
    const response = requireMessageEnvelope(await this.#chrome.runtime.sendMessage(request));
    this.#requireCorrelatedSuccess(response, request.requestId, request.operation);
    if (response.kind !== 'response' || !response.outcome.ok) throw new Error('unreachable');
    const result = requireResourcePageResult(response.outcome.value);
    if (result.requestSequence !== requestSequence) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'resource page request sequence mismatch');
    }
    if (requestSequence !== this.#latestResourcePageIssued) return { applied: false };
    return { applied: true, page: result.page };
  }

  async resourceDetail(observationId: StableId<'resourceObservation'>): Promise<ResourceDetailOutcome> {
    const requestSequence = ++this.#latestResourceDetailIssued;
    const request = createRequestEnvelope({
      operation: CONTROL_PLANE_OPERATIONS.resourceDetail,
      payload: { requestSequence, observationId },
    });
    const response = requireMessageEnvelope(await this.#chrome.runtime.sendMessage(request));
    this.#requireCorrelatedSuccess(response, request.requestId, request.operation);
    if (response.kind !== 'response' || !response.outcome.ok) throw new Error('unreachable');
    const result = requireResourceDetailResult(response.outcome.value);
    if (result.requestSequence !== requestSequence) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'resource detail request sequence mismatch');
    }
    if (requestSequence !== this.#latestResourceDetailIssued) return { applied: false };
    return {
      applied: true,
      found: result.found,
      ...(result.detail === undefined ? {} : { detail: result.detail }),
    };
  }

  async settings(): Promise<SettingsOutcome> {
    return this.#settingsRequest(CONTROL_PLANE_OPERATIONS.settings, {});
  }

  async saveSettings(preferences: SettingsSaveInput): Promise<SettingsOutcome> {
    return this.#settingsRequest(CONTROL_PLANE_OPERATIONS.settingsSave, { preferences });
  }

  async maintainSettings(): Promise<SettingsOutcome> {
    return this.#settingsRequest(CONTROL_PLANE_OPERATIONS.settingsMaintain, {});
  }

  async clearSettings(scope: SettingsClearInput): Promise<SettingsOutcome> {
    return this.#settingsRequest(CONTROL_PLANE_OPERATIONS.settingsClear, {
      scope,
      confirmation: scope === 'history' ? 'clear_history' : 'clear_all_local_data',
    });
  }

  async #settingsRequest(operation: string, payload: Record<string, unknown>): Promise<SettingsOutcome> {
    const requestSequence = ++this.#latestSettingsIssued;
    const request = createRequestEnvelope({
      operation,
      payload: { requestSequence, ...payload },
    });
    const response = requireMessageEnvelope(await this.#chrome.runtime.sendMessage(request));
    this.#requireCorrelatedSuccess(response, request.requestId, request.operation);
    if (response.kind !== 'response' || !response.outcome.ok) throw new Error('unreachable');
    const result = requireSettingsResult(response.outcome.value);
    if (result.requestSequence !== requestSequence) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'settings request sequence mismatch');
    }
    if (requestSequence !== this.#latestSettingsIssued) return { applied: false };
    return {
      applied: true,
      settings: result.settings,
      ...(result.clear === undefined ? {} : { clear: result.clear }),
    };
  }

  #requireCorrelatedSuccess(
    response: ReturnType<typeof requireMessageEnvelope>,
    requestId: string,
    operation: string,
  ): void {
    if (
      response.kind !== 'response'
      || response.requestId !== requestId
      || response.operation !== operation
    ) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control-plane response correlation failed');
    }
    if (!response.outcome.ok) {
      throw new ContractError(
        response.outcome.error.code,
        response.outcome.error.message,
        response.outcome.error.details,
      );
    }
  }

  connect(
    callbacks: PanelConnectionCallbacks,
    scheduleReconnect?: ReconnectScheduler,
  ): SidePanelConnection {
    return new SidePanelConnection(this.#chrome.runtime, callbacks, scheduleReconnect);
  }

  onActiveTabChanged(listener: () => void): () => void {
    const event = this.#chrome.tabs.onActivated;
    if (event === undefined) return () => undefined;
    const wrapped = () => listener();
    event.addListener(wrapped);
    return () => event.removeListener?.(wrapped);
  }
}
</file>

<file path="src/control-plane/port-hub.ts">
import { freezeJsonValue } from '../core/index.ts';
import {
  CONTROL_PLANE_PORT_NAME,
  CONTROL_PLANE_SCHEMA_VERSION,
  type ControlPlaneInvalidationHint,
  type ControlPlaneInvalidationReason,
} from './types.ts';

export interface ChromeRuntimePortServerLike {
  readonly name: string;
  readonly sender?: unknown;
  disconnect?(): void;
  postMessage(message: unknown): void;
  readonly onDisconnect: {
    addListener(listener: () => void): void;
  };
}

/** Ephemeral latency optimization. Ports and its sequence are never correctness authority. */
export class ControlPlanePortHub {
  readonly #ports = new Set<ChromeRuntimePortServerLike>();
  #sequence = 0;

  attach(port: ChromeRuntimePortServerLike): boolean {
    if (port.name !== CONTROL_PLANE_PORT_NAME) return false;
    this.#ports.add(port);
    port.onDisconnect.addListener(() => this.#ports.delete(port));
    this.#send(port, 'connected');
    return true;
  }

  broadcast(reason: Exclude<ControlPlaneInvalidationReason, 'connected'>): void {
    for (const port of [...this.#ports]) {
      try {
        this.#send(port, reason);
      } catch {
        this.#ports.delete(port);
      }
    }
  }

  #send(port: ChromeRuntimePortServerLike, reason: ControlPlaneInvalidationReason): void {
    const hint: ControlPlaneInvalidationHint = freezeJsonValue({
      kind: 'invalidate',
      schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
      sequence: ++this.#sequence,
      reason,
    });
    port.postMessage(hint);
  }
}
</file>

<file path="src/control-plane/projector.ts">
import { freezeJsonValue, type StableId } from '../core/index.ts';
import { requireIsoTimestamp, type IsoTimestamp } from '../persistence/index.ts';
import type { ActiveWatchContext, WatchStatus, WatchTab } from '../watch/index.ts';
import {
  CONTROL_PLANE_SCHEMA_VERSION,
  type ControlPlaneRuntimeHealth,
  type ControlPlaneSnapshot,
  type SelectedTabProjection,
} from './types.ts';
import { requireOptionalTabId, requireRequestSequence } from './validation.ts';

export interface ControlPlaneWatchPort {
  status(tabId?: number): Promise<WatchStatus>;
}

export interface ControlPlaneTabPort {
  get(tabId: number): Promise<WatchTab | undefined>;
}

export interface ControlPlaneActiveWatchPort {
  activeContext(watchSessionId: StableId<'watchSession'>): Promise<ActiveWatchContext | undefined>;
}

export interface ControlPlaneHealthPort {
  snapshot(): ControlPlaneRuntimeHealth;
}

export interface ControlPlaneHydrationInput {
  readonly requestSequence: number;
  readonly tabId?: number;
}

export interface ControlPlaneProjectorOptions {
  readonly watch: ControlPlaneWatchPort;
  readonly tabs?: ControlPlaneTabPort;
  readonly activeWatch?: ControlPlaneActiveWatchPort;
  readonly health?: ControlPlaneHealthPort;
  readonly now?: () => IsoTimestamp;
}

/** Reconstruct a bounded Side Panel projection from background/durable authority. */
export class ControlPlaneProjector {
  readonly #watch: ControlPlaneWatchPort;
  readonly #tabs: ControlPlaneTabPort | undefined;
  readonly #activeWatch: ControlPlaneActiveWatchPort | undefined;
  readonly #health: ControlPlaneHealthPort | undefined;
  readonly #now: () => IsoTimestamp;

  constructor(options: ControlPlaneProjectorOptions) {
    this.#watch = options.watch;
    this.#tabs = options.tabs;
    this.#activeWatch = options.activeWatch;
    this.#health = options.health;
    this.#now = options.now ?? (() => requireIsoTimestamp(new Date().toISOString()));
  }

  async #tab(tabId: number | undefined): Promise<SelectedTabProjection | undefined> {
    if (tabId === undefined || this.#tabs === undefined) return undefined;
    const selected = await this.#tabs.get(tabId);
    if (selected === undefined) return undefined;
    return freezeJsonValue({
      id: selected.id,
      ...(selected.url === undefined ? {} : { url: selected.url }),
      ...(selected.title === undefined ? {} : { title: selected.title }),
      ...(selected.incognito === undefined ? {} : { incognito: selected.incognito }),
    });
  }

  async hydrate(input: ControlPlaneHydrationInput): Promise<ControlPlaneSnapshot> {
    const requestSequence = requireRequestSequence(input.requestSequence);
    const tabId = requireOptionalTabId(input.tabId);
    const watch = await this.#watch.status(tabId);
    const selectedTab = await this.#tab(tabId);
    const activeTab = await this.#tab(watch.active?.tabId);
    const activeWatch = watch.active === undefined || this.#activeWatch === undefined
      ? undefined
      : await this.#activeWatch.activeContext(watch.active.watchSessionId);
    return freezeJsonValue({
      schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
      requestSequence,
      generatedAt: this.#now(),
      ...(tabId === undefined ? {} : { selectedTabId: tabId }),
      ...(selectedTab === undefined ? {} : { selectedTab }),
      watch,
      ...(activeWatch === undefined ? {} : { activeWatch }),
      ...(activeTab === undefined ? {} : { activeTab }),
      runtimeHealth: this.#health?.snapshot() ?? freezeJsonValue({ state: 'healthy' }),
    }) as ControlPlaneSnapshot;
  }
}
</file>

<file path="src/control-plane/types.ts">
import type { JsonObject } from '../core/index.ts';
import type { IsoTimestamp } from '../persistence/index.ts';
import type { ResourceHistoryDetail, ResourceHistoryPage, ResourceHistoryQuery, ResourceHistorySessionList } from '../resources/index.ts';
import type { ActiveWatchContext, WatchStatus, WatchTab } from '../watch/index.ts';
import type { SettingsClearScope, SettingsClearSummary, SettingsPreferences, SettingsSnapshot } from './settings.ts';

export const CONTROL_PLANE_SCHEMA_VERSION = 2 as const;
export const CONTROL_PLANE_PORT_NAME = 'crsniffer.panel.v2' as const;

export const CONTROL_PLANE_OPERATIONS = Object.freeze({
  hydrate: 'panel.hydrate',
  resourceSessions: 'panel.resources.sessions',
  resourcePage: 'panel.resources.page',
  resourceDetail: 'panel.resources.detail',
  settings: 'panel.settings.get',
  settingsSave: 'panel.settings.save',
  settingsMaintain: 'panel.settings.maintain',
  settingsClear: 'panel.settings.clear',
} as const);

export type ControlPlaneOperation = typeof CONTROL_PLANE_OPERATIONS[keyof typeof CONTROL_PLANE_OPERATIONS];

export type ControlPlaneInvalidationReason =
  | 'connected'
  | 'watch_changed'
  | 'observation_persisted'
  | 'configuration_changed'
  | 'packagizer_changed'
  | 'settings_changed'
  | 'history_cleared'
  | 'runtime_degraded'
  | 'runtime_recovered';

export type RuntimeHealthArea = 'storage' | 'evaluation' | 'capture';

export interface ControlPlaneRuntimeHealth extends JsonObject {
  readonly state: 'healthy' | 'degraded';
  readonly area?: RuntimeHealthArea;
  readonly message?: string;
  readonly occurredAt?: IsoTimestamp;
}

export interface SelectedTabProjection extends JsonObject {
  readonly id: number;
  readonly url?: string;
  readonly title?: string;
  readonly incognito?: boolean;
}

export interface ControlPlaneSnapshot extends JsonObject {
  readonly schemaVersion: typeof CONTROL_PLANE_SCHEMA_VERSION;
  readonly requestSequence: number;
  readonly generatedAt: IsoTimestamp;
  readonly selectedTabId?: number;
  readonly selectedTab?: SelectedTabProjection;
  readonly watch: WatchStatus;
  readonly activeWatch?: ActiveWatchContext;
  readonly activeTab?: SelectedTabProjection;
  readonly runtimeHealth: ControlPlaneRuntimeHealth;
}

export interface ControlPlaneInvalidationHint extends JsonObject {
  readonly kind: 'invalidate';
  readonly schemaVersion: typeof CONTROL_PLANE_SCHEMA_VERSION;
  readonly sequence: number;
  readonly reason: ControlPlaneInvalidationReason;
}

export type PanelConnectionState = 'connecting' | 'connected' | 'reconnecting' | 'stopped';

export interface HydrationOutcome {
  readonly applied: boolean;
  readonly snapshot?: ControlPlaneSnapshot;
}

export interface ResourceSessionsResult extends JsonObject {
  readonly schemaVersion: typeof CONTROL_PLANE_SCHEMA_VERSION;
  readonly requestSequence: number;
  readonly sessions: ResourceHistorySessionList;
}

export interface ResourcePageResult extends JsonObject {
  readonly schemaVersion: typeof CONTROL_PLANE_SCHEMA_VERSION;
  readonly requestSequence: number;
  readonly page: ResourceHistoryPage;
}

export interface ResourceDetailResult extends JsonObject {
  readonly schemaVersion: typeof CONTROL_PLANE_SCHEMA_VERSION;
  readonly requestSequence: number;
  readonly found: boolean;
  readonly detail?: ResourceHistoryDetail;
}

export interface ResourceSessionsOutcome {
  readonly applied: boolean;
  readonly sessions?: ResourceHistorySessionList;
}

export interface ResourcePageOutcome {
  readonly applied: boolean;
  readonly page?: ResourceHistoryPage;
}

export interface ResourceDetailOutcome {
  readonly applied: boolean;
  readonly found?: boolean;
  readonly detail?: ResourceHistoryDetail;
}

export type ResourcePageInput = ResourceHistoryQuery;


export interface SettingsResult extends JsonObject {
  readonly schemaVersion: typeof CONTROL_PLANE_SCHEMA_VERSION;
  readonly requestSequence: number;
  readonly settings: SettingsSnapshot;
  readonly clear?: SettingsClearSummary;
}

export interface SettingsOutcome {
  readonly applied: boolean;
  readonly settings?: SettingsSnapshot;
  readonly clear?: SettingsClearSummary;
}

export type SettingsSaveInput = SettingsPreferences;
export type SettingsClearInput = SettingsClearScope;
