import assert from 'node:assert/strict';
import test from 'node:test';

import { createRequestEnvelope, createStableId, requireMessageEnvelope, type JsonObject } from '../../src/core/index.ts';
import { DefinitionCatalog } from '../../src/definitions/index.ts';
import type { PageContextValue } from '../../src/page-context/index.ts';
import {
  PERSISTENCE_STORES,
  JsonRecordRepository,
  requireDefinitionRecord,
  requireIsoTimestamp,
  type DefinitionRecord,
  type RepositoryStorePort,
} from '../../src/persistence/index.ts';
import {
  PAGE_FIELD_WORKSPACE_OPERATIONS,
  PageFieldEvaluationService,
  PageFieldPanelClient,
  PageFieldWorkspaceMessageRouter,
  PageFieldWorkspaceService,
  createPageFieldMappingDraft,
  pageFieldBodyFromDraft,
  clearPageFieldAssistInDocument,
  highlightPageFieldCandidateInDocument,
  inspectPageFieldCandidateInDocument,
  pickPageFieldSelectorInDocument,
  requirePageFieldMappingBody,
  type PageFieldAuthoringAssistPort,
  type PageFieldCandidate,
  type PageFieldDomReadResult,
} from '../../src/page-fields/index.ts';

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();
  async get(key: string): Promise<unknown> { return structuredClone(this.values.get(key)); }
  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('id required');
    this.values.set(key, structuredClone(value));
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async getAll(): Promise<readonly unknown[]> { return [...this.values.values()].map((value) => structuredClone(value)); }
}

const T0 = requireIsoTimestamp('2026-08-20T04:50:00.000Z');
const T1 = requireIsoTimestamp('2026-08-20T04:51:00.000Z');
const IDS = {
  first: createStableId('definition', () => '21000000-0000-4000-8000-000000000001'),
  second: createStableId('definition', () => '21000000-0000-4000-8000-000000000002'),
  session: createStableId('watchSession', () => '22000000-0000-4000-8000-000000000001'),
};
const CONTEXT: PageContextValue = {
  schemaVersion: 1,
  watchSessionId: IDS.session,
  tabId: 11,
  topDocumentId: 'doc-a',
  pageRevision: 1 as never,
  url: 'https://example.test/show/1',
  origin: 'https://example.test',
};

function body(slug = 'title') {
  return requirePageFieldMappingBody({
    schemaVersion: 1,
    slug,
    candidates: [{
      selector: { family: 'css', query: 'h1' },
      read: { kind: 'text_content' },
      cardinality: 'first',
      transforms: [{ kind: 'trim' }],
      accept: { rejectBlank: true },
    }],
    required: true,
    validation: { valueType: 'string', nonBlank: true },
  });
}

function fixture() {
  const definitions = new JsonRecordRepository<DefinitionRecord>(PERSISTENCE_STORES.definitions, new MemoryStore(), requireDefinitionRecord);
  const catalog = new DefinitionCatalog(definitions);
  let current: PageContextValue | undefined = CONTEXT;
  const contexts = { current: async () => current };
  const reader = {
    async read(_context: PageContextValue, _candidate: PageFieldCandidate): Promise<PageFieldDomReadResult> {
      return { kind: 'nodes', values: [{ state: 'value', value: ' Episode 1 ' }] };
    },
  };
  const assist: PageFieldAuthoringAssistPort = {
    async inspect() { return { matchCount: 3, resultKind: 'nodes', sample: 'Episode 1' }; },
    async highlight() { return { matchCount: 3, highlightedCount: 3, highlightable: true }; },
    async pick(_context, family) { return { family, query: family === 'css' ? '#episode-title' : "//*[@id='episode-title']", sample: 'Episode 1' }; },
    async clear() {},
  };
  let next = 10;
  const service = new PageFieldWorkspaceService({
    catalog,
    contexts,
    evaluator: new PageFieldEvaluationService(contexts, reader),
    assist,
    now: () => T1,
    createDefinitionId: () => createStableId('definition', () => `23000000-0000-4000-8000-${String(next++).padStart(12, '0')}`),
  });
  return { catalog, service, assist, setContext(value: PageContextValue | undefined) { current = value; } };
}

test('Page Field workspace creates and revision-fences structured mapping definitions without parallel persistence', async () => {
  const { service, catalog } = fixture();
  const created = await service.save({ mode: 'create', name: 'Episode title', enabled: true, body: body('episode_title') });
  assert.equal(created.created, true);
  assert.equal(created.definition.body.slug, 'episode_title');
  const stored = await catalog.require(created.definition.id);
  assert.equal(stored.definitionKind, 'pageFieldMapping');
  assert.deepEqual(stored.value.references, []);

  const updated = await service.save({
    mode: 'update', definitionId: created.definition.id, expectedRevision: created.definition.revision,
    name: 'Episode heading', enabled: true, body: body('episode_title'),
  });
  assert.equal(updated.definition.revision, created.definition.revision + 1);
  await assert.rejects(() => service.save({
    mode: 'update', definitionId: created.definition.id, expectedRevision: created.definition.revision,
    name: 'Stale update', enabled: true, body: body('episode_title'),
  }), /changed elsewhere/i);
});

test('enabled Page Field slugs remain unambiguous while disabled drafts may coexist', async () => {
  const { service } = fixture();
  await service.save({ mode: 'create', name: 'Primary title', enabled: true, body: body('title') });
  await assert.rejects(
    () => service.save({ mode: 'create', name: 'Duplicate title', enabled: true, body: body('title') }),
    /already used/i,
  );
  const disabled = await service.save({ mode: 'create', name: 'Disabled alternative', enabled: false, body: body('title') });
  assert.equal(disabled.definition.enabled, false);
});



test('Page Field delete uses shared revision and reverse-reference lifecycle authority', async () => {
  const { service, catalog } = fixture();
  const created = await service.save({ mode: 'create', name: 'Unused field', enabled: true, body: body('unused_field') });
  await assert.rejects(
    () => service.delete({ definitionId: created.definition.id, expectedRevision: (created.definition.revision + 1) as never }),
    /changed elsewhere/i,
  );
  const deleted = await service.delete({ definitionId: created.definition.id, expectedRevision: created.definition.revision });
  assert.equal(deleted.deleted, true);
  assert.equal(await catalog.get(created.definition.id), undefined);
});

test('explicit Test/Highlight/Pick use exact current context and return bounded authoring facts', async () => {
  const { service } = fixture();
  const tested = await service.test(body());
  assert.equal(tested.context.status, 'exact');
  assert.equal(tested.context.url, CONTEXT.url);
  assert.equal('topDocumentId' in tested.context, false);
  assert.equal(tested.status, 'value');
  assert.equal(tested.candidates[0]?.matchCount, 3);
  assert.equal(tested.candidates[0]?.sample, 'Episode 1');

  const highlighted = await service.highlight({ body: body(), candidateIndex: 0 });
  assert.equal(highlighted.highlightedCount, 3);
  const picked = await service.pick({ family: 'css' });
  assert.equal(picked.query, '#episode-title');
  assert.equal('watchSessionId' in picked.context, false);
});

test('page assistance fails closed when PageContext changes during an explicit action', async () => {
  const { catalog, setContext } = fixture();
  let current: PageContextValue | undefined = CONTEXT;
  const contexts = { current: async () => current };
  const assist: PageFieldAuthoringAssistPort = {
    async inspect() {
      current = { ...CONTEXT, pageRevision: 2 as never };
      return { matchCount: 1, resultKind: 'nodes' };
    },
    async highlight() { return { matchCount: 1, highlightedCount: 1, highlightable: true }; },
    async pick(_context, family) { return { family, query: 'h1' }; },
    async clear() {},
  };
  const service = new PageFieldWorkspaceService({
    catalog,
    contexts,
    evaluator: new PageFieldEvaluationService(contexts, { async read() { return { kind: 'nodes', values: [] }; } }),
    assist,
  });
  await assert.rejects(() => service.test(body()), /page changed/i);
  setContext(undefined);
});

test('message router and panel client keep authoring operations explicit and correlated', async () => {
  const { service } = fixture();
  const router = new PageFieldWorkspaceMessageRouter(service);
  const runtime = { async sendMessage(message: unknown) { return router.handle(message); } };
  const client = new PageFieldPanelClient(runtime);
  const snap = await client.snapshot();
  assert.equal(snap.context.status, 'exact');
  const saved = await client.save({ mode: 'create', name: 'Title', enabled: true, body: body() });
  assert.equal(saved.definition.name, 'Title');
  const tested = await client.test(saved.definition.body);
  assert.equal(tested.status, 'value');
  const disposable = await client.save({ mode: 'create', name: 'Disposable', enabled: false, body: body('disposable') });
  const deleted = await client.delete(disposable.definition.id, disposable.definition.revision);
  assert.equal(deleted.deleted, true);

  const invalid = createRequestEnvelope({ operation: PAGE_FIELD_WORKSPACE_OPERATIONS.test, payload: { body: saved.definition.body, extra: true } });
  const response = requireMessageEnvelope(await router.handle(invalid));
  assert.equal(response.kind, 'response');
  assert.equal(response.kind === 'response' && response.outcome.ok, false);
});

test('serialized assist functions are closure-free with respect to module helper symbols', () => {
  assert.doesNotMatch(inspectPageFieldCandidateInDocument.toString(), /PAGE_FIELD_ASSIST_OVERLAY_ID|PAGE_FIELD_ASSIST_PICK_KEY/);
  assert.doesNotMatch(highlightPageFieldCandidateInDocument.toString(), /PAGE_FIELD_ASSIST_OVERLAY_ID|PAGE_FIELD_ASSIST_PICK_KEY/);
  assert.doesNotMatch(pickPageFieldSelectorInDocument.toString(), /clearPageFieldAssistInDocument|PAGE_FIELD_ASSIST_OVERLAY_ID|PAGE_FIELD_ASSIST_PICK_KEY|PAGE_FIELD_ASSIST_CANCEL_MESSAGE/);
  assert.doesNotMatch(clearPageFieldAssistInDocument.toString(), /PAGE_FIELD_ASSIST_OVERLAY_ID|PAGE_FIELD_ASSIST_PICK_KEY/);
});


test('structured Page Field draft round-trips namespaces, transforms, mixed typed fallback values and validation without raw schema editing', () => {
  const original = requirePageFieldMappingBody({
    schemaVersion: 1,
    slug: 'episode_code',
    candidates: [{
      selector: { family: 'xpath', query: '//media:title', namespaces: { media: 'https://example.test/media' } },
      read: { kind: 'text_content' }, cardinality: 'exact_one',
      transforms: [{ kind: 'trim' }, { kind: 'replace', search: 'Episode ', replacement: '' }, { kind: 'slice', start: 0, end: 12 }],
      accept: { rejectBlank: true },
    }],
    defaultValue: Object.freeze(['unknown', 0, false, null]),
    required: false,
    validation: { valueType: 'string', nonBlank: true, minLength: 1, maxLength: 40 },
  });
  const draft = createPageFieldMappingDraft({ id: IDS.first, revision: 3 as never, name: 'Episode code', enabled: true, body: original });
  assert.deepEqual(pageFieldBodyFromDraft(draft), original);
});
