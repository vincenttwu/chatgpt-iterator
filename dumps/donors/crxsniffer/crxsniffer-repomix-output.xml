#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import sys
import tempfile
import zipfile
from pathlib import Path, PurePosixPath
from typing import Any

sys.dont_write_bytecode = True

from _manager_common import current_iteration, sha256_file, utc_now, workspace_root

ROOT = workspace_root(__file__)
DEFAULT_RECOVERY_ROOT = Path("/mnt/data")
REQUIRED = [
    ".gitignore",
    "CHANGELOG.md",
    "iteration_manifest.json",
    "iteration_manifest.yaml",
    "agents/README.md",
    "agents/governance/README.md",
    "agents/governance/artifacts.md",
    "agents/governance/initialization.md",
    "agents/governance/iteration.md",
    "agents/governance/recovery.md",
    "agents/governance/management.md",
    "agents/guides/README.md",
    "agents/knowledge/README.md",
    "agents/records/README.md",
    "agents/templates/README.md",
    "agents/templates/ITERATION.yaml",
    "agents/templates/CHANGE.md",
    "agents/workflow/README.md",
    "docs/README.md",
    "agents/scripts/README.md",
    "agents/scripts/_manager_common.py",
    "agents/scripts/initialization-manager.py",
    "agents/scripts/record-manager.py",
    "agents/scripts/knowledge-manager.py",
    "agents/scripts/iteration-manager.py",
    "agents/scripts/workspace-manager.py",
    "agents/tests/test_managers.py",
    "iterations/README.md",
]
TYPO_PARTS = {"knowlege", "recrods", "workflows"}
EXCLUDED_PARTS = {
    ".git",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "node_modules",
}
EXCLUDED_RECOVERY_RULES = (
    "dumps/donors/**/*.zip",
    "iterations/**/changes.diff",
)
VERSION_RE = re.compile(r"v\d+\.\d+\.\d+")
CAPTURE_KIND_RE = re.compile(r"[a-z][a-z0-9-]*")
CAPTURE_TIMESTAMP_RE = re.compile(r"\d{8}T\d{6}Z")
RESERVED_RECOVERY_KINDS = {"sealed", "pre"}


def _included(path: Path) -> bool:
    if any(part in EXCLUDED_PARTS for part in path.parts):
        return False
    parts = path.parts
    if len(parts) >= 3 and parts[0] == "dumps" and parts[1] == "donors" and path.suffix == ".zip":
        return False
    if len(parts) >= 2 and parts[0] == "iterations" and path.name == "changes.diff":
        return False
    return True


def _normalized_mode(path: Path) -> int:
    if path.is_dir():
        return 0o755
    return 0o755 if path.stat().st_mode & 0o111 else 0o644


def _entries(root: Path) -> list[Path]:
    return sorted(path for path in root.rglob("*") if _included(path.relative_to(root)))


def _workspace_tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in _entries(root):
        relative = path.relative_to(root).as_posix().encode("utf-8")
        kind = b"d" if path.is_dir() else b"f"
        mode = f"{_normalized_mode(path):04o}".encode("ascii")
        digest.update(relative)
        digest.update(b"\0")
        digest.update(kind)
        digest.update(b"\0")
        digest.update(mode)
        digest.update(b"\0")
        if path.is_file():
            digest.update(bytes.fromhex(sha256_file(path)))
    return digest.hexdigest()


def _tree_counts(root: Path) -> tuple[int, int]:
    entries = _entries(root)
    return (
        sum(1 for path in entries if path.is_file()),
        sum(1 for path in entries if path.is_dir()),
    )


def _project_name() -> str:
    manifest = ROOT / "iteration_manifest.json"
    try:
        value = json.loads(manifest.read_text(encoding="utf-8")).get("project")
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read project identity from {manifest}: {exc}") from exc
    project = str(value or "").strip()
    if not project:
        raise ValueError("iteration_manifest.json does not declare project")
    return project


def _resolve_version(requested: str | None) -> str:
    active = current_iteration(ROOT)
    version = requested or active
    if not version or not VERSION_RE.fullmatch(version):
        raise ValueError("version must use vN.N.N")
    if active and version != active:
        raise ValueError(f"requested version {version} does not match active workspace version {active}")
    return version


def _version_tuple(version: str) -> tuple[int, int, int]:
    if not VERSION_RE.fullmatch(version):
        raise ValueError("version must use vN.N.N")
    return tuple(int(part) for part in version[1:].split("."))  # type: ignore[return-value]


def _resolve_pre_target(requested: str | None) -> tuple[str, str]:
    if not requested:
        raise ValueError("pre capture requires an explicit target --version vN.N.N")
    _version_tuple(requested)
    source = current_iteration(ROOT)
    if not source or not VERSION_RE.fullmatch(source):
        raise ValueError("pre capture requires a current source workspace version")
    if _version_tuple(requested) <= _version_tuple(source):
        raise ValueError(f"pre target version {requested} must be greater than source workspace version {source}")
    return requested, source


def _capture_timestamp(requested: str | None = None) -> str:
    timestamp = requested or utc_now().replace("-", "").replace(":", "")
    if not CAPTURE_TIMESTAMP_RE.fullmatch(timestamp):
        raise ValueError("capture timestamp must use YYYYMMDDTHHMMSSZ UTC format")
    return timestamp


def _validate_capture_kind(kind: str) -> str:
    if kind in RESERVED_RECOVERY_KINDS or not CAPTURE_KIND_RE.fullmatch(kind):
        raise ValueError("capture kind must be a lowercase slug other than sealed or pre")
    return kind


def _recovery_paths(
    version: str,
    recovery_root: Path,
    *,
    kind: str = "sealed",
    source_version: str | None = None,
    timestamp: str | None = None,
) -> dict[str, Any]:
    project = _project_name()
    if kind == "sealed":
        suffix = ""
        capture_timestamp = None
    elif kind == "pre":
        suffix = "-pre"
        capture_timestamp = None
    else:
        _validate_capture_kind(kind)
        capture_timestamp = _capture_timestamp(timestamp)
        suffix = f"-{kind}.{capture_timestamp}"
    identity = f"{project}.{version}{suffix}"
    recovery_root = recovery_root.resolve()
    return {
        "project": project,
        "version": version,
        "source_version": source_version or version,
        "recovery_kind": kind,
        "capture_timestamp": capture_timestamp,
        "promoted": kind == "sealed",
        "status": "sealed" if kind == "sealed" else "captured",
        "identity": identity,
        "root": recovery_root,
        "snapshot": recovery_root / "snapshots" / identity,
        "bundle": recovery_root / f"{identity}.zip",
        "checksum": recovery_root / f"{identity}.zip.sha256",
        "metadata": recovery_root / f"{identity}.snapshot.json",
    }


def _outside_workspace(path: Path) -> bool:
    path = path.resolve()
    return path != ROOT and ROOT not in path.parents


def _normalize_tree_modes(root: Path) -> None:
    root.chmod(0o755)
    for path in _entries(root):
        path.chmod(_normalized_mode(path))


def audit() -> int:
    errors: list[str] = []
    for relative in REQUIRED:
        path = ROOT / relative
        if not path.is_file():
            errors.append(f"missing required file: {relative}")
    for path in ROOT.rglob("*"):
        relative = path.relative_to(ROOT)
        if not _included(relative):
            continue
        if path.is_symlink():
            errors.append(f"symlink is not recovery-safe: {relative}")
            continue
        if any(part in TYPO_PARTS for part in relative.parts):
            errors.append(f"forbidden legacy path: {relative}")
        if path.is_file() and path.stat().st_size == 0:
            errors.append(f"zero-byte file: {relative}")
    for error in errors:
        print(f"ERROR: {error}")
    file_count, directory_count = _tree_counts(ROOT)
    print(f"files={file_count}")
    print(f"directories={directory_count}")
    print(f"tree_sha256={_workspace_tree_digest(ROOT)}")
    return 1 if errors else 0


def _copy_snapshot(source: Path, destination: Path) -> None:
    if destination.exists():
        raise FileExistsError(f"destination already exists: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)

    def ignore(directory: str, names: list[str]) -> set[str]:
        directory_path = Path(directory)
        ignored: set[str] = set()
        for name in names:
            relative = (directory_path / name).relative_to(source)
            if not _included(relative):
                ignored.add(name)
        return ignored

    shutil.copytree(source, destination, ignore=ignore, copy_function=shutil.copy2)
    _normalize_tree_modes(destination)


def snapshot(destination: Path | None, version: str | None, recovery_root: Path) -> int:
    try:
        resolved_version = _resolve_version(version)
        paths = _recovery_paths(resolved_version, recovery_root)
        target = destination.resolve() if destination else Path(paths["snapshot"])
        if not _outside_workspace(target):
            raise ValueError("snapshot destination must be outside the workspace")
        if audit() != 0:
            raise ValueError("workspace audit failed; snapshot not created")
        _copy_snapshot(ROOT, target)
    except (OSError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    print(target)
    print(f"tree_sha256={_workspace_tree_digest(target)}")
    return 0


def _write_deterministic_zip(source: Path, output: Path, root_name: str | None = None) -> None:
    if output.exists():
        raise FileExistsError(f"output already exists: {output}")
    output.parent.mkdir(parents=True, exist_ok=True)
    entries = _entries(source)
    symlinks = [path for path in entries if path.is_symlink()]
    if symlinks:
        raise ValueError(f"refusing to bundle symlink: {symlinks[0].relative_to(source)}")
    archive_root = root_name or source.name
    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        for path in entries:
            relative = Path(archive_root) / path.relative_to(source)
            info = zipfile.ZipInfo(relative.as_posix() + ("/" if path.is_dir() else ""))
            info.date_time = (1980, 1, 1, 0, 0, 0)
            info.create_system = 3
            mode = _normalized_mode(path)
            kind = stat.S_IFDIR if path.is_dir() else stat.S_IFREG
            info.external_attr = (kind | mode) << 16
            if path.is_dir():
                archive.writestr(info, b"")
            else:
                archive.writestr(
                    info,
                    path.read_bytes(),
                    compress_type=zipfile.ZIP_DEFLATED,
                    compresslevel=9,
                )


def bundle(output: Path | None, source: Path | None, version: str | None, recovery_root: Path) -> int:
    try:
        resolved_version = _resolve_version(version)
        paths = _recovery_paths(resolved_version, recovery_root)
        if source is None:
            source = Path(paths["snapshot"]) if output is None else ROOT
        source = source.resolve()
        if not source.is_dir():
            raise ValueError(f"bundle source does not exist: {source}")
        target = output.resolve() if output else Path(paths["bundle"])
        if not _outside_workspace(target):
            raise ValueError("bundle output must be outside the workspace")
        root_name = str(paths["identity"]) if source == Path(paths["snapshot"]) else source.name
        _write_deterministic_zip(source, target, root_name=root_name)
    except (OSError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    print(target)
    print(f"sha256={sha256_file(target)}")
    return 0


def _snapshot_index(root: Path) -> dict[str, tuple[str, int, str | None]]:
    result: dict[str, tuple[str, int, str | None]] = {}
    for path in _entries(root):
        relative = path.relative_to(root).as_posix()
        if path.is_dir():
            result[relative] = ("dir", _normalized_mode(path), None)
        elif path.is_file():
            result[relative] = ("file", _normalized_mode(path), sha256_file(path))
        else:
            raise ValueError(f"unsupported recovery entry: {relative}")
    return result


def _zip_index(bundle_path: Path, expected_root: str) -> tuple[dict[str, tuple[str, int, str | None]], list[str]]:
    result: dict[str, tuple[str, int, str | None]] = {}
    errors: list[str] = []
    with zipfile.ZipFile(bundle_path, "r") as archive:
        for info in archive.infolist():
            pure = PurePosixPath(info.filename)
            if pure.is_absolute() or ".." in pure.parts:
                errors.append(f"unsafe archive path: {info.filename}")
                continue
            if not pure.parts or pure.parts[0] != expected_root:
                errors.append(f"archive entry outside expected root {expected_root}: {info.filename}")
                continue
            if len(pure.parts) == 1:
                continue
            relative = PurePosixPath(*pure.parts[1:]).as_posix().rstrip("/")
            raw_mode = (info.external_attr >> 16) & 0xFFFF
            file_type = stat.S_IFMT(raw_mode)
            mode = stat.S_IMODE(raw_mode)
            if file_type == stat.S_IFLNK:
                errors.append(f"symlink entry is not recovery-safe: {info.filename}")
                continue
            is_dir = info.is_dir() or file_type == stat.S_IFDIR
            if is_dir:
                result[relative] = ("dir", mode, None)
            else:
                payload_hash = hashlib.sha256(archive.read(info)).hexdigest()
                result[relative] = ("file", mode, payload_hash)
    return result, errors


def _content_projection(index: dict[str, tuple[str, int, str | None]]) -> dict[str, tuple[str, str | None]]:
    return {path: (kind, digest) for path, (kind, _mode, digest) in index.items()}


def _verify_payload(paths: dict[str, Path | str]) -> list[str]:
    errors: list[str] = []
    snapshot_path = Path(paths["snapshot"])
    bundle_path = Path(paths["bundle"])
    checksum_path = Path(paths["checksum"])
    metadata_path = Path(paths["metadata"])
    identity = str(paths["identity"])

    for label, path in (("snapshot", snapshot_path), ("bundle", bundle_path), ("checksum", checksum_path), ("metadata", metadata_path)):
        if not path.exists():
            errors.append(f"missing {label} artifact: {path}")
    if errors:
        return errors
    if not snapshot_path.is_dir():
        errors.append(f"snapshot is not a directory: {snapshot_path}")
    if not bundle_path.is_file() or not zipfile.is_zipfile(bundle_path):
        errors.append(f"bundle is not a valid ZIP: {bundle_path}")
    if errors:
        return errors

    actual_sha = sha256_file(bundle_path)
    expected_checksum_line = f"{actual_sha}  {bundle_path.name}"
    if checksum_path.read_text(encoding="utf-8").strip() != expected_checksum_line:
        errors.append("checksum file does not match bundle SHA-256")

    try:
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"invalid snapshot metadata: {exc}")
        metadata = {}
    if metadata:
        if metadata.get("artifact_type") != "workspace_recovery_snapshot":
            errors.append("snapshot metadata artifact_type mismatch")
        if metadata.get("project") != paths["project"] or metadata.get("version") != paths["version"]:
            errors.append("snapshot metadata project/version mismatch")
        if metadata.get("identity") != identity:
            errors.append("snapshot metadata identity mismatch")
        if metadata.get("recovery_kind") != paths.get("recovery_kind"):
            errors.append("snapshot metadata recovery_kind mismatch")
        if metadata.get("capture_timestamp") != paths.get("capture_timestamp"):
            errors.append("snapshot metadata capture_timestamp mismatch")
        if metadata.get("promoted") is not paths.get("promoted"):
            errors.append("snapshot metadata promoted flag mismatch")
        if metadata.get("status") != paths.get("status"):
            errors.append("snapshot metadata status mismatch")
        if metadata.get("target_version") != paths.get("version"):
            errors.append("snapshot metadata target_version mismatch")
        if metadata.get("bundle", {}).get("sha256") != actual_sha:
            errors.append("snapshot metadata bundle SHA-256 mismatch")
        file_count, directory_count = _tree_counts(snapshot_path)
        if metadata.get("snapshot", {}).get("tree_sha256") != _workspace_tree_digest(snapshot_path):
            errors.append("snapshot metadata tree SHA-256 mismatch")
        if metadata.get("snapshot", {}).get("file_count") != file_count:
            errors.append("snapshot metadata file count mismatch")
        if metadata.get("snapshot", {}).get("directory_count") != directory_count:
            errors.append("snapshot metadata directory count mismatch")

    snapshot_index = _snapshot_index(snapshot_path)
    zip_index, zip_errors = _zip_index(bundle_path, identity)
    errors.extend(zip_errors)
    if set(snapshot_index) != set(zip_index):
        missing = sorted(set(snapshot_index) - set(zip_index))
        extra = sorted(set(zip_index) - set(snapshot_index))
        if missing:
            errors.append(f"bundle missing snapshot paths: {missing[:5]}")
        if extra:
            errors.append(f"bundle has unexpected paths: {extra[:5]}")
    else:
        for relative in sorted(snapshot_index):
            if snapshot_index[relative] != zip_index[relative]:
                errors.append(f"bundle content/mode mismatch: {relative}")
                break

    with tempfile.TemporaryDirectory(prefix="workspace-recovery-cold-") as temp_dir:
        cold_root = Path(temp_dir)
        with zipfile.ZipFile(bundle_path, "r") as archive:
            archive.extractall(cold_root)
        extracted = cold_root / identity
        if not extracted.is_dir():
            errors.append("cold extraction did not create expected root")
        else:
            cold_index = _snapshot_index(extracted)
            if _content_projection(cold_index) != _content_projection(snapshot_index):
                errors.append("cold extracted content is not equivalent to snapshot")

    with tempfile.TemporaryDirectory(prefix="workspace-recovery-repro-") as temp_dir:
        reproduced = Path(temp_dir) / bundle_path.name
        _write_deterministic_zip(snapshot_path, reproduced, root_name=identity)
        if reproduced.read_bytes() != bundle_path.read_bytes():
            errors.append("deterministic ZIP reproduction is not byte-identical")

    return errors


def _write_metadata(paths: dict[str, Any]) -> None:
    snapshot_path = Path(paths["snapshot"])
    bundle_path = Path(paths["bundle"])
    file_count, directory_count = _tree_counts(snapshot_path)
    payload: dict[str, Any] = {
        "schema_version": 1,
        "artifact_type": "workspace_recovery_snapshot",
        "project": paths["project"],
        "version": paths["version"],
        "source_version": paths["source_version"],
        "target_version": paths["version"],
        "recovery_kind": paths["recovery_kind"],
        "capture_timestamp": paths.get("capture_timestamp"),
        "promoted": paths["promoted"],
        "identity": paths["identity"],
        "status": paths["status"],
        "created_at": utc_now(),
        "source_workspace": str(ROOT),
        "snapshot": {
            "path": str(snapshot_path),
            "tree_sha256": _workspace_tree_digest(snapshot_path),
            "file_count": file_count,
            "directory_count": directory_count,
        },
        "bundle": {
            "path": str(bundle_path),
            "format": "zip",
            "deterministic": True,
            "sha256": sha256_file(bundle_path),
            "checksum_path": str(paths["checksum"]),
        },
        "policy": {
            "governance": "agents/governance/recovery.md",
            "excluded_parts": sorted(EXCLUDED_PARTS),
            "excluded_recovery_rules": list(EXCLUDED_RECOVERY_RULES),
            "directory_mode": "0755",
            "executable_file_mode": "0755",
            "regular_file_mode": "0644",
        },
        "validation": {
            "status": "passed",
            "archive_safety": "passed",
            "archive_modes": "passed",
            "snapshot_bundle_equivalence": "passed",
            "cold_content_equivalence": "passed",
            "deterministic_zip": "byte-identical reproduction passed",
        },
    }
    Path(paths["metadata"]).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def _create_recovery(paths: dict[str, Any], *, action: str) -> int:
    created: list[Path] = []
    try:
        for label in ("snapshot", "bundle", "checksum", "metadata"):
            path = Path(paths[label])
            if path.exists():
                raise FileExistsError(f"refusing to overwrite existing recovery artifact: {path}")
        if not _outside_workspace(Path(paths["snapshot"])) or not _outside_workspace(Path(paths["bundle"])):
            raise ValueError("recovery artifacts must be outside the workspace")
        if audit() != 0:
            raise ValueError(f"workspace audit failed; recovery {action} not created")

        _copy_snapshot(ROOT, Path(paths["snapshot"]))
        created.append(Path(paths["snapshot"]))
        _write_deterministic_zip(Path(paths["snapshot"]), Path(paths["bundle"]), root_name=str(paths["identity"]))
        created.append(Path(paths["bundle"]))
        bundle_sha = sha256_file(Path(paths["bundle"]))
        Path(paths["checksum"]).write_text(f"{bundle_sha}  {Path(paths['bundle']).name}\n", encoding="utf-8")
        created.append(Path(paths["checksum"]))
        _write_metadata(paths)
        created.append(Path(paths["metadata"]))
        errors = _verify_payload(paths)
        if errors:
            raise ValueError("; ".join(errors))
    except (OSError, ValueError, zipfile.BadZipFile) as exc:
        for path in reversed(created):
            if path.is_dir():
                shutil.rmtree(path, ignore_errors=True)
            else:
                path.unlink(missing_ok=True)
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    print(f"{action}=passed")
    print(f"identity={paths['identity']}")
    print(f"snapshot={paths['snapshot']}")
    print(f"bundle={paths['bundle']}")
    print(f"checksum={paths['checksum']}")
    print(f"metadata={paths['metadata']}")
    print(f"tree_sha256={_workspace_tree_digest(Path(paths['snapshot']))}")
    print(f"bundle_sha256={sha256_file(Path(paths['bundle']))}")
    return 0


def verify(
    version: str | None,
    recovery_root: Path,
    *,
    pre: bool = False,
    kind: str | None = None,
    timestamp: str | None = None,
) -> int:
    try:
        if pre and (kind or timestamp):
            raise ValueError("--pre cannot be combined with --kind or --timestamp")
        if kind:
            if not timestamp:
                raise ValueError("timestamped capture verification requires --timestamp")
            resolved_version = _resolve_version(version)
            paths = _recovery_paths(
                resolved_version,
                recovery_root,
                kind=_validate_capture_kind(kind),
                timestamp=_capture_timestamp(timestamp),
            )
        elif timestamp:
            raise ValueError("--timestamp requires --kind")
        elif pre:
            if not version or not VERSION_RE.fullmatch(version):
                raise ValueError("pre verification requires --version vN.N.N")
            paths = _recovery_paths(version, recovery_root, kind="pre")
        else:
            resolved_version = _resolve_version(version)
            paths = _recovery_paths(resolved_version, recovery_root, kind="sealed")
        errors = _verify_payload(paths)
    except (OSError, ValueError, zipfile.BadZipFile) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    for error in errors:
        print(f"ERROR: {error}", file=sys.stderr)
    if errors:
        return 2
    print("verification=passed")
    print(f"identity={paths['identity']}")
    print(f"tree_sha256={_workspace_tree_digest(Path(paths['snapshot']))}")
    print(f"bundle_sha256={sha256_file(Path(paths['bundle']))}")
    return 0


def capture(
    kind: str,
    version: str | None,
    timestamp: str | None,
    recovery_root: Path,
) -> int:
    try:
        resolved_version = _resolve_version(version)
        resolved_kind = _validate_capture_kind(kind)
        resolved_timestamp = _capture_timestamp(timestamp)
        paths = _recovery_paths(
            resolved_version,
            recovery_root,
            kind=resolved_kind,
            source_version=resolved_version,
            timestamp=resolved_timestamp,
        )
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    return _create_recovery(paths, action="capture")


def pre(version: str | None, recovery_root: Path) -> int:
    try:
        target_version, source_version = _resolve_pre_target(version)
        paths = _recovery_paths(
            target_version,
            recovery_root,
            kind="pre",
            source_version=source_version,
        )
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    return _create_recovery(paths, action="pre")


def _recovery_set_exists(paths: dict[str, Any]) -> tuple[list[Path], list[Path]]:
    expected = [Path(paths[label]) for label in ("snapshot", "bundle", "checksum", "metadata")]
    existing = [path for path in expected if path.exists()]
    missing = [path for path in expected if not path.exists()]
    return existing, missing


def _remove_recovery_set(paths: dict[str, Any]) -> None:
    for label in ("metadata", "checksum", "bundle", "snapshot"):
        path = Path(paths[label])
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink(missing_ok=True)


def _cleanup_matching_pre(version: str, recovery_root: Path) -> str:
    pre_paths = _recovery_paths(version, recovery_root, kind="pre")
    existing, missing = _recovery_set_exists(pre_paths)
    if not existing:
        return "not_found"
    if missing:
        print(
            "WARNING: matching pre recovery set is incomplete; preserving it instead of cleaning: "
            + ", ".join(str(path) for path in missing),
            file=sys.stderr,
        )
        return "skipped_incomplete"
    errors = _verify_payload(pre_paths)
    if errors:
        print(
            "WARNING: matching pre recovery set failed verification; preserving it instead of cleaning: "
            + "; ".join(errors),
            file=sys.stderr,
        )
        return "skipped_unverified"
    _remove_recovery_set(pre_paths)
    return "removed"


def cleanup(
    kind: str,
    version: str | None,
    retain: int,
    recovery_root: Path,
) -> int:
    try:
        resolved_version = _resolve_version(version)
        resolved_kind = _validate_capture_kind(kind)
        if retain < 0:
            raise ValueError("--retain must be zero or greater")
        project = _project_name()
        prefix = f"{project}.{resolved_version}-{resolved_kind}."
        metadata_files = sorted(recovery_root.resolve().glob(f"{prefix}*.snapshot.json"))
        captures: list[tuple[str, dict[str, Any]]] = []
        for metadata_path in metadata_files:
            identity = metadata_path.name[:-len('.snapshot.json')]
            timestamp = identity.removeprefix(prefix)
            if not CAPTURE_TIMESTAMP_RE.fullmatch(timestamp):
                continue
            captures.append(
                (
                    timestamp,
                    _recovery_paths(
                        resolved_version,
                        recovery_root,
                        kind=resolved_kind,
                        source_version=resolved_version,
                        timestamp=timestamp,
                    ),
                )
            )
        captures.sort(key=lambda item: item[0], reverse=True)
        candidates = captures[retain:]
        removed = 0
        skipped = 0
        for _timestamp, paths in candidates:
            existing, missing = _recovery_set_exists(paths)
            if missing or len(existing) != 4:
                skipped += 1
                print(f"WARNING: preserving incomplete capture {paths['identity']}", file=sys.stderr)
                continue
            errors = _verify_payload(paths)
            if errors:
                skipped += 1
                print(
                    f"WARNING: preserving unverified capture {paths['identity']}: " + "; ".join(errors),
                    file=sys.stderr,
                )
                continue
            _remove_recovery_set(paths)
            removed += 1
    except (OSError, ValueError, zipfile.BadZipFile) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    print(f"cleanup=passed")
    print(f"kind={resolved_kind}")
    print(f"version={resolved_version}")
    print(f"retain={retain}")
    print(f"removed={removed}")
    print(f"skipped={skipped}")
    return 0 if skipped == 0 else 2


def seal(version: str | None, recovery_root: Path, *, keep_pre: bool = False) -> int:
    try:
        resolved_version = _resolve_version(version)
        paths = _recovery_paths(resolved_version, recovery_root, kind="sealed", source_version=resolved_version)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    result = _create_recovery(paths, action="seal")
    if result != 0:
        return result

    # Cleanup is transactional: only run after the promoted recovery set has passed
    # the same independent verification invariants used by `verify`.
    errors = _verify_payload(paths)
    if errors:
        print("ERROR: promoted recovery verification failed after seal: " + "; ".join(errors), file=sys.stderr)
        return 2

    if keep_pre:
        print("pre_cleanup=kept")
    else:
        try:
            cleanup_status = _cleanup_matching_pre(resolved_version, recovery_root)
        except (OSError, ValueError, zipfile.BadZipFile) as exc:
            print(f"WARNING: pre cleanup failed after successful seal; preserving pre artifacts: {exc}", file=sys.stderr)
            cleanup_status = "skipped_error"
        print(f"pre_cleanup={cleanup_status}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Audit, preserve, and verify repository workspace state without changing governed acceptance state."
    )
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("audit")

    snap = sub.add_parser("snapshot")
    snap.add_argument("destination", nargs="?", type=Path)
    snap.add_argument("--version")
    snap.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    pack = sub.add_parser("bundle")
    pack.add_argument("output", nargs="?", type=Path)
    pack.add_argument("--source", type=Path)
    pack.add_argument("--version")
    pack.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    take = sub.add_parser("capture")
    take.add_argument("--kind", required=True, help="repeatable non-promoted capture kind, for example checkpoint")
    take.add_argument("--version")
    take.add_argument("--timestamp", help="optional UTC identity timestamp in YYYYMMDDTHHMMSSZ format")
    take.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    check = sub.add_parser("verify")
    check.add_argument("--version")
    check.add_argument("--pre", action="store_true", help="verify the non-promoted {project}.vN.N.N-pre recovery identity")
    check.add_argument("--kind", help="verify a timestamped non-promoted capture kind")
    check.add_argument("--timestamp", help="timestamp for --kind verification in YYYYMMDDTHHMMSSZ format")
    check.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    before = sub.add_parser("pre")
    before.add_argument("--version", required=True, help="target version that the captured source state precedes")
    before.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    clean = sub.add_parser("cleanup")
    clean.add_argument("--kind", required=True, help="timestamped non-promoted capture kind to prune")
    clean.add_argument("--version")
    clean.add_argument("--retain", required=True, type=int, help="number of newest verified captures to retain")
    clean.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    close = sub.add_parser("seal")
    close.add_argument("--version")
    close.add_argument("--keep-pre", action="store_true", help="preserve the matching verified -pre recovery set after a successful promoted seal")
    close.add_argument("--recovery-root", type=Path, default=DEFAULT_RECOVERY_ROOT)

    args = parser.parse_args()
    if args.command == "audit":
        return audit()
    if args.command == "snapshot":
        return snapshot(args.destination, args.version, args.recovery_root)
    if args.command == "bundle":
        return bundle(args.output, args.source, args.version, args.recovery_root)
    if args.command == "capture":
        return capture(args.kind, args.version, args.timestamp, args.recovery_root)
    if args.command == "verify":
        return verify(args.version, args.recovery_root, pre=args.pre, kind=args.kind, timestamp=args.timestamp)
    if args.command == "pre":
        return pre(args.version, args.recovery_root)
    if args.command == "cleanup":
        return cleanup(args.kind, args.version, args.retain, args.recovery_root)
    if args.command == "seal":
        return seal(args.version, args.recovery_root, keep_pre=args.keep_pre)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
</file>

