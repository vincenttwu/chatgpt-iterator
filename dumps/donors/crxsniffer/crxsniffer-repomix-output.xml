import assert from 'node:assert/strict';
import test from 'node:test';

import { createStableId, type JsonObject, type Revision } from '../../src/core/index.ts';
import { DefinitionCatalog, WatchSessionComposer } from '../../src/definitions/index.ts';
import { ResourceEvaluationService } from '../../src/evaluation/index.ts';
import type { ResourceObservationValue } from '../../src/observations/index.ts';
import type { PageContextResolution, PageContextValue } from '../../src/page-context/index.ts';
import {
  PAGE_FIELD_ERROR_CODES,
  PageFieldEvaluationService,
  PageFieldSnapshotService,
  pageFieldSnapshotIdForObservation,
  resolveWatchSessionPageFieldDependencies,
  validateWatchSessionPageFieldDependencies,
  type PageFieldCandidate,
  type PageFieldDocumentFactsReader,
  type PageFieldDomReadResult,
} from '../../src/page-fields/index.ts';
import {
  JsonRecordRepository,
  PERSISTED_RECORD_SCHEMA_VERSION,
  PERSISTENCE_STORES,
  requireDefinitionRecord,
  requireIsoTimestamp,
  requirePageFieldSnapshotRecord,
  requireResourceObservationRecord,
  requireWatchSessionRecord,
  type DefinitionRecord,
  type PageFieldSnapshotRecord,
  type RepositoryStorePort,
  type ResourceObservationRecord,
  type WatchSessionRecord,
} from '../../src/persistence/index.ts';

const T0 = requireIsoTimestamp('2026-08-20T00:00:00.000Z');
const T1 = requireIsoTimestamp('2026-08-20T00:00:01.000Z');
const IDS = {
  watch: createStableId('definition', () => '91000000-0000-4000-8000-000000000001'),
  rule: createStableId('definition', () => '91000000-0000-4000-8000-000000000002'),
  template: createStableId('definition', () => '91000000-0000-4000-8000-000000000003'),
  mapping: createStableId('definition', () => '91000000-0000-4000-8000-000000000004'),
  session: createStableId('watchSession', () => '92000000-0000-4000-8000-000000000001'),
  observation: createStableId('resourceObservation', () => '93000000-0000-4000-8000-000000000001'),
};

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();
  putCount = 0;

  async get(key: string): Promise<unknown> { return this.values.get(key); }
  async put(value: JsonObject): Promise<void> {
    const key = String(value.id ?? value.key);
    this.values.set(key, structuredClone(value));
    this.putCount += 1;
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async getAll(): Promise<readonly unknown[]> { return [...this.values.values()].map((value) => structuredClone(value)); }
}

function repositories() {
  const definitionStore = new MemoryStore();
  const sessionStore = new MemoryStore();
  const snapshotStore = new MemoryStore();
  return {
    definitionStore,
    sessionStore,
    snapshotStore,
    definitions: new JsonRecordRepository<DefinitionRecord>(PERSISTENCE_STORES.definitions, definitionStore, requireDefinitionRecord),
    sessions: new JsonRecordRepository<WatchSessionRecord>(PERSISTENCE_STORES.watchSessions, sessionStore, requireWatchSessionRecord),
    snapshots: new JsonRecordRepository<PageFieldSnapshotRecord>(PERSISTENCE_STORES.pageFieldSnapshots, snapshotStore, requirePageFieldSnapshotRecord),
  };
}

async function seededSession(options: { includeMappingReference?: boolean; resourceOnlyRuleCondition?: boolean } = {}) {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({
    id: IDS.mapping,
    kind: 'pageFieldMapping',
    name: 'Episode',
    body: {
      schemaVersion: 1,
      slug: 'episode',
      candidates: [{
        selector: { family: 'css', query: '.episode' },
        read: { kind: 'text_content' },
        cardinality: 'first',
        transforms: [{ kind: 'trim' }],
        accept: { rejectBlank: true },
      }],
      required: false,
      validation: { valueType: 'string' },
    },
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.template,
    kind: 'template',
    name: 'Filename',
    body: { schemaVersion: 1, text: '${field.episode|default:"none"}-${page.title|default:"untitled"}' },
    references: options.includeMappingReference === false ? [] : [{ id: IDS.mapping, kind: 'pageFieldMapping' }],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.rule,
    kind: 'packagizerRule',
    name: 'Derive',
    body: {
      schemaVersion: 1,
      conditions: [options.resourceOnlyRuleCondition
        ? { id: 'needs_resource', token: 'resource.url', operator: 'contains', value: 'cdn.example.test' }
        : { id: 'needs_page', token: 'page.url', operator: 'contains', value: 'example.test' }],
      actions: [{ id: 'filename', type: 'set_filename', templateId: IDS.template }],
      stopAfterSuccess: false,
    },
    references: [{ id: IDS.template, kind: 'template' }],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.watch,
    kind: 'watch',
    name: 'Watch',
    references: [{ id: IDS.rule, kind: 'packagizerRule' }],
    timestamp: T0,
  });
  const session = await new WatchSessionComposer(repos.definitions, repos.sessions).compose({
    id: IDS.session,
    watchDefinitionId: IDS.watch,
    timestamp: T0,
  });
  return { ...repos, session };
}

const CONTEXT: PageContextValue = {
  schemaVersion: 1,
  watchSessionId: IDS.session,
  tabId: 7,
  topDocumentId: 'doc-page-fields',
  pageRevision: 1 as Revision,
  url: 'https://example.test/watch?id=7',
  origin: 'https://example.test',
};

function observation(overrides: Partial<ResourceObservationValue> = {}): ResourceObservationRecord {
  const value: ResourceObservationValue = {
    schemaVersion: 1,
    requestId: 'snapshot-request-1',
    tabId: 7,
    method: 'GET',
    requestType: 'media',
    startedAt: T0,
    endedAt: T1,
    startedWithBeforeRequest: true,
    initialUrl: 'https://cdn.example.test/video.mp4',
    finalUrl: 'https://cdn.example.test/video.mp4',
    frameId: 0,
    documentId: CONTEXT.topDocumentId,
    attributionStatus: 'exact_top_document',
    topDocumentId: CONTEXT.topDocumentId,
    pageRevision: CONTEXT.pageRevision,
    responseStatusCode: 200,
    responseMimeType: 'video/mp4',
    hops: [],
    terminal: { kind: 'completed', at: T1, statusCode: 200 },
    ...overrides,
  };
  return requireResourceObservationRecord({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: IDS.observation,
    watchSessionId: IDS.session,
    observedAt: T1,
    value,
  });
}

class MutableContexts {
  currentValue: PageContextValue | undefined = CONTEXT;
  forcedStatus: Exclude<PageContextResolution['status'], 'exact'> | undefined;

  async current(): Promise<PageContextValue | undefined> { return this.currentValue; }
  async resolveObservation(): Promise<PageContextResolution> {
    if (this.forcedStatus !== undefined) return { status: this.forcedStatus };
    return this.currentValue === undefined ? { status: 'unavailable' } : { status: 'exact', context: this.currentValue };
  }
}

class FakeReader implements PageFieldDocumentFactsReader {
  readCount = 0;
  titleCount = 0;
  mutateAfterRead: (() => void) | undefined;

  async read(_context: PageContextValue, _candidate: PageFieldCandidate): Promise<PageFieldDomReadResult> {
    this.readCount += 1;
    const result: PageFieldDomReadResult = { kind: 'nodes', values: [{ state: 'value', value: ' Episode 7 ' }] };
    this.mutateAfterRead?.();
    return result;
  }
  async readTitle(): Promise<string> {
    this.titleCount += 1;
    return 'Example Title';
  }
}

function snapshotService(repos: ReturnType<typeof repositories>, contexts: MutableContexts, reader: FakeReader) {
  const evaluator = new PageFieldEvaluationService(contexts, reader);
  return new PageFieldSnapshotService({
    contexts,
    evaluator,
    documentFacts: reader,
    snapshots: repos.snapshots,
    now: () => T1,
  });
}

test('dependency freeze resolves only page/field tokens used by enabled frozen rules/templates', async () => {
  const seeded = await seededSession();
  const plan = resolveWatchSessionPageFieldDependencies(seeded.session);
  assert.deepEqual(plan.pageTokens, ['page.title', 'page.url']);
  assert.deepEqual(plan.fieldSlugs, ['episode']);
  assert.equal(plan.mappings[0]?.snapshot.id, IDS.mapping);
  assert.equal(plan.required, true);
});

test('Watch dependency validation fails when a field token has no frozen mapping dependency', async () => {
  const seeded = await seededSession({ includeMappingReference: false });
  assert.throws(
    () => validateWatchSessionPageFieldDependencies(seeded.session),
    (error: unknown) => error instanceof Error && error.message.includes('field.episode') && (error as { code?: string }).code === PAGE_FIELD_ERROR_CODES.dependencyMissing,
  );
});

test('exact observation creates one immutable PageFieldSnapshot with mapping provenance and token facts', async () => {
  const seeded = await seededSession();
  const contexts = new MutableContexts();
  const reader = new FakeReader();
  const service = snapshotService(seeded, contexts, reader);
  const result = await service.prepare(seeded.session, observation());
  assert.equal(result.status, 'snapshot');
  assert.equal(result.snapshotId, pageFieldSnapshotIdForObservation(IDS.observation));
  assert.equal(result.persisted, true);
  assert.equal(result.snapshot?.documentId, CONTEXT.topDocumentId);
  assert.equal(result.snapshot?.pageRevision, CONTEXT.pageRevision);
  assert.equal(result.snapshot?.value.page.title?.value, 'Example Title');
  assert.equal(result.snapshot?.value.fields[0]?.slug, 'episode');
  assert.equal(result.snapshot?.value.fields[0]?.mapping.definitionId, IDS.mapping);
  assert.equal(result.snapshot?.value.fields[0]?.value, 'Episode 7');
  assert.equal(result.page?.url, CONTEXT.url);
  assert.equal(result.page?.origin, CONTEXT.origin);
  assert.equal(result.page?.title, 'Example Title');
  assert.equal(result.page?.fields?.episode, 'Episode 7');
  assert.equal((await seeded.snapshots.list()).length, 1);
});

test('snapshot ID is idempotent per observation and exact retries reuse durable page values without rereading DOM', async () => {
  const seeded = await seededSession();
  const contexts = new MutableContexts();
  const reader = new FakeReader();
  const service = snapshotService(seeded, contexts, reader);
  const first = await service.prepare(seeded.session, observation());
  const reads = reader.readCount;
  const titles = reader.titleCount;
  const second = await service.prepare(seeded.session, observation());
  assert.equal(second.snapshotId, first.snapshotId);
  assert.equal(reader.readCount, reads);
  assert.equal(reader.titleCount, titles);
  assert.equal(seeded.snapshotStore.putCount, 1);
});

test('stale or unattributed observation never reads the replacement page and produces no snapshot', async () => {
  const seeded = await seededSession();
  const contexts = new MutableContexts();
  contexts.forcedStatus = 'revision_stale';
  const reader = new FakeReader();
  const service = snapshotService(seeded, contexts, reader);
  const result = await service.prepare(seeded.session, observation());
  assert.equal(result.status, 'revision_stale');
  assert.equal(result.page, undefined);
  assert.equal(reader.readCount, 0);
  assert.equal(reader.titleCount, 0);
  assert.equal((await seeded.snapshots.list()).length, 0);
});

test('same-document revision change during field read discards the candidate snapshot instead of persisting stale values', async () => {
  const seeded = await seededSession();
  const contexts = new MutableContexts();
  const reader = new FakeReader();
  reader.mutateAfterRead = () => {
    contexts.currentValue = { ...CONTEXT, pageRevision: 2 as Revision, url: 'https://example.test/watch?id=8' };
  };
  const service = snapshotService(seeded, contexts, reader);
  const result = await service.prepare(seeded.session, observation());
  assert.equal(result.status, 'revision_stale');
  assert.equal((await seeded.snapshots.list()).length, 0);
});

test('live and Preview use the same snapshot facts and evaluator while Preview alone does not persist page-value history', async () => {
  const seeded = await seededSession();
  const contexts = new MutableContexts();
  const reader = new FakeReader();
  const pages = snapshotService(seeded, contexts, reader);
  const evaluation = new ResourceEvaluationService(seeded.sessions, pages);
  const record = observation();

  const preview = await evaluation.previewObservation(record);
  assert.equal(preview.status, 'projected');
  assert.equal(preview.projection?.derived.filename, 'Episode 7-Example Title');
  assert.equal(preview.explanation.pageEnrichment.status, 'snapshot');
  assert.equal(preview.explanation.pageEnrichment.persisted, false);
  assert.equal((await seeded.snapshots.list()).length, 0);

  const live = await evaluation.evaluateObservation(record);
  assert.equal(live.status, 'projected');
  assert.equal(live.projection?.derived.filename, preview.projection?.derived.filename);
  assert.equal(live.projection?.authority.pageFieldSnapshotId, pageFieldSnapshotIdForObservation(IDS.observation));
  assert.equal(live.explanation.pageEnrichment.persisted, true);
  assert.equal((await seeded.snapshots.list()).length, 1);
});

test('stale enrichment feeds Missing into page/field tokens so explicit template defaults remain deterministic', async () => {
  const seeded = await seededSession({ resourceOnlyRuleCondition: true });
  const contexts = new MutableContexts();
  contexts.forcedStatus = 'unattributed';
  const reader = new FakeReader();
  const pages = snapshotService(seeded, contexts, reader);
  const evaluation = new ResourceEvaluationService(seeded.sessions, pages);
  const result = await evaluation.evaluateObservation(observation());
  assert.equal(result.status, 'projected');
  assert.equal(result.projection?.derived.filename, 'none-untitled');
  assert.equal(result.explanation.pageEnrichment.status, 'unattributed');
  assert.equal(result.projection?.authority.pageFieldSnapshotId, undefined);
  assert.equal((await seeded.snapshots.list()).length, 0);
  const noPage = await pages.prepare(seeded.session, observation(), { persist: false });
  assert.equal(noPage.status, 'unattributed');
  assert.equal(noPage.page, undefined);
});
