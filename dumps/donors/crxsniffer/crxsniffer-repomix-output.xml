<file path="src/resources/history-validation.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  assertJsonSafe,
  freezeJsonValue,
  requireJsonObject,
  requireStableId,
  type JsonObject,
} from '../core/index.ts';
import { requireIsoTimestamp } from '../persistence/index.ts';
import { RESOURCE_KINDS, type ResourceKind } from './types.ts';
import {
  RESOURCE_HISTORY_SCHEMA_VERSION,
  type ResourceHistoryDetail,
  type ResourceHistoryEvaluationDetail,
  type ResourceHistoryPage,
  type ResourceHistoryRow,
  type ResourceHistorySessionList,
  type ResourceHistorySessionSummary,
  type ResourceHistorySourceDetail,
  type ResourceHistoryStatus,
} from './history-types.ts';
import { requireResourceHistoryCursor } from './history-service.ts';

function invalid(message: string): never {
  throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, message);
}

function onlyKeys(record: JsonObject, allowed: readonly string[], path: string): void {
  const set = new Set(allowed);
  for (const key of Object.keys(record)) if (!set.has(key)) invalid(`unknown resource history field at ${path}: ${key}`);
}

function nonEmptyString(value: unknown, label: string): string {
  if (typeof value !== 'string' || value.trim() === '') invalid(`${label} must be a non-empty string`);
  return value as string;
}

function optionalString(value: unknown, label: string): string | undefined {
  if (value === undefined) return undefined;
  return nonEmptyString(value, label);
}

function integer(value: unknown, label: string, minimum = 0): number {
  if (!Number.isSafeInteger(value) || (value as number) < minimum) invalid(`${label} must be a safe integer >= ${minimum}`);
  return value as number;
}

function resourceKind(value: unknown): ResourceKind {
  if (typeof value !== 'string' || !(RESOURCE_KINDS as readonly string[]).includes(value)) invalid('resource history kind is invalid');
  return value as ResourceKind;
}

function historyStatus(value: unknown): ResourceHistoryStatus {
  if (value !== 'projected' && value !== 'failed') invalid('resource history status is invalid');
  return value;
}

function sessionSummary(value: unknown): ResourceHistorySessionSummary {
  const record = requireJsonObject(value as never);
  onlyKeys(record, ['watchSessionId', 'startedAt', 'setupName', 'watchRevision'], '$.sessions[]');
  return freezeJsonValue({
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    startedAt: requireIsoTimestamp(record.startedAt, 'session.startedAt'),
    setupName: nonEmptyString(record.setupName, 'session.setupName'),
    watchRevision: integer(record.watchRevision, 'session.watchRevision', 1),
  });
}

export function requireResourceHistorySessionList(value: unknown): ResourceHistorySessionList {
  assertJsonSafe(value);
  const record = requireJsonObject(value as never);
  onlyKeys(record, ['schemaVersion', 'items', 'truncated'], '$.sessions');
  if (record.schemaVersion !== RESOURCE_HISTORY_SCHEMA_VERSION || typeof record.truncated !== 'boolean' || !Array.isArray(record.items)) {
    invalid('resource history session list shape is invalid');
  }
  return freezeJsonValue({
    schemaVersion: RESOURCE_HISTORY_SCHEMA_VERSION,
    items: Object.freeze(record.items.map(sessionSummary)),
    truncated: record.truncated,
  });
}

function historyRow(value: unknown): ResourceHistoryRow {
  const record = requireJsonObject(value as never);
  onlyKeys(record, [
    'observationId', 'watchSessionId', 'observedAt', 'endedAt', 'canonicalUrl', 'kind', 'status',
    'filename', 'group', 'responseStatusCode', 'responseMimeType', 'initiator', 'contentLength', 'tabTitle', 'userAgent',
  ], '$.page.items[]');
  const filename = optionalString(record.filename, 'row.filename');
  const group = optionalString(record.group, 'row.group');
  const responseStatusCode = record.responseStatusCode === undefined
    ? undefined
    : integer(record.responseStatusCode, 'row.responseStatusCode');
  const responseMimeType = optionalString(record.responseMimeType, 'row.responseMimeType');
  const initiator = optionalString(record.initiator, 'row.initiator');
  const contentLength = record.contentLength === undefined
    ? undefined
    : integer(record.contentLength, 'row.contentLength');
  const tabTitle = optionalString(record.tabTitle, 'row.tabTitle');
  const userAgent = optionalString(record.userAgent, 'row.userAgent');
  const result: ResourceHistoryRow = {
    observationId: requireStableId(record.observationId, 'resourceObservation'),
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    observedAt: requireIsoTimestamp(record.observedAt, 'row.observedAt'),
    endedAt: requireIsoTimestamp(record.endedAt, 'row.endedAt'),
    canonicalUrl: nonEmptyString(record.canonicalUrl, 'row.canonicalUrl'),
    kind: resourceKind(record.kind),
    status: historyStatus(record.status),
    ...(filename === undefined ? {} : { filename }),
    ...(group === undefined ? {} : { group }),
    ...(responseStatusCode === undefined ? {} : { responseStatusCode }),
    ...(responseMimeType === undefined ? {} : { responseMimeType }),
    ...(initiator === undefined ? {} : { initiator }),
    ...(contentLength === undefined ? {} : { contentLength }),
    ...(tabTitle === undefined ? {} : { tabTitle }),
    ...(userAgent === undefined ? {} : { userAgent }),
  };
  return freezeJsonValue(result);
}

export function requireResourceHistoryPage(value: unknown): ResourceHistoryPage {
  assertJsonSafe(value);
  const record = requireJsonObject(value as never);
  onlyKeys(record, ['schemaVersion', 'watchSessionId', 'items', 'scannedCount', 'truncated', 'nextCursor'], '$.page');
  if (record.schemaVersion !== RESOURCE_HISTORY_SCHEMA_VERSION || typeof record.truncated !== 'boolean' || !Array.isArray(record.items)) {
    invalid('resource history page shape is invalid');
  }
  const watchSessionId = requireStableId(record.watchSessionId, 'watchSession');
  const items = Object.freeze(record.items.map(historyRow));
  if (items.some((item) => item.watchSessionId !== watchSessionId)) invalid('resource history page contains another WatchSession');
  return freezeJsonValue({
    schemaVersion: RESOURCE_HISTORY_SCHEMA_VERSION,
    watchSessionId,
    items,
    scannedCount: integer(record.scannedCount, 'page.scannedCount'),
    truncated: record.truncated,
    ...(record.nextCursor === undefined ? {} : { nextCursor: requireResourceHistoryCursor(record.nextCursor) }),
  });
}

function sourceDetail(value: unknown): ResourceHistorySourceDetail {
  const record = requireJsonObject(value as never);
  onlyKeys(record, [
    'method', 'requestType', 'initialUrl', 'finalUrl', 'startedAt', 'endedAt', 'redirectCount', 'terminal',
    'responseStatusCode', 'responseMimeType', 'fromCache', 'initiator', 'contentLength', 'tabTitle', 'userAgent',
  ], '$.detail.source');
  if (!['completed', 'error', 'redirect_out_of_scope'].includes(record.terminal as string)) invalid('resource source terminal is invalid');
  if (record.fromCache !== undefined && typeof record.fromCache !== 'boolean') invalid('resource source fromCache is invalid');
  const responseStatusCode = record.responseStatusCode === undefined
    ? undefined
    : integer(record.responseStatusCode, 'detail.source.responseStatusCode');
  const responseMimeType = optionalString(record.responseMimeType, 'detail.source.responseMimeType');
  const initiator = optionalString(record.initiator, 'detail.source.initiator');
  const contentLength = record.contentLength === undefined
    ? undefined
    : integer(record.contentLength, 'detail.source.contentLength');
  const tabTitle = optionalString(record.tabTitle, 'detail.source.tabTitle');
  const userAgent = optionalString(record.userAgent, 'detail.source.userAgent');
  const result: ResourceHistorySourceDetail = {
    method: nonEmptyString(record.method, 'detail.source.method'),
    requestType: nonEmptyString(record.requestType, 'detail.source.requestType'),
    initialUrl: nonEmptyString(record.initialUrl, 'detail.source.initialUrl'),
    finalUrl: nonEmptyString(record.finalUrl, 'detail.source.finalUrl'),
    startedAt: requireIsoTimestamp(record.startedAt, 'detail.source.startedAt'),
    endedAt: requireIsoTimestamp(record.endedAt, 'detail.source.endedAt'),
    redirectCount: integer(record.redirectCount, 'detail.source.redirectCount'),
    terminal: record.terminal as ResourceHistorySourceDetail['terminal'],
    ...(responseStatusCode === undefined ? {} : { responseStatusCode }),
    ...(responseMimeType === undefined ? {} : { responseMimeType }),
    ...(record.fromCache === undefined ? {} : { fromCache: record.fromCache }),
    ...(initiator === undefined ? {} : { initiator }),
    ...(contentLength === undefined ? {} : { contentLength }),
    ...(tabTitle === undefined ? {} : { tabTitle }),
    ...(userAgent === undefined ? {} : { userAgent }),
  };
  return freezeJsonValue(result);
}

function evaluationDetail(value: unknown): ResourceHistoryEvaluationDetail {
  const record = requireJsonObject(value as never);
  onlyKeys(record, [
    'status', 'kind', 'classificationReason', 'matchedPresets', 'filename', 'group', 'comment',
    'pageEnrichmentStatus', 'evaluatedRuleCount', 'appliedRuleCount', 'failedRuleCount', 'failureCode',
  ], '$.detail.evaluation');
  if (!Array.isArray(record.matchedPresets) || !record.matchedPresets.every((entry) => entry === 'images' || entry === 'videos')) {
    invalid('resource detail matchedPresets is invalid');
  }
  const filename = optionalString(record.filename, 'detail.evaluation.filename');
  const group = optionalString(record.group, 'detail.evaluation.group');
  const comment = optionalString(record.comment, 'detail.evaluation.comment');
  const failureCode = optionalString(record.failureCode, 'detail.evaluation.failureCode');
  const result: ResourceHistoryEvaluationDetail = {
    status: historyStatus(record.status),
    kind: resourceKind(record.kind),
    classificationReason: nonEmptyString(record.classificationReason, 'detail.evaluation.classificationReason'),
    matchedPresets: Object.freeze([...record.matchedPresets] as ('images' | 'videos')[]),
    ...(filename === undefined ? {} : { filename }),
    ...(group === undefined ? {} : { group }),
    ...(comment === undefined ? {} : { comment }),
    pageEnrichmentStatus: nonEmptyString(record.pageEnrichmentStatus, 'detail.evaluation.pageEnrichmentStatus'),
    evaluatedRuleCount: integer(record.evaluatedRuleCount, 'detail.evaluation.evaluatedRuleCount'),
    appliedRuleCount: integer(record.appliedRuleCount, 'detail.evaluation.appliedRuleCount'),
    failedRuleCount: integer(record.failedRuleCount, 'detail.evaluation.failedRuleCount'),
    ...(failureCode === undefined ? {} : { failureCode }),
  };
  return freezeJsonValue(result);
}

export function requireResourceHistoryDetail(value: unknown): ResourceHistoryDetail {
  assertJsonSafe(value);
  const record = requireJsonObject(value as never);
  onlyKeys(record, ['schemaVersion', 'observationId', 'watchSessionId', 'observedAt', 'canonicalUrl', 'source', 'evaluation'], '$.detail');
  if (record.schemaVersion !== RESOURCE_HISTORY_SCHEMA_VERSION) invalid('resource history detail schemaVersion is invalid');
  return freezeJsonValue({
    schemaVersion: RESOURCE_HISTORY_SCHEMA_VERSION,
    observationId: requireStableId(record.observationId, 'resourceObservation'),
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    observedAt: requireIsoTimestamp(record.observedAt, 'detail.observedAt'),
    canonicalUrl: nonEmptyString(record.canonicalUrl, 'detail.canonicalUrl'),
    source: sourceDetail(record.source),
    evaluation: evaluationDetail(record.evaluation),
  });
}
</file>

