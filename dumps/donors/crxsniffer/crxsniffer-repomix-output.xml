import type { JsonObject, Revision, StableId } from '../core/index.ts';
import type { ObservationAttributionStatus } from '../page-context/index.ts';
import type { IsoTimestamp } from '../persistence/index.ts';

export const OBSERVATION_PENDING_SCHEMA_VERSION = 1 as const;
export const OBSERVATION_VALUE_SCHEMA_VERSION = 1 as const;
export const OBSERVATION_PENDING_PREFIX = 'crsniffer.observation.pending.';

export interface ObservationRedirectHop extends JsonObject {
  readonly kind: 'redirect';
  readonly url: string;
  readonly redirectUrl: string;
  readonly statusCode: number;
  readonly at: IsoTimestamp;
}

export interface ObservationAuthChallengeHop extends JsonObject {
  readonly kind: 'auth_challenge';
  readonly url: string;
  readonly statusCode: 401 | 407;
  readonly at: IsoTimestamp;
}

export type ObservationHop = ObservationRedirectHop | ObservationAuthChallengeHop;

export interface ObservationCompletedTerminal extends JsonObject {
  readonly kind: 'completed';
  readonly at: IsoTimestamp;
  readonly statusCode: number;
}

export interface ObservationErrorTerminal extends JsonObject {
  readonly kind: 'error';
  readonly at: IsoTimestamp;
  readonly error: string;
}

export interface ObservationRedirectOutOfScopeTerminal extends JsonObject {
  readonly kind: 'redirect_out_of_scope';
  readonly at: IsoTimestamp;
  readonly redirectUrl: string;
  readonly statusCode: number;
}

export type ObservationTerminal =
  | ObservationCompletedTerminal
  | ObservationErrorTerminal
  | ObservationRedirectOutOfScopeTerminal;

export interface PendingObservationTrace extends JsonObject {
  readonly schemaVersion: typeof OBSERVATION_PENDING_SCHEMA_VERSION;
  readonly observationId: StableId<'resourceObservation'>;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly requestId: string;
  readonly tabId: number;
  readonly method: string;
  readonly requestType: string;
  readonly startedAt: IsoTimestamp;
  readonly startedWithBeforeRequest: boolean;
  readonly initialUrl: string;
  readonly currentUrl: string;
  readonly initiator?: string;
  readonly frameId: number;
  readonly parentFrameId?: number;
  readonly documentId?: string;
  readonly parentDocumentId?: string;
  readonly attributionStatus?: ObservationAttributionStatus;
  readonly topDocumentId?: string;
  readonly pageRevision?: Revision;
  readonly hops: readonly ObservationHop[];
  readonly responseStatusCode?: number;
  readonly responseMimeType?: string;
  readonly contentLength?: number;
  readonly tabTitle?: string;
  readonly userAgent?: string;
  readonly fromCache?: boolean;
  readonly terminal?: ObservationTerminal;
}

export interface ResourceObservationValue extends JsonObject {
  readonly schemaVersion: typeof OBSERVATION_VALUE_SCHEMA_VERSION;
  readonly requestId: string;
  readonly tabId: number;
  readonly method: string;
  readonly requestType: string;
  readonly startedAt: IsoTimestamp;
  readonly endedAt: IsoTimestamp;
  readonly startedWithBeforeRequest: boolean;
  readonly initialUrl: string;
  readonly finalUrl: string;
  readonly initiator?: string;
  readonly frameId: number;
  readonly parentFrameId?: number;
  readonly documentId?: string;
  readonly parentDocumentId?: string;
  readonly attributionStatus?: ObservationAttributionStatus;
  readonly topDocumentId?: string;
  readonly pageRevision?: Revision;
  readonly hops: readonly ObservationHop[];
  readonly responseStatusCode?: number;
  readonly responseMimeType?: string;
  readonly contentLength?: number;
  readonly tabTitle?: string;
  readonly userAgent?: string;
  readonly fromCache?: boolean;
  readonly terminal: ObservationTerminal;
}

export interface WebRequestBaseDetails {
  readonly requestId: string;
  readonly url: string;
  readonly method: string;
  readonly tabId: number;
  readonly type: string;
  readonly timeStamp: number;
  readonly initiator?: string;
  readonly frameId: number;
  readonly parentFrameId?: number;
  readonly documentId?: string;
  readonly parentDocumentId?: string;
}

export interface WebRequestHeader {
  readonly name: string;
  readonly value?: string;
  readonly binaryValue?: readonly number[];
}

export interface WebRequestHeadersReceivedDetails extends WebRequestBaseDetails {
  readonly statusCode: number;
  readonly responseHeaders?: readonly WebRequestHeader[];
}

export interface WebRequestRedirectDetails extends WebRequestBaseDetails {
  readonly statusCode: number;
  readonly redirectUrl: string;
}

export interface WebRequestCompletedDetails extends WebRequestBaseDetails {
  readonly statusCode: number;
  readonly fromCache?: boolean;
}

export interface WebRequestErrorDetails extends WebRequestBaseDetails {
  readonly error: string;
}
