import { freezeJsonValue, type JsonObject } from '../core/index.ts';

export const STORAGE_PRESSURE_WARNING_RATIO = 0.8;
export const STORAGE_PRESSURE_CRITICAL_RATIO = 0.9;
export type StoragePressureLevel = 'unknown' | 'normal' | 'warning' | 'critical';

export interface StorageEstimateLike {
  readonly usage?: number;
  readonly quota?: number;
}

export interface StorageManagerLike {
  estimate(): Promise<StorageEstimateLike>;
  persisted?(): Promise<boolean>;
}

export interface StorageQuotaSnapshot extends JsonObject {
  readonly level: StoragePressureLevel;
  readonly approximate: true;
  readonly usageBytes?: number;
  readonly quotaBytes?: number;
  readonly usageRatio?: number;
  readonly persistent?: boolean;
}

function finiteNonNegative(value: unknown): number | undefined {
  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined;
}


export function requireStorageQuotaSnapshot(value: unknown): StorageQuotaSnapshot {
  if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new TypeError('Storage quota snapshot must be an object');
  const record = value as Record<string, unknown>;
  const allowed = new Set(['level', 'approximate', 'usageBytes', 'quotaBytes', 'usageRatio', 'persistent']);
  for (const key of Object.keys(record)) if (!allowed.has(key)) throw new TypeError(`Storage quota snapshot contains unsupported field ${key}`);
  if (record.level !== 'unknown' && record.level !== 'normal' && record.level !== 'warning' && record.level !== 'critical') throw new TypeError('Storage pressure level is invalid');
  if (record.approximate !== true) throw new TypeError('Storage quota snapshot must be approximate');
  const numeric = (candidate: unknown, label: string): number | undefined => {
    if (candidate === undefined) return undefined;
    if (typeof candidate !== 'number' || !Number.isFinite(candidate) || candidate < 0) throw new TypeError(`${label} is invalid`);
    return candidate;
  };
  const usageBytes = numeric(record.usageBytes, 'Storage usage');
  const quotaBytes = numeric(record.quotaBytes, 'Storage quota');
  const usageRatio = numeric(record.usageRatio, 'Storage usage ratio');
  if (usageRatio !== undefined && usageRatio > 1) throw new TypeError('Storage usage ratio is invalid');
  if (record.persistent !== undefined && typeof record.persistent !== 'boolean') throw new TypeError('Storage persistence status is invalid');
  return freezeJsonValue({
    level: record.level as StoragePressureLevel,
    approximate: true,
    ...(usageBytes === undefined ? {} : { usageBytes }),
    ...(quotaBytes === undefined ? {} : { quotaBytes }),
    ...(usageRatio === undefined ? {} : { usageRatio }),
    ...(record.persistent === undefined ? {} : { persistent: record.persistent as boolean }),
  }) as StorageQuotaSnapshot;
}

export class StorageQuotaMonitor {
  readonly #manager: StorageManagerLike | undefined;

  constructor(manager: StorageManagerLike | undefined = globalThis.navigator?.storage) {
    this.#manager = manager;
  }

  async snapshot(): Promise<StorageQuotaSnapshot> {
    if (this.#manager === undefined) return freezeJsonValue({ level: 'unknown', approximate: true }) as StorageQuotaSnapshot;
    let estimate: StorageEstimateLike;
    try {
      estimate = await this.#manager.estimate();
    } catch {
      return freezeJsonValue({ level: 'unknown', approximate: true }) as StorageQuotaSnapshot;
    }
    const usageBytes = finiteNonNegative(estimate.usage);
    const quotaBytes = finiteNonNegative(estimate.quota);
    const usageRatio = usageBytes !== undefined && quotaBytes !== undefined && quotaBytes > 0
      ? Math.min(1, usageBytes / quotaBytes)
      : undefined;
    const level: StoragePressureLevel = usageRatio === undefined
      ? 'unknown'
      : usageRatio >= STORAGE_PRESSURE_CRITICAL_RATIO
        ? 'critical'
        : usageRatio >= STORAGE_PRESSURE_WARNING_RATIO
          ? 'warning'
          : 'normal';
    let persistent: boolean | undefined;
    if (this.#manager.persisted !== undefined) {
      try { persistent = await this.#manager.persisted(); } catch { persistent = undefined; }
    }
    return freezeJsonValue({
      level,
      approximate: true,
      ...(usageBytes === undefined ? {} : { usageBytes }),
      ...(quotaBytes === undefined ? {} : { quotaBytes }),
      ...(usageRatio === undefined ? {} : { usageRatio }),
      ...(persistent === undefined ? {} : { persistent }),
    }) as StorageQuotaSnapshot;
  }
}
