test('bounded retention deletes only terminal Watch history outside the disclosed age policy', async () => {
  const h = harness();
  await h.meta.put({
    schemaVersion: 1,
    key: META_KEYS.retentionState,
    value: { schemaVersion: 1, lastReason: 'initial', deletedSessions: 0, deletedResourceObservations: 0, deletedPageFieldSnapshots: 0, deletedLifecycleRecords: 0 },
  });
  const oldId = createStableId('watchSession', () => '20000000-0000-4000-8000-000000000101');
  const recentId = createStableId('watchSession', () => '20000000-0000-4000-8000-000000000102');
  const activeId = createStableId('watchSession', () => '20000000-0000-4000-8000-000000000103');
  await h.lifecycle.put({ schemaVersion: 1, watchSessionId: oldId, tabId: 1, state: 'stopped', startedAt: '2026-07-01T00:00:00.000Z' as never, endedAt: '2026-07-01T00:01:00.000Z' as never, terminationReason: 'user_stop' });
  await h.lifecycle.put({ schemaVersion: 1, watchSessionId: recentId, tabId: 2, state: 'stopped', startedAt: '2026-08-19T00:00:00.000Z' as never, endedAt: '2026-08-19T00:01:00.000Z' as never, terminationReason: 'user_stop' });
  await h.lifecycle.put({ schemaVersion: 1, watchSessionId: activeId, tabId: 3, state: 'watching', startedAt: '2026-06-01T00:00:00.000Z' as never });
  const deleted: string[][] = [];
  const service = new WatchRetentionService({
    lifecycle: h.lifecycle,
    meta: h.meta,
    store: {
      async deleteTerminalSessions(ids) {
        deleted.push(ids as unknown as string[]);
        for (const id of ids) await h.lifecycle.delete(id);
        return { deletedSessions: ids.length, deletedResourceObservations: ids.length * 2, deletedPageFieldSnapshots: ids.length, deletedLifecycleRecords: ids.length };
      },
    },
    now: () => '2026-08-20T00:00:00.000Z' as never,
  });
  const state = await service.enforce({ maxAgeDays: 30, maxTerminalSessions: 50 }, 'manual');
  assert.deepEqual(deleted, [[oldId]]);
  assert.equal(await h.lifecycle.get(oldId), undefined);
  assert.ok(await h.lifecycle.get(recentId));
  assert.ok(await h.lifecycle.get(activeId), 'active history is never a retention candidate');
  assert.equal(state.lastReason, 'manual');
  assert.equal(state.deletedSessions, 1);
  assert.equal(state.deletedResourceObservations, 2);
});

