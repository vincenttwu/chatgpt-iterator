<file path="src/page-fields/workspace.ts">
import {
  createStableId,
  freezeJsonValue,
  requireRevision,
  type JsonObject,
  type Revision,
  type StableId,
} from '../core/index.ts';
import {
  DEFINITION_ERROR_CODES,
  DefinitionCatalog,
  DefinitionLifecycleService,
  DefinitionError,
  type SavedDefinitionRecord,
} from '../definitions/index.ts';
import { requireIsoTimestamp, type IsoTimestamp } from '../persistence/index.ts';
import type { PageContextValue } from '../page-context/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from './errors.ts';
import type { PageFieldEvaluationService } from './service.ts';
import type {
  PageFieldAssistHighlightResult,
  PageFieldAssistInspection,
  PageFieldAssistPickResult,
  PageFieldAuthoringAssistPort,
  PageFieldCandidate,
  PageFieldContextGuard,
  PageFieldMappingBody,
  PageFieldSelectorFamily,
} from './types.ts';
import { requirePageFieldMappingBody } from './validation.ts';

export const PAGE_FIELD_WORKSPACE_SCHEMA_VERSION = 1 as const;
export const PAGE_FIELD_AUTHORING_MAX_SAMPLE_LENGTH = 160 as const;

export interface PageFieldMappingSummary extends JsonObject {
  readonly id: StableId<'definition'>;
  readonly revision: Revision;
  readonly name: string;
  readonly enabled: boolean;
  readonly body: PageFieldMappingBody;
}

export interface PageFieldAuthoringContextSummary extends JsonObject {
  readonly status: 'exact' | 'unavailable';
  readonly tabId?: number;
  readonly url?: string;
  readonly origin?: string;
  readonly pageRevision?: Revision;
}

export interface PageFieldWorkspaceSnapshot extends JsonObject {
  readonly schemaVersion: typeof PAGE_FIELD_WORKSPACE_SCHEMA_VERSION;
  readonly mappings: readonly PageFieldMappingSummary[];
  readonly context: PageFieldAuthoringContextSummary;
}

export interface SavePageFieldMappingInput extends JsonObject {
  readonly mode: 'create' | 'update';
  readonly definitionId?: StableId<'definition'>;
  readonly expectedRevision?: Revision;
  readonly name: string;
  readonly enabled: boolean;
  readonly body: PageFieldMappingBody;
}

export interface SavePageFieldMappingResult extends JsonObject {
  readonly created: boolean;
  readonly definition: PageFieldMappingSummary;
}

export interface DeletePageFieldMappingInput extends JsonObject {
  readonly definitionId: StableId<'definition'>;
  readonly expectedRevision: Revision;
}

export interface DeletePageFieldMappingResult extends JsonObject {
  readonly deleted: true;
  readonly definitionId: StableId<'definition'>;
}

export interface PageFieldCandidateTestFact extends JsonObject {
  readonly candidateIndex: number;
  readonly selectorFamily: PageFieldSelectorFamily;
  readonly status: 'inspected' | 'error';
  readonly matchCount?: number;
  readonly resultKind?: 'nodes' | 'scalar';
  readonly sample?: string;
  readonly errorCode?: string;
}

export interface PageFieldTestResult extends JsonObject {
  readonly schemaVersion: typeof PAGE_FIELD_WORKSPACE_SCHEMA_VERSION;
  readonly context: PageFieldAuthoringContextSummary;
  readonly status: 'value' | 'missing' | 'error';
  readonly source?: 'candidate' | 'default';
  readonly selectedCandidateIndex?: number;
  readonly errorCode?: string;
  readonly candidates: readonly PageFieldCandidateTestFact[];
}

export interface PageFieldHighlightInput extends JsonObject {
  readonly body: PageFieldMappingBody;
  readonly candidateIndex: number;
}

export interface PageFieldHighlightResult extends JsonObject {
  readonly schemaVersion: typeof PAGE_FIELD_WORKSPACE_SCHEMA_VERSION;
  readonly context: PageFieldAuthoringContextSummary;
  readonly candidateIndex: number;
  readonly matchCount: number;
  readonly highlightedCount: number;
  readonly highlightable: boolean;
}

export interface PageFieldPickInput extends JsonObject {
  readonly family: PageFieldSelectorFamily;
}

export interface PageFieldPickWorkspaceResult extends JsonObject {
  readonly schemaVersion: typeof PAGE_FIELD_WORKSPACE_SCHEMA_VERSION;
  readonly context: PageFieldAuthoringContextSummary;
  readonly family: PageFieldSelectorFamily;
  readonly query: string;
  readonly sample?: string;
}

export interface PageFieldWorkspaceServiceOptions {
  readonly catalog: DefinitionCatalog;
  readonly contexts: PageFieldContextGuard;
  readonly evaluator: PageFieldEvaluationService;
  readonly assist: PageFieldAuthoringAssistPort;
  readonly now?: () => IsoTimestamp;
  readonly createDefinitionId?: () => StableId<'definition'>;
}

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString());
}

function requireName(value: string): string {
  const name = value.trim();
  if (name.length === 0 || name.length > 120) {
    throw new DefinitionError(DEFINITION_ERROR_CODES.invalidDefinition, 'Page Field name must contain 1..120 characters');
  }
  return name;
}

function summary(record: SavedDefinitionRecord): PageFieldMappingSummary {
  if (record.definitionKind !== 'pageFieldMapping') {
    throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, 'Expected a Page Field mapping definition');
  }
  return freezeJsonValue({
    id: record.id,
    revision: record.revision,
    name: record.value.name,
    enabled: record.value.enabled,
    body: requirePageFieldMappingBody(record.value.body),
  }) as PageFieldMappingSummary;
}

function contextSummary(context: PageContextValue | undefined): PageFieldAuthoringContextSummary {
  if (context === undefined) return freezeJsonValue({ status: 'unavailable' }) as PageFieldAuthoringContextSummary;
  return freezeJsonValue({
    status: 'exact',
    tabId: context.tabId,
    url: context.url,
    origin: context.origin,
    pageRevision: context.pageRevision,
  }) as PageFieldAuthoringContextSummary;
}

function sameContext(left: PageContextValue | undefined, right: PageContextValue): boolean {
  return left !== undefined
    && left.watchSessionId === right.watchSessionId
    && left.tabId === right.tabId
    && left.topDocumentId === right.topDocumentId
    && left.pageRevision === right.pageRevision;
}

function sampleOf(inspection: PageFieldAssistInspection): string | undefined {
  if (inspection.sample === undefined) return undefined;
  return inspection.sample.slice(0, PAGE_FIELD_AUTHORING_MAX_SAMPLE_LENGTH);
}

export class PageFieldWorkspaceService {
  readonly #catalog: DefinitionCatalog;
  readonly #contexts: PageFieldContextGuard;
  readonly #evaluator: PageFieldEvaluationService;
  readonly #assist: PageFieldAuthoringAssistPort;
  readonly #now: () => IsoTimestamp;
  readonly #createDefinitionId: () => StableId<'definition'>;
  readonly #lifecycle: DefinitionLifecycleService;

  constructor(options: PageFieldWorkspaceServiceOptions) {
    this.#catalog = options.catalog;
    this.#lifecycle = new DefinitionLifecycleService({ catalog: options.catalog });
    this.#contexts = options.contexts;
    this.#evaluator = options.evaluator;
    this.#assist = options.assist;
    this.#now = options.now ?? defaultNow;
    this.#createDefinitionId = options.createDefinitionId ?? (() => createStableId('definition'));
  }

  async #requireExactContext(expected?: PageContextValue): Promise<PageContextValue> {
    const current = await this.#contexts.current();
    if (current === undefined) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.contextUnavailable, 'Start Watch on the page you want to test so an exact PageContext is available');
    }
    if (expected !== undefined && !sameContext(current, expected)) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.contextStale, 'The page changed while Page Field assistance was running. Retry against the current document.');
    }
    return current;
  }

  async #assertUniqueEnabledSlug(body: PageFieldMappingBody, currentId?: StableId<'definition'>): Promise<void> {
    const mappings = await this.#catalog.list('pageFieldMapping');
    const conflict = mappings.find((record) => record.id !== currentId
      && record.value.enabled
      && record.value.body.slug === body.slug);
    if (conflict !== undefined) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.invalidDefinition,
        `Enabled Page Field slug ${body.slug} is already used by ${conflict.value.name}`,
        { slug: body.slug, definitionId: conflict.id },
      );
    }
  }

  async snapshot(): Promise<PageFieldWorkspaceSnapshot> {
    const [records, context] = await Promise.all([this.#catalog.list('pageFieldMapping'), this.#contexts.current()]);
    return freezeJsonValue({
      schemaVersion: PAGE_FIELD_WORKSPACE_SCHEMA_VERSION,
      mappings: Object.freeze(records.map(summary).sort((left, right) => left.name.localeCompare(right.name))),
      context: contextSummary(context),
    }) as PageFieldWorkspaceSnapshot;
  }

  async save(input: SavePageFieldMappingInput): Promise<SavePageFieldMappingResult> {
    const body = requirePageFieldMappingBody(input.body);
    const name = requireName(input.name);
    let current: SavedDefinitionRecord | undefined;
    if (input.mode === 'update') {
      if (input.definitionId === undefined || input.expectedRevision === undefined) {
        throw new DefinitionError(DEFINITION_ERROR_CODES.invalidDefinition, 'Update requires an exact saved Page Field revision');
      }
      current = await this.#catalog.require(input.definitionId);
      if (current.definitionKind !== 'pageFieldMapping') {
        throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, 'Expected a Page Field mapping definition');
      }
      if (current.revision !== requireRevision(input.expectedRevision)) {
        throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, 'This Page Field changed elsewhere. Reload the latest revision or Save as a new Page Field.');
      }
    }
    if (input.enabled) await this.#assertUniqueEnabledSlug(body, current?.id);
    const timestamp = this.#now();
    const record = current === undefined
      ? await this.#catalog.create({
        id: this.#createDefinitionId(),
        kind: 'pageFieldMapping',
        name,
        enabled: input.enabled,
        body,
        references: Object.freeze([]),
        timestamp,
      })
      : await this.#catalog.update(current.id, current.revision, {
        name,
        enabled: input.enabled,
        body,
        references: Object.freeze([]),
      }, timestamp);
    return freezeJsonValue({ created: current === undefined, definition: summary(record) }) as SavePageFieldMappingResult;
  }


  async delete(input: DeletePageFieldMappingInput): Promise<DeletePageFieldMappingResult> {
    const result = await this.#lifecycle.delete({
      definitionId: input.definitionId,
      expectedRevision: input.expectedRevision,
      kind: 'pageFieldMapping',
    });
    return freezeJsonValue(result) as DeletePageFieldMappingResult;
  }

  async test(bodyInput: PageFieldMappingBody): Promise<PageFieldTestResult> {
    const body = requirePageFieldMappingBody(bodyInput);
    const context = await this.#requireExactContext();
    const facts: PageFieldCandidateTestFact[] = [];
    for (const [candidateIndex, candidate] of body.candidates.entries()) {
      try {
        const inspection = await this.#assist.inspect(context, candidate);
        await this.#requireExactContext(context);
        const sample = sampleOf(inspection);
        const fact: PageFieldCandidateTestFact = {
          candidateIndex,
          selectorFamily: candidate.selector.family,
          status: 'inspected',
          matchCount: inspection.matchCount,
          resultKind: inspection.resultKind,
          ...(sample === undefined ? {} : { sample }),
        };
        facts.push(freezeJsonValue(fact) as PageFieldCandidateTestFact);
      } catch (error) {
        await this.#requireExactContext(context);
        const fact: PageFieldCandidateTestFact = {
          candidateIndex,
          selectorFamily: candidate.selector.family,
          status: 'error',
          errorCode: error instanceof PageFieldError ? error.code : PAGE_FIELD_ERROR_CODES.selectorEvaluationFailed,
        };
        facts.push(freezeJsonValue(fact) as PageFieldCandidateTestFact);
      }
    }
    const evaluation = await this.#evaluator.evaluateBody(context, body);
    await this.#requireExactContext(context);
    return freezeJsonValue({
      schemaVersion: PAGE_FIELD_WORKSPACE_SCHEMA_VERSION,
      context: contextSummary(context),
      status: evaluation.status,
      ...(evaluation.status === 'value' ? {
        source: evaluation.source,
        ...(evaluation.selectedCandidateIndex === undefined ? {} : { selectedCandidateIndex: evaluation.selectedCandidateIndex }),
      } : {}),
      ...(evaluation.status === 'error' ? { errorCode: evaluation.code } : {}),
      candidates: Object.freeze(facts),
    }) as PageFieldTestResult;
  }

  async highlight(input: PageFieldHighlightInput): Promise<PageFieldHighlightResult> {
    const body = requirePageFieldMappingBody(input.body);
    if (!Number.isSafeInteger(input.candidateIndex) || input.candidateIndex < 0 || input.candidateIndex >= body.candidates.length) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.invalidMapping, 'Highlight candidate index is out of range');
    }
    const context = await this.#requireExactContext();
    const candidate = body.candidates[input.candidateIndex] as PageFieldCandidate;
    const result: PageFieldAssistHighlightResult = await this.#assist.highlight(context, candidate);
    await this.#requireExactContext(context);
    return freezeJsonValue({
      schemaVersion: PAGE_FIELD_WORKSPACE_SCHEMA_VERSION,
      context: contextSummary(context),
      candidateIndex: input.candidateIndex,
      matchCount: result.matchCount,
      highlightedCount: result.highlightedCount,
      highlightable: result.highlightable,
    }) as PageFieldHighlightResult;
  }

  async pick(input: PageFieldPickInput): Promise<PageFieldPickWorkspaceResult> {
    if (input.family !== 'css' && input.family !== 'xpath') {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.invalidMapping, 'Pick selector family must be CSS or XPath');
    }
    const context = await this.#requireExactContext();
    const result: PageFieldAssistPickResult = await this.#assist.pick(context, input.family);
    await this.#requireExactContext(context);
    return freezeJsonValue({
      schemaVersion: PAGE_FIELD_WORKSPACE_SCHEMA_VERSION,
      context: contextSummary(context),
      family: result.family,
      query: result.query,
      ...(result.sample === undefined ? {} : { sample: result.sample.slice(0, PAGE_FIELD_AUTHORING_MAX_SAMPLE_LENGTH) }),
    }) as PageFieldPickWorkspaceResult;
  }

  async clearAssist(): Promise<void> {
    const context = await this.#contexts.current();
    if (context === undefined) return;
    await this.#assist.clear(context);
  }
}
