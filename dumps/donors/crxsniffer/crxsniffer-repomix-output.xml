import {
  assertJsonSafe,
  requireJsonObject,
  type JsonObject,
} from '../core/index.ts';
import { PERSISTENCE_ERROR_CODES, PersistenceError } from './errors.ts';
import { META_KEYS } from './schema.ts';
import {
  LOGICAL_DATABASE_VERSION,
  PERSISTED_RECORD_SCHEMA_VERSION,
  type LogicalMigrationState,
  type MetaRecord,
} from './types.ts';
import type { JsonRecordRepository } from './repository.ts';
import { INITIAL_RETENTION_MAINTENANCE_STATE, retentionMaintenanceRecord } from './retention-state.ts';

export interface LogicalMigrationStep {
  readonly id: string;
  readonly fromVersion: number;
  readonly toVersion: number;
  run(): Promise<void>;
}

function requireLogicalVersion(value: unknown, label: string): number {
  if (!Number.isSafeInteger(value) || (value as number) < 1) {
    throw new PersistenceError(
      PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
      `${label} must be a positive safe integer`,
      { label },
    );
  }
  return value as number;
}

export function requireLogicalMigrationState(value: unknown): LogicalMigrationState {
  assertJsonSafe(value);
  const state = requireJsonObject(value);
  const currentVersion = requireLogicalVersion(state.currentVersion, 'currentVersion');
  const targetVersion = requireLogicalVersion(state.targetVersion, 'targetVersion');
  if (targetVersion < currentVersion) {
    throw new PersistenceError(
      PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
      'targetVersion may not be lower than currentVersion',
    );
  }
  if (state.status !== 'idle' && state.status !== 'running' && state.status !== 'failed') {
    throw new PersistenceError(
      PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
      'Logical migration status is invalid',
    );
  }
  if (state.activeStepId !== undefined && typeof state.activeStepId !== 'string') {
    throw new PersistenceError(PERSISTENCE_ERROR_CODES.logicalMigrationFailed, 'activeStepId is invalid');
  }
  if (state.lastCompletedStepId !== undefined && typeof state.lastCompletedStepId !== 'string') {
    throw new PersistenceError(PERSISTENCE_ERROR_CODES.logicalMigrationFailed, 'lastCompletedStepId is invalid');
  }
  if (state.error !== undefined) {
    requireJsonObject(state.error);
  }
  return state as LogicalMigrationState;
}

function stateRecord(state: LogicalMigrationState): MetaRecord {
  return {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.logicalMigration,
    value: state,
  };
}

export async function readLogicalMigrationState(
  meta: JsonRecordRepository<MetaRecord>,
): Promise<LogicalMigrationState> {
  const record = await meta.get(META_KEYS.logicalMigration);
  if (record === undefined) {
    throw new PersistenceError(
      PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
      'Logical migration metadata is missing',
    );
  }
  return requireLogicalMigrationState(record.value);
}

/**
 * Run logical migrations after the database is open.
 *
 * Each step checkpoints durable metadata before and after work so a later worker activation can
 * resume from the last completed logical version. Physical object-store/index changes never occur here.
 */
export async function runLogicalMigrations(
  meta: JsonRecordRepository<MetaRecord>,
  steps: readonly LogicalMigrationStep[],
  targetVersion = LOGICAL_DATABASE_VERSION,
): Promise<LogicalMigrationState> {
  requireLogicalVersion(targetVersion, 'targetVersion');
  let state = await readLogicalMigrationState(meta);
  if (state.currentVersion > targetVersion) {
    throw new PersistenceError(
      PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
      `Persisted logical version ${state.currentVersion} is newer than supported target ${targetVersion}`,
    );
  }

  const byFromVersion = new Map<number, LogicalMigrationStep>();
  for (const step of steps) {
    requireLogicalVersion(step.fromVersion, 'fromVersion');
    requireLogicalVersion(step.toVersion, 'toVersion');
    if (step.toVersion !== step.fromVersion + 1 || step.id.trim() === '') {
      throw new PersistenceError(
        PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
        'Logical migrations must be named consecutive single-version steps',
      );
    }
    if (byFromVersion.has(step.fromVersion)) {
      throw new PersistenceError(
        PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
        `Duplicate logical migration from version ${step.fromVersion}`,
      );
    }
    byFromVersion.set(step.fromVersion, step);
  }

  while (state.currentVersion < targetVersion) {
    const step = byFromVersion.get(state.currentVersion);
    if (step === undefined || step.toVersion > targetVersion) {
      throw new PersistenceError(
        PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
        `Missing logical migration from version ${state.currentVersion}`,
      );
    }

    const running: LogicalMigrationState = {
      currentVersion: state.currentVersion,
      targetVersion,
      status: 'running',
      activeStepId: step.id,
      ...(state.lastCompletedStepId === undefined
        ? {}
        : { lastCompletedStepId: state.lastCompletedStepId }),
    };
    await meta.put(stateRecord(running));

    try {
      await step.run();
    } catch (error) {
      const failure: JsonObject = {
        code: PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
        message: error instanceof Error ? error.message : 'Logical migration step failed',
      };
      const failed: LogicalMigrationState = {
        currentVersion: state.currentVersion,
        targetVersion,
        status: 'failed',
        activeStepId: step.id,
        ...(state.lastCompletedStepId === undefined
          ? {}
          : { lastCompletedStepId: state.lastCompletedStepId }),
        error: failure,
      };
      await meta.put(stateRecord(failed));
      throw new PersistenceError(
        PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
        `Logical migration ${step.id} failed`,
        failure,
      );
    }

    state = {
      currentVersion: step.toVersion,
      targetVersion,
      status: 'idle',
      lastCompletedStepId: step.id,
    };
    await meta.put(stateRecord(state));
  }

  if (state.targetVersion !== targetVersion || state.status !== 'idle') {
    state = {
      currentVersion: state.currentVersion,
      targetVersion,
      status: 'idle',
      ...(state.lastCompletedStepId === undefined
        ? {}
        : { lastCompletedStepId: state.lastCompletedStepId }),
    };
    await meta.put(stateRecord(state));
  }
  return state;
}


/** Canonical logical migration plan for the current product version. Physical IndexedDB topology remains independent. */
export function createCrSnifferLogicalMigrationSteps(
  meta: JsonRecordRepository<MetaRecord>,
): readonly LogicalMigrationStep[] {
  return Object.freeze([
    {
      id: 'logical-v1-to-v2-retention-recovery-authority',
      fromVersion: 1,
      toVersion: 2,
      run: async () => {
        const existing = await meta.get(META_KEYS.retentionState);
        if (existing === undefined) {
          await meta.put(retentionMaintenanceRecord(META_KEYS.retentionState, INITIAL_RETENTION_MAINTENANCE_STATE));
        }
      },
    },
  ]);
}
</file>

