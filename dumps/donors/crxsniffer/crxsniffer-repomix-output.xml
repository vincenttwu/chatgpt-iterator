import { assertJsonSafe, cloneJsonValue, freezeJsonValue, type JsonObject } from '../core/index.ts';
import type { PersistenceRecordValidator } from './records.ts';
import type { PersistenceRecord } from './types.ts';
import type { PersistenceStoreName } from './schema.ts';

export interface RepositoryStorePort {
  get(key: string): Promise<unknown>;
  put(value: JsonObject): Promise<void>;
  delete(key: string): Promise<void>;
  count(): Promise<number>;
  clear(): Promise<void>;
  getAll(): Promise<readonly unknown[]>;
}

/** Strict repository facade that validates both writes and persisted reads. */
export class JsonRecordRepository<T extends PersistenceRecord> {
  readonly storeName: PersistenceStoreName;
  readonly #store: RepositoryStorePort;
  readonly #validate: PersistenceRecordValidator<T>;

  constructor(
    storeName: PersistenceStoreName,
    store: RepositoryStorePort,
    validate: PersistenceRecordValidator<T>,
  ) {
    this.storeName = storeName;
    this.#store = store;
    this.#validate = validate;
  }

  async get(key: string): Promise<T | undefined> {
    const value = await this.#store.get(key);
    return value === undefined ? undefined : this.#validate(value);
  }

  async put(value: T): Promise<void> {
    const validated = this.#validate(value);
    assertJsonSafe(validated);
    await this.#store.put(cloneJsonValue(validated));
  }

  async delete(key: string): Promise<void> {
    await this.#store.delete(key);
  }

  async count(): Promise<number> {
    return this.#store.count();
  }

  async clear(): Promise<void> {
    await this.#store.clear();
  }

  async list(): Promise<readonly T[]> {
    const values = await this.#store.getAll();
    return Object.freeze(values.map((value) => this.#validate(value)));
  }
}

export function immutableRecord<T extends JsonObject>(value: T): T {
  return freezeJsonValue(cloneJsonValue(value));
}
