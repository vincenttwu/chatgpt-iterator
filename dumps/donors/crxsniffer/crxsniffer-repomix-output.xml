<file path="src/watch/chrome-runtime.ts">
import {
  createFailureResponse,
  requireMessageEnvelope,
  toContractErrorPayload,
} from '../core/index.ts';
import {
  CONTROL_PLANE_OPERATIONS,
  ControlPlaneHealthTracker,
  ControlPlaneMessageRouter,
  ControlPlanePortHub,
  ControlPlaneProjector,
  DEFAULT_SETTINGS_PREFERENCES,
  SettingsService,
  watchRetentionPolicyFromSettings,
  type RuntimeHealthArea,
} from '../control-plane/index.ts';
import { DefinitionCatalog, WatchSessionComposer } from '../definitions/index.ts';
import { PackagizerResourcePreviewService, ResourceEvaluationError, ResourceEvaluationService } from '../evaluation/index.ts';
import {
  PACKAGIZER_WORKSPACE_OPERATIONS,
  PackagizerWorkspaceMessageRouter,
  PackagizerWorkspaceService,
} from '../packagizer/index.ts';
import {
  ChromePageFieldReader,
  PAGE_FIELD_WORKSPACE_OPERATIONS,
  PageFieldError,
  PageFieldEvaluationService,
  PageFieldSnapshotService,
  PageFieldWorkspaceMessageRouter,
  PageFieldWorkspaceService,
} from '../page-fields/index.ts';
import { ChromePageContextCapture, PageContextRegistry } from '../page-context/index.ts';
import {
  createChromeStorageTiers,
  createCrSnifferLogicalMigrationSteps,
  createIndexedDbRepositories,
  openCrSnifferDatabase,
  IndexedDbResourceHistoryReader,
  runLogicalMigrations,
  StorageQuotaMonitor,
  PersistenceError,
} from '../persistence/index.ts';
import { ResourceHistoryService } from '../resources/index.ts';
import { requireTrustedExtensionSender } from '../security/index.ts';
import {
  ChromePendingObservationStore,
  ChromeWebRequestCapture,
  ObservationLifecycle,
} from '../observations/index.ts';
import { ChromeHostAuthority, ChromeTabAuthority, type ChromeWatchRuntimeLike } from './chrome-ports.ts';
import { WatchConfigurationService } from './configuration.ts';
import { IndexedDbWatchRetentionStore, WatchRetentionService } from './retention.ts';
import { WatchController } from './controller.ts';
import { WatchLifecycleRepository } from './lifecycle-repository.ts';
import { WATCH_OPERATIONS, WatchMessageRouter } from './messages.ts';

interface ChromeRuntimeState {
  readonly controller: WatchController;
  readonly configurations: WatchConfigurationService;
  readonly capture: ChromeWebRequestCapture;
  readonly pageContexts: ChromePageContextCapture;
  readonly controlPlane: ControlPlaneMessageRouter;
  readonly controlPlanePorts: ControlPlanePortHub;
  readonly packagizerWorkspace: PackagizerWorkspaceService;
  readonly pageFieldWorkspace: PageFieldWorkspaceService;
}

function healthArea(error: unknown): RuntimeHealthArea {
  if (error instanceof PersistenceError) return 'storage';
  if (error instanceof ResourceEvaluationError || error instanceof PageFieldError) return 'evaluation';
  return 'capture';
}

function healthMessage(area: RuntimeHealthArea): string {
  if (area === 'storage') return 'Local storage could not commit a captured resource. Watch stopped to avoid claiming complete history; a terminal pending capture is retained for retry when possible.';
  if (area === 'evaluation') return 'A captured resource could not be evaluated. Watch remains active, but recent results may be incomplete.';
  return 'A background capture operation failed. Watch remains active, but recent capture may be incomplete.';
}

async function createRuntime(chromeApi: ChromeWatchRuntimeLike): Promise<ChromeRuntimeState> {
  const controlPlanePorts = new ControlPlanePortHub();
  const database = await openCrSnifferDatabase();
  const repositories = createIndexedDbRepositories(database);
  await runLogicalMigrations(repositories.meta, createCrSnifferLogicalMigrationSteps(repositories.meta));
  const tiers = createChromeStorageTiers(chromeApi.storage);
  const catalog = new DefinitionCatalog(repositories.definitions);
  const composer = new WatchSessionComposer(repositories.definitions, repositories.watchSessions);
  const tabAuthority = new ChromeTabAuthority(chromeApi.tabs);
  const lifecycleRepository = new WatchLifecycleRepository(repositories.meta);
  const pendingObservations = new ChromePendingObservationStore(chromeApi.storage.session);
  const retention = new WatchRetentionService({
    lifecycle: lifecycleRepository,
    store: new IndexedDbWatchRetentionStore(database),
    meta: repositories.meta,
  });
  const quota = new StorageQuotaMonitor();
  let settingsAuthority: SettingsService | undefined;
  const controller = new WatchController({
    catalog,
    composer,
    sessions: repositories.watchSessions,
    lifecycle: lifecycleRepository,
    sessionState: tiers.session,
    permissions: new ChromeHostAuthority(chromeApi.permissions),
    tabs: tabAuthority,
    onTerminated: async () => {
      const preferences = settingsAuthority === undefined
        ? DEFAULT_SETTINGS_PREFERENCES
        : await settingsAuthority.preferences();
      await retention.enforce(watchRetentionPolicyFromSettings(preferences), 'session_ended');
    },
  });
  const configurations = new WatchConfigurationService({
    catalog,
    sessions: repositories.watchSessions,
  });
  const health = new ControlPlaneHealthTracker();
  const pageContextRegistry = new PageContextRegistry(tiers.session);
  const pageFieldMessenger = chromeApi.tabs.sendMessage === undefined
    ? undefined
    : { sendMessage: (tabId: number, message: unknown) => chromeApi.tabs.sendMessage!(tabId, message) };
  const pageFieldReader = new ChromePageFieldReader(chromeApi.scripting, pageFieldMessenger);
  const pageFieldEvaluation = new PageFieldEvaluationService(pageContextRegistry, pageFieldReader);
  const pageFieldWorkspace = new PageFieldWorkspaceService({
    catalog,
    contexts: pageContextRegistry,
    evaluator: pageFieldEvaluation,
    assist: pageFieldReader,
  });
  const pageContexts = new ChromePageContextCapture({
    webNavigation: chromeApi.webNavigation,
    registry: pageContextRegistry,
    onBeforeContextChange: () => pageFieldWorkspace.clearAssist(),
  });
  const pageFieldSnapshots = new PageFieldSnapshotService({
    contexts: pageContextRegistry,
    evaluator: pageFieldEvaluation,
    documentFacts: pageFieldReader,
    snapshots: repositories.pageFieldSnapshots,
  });
  const evaluation = new ResourceEvaluationService(repositories.watchSessions, pageFieldSnapshots);
  const packagizerWorkspace = new PackagizerWorkspaceService({
    catalog,
    preview: new PackagizerResourcePreviewService({
      composer,
      observations: repositories.resourceObservations,
      evaluation,
    }),
  });
  const lifecycle = new ObservationLifecycle({
    observations: repositories.resourceObservations,
    pending: pendingObservations,
    sessionState: tiers.session,
    evaluate: async (record) => evaluation.evaluateObservation(record),
    attribute: async (details) => pageContextRegistry.attribute(details),
    onPersisted: () => {
      controlPlanePorts.broadcast('observation_persisted');
      if (health.recover()) controlPlanePorts.broadcast('runtime_recovered');
    },
  });
  let capture: ChromeWebRequestCapture;
  capture = new ChromeWebRequestCapture({
    webRequest: chromeApi.webRequest,
    lifecycle,
    onError: async (error) => {
      const area = healthArea(error);
      health.degrade(area, healthMessage(area));
      if (area === 'storage') {
        capture.suspend();
        const changed = await controller.handleStorageFailure();
        await pageContexts.sync(undefined).catch(() => undefined);
        if (changed) controlPlanePorts.broadcast('watch_changed');
      }
      controlPlanePorts.broadcast('runtime_degraded');
      console.error('crsniffer webRequest observation failed', error);
    },
  });
  const resourceHistory = new ResourceHistoryService(new IndexedDbResourceHistoryReader(database));
  const settings = new SettingsService({
    repositories,
    preferences: tiers.local,
    sessionState: tiers.session,
    pendingObservations,
    lifecycle: lifecycleRepository,
    watch: controller,
    catalog,
    retention,
    quota,
  });
  settingsAuthority = settings;
  await controller.reconcileOnStartup();
  const preferences = await settings.preferences();
  const storage = await quota.snapshot();
  await retention.enforce(
    watchRetentionPolicyFromSettings(preferences),
    storage.level === 'warning' || storage.level === 'critical' ? 'quota_pressure' : 'startup',
  );
  try {
    await lifecycle.resumeTerminalPending();
  } catch (error) {
    health.degrade('storage', healthMessage('storage'));
    controlPlanePorts.broadcast('runtime_degraded');
    console.error('crsniffer terminal observation recovery failed', error);
  }
  const active = (await controller.status()).active;
  await pageContexts.sync(active);
  await capture.sync(active);
  const controlPlane = new ControlPlaneMessageRouter(new ControlPlaneProjector({
    watch: controller,
    tabs: tabAuthority,
    activeWatch: configurations,
    health,
  }), resourceHistory, settings);
  return Object.freeze({ controller, configurations, capture, pageContexts, controlPlane, controlPlanePorts, packagizerWorkspace, pageFieldWorkspace });
}

function preparedStartTabId(message: unknown): number | undefined {
  try {
    const envelope = requireMessageEnvelope(message);
    if (envelope.kind !== 'request' || envelope.operation !== WATCH_OPERATIONS.start) return undefined;
    const tabId = envelope.payload.tabId;
    return Number.isSafeInteger(tabId) && (tabId as number) >= 0 ? tabId as number : undefined;
  } catch {
    return undefined;
  }
}

/** Register Watch capture, exact-document PageContext tracking, and shared live resource evaluation. */
export function registerChromeWatchRuntime(chromeApi: ChromeWatchRuntimeLike): Promise<WatchController> {
  const statePromise = createRuntime(chromeApi);

  chromeApi.tabs.onRemoved.addListener((tabId) => {
    void statePromise.then(async ({ controller, capture, pageContexts, controlPlanePorts, pageFieldWorkspace }) => {
      await pageFieldWorkspace.clearAssist().catch(() => undefined);
      const changed = await controller.handleTabClosed(tabId);
      const active = (await controller.status()).active;
      await pageContexts.sync(active);
      await capture.sync(active);
      if (changed) controlPlanePorts.broadcast('watch_changed');
    });
  });
  chromeApi.permissions.onRemoved.addListener(() => {
    void statePromise.then(async ({ controller, capture, pageContexts, controlPlanePorts, pageFieldWorkspace }) => {
      await pageFieldWorkspace.clearAssist().catch(() => undefined);
      const changed = await controller.handlePermissionChange();
      const active = (await controller.status()).active;
      await pageContexts.sync(active);
      await capture.sync(active);
      if (changed) controlPlanePorts.broadcast('watch_changed');
    });
  });
  chromeApi.runtime.onConnect.addListener((port) => {
    try {
      requireTrustedExtensionSender(port.sender, chromeApi.runtime.id);
    } catch {
      try { port.disconnect?.(); } catch { /* untrusted Port is already rejected */ }
      return;
    }
    void statePromise.then(({ controlPlanePorts }) => {
      controlPlanePorts.attach(port);
    });
  });
  chromeApi.runtime.onMessage.addListener((message, sender, sendResponse) => {
    try {
      requireTrustedExtensionSender(sender, chromeApi.runtime.id);
    } catch (error) {
      try {
        const request = requireMessageEnvelope(message);
        if (request.kind === 'request') sendResponse(createFailureResponse(request, toContractErrorPayload(error)));
      } catch {
        // Malformed or untrusted cross-extension input is intentionally ignored.
      }
      return true;
    }
    void statePromise
      .then(async ({ controller, configurations, capture, pageContexts, controlPlane, controlPlanePorts, packagizerWorkspace, pageFieldWorkspace }) => {
        const envelope = requireMessageEnvelope(message);
        const isControlPlane = envelope.kind === 'request'
          && (Object.values(CONTROL_PLANE_OPERATIONS) as readonly string[]).includes(envelope.operation);
        const isPackagizerWorkspace = envelope.kind === 'request'
          && (Object.values(PACKAGIZER_WORKSPACE_OPERATIONS) as readonly string[]).includes(envelope.operation);
        const isPageFieldWorkspace = envelope.kind === 'request'
          && (Object.values(PAGE_FIELD_WORKSPACE_OPERATIONS) as readonly string[]).includes(envelope.operation);
        const startTabId = preparedStartTabId(message);
        if (startTabId !== undefined) capture.prepare(startTabId);
        const response = isControlPlane
          ? await controlPlane.handle(message)
          : isPackagizerWorkspace
            ? await new PackagizerWorkspaceMessageRouter(packagizerWorkspace).handle(message)
            : isPageFieldWorkspace
              ? await new PageFieldWorkspaceMessageRouter(pageFieldWorkspace).handle(message)
              : await new WatchMessageRouter(controller, configurations).handle(message);
        const active = (await controller.status()).active;
        await pageContexts.sync(active);
        await capture.sync(active);
        if (!isControlPlane && !isPackagizerWorkspace && !isPageFieldWorkspace && envelope.kind === 'request' && (
          envelope.operation === WATCH_OPERATIONS.start
          || envelope.operation === WATCH_OPERATIONS.stop
        )) {
          controlPlanePorts.broadcast('watch_changed');
        }
        if (
          !isControlPlane
          && !isPackagizerWorkspace
          && !isPageFieldWorkspace
          && envelope.kind === 'request'
          && (
            envelope.operation === WATCH_OPERATIONS.saveConfiguration
            || envelope.operation === WATCH_OPERATIONS.deleteConfiguration
          )
          && response.kind === 'response'
          && response.outcome.ok
        ) {
          controlPlanePorts.broadcast('configuration_changed');
        }
        const packagizerMutation = envelope.kind === 'request' && (
          envelope.operation === PACKAGIZER_WORKSPACE_OPERATIONS.saveRule
          || envelope.operation === PACKAGIZER_WORKSPACE_OPERATIONS.saveTemplate
          || envelope.operation === PACKAGIZER_WORKSPACE_OPERATIONS.saveRuleOrder
          || envelope.operation === PACKAGIZER_WORKSPACE_OPERATIONS.deleteDefinition
        );
        if (
          isPackagizerWorkspace
          && packagizerMutation
          && response.kind === 'response'
          && response.outcome.ok
        ) {
          controlPlanePorts.broadcast('packagizer_changed');
          if (envelope.operation === PACKAGIZER_WORKSPACE_OPERATIONS.saveRuleOrder) {
            controlPlanePorts.broadcast('configuration_changed');
          }
        }

        const pageFieldMutation = envelope.kind === 'request'
          && (
            envelope.operation === PAGE_FIELD_WORKSPACE_OPERATIONS.save
            || envelope.operation === PAGE_FIELD_WORKSPACE_OPERATIONS.delete
          );
        if (
          isPageFieldWorkspace
          && pageFieldMutation
          && response.kind === 'response'
          && response.outcome.ok
        ) {
          controlPlanePorts.broadcast('packagizer_changed');
        }
        const settingsMutation = envelope.kind === 'request'
          && (
            envelope.operation === CONTROL_PLANE_OPERATIONS.settingsSave
            || envelope.operation === CONTROL_PLANE_OPERATIONS.settingsMaintain
            || envelope.operation === CONTROL_PLANE_OPERATIONS.settingsClear
          );
        if (isControlPlane && settingsMutation && response.kind === 'response' && response.outcome.ok) {
          controlPlanePorts.broadcast('settings_changed');
          if (envelope.operation === CONTROL_PLANE_OPERATIONS.settingsClear) {
            controlPlanePorts.broadcast('history_cleared');
          }
        }
        return response;
      })
      .then(sendResponse)
      .catch((error) => {
        try {
          const request = requireMessageEnvelope(message);
          if (request.kind === 'request') {
            sendResponse(createFailureResponse(request, toContractErrorPayload(error)));
          }
        } catch {
          // Invalid messages are intentionally ignored at the Chrome boundary.
        }
      });
    return true;
  });

  return statePromise.then(({ controller }) => controller);
}
</file>

