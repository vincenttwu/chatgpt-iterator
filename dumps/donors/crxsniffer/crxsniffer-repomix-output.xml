<file path="src/page-fields/validation.ts">
import {
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  requireJsonObject,
  type JsonObject,
  type JsonPrimitive,
  type JsonValue,
} from '../core/index.ts';
import type {
  FrozenDefinitionSnapshot,
  ImmutableWatchSessionRecord,
} from '../definitions/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from './errors.ts';
import {
  PAGE_FIELD_MAPPING_SCHEMA_VERSION,
  PAGE_FIELD_MAX_CANDIDATES,
  PAGE_FIELD_MAX_LIST_VALUES,
  PAGE_FIELD_MAX_STRING_LENGTH,
  PAGE_FIELD_MAX_TRANSFORMS,
  type PageFieldAcceptance,
  type PageFieldCandidate,
  type PageFieldCardinality,
  type PageFieldMappingBody,
  type PageFieldMappingDefinition,
  type PageFieldRead,
  type PageFieldReadKind,
  type PageFieldSelector,
  type PageFieldSelectorFamily,
  type PageFieldTransform,
  type PageFieldTransformKind,
  type PageFieldValidation,
  type PageFieldValidationType,
  type PageFieldValue,
} from './types.ts';

const SELECTOR_FAMILIES = new Set<PageFieldSelectorFamily>(['css', 'xpath']);
const READ_KINDS = new Set<PageFieldReadKind>(['text_content', 'inner_text', 'attribute', 'property', 'raw']);
const CARDINALITIES = new Set<PageFieldCardinality>(['first', 'optional_one', 'exact_one', 'many']);
const TRANSFORM_KINDS = new Set<PageFieldTransformKind>(['trim', 'lower', 'upper', 'slice', 'replace', 'to_string', 'join']);
const VALIDATION_TYPES = new Set<PageFieldValidationType>(['string', 'number', 'boolean', 'null', 'list']);
const SLUG_PATTERN = /^[a-z][a-z0-9_]{0,63}$/;
const PROPERTY_PATTERN = /^[A-Za-z_$][A-Za-z0-9_$]{0,63}$/;
const NAMESPACE_PREFIX_PATTERN = /^[A-Za-z_][A-Za-z0-9._-]{0,63}$/;
const MAPPING_KEYS = new Set(['schemaVersion', 'slug', 'candidates', 'defaultValue', 'required', 'validation']);
const CANDIDATE_KEYS = new Set(['selector', 'read', 'cardinality', 'transforms', 'accept']);
const SELECTOR_KEYS = new Set(['family', 'query', 'namespaces']);
const READ_KEYS = new Set(['kind', 'name']);
const TRANSFORM_KEYS = new Set(['kind', 'start', 'end', 'search', 'replacement', 'separator']);
const ACCEPTANCE_KEYS = new Set(['rejectBlank', 'rejectEmptyList']);
const VALIDATION_KEYS = new Set(['valueType', 'nonBlank', 'minLength', 'maxLength']);

function rejectUnknownKeys(record: Readonly<Record<string, unknown>>, allowed: ReadonlySet<string>, label: string): void {
  for (const key of Object.keys(record)) if (!allowed.has(key)) invalid(`unsupported ${label} field: ${key}`);
}

function invalid(message: string): never {
  throw new PageFieldError(PAGE_FIELD_ERROR_CODES.invalidMapping, message);
}

function requireString(value: unknown, label: string, max = PAGE_FIELD_MAX_STRING_LENGTH): string {
  if (typeof value !== 'string' || value.length === 0 || value.length > max) invalid(`${label} must be a non-empty string <= ${max}`);
  return value;
}

function optionalBoolean(value: unknown, label: string): boolean | undefined {
  if (value === undefined) return undefined;
  if (typeof value !== 'boolean') invalid(`${label} must be boolean`);
  return value;
}

function optionalBoundedInteger(value: unknown, label: string): number | undefined {
  if (value === undefined) return undefined;
  if (!Number.isSafeInteger(value) || Math.abs(value as number) > 1_000_000) invalid(`${label} must be a bounded safe integer`);
  return value as number;
}

function optionalLength(value: unknown, label: string): number | undefined {
  if (value === undefined) return undefined;
  if (!Number.isSafeInteger(value) || (value as number) < 0 || (value as number) > PAGE_FIELD_MAX_STRING_LENGTH) {
    invalid(`${label} must be a safe integer between 0 and ${PAGE_FIELD_MAX_STRING_LENGTH}`);
  }
  return value as number;
}

function isPrimitive(value: JsonValue): value is JsonPrimitive {
  return value === null || typeof value === 'string' || typeof value === 'boolean' || typeof value === 'number';
}

export function requirePageFieldValue(value: unknown, label = 'value'): PageFieldValue {
  assertJsonSafe(value);
  if (isPrimitive(value)) {
    if (typeof value === 'string' && value.length > PAGE_FIELD_MAX_STRING_LENGTH) invalid(`${label} string is too long`);
    return value;
  }
  if (!Array.isArray(value) || value.length > PAGE_FIELD_MAX_LIST_VALUES) invalid(`${label} must be a primitive or bounded primitive list`);
  const normalized: JsonPrimitive[] = [];
  for (const [index, item] of value.entries()) {
    if (!isPrimitive(item)) invalid(`${label}[${index}] must be primitive`);
    if (typeof item === 'string' && item.length > PAGE_FIELD_MAX_STRING_LENGTH) invalid(`${label}[${index}] string is too long`);
    normalized.push(item);
  }
  return Object.freeze(normalized);
}

function requireNamespaces(value: unknown): JsonObject | undefined {
  if (value === undefined) return undefined;
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  const entries = Object.entries(record);
  if (entries.length > 16) invalid('XPath namespaces must contain at most 16 prefixes');
  const normalized: Record<string, string> = {};
  for (const [prefix, uri] of entries) {
    if (!NAMESPACE_PREFIX_PATTERN.test(prefix)) invalid(`invalid XPath namespace prefix: ${prefix}`);
    normalized[prefix] = requireString(uri, `namespace ${prefix}`, 2048);
  }
  return freezeJsonValue(normalized);
}

export function requirePageFieldSelector(value: unknown): PageFieldSelector {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, SELECTOR_KEYS, 'selector');
  if (typeof record.family !== 'string' || !SELECTOR_FAMILIES.has(record.family as PageFieldSelectorFamily)) invalid('selector.family is unsupported');
  const family = record.family as PageFieldSelectorFamily;
  const query = requireString(record.query, 'selector.query', 4096);
  const namespaces = requireNamespaces(record.namespaces);
  if (family === 'css' && namespaces !== undefined) invalid('CSS selectors must not define XPath namespaces');
  return freezeJsonValue({ family, query, ...(namespaces === undefined ? {} : { namespaces }) });
}

export function requirePageFieldRead(value: unknown, family: PageFieldSelectorFamily): PageFieldRead {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, READ_KEYS, 'read');
  if (typeof record.kind !== 'string' || !READ_KINDS.has(record.kind as PageFieldReadKind)) invalid('read.kind is unsupported');
  const kind = record.kind as PageFieldReadKind;
  const needsName = kind === 'attribute' || kind === 'property';
  const name = record.name === undefined ? undefined : requireString(record.name, 'read.name', 128);
  if (needsName && name === undefined) invalid(`${kind} read requires name`);
  if (!needsName && name !== undefined) invalid(`${kind} read must not define name`);
  if (kind === 'property' && !PROPERTY_PATTERN.test(name!)) invalid('property read requires one direct primitive property name');
  if (family === 'css' && kind === 'raw') invalid('raw read is only valid for XPath scalar results');
  return freezeJsonValue({ kind, ...(name === undefined ? {} : { name }) });
}

export function requirePageFieldTransform(value: unknown): PageFieldTransform {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, TRANSFORM_KEYS, 'transform');
  if (typeof record.kind !== 'string' || !TRANSFORM_KINDS.has(record.kind as PageFieldTransformKind)) invalid('transform.kind is unsupported');
  const kind = record.kind as PageFieldTransformKind;
  const start = optionalBoundedInteger(record.start, 'transform.start');
  const end = optionalBoundedInteger(record.end, 'transform.end');
  const search = record.search === undefined ? undefined : requireString(record.search, 'transform.search', 1024);
  const replacement = record.replacement === undefined ? undefined : (typeof record.replacement === 'string' && record.replacement.length <= 1024 ? record.replacement : invalid('transform.replacement must be a string <= 1024'));
  const separator = record.separator === undefined ? undefined : (typeof record.separator === 'string' && record.separator.length <= 256 ? record.separator : invalid('transform.separator must be a string <= 256'));

  if (kind === 'slice') {
    if (start === undefined) invalid('slice requires start');
    if (search !== undefined || replacement !== undefined || separator !== undefined) invalid('slice has incompatible arguments');
  } else if (kind === 'replace') {
    if (search === undefined || replacement === undefined) invalid('replace requires search and replacement');
    if (start !== undefined || end !== undefined || separator !== undefined) invalid('replace has incompatible arguments');
  } else if (kind === 'join') {
    if (separator === undefined) invalid('join requires separator');
    if (start !== undefined || end !== undefined || search !== undefined || replacement !== undefined) invalid('join has incompatible arguments');
  } else if (start !== undefined || end !== undefined || search !== undefined || replacement !== undefined || separator !== undefined) {
    invalid(`${kind} does not accept arguments`);
  }
  return freezeJsonValue({
    kind,
    ...(start === undefined ? {} : { start }),
    ...(end === undefined ? {} : { end }),
    ...(search === undefined ? {} : { search }),
    ...(replacement === undefined ? {} : { replacement }),
    ...(separator === undefined ? {} : { separator }),
  });
}

function requireAcceptance(value: unknown): PageFieldAcceptance {
  if (value === undefined) return freezeJsonValue({});
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, ACCEPTANCE_KEYS, 'acceptance');
  const rejectBlank = optionalBoolean(record.rejectBlank, 'accept.rejectBlank');
  const rejectEmptyList = optionalBoolean(record.rejectEmptyList, 'accept.rejectEmptyList');
  return freezeJsonValue({
    ...(rejectBlank === undefined ? {} : { rejectBlank }),
    ...(rejectEmptyList === undefined ? {} : { rejectEmptyList }),
  });
}

export function requirePageFieldCandidate(value: unknown): PageFieldCandidate {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, CANDIDATE_KEYS, 'candidate');
  const selector = requirePageFieldSelector(record.selector);
  const read = requirePageFieldRead(record.read, selector.family);
  if (typeof record.cardinality !== 'string' || !CARDINALITIES.has(record.cardinality as PageFieldCardinality)) invalid('candidate.cardinality is unsupported');
  if (!Array.isArray(record.transforms) || record.transforms.length > PAGE_FIELD_MAX_TRANSFORMS) invalid(`candidate.transforms must be an array <= ${PAGE_FIELD_MAX_TRANSFORMS}`);
  const transforms = Object.freeze(record.transforms.map(requirePageFieldTransform));
  return freezeJsonValue({
    selector,
    read,
    cardinality: record.cardinality as PageFieldCardinality,
    transforms,
    accept: requireAcceptance(record.accept),
  });
}

function requireValidation(value: unknown): PageFieldValidation {
  if (value === undefined) return freezeJsonValue({});
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, VALIDATION_KEYS, 'validation');
  let valueType: PageFieldValidationType | undefined;
  if (record.valueType !== undefined) {
    if (typeof record.valueType !== 'string' || !VALIDATION_TYPES.has(record.valueType as PageFieldValidationType)) invalid('validation.valueType is unsupported');
    valueType = record.valueType as PageFieldValidationType;
  }
  const nonBlank = optionalBoolean(record.nonBlank, 'validation.nonBlank');
  const minLength = optionalLength(record.minLength, 'validation.minLength');
  const maxLength = optionalLength(record.maxLength, 'validation.maxLength');
  if (minLength !== undefined && maxLength !== undefined && minLength > maxLength) invalid('validation minLength must not exceed maxLength');
  if (nonBlank === true && valueType !== undefined && valueType !== 'string') invalid('validation.nonBlank requires string valueType');
  if ((minLength !== undefined || maxLength !== undefined) && valueType !== undefined && valueType !== 'string' && valueType !== 'list') invalid('length validation requires string or list valueType');
  return freezeJsonValue({
    ...(valueType === undefined ? {} : { valueType }),
    ...(nonBlank === undefined ? {} : { nonBlank }),
    ...(minLength === undefined ? {} : { minLength }),
    ...(maxLength === undefined ? {} : { maxLength }),
  });
}

export function requirePageFieldMappingBody(value: unknown): PageFieldMappingBody {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, MAPPING_KEYS, 'mapping');
  if (record.schemaVersion !== PAGE_FIELD_MAPPING_SCHEMA_VERSION) invalid('unsupported PageFieldMapping schemaVersion');
  const slug = requireString(record.slug, 'mapping.slug', 64);
  if (!SLUG_PATTERN.test(slug)) invalid('mapping.slug must be a lowercase token slug');
  if (!Array.isArray(record.candidates) || record.candidates.length === 0 || record.candidates.length > PAGE_FIELD_MAX_CANDIDATES) {
    invalid(`mapping.candidates must contain 1..${PAGE_FIELD_MAX_CANDIDATES} candidates`);
  }
  const defaultValue = record.defaultValue === undefined ? undefined : requirePageFieldValue(record.defaultValue, 'defaultValue');
  if (record.required !== undefined && typeof record.required !== 'boolean') invalid('mapping.required must be boolean');
  return freezeJsonValue({
    schemaVersion: PAGE_FIELD_MAPPING_SCHEMA_VERSION,
    slug,
    candidates: Object.freeze(record.candidates.map(requirePageFieldCandidate)),
    ...(defaultValue === undefined ? {} : { defaultValue: cloneJsonValue(defaultValue) }),
    required: record.required ?? false,
    validation: requireValidation(record.validation),
  });
}

export function requirePageFieldMappingDefinition(snapshot: FrozenDefinitionSnapshot): PageFieldMappingDefinition {
  if (snapshot.kind !== 'pageFieldMapping') invalid('definition must be pageFieldMapping');
  return Object.freeze({ snapshot, body: requirePageFieldMappingBody(snapshot.value.body) });
}

export function validateWatchSessionPageFieldMappings(session: ImmutableWatchSessionRecord): void {
  const slugs = new Set<string>();
  for (const definition of session.value.definitions) {
    if (definition.kind !== 'pageFieldMapping' || !definition.value.enabled) continue;
    const mapping = requirePageFieldMappingDefinition(definition);
    if (slugs.has(mapping.body.slug)) invalid(`duplicate frozen PageFieldMapping slug: ${mapping.body.slug}`);
    slugs.add(mapping.body.slug);
  }
}
