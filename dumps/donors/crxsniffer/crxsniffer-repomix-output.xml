import {
  MISSING,
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  requireJsonObject,
  requireRevision,
  requireStableId,
  type JsonObject,
  type StableId,
} from '../core/index.ts';
import { requireImmutableWatchSessionRecord, type ImmutableWatchSessionRecord } from '../definitions/index.ts';
import type { PackagizerPageContext } from '../packagizer/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  requireIsoTimestamp,
  requirePageFieldSnapshotRecord,
  type IsoTimestamp,
  type JsonRecordRepository,
  type PageFieldSnapshotRecord,
  type ResourceObservationRecord,
} from '../persistence/index.ts';
import type {
  PageContextAttributableObservation,
  PageContextResolution,
  PageContextValue,
} from '../page-context/index.ts';
import { requireResourceObservationValue } from '../observations/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError, type PageFieldErrorCode } from './errors.ts';
import { resolveWatchSessionPageFieldDependencies, type PageFieldDependencyPlan } from './dependencies.ts';
import type { PageFieldEvaluationService } from './service.ts';
import type {
  ImmutablePageFieldSnapshotRecord,
  PageFieldDocumentFactsReader,
  PageFieldEnrichmentResult,
  PageFieldSnapshotFieldFact,
  PageFieldSnapshotPageFacts,
  PageFieldSnapshotPersistOptions,
  PageFieldSnapshotTitleFact,
  PageFieldSnapshotValue,
} from './snapshot-types.ts';
import type { PageFieldEvaluationResult, PageFieldValue } from './types.ts';

const DIGEST_PATTERN = /^sha256:[0-9a-f]{64}$/;
const SLUG_PATTERN = /^[a-z][a-z0-9_]{0,63}$/;
const ERROR_CODE_SET = new Set<string>(Object.values(PAGE_FIELD_ERROR_CODES));

export interface PageFieldSnapshotContextPort {
  current(): Promise<PageContextValue | undefined>;
  resolveObservation(observation: PageContextAttributableObservation): Promise<PageContextResolution>;
}

export interface PageFieldSnapshotServiceOptions {
  readonly contexts: PageFieldSnapshotContextPort;
  readonly evaluator: PageFieldEvaluationService;
  readonly documentFacts: PageFieldDocumentFactsReader;
  readonly snapshots: JsonRecordRepository<PageFieldSnapshotRecord>;
  readonly now?: () => IsoTimestamp;
}

function requireDigest(value: unknown, label: string): string {
  if (typeof value !== 'string' || !DIGEST_PATTERN.test(value)) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, `${label} must be a canonical SHA-256 digest`);
  }
  return value;
}

function requireString(value: unknown, label: string): string {
  if (typeof value !== 'string') {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, `${label} must be a string`);
  }
  return value;
}


function requireObject(value: import('../core/index.ts').JsonValue | undefined, label: string): JsonObject {
  if (value === undefined) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, `${label} is required`);
  }
  return requireJsonObject(value);
}

function requireErrorCode(value: unknown): PageFieldErrorCode {
  if (typeof value !== 'string' || !ERROR_CODE_SET.has(value)) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot errorCode is unsupported');
  }
  return value as PageFieldErrorCode;
}

function requirePageFieldValue(value: unknown): PageFieldValue {
  assertJsonSafe(value);
  if (Array.isArray(value)) {
    for (const item of value) {
      if (!(item === null || typeof item === 'string' || typeof item === 'number' || typeof item === 'boolean')) {
        throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot list field values must be JSON primitives');
      }
    }
    return Object.freeze([...value]) as PageFieldValue;
  }
  if (value === null || typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
    return value as PageFieldValue;
  }
  throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot field value must be a primitive or primitive list');
}

function requireTitleFact(value: unknown): PageFieldSnapshotTitleFact {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (record.status === 'value') {
    return freezeJsonValue({ status: 'value', value: requireString(record.value, 'page.title') });
  }
  if (record.status === 'error') {
    return freezeJsonValue({ status: 'error', errorCode: requireErrorCode(record.errorCode) });
  }
  throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot page.title status is unsupported');
}

function requireFieldFact(value: unknown): PageFieldSnapshotFieldFact {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  const slug = requireString(record.slug, 'field.slug');
  if (!SLUG_PATTERN.test(slug)) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot field slug is invalid');
  }
  const mappingRecord = requireObject(record.mapping, 'field.mapping');
  const mapping = freezeJsonValue({
    definitionId: requireStableId(mappingRecord.definitionId, 'definition'),
    revision: requireRevision(mappingRecord.revision),
    digest: requireDigest(mappingRecord.digest, 'mapping.digest'),
  });
  if (!Array.isArray(record.trace)) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot field trace must be an array');
  }
  assertJsonSafe(record.trace);
  const trace = freezeJsonValue(cloneJsonValue(record.trace));
  if (record.status === 'value') {
    const source = record.source;
    if (source !== 'candidate' && source !== 'default') {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot value source is unsupported');
    }
    const selectedCandidateIndex = record.selectedCandidateIndex;
    if (selectedCandidateIndex !== undefined && (!Number.isSafeInteger(selectedCandidateIndex) || (selectedCandidateIndex as number) < 0)) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'selectedCandidateIndex must be a non-negative safe integer');
    }
    return freezeJsonValue({
      slug,
      mapping,
      status: 'value',
      value: cloneJsonValue(requirePageFieldValue(record.value)),
      source,
      ...(selectedCandidateIndex === undefined ? {} : { selectedCandidateIndex: selectedCandidateIndex as number }),
      trace,
    }) as PageFieldSnapshotFieldFact;
  }
  if (record.status === 'missing') {
    return freezeJsonValue({ slug, mapping, status: 'missing', trace }) as PageFieldSnapshotFieldFact;
  }
  if (record.status === 'error') {
    return freezeJsonValue({
      slug,
      mapping,
      status: 'error',
      errorCode: requireErrorCode(record.errorCode),
      trace,
    }) as PageFieldSnapshotFieldFact;
  }
  throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot field status is unsupported');
}

export function requirePageFieldSnapshotValue(value: unknown): PageFieldSnapshotValue {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (record.schemaVersion !== 1) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'unsupported PageFieldSnapshot value schemaVersion');
  }
  const pageRecord = requireObject(record.page, 'page');
  const page: PageFieldSnapshotPageFacts = freezeJsonValue({
    url: requireString(pageRecord.url, 'page.url'),
    origin: requireString(pageRecord.origin, 'page.origin'),
    ...(pageRecord.title === undefined ? {} : { title: requireTitleFact(pageRecord.title) }),
  });
  if (!Array.isArray(record.fields)) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot fields must be an array');
  }
  const fields = Object.freeze(record.fields.map(requireFieldFact));
  if (new Set(fields.map((field) => field.slug)).size !== fields.length) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'snapshot field slugs must be unique');
  }
  return freezeJsonValue({
    schemaVersion: 1,
    definitionSetDigest: requireDigest(record.definitionSetDigest, 'definitionSetDigest'),
    page,
    fields,
  }) as PageFieldSnapshotValue;
}

export function requireImmutablePageFieldSnapshotRecord(value: unknown): ImmutablePageFieldSnapshotRecord {
  const base = requirePageFieldSnapshotRecord(value);
  return freezeJsonValue({
    ...base,
    value: requirePageFieldSnapshotValue(base.value),
  }) as ImmutablePageFieldSnapshotRecord;
}

export function pageFieldSnapshotIdForObservation(
  observationId: StableId<'resourceObservation'>,
): StableId<'pageFieldSnapshot'> {
  return requireStableId(`pfs_${observationId.slice('obs_'.length)}`, 'pageFieldSnapshot');
}

function errorCode(error: unknown): PageFieldErrorCode {
  return error instanceof PageFieldError ? error.code : PAGE_FIELD_ERROR_CODES.readFailed;
}

function titleFactFromError(error: unknown): PageFieldSnapshotTitleFact {
  return freezeJsonValue({ status: 'error', errorCode: errorCode(error) });
}

function fieldFact(
  mapping: PageFieldDependencyPlan['mappings'][number],
  result: PageFieldEvaluationResult,
): PageFieldSnapshotFieldFact {
  const authority = freezeJsonValue({
    definitionId: mapping.snapshot.id,
    revision: mapping.snapshot.revision,
    digest: mapping.snapshot.digest,
  });
  if (result.status === 'value') {
    return freezeJsonValue({
      slug: mapping.body.slug,
      mapping: authority,
      status: 'value',
      value: cloneJsonValue(result.value),
      source: result.source,
      ...(result.selectedCandidateIndex === undefined ? {} : { selectedCandidateIndex: result.selectedCandidateIndex }),
      trace: result.trace,
    }) as PageFieldSnapshotFieldFact;
  }
  if (result.status === 'missing') {
    return freezeJsonValue({
      slug: mapping.body.slug,
      mapping: authority,
      status: 'missing',
      trace: result.trace,
    }) as PageFieldSnapshotFieldFact;
  }
  return freezeJsonValue({
    slug: mapping.body.slug,
    mapping: authority,
    status: 'error',
    errorCode: result.code,
    trace: result.trace,
  }) as PageFieldSnapshotFieldFact;
}

function pageFromSnapshot(snapshot: ImmutablePageFieldSnapshotRecord): PackagizerPageContext {
  const fields: Record<string, import('../core/index.ts').MaybeJsonValue> = {};
  for (const field of snapshot.value.fields) {
    fields[field.slug] = field.status === 'value' ? field.value! : MISSING;
  }
  const title = snapshot.value.page.title;
  return Object.freeze({
    url: snapshot.value.page.url,
    origin: snapshot.value.page.origin,
    ...(title === undefined ? {} : { title: title.status === 'value' ? title.value! : MISSING }),
    ...(snapshot.value.fields.length === 0 ? {} : { fields: Object.freeze(fields) }),
  });
}

function sameSnapshotAuthority(
  snapshot: ImmutablePageFieldSnapshotRecord,
  session: ImmutableWatchSessionRecord,
  context: PageContextValue,
  plan: PageFieldDependencyPlan,
): boolean {
  if (
    snapshot.watchSessionId !== session.id ||
    snapshot.documentId !== context.topDocumentId ||
    snapshot.pageRevision !== context.pageRevision ||
    snapshot.value.definitionSetDigest !== session.value.definitionSetDigest
  ) return false;
  if (plan.pageTokens.includes('page.title') !== (snapshot.value.page.title !== undefined)) return false;
  const slugs = snapshot.value.fields.map((field) => field.slug);
  return slugs.length === plan.fieldSlugs.length && slugs.every((slug, index) => slug === plan.fieldSlugs[index]);
}

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString());
}

/**
 * On-demand exact-document PageFieldSnapshot builder shared by live evaluation and Preview.
 * Live calls persist; Preview may request a transient snapshot without changing semantics.
 */
export class PageFieldSnapshotService {
  readonly #contexts: PageFieldSnapshotContextPort;
  readonly #evaluator: PageFieldEvaluationService;
  readonly #documentFacts: PageFieldDocumentFactsReader;
  readonly #snapshots: JsonRecordRepository<PageFieldSnapshotRecord>;
  readonly #now: () => IsoTimestamp;

  constructor(options: PageFieldSnapshotServiceOptions) {
    this.#contexts = options.contexts;
    this.#evaluator = options.evaluator;
    this.#documentFacts = options.documentFacts;
    this.#snapshots = options.snapshots;
    this.#now = options.now ?? defaultNow;
  }

  async prepare(
    sessionInput: ImmutableWatchSessionRecord,
    observation: ResourceObservationRecord,
    options: PageFieldSnapshotPersistOptions = {},
  ): Promise<PageFieldEnrichmentResult> {
    const session = requireImmutableWatchSessionRecord(sessionInput);
    const plan = resolveWatchSessionPageFieldDependencies(session);
    if (!plan.required) return Object.freeze({ status: 'not_required' as const });

    const observationValue = requireResourceObservationValue(observation.value);
    const resolution = await this.#contexts.resolveObservation(observationValue);
    if (resolution.status !== 'exact') {
      return Object.freeze({ status: resolution.status });
    }
    if (resolution.context === undefined) {
      return Object.freeze({ status: 'unavailable' as const });
    }
    const context = resolution.context;
    const snapshotId = pageFieldSnapshotIdForObservation(observation.id);
    const existing = await this.#snapshots.get(snapshotId);
    if (existing !== undefined) {
      const snapshot = requireImmutablePageFieldSnapshotRecord(existing);
      if (!sameSnapshotAuthority(snapshot, session, context, plan)) {
        throw new PageFieldError(PAGE_FIELD_ERROR_CODES.snapshotConflict, 'existing PageFieldSnapshot authority does not match this observation');
      }
      return Object.freeze({
        status: 'snapshot' as const,
        page: pageFromSnapshot(snapshot),
        snapshotId,
        snapshot,
        persisted: true,
      });
    }

    let title: PageFieldSnapshotTitleFact | undefined;
    if (plan.pageTokens.includes('page.title')) {
      try {
        title = freezeJsonValue({ status: 'value' as const, value: await this.#documentFacts.readTitle(context) });
      } catch (error) {
        title = titleFactFromError(error);
      }
    }

    const fields: PageFieldSnapshotFieldFact[] = [];
    for (const mapping of plan.mappings) {
      const result = await this.#evaluator.evaluate({ context, mapping });
      fields.push(fieldFact(mapping, result));
    }

    const finalResolution = await this.#contexts.resolveObservation(observationValue);
    if (finalResolution.status !== 'exact') {
      return Object.freeze({ status: finalResolution.status });
    }
    if (finalResolution.context === undefined) {
      return Object.freeze({ status: 'unavailable' as const });
    }
    if (
      finalResolution.context.topDocumentId !== context.topDocumentId ||
      finalResolution.context.pageRevision !== context.pageRevision
    ) {
      return Object.freeze({ status: 'revision_stale' as const });
    }

    const capturedAt = requireIsoTimestamp(this.#now(), 'capturedAt');
    const value: PageFieldSnapshotValue = requirePageFieldSnapshotValue({
      schemaVersion: 1,
      definitionSetDigest: session.value.definitionSetDigest,
      page: {
        url: context.url,
        origin: context.origin,
        ...(title === undefined ? {} : { title }),
      },
      fields,
    });
    const snapshot = requireImmutablePageFieldSnapshotRecord({
      schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
      id: snapshotId,
      watchSessionId: session.id,
      documentId: context.topDocumentId,
      pageRevision: context.pageRevision,
      capturedAt,
      value,
    });
    const persist = options.persist ?? true;
    if (persist) await this.#snapshots.put(snapshot);
    return Object.freeze({
      status: 'snapshot' as const,
      page: pageFromSnapshot(snapshot),
      snapshotId,
      snapshot,
      persisted: persist,
    });
  }
}
