<file path="tests/packagizer/packagizer.test.ts">
import assert from 'node:assert/strict';
import test from 'node:test';

import {
  MISSING,
  createStableId,
  type JsonObject,
} from '../../src/core/index.ts';
import {
  DefinitionCatalog,
  WatchSessionComposer,
  type ImmutableWatchSessionRecord,
} from '../../src/definitions/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  PERSISTENCE_STORES,
  JsonRecordRepository,
  requireDefinitionRecord,
  requireIsoTimestamp,
  requireWatchSessionRecord,
  type DefinitionRecord,
  type RepositoryStorePort,
  type ResourceObservationRecord,
  type WatchSessionRecord,
} from '../../src/persistence/index.ts';
import type { ResourceObservationValue } from '../../src/observations/index.ts';
import {
  evaluateResourceObservation,
  type ResourceOccurrenceProjection,
} from '../../src/resources/index.ts';
import {
  PACKAGIZER_DERIVED_ACTION_REGISTRY,
  PACKAGIZER_ERROR_CODES,
  PackagizerError,
  evaluatePackagizer,
  evaluatePackagizerCondition,
  parsePackagizerTemplate,
  renderPackagizerTemplate,
  requirePackagizerRuleBody,
  requirePackagizerTemplateBody,
  resolvePackagizerToken,
  resolveWatchSessionPackagizerRules,
  validateWatchSessionPackagizer,
  type PackagizerRuleBody,
} from '../../src/packagizer/index.ts';

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();

  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }

  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('memory store requires id or key');
    this.values.set(key, structuredClone(value));
  }

  async delete(key: string): Promise<void> {
    this.values.delete(key);
  }

  async getAll(): Promise<readonly unknown[]> {
    return [...this.values.values()].map((value) => structuredClone(value));
  }
}

const IDS = {
  watch: createStableId('definition', () => 'a0000000-0000-4000-8000-000000000001'),
  ruleA: createStableId('definition', () => 'a0000000-0000-4000-8000-000000000009'),
  ruleB: createStableId('definition', () => 'a0000000-0000-4000-8000-000000000002'),
  ruleC: createStableId('definition', () => 'a0000000-0000-4000-8000-000000000003'),
  templateA: createStableId('definition', () => 'b0000000-0000-4000-8000-000000000001'),
  templateB: createStableId('definition', () => 'b0000000-0000-4000-8000-000000000002'),
  templateC: createStableId('definition', () => 'b0000000-0000-4000-8000-000000000003'),
  templateMissing: createStableId('definition', () => 'b0000000-0000-4000-8000-000000000004'),
  mapping: createStableId('definition', () => 'c0000000-0000-4000-8000-000000000001'),
  session: createStableId('watchSession', () => 'd0000000-0000-4000-8000-000000000001'),
  observation: createStableId('resourceObservation', () => 'e0000000-0000-4000-8000-000000000001'),
};

const T0 = requireIsoTimestamp('2026-08-19T14:00:00.000Z');
const T1 = requireIsoTimestamp('2026-08-19T14:00:01.000Z');

function repositories() {
  const definitionsMemory = new MemoryStore();
  const sessionsMemory = new MemoryStore();
  return {
    definitions: new JsonRecordRepository<DefinitionRecord>(
      PERSISTENCE_STORES.definitions,
      definitionsMemory,
      requireDefinitionRecord,
    ),
    sessions: new JsonRecordRepository<WatchSessionRecord>(
      PERSISTENCE_STORES.watchSessions,
      sessionsMemory,
      requireWatchSessionRecord,
    ),
  };
}

function ruleBody(
  conditions: PackagizerRuleBody['conditions'],
  actions: PackagizerRuleBody['actions'],
  stopAfterSuccess = false,
): PackagizerRuleBody {
  return requirePackagizerRuleBody({ schemaVersion: 1, conditions, actions, stopAfterSuccess });
}

async function createSession(options: {
  readonly rules: readonly {
    id: typeof IDS.ruleA;
    name: string;
    body: PackagizerRuleBody | JsonObject;
    templates: readonly { id: typeof IDS.templateA; text: string; enabled?: boolean; references?: readonly { id: typeof IDS.mapping; kind: 'pageFieldMapping' }[] }[];
    enabled?: boolean;
    omitTemplateReference?: boolean;
  }[];
  readonly directTemplates?: readonly { id: typeof IDS.templateA; text: string }[];
}): Promise<ImmutableWatchSessionRecord> {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({ id: IDS.mapping, kind: 'pageFieldMapping', name: 'Episode', body: { slug: 'episode' }, timestamp: T0 });

  const createdTemplates = new Set<string>();
  const ensureTemplate = async (template: { id: typeof IDS.templateA; text: string; enabled?: boolean; references?: readonly { id: typeof IDS.mapping; kind: 'pageFieldMapping' }[] }) => {
    if (createdTemplates.has(template.id)) return;
    await catalog.create({
      id: template.id,
      kind: 'template',
      name: `Template ${template.id}`,
      enabled: template.enabled,
      body: { schemaVersion: 1, text: template.text },
      references: template.references,
      timestamp: T0,
    });
    createdTemplates.add(template.id);
  };

  for (const template of options.directTemplates ?? []) await ensureTemplate(template);
  for (const rule of options.rules) {
    for (const template of rule.templates) await ensureTemplate(template);
    await catalog.create({
      id: rule.id,
      kind: 'packagizerRule',
      name: rule.name,
      enabled: rule.enabled,
      body: rule.body,
      references: rule.omitTemplateReference
        ? []
        : rule.templates.map((template) => ({ id: template.id, kind: 'template' as const })),
      timestamp: T0,
    });
  }

  await catalog.create({
    id: IDS.watch,
    kind: 'watch',
    name: 'Watch',
    references: [
      ...options.rules.map((rule) => ({ id: rule.id, kind: 'packagizerRule' as const })),
      ...(options.directTemplates ?? []).map((template) => ({ id: template.id, kind: 'template' as const })),
    ],
    timestamp: T0,
  });
  return new WatchSessionComposer(repos.definitions, repos.sessions).compose({
    id: IDS.session,
    watchDefinitionId: IDS.watch,
    timestamp: T0,
  });
}

function observationValue(overrides: Partial<ResourceObservationValue> = {}): ResourceObservationValue {
  return {
    schemaVersion: 1,
    requestId: 'pack-request-1',
    tabId: 4,
    method: 'GET',
    requestType: 'media',
    startedAt: T0,
    endedAt: T1,
    startedWithBeforeRequest: true,
    initialUrl: 'https://CDN.example.test/media/My Video.mp4?token=A#start',
    finalUrl: 'https://cdn.example.test/media/My%20Video.mp4?token=A#end',
    frameId: 0,
    documentId: 'doc-pack',
    responseStatusCode: 206,
    responseMimeType: 'video/mp4',
    hops: [],
    terminal: { kind: 'completed', at: T1, statusCode: 206 },
    ...overrides,
  };
}

function input(session: ImmutableWatchSessionRecord, overrides: Partial<ResourceObservationValue> = {}, page?: Parameters<typeof resolvePackagizerToken>[1]['page']) {
  const value = observationValue(overrides);
  const observation: ResourceObservationRecord = {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: IDS.observation,
    watchSessionId: session.id,
    observedAt: T1,
    value,
  };
  const occurrence = evaluateResourceObservation(observation);
  return {
    session,
    occurrence,
    observation,
    watchStartedAt: T0,
    ...(page === undefined ? {} : { page }),
  };
}

test('rules follow frozen Watch reference order and later successful actions may overwrite derived fields', async () => {
  const first = ruleBody(
    [{ id: 'video', token: 'resource.kind', operator: 'equals', value: 'video' }],
    [{ id: 'group', type: 'set_group', templateId: IDS.templateA }],
  );
  const second = ruleBody(
    [
      { id: 'status_low', token: 'resource.status', operator: 'gte', value: 200 },
      { id: 'status_high', token: 'resource.status', operator: 'lt', value: 300 },
    ],
    [
      { id: 'group', type: 'set_group', templateId: IDS.templateB },
      { id: 'filename', type: 'set_filename', templateId: IDS.templateC },
    ],
  );
  const session = await createSession({ rules: [
    { id: IDS.ruleA, name: 'First despite higher ID', body: first, templates: [{ id: IDS.templateA, text: '${resource.host|upper}' }] },
    { id: IDS.ruleB, name: 'Second despite lower ID', body: second, templates: [
      { id: IDS.templateB, text: 'video-${resource.basename}' },
      { id: IDS.templateC, text: '${resource.basename|replace:" ":"_"|filename_safe}.${resource.extension}' },
    ] },
  ] });

  const resolved = resolveWatchSessionPackagizerRules(session);
  assert.deepEqual(resolved.map((rule) => rule.definition.id), [IDS.ruleA, IDS.ruleB]);
  const result = evaluatePackagizer(input(session));
  assert.deepEqual(result.appliedRuleIds, [IDS.ruleA, IDS.ruleB]);
  assert.equal(result.derived.group, 'video-My Video');
  assert.equal(result.derived.filename, 'My_Video.mp4');
  assert.equal(Object.isFrozen(result), true);
});

test('stopAfterSuccess stops later rules only after a matched rule applies successfully', async () => {
  const noMatch = ruleBody(
    [{ id: 'not_image', token: 'resource.kind', operator: 'equals', value: 'image' }],
    [{ id: 'comment', type: 'set_comment', templateId: IDS.templateA }],
    true,
  );
  const stop = ruleBody(
    [{ id: 'video', token: 'resource.kind', operator: 'equals', value: 'video' }],
    [{ id: 'group', type: 'set_group', templateId: IDS.templateB }],
    true,
  );
  const later = ruleBody([], [{ id: 'filename', type: 'set_filename', templateId: IDS.templateC }]);
  const session = await createSession({ rules: [
    { id: IDS.ruleA, name: 'No match', body: noMatch, templates: [{ id: IDS.templateA, text: 'never' }] },
    { id: IDS.ruleB, name: 'Stop', body: stop, templates: [{ id: IDS.templateB, text: 'videos' }] },
    { id: IDS.ruleC, name: 'Later', body: later, templates: [{ id: IDS.templateC, text: 'later.mp4' }] },
  ] });
  const result = evaluatePackagizer(input(session));
  assert.deepEqual(result.appliedRuleIds, [IDS.ruleB]);
  assert.equal(result.stoppedByRuleId, IDS.ruleB);
  assert.equal(result.derived.group, 'videos');
  assert.equal(result.derived.filename, undefined);
});

test('matched rule actions are atomic and Missing template failure stops later rules without partial mutation', async () => {
  const prior = ruleBody([], [{ id: 'group', type: 'set_group', templateId: IDS.templateA }]);
  const failing = ruleBody([], [
    { id: 'comment', type: 'set_comment', templateId: IDS.templateB },
    { id: 'filename', type: 'set_filename', templateId: IDS.templateMissing },
  ]);
  const later = ruleBody([], [{ id: 'group', type: 'set_group', templateId: IDS.templateC }]);
  const session = await createSession({ rules: [
    { id: IDS.ruleA, name: 'Prior', body: prior, templates: [{ id: IDS.templateA, text: 'prior' }] },
    { id: IDS.ruleB, name: 'Fail', body: failing, templates: [
      { id: IDS.templateB, text: 'would-have-applied' },
      { id: IDS.templateMissing, text: '${field.episode}' },
    ] },
    { id: IDS.ruleC, name: 'Later', body: later, templates: [{ id: IDS.templateC, text: 'later' }] },
  ] });
  const result = evaluatePackagizer(input(session));
  assert.deepEqual(result.appliedRuleIds, [IDS.ruleA]);
  assert.deepEqual(result.derived, { group: 'prior' });
  assert.equal(result.failure?.ruleId, IDS.ruleB);
  assert.equal(result.failure?.code, PACKAGIZER_ERROR_CODES.missingToken);
});

test('Missing is distinct from false, zero, null, and empty string; default only handles Missing', async () => {
  const session = await createSession({ rules: [] });
  const base = input(session);
  assert.equal(resolvePackagizerToken('resource.initiator', base), MISSING);
  assert.equal(renderPackagizerTemplate('${resource.initiator|default:"none"}', base), 'none');
  assert.equal(renderPackagizerTemplate('${field.zero|default:"missing"}', { ...base, page: { fields: { zero: 0 } } }), '0');
  assert.equal(renderPackagizerTemplate('${field.false_value|default:"missing"}', { ...base, page: { fields: { false_value: false } } }), 'false');
  assert.equal(renderPackagizerTemplate('${field.null_value|default:"missing"}', { ...base, page: { fields: { null_value: null } } }), 'null');
  assert.equal(renderPackagizerTemplate('x${field.empty|default:"missing"}y', { ...base, page: { fields: { empty: '' } } }), 'xy');
});

test('safe transform whitelist is deterministic and chained left-to-right', async () => {
  const session = await createSession({ rules: [] });
  const source = input(session, { finalUrl: 'https://cdn.example.test/media/%20ViD%20A:B?.mp4' });
  assert.equal(renderPackagizerTemplate('${resource.basename|trim|lower|slice:0:5|replace:"vid":"clip"|upper}', source), 'CLIP A');
  assert.equal(renderPackagizerTemplate('${resource.filename|filename_safe}', source), ' ViD A_B');
  assert.equal(renderPackagizerTemplate('${resource.host|urlencode}', source), 'cdn.example.test');
  assert.deepEqual(parsePackagizerTemplate('x${field.episode|default:"a|b:c"}y').tokenNames, ['field.episode']);
});

test('derived action registry is intentionally limited to local naming/grouping/comment metadata', () => {
  assert.deepEqual(Object.keys(PACKAGIZER_DERIVED_ACTION_REGISTRY).sort(), ['set_comment', 'set_filename', 'set_group']);
  assert.equal('set_download_directory' in PACKAGIZER_DERIVED_ACTION_REGISTRY, false);
  assert.equal('autostart' in PACKAGIZER_DERIVED_ACTION_REGISTRY, false);
});

test('not_equals does not silently treat Missing as a comparable value', async () => {
  const session = await createSession({ rules: [] });
  const source = input(session);
  const condition = requirePackagizerRuleBody({
    schemaVersion: 1,
    conditions: [{ id: 'not_source', token: 'resource.initiator', operator: 'not_equals', value: 'https://other.test' }],
    actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }],
    stopAfterSuccess: false,
  }).conditions[0]!;
  assert.equal(evaluatePackagizerCondition(condition, source), false);
});

test('conditions are AND-compatible, case-sensitive, use the shared glob grammar, and support typed numeric comparisons', async () => {
  const session = await createSession({ rules: [] });
  const source = input(session);
  const conditions = [
    { id: 'contains', token: 'resource.filename', operator: 'contains', value: 'Video' },
    { id: 'starts', token: 'resource.path', operator: 'starts_with', value: '/media/' },
    { id: 'ends', token: 'resource.filename', operator: 'ends_with', value: '.mp4' },
    { id: 'glob', token: 'resource.url', operator: 'glob', value: 'https://cdn.example.test/*.mp4?token=?' },
    { id: 'status', token: 'resource.status', operator: 'gte', value: 200 },
  ] as const;
  assert.equal(conditions.every((condition) => evaluatePackagizerCondition(requirePackagizerRuleBody({ schemaVersion: 1, conditions: [condition], actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }], stopAfterSuccess: false }).conditions[0]!, source)), true);
  const wrongCase = requirePackagizerRuleBody({ schemaVersion: 1, conditions: [{ id: 'wrong', token: 'resource.filename', operator: 'contains', value: 'video' }], actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }], stopAfterSuccess: false }).conditions[0]!;
  assert.equal(evaluatePackagizerCondition(wrongCase, source), false);
});

test('unknown, sensitive, and derived-state tokens plus unknown transforms fail validation', () => {
  for (const token of ['resource.cookie', 'resource.authorization', 'request.headers', 'derived.filename', 'environment.home']) {
    assert.throws(
      () => requirePackagizerRuleBody({
        schemaVersion: 1,
        conditions: [{ id: 'c', token, operator: 'exists' }],
        actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }],
        stopAfterSuccess: false,
      }),
      (error) => error instanceof PackagizerError && error.code === PACKAGIZER_ERROR_CODES.invalidToken,
    );
  }
  assert.throws(() => requirePackagizerTemplateBody({ schemaVersion: 1, text: '${resource.url|regex:".*"}' }), (error) => error instanceof PackagizerError && error.code === PACKAGIZER_ERROR_CODES.invalidTransform);
  assert.throws(() => requirePackagizerTemplateBody({ schemaVersion: 1, text: '${field.BadSlug}' }), (error) => error instanceof PackagizerError && error.code === PACKAGIZER_ERROR_CODES.invalidToken);
});

test('rule validation rejects hidden fields, duplicate local IDs, invalid numeric operands, and regex-like glob escapes', () => {
  assert.throws(() => requirePackagizerRuleBody({ schemaVersion: 1, conditions: [], actions: [], stopAfterSuccess: false }), PackagizerError);
  assert.throws(() => requirePackagizerRuleBody({ schemaVersion: 1, conditions: [
    { id: 'same', token: 'resource.kind', operator: 'exists' },
    { id: 'same', token: 'resource.url', operator: 'exists' },
  ], actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }], stopAfterSuccess: false }), PackagizerError);
  assert.throws(() => requirePackagizerRuleBody({ schemaVersion: 1, conditions: [{ id: 'n', token: 'resource.status', operator: 'gt', value: '200' }], actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }], stopAfterSuccess: false }), PackagizerError);
  assert.throws(() => requirePackagizerRuleBody({ schemaVersion: 1, conditions: [{ id: 'g', token: 'resource.url', operator: 'glob', value: '*\\d*' }], actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }], stopAfterSuccess: false }), PackagizerError);
  assert.throws(() => requirePackagizerRuleBody({ schemaVersion: 1, conditions: [], actions: [{ id: 'a', type: 'set_comment', templateId: IDS.templateA }], stopAfterSuccess: false, script: 'evil()' }), PackagizerError);
});

test('WatchSession preflight requires action templates to be explicitly referenced, frozen, enabled, and valid', async () => {
  const body = ruleBody([], [{ id: 'group', type: 'set_group', templateId: IDS.templateA }]);
  const unreferenced = await createSession({
    rules: [{ id: IDS.ruleA, name: 'Rule', body, templates: [], omitTemplateReference: true }],
    directTemplates: [{ id: IDS.templateA, text: 'group' }],
  });
  assert.throws(
    () => validateWatchSessionPackagizer(unreferenced),
    (error) => error instanceof PackagizerError && error.code === PACKAGIZER_ERROR_CODES.templateNotReferenced,
  );

  const disabled = await createSession({ rules: [{
    id: IDS.ruleA,
    name: 'Rule',
    body,
    templates: [{ id: IDS.templateA, text: 'group', enabled: false }],
  }] });
  assert.throws(
    () => validateWatchSessionPackagizer(disabled),
    (error) => error instanceof PackagizerError && error.code === PACKAGIZER_ERROR_CODES.templateNotFrozen,
  );
});

test('page and field tokens are valid reserved sources but remain Missing until exact page context is supplied', async () => {
  const session = await createSession({ rules: [] });
  const source = input(session);
  assert.equal(resolvePackagizerToken('page.url', source), MISSING);
  assert.equal(resolvePackagizerToken('field.episode', source), MISSING);
  const enriched = { ...source, page: { url: 'https://page.example.test/show', title: 'Show', origin: 'https://page.example.test', fields: { episode: 'S01E02' } } };
  assert.equal(resolvePackagizerToken('page.title', enriched), 'Show');
  assert.equal(resolvePackagizerToken('field.episode', enriched), 'S01E02');
});

test('evaluation rejects incoherent observation/occurrence/session identity instead of crossing Watch boundaries', async () => {
  const session = await createSession({ rules: [] });
  const source = input(session);
  const badOccurrence = { ...source.occurrence, requestId: 'different' } as ResourceOccurrenceProjection;
  assert.throws(() => evaluatePackagizer({ ...source, occurrence: badOccurrence }), PackagizerError);
});
