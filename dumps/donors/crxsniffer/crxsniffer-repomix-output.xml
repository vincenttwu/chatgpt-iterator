import { assertJsonSafe, cloneJsonValue, freezeJsonValue, type JsonValue } from '../core/index.ts';
import type { ChromeStorageAreaLike } from '../persistence/storage-tiers.ts';
import type { DownloadQueueJob, QueueEngineSettings } from './queue-types.ts';

const SESSION_QUEUE_KEY = 'crsniffer.downloads.queue.v1';
const SESSION_PAUSED_KEY = 'crsniffer.downloads.paused.v1';

export class DownloadQueueStore {
  readonly #storageArea: ChromeStorageAreaLike;

  constructor(storageArea: ChromeStorageAreaLike) {
    this.#storageArea = storageArea;
  }

  async loadQueueState(): Promise<{ jobs: DownloadQueueJob[]; isPaused: boolean }> {
    const raw = await this.#storageArea.get([SESSION_QUEUE_KEY, SESSION_PAUSED_KEY]);
    const rawJobs = raw[SESSION_QUEUE_KEY];
    const rawPaused = raw[SESSION_PAUSED_KEY];

    const isPaused = typeof rawPaused === 'boolean' ? rawPaused : false;
    let jobs: DownloadQueueJob[] = [];

    if (Array.isArray(rawJobs)) {
      jobs = rawJobs
        .filter((item): item is DownloadQueueJob => typeof item === 'object' && item !== null && typeof (item as Record<string, unknown>).id === 'string')
        .map((job) => freezeJsonValue(cloneJsonValue(job as unknown as JsonValue)) as unknown as DownloadQueueJob);
    }

    return { jobs, isPaused };
  }

  async saveQueueState(jobs: readonly DownloadQueueJob[], isPaused: boolean): Promise<void> {
    const serialized = jobs.map((job) => cloneJsonValue(job as unknown as JsonValue));
    assertJsonSafe(serialized);
    await this.#storageArea.set({
      [SESSION_QUEUE_KEY]: serialized,
      [SESSION_PAUSED_KEY]: isPaused,
    });
  }

  async clearQueueState(): Promise<void> {
    await this.#storageArea.remove([SESSION_QUEUE_KEY, SESSION_PAUSED_KEY]);
  }
}
