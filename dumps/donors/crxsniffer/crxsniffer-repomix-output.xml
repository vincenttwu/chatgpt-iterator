<file path="tests/packagizer/workspace.test.ts">
import assert from 'node:assert/strict';
import test from 'node:test';

import { createRequestEnvelope, createStableId, requireMessageEnvelope, type JsonObject } from '../../src/core/index.ts';
import {
  DefinitionCatalog,
  WatchSessionComposer,
} from '../../src/definitions/index.ts';
import {
  PERSISTENCE_STORES,
  JsonRecordRepository,
  requireDefinitionRecord,
  requireIsoTimestamp,
  requireWatchSessionRecord,
  type DefinitionRecord,
  type RepositoryStorePort,
  type WatchSessionRecord,
} from '../../src/persistence/index.ts';
import {
  PACKAGIZER_WORKSPACE_OPERATIONS,
  PackagizerPanelClient,
  PackagizerWorkspaceMessageRouter,
  PackagizerWorkspaceService,
  type PackagizerPreviewInput,
  type PackagizerPreviewPort,
  type PackagizerRuleBody,
} from '../../src/packagizer/index.ts';

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();
  async get(key: string): Promise<unknown> { return structuredClone(this.values.get(key)); }
  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('id required');
    this.values.set(key, structuredClone(value));
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async getAll(): Promise<readonly unknown[]> { return [...this.values.values()].map((value) => structuredClone(value)); }
}

const T0 = requireIsoTimestamp('2026-08-20T04:10:00.000Z');
const T1 = requireIsoTimestamp('2026-08-20T04:11:00.000Z');
const IDS = {
  watch: createStableId('definition', () => '11000000-0000-4000-8000-000000000001'),
  ruleA: createStableId('definition', () => '12000000-0000-4000-8000-000000000001'),
  ruleB: createStableId('definition', () => '12000000-0000-4000-8000-000000000002'),
  templateA: createStableId('definition', () => '13000000-0000-4000-8000-000000000001'),
  templateB: createStableId('definition', () => '13000000-0000-4000-8000-000000000002'),
  mapping: createStableId('definition', () => '14000000-0000-4000-8000-000000000001'),
  sessionA: createStableId('watchSession', () => '15000000-0000-4000-8000-000000000001'),
  sessionB: createStableId('watchSession', () => '15000000-0000-4000-8000-000000000002'),
  observation: createStableId('resourceObservation', () => '17000000-0000-4000-8000-000000000001'),
};

function repos() {
  return {
    definitions: new JsonRecordRepository<DefinitionRecord>(PERSISTENCE_STORES.definitions, new MemoryStore(), requireDefinitionRecord),
    sessions: new JsonRecordRepository<WatchSessionRecord>(PERSISTENCE_STORES.watchSessions, new MemoryStore(), requireWatchSessionRecord),
  };
}

function body(templateId = IDS.templateA): PackagizerRuleBody {
  return {
    schemaVersion: 1,
    conditions: [{ id: 'kind_video', token: 'resource.kind', operator: 'equals', value: 'video' }],
    actions: [{ id: 'filename', type: 'set_filename', templateId }],
    stopAfterSuccess: false,
  };
}

async function fixture(preview?: PackagizerPreviewPort) {
  const repositories = repos();
  const catalog = new DefinitionCatalog(repositories.definitions);
  await catalog.create({ id: IDS.mapping, kind: 'pageFieldMapping', name: 'Episode field', body: { slug: 'episode' }, timestamp: T0 });
  await catalog.create({ id: IDS.templateA, kind: 'template', name: 'Filename', body: { schemaVersion: 1, text: '${resource.basename}' }, timestamp: T0 });
  await catalog.create({ id: IDS.templateB, kind: 'template', name: 'Group', body: { schemaVersion: 1, text: '${resource.host}' }, timestamp: T0 });
  await catalog.create({ id: IDS.ruleA, kind: 'packagizerRule', name: 'Video filename', body: body(), references: [{ id: IDS.templateA, kind: 'template' }], timestamp: T0 });
  await catalog.create({ id: IDS.ruleB, kind: 'packagizerRule', name: 'Group', body: { ...body(IDS.templateB), conditions: [] }, references: [{ id: IDS.templateB, kind: 'template' }], timestamp: T0 });
  await catalog.create({ id: IDS.watch, kind: 'watch', name: 'Media watch', references: [{ id: IDS.ruleA, kind: 'packagizerRule' }], timestamp: T0 });
  let next = 20;
  const service = new PackagizerWorkspaceService({
    catalog,
    preview,
    now: () => T1,
    createDefinitionId: () => createStableId('definition', () => `16000000-0000-4000-8000-${String(next++).padStart(12, '0')}`),
  });
  return { repositories, catalog, service };
}

test('workspace snapshot exposes structured rule/template/watch projections and bounded field tokens', async () => {
  const { service } = await fixture();
  const snapshot = await service.snapshot();
  assert.equal(snapshot.schemaVersion, 1);
  assert.deepEqual(snapshot.rules.map((rule) => rule.name), ['Group', 'Video filename']);
  assert.deepEqual(snapshot.templates.map((template) => template.name), ['Filename', 'Group']);
  assert.deepEqual(snapshot.watches[0]?.ruleIds, [IDS.ruleA]);
  assert.equal(snapshot.conditionTokens.includes('resource.kind'), true);
  assert.equal(snapshot.conditionTokens.includes('field.episode'), true);
  assert.equal(snapshot.conditionTokens.includes('resource.cookie'), false);
});

test('Token Browser groups safe namespaces and marks exact selected-Watch page/field dependencies as contextual', async () => {
  const { service, catalog } = await fixture();
  const template = await catalog.require(IDS.templateA);
  await service.saveTemplate({
    mode: 'update',
    definitionId: IDS.templateA,
    expectedRevision: template.revision,
    name: template.value.name,
    enabled: true,
    text: '${page.title}-${field.episode|default:"unknown"}-${resource.basename}',
  });

  const watch = await catalog.require(IDS.watch);
  const browser = await service.tokenBrowser({ watchDefinitionId: IDS.watch, expectedWatchRevision: watch.revision });
  assert.equal(browser.schemaVersion, 1);
  assert.deepEqual(browser.groups.map((group) => group.namespace), ['resource', 'watch', 'page', 'field']);
  const tokens = browser.groups.flatMap((group) => group.tokens);
  const pageTitle = tokens.find((token) => token.token === 'page.title');
  const episode = tokens.find((token) => token.token === 'field.episode');
  const resourceUrl = tokens.find((token) => token.token === 'resource.url');
  assert.equal(pageTitle?.availability, 'contextual');
  assert.equal(pageTitle?.usedBySelectedWatch, true);
  assert.equal(episode?.availability, 'contextual');
  assert.equal(episode?.usedBySelectedWatch, true);
  assert.match(episode?.missingBehavior ?? '', /exact document.*stale|stale\/unavailable/i);
  assert.equal(resourceUrl?.availability, 'available');
  assert.equal(tokens.some((token) => token.token.includes('cookie') || token.token.includes('header')), false);
});

test('Token Browser and Preview reject stale selected Watch revisions and Preview delegates without mutation semantics', async () => {
  const calls: PackagizerPreviewInput[] = [];
  const { service, catalog } = await fixture({
    async preview(input) {
      calls.push(input);
      return {
        schemaVersion: 1,
        sourceObservationId: input.observationId,
        watchDefinitionId: input.watchDefinitionId,
        watchRevision: input.expectedWatchRevision,
        status: 'projected',
        classification: { kind: 'video' },
        admission: { outcome: 'admitted' },
        pageEnrichmentStatus: 'not_required',
        derived: { filename: 'video.mp4' },
        rules: [],
      };
    },
  });
  const watch = await catalog.require(IDS.watch);
  await assert.rejects(
    () => service.tokenBrowser({ watchDefinitionId: IDS.watch, expectedWatchRevision: watch.revision + 1 }),
    /changed elsewhere/i,
  );
  const result = await service.preview({
    watchDefinitionId: IDS.watch,
    expectedWatchRevision: watch.revision,
    observationId: IDS.observation,
  });
  assert.equal(result.status, 'projected');
  assert.equal(result.derived.filename, 'video.mp4');
  assert.deepEqual(calls, [{ watchDefinitionId: IDS.watch, expectedWatchRevision: watch.revision, observationId: IDS.observation }]);
  await assert.rejects(
    () => service.preview({ watchDefinitionId: IDS.watch, expectedWatchRevision: watch.revision + 1, observationId: IDS.observation }),
    /changed elsewhere/i,
  );
});

test('template and rule working copies publish through create/update revision fences with derived references', async () => {
  const { service, catalog } = await fixture();
  const template = await service.saveTemplate({
    mode: 'create', name: 'Episode label', enabled: true, text: '${field.episode|default:"unknown"}',
  });
  assert.equal(template.created, true);
  const storedTemplate = await catalog.require(template.definition.id);
  assert.deepEqual(storedTemplate.value.references, [{ id: IDS.mapping, kind: 'pageFieldMapping' }]);

  const rule = await service.saveRule({
    mode: 'create', name: 'Episode comment', enabled: true,
    body: {
      schemaVersion: 1,
      conditions: [{ id: 'episode_exists', token: 'field.episode', operator: 'exists' }],
      actions: [{ id: 'comment', type: 'set_comment', templateId: template.definition.id }],
      stopAfterSuccess: true,
    },
  });
  assert.equal(rule.created, true);
  const storedRule = await catalog.require(rule.definition.id);
  assert.deepEqual(storedRule.value.references, [
    { id: template.definition.id, kind: 'template' },
    { id: IDS.mapping, kind: 'pageFieldMapping' },
  ]);

  const updated = await service.saveRule({
    mode: 'update', definitionId: rule.definition.id, expectedRevision: rule.definition.revision,
    name: 'Episode comment renamed', enabled: false, body: rule.definition.body,
  });
  assert.equal(updated.definition.revision, rule.definition.revision + 1);
  assert.equal(updated.definition.enabled, false);
  await assert.rejects(
    () => service.saveRule({
      mode: 'update', definitionId: rule.definition.id, expectedRevision: rule.definition.revision,
      name: 'stale', enabled: true, body: rule.definition.body,
    }),
    /changed elsewhere/i,
  );
});

test('rule order updates exact Watch revision while historical WatchSession keeps its frozen order', async () => {
  const { service, repositories, catalog } = await fixture();
  const composer = new WatchSessionComposer(repositories.definitions, repositories.sessions);
  const before = await composer.compose({ id: IDS.sessionA, watchDefinitionId: IDS.watch, timestamp: T0 });
  const beforeWatch = before.value.definitions.find((definition) => definition.id === IDS.watch)!;
  assert.deepEqual(beforeWatch.value.references.filter((reference) => reference.kind === 'packagizerRule').map((reference) => reference.id), [IDS.ruleA]);

  const current = await catalog.require(IDS.watch);
  const result = await service.saveRuleOrder({
    watchDefinitionId: IDS.watch,
    expectedWatchRevision: current.revision,
    ruleIds: [IDS.ruleB, IDS.ruleA],
  });
  assert.deepEqual(result.watch.ruleIds, [IDS.ruleB, IDS.ruleA]);

  const historical = await repositories.sessions.get(IDS.sessionA);
  assert.deepEqual(historical, before);
  const after = await composer.compose({ id: IDS.sessionB, watchDefinitionId: IDS.watch, timestamp: T1 });
  const afterWatch = after.value.definitions.find((definition) => definition.id === IDS.watch)!;
  assert.deepEqual(afterWatch.value.references.filter((reference) => reference.kind === 'packagizerRule').map((reference) => reference.id), [IDS.ruleB, IDS.ruleA]);
});

test('rule order rejects duplicate IDs and stale Watch revisions', async () => {
  const { service, catalog } = await fixture();
  const watch = await catalog.require(IDS.watch);
  await assert.rejects(
    () => service.saveRuleOrder({ watchDefinitionId: IDS.watch, expectedWatchRevision: watch.revision, ruleIds: [IDS.ruleA, IDS.ruleA] }),
    /only once/i,
  );
  await assert.rejects(
    () => service.saveRuleOrder({ watchDefinitionId: IDS.watch, expectedWatchRevision: watch.revision + 1, ruleIds: [IDS.ruleA] }),
    /changed elsewhere/i,
  );
});

test('delete is revision-fenced and blocked while a rule/template is still referenced', async () => {
  const { service, catalog } = await fixture();
  const rule = await catalog.require(IDS.ruleA);
  await assert.rejects(
    () => service.deleteDefinition({ definitionId: IDS.ruleA, expectedRevision: rule.revision, kind: 'packagizerRule' }),
    /still used by Media watch/i,
  );
  const template = await catalog.require(IDS.templateA);
  await assert.rejects(
    () => service.deleteDefinition({ definitionId: IDS.templateA, expectedRevision: template.revision, kind: 'template' }),
    /still used by Video filename/i,
  );
});

test('message router and panel client preserve the same explicit workspace contract', async () => {
  const { service } = await fixture();
  const router = new PackagizerWorkspaceMessageRouter(service);
  const client = new PackagizerPanelClient({ sendMessage: (message) => router.handle(message) });
  const snapshot = await client.snapshot();
  assert.equal(snapshot.rules.length, 2);
  const duplicated = await client.saveTemplate({
    mode: 'create', name: 'Copy', enabled: true, text: '${resource.filename}',
  });
  assert.equal(duplicated.created, true);
  assert.equal((await client.snapshot()).templates.length, 3);
  const watch = snapshot.watches[0]!;
  const tokens = await client.tokenBrowser({ watchDefinitionId: watch.watchDefinitionId, expectedWatchRevision: watch.watchRevision });
  assert.equal(tokens.groups.length, 4);
});


test('workspace message payloads fail closed on unknown fields', async () => {
  const { service } = await fixture();
  const router = new PackagizerWorkspaceMessageRouter(service);
  const response = requireMessageEnvelope(await router.handle(createRequestEnvelope({
    operation: PACKAGIZER_WORKSPACE_OPERATIONS.snapshot,
    payload: { extra: true },
  })));
  assert.equal(response.kind, 'response');
  assert.equal(response.outcome.ok, false);
  if (response.kind === 'response' && !response.outcome.ok) assert.equal(response.outcome.error.code, 'invalid_argument');
});
</file>

