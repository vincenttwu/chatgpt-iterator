import type { JsonObject, Revision, StableId } from '../core/index.ts';
import type { IsoTimestamp } from '../persistence/index.ts';
import type { ResourceAdmissionFilter } from '../resources/index.ts';

export const WATCH_LIFECYCLE_SCHEMA_VERSION = 1 as const;
export const WATCH_ACTIVE_STATE_SCHEMA_VERSION = 1 as const;
export const WATCH_SESSION_STORAGE_KEY = 'activeWatch';
export const WATCH_LIFECYCLE_META_PREFIX = 'watch.lifecycle.';

export const REQUIRED_WATCH_HOST_ORIGINS = Object.freeze([
  'http://*/*',
  'https://*/*',
] as const);

export type WatchHostCoverage = 'full' | 'required';
export type WatchLifecycleState = 'watching' | 'stopped' | 'terminated';
export type WatchTerminationReason =
  | 'user_stop'
  | 'target_closed'
  | 'permission_lost'
  | 'runtime_session_lost'
  | 'storage_failure'
  | 'target_unsupported';

export type WatchReadiness =
  | 'watching'
  | 'ready'
  | 'permission_required'
  | 'target_unavailable'
  | 'target_unsupported';

export interface WatchLifecycleValue extends JsonObject {
  readonly schemaVersion: typeof WATCH_LIFECYCLE_SCHEMA_VERSION;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly tabId: number;
  readonly state: WatchLifecycleState;
  readonly startedAt: IsoTimestamp;
  readonly endedAt?: IsoTimestamp;
  readonly terminationReason?: WatchTerminationReason;
}

export interface ActiveWatchAuthority extends JsonObject {
  readonly schemaVersion: typeof WATCH_ACTIVE_STATE_SCHEMA_VERSION;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly tabId: number;
  readonly startedAt: IsoTimestamp;
}

export interface WatchStatusActive extends JsonObject {
  readonly watchSessionId: StableId<'watchSession'>;
  readonly tabId: number;
  readonly startedAt: IsoTimestamp;
}

export interface WatchTerminationSummary extends JsonObject {
  readonly watchSessionId: StableId<'watchSession'>;
  readonly tabId: number;
  readonly endedAt: IsoTimestamp;
  readonly reason: WatchTerminationReason;
}

export interface WatchStatus extends JsonObject {
  readonly state: 'idle' | 'watching';
  readonly readiness: WatchReadiness;
  readonly hostCoverage: WatchHostCoverage;
  readonly active?: WatchStatusActive;
  readonly lastTermination?: WatchTerminationSummary;
}

export type WatchStartReason =
  | 'started'
  | 'already_watching'
  | 'permission_required'
  | 'target_unavailable'
  | 'target_unsupported';

export interface WatchStartResult extends JsonObject {
  readonly started: boolean;
  readonly reason: WatchStartReason;
  readonly status: WatchStatus;
}

export interface WatchStopResult extends JsonObject {
  readonly stopped: boolean;
  readonly status: WatchStatus;
}

export interface WatchTab {
  readonly id: number;
  readonly url?: string;
  readonly title?: string;
  readonly incognito?: boolean;
}

export interface WatchHostAuthorityPort {
  hasRequiredHosts(): Promise<boolean>;
}

export interface WatchTabPort {
  get(tabId: number): Promise<WatchTab | undefined>;
}

export interface WatchSessionStatePort {
  get(key: string): Promise<unknown>;
  set(key: string, value: JsonObject): Promise<void>;
  remove(key: string): Promise<void>;
}

export interface StartWatchInput {
  readonly tabId: number;
  readonly watchDefinitionId?: StableId<'definition'>;
  readonly expectedWatchRevision?: Revision;
}

export type WatchConfigurationProblem =
  | 'disabled'
  | 'missing_resource_filter'
  | 'multiple_resource_filters'
  | 'invalid_resource_filter';

/** Human-oriented saved Watch setup projection used by the Side Panel. */
export interface WatchConfigurationSummary extends JsonObject {
  readonly watchDefinitionId: StableId<'definition'>;
  readonly watchRevision: Revision;
  readonly name: string;
  readonly builtIn: boolean;
  readonly enabled: boolean;
  readonly filter: ResourceAdmissionFilter;
  readonly problem?: WatchConfigurationProblem;
}

export interface WatchConfigurationList extends JsonObject {
  readonly configurations: readonly WatchConfigurationSummary[];
}

export interface CreateWatchConfigurationInput extends JsonObject {
  readonly mode: 'create';
  readonly name: string;
  readonly filter: ResourceAdmissionFilter;
}

export interface UpdateWatchConfigurationInput extends JsonObject {
  readonly mode: 'update';
  readonly watchDefinitionId: StableId<'definition'>;
  readonly expectedWatchRevision: Revision;
  readonly name: string;
  readonly filter: ResourceAdmissionFilter;
}

export type SaveWatchConfigurationInput =
  | CreateWatchConfigurationInput
  | UpdateWatchConfigurationInput;

export interface SaveWatchConfigurationResult extends JsonObject {
  readonly created: boolean;
  readonly configuration: WatchConfigurationSummary;
}

export interface DeleteWatchConfigurationResult extends JsonObject {
  readonly deleted: true;
  readonly watchDefinitionId: StableId<'definition'>;
  readonly cleanedResourceFilterIds: readonly StableId<'definition'>[];
