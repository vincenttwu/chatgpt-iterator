  });
  seedHistory(h.stores);
  await assert.rejects(() => h.service.clear('history'), /Stop Watch/);
  assert.equal(h.stores.watchSessions.values.size, 1);
  assert.equal(h.stores.resourceObservations.values.size, 1);
  assert.equal(h.stores.definitions.values.size, 1);
});

test('Settings control-plane operations are strict and require explicit destructive confirmation', async () => {
  const h = await harness();
  const router = new ControlPlaneMessageRouter(
    new ControlPlaneProjector({ watch: { status: async () => ({ state: 'idle', readiness: 'ready', hostCoverage: 'full' }) } }),
    undefined,
    h.service,
  );

  const getRequest = createRequestEnvelope({ operation: CONTROL_PLANE_OPERATIONS.settings, payload: { requestSequence: 1 } });
  const getResponse = requireMessageEnvelope(await router.handle(getRequest));
  assert.equal(getResponse.kind, 'response');
  assert.equal(getResponse.outcome.ok, true);
  if (getResponse.kind === 'response' && getResponse.outcome.ok) {
    const result = requireSettingsResult(getResponse.outcome.value);
    assert.equal(result.requestSequence, 1);
    assert.equal(result.settings.retention.mode, 'bounded_terminal_history');
  }

  const maintain = createRequestEnvelope({ operation: CONTROL_PLANE_OPERATIONS.settingsMaintain, payload: { requestSequence: 2 } });
  const maintainResponse = requireMessageEnvelope(await router.handle(maintain));
  assert.equal(maintainResponse.kind, 'response');
  assert.equal(maintainResponse.outcome.ok, true);

  const badClear = createRequestEnvelope({
    operation: CONTROL_PLANE_OPERATIONS.settingsClear,
    payload: { requestSequence: 3, scope: 'history', confirmation: 'yes' },
  });
  const badResponse = requireMessageEnvelope(await router.handle(badClear));
  assert.equal(badResponse.kind, 'response');
  assert.equal(badResponse.outcome.ok, false);

  const goodClear = createRequestEnvelope({
    operation: CONTROL_PLANE_OPERATIONS.settingsClear,
    payload: { requestSequence: 4, scope: 'history', confirmation: 'clear_history' },
  });
  const goodResponse = requireMessageEnvelope(await router.handle(goodClear));
  assert.equal(goodResponse.kind, 'response');
  assert.equal(goodResponse.outcome.ok, true);
  if (goodResponse.kind === 'response' && goodResponse.outcome.ok) {
    assert.equal(requireSettingsResult(goodResponse.outcome.value).clear?.scope, 'history');
  }
});


test('Settings client has an independent freshness lane and discards an older response', async () => {
  const h = await harness();
  const currentSettings = await h.service.snapshot();
  const pending: Array<{ request: ReturnType<typeof requireMessageEnvelope>; resolve: (value: unknown) => void }> = [];
  const runtime = {
    sendMessage(message: unknown): Promise<unknown> {
      const request = requireMessageEnvelope(message);
      return new Promise((resolve) => pending.push({ request, resolve }));
    },
    connect(): never { throw new Error('not used'); },
  };
  const client = new SidePanelControlClient({ runtime: runtime as never, tabs: { query: async () => [{ id: 7 }] } });
  const older = client.settings();
  const newer = client.settings();
  while (pending.length < 2) await Promise.resolve();

  const second = pending[1]!;
  if (second.request.kind !== 'request') throw new Error('request expected');
  second.resolve(createSuccessResponse(second.request, {
    schemaVersion: 2,
    requestSequence: 2,
    settings: currentSettings,
  }));
  assert.equal((await newer).applied, true);

  const first = pending[0]!;
  if (first.request.kind !== 'request') throw new Error('request expected');
  first.resolve(createSuccessResponse(first.request, {
    schemaVersion: 2,
    requestSequence: 1,
    settings: currentSettings,
  }));
  assert.deepEqual(await older, { applied: false });
});
