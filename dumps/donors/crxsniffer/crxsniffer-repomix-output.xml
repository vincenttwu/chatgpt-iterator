import { assertJsonSafe, cloneJsonValue, freezeJsonValue, type JsonValue } from '../core/index.ts';
import type { ChromeStorageAreaLike } from '../persistence/storage-tiers.ts';
import type { WebhookJob } from './webhook-types.ts';

const SESSION_WEBHOOK_QUEUE_KEY = 'crsniffer.webhooks.queue.v1';
const SESSION_WEBHOOK_PAUSED_KEY = 'crsniffer.webhooks.paused.v1';

export class WebhookQueueStore {
  readonly #storageArea: ChromeStorageAreaLike;

  constructor(storageArea: ChromeStorageAreaLike) {
    this.#storageArea = storageArea;
  }

  async loadQueueState(): Promise<{ jobs: WebhookJob[]; isPaused: boolean }> {
    const raw = await this.#storageArea.get([SESSION_WEBHOOK_QUEUE_KEY, SESSION_WEBHOOK_PAUSED_KEY]);
    const rawJobs = raw[SESSION_WEBHOOK_QUEUE_KEY];
    const rawPaused = raw[SESSION_WEBHOOK_PAUSED_KEY];

    const isPaused = typeof rawPaused === 'boolean' ? rawPaused : false;
    let jobs: WebhookJob[] = [];

    if (Array.isArray(rawJobs)) {
      jobs = rawJobs
        .filter((item): item is WebhookJob => typeof item === 'object' && item !== null && typeof (item as Record<string, unknown>).id === 'string')
        .map((job) => freezeJsonValue(cloneJsonValue(job as unknown as JsonValue)) as unknown as WebhookJob);
    }

    return { jobs, isPaused };
  }

  async saveQueueState(jobs: readonly WebhookJob[], isPaused: boolean): Promise<void> {
    const serialized = jobs.map((job) => cloneJsonValue(job as unknown as JsonValue));
    assertJsonSafe(serialized);
    await this.#storageArea.set({
      [SESSION_WEBHOOK_QUEUE_KEY]: serialized,
      [SESSION_WEBHOOK_PAUSED_KEY]: isPaused,
    });
  }

  async clearQueueState(): Promise<void> {
    await this.#storageArea.remove([SESSION_WEBHOOK_QUEUE_KEY, SESSION_WEBHOOK_PAUSED_KEY]);
  }
}
