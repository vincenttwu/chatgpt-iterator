import { freezeJsonValue } from '../core/index.ts';
import {
  requireResourceObservationRecord,
  type ResourceObservationRecord,
} from '../persistence/index.ts';
import { requireResourceObservationValue } from '../observations/index.ts';
import { canonicalizeResourceUrl } from './canonical-url.ts';
import { classifyResource } from './classification.ts';
import {
  DEFAULT_RESOURCE_ADMISSION_FILTER,
  evaluateResourceAdmission,
} from './filter.ts';
import type {
  ResourceAdmissionFilter,
  ResourceDedupGroup,
  ResourceOccurrenceProjection,
} from './types.ts';

export function resourceDocumentKey(value: { readonly documentId?: string }): string {
  return value.documentId === undefined ? 'unknown' : `document:${value.documentId}`;
}

export function evaluateResourceObservation(
  recordInput: ResourceObservationRecord,
  filter: ResourceAdmissionFilter = DEFAULT_RESOURCE_ADMISSION_FILTER,
): ResourceOccurrenceProjection {
  const record = requireResourceObservationRecord(recordInput);
  const value = requireResourceObservationValue(record.value);
  const canonical = canonicalizeResourceUrl(value.finalUrl);
  const classification = classifyResource(value);
  const admission = evaluateResourceAdmission(classification, canonical.href, filter);
  return freezeJsonValue({
    schemaVersion: 1,
    observationId: record.id,
    watchSessionId: record.watchSessionId,
    requestId: value.requestId,
    documentKey: resourceDocumentKey(value),
    canonicalUrl: canonical.href,
    startedAt: value.startedAt,
    endedAt: value.endedAt,
    classification,
    admission,
  }) as ResourceOccurrenceProjection;
}

function groupKey(occurrence: ResourceOccurrenceProjection): string {
  return `${occurrence.watchSessionId}\u001f${occurrence.documentKey}\u001f${occurrence.canonicalUrl}`;
}

/** Reversible user-facing duplicate folding; raw observation identity and every occurrence remain present. */
export function groupResourceOccurrences(
  occurrences: readonly ResourceOccurrenceProjection[],
): readonly ResourceDedupGroup[] {
  const groups = new Map<string, ResourceOccurrenceProjection[]>();
  for (const occurrence of occurrences) {
    const key = groupKey(occurrence);
    const group = groups.get(key);
    if (group === undefined) groups.set(key, [occurrence]);
    else group.push(occurrence);
  }
  return Object.freeze([...groups.values()].map((values) => freezeJsonValue({
    schemaVersion: 1,
    watchSessionId: values[0]!.watchSessionId,
    documentKey: values[0]!.documentKey,
    canonicalUrl: values[0]!.canonicalUrl,
    occurrenceCount: values.length,
    admittedOccurrenceCount: values.filter((value) => value.admission.admitted).length,
    occurrences: values,
  }) as ResourceDedupGroup));
}
