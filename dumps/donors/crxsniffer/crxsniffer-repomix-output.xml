import type { JsonObject } from '../core/index.ts';

export const PERSISTENCE_ERROR_CODES = {
  unavailable: 'persistence_unavailable',
  blocked: 'persistence_blocked',
  failed: 'persistence_failed',
  quotaExceeded: 'persistence_quota_exceeded',
  invalidRecord: 'persistence_invalid_record',
  unsupportedPhysicalVersion: 'persistence_unsupported_physical_version',
  logicalMigrationFailed: 'logical_migration_failed',
  storageTierFailed: 'storage_tier_failed',
} as const;

export type PersistenceErrorCode =
  (typeof PERSISTENCE_ERROR_CODES)[keyof typeof PERSISTENCE_ERROR_CODES];

/** Local persistence failure. Cross-context callers must map this to a bounded core error payload. */
export class PersistenceError extends Error {
  readonly code: PersistenceErrorCode;
  readonly details: JsonObject | undefined;

  constructor(code: PersistenceErrorCode, message: string, details?: JsonObject) {
    super(message);
    this.name = 'PersistenceError';
    this.code = code;
    this.details = details;
  }
}


export function isQuotaExceededError(error: unknown): boolean {
  if (error instanceof PersistenceError) return error.code === PERSISTENCE_ERROR_CODES.quotaExceeded;
  if (error instanceof DOMException) return error.name === 'QuotaExceededError';
  return error instanceof Error && error.name === 'QuotaExceededError';
}

export function normalizePersistenceWriteError(error: unknown, storeName: string): PersistenceError {
  if (error instanceof PersistenceError) return error;
  if (isQuotaExceededError(error)) {
    return new PersistenceError(
      PERSISTENCE_ERROR_CODES.quotaExceeded,
      `Local storage quota prevented writing ${storeName}`,
      { storeName },
    );
  }
  return new PersistenceError(
    PERSISTENCE_ERROR_CODES.failed,
    error instanceof Error ? error.message : `Local persistence write failed for ${storeName}`,
    { storeName },
  );
}
