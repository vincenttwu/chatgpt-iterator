async function confirmClear(): Promise<void> {
  const scope = clearScope.value;
  if (scope === null || settingsBusy.value || isWatching.value) return;
  const opener = clearOpener;
  settingsBusy.value = true;
  settingsError.value = '';
  settingsNotice.value = '';
  try {
    const outcome = await controlClient.clearSettings(scope);
    if (!outcome.applied || outcome.settings === undefined || outcome.clear === undefined) return;
    applySettingsSnapshot(outcome.settings, false);
    clearResourceHistoryUi();
    await refreshResourceSessions();
    if (scope === 'all_local_data') {
      await Promise.all([refreshConfigurations(), refreshPackagizer(), refreshPageFields()]);
    }
    const before = outcome.clear.before;
    settingsNotice.value = scope === 'history'
      ? uiFormat('history_cleared_summary', [String(before.watchSessions), String(before.resourceObservations), String(before.pageFieldSnapshots)])
      : ui('all_local_crsniffer_data_cleared_preferences_were_re');
    clearScope.value = null;
    await nextTick();
    opener?.focus();
    clearOpener = null;
  } catch (error) {
    settingsError.value = error instanceof Error ? error.message : ui('local_data_could_not_be_cleared_no_completion_is_cla');
    await nextTick();
    clearCancelButton.value?.focus();
  } finally {
    settingsBusy.value = false;
  }
}

async function refreshControl(): Promise<void> {
  try {
    const outcome = await controlClient.hydrate();
    if (!outcome.applied || outcome.snapshot === undefined) return;
    snapshot.value = outcome.snapshot;
    syncError.value = '';
  } catch {
    syncError.value = ui('unable_to_synchronize_current_watch_state_crsniffer');
  }
}

async function refreshConfigurations(): Promise<void> {
  try {
    const result = await watchClient.configurations();
    configurations.value = result.configurations;
    configurationsError.value = '';
    if (!draftInitialized.value) {
      const preferred = result.configurations.find((entry) => entry.builtIn) ?? result.configurations[0];
      if (preferred !== undefined) hydrateConfiguration(preferred);
      else initializeNewSetup();
      return;
    }
    if (sourceWatchDefinitionId.value !== null && !draftDirty.value) {
      const current = result.configurations.find((entry) => entry.watchDefinitionId === sourceWatchDefinitionId.value);
      if (current !== undefined) hydrateConfiguration(current);
    }
  } catch {
    configurationsError.value = ui('saved_watch_setups_could_not_be_loaded_your_current');
  }
}

async function grantAccess(): Promise<void> {
  busy.value = true;
  notice.value = '';
  try {
    const outcome = await watchClient.grantHostAuthority();
    notice.value = outcome === 'granted'
      ? ui('site_access_granted_the_exact_current_page_can_now_b')
      : outcome === 'denied'
        ? ui('site_access_was_not_granted_watch_remains_off')
        : ui('site_access_is_incomplete_watch_remains_off_until_ht');
  } catch {
    notice.value = ui('site_access_could_not_be_requested_watch_remains_off');
  } finally {
    await refreshControl();
    busy.value = false;
  }
}

async function saveAs(): Promise<void> {
  if (!canSaveAs.value || filterValidation.value.filter === undefined) return;
  busy.value = true;
  notice.value = '';
  try {
    const result = await watchClient.saveConfiguration({
      mode: 'create',
      name: draftName.value.trim(),
      filter: filterValidation.value.filter,
    });
    mergeConfiguration(result.configuration);
    hydrateConfiguration(result.configuration);
    notice.value = uiFormat('saved_watch_future', [result.configuration.name]);
  } catch (error) {
    notice.value = humanOperationError(error, ui('this_watch_setup_could_not_be_saved_your_working_cop'));
  } finally {
    busy.value = false;
  }
}

async function updateSetup(): Promise<void> {
  if (!canUpdate.value || filterValidation.value.filter === undefined || sourceWatchDefinitionId.value === null || sourceWatchRevision.value === null) return;
  busy.value = true;
  notice.value = '';
  try {
    const result = await watchClient.saveConfiguration({
      mode: 'update',
      watchDefinitionId: sourceWatchDefinitionId.value as WatchConfigurationSummary['watchDefinitionId'],
      expectedWatchRevision: sourceWatchRevision.value as WatchConfigurationSummary['watchRevision'],
      name: draftName.value.trim(),
      filter: filterValidation.value.filter,
    });
    mergeConfiguration(result.configuration);
    hydrateConfiguration(result.configuration);
    notice.value = uiFormat('updated_watch_frozen', [result.configuration.name]);
  } catch (error) {
    notice.value = humanOperationError(error, ui('this_watch_setup_could_not_be_updated_your_working_c'));
    await refreshConfigurations();
  } finally {
    busy.value = false;
  }
}

async function startWatch(): Promise<void> {
  if (!canStart.value || sourceWatchDefinitionId.value === null || sourceWatchRevision.value === null) return;
  busy.value = true;
  notice.value = '';
  try {
    const outcome = await watchClient.start({
      watchDefinitionId: sourceWatchDefinitionId.value as WatchConfigurationSummary['watchDefinitionId'],
      expectedWatchRevision: sourceWatchRevision.value as WatchConfigurationSummary['watchRevision'],
    });
    if (outcome.permission === 'denied') {
      notice.value = ui('site_access_was_not_granted_watch_remains_off');
    } else if (outcome.permission === 'incomplete') {
      notice.value = ui('site_access_is_incomplete_watch_remains_off_until_ht');
    } else if (outcome.permission === 'not_requested') {
      notice.value = ui('no_active_browser_tab_is_available_to_watch');
    } else if (outcome.result !== undefined && !outcome.result.started) {
      if (outcome.result.reason === 'already_watching') notice.value = ui('a_watch_is_already_active_it_was_not_replaced');
      else if (outcome.result.reason === 'target_unsupported') notice.value = ui('only_normal_http_or_https_tabs_can_be_watched');
      else if (outcome.result.reason === 'permission_required') notice.value = ui('site_access_is_required_before_watch_can_start');
      else notice.value = ui('the_current_tab_is_no_longer_available_for_watch');
    } else {
      notice.value = ui('watch_started_its_target_and_saved_setup_are_now_fro');
    }
  } catch (error) {
    notice.value = humanOperationError(error, ui('watch_could_not_start_review_readiness_and_the_saved'));
  } finally {
    await refreshControl();
    busy.value = false;
  }
}

async function stopWatch(): Promise<void> {
  busy.value = true;
  notice.value = '';
  try {
    const result = await watchClient.stop();
    notice.value = result.stopped ? ui('watch_stopped') : ui('watch_was_already_idle');
  } catch {
    notice.value = ui('watch_could_not_stop_cleanly_current_state_will_be_r');
  } finally {
    await refreshControl();
    busy.value = false;
  }
}

async function revokeAccess(): Promise<void> {
  if (isWatching.value && !globalThis.confirm(ui('revoke_site_access_the_active_watch_will_stop_when_a'))) return;
  busy.value = true;
  notice.value = '';
  try {
    await clearPageFieldAssist();
    const removed = await watchClient.revokeHostAuthority();
    notice.value = removed
      ? ui('optional_http_https_site_access_removed_any_active_w')
      : ui('no_optional_site_access_was_removed');
  } catch {
    notice.value = ui('site_access_could_not_be_removed');
  } finally {
    await refreshControl();
    busy.value = false;
  }
}

function mergeResourceRows(incoming: readonly ResourceHistoryRow[]): readonly ResourceHistoryRow[] {
  return mergeResourceHistoryRows({
    current: resourceRows.value,
    incoming,
    limit: RESOURCE_HISTORY_UI_BUFFER_LIMIT,
    ...(selectedObservationId.value === null ? {} : { preserveObservationId: selectedObservationId.value }),
  });
}

function focusedResourceObservationId(): StableId<'resourceObservation'> | undefined {
  const active = document.activeElement;
  if (!(active instanceof HTMLElement) || !active.classList.contains('resource-row')) return undefined;
  const id = active.dataset.observationId;
  return resourceRows.value.find((row) => row.observationId === id)?.observationId;
}

async function preserveFocusedResourcePosition(
  focusedId: StableId<'resourceObservation'> | undefined,
  previousIndex: number,
): Promise<void> {
  if (focusedId === undefined || previousIndex < 0) return;
  const nextIndex = resourceRows.value.findIndex((row) => row.observationId === focusedId);
  if (nextIndex < 0 || nextIndex === previousIndex) return;
  const nextScrollTop = Math.max(0, resourceScrollTop.value + ((nextIndex - previousIndex) * resourceRowHeight.value));
  resourceScrollTop.value = nextScrollTop;
  await nextTick();
  if (resourceScroller.value !== null) resourceScroller.value.scrollTop = nextScrollTop;
}

function clearResourceSelection(): void {
  selectedObservationId.value = null;
  resourceDetail.value = null;
}

async function triggerDownload(url: string, filename?: string): Promise<void> {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const blob = await response.blob();
    const objectUrl = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = objectUrl;
    a.download = filename || url.split('/').pop()?.split('?')[0] || 'resource';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(objectUrl), 10000);
  } catch {
    const a = document.createElement('a');
    a.href = url;
    if (filename) a.download = filename;
    a.rel = 'noopener';
    a.target = '_blank';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }
}

function downloadSingleResource(url: string, filename?: string): void {
  triggerDownload(url, filename);
}

function toggleBatchResourceSelection(observationId: string): void {
  const next = new Set(selectedObservationIds.value);
  if (next.has(observationId)) {
    next.delete(observationId);
  } else {
    next.add(observationId);
  }
  selectedObservationIds.value = next;
}

function selectAllBatchResources(): void {
  if (selectedObservationIds.value.size === resourceRows.value.length && resourceRows.value.length > 0) {
    selectedObservationIds.value = new Set();
  } else {
    selectedObservationIds.value = new Set(resourceRows.value.map((row) => row.observationId));
  }
}

function clearBatchSelection(): void {
  selectedObservationIds.value = new Set();
}

function downloadSelectedBatch(): void {
  const selectedRows = resourceRows.value.filter((row) => selectedObservationIds.value.has(row.observationId));
  if (selectedRows.length === 0) return;
  selectedRows.forEach((row, idx) => {
    setTimeout(() => {
      triggerDownload(row.canonicalUrl, row.filename ?? undefined);
    }, idx * 200);
  });
  resourceStatus.value = uiFormat('download_started', [selectedRows.length]);
}

async function copySelectedUrls(): Promise<void> {
  const selectedRows = resourceRows.value.filter((row) => selectedObservationIds.value.has(row.observationId));
  if (selectedRows.length === 0) return;
  const text = selectedRows.map((row) => row.canonicalUrl).join('\n');
  try {
    await navigator.clipboard.writeText(text);
    resourceStatus.value = uiFormat('copied_urls', [selectedRows.length]);
  } catch {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    resourceStatus.value = uiFormat('copied_urls', [selectedRows.length]);
  }
}

async function copySingleUrl(url: string): Promise<void> {
  try {
    await navigator.clipboard.writeText(url);
    resourceStatus.value = uiFormat('copied_urls', [1]);
  } catch {
    const textarea = document.createElement('textarea');
    textarea.value = url;
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    resourceStatus.value = uiFormat('copied_urls', [1]);
  }
}

async function refreshResourceSessions(reconcileSelectedPage = false): Promise<void> {
  try {
    const outcome = await controlClient.resourceSessions();
    if (!outcome.applied || outcome.sessions === undefined) return;
    resourceSessions.value = outcome.sessions.items;
    resourceError.value = '';
    const currentStillExists = outcome.sessions.items.some(
      (session) => session.watchSessionId === selectedResourceSessionId.value,
    );
    if (!currentStillExists) {
      const activeId = snapshot.value?.activeWatch?.watchSessionId;
      selectedResourceSessionId.value = outcome.sessions.items.find(
        (session) => session.watchSessionId === activeId,
      )?.watchSessionId ?? outcome.sessions.items[0]?.watchSessionId ?? null;
      clearResourceSelection();
      await refreshResourcePage(false);
    } else if (reconcileSelectedPage) {
      await refreshResourcePage(true);
    }
  } catch {
    resourceError.value = ui('recent_watch_sessions_could_not_be_loaded_existing_r');
  }
}

async function refreshResourcePage(mergeNewest: boolean, announce = false): Promise<void> {
  const watchSessionId = selectedResourceSessionId.value;
  if (watchSessionId === null) {
    resourceRows.value = Object.freeze([]);
    resourceNextCursor.value = undefined;
    clearResourceSelection();
    return;
  }
  resourceBusy.value = true;
  try {
    const outcome = await controlClient.resourcePage({
      watchSessionId,
      limit: RESOURCE_HISTORY_DEFAULT_PAGE_SIZE,
      ...(resourceSearch.value === '' ? {} : { searchText: resourceSearch.value }),
      kind: resourceKind.value,
      status: resourceStatusFilter.value,
    });
    if (!outcome.applied || outcome.page === undefined) return;
    const previousIds = new Set(resourceRows.value.map((row) => row.observationId));
    const previousCursor = resourceNextCursor.value;
    const focusedId = mergeNewest ? focusedResourceObservationId() : undefined;
    const previousFocusedIndex = focusedId === undefined
      ? -1
      : resourceRows.value.findIndex((row) => row.observationId === focusedId);
    resourceRows.value = mergeNewest ? mergeResourceRows(outcome.page.items) : outcome.page.items;
    resourceNextCursor.value = mergeNewest && previousCursor !== undefined
      ? previousCursor
      : outcome.page.nextCursor;
    await preserveFocusedResourcePosition(focusedId, previousFocusedIndex);
    resourceError.value = '';
    if (selectedObservationId.value !== null && !resourceRows.value.some(
      (row) => row.observationId === selectedObservationId.value,
    )) clearResourceSelection();
    if (announce) {
      const added = outcome.page.items.filter((row) => !previousIds.has(row.observationId)).length;
      if (added > 0) { resourceStatus.value = uiFormat('new_resources_added', [String(added)]); announceMeaningful(resourceStatus.value); }
    }
  } catch {
    resourceError.value = ui('resource_history_could_not_be_refreshed_existing_row');
  } finally {
    resourceBusy.value = false;
  }
}

async function loadOlderResources(): Promise<void> {
  const watchSessionId = selectedResourceSessionId.value;
  const cursor = resourceNextCursor.value;
  if (watchSessionId === null || cursor === undefined || resourceBusy.value) return;
  resourceBusy.value = true;
  try {
    const outcome = await controlClient.resourcePage({
      watchSessionId,
      limit: RESOURCE_HISTORY_DEFAULT_PAGE_SIZE,
      cursor,
      ...(resourceSearch.value === '' ? {} : { searchText: resourceSearch.value }),
      kind: resourceKind.value,
      status: resourceStatusFilter.value,
    });
    if (!outcome.applied || outcome.page === undefined) return;
    resourceRows.value = mergeResourceRows(outcome.page.items);
    resourceNextCursor.value = resourceRows.value.length >= RESOURCE_HISTORY_UI_BUFFER_LIMIT
      ? undefined
      : outcome.page.nextCursor;
    resourceError.value = '';
  } catch {
    resourceError.value = ui('older_resources_could_not_be_loaded_current_rows_rem');
  } finally {
    resourceBusy.value = false;
  }
}

async function selectResource(row: ResourceHistoryRow): Promise<void> {
  selectedObservationId.value = row.observationId;
  resourceDetail.value = null;
  try {
    const outcome = await controlClient.resourceDetail(row.observationId);
    if (!outcome.applied) return;
    if (!outcome.found || outcome.detail === undefined) {
      resourceError.value = ui('that_resource_is_no_longer_available_for_inspection');
      if (selectedObservationId.value === row.observationId) clearResourceSelection();
      return;
    }
    if (selectedObservationId.value === row.observationId) resourceDetail.value = outcome.detail;
    resourceError.value = '';
  } catch {
    resourceError.value = ui('resource_detail_could_not_be_loaded_the_result_list');
  }
}

function selectResourceSession(event: Event): void {
  const value = (event.currentTarget as HTMLSelectElement).value;
  selectedResourceSessionId.value = resourceSessions.value.find(
    (session) => session.watchSessionId === value,
  )?.watchSessionId ?? null;
  resourceRows.value = Object.freeze([]);
  resourceNextCursor.value = undefined;
  resourceScrollTop.value = 0;
  clearResourceSelection();
  void refreshResourcePage(false);
}

function applyResourceFilters(): void {
  resourceSearch.value = resourceSearchDraft.value.trim();
  resourceKind.value = resourceKindDraft.value;
  resourceStatusFilter.value = resourceStatusDraft.value;
  resourceRows.value = Object.freeze([]);
  resourceNextCursor.value = undefined;
  resourceScrollTop.value = 0;
  clearResourceSelection();
  void refreshResourcePage(false);
}

function onResourceScroll(event: Event): void {
  resourceScrollTop.value = (event.currentTarget as HTMLElement).scrollTop;
}

function selectWorkspace(workspace: Workspace): void {
  activeWorkspace.value = workspace;
  if (workspace === 'rules') {
    void refreshTokenBrowser();
    void refreshPreviewSessions();
    void refreshPageFields();
  }
  if (workspace === 'settings') void refreshSettings();
}


const liveSummary = ref('');
let lastAnnouncedSummary = '';
function announceMeaningful(message: string): void {
  const normalized = message.trim();
  if (normalized === '' || normalized === lastAnnouncedSummary) return;
  lastAnnouncedSummary = normalized;
  liveSummary.value = normalized;
}

const workspaceStateKind = computed<UiStateKind>(() => {
  if (connectionState.value === 'reconnecting') return 'reconnecting';
  if (connectionState.value !== 'connected' || snapshot.value === null) return 'loading';
  if (activeWorkspace.value === 'watch') {
    if (syncError.value || configurationsError.value || resourceError.value) return 'error';
    if (sourceOutdated.value) return 'stale';
    if (snapshot.value.runtimeHealth.state === 'degraded') return 'degraded';
    if (isWatching.value) return 'live';
    if (!hostAccessGranted.value || status.value?.readiness === 'target_unsupported' || status.value?.readiness === 'target_unavailable') return 'disabled';
    if (configurations.value.length === 0) return 'empty';
    return 'success';
  }
  if (activeWorkspace.value === 'rules') {
    if (packagizerBusy.value || pageFieldBusy.value || previewBusy.value || tokenBrowserBusy.value) return 'loading';
    if (packagizerError.value || pageFieldError.value || previewError.value || tokenBrowserError.value) return 'error';
    if (ruleSourceOutdated.value || templateSourceOutdated.value || pageFieldSourceOutdated.value || ruleOrderOutdated.value) return 'stale';
    if ((packagizerSnapshot.value?.rules.length ?? 0) === 0 && (packagizerSnapshot.value?.templates.length ?? 0) === 0) return 'empty';
    return 'success';
  }
  if (settingsBusy.value) return 'loading';
  if (settingsError.value) return 'error';
  if (snapshot.value.runtimeHealth.state === 'degraded' || settingsSnapshot.value?.diagnostics.migrationStatus === 'failed' || settingsSnapshot.value?.diagnostics.storage.level === 'critical') return 'degraded';
  if (isWatching.value) return 'disabled';
  return settingsSnapshot.value === null ? 'loading' : 'success';
});
const workspaceStateLabel = computed(() => uiStateLabel(workspaceStateKind.value));
watch(workspaceStateLabel, (label) => announceMeaningful(label));
watch([notice, resourceStatus, packagizerNotice, pageFieldNotice, previewStatus, settingsNotice, exportStatus], (messages) => {
  const meaningful = [...messages].reverse().find((message) => message.trim() !== '');
  if (meaningful !== undefined) announceMeaningful(meaningful);
});
function onTabKeydown(event: KeyboardEvent): void {
  if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const current = tabs.indexOf(event.currentTarget as HTMLButtonElement);
  if (current < 0 || tabs.length === 0) return;
  event.preventDefault();
  const next = event.key === 'Home'
    ? 0
    : event.key === 'End'
      ? tabs.length - 1
      : (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
  tabs[next]?.focus();
}

onMounted(() => {
  invalidationBatcher = new ControlPlaneInvalidationBatcher((reasons) => {
    const pending = new Set(reasons);
    void refreshControl();
    if (pending.has('configuration_changed')) { void refreshConfigurations(); void refreshPackagizer(); }
    if (pending.has('watch_changed')) void refreshResourceSessions();
    if (pending.has('connected')) void refreshResourceSessions(true);
    if (pending.has('observation_persisted')) {
      void refreshResourcePage(true, true);
      if (activeWorkspace.value === 'rules') void refreshPreviewSessions();
    }
    if (pending.has('packagizer_changed')) {
      void refreshPackagizer();
      void refreshPageFields();
      if (activeWorkspace.value === 'rules') void refreshTokenBrowser();
    }
    if (pending.has('settings_changed')) void refreshSettings();
    if (pending.has('history_cleared')) {
      clearResourceHistoryUi();
      void refreshResourceSessions();
      void refreshConfigurations();
      void refreshPackagizer();
      void refreshPageFields();
    }
  });
  connection = controlClient.connect({
    onInvalidation: (hint) => invalidationBatcher?.enqueue(hint.reason),
    onStateChange: (state) => { connectionState.value = state; announceMeaningful(uiStateLabel(state === 'reconnecting' ? 'reconnecting' : state === 'connected' ? 'success' : state === 'stopped' ? 'disabled' : 'loading')); },
  });
  connection.start();
  removeActiveTabListener = controlClient.onActiveTabChanged(() => { void clearPageFieldAssist(); void refreshControl(); void refreshPageFields(); });
  void (async () => {
    await Promise.all([refreshControl(), refreshConfigurations(), refreshPackagizer(), refreshPageFields(), refreshSettings()]);
    await refreshResourceSessions();
  })();
});

onUnmounted(() => {
  void clearPageFieldAssist();
  removeActiveTabListener?.();
  invalidationBatcher?.stop();
  connection?.stop();
});
</script>

<template>
  <main class="shell" :data-workspace="activeWorkspace" :data-state="workspaceStateKind" aria-labelledby="app-title">
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true">{{ liveSummary }}</p>
    <header class="shell__header">
      <div>
        <p class="eyebrow">{{ ui('crsniffer') }}</p>
        <h1 id="app-title">{{ activeWorkspace === 'watch' ? ui('watch_workspace') : activeWorkspace === 'rules' ? ui('rules_workspace') : activeWorkspace === 'downloads' ? ui('downloads_workspace') : activeWorkspace === 'webhooks' ? ui('webhooks_workspace') : activeWorkspace === 'export' ? ui('export_workspace') : ui('settings_workspace') }}</h1>
      </div>
      <span class="version" :aria-label="uiFormat('version_label', [version])">{{ uiFormat('version_short', [version]) }}</span>
    </header>

    <div class="control-status" :data-state="workspaceStateKind" :aria-label="ui('workspace_status')">
      <span>{{ connectionLabel }}</span>
      <span aria-hidden="true">·</span>
      <span>{{ synchronizedLabel }}</span>
      <span class="state-badge shell-state-badge" :data-state="workspaceStateKind">{{ workspaceStateLabel }}</span>
    </div>

    <div class="tabs" role="tablist" :aria-label="ui('primary_workspaces')">
      <button id="tab-watch" type="button" role="tab" aria-controls="panel-watch" :aria-selected="activeWorkspace === 'watch'" :tabindex="activeWorkspace === 'watch' ? 0 : -1" @keydown="onTabKeydown" @click="selectWorkspace('watch')">
        <Icon name="watch" size="16" />
        <span>{{ ui('watch') }}</span>
      </button>
      <button id="tab-rules" type="button" role="tab" aria-controls="panel-rules" :aria-selected="activeWorkspace === 'rules'" :tabindex="activeWorkspace === 'rules' ? 0 : -1" @keydown="onTabKeydown" @click="selectWorkspace('rules')">
        <Icon name="rules" size="16" />
        <span>{{ ui('rules') }}</span>
      </button>
      <button id="tab-downloads" type="button" role="tab" aria-controls="panel-downloads" :aria-selected="activeWorkspace === 'downloads'" :tabindex="activeWorkspace === 'downloads' ? 0 : -1" @keydown="onTabKeydown" @click="selectWorkspace('downloads')">
        <Icon name="download" size="16" />
        <span>{{ ui('downloads') }}</span>
      </button>
      <button id="tab-webhooks" type="button" role="tab" aria-controls="panel-webhooks" :aria-selected="activeWorkspace === 'webhooks'" :tabindex="activeWorkspace === 'webhooks' ? 0 : -1" @keydown="onTabKeydown" @click="selectWorkspace('webhooks')">
        <Icon name="export" size="16" />
        <span>{{ ui('webhooks') }}</span>
      </button>
      <button id="tab-export" type="button" role="tab" aria-controls="panel-export" :aria-selected="activeWorkspace === 'export'" :tabindex="activeWorkspace === 'export' ? 0 : -1" @keydown="onTabKeydown" @click="selectWorkspace('export')">
        <Icon name="export" size="16" />
        <span>{{ ui('export') }}</span>
      </button>
      <button id="tab-settings" type="button" role="tab" aria-controls="panel-settings" :aria-selected="activeWorkspace === 'settings'" :tabindex="activeWorkspace === 'settings' ? 0 : -1" @keydown="onTabKeydown" @click="selectWorkspace('settings')">
        <Icon name="settings" size="16" />
        <span>{{ ui('settings') }}</span>
      </button>
    </div>

    <section v-if="activeWorkspace === 'watch'" id="panel-watch" class="watch-workspace" role="tabpanel" aria-labelledby="tab-watch">
      <details class="watch-card" open aria-labelledby="watch-readiness-title">
        <summary class="watch-card__heading">
          <div>
            <p class="eyebrow">{{ ui('eyebrow_status') }}</p>
            <h2 id="watch-readiness-title" style="display: inline;">{{ ui('title_sniffer_engine') }}</h2>
          </div>
          <span class="state-badge">{{ isWatching ? ui('on') : ui('off') }}</span>
        </summary>
        <p style="margin-top: 0.5rem;">{{ readinessDetail }}</p>

        <div class="scope-card">
