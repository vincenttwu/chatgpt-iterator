} from '../../src/observations/index.ts';
import {
  WATCH_SESSION_STORAGE_KEY,
  type WatchSessionStatePort,
} from '../../src/watch/index.ts';

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();
  putCount = 0;
  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }
  async put(value: JsonObject): Promise<void> {
    this.putCount += 1;
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('memory store requires id/key');
    this.values.set(key, structuredClone(value));
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async getAll(): Promise<readonly unknown[]> {
    return [...this.values.values()].map((value) => structuredClone(value));
  }
}



class MemoryPending implements PendingObservationStore {
  readonly values = new Map<string, PendingObservationTrace>();
  async get(key: string): Promise<PendingObservationTrace | undefined> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }
  async put(key: string, value: PendingObservationTrace): Promise<void> {
    this.values.set(key, structuredClone(value));
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async list(): Promise<readonly PendingObservationTrace[]> {
    return [...this.values.values()].map((value) => structuredClone(value));
  }
  async clear(): Promise<void> { this.values.clear(); }
}

class MemorySessionState implements WatchSessionStatePort {
  readonly values = new Map<string, JsonObject>();
  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }
  async set(key: string, value: JsonObject): Promise<void> { this.values.set(key, structuredClone(value)); }
  async remove(key: string): Promise<void> { this.values.delete(key); }
}

const IDS = {
  watch: createStableId('definition', () => '91000000-0000-4000-8000-000000000001'),
  filter: createStableId('definition', () => '91000000-0000-4000-8000-000000000002'),
  ruleA: createStableId('definition', () => '91000000-0000-4000-8000-000000000003'),
  ruleB: createStableId('definition', () => '91000000-0000-4000-8000-000000000004'),
  ruleDisabled: createStableId('definition', () => '91000000-0000-4000-8000-000000000005'),
  templateA: createStableId('definition', () => '91000000-0000-4000-8000-000000000006'),
  templateB: createStableId('definition', () => '91000000-0000-4000-8000-000000000007'),
  templateFail: createStableId('definition', () => '91000000-0000-4000-8000-000000000008'),
  session: createStableId('watchSession', () => '92000000-0000-4000-8000-000000000001'),
  observation: createStableId('resourceObservation', () => '93000000-0000-4000-8000-000000000001'),
  lifecycleObservation: createStableId('resourceObservation', () => '93000000-0000-4000-8000-000000000002'),
};

const T0 = '2026-08-19T14:00:00.000Z' as never;
const T1 = '2026-08-19T14:00:01.000Z' as never;

function repositories() {
  const definitionStore = new MemoryStore();
  const sessionStore = new MemoryStore();
  return {
    definitions: new JsonRecordRepository<DefinitionRecord>(
      PERSISTENCE_STORES.definitions,
      definitionStore,
      requireDefinitionRecord,
    ),
    sessions: new JsonRecordRepository<WatchSessionRecord>(
      PERSISTENCE_STORES.watchSessions,
      sessionStore,
      requireWatchSessionRecord,
    ),
  };
}

async function session(options: {
  readonly exclude?: readonly string[];
  readonly failingRule?: boolean;
  readonly nonMatchingFirstCondition?: boolean;
} = {}): Promise<{
  session: ImmutableWatchSessionRecord;
  sessions: JsonRecordRepository<WatchSessionRecord>;
  definitions: JsonRecordRepository<DefinitionRecord>;
  composer: WatchSessionComposer;
}> {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({
    id: IDS.filter,
    kind: 'resourceFilter',
    name: 'Video filter',
    body: {
      schemaVersion: 1,
      images: false,
      videos: true,
      includeGlobs: ['https://cdn.example.test/special/*'],
      excludeGlobs: options.exclude ?? [],
    },
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.templateA,
    kind: 'template',
    name: 'Filename',
    body: { schemaVersion: 1, text: '${resource.basename|trim|lower|filename_safe}.${resource.extension}' },
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.templateB,
    kind: 'template',
    name: 'Group',
    body: { schemaVersion: 1, text: '${resource.host|upper}' },
    timestamp: T0,
  });
  if (options.failingRule) {
    await catalog.create({
      id: IDS.templateFail,
      kind: 'template',
      name: 'Missing field',
      body: { schemaVersion: 1, text: '${field.episode}' },
      timestamp: T0,
    });
  }
  await catalog.create({
    id: IDS.ruleDisabled,
    kind: 'packagizerRule',
    name: 'Disabled',
    enabled: false,
    body: {
      schemaVersion: 1,
      conditions: [],
      actions: [{ id: 'disabled_group', type: 'set_group', templateId: IDS.templateB }],
      stopAfterSuccess: false,
    },
    references: [{ id: IDS.templateB, kind: 'template' }],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.ruleA,
    kind: 'packagizerRule',
    name: 'Filename',
    body: {
      schemaVersion: 1,
      conditions: options.nonMatchingFirstCondition
        ? [
            { id: 'must_be_image', token: 'resource.kind', operator: 'equals', value: 'image' },
            { id: 'never_read', token: 'resource.status', operator: 'gte', value: 200 },
          ]
        : [{ id: 'video', token: 'resource.kind', operator: 'equals', value: 'video' }],
      actions: [{ id: 'filename', type: 'set_filename', templateId: IDS.templateA }],
      stopAfterSuccess: false,
    },
    references: [{ id: IDS.templateA, kind: 'template' }],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.ruleB,
    kind: 'packagizerRule',
    name: options.failingRule ? 'Failure' : 'Group overwrite',
    body: {
      schemaVersion: 1,
      conditions: [],
      actions: [
        { id: 'group', type: 'set_group', templateId: IDS.templateB },
        ...(options.failingRule
          ? [{ id: 'fail', type: 'set_comment' as const, templateId: IDS.templateFail }]
          : []),
      ],
      stopAfterSuccess: true,
    },
    references: [
      { id: IDS.templateB, kind: 'template' },
      ...(options.failingRule ? [{ id: IDS.templateFail, kind: 'template' as const }] : []),
    ],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.watch,
    kind: 'watch',
    name: 'Watch',
    references: [
      { id: IDS.filter, kind: 'resourceFilter' },
      { id: IDS.ruleDisabled, kind: 'packagizerRule' },
      { id: IDS.ruleA, kind: 'packagizerRule' },
      { id: IDS.ruleB, kind: 'packagizerRule' },
    ],
    timestamp: T0,
  });
  const composer = new WatchSessionComposer(repos.definitions, repos.sessions);
  const composed = await composer.compose({
    id: IDS.session,
    watchDefinitionId: IDS.watch,
    timestamp: T0,
  });
  return { session: composed, sessions: repos.sessions, definitions: repos.definitions, composer };
}

function observation(overrides: Partial<ResourceObservationValue> = {}): ResourceObservationRecord {
  const value: ResourceObservationValue = {
    schemaVersion: 1,
    requestId: 'eval-request-1',
    tabId: 7,
    method: 'GET',
    requestType: 'media',
    startedAt: T0,
    endedAt: T1,
    startedWithBeforeRequest: true,
    initialUrl: 'https://cdn.example.test/media/My Video.mp4?secret=A#start',
    finalUrl: 'https://cdn.example.test/media/My%20Video.mp4?secret=A#end',
    frameId: 0,
    documentId: 'doc-eval',
    responseStatusCode: 206,
    responseMimeType: 'video/mp4',
    hops: [],
    terminal: { kind: 'completed', at: T1, statusCode: 206 },
    ...overrides,
  };
  return {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: IDS.observation,
    watchSessionId: IDS.session,
    observedAt: T0,
    value,
