test('panel client verifies complete coverage after grant before sending Watch start', async () => {
  let contains = false;
  let sendCount = 0;
  const permissions: ChromePermissionsPanelLike = {
    async request() { return true; },
    async contains() { return contains; },
    async remove(details) {
      assert.deepEqual(details.origins, REQUIRED_WATCH_HOST_ORIGINS);
      return true;
    },
  };
  const tabs: ChromeTabsPanelLike = {
    async query() { return [{ id: 7 }]; },
  };
  const runtime: ChromeRuntimePanelLike = {
    async sendMessage(message) {
      sendCount += 1;
      const request = requireMessageEnvelope(message);
      assert.equal(request.kind, 'request');
      if (request.kind !== 'request') throw new Error('request expected');
      assert.equal(request.operation, WATCH_OPERATIONS.start);
      assert.deepEqual(request.payload, { tabId: 7 });
      return createSuccessResponse(request, {
        started: true,
        reason: 'started',
        status: { state: 'watching', readiness: 'watching', hostCoverage: 'full' },
      });
    },
  };
  const client = new WatchPanelClient({ permissions, tabs, runtime });
  assert.equal((await client.start()).permission, 'incomplete');
  assert.equal(sendCount, 0);

  contains = true;
  const outcome = await client.start();
  assert.equal(outcome.permission, 'granted');
  assert.equal(outcome.result?.started, true);
  assert.equal(sendCount, 1);
  assert.equal(await client.revokeHostAuthority(), true);
});

