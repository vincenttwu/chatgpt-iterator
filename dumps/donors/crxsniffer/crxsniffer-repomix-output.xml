import assert from 'node:assert/strict';
import test from 'node:test';

import {
  CONTRACT_ERROR_CODES,
  CONTRACT_ERROR_SCHEMA_VERSION,
  ContractError,
  CORE_SCHEMA_VERSION,
  INITIAL_REVISION,
  MESSAGE_PROTOCOL_VERSION,
  MESSAGE_SCHEMA_VERSION,
  MISSING,
  createErrorPayload,
  createFailureResponse,
  createRequestEnvelope,
  createStableId,
  createSuccessResponse,
  decodeMaybeJson,
  encodeMaybeJson,
  isJsonSafe,
  isMissing,
  isStableId,
  nextRevision,
  requireMessageEnvelope,
  requireRevision,
  stringifyJsonValue,
  type IdFactory,
  type StableIdKind,
} from '../../src/core/index.ts';

const UUIDS = [
  '11111111-1111-4111-8111-111111111111',
  '22222222-2222-4222-8222-222222222222',
  '33333333-3333-4333-8333-333333333333',
  '44444444-4444-4444-8444-444444444444',
  '55555555-5555-4555-8555-555555555555',
  '66666666-6666-4666-8666-666666666666',
];

function deterministicIdFactory(): IdFactory {
  let index = 0;
  return <K extends StableIdKind>(kind: K) => {
    const uuid = UUIDS[index];
    index += 1;
    if (uuid === undefined) {
      throw new Error('test UUID pool exhausted');
    }
    return createStableId(kind, () => uuid);
  };
}

test('stable IDs are kind-prefixed canonical UUID v4 values', () => {
  const watchSessionId = createStableId(
    'watchSession',
    () => '11111111-1111-4111-8111-111111111111',
  );
  assert.equal(watchSessionId, 'ws_11111111-1111-4111-8111-111111111111');
  assert.equal(isStableId(watchSessionId, 'watchSession'), true);
  assert.equal(isStableId(watchSessionId, 'request'), false);
  assert.equal(isStableId(watchSessionId.toUpperCase(), 'watchSession'), false);
});

test('invalid UUID sources fail closed instead of manufacturing ambiguous IDs', () => {
  assert.throws(
    () => createStableId('request', () => 'not-a-uuid'),
    (error) => error instanceof ContractError && error.code === CONTRACT_ERROR_CODES.invalidId,
  );
});

test('revisions start at one and remain positive safe integers', () => {
  assert.equal(INITIAL_REVISION, 1);
  assert.equal(nextRevision(INITIAL_REVISION), 2);
  assert.equal(requireRevision(7), 7);
  assert.throws(() => requireRevision(0), ContractError);
  assert.throws(() => requireRevision(1.5), ContractError);
});

test('strict JSON rejects values that JSON.stringify would silently reinterpret', () => {
  assert.equal(isJsonSafe({ ok: true, values: [null, 0, '', false] }), true);
  assert.equal(isJsonSafe(undefined), false);
  assert.equal(isJsonSafe(Number.NaN), false);
  assert.equal(isJsonSafe(Number.POSITIVE_INFINITY), false);
  assert.equal(isJsonSafe(-0), false);
  assert.equal(isJsonSafe(1n), false);
  assert.equal(isJsonSafe(new Date()), false);
  assert.equal(isJsonSafe([, 'hole']), false);

  const arrayWithHiddenValue = [1];
  Object.defineProperty(arrayWithHiddenValue, 'hidden', { value: 2, enumerable: false });
  assert.equal(isJsonSafe(arrayWithHiddenValue), false);

  const cyclic: Record<string, unknown> = {};
  cyclic.self = cyclic;
  assert.equal(isJsonSafe(cyclic), false);
});

test('Missing is distinct from every JSON falsey value and uses explicit wire encoding', () => {
  const falseyValues = [null, false, 0, ''] as const;
  for (const value of falseyValues) {
    assert.equal(isMissing(value), false);
    assert.equal(decodeMaybeJson(encodeMaybeJson(value)), value);
  }

  const encoded = encodeMaybeJson(MISSING);
  assert.deepEqual(encoded, { $type: 'crsniffer.missing', schemaVersion: CORE_SCHEMA_VERSION });
  assert.equal(isMissing(decodeMaybeJson(encoded)), true);
  assert.equal(isJsonSafe(MISSING), false);
});

test('request and success response envelopes preserve request correlation and exact context', () => {
  const idFactory = deterministicIdFactory();
  const watchSessionId = idFactory('watchSession');
  const request = createRequestEnvelope({
    operation: 'watch.status',
    context: { watchSessionId, tabId: 42, documentId: 'doc-abc' },
    payload: { includeHistory: false },
    idFactory,
  });

  assert.equal(request.schemaVersion, MESSAGE_SCHEMA_VERSION);
  assert.equal(request.protocolVersion, MESSAGE_PROTOCOL_VERSION);
  assert.equal(Object.isFrozen(request), true);
  assert.equal(Object.isFrozen(request.payload), true);

  const response = createSuccessResponse(request, { state: 'idle' }, idFactory);
  assert.equal(response.requestId, request.requestId);
  assert.equal(response.operation, request.operation);
  assert.deepEqual(response.context, request.context);
  assert.deepEqual(response.outcome, { ok: true, value: { state: 'idle' } });

  const parsed = requireMessageEnvelope(JSON.parse(stringifyJsonValue(response)));
  assert.deepEqual(parsed, response);
});

test('failure envelopes carry bounded typed errors rather than Error objects or stacks', () => {
  const idFactory = deterministicIdFactory();
  const request = createRequestEnvelope({
    operation: 'watch.start',
    payload: {},
    idFactory,
  });
  const payload = createErrorPayload(
    CONTRACT_ERROR_CODES.missingRequiredValue,
    'tabId is required',
    { field: 'tabId' },
  );
  const response = createFailureResponse(request, payload, idFactory);

  assert.equal(payload.schemaVersion, CONTRACT_ERROR_SCHEMA_VERSION);
  assert.deepEqual(response.outcome, { ok: false, error: payload });
  assert.equal('stack' in (response.outcome.ok ? {} : response.outcome.error), false);
  assert.deepEqual(requireMessageEnvelope(response), response);
});

test('message decoder rejects unsupported versions, malformed context, and unsafe payloads', () => {
  const idFactory = deterministicIdFactory();
  const request = createRequestEnvelope({ operation: 'watch.status', payload: {}, idFactory });

  assert.throws(
    () => requireMessageEnvelope({ ...request, protocolVersion: 999 }),
    (error) => error instanceof ContractError
      && error.code === CONTRACT_ERROR_CODES.unsupportedProtocolVersion,
  );

  assert.throws(
    () => requireMessageEnvelope({ ...request, context: { unknown: true } }),
    (error) => error instanceof ContractError && error.code === CONTRACT_ERROR_CODES.invalidMessage,
  );

  assert.throws(
    () => requireMessageEnvelope({ ...request, unexpected: true }),
    (error) => error instanceof ContractError && error.code === CONTRACT_ERROR_CODES.invalidMessage,
  );

  assert.throws(
    () => requireMessageEnvelope({ ...request, payload: 'primitive' }),
    (error) => error instanceof ContractError && error.code === CONTRACT_ERROR_CODES.invalidMessage,
  );

  assert.throws(
    () => createRequestEnvelope({
      operation: 'watch.status',
      payload: { unsafe: undefined } as never,
      idFactory,
    }),
    (error) => error instanceof ContractError && error.code === CONTRACT_ERROR_CODES.invalidJson,
  );
});
