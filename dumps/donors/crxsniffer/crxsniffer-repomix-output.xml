<file path="src/downloads/queue-engine.ts">
import { freezeJsonValue } from '../core/index.ts';
import type {
  DownloadQueueJob,
  QueueEngineSettings,
  QueueStateSnapshot,
} from './queue-types.ts';
import { DownloadQueueStore } from './queue-store.ts';
import type { ChromeStorageAreaLike } from '../persistence/storage-tiers.ts';
import { matchSmartPatternList } from '../resources/index.ts';

export interface ChromeDownloadsApiLike {
  download(options: { url: string; filename?: string; saveAs?: boolean }): Promise<number>;
  pause?(downloadId: number): Promise<void>;
  resume?(downloadId: number): Promise<void>;
  cancel?(downloadId: number): Promise<void>;
}

export const DEFAULT_QUEUE_ENGINE_SETTINGS: QueueEngineSettings = freezeJsonValue({
  maxGlobalConcurrency: 2,
  maxDomainConcurrency: 1,
  downloadCooldownIntervalMs: 500,
  downloadSizeGuardEnabled: true,
  downloadMinSizeBytes: 51200,
  downloadMaxSizeBytes: 2147483648,
  downloadPreflightHeadEnabled: false,
  downloadIncludeGlobs: '*',
  downloadExcludeGlobs: '',
});

export class DownloadQueueEngine {
  readonly #store: DownloadQueueStore;
  readonly #chromeDownloads?: ChromeDownloadsApiLike;
  #jobs: DownloadQueueJob[] = [];
  #isPaused = false;
  #settings: QueueEngineSettings = DEFAULT_QUEUE_ENGINE_SETTINGS;
  #lastDomainDispatchTimes = new Map<string, number>();
  #processing = false;

  constructor(storageArea: ChromeStorageAreaLike, chromeDownloads?: ChromeDownloadsApiLike) {
    this.#store = new DownloadQueueStore(storageArea);
    this.#chromeDownloads = chromeDownloads;
  }

  async init(settings: Partial<QueueEngineSettings> = {}): Promise<QueueStateSnapshot> {
    this.#settings = freezeJsonValue({ ...DEFAULT_QUEUE_ENGINE_SETTINGS, ...settings });
    const loaded = await this.#store.loadQueueState();
    this.#jobs = [...loaded.jobs];
    this.#isPaused = loaded.isPaused;
    await this.processQueue();
    return this.getSnapshot();
  }

  updateSettings(settings: Partial<QueueEngineSettings>): void {
    this.#settings = freezeJsonValue({ ...this.#settings, ...settings });
    void this.processQueue();
  }

  evaluateResourceGuard(item: { url: string; targetPath: string; mimeType?: string; kind?: string }): {
    allowed: boolean;
    filterReason?: 'extension_blocked' | 'rule_mismatch';
  } {
    // 1. Exclude Glob Check (Veto First)
    if (this.#settings.downloadExcludeGlobs && this.#settings.downloadExcludeGlobs.trim() !== '') {
      if (matchSmartPatternList(this.#settings.downloadExcludeGlobs, item.url, false)) {
        return { allowed: false, filterReason: 'rule_mismatch' };
      }
    }

    // 2. Include Glob Check
    if (this.#settings.downloadIncludeGlobs && this.#settings.downloadIncludeGlobs.trim() !== '') {
      if (!matchSmartPatternList(this.#settings.downloadIncludeGlobs, item.url, true)) {
        return { allowed: false, filterReason: 'rule_mismatch' };
      }
    }

    // 3. Extension Check
    if (!this.#settings.forceDirectDownloadEnabled || !this.#settings.forceDirectDownloadExtensions) {
      return { allowed: true };
    }

    const rawExts = this.#settings.forceDirectDownloadExtensions
      .split(',')
      .map((ext) => ext.trim().toLowerCase())
      .filter((ext) => ext.length > 0);

    if (rawExts.length === 0) return { allowed: true };

    const formattedExts = rawExts.map((ext) => (ext.startsWith('.') ? ext : `.${ext}`));

    let fileExt = '';
    const pathCandidate = item.targetPath || item.url;
    try {
      const urlObj = new URL(pathCandidate, 'https://localhost');
      const pathname = urlObj.pathname;
      const lastDot = pathname.lastIndexOf('.');
      if (lastDot !== -1) {
        fileExt = pathname.slice(lastDot).toLowerCase();
      }
    } catch {
      const lastDot = pathCandidate.lastIndexOf('.');
      if (lastDot !== -1) {
        fileExt = pathCandidate.slice(lastDot).toLowerCase();
      }
    }

    if (!fileExt || !formattedExts.includes(fileExt)) {
      return { allowed: false, filterReason: 'extension_blocked' };
    }

    return { allowed: true };
  }

  evaluateSizeGuard(sizeBytes: number): { allowed: boolean; filterReason?: 'size_below_min' | 'size_above_max' } {
    if (!this.#settings.downloadSizeGuardEnabled || sizeBytes <= 0) return { allowed: true };
    if (this.#settings.downloadMinSizeBytes > 0 && sizeBytes < this.#settings.downloadMinSizeBytes) {
      return { allowed: false, filterReason: 'size_below_min' };
    }
    if (this.#settings.downloadMaxSizeBytes > 0 && sizeBytes > this.#settings.downloadMaxSizeBytes) {
      return { allowed: false, filterReason: 'size_above_max' };
    }
    return { allowed: true };
  }

  getSnapshot(): QueueStateSnapshot {
    const activeCount = this.#jobs.filter((j) => j.status === 'downloading' || j.status === 'scheduled').length;
    const queuedCount = this.#jobs.filter((j) => j.status === 'queued').length;
    const completedCount = this.#jobs.filter((j) => j.status === 'completed').length;
    const failedCount = this.#jobs.filter((j) => j.status === 'failed').length;
    const filteredCount = this.#jobs.filter((j) => j.status === 'filtered').length;

    return freezeJsonValue({
      isPaused: this.#isPaused,
      activeCount,
      queuedCount,
      completedCount,
      failedCount,
      filteredCount,
      jobs: this.#jobs,
      settings: this.#settings,
    });
  }

  async enqueue(item: {
    url: string;
    targetPath: string;
    originUrl?: string;
    kind?: 'video' | 'image' | 'audio' | 'stream' | 'document' | 'other';
    mimeType?: string;
    contentLength?: number;
  }): Promise<DownloadQueueJob> {
    let domain = 'unknown_domain';
    try {
      if (item.originUrl && item.originUrl.trim() !== '') {
        domain = new URL(item.originUrl).hostname;
      } else {
        domain = new URL(item.url).hostname;
      }
    } catch {
      // Fallback
    }

    const totalBytes = item.contentLength ?? -1;
    let initialStatus: 'queued' | 'filtered' = 'queued';
    let filterReason: 'size_below_min' | 'size_above_max' | 'extension_blocked' | 'rule_mismatch' | undefined = undefined;
    let lastError: string | undefined = undefined;

    // Layer 2: Resource & Extension Guard Check (In-Memory, 0 Network Cost)
    const resourceGuard = this.evaluateResourceGuard(item);
    if (!resourceGuard.allowed) {
      initialStatus = 'filtered';
      filterReason = resourceGuard.filterReason;
      lastError = 'Filtered: File extension not allowed by direct download rules';
    }

    // Layer 3: Download Size Guard Check (Sniffed Header)
    if (initialStatus !== 'filtered' && totalBytes > 0) {
      const sizeGuard = this.evaluateSizeGuard(totalBytes);
      if (!sizeGuard.allowed) {
        initialStatus = 'filtered';
        filterReason = sizeGuard.filterReason;
        lastError = filterReason === 'size_below_min' ? 'Filtered: Below minimum file size limit' : 'Filtered: Exceeds maximum file size limit';
      }
    }

    const job: DownloadQueueJob = freezeJsonValue({
      id: `job_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
      url: item.url,
      targetPath: item.targetPath,
      originUrl: item.originUrl ?? item.url,
      domain,
      kind: item.kind ?? 'other',
      ...(item.mimeType !== undefined ? { mimeType: item.mimeType } : {}),
      status: initialStatus,
      ...(filterReason !== undefined ? { filterReason } : {}),
      bytesReceived: 0,
      totalBytes,
      speedBytesPerSec: 0,
      retryCount: 0,
      enqueuedAt: Date.now(),
      ...(initialStatus === 'filtered' ? { endedAt: Date.now(), ...(lastError ? { lastError } : {}) } : {}),
    });

    this.#jobs = [...this.#jobs, job];
    await this.#store.saveQueueState(this.#jobs, this.#isPaused);
    void this.processQueue();
    return job;
  }

  async setPaused(paused: boolean): Promise<QueueStateSnapshot> {
    this.#isPaused = paused;
    if (paused) {
      this.#jobs = this.#jobs.map((j) => (j.status === 'downloading' || j.status === 'scheduled' ? { ...j, status: 'paused' } : j));
    } else {
      this.#jobs = this.#jobs.map((j) => (j.status === 'paused' ? { ...j, status: 'queued' } : j));
    }
    await this.#store.saveQueueState(this.#jobs, this.#isPaused);
    void this.processQueue();
    return this.getSnapshot();
  }

  async promoteJob(jobId: string): Promise<QueueStateSnapshot> {
    const idx = this.#jobs.findIndex((j) => j.id === jobId);
    if (idx > 0) {
      const [job] = this.#jobs.splice(idx, 1);
      if (job) {
        this.#jobs.unshift(job);
        await this.#store.saveQueueState(this.#jobs, this.#isPaused);
        void this.processQueue();
      }
    }
    return this.getSnapshot();
  }

  async removeJob(jobId: string): Promise<QueueStateSnapshot> {
    this.#jobs = this.#jobs.filter((j) => j.id !== jobId);
    await this.#store.saveQueueState(this.#jobs, this.#isPaused);
    return this.getSnapshot();
  }

  async clearCompleted(): Promise<QueueStateSnapshot> {
    this.#jobs = this.#jobs.filter((j) => j.status !== 'completed');
    await this.#store.saveQueueState(this.#jobs, this.#isPaused);
    return this.getSnapshot();
  }

  async retryFailed(): Promise<QueueStateSnapshot> {
    this.#jobs = this.#jobs.map((j) => (j.status === 'failed' ? { ...j, status: 'queued', retryCount: 0, lastError: undefined } : j));
    await this.#store.saveQueueState(this.#jobs, this.#isPaused);
    void this.processQueue();
    return this.getSnapshot();
  }

  updateJobProgress(chromeDownloadId: number, delta: { bytesReceived?: number; totalBytes?: number; state?: string; error?: string }): void {
    const jobIndex = this.#jobs.findIndex((j) => j.chromeDownloadId === chromeDownloadId);
    if (jobIndex < 0) return;

    const job = this.#jobs[jobIndex]!;
    let newStatus = job.status;
    let endedAt = job.endedAt;
    let lastError = job.lastError;
    let filterReason = job.filterReason;
    const totalBytes = delta.totalBytes ?? job.totalBytes;

    if (totalBytes > 0 && (job.status === 'downloading' || job.status === 'scheduled')) {
      const guard = this.evaluateSizeGuard(totalBytes);
      if (!guard.allowed) {
        if (job.chromeDownloadId && this.#chromeDownloads?.cancel) {
          void this.#chromeDownloads.cancel(job.chromeDownloadId);
        }
        newStatus = 'filtered';
        filterReason = guard.filterReason;
        endedAt = Date.now();
        lastError = filterReason === 'size_below_min' ? 'Filtered: Below minimum file size limit' : 'Filtered: Exceeds maximum file size limit';
      }
    }

    if (newStatus !== 'filtered') {
      if (delta.state === 'complete') {
        newStatus = 'completed';
        endedAt = Date.now();
      } else if (delta.state === 'interrupted' || delta.error) {
        newStatus = 'failed';
        endedAt = Date.now();
        lastError = delta.error ?? 'Download interrupted';
      }
    }

    const updated: DownloadQueueJob = freezeJsonValue({
      ...job,
      bytesReceived: delta.bytesReceived ?? job.bytesReceived,
      totalBytes,
      status: newStatus,
      ...(filterReason !== undefined ? { filterReason } : {}),
      endedAt,
      lastError,
    });

    this.#jobs[jobIndex] = updated;
    void this.#store.saveQueueState(this.#jobs, this.#isPaused);

    if (newStatus === 'completed' || newStatus === 'failed' || newStatus === 'filtered') {
      void this.processQueue();
    }
  }

  async processQueue(): Promise<void> {
    if (this.#isPaused || this.#processing) return;
    this.#processing = true;

    try {
      const activeJobs = this.#jobs.filter((j) => j.status === 'downloading' || j.status === 'scheduled');
      if (activeJobs.length >= this.#settings.maxGlobalConcurrency) return;

      const queuedJobs = this.#jobs.filter((j) => j.status === 'queued');
      if (queuedJobs.length === 0) return;

      // Group queued jobs by domain for round-robin fair dispatching
      const domainMap = new Map<string, DownloadQueueJob[]>();
      for (const job of queuedJobs) {
        const list = domainMap.get(job.domain) ?? [];
        list.push(job);
        domainMap.set(job.domain, list);
      }

      const now = Date.now();
      for (const [domain, jobs] of domainMap) {
        if (activeJobs.length >= this.#settings.maxGlobalConcurrency) break;

        const activeInDomain = activeJobs.filter((j) => j.domain === domain).length;
        if (activeInDomain >= this.#settings.maxDomainConcurrency) continue;

        const lastDispatch = this.#lastDomainDispatchTimes.get(domain) ?? 0;
        if (now - lastDispatch < this.#settings.downloadCooldownIntervalMs) continue;

        const jobToDispatch = jobs[0];
        if (!jobToDispatch) continue;

        const jobIndex = this.#jobs.findIndex((j) => j.id === jobToDispatch.id);
        if (jobIndex < 0) continue;

        // Layer 2 Check: Re-verify Resource/Extension Guard before dispatching (0 Network Cost)
        const resourceGuard = this.evaluateResourceGuard(jobToDispatch);
        if (!resourceGuard.allowed) {
          this.#jobs[jobIndex] = freezeJsonValue({
            ...jobToDispatch,
            status: 'filtered',
            filterReason: resourceGuard.filterReason,
            endedAt: Date.now(),
            lastError: 'Filtered: File extension not allowed by direct download rules',
          });
          await this.#store.saveQueueState(this.#jobs, this.#isPaused);
          continue;
        }

        // Layer 3 Check: Pre-flight HEAD size check if enabled and totalBytes unknown
        if (this.#settings.downloadPreflightHeadEnabled && jobToDispatch.totalBytes <= 0) {
          try {
            const res = await fetch(jobToDispatch.url, { method: 'HEAD' });
            const cl = res.headers.get('content-length');
            if (cl) {
              const bytes = parseInt(cl, 10);
              if (!isNaN(bytes) && bytes > 0) {
                const guard = this.evaluateSizeGuard(bytes);
                if (!guard.allowed) {
                  this.#jobs[jobIndex] = freezeJsonValue({
                    ...jobToDispatch,
                    status: 'filtered',
                    filterReason: guard.filterReason,
                    totalBytes: bytes,
                    endedAt: Date.now(),
                    lastError: guard.filterReason === 'size_below_min' ? 'Filtered: Below minimum file size limit' : 'Filtered: Exceeds maximum file size limit',
                  });
                  await this.#store.saveQueueState(this.#jobs, this.#isPaused);
                  continue;
                }
              }
            }
          } catch {
            // Ignore pre-flight fetch errors and proceed with normal download
          }
        }

        // Schedule job
        this.#jobs[jobIndex] = freezeJsonValue({
          ...jobToDispatch,
          status: 'scheduled',
          startedAt: Date.now(),
        });
        this.#lastDomainDispatchTimes.set(domain, now);

        if (this.#chromeDownloads) {
          try {
            const chromeDownloadId = await this.#chromeDownloads.download({
              url: jobToDispatch.url,
              filename: jobToDispatch.targetPath,
              saveAs: false,
            });

            this.#jobs[jobIndex] = freezeJsonValue({
              ...this.#jobs[jobIndex]!,
              status: 'downloading',
              chromeDownloadId,
            });
          } catch (err) {
            const errMsg = err instanceof Error ? err.message : String(err);
            this.#jobs[jobIndex] = freezeJsonValue({
              ...this.#jobs[jobIndex]!,
              status: 'failed',
              endedAt: Date.now(),
              lastError: errMsg,
            });
          }
        }

        await this.#store.saveQueueState(this.#jobs, this.#isPaused);
      }
    } finally {
      this.#processing = false;
    }
  }
}
</file>

