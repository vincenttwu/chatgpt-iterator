import assert from 'node:assert/strict';
import fs from 'node:fs';
import test from 'node:test';

import { PERFORMANCE_CONTRACT, runRepositoryPerformanceWorkloads } from '../../scripts/check-performance-capacity.mjs';

const HISTORY_READER = fs.readFileSync(new URL('../../src/persistence/history-reader.ts', import.meta.url), 'utf8');
const APP = fs.readFileSync(new URL('../../entrypoints/sidepanel/App.vue', import.meta.url), 'utf8');


test('STEP-12 performance contract uses measured local regression guards without inventing product maxima', () => {
  assert.equal(PERFORMANCE_CONTRACT.packageVersion, '0.0.30');
  assert.equal(PERFORMANCE_CONTRACT.measurement.clock, 'performance.now');
  assert.equal(PERFORMANCE_CONTRACT.measurement.portableTimingClaim, false);
  assert.deepEqual(PERFORMANCE_CONTRACT.productHardLimitsAdded, []);
