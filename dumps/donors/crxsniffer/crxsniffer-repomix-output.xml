import { CONTRACT_ERROR_CODES, ContractError } from './errors.ts';

export type Revision = number & { readonly __revisionBrand: unique symbol };
export type SchemaVersion = number & { readonly __schemaVersionBrand: unique symbol };
export type ProtocolVersion = number & { readonly __protocolVersionBrand: unique symbol };

export const INITIAL_REVISION = 1 as Revision;
export const CORE_SCHEMA_VERSION = 1 as SchemaVersion;
export const MESSAGE_SCHEMA_VERSION = 1 as SchemaVersion;
export const MESSAGE_PROTOCOL_VERSION = 1 as ProtocolVersion;

function requirePositiveSafeInteger(
  value: unknown,
  code: typeof CONTRACT_ERROR_CODES.invalidRevision |
    typeof CONTRACT_ERROR_CODES.invalidSchemaVersion |
    typeof CONTRACT_ERROR_CODES.invalidProtocolVersion,
  label: string,
): number {
  if (!Number.isSafeInteger(value) || (value as number) < 1) {
    throw new ContractError(code, `${label} must be a positive safe integer`, { label });
  }
  return value as number;
}

/** Validate a reusable-definition or entity revision. */
export function requireRevision(value: unknown): Revision {
  return requirePositiveSafeInteger(
    value,
    CONTRACT_ERROR_CODES.invalidRevision,
    'revision',
  ) as Revision;
}

/** Increment a revision without allowing numeric wrap or unsafe integers. */
export function nextRevision(value: Revision): Revision {
  const current = requireRevision(value);
  if (current === Number.MAX_SAFE_INTEGER) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidRevision,
      'revision cannot exceed Number.MAX_SAFE_INTEGER',
    );
  }
  return (current + 1) as Revision;
}

/** Validate a logical object schema version. */
export function requireSchemaVersion(value: unknown): SchemaVersion {
  return requirePositiveSafeInteger(
    value,
    CONTRACT_ERROR_CODES.invalidSchemaVersion,
    'schemaVersion',
  ) as SchemaVersion;
}

/** Validate a cross-context transport protocol version. */
export function requireProtocolVersion(value: unknown): ProtocolVersion {
  return requirePositiveSafeInteger(
    value,
    CONTRACT_ERROR_CODES.invalidProtocolVersion,
    'protocolVersion',
  ) as ProtocolVersion;
}
</file>

