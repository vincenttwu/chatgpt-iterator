import { assertJsonSafe, cloneJsonValue, type JsonObject } from '../core/index.ts';
import { PERSISTENCE_ERROR_CODES, PersistenceError, normalizePersistenceWriteError } from './errors.ts';
import {
  CRSNIFFER_DATABASE_NAME,
  CRSNIFFER_DATABASE_VERSION,
  PERSISTENCE_STORES,
  applyPhysicalUpgrade,
  type PersistenceStoreName,
} from './schema.ts';
import {
  requireDefinitionRecord,
  requireMetaRecord,
  requirePageFieldSnapshotRecord,
  requireResourceObservationRecord,
  requireWatchSessionRecord,
} from './records.ts';
import { JsonRecordRepository, type RepositoryStorePort } from './repository.ts';

function requestResult<T>(request: IDBRequest<T>): Promise<T> {
  return new Promise<T>((resolve, reject) => {
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error ?? new Error('IndexedDB request failed'));
  });
}

function transactionComplete(transaction: IDBTransaction): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    transaction.oncomplete = () => resolve();
    transaction.onabort = () => reject(transaction.error ?? new Error('IndexedDB transaction aborted'));
    transaction.onerror = () => reject(transaction.error ?? new Error('IndexedDB transaction failed'));
  });
}

class IndexedDbStorePort implements RepositoryStorePort {
  readonly #database: IDBDatabase;
  readonly #storeName: PersistenceStoreName;

  constructor(database: IDBDatabase, storeName: PersistenceStoreName) {
    this.#database = database;
    this.#storeName = storeName;
  }

  async get(key: string): Promise<unknown> {
    const transaction = this.#database.transaction(this.#storeName, 'readonly');
    const request = transaction.objectStore(this.#storeName).get(key);
    const result = await requestResult(request);
    await transactionComplete(transaction);
    return result;
  }

  async put(value: JsonObject): Promise<void> {
    assertJsonSafe(value);
    try {
      const transaction = this.#database.transaction(this.#storeName, 'readwrite');
      transaction.objectStore(this.#storeName).put(cloneJsonValue(value));
      await transactionComplete(transaction);
    } catch (error) {
      throw normalizePersistenceWriteError(error, this.#storeName);
    }
  }

  async delete(key: string): Promise<void> {
    const transaction = this.#database.transaction(this.#storeName, 'readwrite');
    transaction.objectStore(this.#storeName).delete(key);
    await transactionComplete(transaction);
  }

  async count(): Promise<number> {
    const transaction = this.#database.transaction(this.#storeName, 'readonly');
    const result = await requestResult(transaction.objectStore(this.#storeName).count());
    await transactionComplete(transaction);
    return result;
  }

  async clear(): Promise<void> {
    const transaction = this.#database.transaction(this.#storeName, 'readwrite');
    transaction.objectStore(this.#storeName).clear();
    await transactionComplete(transaction);
  }

  async getAll(): Promise<readonly unknown[]> {
    const transaction = this.#database.transaction(this.#storeName, 'readonly');
    const result = await requestResult(transaction.objectStore(this.#storeName).getAll());
    await transactionComplete(transaction);
    return result;
  }
}

export interface OpenCrSnifferDatabaseOptions {
  readonly factory?: IDBFactory;
  readonly onBlocked?: () => void;
  readonly onForcedClose?: () => void;
}

/** Open the canonical database and close stale connections when another version wants authority. */
export function openCrSnifferDatabase(
  options: OpenCrSnifferDatabaseOptions = {},
): Promise<IDBDatabase> {
  const factory = options.factory ?? globalThis.indexedDB;
  if (factory === undefined) {
    return Promise.reject(new PersistenceError(
      PERSISTENCE_ERROR_CODES.unavailable,
      'IndexedDB is unavailable in this execution context',
    ));
  }

  return new Promise<IDBDatabase>((resolve, reject) => {
    const request = factory.open(CRSNIFFER_DATABASE_NAME, CRSNIFFER_DATABASE_VERSION);
    let settled = false;
    let upgradeFailure: unknown;

    request.onupgradeneeded = (event) => {
      const transaction = request.transaction;
      if (transaction === null) {
        upgradeFailure = new PersistenceError(
          PERSISTENCE_ERROR_CODES.failed,
          'IndexedDB upgrade did not expose a versionchange transaction',
        );
        request.result.close();
        return;
      }
      try {
        applyPhysicalUpgrade(
          request.result,
          transaction,
          event.oldVersion,
          event.newVersion,
        );
      } catch (error) {
        upgradeFailure = error;
        transaction.abort();
      }
    };

    request.onblocked = () => {
      // There is no cancellation API for IDBOpenDBRequest. Surface the blocked state but keep the
      // request pending so an abandoned caller cannot later cause a surprise upgrade after rejection.
      options.onBlocked?.();
    };

    request.onerror = () => {
      if (!settled) {
        settled = true;
        reject(upgradeFailure instanceof Error
          ? upgradeFailure
          : new PersistenceError(
              PERSISTENCE_ERROR_CODES.failed,
              request.error?.message ?? 'IndexedDB open failed',
            ));
      }
    };

    request.onsuccess = () => {
      const database = request.result;
      database.onversionchange = () => database.close();
      database.onclose = () => options.onForcedClose?.();
      if (settled) {
        database.close();
        return;
      }
      settled = true;
      resolve(database);
    };
  });
}

export function createIndexedDbRepositories(database: IDBDatabase) {
  const store = (name: PersistenceStoreName) => new IndexedDbStorePort(database, name);
  return Object.freeze({
    meta: new JsonRecordRepository(PERSISTENCE_STORES.meta, store(PERSISTENCE_STORES.meta), requireMetaRecord),
    definitions: new JsonRecordRepository(
      PERSISTENCE_STORES.definitions,
      store(PERSISTENCE_STORES.definitions),
      requireDefinitionRecord,
    ),
    watchSessions: new JsonRecordRepository(
      PERSISTENCE_STORES.watchSessions,
      store(PERSISTENCE_STORES.watchSessions),
      requireWatchSessionRecord,
    ),
    resourceObservations: new JsonRecordRepository(
      PERSISTENCE_STORES.resourceObservations,
      store(PERSISTENCE_STORES.resourceObservations),
      requireResourceObservationRecord,
    ),
    pageFieldSnapshots: new JsonRecordRepository(
      PERSISTENCE_STORES.pageFieldSnapshots,
      store(PERSISTENCE_STORES.pageFieldSnapshots),
      requirePageFieldSnapshotRecord,
    ),
  });
}
