import type { StableId } from '../core/index.ts';
import type { ResourceHistoryRow, VirtualResourceWindow } from './history-types.ts';

export interface VirtualResourceWindowInput {
  readonly itemCount: number;
  readonly rowHeight: number;
  readonly viewportHeight: number;
  readonly scrollTop: number;
  readonly overscan?: number;
}

/** Pure fixed-row virtual window used by the Side Panel to avoid mounting complete history. */
export function virtualResourceWindow(input: VirtualResourceWindowInput): VirtualResourceWindow {
  const itemCount = Math.max(0, Math.trunc(input.itemCount));
  const rowHeight = Math.max(1, input.rowHeight);
  const viewportHeight = Math.max(0, input.viewportHeight);
  const scrollTop = Math.max(0, input.scrollTop);
  const overscan = Math.max(0, Math.trunc(input.overscan ?? 4));
  const visibleStart = Math.floor(scrollTop / rowHeight);
  const visibleCount = Math.max(1, Math.ceil(viewportHeight / rowHeight));
  const startIndex = Math.min(itemCount, Math.max(0, visibleStart - overscan));
  const endIndex = Math.min(itemCount, visibleStart + visibleCount + overscan);
  return Object.freeze({
    startIndex,
    endIndex,
    offsetTop: startIndex * rowHeight,
    totalHeight: itemCount * rowHeight,
  });
}


export interface MergeResourceHistoryRowsInput {
  readonly current: readonly ResourceHistoryRow[];
  readonly incoming: readonly ResourceHistoryRow[];
  readonly limit: number;
  readonly preserveObservationId?: StableId<'resourceObservation'>;
}

/**
 * Merge immutable occurrence rows newest-first while keeping presentation state bounded.
 * When a selected occurrence is still present in the merged authority, keep it in the
 * bounded buffer even if newer inserts would otherwise trim it from the tail.
 */
export function mergeResourceHistoryRows(input: MergeResourceHistoryRowsInput): readonly ResourceHistoryRow[] {
  const limit = Math.max(1, Math.trunc(input.limit));
  const merged = new Map<StableId<'resourceObservation'>, ResourceHistoryRow>();
  for (const row of input.current) merged.set(row.observationId, row);
  for (const row of input.incoming) merged.set(row.observationId, row);
  const sorted = [...merged.values()].sort((left, right) => {
    const byTime = right.observedAt.localeCompare(left.observedAt);
    return byTime !== 0 ? byTime : right.observationId.localeCompare(left.observationId);
  });
  if (sorted.length <= limit) return Object.freeze(sorted);
  const clipped = sorted.slice(0, limit);
  const preserveId = input.preserveObservationId;
  if (preserveId === undefined || clipped.some((row) => row.observationId === preserveId)) {
    return Object.freeze(clipped);
  }
  const preserved = sorted.find((row) => row.observationId === preserveId);
  if (preserved === undefined) return Object.freeze(clipped);
  clipped[clipped.length - 1] = preserved;
  clipped.sort((left, right) => {
    const byTime = right.observedAt.localeCompare(left.observedAt);
    return byTime !== 0 ? byTime : right.observationId.localeCompare(left.observationId);
  });
  return Object.freeze(clipped);
}
