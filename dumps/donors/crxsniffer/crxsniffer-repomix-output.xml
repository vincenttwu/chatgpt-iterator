  type SavePackagizerRuleOrderInput,
  type SavePackagizerTemplateInput,
} from './workspace.ts';
import { PackagizerError } from './errors.ts';
import { requirePackagizerRuleBody } from './validation.ts';

export const PACKAGIZER_WORKSPACE_OPERATIONS = Object.freeze({
  snapshot: 'packagizer.workspace',
  tokenBrowser: 'packagizer.tokens',
  preview: 'packagizer.preview',
  saveRule: 'packagizer.rule.save',
  saveTemplate: 'packagizer.template.save',
  saveRuleOrder: 'packagizer.rules.order',
  deleteDefinition: 'packagizer.definition.delete',
} as const);

export type PackagizerWorkspaceOperation = typeof PACKAGIZER_WORKSPACE_OPERATIONS[keyof typeof PACKAGIZER_WORKSPACE_OPERATIONS];

function requireOnlyKeys(payload: JsonObject, allowed: readonly string[]): void {
  const allowedSet = new Set(allowed);
  for (const key of Object.keys(payload)) {
    if (!allowedSet.has(key)) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `Unsupported Packagizer workspace field: ${key}`);
    }
  }
}

function requireBoolean(value: unknown, label: string): boolean {
  if (typeof value !== 'boolean') throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be boolean`);
  return value;
}

function requireString(value: unknown, label: string): string {
  if (typeof value !== 'string') throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be a string`);
  return value;
}

function requireMode(value: unknown): 'create' | 'update' {
  if (value !== 'create' && value !== 'update') throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'mode must be create or update');
  return value;
}

function requireTemplateInput(payload: JsonObject): SavePackagizerTemplateInput {
  const mode = requireMode(payload.mode);
  return {
    mode,
    ...(payload.definitionId === undefined ? {} : { definitionId: requireStableId(payload.definitionId, 'definition') }),
    ...(payload.expectedRevision === undefined ? {} : { expectedRevision: requireRevision(payload.expectedRevision) }),
    name: requireString(payload.name, 'name'),
    enabled: requireBoolean(payload.enabled, 'enabled'),
    text: requireString(payload.text, 'text'),
  };
}

function requireRuleInput(payload: JsonObject): SavePackagizerRuleInput {
  const mode = requireMode(payload.mode);
  return {
    mode,
    ...(payload.definitionId === undefined ? {} : { definitionId: requireStableId(payload.definitionId, 'definition') }),
    ...(payload.expectedRevision === undefined ? {} : { expectedRevision: requireRevision(payload.expectedRevision) }),
    name: requireString(payload.name, 'name'),
    enabled: requireBoolean(payload.enabled, 'enabled'),
    body: requirePackagizerRuleBody(payload.body),
  };
}

function requireRuleOrderInput(payload: JsonObject): SavePackagizerRuleOrderInput {
  if (!Array.isArray(payload.ruleIds)) throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'ruleIds must be an array');
  return {
    watchDefinitionId: requireStableId(payload.watchDefinitionId, 'definition'),
    expectedWatchRevision: requireRevision(payload.expectedWatchRevision),
    ruleIds: Object.freeze(payload.ruleIds.map((id) => requireStableId(id, 'definition'))),
  };
}

function requireDeleteInput(payload: JsonObject): DeletePackagizerDefinitionInput {
  if (payload.kind !== 'packagizerRule' && payload.kind !== 'template') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'kind must be packagizerRule or template');
  }
  return {
    definitionId: requireStableId(payload.definitionId, 'definition'),
    expectedRevision: requireRevision(payload.expectedRevision),
    kind: payload.kind,
  };
}

function requireTokenBrowserInput(payload: JsonObject): PackagizerTokenBrowserInput {
  return {
    watchDefinitionId: requireStableId(payload.watchDefinitionId, 'definition'),
    expectedWatchRevision: requireRevision(payload.expectedWatchRevision),
  };
}

function requirePreviewInput(payload: JsonObject): PackagizerPreviewInput {
  return {
    watchDefinitionId: requireStableId(payload.watchDefinitionId, 'definition'),
    expectedWatchRevision: requireRevision(payload.expectedWatchRevision),
    observationId: requireStableId(payload.observationId, 'resourceObservation'),
  };
}

export class PackagizerWorkspaceMessageRouter {
  readonly #service: PackagizerWorkspaceService;

  constructor(service: PackagizerWorkspaceService) {
    this.#service = service;
  }

  async handle(message: unknown): Promise<ResponseEnvelope> {
    let request: RequestEnvelope;
    try {
      const envelope = requireMessageEnvelope(message);
      if (envelope.kind !== 'request') throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Packagizer workspace accepts request envelopes only');
      request = envelope;
    } catch (error) {
      throw error;
    }
    try {
      const payload = requireJsonObject(request.payload);
      switch (request.operation) {
        case PACKAGIZER_WORKSPACE_OPERATIONS.snapshot:
          requireOnlyKeys(payload, []);
          return createSuccessResponse(request, await this.#service.snapshot());
        case PACKAGIZER_WORKSPACE_OPERATIONS.tokenBrowser:
          requireOnlyKeys(payload, ['watchDefinitionId', 'expectedWatchRevision']);
          return createSuccessResponse(request, await this.#service.tokenBrowser(requireTokenBrowserInput(payload)));
        case PACKAGIZER_WORKSPACE_OPERATIONS.preview:
          requireOnlyKeys(payload, ['watchDefinitionId', 'expectedWatchRevision', 'observationId']);
          return createSuccessResponse(request, await this.#service.preview(requirePreviewInput(payload)));
        case PACKAGIZER_WORKSPACE_OPERATIONS.saveRule:
          requireOnlyKeys(payload, ['mode', 'definitionId', 'expectedRevision', 'name', 'enabled', 'body']);
          return createSuccessResponse(request, await this.#service.saveRule(requireRuleInput(payload)));
        case PACKAGIZER_WORKSPACE_OPERATIONS.saveTemplate:
          requireOnlyKeys(payload, ['mode', 'definitionId', 'expectedRevision', 'name', 'enabled', 'text']);
          return createSuccessResponse(request, await this.#service.saveTemplate(requireTemplateInput(payload)));
        case PACKAGIZER_WORKSPACE_OPERATIONS.saveRuleOrder:
          requireOnlyKeys(payload, ['watchDefinitionId', 'expectedWatchRevision', 'ruleIds']);
          return createSuccessResponse(request, await this.#service.saveRuleOrder(requireRuleOrderInput(payload)));
        case PACKAGIZER_WORKSPACE_OPERATIONS.deleteDefinition:
          requireOnlyKeys(payload, ['definitionId', 'expectedRevision', 'kind']);
          return createSuccessResponse(request, await this.#service.deleteDefinition(requireDeleteInput(payload)));
        default:
          throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, `Unknown Packagizer workspace operation: ${request.operation}`);
      }
    } catch (error) {
      if (error instanceof DefinitionError) {
        return createFailureResponse(request, toContractErrorPayload(new ContractError(
          error.code === DEFINITION_ERROR_CODES.revisionConflict
            ? CONTRACT_ERROR_CODES.invalidRevision
            : CONTRACT_ERROR_CODES.invalidArgument,
          error.message,
          { domainCode: error.code },
        )));
      }
      if (error instanceof PackagizerError) {
        return createFailureResponse(request, toContractErrorPayload(new ContractError(
          CONTRACT_ERROR_CODES.invalidArgument,
          error.message,
          { domainCode: error.code },
        )));
      }
      return createFailureResponse(request, toContractErrorPayload(error));
    }
  }
}

async function responseValue<T>(runtime: ChromeRuntimePanelLike, operation: PackagizerWorkspaceOperation, payload: JsonObject): Promise<T> {
  const request = createRequestEnvelope({ operation, payload });
  const response = requireMessageEnvelope(await runtime.sendMessage(request));
  if (response.kind !== 'response' || response.requestId !== request.requestId || response.operation !== operation) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Packagizer workspace response correlation failed');
  }
  if (!response.outcome.ok) {
    throw new ContractError(response.outcome.error.code, response.outcome.error.message, response.outcome.error.details);
  }
  return response.outcome.value as T;
}

export class PackagizerPanelClient {
  readonly #runtime: ChromeRuntimePanelLike;

  constructor(runtime: ChromeRuntimePanelLike) {
    this.#runtime = runtime;
  }

  snapshot(): Promise<PackagizerWorkspaceSnapshot> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.snapshot, {});
  }

  tokenBrowser(input: PackagizerTokenBrowserInput): Promise<PackagizerTokenBrowserResult> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.tokenBrowser, input);
  }

  preview(input: PackagizerPreviewInput): Promise<PackagizerPreviewResult> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.preview, input);
  }

  saveRule(input: SavePackagizerRuleInput): Promise<PackagizerSaveResult<PackagizerRuleSummary>> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.saveRule, input);
  }

  saveTemplate(input: SavePackagizerTemplateInput): Promise<PackagizerSaveResult<PackagizerTemplateSummary>> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.saveTemplate, input);
  }

  saveRuleOrder(input: SavePackagizerRuleOrderInput): Promise<PackagizerRuleOrderResult> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.saveRuleOrder, input);
  }

  deleteDefinition(input: DeletePackagizerDefinitionInput): Promise<PackagizerDeleteResult> {
    return responseValue(this.#runtime, PACKAGIZER_WORKSPACE_OPERATIONS.deleteDefinition, input);
  }
}
