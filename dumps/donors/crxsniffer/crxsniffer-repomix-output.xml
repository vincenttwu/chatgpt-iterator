<file path="src/resources/glob.ts">
import { RESOURCE_ERROR_CODES, ResourceError } from './errors.ts';

function regexEscape(value: string): string {
  return value.replace(/[|\\{}()[\]^$+*?.]/g, '\\$&');
}

export function compileResourceGlob(pattern: string): RegExp {
  if (pattern.length === 0) {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidGlob, 'resource glob must not be empty');
  }
  let source = '^';
  for (let index = 0; index < pattern.length; index += 1) {
    const char = pattern[index]!;
    if (char === '*') {
      source += '.*';
      continue;
    }
    if (char === '?') {
      source += '.';
      continue;
    }
    if (char === '\\') {
      const next = pattern[index + 1];
      if (next === undefined) {
        throw new ResourceError(RESOURCE_ERROR_CODES.invalidGlob, 'resource glob may not end with an escape');
      }
      if (next !== '*' && next !== '?' && next !== '\\') {
        throw new ResourceError(RESOURCE_ERROR_CODES.invalidGlob, `unsupported resource glob escape \\${next}`);
      }
      source += regexEscape(next);
      index += 1;
      continue;
    }
    source += regexEscape(char);
  }
  source += '$';
  return new RegExp(source, 'u');
}

export function matchResourceGlob(pattern: string, canonicalUrl: string): boolean {
  return compileResourceGlob(pattern).test(canonicalUrl);
}

export function compileSmartPattern(pattern: string): RegExp {
  let trimmed = pattern.trim();
  if (trimmed === '' || trimmed === '*') {
    return /^.*$/iu;
  }
  if (trimmed.startsWith('re:')) {
    const regexBody = trimmed.slice(3).trim();
    if (regexBody.length === 0) return /^.*$/iu;
    try {
      return new RegExp(regexBody, 'iu');
    } catch {
      throw new ResourceError(
        RESOURCE_ERROR_CODES.invalidGlob,
        `Invalid regular expression pattern ${regexBody}`,
      );
    }
  }
  // Validate strict glob first so unclosed escape sequences throw properly
  compileResourceGlob(trimmed);

  if (!trimmed.endsWith('*') && !trimmed.endsWith('?')) {
    trimmed = `${trimmed}*`;
  }
  return compileResourceGlob(trimmed);
}

export function parseSmartPatternList(rawInput: string): string[] {
  if (!rawInput || rawInput.trim() === '') return [];
  return rawInput
    .split(/[\n,;]+/)
    .map((p) => p.trim())
    .filter((p) => p.length > 0);
}

export function compileSmartPatternList(rawInput: string): RegExp[] {
  const patterns = parseSmartPatternList(rawInput);
  return patterns.map((p) => compileSmartPattern(p));
}

export function matchSmartPatternList(patternsRaw: string, targetUrl: string, defaultMatch = true): boolean {
  const compiled = compileSmartPatternList(patternsRaw);
  if (compiled.length === 0) return defaultMatch;
  return compiled.some((regex) => regex.test(targetUrl));
}
