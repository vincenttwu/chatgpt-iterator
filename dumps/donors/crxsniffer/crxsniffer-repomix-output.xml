function mergeConfiguration(configuration: WatchConfigurationSummary): void {
  configurations.value = Object.freeze([
    ...configurations.value.filter((entry) => entry.watchDefinitionId !== configuration.watchDefinitionId),
    configuration,
  ].sort((left, right) => {
    if (left.builtIn) return -1;
    if (right.builtIn) return 1;
    return left.name.localeCompare(right.name);
  }));
}

function domainCode(error: unknown): unknown {
  return error instanceof ContractError ? error.details?.domainCode : undefined;
}

function humanOperationError(error: unknown, fallback: string): string {
  if (domainCode(error) === 'definition_revision_conflict') {
    return ui('this_saved_setup_changed_elsewhere_your_working_copy');
