}

test('Preview and live invoke the same pure evaluator and produce identical immutable projections', async () => {
  const seeded = await session();
  const input = { session: seeded.session, observation: observation() };
  const live = evaluateResourceCandidate(input);
  const preview = previewResourceCandidate(input);
  assert.deepEqual(preview, live);
  assert.equal(live.status, 'projected');
  assert.equal(live.projection?.canonicalUrl, 'https://cdn.example.test/media/My%20Video.mp4?secret=A');
  assert.equal(live.projection?.derived.filename, 'my video.mp4');
  assert.equal(live.projection?.derived.group, 'CDN.EXAMPLE.TEST');
  assert.equal(live.projection?.authority.definitionSetDigest, seeded.session.value.definitionSetDigest);
  assert.equal(Object.isFrozen(live), true);
  assert.equal(Object.isFrozen(live.projection), true);
});

test('structural explanation records rule/token/action outcomes without durable raw values', async () => {
  const seeded = await session();
  const result = evaluateResourceCandidate({ session: seeded.session, observation: observation() });
  assert.equal(result.explanation.packagizerStatus, 'evaluated');
  const rules = result.explanation.packagizer?.rules ?? [];
  assert.equal(rules[0]?.ruleId, IDS.ruleDisabled);
  assert.equal(rules[0]?.outcome, 'disabled');
  assert.equal(rules[1]?.conditions[0]?.sourceState, 'value');
  assert.deepEqual(rules[1]?.actions[0]?.tokens[0]?.transforms, ['trim', 'lower', 'filename_safe']);
  assert.equal(rules[2]?.outcome, 'stopped');
  const serialized = JSON.stringify(result.explanation);
