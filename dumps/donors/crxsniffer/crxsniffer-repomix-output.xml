test('recomputing from immutable observation + frozen session is deterministic without a second mutable projection store', async () => {
  const seeded = await session();
  const first = evaluateResourceCandidate({ session: seeded.session, observation: observation() });
  const second = evaluateResourceCandidate({ session: structuredClone(seeded.session), observation: structuredClone(observation()) });
  assert.deepEqual(second, first);
});

test('ResourceEvaluationService loads the durable WatchSession and delegates to the same evaluator', async () => {
  const seeded = await session();
  const record = observation();
  const direct = evaluateResourceCandidate({ session: seeded.session, observation: record });
  const service = new ResourceEvaluationService(seeded.sessions);
  assert.deepEqual(await service.evaluateObservation(record), direct);
});

test('Packagizer resource Preview transiently freezes the current saved Watch and returns only privacy-bounded result data', async () => {
  const seeded = await session();
  const observationStore = new MemoryStore();
  const observations = new JsonRecordRepository<ResourceObservationRecord>(
    PERSISTENCE_STORES.resourceObservations,
    observationStore,
    requireResourceObservationRecord,
  );
  const source = observation();
  await observations.put(source);
  const previewSessionId = createStableId('watchSession', () => '92000000-0000-4000-8000-000000000099');
  const previewObservationId = createStableId('resourceObservation', () => '93000000-0000-4000-8000-000000000099');
  const preview = new PackagizerResourcePreviewService({
    composer: seeded.composer,
    observations,
    evaluation: new ResourceEvaluationService(seeded.sessions),
    now: () => T1,
    createWatchSessionId: () => previewSessionId,
    createObservationId: () => previewObservationId,
  });

  const beforeSessions = await seeded.sessions.list();
  const result = await preview.preview({
    watchDefinitionId: IDS.watch,
    expectedWatchRevision: 1 as never,
    observationId: IDS.observation,
  });

  assert.equal(result.status, 'projected');
  assert.equal(result.sourceObservationId, IDS.observation);
  assert.equal(result.watchDefinitionId, IDS.watch);
  assert.equal(result.derived.filename, 'my video.mp4');
  assert.equal(result.rules.length >= 2, true);
  assert.deepEqual(await seeded.sessions.list(), beforeSessions, 'Preview must not persist its transient WatchSession');
  assert.deepEqual(await observations.get(IDS.observation), source, 'Preview must not mutate the captured source observation');
  assert.equal(await observations.get(previewObservationId), undefined, 'Preview must not persist a rebound observation');
  const serialized = JSON.stringify(result);
  assert.equal(serialized.includes('secret=A'), false);
  assert.equal(serialized.includes('eval-request-1'), false);
  assert.equal(serialized.includes('doc-eval'), false);
});

test('resource observation validator preserves an immutable evaluation snapshot beside untouched raw value', async () => {
  const seeded = await session();
  const record = observation();
  const evaluation = evaluateResourceCandidate({ session: seeded.session, observation: record });
  const validated = requireResourceObservationRecord({ ...record, evaluation });
  assert.equal(validated.value.finalUrl, record.value.finalUrl);
  assert.deepEqual(validated.evaluation, evaluation);
  assert.equal(Object.isFrozen(validated.evaluation), true);
});

function lifecycleRequest(overrides: Partial<WebRequestBaseDetails> = {}): WebRequestBaseDetails {
  return {
    requestId: 'eval-lifecycle-request-1',
    url: 'https://cdn.example.test/media/My%20Video.mp4?secret=A#network',
    method: 'GET',
    tabId: 7,
    type: 'media',
    timeStamp: Date.parse(T0),
    frameId: 0,
    documentId: 'doc-eval',
    ...overrides,
  };
}

function lifecyclePorts() {
  const raw = new MemoryStore();
  const observations = new JsonRecordRepository<ResourceObservationRecord>(
    PERSISTENCE_STORES.resourceObservations,
    raw,
    requireResourceObservationRecord,
  );
  const pending = new MemoryPending();
  const state = new MemorySessionState();
  state.values.set(WATCH_SESSION_STORAGE_KEY, {
    schemaVersion: 1,
    watchSessionId: IDS.session,
    tabId: 7,
    startedAt: T0,
  });
  return { raw, observations, pending, state };
}

test('live observation lifecycle attaches evaluation on the single initial durable write without changing raw value', async () => {
  const seeded = await session();
  const ports = lifecyclePorts();
  const service = new ResourceEvaluationService(seeded.sessions);
  let evaluatorInput: ResourceObservationRecord | undefined;
  const lifecycle = new ObservationLifecycle({
    observations: ports.observations,
    pending: ports.pending,
    sessionState: ports.state,
    createObservationId: () => IDS.lifecycleObservation,
    evaluate: async (record) => {
      evaluatorInput = structuredClone(record);
      return service.evaluateObservation(record);
    },
  });

  await lifecycle.beforeRequest(lifecycleRequest());
  await lifecycle.completed({
    ...lifecycleRequest({ timeStamp: Date.parse(T1) }),
    statusCode: 206,
  });

  assert.ok(evaluatorInput);
  assert.equal(evaluatorInput.evaluation, undefined);
  assert.equal(evaluatorInput.value.finalUrl, lifecycleRequest().url);
  const [persisted] = await ports.observations.list();
  assert.ok(persisted);
  assert.equal(ports.raw.putCount, 1, 'observation is persisted once with its evaluation sibling');
  assert.equal(persisted.value.finalUrl, lifecycleRequest().url);
  assert.equal((persisted.evaluation as JsonObject | undefined)?.status, 'projected');
  assert.equal(ports.pending.values.size, 0);
});

test('structural live evaluation failure prevents observation write and preserves terminal pending trace for retry', async () => {
  const seeded = await session();
  const ports = lifecyclePorts();
  const service = new ResourceEvaluationService(seeded.sessions);
  let fail = true;
  const lifecycle = new ObservationLifecycle({
    observations: ports.observations,
    pending: ports.pending,
    sessionState: ports.state,
    createObservationId: () => IDS.lifecycleObservation,
    evaluate: async (record) => {
      if (fail) throw new Error('evaluation authority unavailable');
      return service.evaluateObservation(record);
    },
  });

  await lifecycle.beforeRequest(lifecycleRequest());
  await assert.rejects(
    lifecycle.completed({ ...lifecycleRequest({ timeStamp: Date.parse(T1) }), statusCode: 206 }),
    /evaluation authority unavailable/,
  );
  assert.equal((await ports.observations.list()).length, 0);
  assert.equal(ports.raw.putCount, 0);
  const [terminalPending] = await ports.pending.list();
  assert.equal((terminalPending?.terminal as JsonObject | undefined)?.kind, 'completed');

  fail = false;
  await lifecycle.resumeTerminalPending();
  const [persisted] = await ports.observations.list();
  assert.ok(persisted);
  assert.equal(persisted.id, IDS.lifecycleObservation);
  assert.equal((persisted.evaluation as JsonObject | undefined)?.status, 'projected');
  assert.equal(ports.raw.putCount, 1);
  assert.equal(ports.pending.values.size, 0);
});
