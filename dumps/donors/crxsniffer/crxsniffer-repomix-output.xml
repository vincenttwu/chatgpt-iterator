import {
  CONTRACT_ERROR_CODES,
  ContractError,
  freezeJsonValue,
  requireJsonObject,
  requireRevision,
  requireStableId,
  type JsonObject,
  type JsonValue,
} from '../core/index.ts';
import {
  PAGE_CONTEXT_SCHEMA_VERSION,
  PAGE_CONTEXT_STATE_SCHEMA_VERSION,
  type ObservationAttributionStatus,
  type ObservationPageAttribution,
  type PageContextSessionState,
  type PageContextValue,
  type PageDocumentLink,
} from './types.ts';

const ATTRIBUTION_STATUSES = new Set<ObservationAttributionStatus>([
  'exact_top_document',
  'exact_descendant',
  'unattributed',
  'stale_or_ambiguous',
]);

function requiredString(value: unknown, label: string): string {
  if (typeof value !== 'string' || value.length === 0) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be a non-empty string`, { label });
  }
  return value;
}

function requiredInteger(value: unknown, label: string, minimum = 0): number {
  if (!Number.isSafeInteger(value) || (value as number) < minimum) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be a safe integer >= ${minimum}`, { label });
  }
  return value as number;
}

function canonicalHttpUrl(value: unknown, label: string): URL {
  const text = requiredString(value, label);
  let url: URL;
  try {
    url = new URL(text);
  } catch {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be an absolute URL`, { label });
  }
  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be HTTP(S)`, { label });
  }
  return url;
}

export function requirePageContextValue(value: unknown): PageContextValue {
  const record = requireJsonObject(value as JsonValue);
  if (record.schemaVersion !== PAGE_CONTEXT_SCHEMA_VERSION) {
    throw new ContractError(CONTRACT_ERROR_CODES.unsupportedSchemaVersion, 'unsupported PageContext schemaVersion');
  }
  requireStableId(record.watchSessionId, 'watchSession');
  requiredInteger(record.tabId, 'tabId');
  requiredString(record.topDocumentId, 'topDocumentId');
  requireRevision(record.pageRevision);
  const url = canonicalHttpUrl(record.url, 'url');
  if (record.origin !== url.origin) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'PageContext origin must match url origin');
  }
  return freezeJsonValue(record) as unknown as PageContextValue;
}

export function requirePageDocumentLink(value: unknown): PageDocumentLink {
  const record = requireJsonObject(value as JsonValue);
  requiredString(record.documentId, 'documentId');
  requiredInteger(record.frameId, 'frameId');
  requiredString(record.topDocumentId, 'topDocumentId');
  if (record.parentDocumentId !== undefined) requiredString(record.parentDocumentId, 'parentDocumentId');
  return freezeJsonValue(record) as unknown as PageDocumentLink;
}

export function requirePageContextSessionState(value: unknown): PageContextSessionState {
  const record = requireJsonObject(value as JsonValue);
  if (record.schemaVersion !== PAGE_CONTEXT_STATE_SCHEMA_VERSION) {
    throw new ContractError(CONTRACT_ERROR_CODES.unsupportedSchemaVersion, 'unsupported PageContext state schemaVersion');
  }
  requireStableId(record.watchSessionId, 'watchSession');
  requiredInteger(record.tabId, 'tabId');
  if (record.context !== undefined) requirePageContextValue(record.context);
  if (!Array.isArray(record.documents)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'PageContext documents must be an array');
  }
  const seen = new Set<string>();
  for (const item of record.documents) {
    const link = requirePageDocumentLink(item);
    if (seen.has(link.documentId)) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'PageContext documentId entries must be unique');
    }
    seen.add(link.documentId);
  }
  return freezeJsonValue(record) as unknown as PageContextSessionState;
}

export function requireObservationPageAttribution(value: unknown): ObservationPageAttribution {
  const record = requireJsonObject(value as JsonValue);
  const status = requiredString(record.status, 'attribution.status') as ObservationAttributionStatus;
  if (!ATTRIBUTION_STATUSES.has(status)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'unsupported observation attribution status');
  }
  const exact = status === 'exact_top_document' || status === 'exact_descendant';
  if (exact) {
    requiredString(record.topDocumentId, 'attribution.topDocumentId');
    requireRevision(record.pageRevision);
  } else if (record.topDocumentId !== undefined || record.pageRevision !== undefined) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidArgument,
      'non-exact observation attribution must not carry topDocumentId/pageRevision',
    );
  }
  return freezeJsonValue(record) as unknown as ObservationPageAttribution;
}

export function pageContextOrigin(url: string): string {
  return canonicalHttpUrl(url, 'url').origin;
}

export function isActiveDocument(value: { readonly documentLifecycle?: string }): boolean {
  return value.documentLifecycle === undefined || value.documentLifecycle === 'active';
}

export function isTopLevelFrame(value: { readonly frameId: number; readonly frameType?: string }): boolean {
  return value.frameId === 0 || value.frameType === 'outermost_frame';
}

export function pageContextObject(value: JsonObject): JsonObject {
  return freezeJsonValue(value);
}
