<file path="src/observations/lifecycle.ts">
import {
  createStableId,
  freezeJsonValue,
  type JsonObject,
  type StableId,
} from '../core/index.ts';
import type { ObservationPageAttribution } from '../page-context/index.ts';
import { sanitizeObservedUrl } from '../security/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  requireIsoTimestamp,
  type JsonRecordRepository,
  type ResourceObservationRecord,
} from '../persistence/index.ts';
import {
  WATCH_SESSION_STORAGE_KEY,
  type ActiveWatchAuthority,
  type WatchSessionStatePort,
} from '../watch/types.ts';
import { requireActiveWatchAuthority } from '../watch/validation.ts';
import type { PendingObservationStore } from './pending-store.ts';
import {
  OBSERVATION_PENDING_SCHEMA_VERSION,
  OBSERVATION_VALUE_SCHEMA_VERSION,
  type ObservationHop,
  type ObservationTerminal,
  type PendingObservationTrace,
  type ResourceObservationValue,
  type WebRequestBaseDetails,
  type WebRequestCompletedDetails,
  type WebRequestErrorDetails,
  type WebRequestHeadersReceivedDetails,
  type WebRequestRedirectDetails,
} from './types.ts';
import {
  contentLengthFromHeaders,
  contentTypeMimeEssence,
  isHttpUrl,
  requirePendingObservationTrace,
  requireResourceObservationValue,
  webRequestTimestamp,
} from './validation.ts';

export interface ObservationLifecycleOptions {
  readonly observations: JsonRecordRepository<ResourceObservationRecord>;
  readonly pending: PendingObservationStore;
  readonly sessionState: WatchSessionStatePort;
  readonly createObservationId?: () => StableId<'resourceObservation'>;
  readonly evaluate?: (record: ResourceObservationRecord) => Promise<JsonObject>;
  readonly attribute?: (details: WebRequestBaseDetails) => Promise<ObservationPageAttribution>;
  readonly onPersisted?: (record: ResourceObservationRecord) => void | Promise<void>;
}

function traceKey(watchSessionId: StableId<'watchSession'>, requestId: string): string {
  return `${watchSessionId}:${requestId}`;
}

function nonEmpty(value: string | undefined): string | undefined {
  return value === undefined || value.length === 0 ? undefined : value;
}


function withoutResponseFacts(trace: PendingObservationTrace): Omit<PendingObservationTrace, 'responseStatusCode' | 'responseMimeType'> {
  const { responseStatusCode: _status, responseMimeType: _mime, ...rest } = trace;
  return rest;
}

function appendHop(hops: readonly ObservationHop[], hop: ObservationHop): readonly ObservationHop[] {
  const previous = hops[hops.length - 1];
  if (previous !== undefined && JSON.stringify(previous) === JSON.stringify(hop)) return hops;
  return Object.freeze([...hops, hop]);
}

function initialTrace(
  active: ActiveWatchAuthority,
  details: WebRequestBaseDetails,
  observationId: StableId<'resourceObservation'>,
  beforeRequest: boolean,
  attribution: ObservationPageAttribution | undefined,
): PendingObservationTrace {
  return requirePendingObservationTrace({
    schemaVersion: OBSERVATION_PENDING_SCHEMA_VERSION,
    observationId,
    watchSessionId: active.watchSessionId,
    requestId: details.requestId,
    tabId: details.tabId,
    method: details.method,
    requestType: details.type,
    startedAt: webRequestTimestamp(details.timeStamp),
    startedWithBeforeRequest: beforeRequest,
    initialUrl: sanitizeObservedUrl(details.url),
    currentUrl: sanitizeObservedUrl(details.url),
    ...(nonEmpty(details.initiator) === undefined ? {} : { initiator: sanitizeObservedUrl(details.initiator!) }),
    frameId: details.frameId,
    ...(details.parentFrameId === undefined ? {} : { parentFrameId: details.parentFrameId }),
    ...(nonEmpty(details.documentId) === undefined ? {} : { documentId: details.documentId }),
    ...(nonEmpty(details.parentDocumentId) === undefined ? {} : { parentDocumentId: details.parentDocumentId }),
    ...(attribution === undefined ? {} : {
      attributionStatus: attribution.status,
      ...(attribution.topDocumentId === undefined ? {} : { topDocumentId: attribution.topDocumentId }),
      ...(attribution.pageRevision === undefined ? {} : { pageRevision: attribution.pageRevision }),
    }),
    hops: [],
  });
}

function mergeRequestFacts(trace: PendingObservationTrace, details: WebRequestBaseDetails): PendingObservationTrace {
  return requirePendingObservationTrace({
    ...trace,
    method: details.method,
    requestType: details.type,
    currentUrl: sanitizeObservedUrl(details.url),
    ...(trace.initiator !== undefined || nonEmpty(details.initiator) === undefined
      ? {}
      : { initiator: sanitizeObservedUrl(details.initiator!) }),
    ...(trace.documentId !== undefined || nonEmpty(details.documentId) === undefined
      ? {}
      : { documentId: details.documentId }),
    ...(trace.parentDocumentId !== undefined || nonEmpty(details.parentDocumentId) === undefined
      ? {}
      : { parentDocumentId: details.parentDocumentId }),
  });
}

export class ObservationLifecycle {
  readonly #observations: JsonRecordRepository<ResourceObservationRecord>;
  readonly #pending: PendingObservationStore;
  readonly #sessionState: WatchSessionStatePort;
  readonly #createObservationId: () => StableId<'resourceObservation'>;
  readonly #evaluate: ((record: ResourceObservationRecord) => Promise<JsonObject>) | undefined;
  readonly #attribute: ((details: WebRequestBaseDetails) => Promise<ObservationPageAttribution>) | undefined;
  readonly #onPersisted: ((record: ResourceObservationRecord) => void | Promise<void>) | undefined;

  constructor(options: ObservationLifecycleOptions) {
    this.#observations = options.observations;
    this.#pending = options.pending;
    this.#sessionState = options.sessionState;
    this.#createObservationId = options.createObservationId ?? (() => createStableId('resourceObservation'));
    this.#evaluate = options.evaluate;
    this.#attribute = options.attribute;
    this.#onPersisted = options.onPersisted;
  }

  async #activeFor(details: WebRequestBaseDetails): Promise<ActiveWatchAuthority | undefined> {
    const value = await this.#sessionState.get(WATCH_SESSION_STORAGE_KEY);
    if (value === undefined) return undefined;
    const active = requireActiveWatchAuthority(value);
    return active.tabId === details.tabId ? active : undefined;
  }

  async #load(active: ActiveWatchAuthority, details: WebRequestBaseDetails, beforeRequest: boolean): Promise<PendingObservationTrace> {
    const key = traceKey(active.watchSessionId, details.requestId);
    const existing = await this.#pending.get(key);
    if (existing !== undefined) {
      const merged = mergeRequestFacts(existing, details);
      if (beforeRequest && !merged.startedWithBeforeRequest) {
        return requirePendingObservationTrace({ ...merged, startedWithBeforeRequest: true });
      }
      return merged;
    }
    const attribution = this.#attribute === undefined ? undefined : await this.#attribute(details);
    return initialTrace(active, details, this.#createObservationId(), beforeRequest, attribution);
  }

  async #save(trace: PendingObservationTrace): Promise<void> {
    await this.#pending.put(traceKey(trace.watchSessionId, trace.requestId), trace);
  }

  async beforeRequest(details: WebRequestBaseDetails): Promise<void> {
    const active = await this.#activeFor(details);
    if (active === undefined || !isHttpUrl(details.url)) return;
    await this.#save(await this.#load(active, details, true));
  }

  async headersReceived(details: WebRequestHeadersReceivedDetails): Promise<void> {
    const active = await this.#activeFor(details);
    if (active === undefined || !isHttpUrl(details.url)) return;
    let trace = await this.#load(active, details, false);
    const at = webRequestTimestamp(details.timeStamp);
    if (details.statusCode === 401 || details.statusCode === 407) {
      const hop: ObservationHop = freezeJsonValue({
        kind: 'auth_challenge',
        url: sanitizeObservedUrl(details.url),
        statusCode: details.statusCode,
        at,
      });
      trace = requirePendingObservationTrace({
        ...withoutResponseFacts(trace),
        hops: appendHop(trace.hops, hop),
      });
    } else {
      const mime = contentTypeMimeEssence(details.responseHeaders);
      const contentLength = contentLengthFromHeaders(details.responseHeaders);
      trace = requirePendingObservationTrace({
        ...trace,
        responseStatusCode: details.statusCode,
        ...(mime === undefined ? {} : { responseMimeType: mime }),
        ...(contentLength === undefined ? {} : { contentLength }),
      });
    }
    await this.#save(trace);
  }

  async beforeRedirect(details: WebRequestRedirectDetails): Promise<void> {
    const active = await this.#activeFor(details);
    if (active === undefined || !isHttpUrl(details.url)) return;
    let trace = await this.#load(active, details, false);
    const at = webRequestTimestamp(details.timeStamp);
    const hop: ObservationHop = freezeJsonValue({
      kind: 'redirect',
      url: sanitizeObservedUrl(details.url),
      redirectUrl: sanitizeObservedUrl(details.redirectUrl),
      statusCode: details.statusCode,
      at,
    });
    trace = requirePendingObservationTrace({
      ...withoutResponseFacts(trace),
      currentUrl: sanitizeObservedUrl(details.redirectUrl),
      hops: appendHop(trace.hops, hop),
    });
    if (!isHttpUrl(details.redirectUrl)) {
      await this.#finalize(trace, freezeJsonValue({
        kind: 'redirect_out_of_scope',
        at,
        redirectUrl: sanitizeObservedUrl(details.redirectUrl),
        statusCode: details.statusCode,
      }));
      return;
    }
    await this.#save(trace);
  }

  async completed(details: WebRequestCompletedDetails): Promise<void> {
    const active = await this.#activeFor(details);
    if (active === undefined || !isHttpUrl(details.url)) return;
    const trace = requirePendingObservationTrace({
      ...await this.#load(active, details, false),
      currentUrl: sanitizeObservedUrl(details.url),
      responseStatusCode: details.statusCode,
      ...(details.fromCache === undefined ? {} : { fromCache: details.fromCache }),
    });
    await this.#finalize(trace, freezeJsonValue({
      kind: 'completed',
      at: webRequestTimestamp(details.timeStamp),
      statusCode: details.statusCode,
    }));
  }

  async errorOccurred(details: WebRequestErrorDetails): Promise<void> {
    const active = await this.#activeFor(details);
    if (active === undefined || !isHttpUrl(details.url)) return;
    const trace = requirePendingObservationTrace({
      ...await this.#load(active, details, false),
      currentUrl: sanitizeObservedUrl(details.url),
    });
    await this.#finalize(trace, freezeJsonValue({
      kind: 'error',
      at: webRequestTimestamp(details.timeStamp),
      error: details.error,
    }));
  }

  async #finalize(trace: PendingObservationTrace, terminal: ObservationTerminal): Promise<void> {
    const terminalTrace = requirePendingObservationTrace({ ...trace, terminal });
    await this.#save(terminalTrace);
    const value: ResourceObservationValue = requireResourceObservationValue({
      schemaVersion: OBSERVATION_VALUE_SCHEMA_VERSION,
      requestId: terminalTrace.requestId,
      tabId: terminalTrace.tabId,
      method: terminalTrace.method,
      requestType: terminalTrace.requestType,
      startedAt: terminalTrace.startedAt,
      endedAt: terminal.at,
      startedWithBeforeRequest: terminalTrace.startedWithBeforeRequest,
      initialUrl: terminalTrace.initialUrl,
      finalUrl: terminalTrace.currentUrl,
      ...(terminalTrace.initiator === undefined ? {} : { initiator: terminalTrace.initiator }),
      frameId: terminalTrace.frameId,
      ...(terminalTrace.parentFrameId === undefined ? {} : { parentFrameId: terminalTrace.parentFrameId }),
      ...(terminalTrace.documentId === undefined ? {} : { documentId: terminalTrace.documentId }),
      ...(terminalTrace.parentDocumentId === undefined ? {} : { parentDocumentId: terminalTrace.parentDocumentId }),
      ...(terminalTrace.attributionStatus === undefined ? {} : { attributionStatus: terminalTrace.attributionStatus }),
      ...(terminalTrace.topDocumentId === undefined ? {} : { topDocumentId: terminalTrace.topDocumentId }),
      ...(terminalTrace.pageRevision === undefined ? {} : { pageRevision: terminalTrace.pageRevision }),
      hops: terminalTrace.hops,
      ...(terminalTrace.responseStatusCode === undefined ? {} : { responseStatusCode: terminalTrace.responseStatusCode }),
      ...(terminalTrace.responseMimeType === undefined ? {} : { responseMimeType: terminalTrace.responseMimeType }),
      ...(terminalTrace.contentLength === undefined ? {} : { contentLength: terminalTrace.contentLength }),
      ...(terminalTrace.tabTitle === undefined ? {} : { tabTitle: terminalTrace.tabTitle }),
      ...(terminalTrace.userAgent === undefined ? {} : { userAgent: terminalTrace.userAgent }),
      ...(terminalTrace.fromCache === undefined ? {} : { fromCache: terminalTrace.fromCache }),
      terminal,
    });
    const rawRecord: ResourceObservationRecord = {
      schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
      id: terminalTrace.observationId,
      watchSessionId: terminalTrace.watchSessionId,
      observedAt: requireIsoTimestamp(terminalTrace.startedAt),
      value,
    };
    const evaluation = this.#evaluate === undefined ? undefined : await this.#evaluate(rawRecord);
    const record: ResourceObservationRecord = evaluation === undefined
      ? rawRecord
      : { ...rawRecord, evaluation };
    await this.#observations.put(record);
    await this.#pending.delete(traceKey(terminalTrace.watchSessionId, terminalTrace.requestId));
    if (this.#onPersisted !== undefined) {
      try {
        await this.#onPersisted(record);
      } catch {
        // UI invalidation is latency-only and must never compromise durable observation capture.
      }
    }
  }

  async resumeTerminalPending(): Promise<void> {
    for (const trace of await this.#pending.list()) {
      if (trace.terminal !== undefined) await this.#finalize(trace, trace.terminal);
    }
  }

  async discardNonTerminalPending(): Promise<void> {
    for (const trace of await this.#pending.list()) {
      if (trace.terminal === undefined) {
        await this.#pending.delete(traceKey(trace.watchSessionId, trace.requestId));
      }
    }
  }

  async discardPending(): Promise<void> {
    await this.#pending.clear();
  }
}
</file>

