  });
  const composer = new WatchSessionComposer(repos.definitions, repos.sessions);
  await assert.rejects(
    () => composer.compose({ id: IDS.session, watchDefinitionId: IDS.watch, timestamp: T0 }),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.kindMismatch,
  );
});

test('Watch definitions cannot directly freeze PageFieldMappings outside enabled rule/template dependency paths', async () => {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({ id: IDS.mapping, kind: 'pageFieldMapping', name: 'Field', timestamp: T0 });
  await catalog.create({
    id: IDS.watch,
    kind: 'watch',
    name: 'Watch',
    references: [{ id: IDS.mapping, kind: 'pageFieldMapping' }],
    timestamp: T0,
  });
  const composer = new WatchSessionComposer(repos.definitions, repos.sessions);
  await assert.rejects(
    () => composer.compose({ id: IDS.session, watchDefinitionId: IDS.watch, timestamp: T0 }),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.invalidReference,
  );
});



test('SHA-256 definition digests are canonical across JSON object key insertion order', async () => {
  const left = { b: 2, a: { z: true, y: false }, order: ['x', 'y'] } as const;
  const right = { order: ['x', 'y'], a: { y: false, z: true }, b: 2 } as const;
  assert.equal(canonicalJson(left), canonicalJson(right));
  assert.equal(await sha256Json(left), await sha256Json(right));
});

test('expected dependency revisions prevent Watch start from silently consuming later edits', async () => {
  const { catalog, composer } = await seedGraph();
  await catalog.update(IDS.mapping, INITIAL_REVISION, { body: { field: 'episode_number' } }, T1);
  await assert.rejects(
    () => composer.compose({ id: IDS.session3, watchDefinitionId: IDS.watch, timestamp: T1 }),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.revisionConflict,
  );
});
test('duplicate references collapse to one frozen definition without changing array-order semantics inside values', async () => {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({ id: IDS.filter, kind: 'resourceFilter', name: 'Filter', timestamp: T0 });
  await catalog.create({
    id: IDS.watch,
    kind: 'watch',
    name: 'Watch',
    body: { ordered: ['first', 'second'] },
    references: [
      { id: IDS.filter, kind: 'resourceFilter' },
      { id: IDS.filter, kind: 'resourceFilter', expectedRevision: INITIAL_REVISION },
    ],
    timestamp: T0,
  });
  const composer = new WatchSessionComposer(repos.definitions, repos.sessions);
  const session = await composer.compose({ id: IDS.session3, watchDefinitionId: IDS.watch, timestamp: T0 });
  assert.equal(session.value.definitions.filter((definition) => definition.id === IDS.filter).length, 1);
  const watch = session.value.definitions.find((definition) => definition.id === IDS.watch);
  assert.deepEqual(watch?.value.body, { ordered: ['first', 'second'] });
});


test('reusable-definition lifecycle reports reverse references and blocks referenced or stale deletes', async () => {
  const { catalog } = await seedGraph();
  const lifecycle = new DefinitionLifecycleService({ catalog, protectedDefinitionIds: [IDS.watch] });
  const usages = await lifecycle.usages(IDS.template);
  assert.deepEqual(usages.map((entry) => [entry.id, entry.kind, entry.name]), [[IDS.rule, 'packagizerRule', 'Rule']]);

  const template = await catalog.require(IDS.template);
  await assert.rejects(
    () => lifecycle.delete({ definitionId: template.id, expectedRevision: template.revision, kind: 'template' }),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.invalidReference,
  );

  const unused = await catalog.require(IDS.unusedMapping);
  await assert.rejects(
    () => lifecycle.delete({ definitionId: unused.id, expectedRevision: (unused.revision + 1) as never, kind: 'pageFieldMapping' }),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.revisionConflict,
  );
  const deleted = await lifecycle.delete({ definitionId: unused.id, expectedRevision: unused.revision, kind: 'pageFieldMapping' });
  assert.deepEqual(deleted, { deleted: true, definitionId: IDS.unusedMapping });
  assert.equal(await catalog.get(IDS.unusedMapping), undefined);
});

test('reusable-definition lifecycle never treats immutable WatchSession snapshots as live delete references', async () => {
  const { catalog, composer } = await seedGraph();
  await composer.compose({ id: IDS.session, watchDefinitionId: IDS.watch, expectedWatchRevision: INITIAL_REVISION, timestamp: T0 });
  const unused = await catalog.require(IDS.unusedMapping);
  const lifecycle = new DefinitionLifecycleService({ catalog });
  const result = await lifecycle.delete({ definitionId: unused.id, expectedRevision: unused.revision, kind: 'pageFieldMapping' });
  assert.equal(result.deleted, true);
});

test('reusable-definition presentation uses one New Loaded Modified and duplicate/provenance grammar', () => {
  assert.equal(reusableDefinitionDraftState(false, false), 'New');
  assert.equal(reusableDefinitionDraftState(true, false), 'Loaded');
  assert.equal(reusableDefinitionDraftState(true, true), 'Modified');
  assert.equal(duplicateDefinitionName('Episode rule'), 'Episode rule copy');
  assert.equal(duplicateDefinitionName('   ', 'Rule'), 'Rule copy');
  assert.equal(loadedDefinitionProvenance('Episode rule', 7), 'Loaded from Episode rule · revision 7');
});
