  // Disabled engine
  const disabledGuard = evaluateWebhookResourceGuard('https://cdn.example.com/video.mp4', {
    ...baseSettings,
    webhookEnabled: false,
  });
  assert.equal(disabledGuard.admitted, false);
  assert.equal(disabledGuard.filterReason, 'disabled');

  // Empty endpoint
  const emptyEndpointGuard = evaluateWebhookResourceGuard('https://cdn.example.com/video.mp4', {
    ...baseSettings,
    webhookEndpointUrl: '   ',
  });
  assert.equal(emptyEndpointGuard.admitted, false);
  assert.equal(emptyEndpointGuard.filterReason, 'invalid_endpoint');

  // Exclude glob veto
  const excludeGuard = evaluateWebhookResourceGuard('https://cdn.example.com/analytics.js', {
    ...baseSettings,
    webhookExcludeGlobs: '*analytics*',
  });
  assert.equal(excludeGuard.admitted, false);
  assert.equal(excludeGuard.filterReason, 'rule_mismatch');

