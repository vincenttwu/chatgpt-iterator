from __future__ import annotations

import json
import re
import shutil
import subprocess
import tempfile
import unittest
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SCRIPTS = ROOT / "agents" / "scripts"
COPY_IGNORE = shutil.ignore_patterns(
    ".git",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "node_modules",
)


class ManagerSmokeTests(unittest.TestCase):
    def run_script(self, name: str, *args: str, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["python3", str(SCRIPTS / name), *args],
            cwd=cwd or ROOT,
            text=True,
            capture_output=True,
            check=False,
        )

    def test_record_manager_validates_and_allocates_next_roadmap(self) -> None:
        result = self.run_script("record-manager.py", "validate")
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        next_id = self.run_script("record-manager.py", "next-id", "roadmap")
        self.assertEqual(next_id.returncode, 0, next_id.stderr)
        issued = [
            int(match.group(1))
            for path in (ROOT / "agents" / "records" / "roadmaps").glob("ROADMAP-*.md")
            if (match := re.match(r"ROADMAP-(\d{4})--", path.name))
        ]
        expected = (max(issued) if issued else 0) + 1
        self.assertEqual(next_id.stdout.strip(), f"ROADMAP-{expected:04d}")

    def test_knowledge_manager_validates_and_allocates_next_note(self) -> None:
        result = self.run_script("knowledge-manager.py", "validate")
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        next_id = self.run_script("knowledge-manager.py", "next-id")
        self.assertEqual(next_id.returncode, 0, next_id.stderr)
        issued = [
            int(match.group(1))
            for path in (ROOT / "agents" / "knowledge").glob("**/NOTE-*.md")
            if (match := re.match(r"NOTE-(\d{4})--", path.name))
        ]
        expected = (max(issued) if issued else 0) + 1
        self.assertEqual(next_id.stdout.strip(), f"NOTE-{expected:04d}")

    def test_create_commands_render_without_mutating_when_stdout_selected(self) -> None:
        managed_before = {
            path.relative_to(ROOT)
            for path in (ROOT / "agents").glob("**/*.md")
        }
        next_note = self.run_script("knowledge-manager.py", "next-id")
        self.assertEqual(next_note.returncode, 0, next_note.stderr)
        note = self.run_script("knowledge-manager.py", "create", "http", "Retry Semantics", "--stdout")
        self.assertEqual(note.returncode, 0, note.stderr)
        self.assertIn(f"record_id: {next_note.stdout.strip()}", note.stdout)
        self.assertIn("knowledge:\n  topic: http", note.stdout)
        current = json.loads((ROOT / 'iteration_manifest.json').read_text(encoding='utf-8'))['iteration']
        self.assertIn(f'id: "{current}"', note.stdout)
        next_finding = self.run_script("record-manager.py", "next-id", "finding")
        self.assertEqual(next_finding.returncode, 0, next_finding.stderr)
        finding = self.run_script("record-manager.py", "create", "finding", "External Retry Contract", "--stdout")
        self.assertEqual(finding.returncode, 0, finding.stderr)
        self.assertIn(f"record_id: {next_finding.stdout.strip()}", finding.stdout)
        managed_after = {
            path.relative_to(ROOT)
            for path in (ROOT / "agents").glob("**/*.md")
        }
        self.assertEqual(managed_after, managed_before)

    def test_record_manager_renders_environment_deferral_contract(self) -> None:
        result = self.run_script(
            "record-manager.py",
            "create",
            "deferral",
            "Live Verification",
            "--environment",
            "--revisit-condition",
            "authenticated environment available",
            "--stdout",
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("environment_only: true", result.stdout)
        self.assertIn("blocking: false", result.stdout)
        self.assertIn("validation_status: deferred_environment", result.stdout)
        current = json.loads((ROOT / 'iteration_manifest.json').read_text(encoding='utf-8'))['iteration']
        self.assertIn(f'id: "{current}"', result.stdout)
        self.assertIn('condition: "authenticated environment available"', result.stdout)

    def test_environment_deferral_policy_is_explicit_and_non_blocking(self) -> None:
        governance = (ROOT / "agents" / "governance" / "environment-deferrals.md").read_text(encoding="utf-8")
        environment = (ROOT / "agents" / "templates" / "execution-environment.yaml").read_text(encoding="utf-8")
        self.assertIn("never a roadmap blocker by itself", governance)
        self.assertIn("environment_only_non_blocking: true", environment)
        self.assertIn("iteration_may_progress: true", environment)

    def test_manager_commands_do_not_leave_script_bytecode_cache(self) -> None:
        cache = SCRIPTS / "__pycache__"
        if cache.exists():
            shutil.rmtree(cache)
        commands = [
            ("record-manager.py", "next-id", "roadmap"),
            ("knowledge-manager.py", "next-id"),
            ("initialization-manager.py", "status"),
            ("iteration-manager.py", "validate"),
        ]
