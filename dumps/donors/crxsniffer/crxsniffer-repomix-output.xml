import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import test from 'node:test';

import { EN_MESSAGES, UI_STATE_KINDS, uiFormat, uiMessage, uiStateLabel } from '../../src/ui/index.ts';

const ROOT = new URL('../../', import.meta.url);

async function text(path: string): Promise<string> {
  return readFile(new URL(path, ROOT), 'utf8');
}

test('STEP-09 localization catalog is a Chrome/WXT-compatible complete English baseline', async () => {
  const locale = JSON.parse(await text('public/_locales/en/messages.json')) as Record<string, { message: string }>;
  assert.ok(Object.keys(EN_MESSAGES).length >= 600, 'whole-product catalog should cover the existing Side Panel surface');
  assert.deepEqual(
    Object.fromEntries(Object.entries(locale).map(([key, value]) => [key, value.message])),
    EN_MESSAGES,
  );
  assert.equal(uiMessage('appName'), 'Crsniffer');
  assert.equal(uiFormat('session_started_revision', ['today', 7]), 'Started today · saved setup revision 7');
  assert.equal(uiMessage('missing_catalog_key_for_test'), 'missing_catalog_key_for_test');
});

test('STEP-09 canonical state grammar covers every required whole-product presentation state', () => {
  assert.deepEqual(UI_STATE_KINDS, [
    'empty', 'loading', 'disabled', 'error', 'success', 'live', 'degraded', 'reconnecting', 'stale',
  ]);
  for (const kind of UI_STATE_KINDS) {
    const label = uiStateLabel(kind);
    assert.notEqual(label, kind);
    assert.ok(label.length > 0);
  }
});

test('STEP-09 Side Panel externalizes static copy and uses one summarized live announcement lane', async () => {
  const app = await text('entrypoints/sidepanel/App.vue');
  const template = app.slice(app.indexOf('<template>'));

  const templateForTextAudit = template.replaceAll('=>', '__ARROW__');
  const textNodes = [...templateForTextAudit.matchAll(/>([^<]+)</g)]
    .map((match) => (match[1] ?? '').replace(/\{\{.*?\}\}/gs, '').trim())
    .filter((value) => /[A-Za-z]/.test(value));
  assert.deepEqual(textNodes, [], `unexternalized static text nodes: ${textNodes.join(' | ')}`);

  const literalUiAttributes = [...template.matchAll(/(?<!:)(?:aria-label|placeholder|title)="([^"]*[A-Za-z][^"]*)"/g)]
    .map((match) => match[1]);
  assert.deepEqual(literalUiAttributes, [], `unexternalized UI attributes: ${literalUiAttributes.join(' | ')}`);

  const usedKeys = new Set([
    ...app.matchAll(/\bui\('([^']+)'\)/g),
    ...app.matchAll(/\buiFormat\('([^']+)'/g),
  ].map((match) => match[1]));
  const missing = [...usedKeys].filter((key) => !(key in EN_MESSAGES));
  assert.deepEqual(missing, []);

  assert.equal((template.match(/role="status"/g) ?? []).length, 1);
  assert.equal((template.match(/aria-live="polite"/g) ?? []).length, 1);
  assert.match(template, /aria-atomic="true"/);
  assert.match(app, /announceMeaningful/);
  assert.match(app, /watch\(workspaceStateLabel/);
  assert.match(app, /data-state="workspaceStateKind"/);
  assert.match(app, /role="tablist"/);
  assert.equal((app.match(/<button[^>]*role="tab"/g) ?? []).length, 6);
});

test('STEP-09 responsive/focus/target/reduced-motion contract is explicit at 320 CSS px', async () => {
  const css = await text('entrypoints/sidepanel/style.css');
  assert.match(css, /body\s*\{[^}]*min-width:\s*0/s);
  assert.match(css, /:focus-visible/);
  assert.match(css, /--cr-focus:\s*/);
  assert.match(css, /outline:\s*3px solid var\(--cr-focus\)/);
  assert.match(css, /scroll-margin-block:\s*1rem/);
  assert.match(css, /min-height:\s*2\.75rem/);
  assert.match(css, /input\[type="checkbox"\][\s\S]*?width:\s*1\.5rem[\s\S]*?height:\s*1\.5rem/);
  assert.match(css, /@media \(max-width:\s*320px\)/);
  assert.match(css, /grid-template-columns:\s*minmax\(0,\s*1fr\)/);
  assert.match(css, /@media \(prefers-reduced-motion:\s*reduce\)/);
  assert.match(css, /\.sr-only/);
});

test('STEP-09 WXT manifest and public locale projection use the supported vanilla i18n layout', async () => {
  const config = await text('wxt.config.ts');
  const locale = await text('public/_locales/en/messages.json');
  assert.match(config, /name:\s*'__MSG_appName__'/);
  assert.match(config, /description:\s*'__MSG_appDescription__'/);
  assert.match(config, /default_locale:\s*'en'/);
  assert.match(locale, /"appName"/);
  assert.match(locale, /"appDescription"/);
  assert.doesNotMatch(config, /activeTab/);
  assert.doesNotMatch(config, /<all_urls>/);
});


test('STEP-12 virtualized dynamic resources preserve final accessibility and localization contracts', async () => {
  const app = await text('entrypoints/sidepanel/App.vue');
  const css = await text('entrypoints/sidepanel/style.css');
  assert.match(app, /class="resource-scroller"[\s\S]*?tabindex="0"[\s\S]*?:aria-label="ui\('captured_resource_results'\)"/);
  assert.match(app, /v-for="row in visibleResourceRows"[\s\S]*?class="resource-row"[\s\S]*?:aria-pressed=/);
  assert.match(app, /resourceWindow\.totalHeight/);
  assert.match(app, /resourceWindow\.offsetTop/);
  assert.match(app, /ControlPlaneInvalidationBatcher/);
  assert.equal((app.match(/role="status"/g) ?? []).length, 1, 'dynamic resources must not create competing live regions');
  assert.match(css, /@media \(max-width:\s*320px\)/);
  assert.match(css, /@media \(prefers-reduced-motion:\s*reduce\)/);
  assert.match(css, /:focus-visible/);
});

test('STEP-13 Side Panel uses Chrome-native-aware Material 3 system theming', async () => {
  const css = await text('entrypoints/sidepanel/style.css');
  assert.match(css, /color-scheme:\s*light dark/);
  assert.match(css, /--bg:\s*light-dark\(#f8f9fa,\s*#202124\)/);
  assert.match(css, /--surface:\s*light-dark\(#ffffff,\s*#292a2d\)/);
  assert.match(css, /--accent:\s*light-dark\(#1a73e8,\s*#8ab4f8\)/);
  assert.match(css, /@media \(forced-colors:\s*active\)/);
});
