  await h.service.savePreferences({ ...DEFAULT_SETTINGS_PREFERENCES, resourceRowDensity: 'compact' });
  await new JsonStorageTier(h.sessionArea, 'crsniffer.session.').set('activeTab', { tabId: 7 });

  const result = await h.service.clear('history');
  assert.equal(result.clear.before.definitions, 1);
  assert.equal(result.clear.before.watchSessions, 1);
  assert.deepEqual(result.clear.after, { definitions: 1, watchSessions: 0, resourceObservations: 0, pageFieldSnapshots: 0 });
  assert.equal(h.pendingClearCount(), 1);
  assert.equal(h.sessionArea.values.has('crsniffer.session.activeTab'), false);
  assert.equal(result.settings.preferences.resourceRowDensity, 'compact');
});

