import { CONTRACT_ERROR_CODES, ContractError } from './errors.ts';
import type { JsonObject, JsonValue } from './types.ts';

function invalidJson(path: string, reason: string): never {
  throw new ContractError(
    CONTRACT_ERROR_CODES.invalidJson,
    `Value at ${path} is not strict JSON: ${reason}`,
    { path, reason },
  );
}

function assertArray(value: readonly unknown[], path: string, active: WeakSet<object>): void {
  for (const key of Reflect.ownKeys(value)) {
    if (typeof key !== 'string') {
      invalidJson(path, 'symbol keys are not serializable');
    }
    if (key === 'length') {
      continue;
    }

    const index = Number(key);
    if (!Number.isSafeInteger(index) || index < 0 || String(index) !== key) {
      invalidJson(path, 'arrays may not carry non-index properties');
    }
    const descriptor = Object.getOwnPropertyDescriptor(value, key);
    if (descriptor === undefined || !descriptor.enumerable || !('value' in descriptor)) {
      invalidJson(`${path}[${key}]`, 'array entries must be enumerable data properties');
    }
  }

  if (Object.keys(value).length !== value.length) {
    invalidJson(path, 'arrays must be dense');
  }

  for (let index = 0; index < value.length; index += 1) {
    if (!Object.hasOwn(value, index)) {
      invalidJson(`${path}[${index}]`, 'array holes are not allowed');
    }
    assertJsonSafeInternal(value[index], `${path}[${index}]`, active);
  }
}

function assertPlainObject(
  value: Record<string | symbol, unknown>,
  path: string,
  active: WeakSet<object>,
): void {
  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    invalidJson(path, 'only plain objects are allowed');
  }

  for (const key of Reflect.ownKeys(value)) {
    if (typeof key !== 'string') {
      invalidJson(path, 'symbol keys are not serializable');
    }

    const descriptor = Object.getOwnPropertyDescriptor(value, key);
    if (descriptor === undefined || !descriptor.enumerable) {
      invalidJson(`${path}.${key}`, 'non-enumerable properties are not allowed');
    }
    if (!('value' in descriptor)) {
      invalidJson(`${path}.${key}`, 'accessor properties are not allowed');
    }

    assertJsonSafeInternal(descriptor.value, `${path}.${key}`, active);
  }
}

function assertJsonSafeInternal(value: unknown, path: string, active: WeakSet<object>): void {
  if (value === null || typeof value === 'string' || typeof value === 'boolean') {
    return;
  }

  if (typeof value === 'number') {
    if (!Number.isFinite(value)) {
      invalidJson(path, 'numbers must be finite');
    }
    if (Object.is(value, -0)) {
      invalidJson(path, 'negative zero is not canonical JSON');
    }
    return;
  }

  if (typeof value !== 'object') {
    invalidJson(path, `${typeof value} is not JSON serializable`);
  }

  if (active.has(value)) {
    invalidJson(path, 'cyclic references are not allowed');
  }

  active.add(value);
  try {
    if (Array.isArray(value)) {
      assertArray(value, path, active);
      return;
    }
    assertPlainObject(value as Record<string | symbol, unknown>, path, active);
  } finally {
    active.delete(value);
  }
}

/**
 * Reject values that JSON would silently coerce, omit, or structurally reinterpret.
 *
 * This is intentionally stricter than `JSON.stringify`: undefined, non-finite numbers,
 * negative zero, holes, accessors, class instances, symbol keys, and cycles fail closed.
 */
export function assertJsonSafe(value: unknown, path = '$'): asserts value is JsonValue {
  assertJsonSafeInternal(value, path, new WeakSet<object>());
}

/** Return whether an unknown value satisfies the strict JSON boundary contract. */
export function isJsonSafe(value: unknown): value is JsonValue {
  try {
    assertJsonSafe(value);
    return true;
  } catch {
    return false;
  }
}

/** Detach a strict JSON value from mutable caller-owned references. */
export function cloneJsonValue<T extends JsonValue>(value: T): T {
  assertJsonSafe(value);
  return JSON.parse(JSON.stringify(value)) as T;
}

/** Recursively freeze a strict JSON value after validation. */
export function freezeJsonValue<T extends JsonValue>(value: T): T {
  assertJsonSafe(value);
  if (value !== null && typeof value === 'object') {
    for (const child of Array.isArray(value) ? value : Object.values(value)) {
      freezeJsonValue(child);
    }
    Object.freeze(value);
  }
  return value;
}

/** Parse text and require the result to satisfy the strict JSON contract. */
export function parseJsonValue(text: string): JsonValue {
  let parsed: unknown;
  try {
    parsed = JSON.parse(text);
  } catch (error) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidJson,
      error instanceof Error ? error.message : 'Invalid JSON text',
    );
  }
  assertJsonSafe(parsed);
  return parsed;
}

/** Serialize only values that satisfy the strict JSON contract. */
export function stringifyJsonValue(value: JsonValue): string {
  assertJsonSafe(value);
  return JSON.stringify(value);
}

/** Narrow an already-validated JSON value to an object. */
export function requireJsonObject(value: JsonValue, path = '$'): JsonObject {
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    invalidJson(path, 'expected an object');
  }
  return value as JsonObject;
}
</file>

