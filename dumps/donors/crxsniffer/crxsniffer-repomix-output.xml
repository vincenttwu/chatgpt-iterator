  }
  if (['contains', 'starts_with', 'ends_with', 'glob'].includes(condition.operator)) {
    return { ...base, value: condition.operandText };
  }
  if (condition.operandKind === 'null') return { ...base, value: null };
  if (condition.operandKind === 'boolean') return { ...base, value: condition.operandBoolean };
