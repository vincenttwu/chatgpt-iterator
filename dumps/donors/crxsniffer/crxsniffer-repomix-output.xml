import type { JsonObject, JsonValue } from './types.ts';
import { CORE_SCHEMA_VERSION } from './versions.ts';

const MISSING_MARKER: unique symbol = Symbol('crsniffer.missing');

/** Internal sentinel: absence is not null, false, zero, or an empty string. */
export interface Missing {
  readonly [MISSING_MARKER]: true;
}

export const MISSING: Missing = Object.freeze({ [MISSING_MARKER]: true as const });

export const MISSING_WIRE_TAG = 'crsniffer.missing';

/** Explicit JSON representation used only in fields whose contract allows Missing. */
export interface MissingWire extends JsonObject {
  readonly $type: typeof MISSING_WIRE_TAG;
  readonly schemaVersion: number;
}

export type MaybeJsonValue = JsonValue | Missing;

export function isMissing(value: unknown): value is Missing {
  return value === MISSING;
}

export function encodeMaybeJson(value: MaybeJsonValue): JsonValue {
  if (!isMissing(value)) {
    return value;
  }
  return {
    $type: MISSING_WIRE_TAG,
    schemaVersion: CORE_SCHEMA_VERSION,
  };
}

export function isMissingWire(value: JsonValue): value is MissingWire {
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    return false;
  }

  const candidate = value as JsonObject;
  const keys = Object.keys(candidate);
  return keys.length === 2
    && candidate.$type === MISSING_WIRE_TAG
    && candidate.schemaVersion === CORE_SCHEMA_VERSION;
}

export function decodeMaybeJson(value: JsonValue): MaybeJsonValue {
  return isMissingWire(value) ? MISSING : value;
}
</file>

