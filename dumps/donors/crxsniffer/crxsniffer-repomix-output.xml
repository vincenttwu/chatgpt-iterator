export interface DownloadProgressInfo {
  readonly id: number;
  readonly bytesReceived: number;
  readonly totalBytes: number;
  readonly state?: 'in_progress' | 'complete' | 'interrupted';
  readonly error?: string;
}

export function computeProgressMetrics(
  prevBytes: number,
  currBytes: number,
  prevTimestamp: number,
  currTimestamp: number,
): number {
  const timeDeltaSec = (currTimestamp - prevTimestamp) / 1000;
  if (timeDeltaSec <= 0) return 0;
  const bytesDelta = currBytes - prevBytes;
  if (bytesDelta <= 0) return 0;
  return Math.round(bytesDelta / timeDeltaSec);
}

export function formatBytes(bytes: number): string {
  if (bytes <= 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(1024));
  const val = (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1);
  return `${val} ${units[i] ?? 'B'}`;
}

export function formatSpeed(bytesPerSec: number): string {
  if (bytesPerSec <= 0) return '0 B/s';
  return `${formatBytes(bytesPerSec)}/s`;
}
