import type {
  JsonObject,
  JsonPrimitive,
  MaybeJsonValue,
  StableId,
} from '../core/index.ts';
import type { ImmutableWatchSessionRecord } from '../definitions/index.ts';
import type { ResourceObservationRecord } from '../persistence/index.ts';
import type { ResourceOccurrenceProjection } from '../resources/index.ts';

export const PACKAGIZER_RULE_SCHEMA_VERSION = 1 as const;
export const PACKAGIZER_TEMPLATE_SCHEMA_VERSION = 1 as const;
export const PACKAGIZER_EVALUATION_SCHEMA_VERSION = 1 as const;
export const PACKAGIZER_EXPLANATION_SCHEMA_VERSION = 1 as const;

export const PACKAGIZER_CONDITION_OPERATORS = [
  'exists',
  'missing',
  'equals',
  'not_equals',
  'contains',
  'starts_with',
  'ends_with',
  'glob',
  'lt',
  'lte',
  'gt',
  'gte',
] as const;
export type PackagizerConditionOperator = (typeof PACKAGIZER_CONDITION_OPERATORS)[number];

export const PACKAGIZER_ACTION_TYPES = [
  'set_filename',
  'set_group',
  'set_comment',
] as const;
export type PackagizerActionType = (typeof PACKAGIZER_ACTION_TYPES)[number];

export interface PackagizerCondition extends JsonObject {
  readonly id: string;
  readonly token: string;
  readonly operator: PackagizerConditionOperator;
  readonly value?: JsonPrimitive;
}

export interface PackagizerAction extends JsonObject {
  readonly id: string;
  readonly type: PackagizerActionType;
  readonly templateId: StableId<'definition'>;
}

export interface PackagizerRuleBody extends JsonObject {
  readonly schemaVersion: typeof PACKAGIZER_RULE_SCHEMA_VERSION;
  readonly conditions: readonly PackagizerCondition[];
  readonly actions: readonly PackagizerAction[];
  readonly stopAfterSuccess: boolean;
}

export interface PackagizerTemplateBody extends JsonObject {
  readonly schemaVersion: typeof PACKAGIZER_TEMPLATE_SCHEMA_VERSION;
  readonly text: string;
}

export interface PackagizerPageContext {
  readonly url?: MaybeJsonValue;
  readonly title?: MaybeJsonValue;
  readonly origin?: MaybeJsonValue;
  readonly fields?: Readonly<Record<string, MaybeJsonValue>>;
}

export interface PackagizerEvaluationInput {
  readonly session: ImmutableWatchSessionRecord;
  readonly occurrence: ResourceOccurrenceProjection;
  readonly observation: ResourceObservationRecord;
  readonly watchStartedAt: string;
  readonly page?: PackagizerPageContext;
}

export interface PackagizerDerivedFields extends JsonObject {
  readonly filename?: string;
  readonly group?: string;
  readonly comment?: string;
}

export interface PackagizerEvaluationFailure extends JsonObject {
  readonly ruleId: StableId<'definition'>;
  readonly code: string;
}

export interface PackagizerEvaluationResult extends JsonObject {
  readonly schemaVersion: typeof PACKAGIZER_EVALUATION_SCHEMA_VERSION;
  readonly derived: PackagizerDerivedFields;
  readonly appliedRuleIds: readonly StableId<'definition'>[];
  readonly stoppedByRuleId?: StableId<'definition'>;
  readonly failure?: PackagizerEvaluationFailure;
}

export type PackagizerTokenState = 'missing' | 'value';
export type PackagizerTokenOutcome = 'rendered' | 'failed';
export type PackagizerConditionOutcome = 'matched' | 'not_matched' | 'not_evaluated' | 'failed';
export type PackagizerActionOutcome = 'applied' | 'rolled_back' | 'not_evaluated' | 'failed';
export type PackagizerRuleOutcome = 'disabled' | 'not_matched' | 'applied' | 'stopped' | 'failed';

export interface PackagizerTokenExplanation extends JsonObject {
  readonly token: string;
  readonly sourceState: PackagizerTokenState;
  readonly transforms: readonly string[];
  readonly outcome: PackagizerTokenOutcome;
  readonly errorCode?: string;
}

export interface PackagizerConditionExplanation extends JsonObject {
  readonly id: string;
  readonly token: string;
  readonly operator: PackagizerConditionOperator;
  readonly outcome: PackagizerConditionOutcome;
  readonly sourceState?: PackagizerTokenState;
  readonly errorCode?: string;
}

export interface PackagizerActionExplanation extends JsonObject {
  readonly id: string;
  readonly type: PackagizerActionType;
  readonly templateId: StableId<'definition'>;
  readonly field: keyof PackagizerDerivedFields;
  readonly outcome: PackagizerActionOutcome;
  readonly overwrote?: boolean;
  readonly tokens: readonly PackagizerTokenExplanation[];
  readonly errorCode?: string;
}

export interface PackagizerRuleExplanation extends JsonObject {
  readonly ruleId: StableId<'definition'>;
  readonly enabled: boolean;
  readonly stopAfterSuccess: boolean;
  readonly outcome: PackagizerRuleOutcome;
  readonly conditions: readonly PackagizerConditionExplanation[];
  readonly actions: readonly PackagizerActionExplanation[];
}

export interface PackagizerStructuralExplanation extends JsonObject {
  readonly schemaVersion: typeof PACKAGIZER_EXPLANATION_SCHEMA_VERSION;
  readonly rules: readonly PackagizerRuleExplanation[];
  readonly failure?: PackagizerEvaluationFailure;
}

export interface PackagizerDetailedEvaluation {
  readonly result: PackagizerEvaluationResult;
  readonly explanation: PackagizerStructuralExplanation;
}

export interface PackagizerTemplateEvaluationSuccess {
  readonly ok: true;
  readonly value: string;
  readonly tokens: readonly PackagizerTokenExplanation[];
}

export interface PackagizerTemplateEvaluationFailure {
  readonly ok: false;
  readonly code: string;
  readonly tokens: readonly PackagizerTokenExplanation[];
}

export type PackagizerTemplateEvaluation =
  | PackagizerTemplateEvaluationSuccess
  | PackagizerTemplateEvaluationFailure;
