const HISTORY_WATCH_ID = createStableId('watchSession', () => '60000000-0000-4000-8000-000000000010');
const HISTORY_WATCH_ID_2 = createStableId('watchSession', () => '60000000-0000-4000-8000-000000000011');
const HISTORY_WATCH_DEF = createStableId('definition', () => '80000000-0000-4000-8000-000000000010');
const HISTORY_OBS_IDS = [
  createStableId('resourceObservation', () => '70000000-0000-4000-8000-000000000010'),
  createStableId('resourceObservation', () => '70000000-0000-4000-8000-000000000011'),
  createStableId('resourceObservation', () => '70000000-0000-4000-8000-000000000012'),
] as const;

function historySession(id: WatchSessionRecord['id'], name: string, createdAt: string): WatchSessionRecord {
  return {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id,
    createdAt: requireIsoTimestamp(createdAt),
    updatedAt: requireIsoTimestamp(createdAt),
    value: {
      watchDefinitionId: HISTORY_WATCH_DEF,
      definitionSetDigest: `sha256:${'a'.repeat(64)}`,
      definitions: [{
        id: HISTORY_WATCH_DEF,
        kind: 'watch',
        revision: 1,
        digest: `sha256:${'b'.repeat(64)}`,
        value: { name, enabled: true, body: {}, references: [] },
      }],
    },
  };
}

function historyObservation(input: {
  id: ResourceObservationRecord['id'];
  observedAt: string;
  url: string;
  kind: 'image' | 'video';
  status: 'projected' | 'failed' | 'rejected';
  filename?: string;
}): ResourceObservationRecord {
  const observedAt = requireIsoTimestamp(input.observedAt);
  const value = observationValue({
    requestId: `private-${input.id}`,
    documentId: `private-doc-${input.id}`,
    startedAt: observedAt,
    endedAt: observedAt,
    initialUrl: input.url,
    finalUrl: input.url,
    responseStatusCode: input.status === 'failed' ? 503 : 200,
    responseMimeType: input.kind === 'image' ? 'image/jpeg' : 'video/mp4',
  });
  const explanation = {
    schemaVersion: 2,
    classification: {
      kind: input.kind,
      reason: input.kind === 'image' ? 'mime_image' : 'mime_video',
      requestType: value.requestType,
      mimePresent: true,
      extensionPresent: true,
      conflict: false,
    },
    admission: {
      admitted: input.status !== 'rejected',
      positive: true,
      matchedPresets: [input.kind === 'image' ? 'images' : 'videos'],
      matchedIncludeGlobIndexes: [],
      matchedExcludeGlobIndexes: [],
    },
    packagizerStatus: input.status === 'rejected' ? 'not_evaluated_admission' : 'evaluated',
    pageEnrichment: { status: 'not_provided' },
  } as const;
  return {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: input.id,
    watchSessionId: HISTORY_WATCH_ID,
    observedAt,
    value,
    evaluation: {
      schemaVersion: 2,
      status: input.status,
      observationId: input.id,
      watchSessionId: HISTORY_WATCH_ID,
      ...(input.status === 'projected' ? {
        projection: {
          schemaVersion: 2,
          observationId: input.id,
          watchSessionId: HISTORY_WATCH_ID,
          requestId: value.requestId,
          documentKey: `document:${value.documentId}`,
          canonicalUrl: input.url,
          startedAt: observedAt,
          endedAt: observedAt,
          classification: {
            kind: input.kind,
            reason: input.kind === 'image' ? 'mime_image' : 'mime_video',
            evidence: { requestType: value.requestType, mimeType: value.responseMimeType },
          },
          admission: {
            matchedPresets: [input.kind === 'image' ? 'images' : 'videos'],
            matchedIncludeGlobIndexes: [],
          },
          derived: { ...(input.filename === undefined ? {} : { filename: input.filename }) },
          authority: { evaluatorSchemaVersion: 2, definitionSetDigest: `sha256:${'a'.repeat(64)}` },
        },
      } : {}),
      explanation,
      ...(input.status === 'failed' ? { failure: { stage: 'packagizer', code: 'rule_failed' } } : {}),
    },
  };
}

class MemoryHistoryReader implements ResourceHistoryReader {
  readonly sessions: readonly WatchSessionRecord[];
  readonly observations: readonly ResourceObservationRecord[];

  constructor(sessions: readonly WatchSessionRecord[], observations: readonly ResourceObservationRecord[]) {
    this.sessions = sessions;
    this.observations = observations;
  }

  async listWatchSessions(limit: number, cursor?: WatchSessionHistoryCursor) {
    const sorted = [...this.sessions].sort((a, b) => b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id));
    const filtered = cursor === undefined ? sorted : sorted.filter(
      (record) => record.createdAt < cursor.createdAt || (record.createdAt === cursor.createdAt && record.id < cursor.watchSessionId),
    );
    const items = filtered.slice(0, limit);
    const last = items.at(-1);
    return {
      items,
      ...(filtered.length > items.length && last !== undefined ? { nextCursor: { createdAt: last.createdAt, watchSessionId: last.id } } : {}),
    };
  }

  async listResourceObservations(
    watchSessionId: ResourceObservationRecord['watchSessionId'],
    limit: number,
    cursor?: ResourceObservationHistoryCursor,
  ) {
    const sorted = this.observations.filter((record) => record.watchSessionId === watchSessionId)
      .sort((a, b) => b.observedAt.localeCompare(a.observedAt) || b.id.localeCompare(a.id));
    const filtered = cursor === undefined ? sorted : sorted.filter(
      (record) => record.observedAt < cursor.observedAt || (record.observedAt === cursor.observedAt && record.id < cursor.observationId),
    );
    const items = filtered.slice(0, limit);
    const last = items.at(-1);
    return {
      items,
      ...(filtered.length > items.length && last !== undefined ? { nextCursor: { observedAt: last.observedAt, observationId: last.id } } : {}),
    };
  }

  async getResourceObservation(observationId: ResourceObservationRecord['id']) {
    return this.observations.find((record) => record.id === observationId);
  }
}

function historyService(): ResourceHistoryService {
  return new ResourceHistoryService(new MemoryHistoryReader(
    [
      historySession(HISTORY_WATCH_ID_2, 'Earlier setup', '2026-08-20T02:00:00.000Z'),
      historySession(HISTORY_WATCH_ID, 'Current media setup', '2026-08-20T03:00:00.000Z'),
    ],
    [
      historyObservation({ id: HISTORY_OBS_IDS[0], observedAt: '2026-08-20T03:01:03.000Z', url: 'https://cdn.example.test/poster.jpg', kind: 'image', status: 'projected', filename: 'poster.jpg' }),
      historyObservation({ id: HISTORY_OBS_IDS[1], observedAt: '2026-08-20T03:01:02.000Z', url: 'https://cdn.example.test/movie.mp4', kind: 'video', status: 'failed' }),
      historyObservation({ id: HISTORY_OBS_IDS[2], observedAt: '2026-08-20T03:01:01.000Z', url: 'https://cdn.example.test/noise.jpg', kind: 'image', status: 'rejected' }),
    ],
  ));
}

test('resource history sessions expose human setup context without requiring opaque IDs', async () => {
  const sessions = await historyService().sessions();
  assert.deepEqual(sessions.items.map((item) => item.setupName), ['Current media setup', 'Earlier setup']);
  assert.equal(sessions.items[0]?.watchRevision, 1);
  assert.equal(sessions.truncated, false);
});

test('resource history page is bounded, filterable, occurrence-preserving, and rejects are not primary results', async () => {
  const service = historyService();
  const first = await service.page({ watchSessionId: HISTORY_WATCH_ID, limit: 1, kind: 'all', status: 'all' });
  assert.equal(first.items.length, 1);
  assert.equal(first.items[0]?.filename, 'poster.jpg');
  assert.ok(first.nextCursor);

  const second = await service.page({ watchSessionId: HISTORY_WATCH_ID, limit: 1, cursor: first.nextCursor, kind: 'all', status: 'all' });
  assert.equal(second.items.length, 1);
  assert.equal(second.items[0]?.status, 'failed');
  assert.equal(second.items.some((item) => item.canonicalUrl.includes('noise.jpg')), false);

  const searched = await service.page({ watchSessionId: HISTORY_WATCH_ID, limit: 40, searchText: 'poster', kind: 'image', status: 'projected' });
  assert.deepEqual(searched.items.map((item) => item.filename), ['poster.jpg']);
  assert.ok(searched.scannedCount <= 500);
});

test('resource detail is human-facing and excludes raw request/document identity and sensitive payload surfaces', async () => {
  const detail = await historyService().detail(HISTORY_OBS_IDS[0]);
  assert.ok(detail);
  assert.equal(detail?.evaluation.filename, 'poster.jpg');
  assert.equal(detail?.source.responseStatusCode, 200);
  const serialized = JSON.stringify(detail);
  assert.equal(serialized.includes('private-doc'), false);
  assert.equal(serialized.includes('private-obs'), false);
  assert.equal(serialized.includes('requestId'), false);
  assert.equal(serialized.includes('documentId'), false);
  assert.equal(serialized.includes('headers'), false);
  assert.equal(serialized.includes('cookies'), false);
});

test('virtual resource window mounts a small stable slice even for large histories', () => {
  const window = virtualResourceWindow({ itemCount: 10_000, rowHeight: 72, viewportHeight: 360, scrollTop: 72 * 500, overscan: 4 });
  assert.equal(window.startIndex, 496);
  assert.equal(window.endIndex, 509);
  assert.equal(window.endIndex - window.startIndex, 13);
  assert.equal(window.totalHeight, 720_000);
});


test('bounded resource-row reconciliation pins the selected occurrence across newer inserts', async () => {
  const page = await historyService().page({ watchSessionId: HISTORY_WATCH_ID, limit: 40, kind: 'all', status: 'all' });
  assert.equal(page.items.length, 2);
  const selected = page.items[1]!;
  const incoming = {
    ...page.items[0]!,
    observationId: createStableId('resourceObservation', () => '90000000-0000-4000-8000-000000000099'),
    observedAt: requireIsoTimestamp('2026-08-20T03:01:04.000Z'),
    canonicalUrl: 'https://cdn.example.test/newest.jpg',
  };
  const merged = mergeResourceHistoryRows({
    current: page.items,
    incoming: [incoming],
    limit: 2,
    preserveObservationId: selected.observationId,
  });
  assert.equal(merged.length, 2);
  assert.equal(merged[0]?.observationId, incoming.observationId);
  assert.equal(merged[1]?.observationId, selected.observationId);
});
