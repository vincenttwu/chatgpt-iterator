import { cloneJsonValue, freezeJsonValue } from '../core/index.ts';
import { requireImmutableWatchSessionRecord } from '../definitions/index.ts';
import { evaluatePackagizerDetailed } from '../packagizer/index.ts';
import { requireResourceObservationRecord } from '../persistence/index.ts';
import {
  evaluateResourceObservation,
  resolveWatchSessionResourceFilter,
} from '../resources/index.ts';
import { RESOURCE_EVALUATION_ERROR_CODES, ResourceEvaluationError } from './errors.ts';
import {
  RESOURCE_EVALUATION_SCHEMA_VERSION,
  RESOURCE_EXPLANATION_SCHEMA_VERSION,
  RESOURCE_PROJECTION_SCHEMA_VERSION,
  type ResourceAdmissionExplanation,
  type ResourceClassificationExplanation,
  type ResourceEvaluationExplanation,
  type ResourceEvaluationFailure,
  type ResourceEvaluationInput,
  type ResourceEvaluationResult,
  type ResourceProjection,
  type ResourcePageEnrichmentExplanation,
} from './types.ts';

function matchedPatternIndexes(patterns: readonly string[], matched: readonly string[]): readonly number[] {
  return Object.freeze(patterns.flatMap((pattern, index) => matched.includes(pattern) ? [index] : []));
}

function classificationExplanation(
  occurrence: ReturnType<typeof evaluateResourceObservation>,
): ResourceClassificationExplanation {
  const evidence = occurrence.classification.evidence;
  return freezeJsonValue({
    kind: occurrence.classification.kind,
    reason: occurrence.classification.reason,
    requestType: evidence.requestType,
    mimePresent: evidence.mimeType !== undefined,
    extensionPresent: evidence.extension !== undefined,
    conflict: evidence.conflict,
    ...(evidence.mimeKind === undefined ? {} : { mimeKind: evidence.mimeKind }),
    ...(evidence.extensionKind === undefined ? {} : { extensionKind: evidence.extensionKind }),
  }) as ResourceClassificationExplanation;
}

function admissionExplanation(
  occurrence: ReturnType<typeof evaluateResourceObservation>,
  includeGlobs: readonly string[],
  excludeGlobs: readonly string[],
): ResourceAdmissionExplanation {
  return freezeJsonValue({
    admitted: occurrence.admission.admitted,
    positive: occurrence.admission.positive,
    matchedPresets: occurrence.admission.matchedPresets,
    matchedIncludeGlobIndexes: matchedPatternIndexes(includeGlobs, occurrence.admission.matchedIncludeGlobs),
    matchedExcludeGlobIndexes: matchedPatternIndexes(excludeGlobs, occurrence.admission.matchedExcludeGlobs),
  }) as ResourceAdmissionExplanation;
}

function pageEnrichmentExplanation(input: ResourceEvaluationInput): ResourcePageEnrichmentExplanation {
  if (input.pageEnrichment !== undefined) return freezeJsonValue(cloneJsonValue(input.pageEnrichment));
  return freezeJsonValue({ status: input.page === undefined ? 'not_provided' : 'provided' });
}

function requireCoherentInput(input: ResourceEvaluationInput) {
  const session = requireImmutableWatchSessionRecord(input.session);
  const observation = requireResourceObservationRecord(input.observation);
  if (session.id !== observation.watchSessionId) {
    throw new ResourceEvaluationError(
      RESOURCE_EVALUATION_ERROR_CODES.sessionMismatch,
      'Resource evaluation observation must belong to the supplied frozen WatchSession',
    );
  }
  return { session, observation };
}

/** Single pure semantic engine shared by live materialization and Preview/Test. */
export function evaluateResourceCandidate(input: ResourceEvaluationInput): ResourceEvaluationResult {
  const { session, observation } = requireCoherentInput(input);
  const filter = resolveWatchSessionResourceFilter(session);
  const occurrence = evaluateResourceObservation(observation, filter);
  const classification = classificationExplanation(occurrence);
  const admission = admissionExplanation(occurrence, filter.includeGlobs, filter.excludeGlobs);

  if (!occurrence.admission.admitted) {
    const explanation: ResourceEvaluationExplanation = freezeJsonValue({
      schemaVersion: RESOURCE_EXPLANATION_SCHEMA_VERSION,
      classification,
      admission,
      packagizerStatus: 'not_evaluated_admission',
      pageEnrichment: pageEnrichmentExplanation(input),
    });
    return freezeJsonValue({
      schemaVersion: RESOURCE_EVALUATION_SCHEMA_VERSION,
      status: 'rejected',
      observationId: observation.id,
      watchSessionId: session.id,
      explanation,
    }) as ResourceEvaluationResult;
  }

  const packagizer = evaluatePackagizerDetailed({
    session,
    occurrence,
    observation,
    watchStartedAt: session.createdAt,
    ...(input.page === undefined ? {} : { page: input.page }),
  });
  if (packagizer.result.failure !== undefined) {
    const failure: ResourceEvaluationFailure = {
      stage: 'packagizer',
      code: packagizer.result.failure.code,
      ruleId: packagizer.result.failure.ruleId,
    };
    const explanation: ResourceEvaluationExplanation = freezeJsonValue({
      schemaVersion: RESOURCE_EXPLANATION_SCHEMA_VERSION,
      classification,
      admission,
      packagizerStatus: 'evaluated',
      pageEnrichment: pageEnrichmentExplanation(input),
      packagizer: packagizer.explanation,
      failure,
    });
    return freezeJsonValue({
      schemaVersion: RESOURCE_EVALUATION_SCHEMA_VERSION,
      status: 'failed',
      observationId: observation.id,
      watchSessionId: session.id,
      explanation,
      failure,
    }) as ResourceEvaluationResult;
  }

  const projection: ResourceProjection = freezeJsonValue(cloneJsonValue({
    schemaVersion: RESOURCE_PROJECTION_SCHEMA_VERSION,
    observationId: observation.id,
    watchSessionId: session.id,
    requestId: occurrence.requestId,
    documentKey: occurrence.documentKey,
    canonicalUrl: occurrence.canonicalUrl,
    startedAt: occurrence.startedAt,
    endedAt: occurrence.endedAt,
    classification: occurrence.classification,
    admission: {
      matchedPresets: occurrence.admission.matchedPresets,
      matchedIncludeGlobIndexes: admission.matchedIncludeGlobIndexes,
    },
    derived: packagizer.result.derived,
    authority: {
      evaluatorSchemaVersion: RESOURCE_EVALUATION_SCHEMA_VERSION,
      definitionSetDigest: session.value.definitionSetDigest,
      ...(input.pageEnrichment?.snapshotId === undefined ? {} : { pageFieldSnapshotId: input.pageEnrichment.snapshotId }),
    },
  })) as ResourceProjection;
  const explanation: ResourceEvaluationExplanation = freezeJsonValue({
    schemaVersion: RESOURCE_EXPLANATION_SCHEMA_VERSION,
    classification,
    admission,
    packagizerStatus: 'evaluated',
    pageEnrichment: pageEnrichmentExplanation(input),
    packagizer: packagizer.explanation,
  });
  return freezeJsonValue({
    schemaVersion: RESOURCE_EVALUATION_SCHEMA_VERSION,
    status: 'projected',
    observationId: observation.id,
    watchSessionId: session.id,
    projection,
    explanation,
  }) as ResourceEvaluationResult;
}

/** Preview/Test is intentionally the exact same evaluator, not a toy reimplementation. */
export function previewResourceCandidate(input: ResourceEvaluationInput): ResourceEvaluationResult {
  return evaluateResourceCandidate(input);
}
</file>

