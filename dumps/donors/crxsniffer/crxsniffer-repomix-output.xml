import { assertJsonSafe, type JsonValue } from '../core/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from './errors.ts';

function canonicalize(value: JsonValue): string {
  if (value === null || typeof value === 'boolean' || typeof value === 'number' || typeof value === 'string') {
    return JSON.stringify(value);
  }
  if (Array.isArray(value)) {
    return `[${value.map((entry) => canonicalize(entry)).join(',')}]`;
  }
  const object = value as Record<string, JsonValue>;
  return `{${Object.keys(object)
    .sort()
    .map((key) => `${JSON.stringify(key)}:${canonicalize(object[key] as JsonValue)}`)
    .join(',')}}`;
}

export function canonicalJson(value: JsonValue): string {
  assertJsonSafe(value);
  return canonicalize(value);
}

export async function sha256Json(value: JsonValue): Promise<string> {
  const subtle = globalThis.crypto?.subtle;
  if (subtle === undefined) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.digestUnavailable,
      'Web Crypto SHA-256 is unavailable in this execution context',
    );
  }
  const bytes = new TextEncoder().encode(canonicalJson(value));
  const digest = await subtle.digest('SHA-256', bytes);
  return `sha256:${[...new Uint8Array(digest)]
    .map((byte) => byte.toString(16).padStart(2, '0'))
    .join('')}`;
}
</file>

