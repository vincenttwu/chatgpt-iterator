<file path="src/page-context/registry.ts">
import {
  INITIAL_REVISION,
  freezeJsonValue,
  nextRevision,
  type Revision,
} from '../core/index.ts';
import type { WatchStatusActive } from '../watch/types.ts';
import {
  PAGE_CONTEXT_SCHEMA_VERSION,
  PAGE_CONTEXT_STATE_SCHEMA_VERSION,
  PAGE_CONTEXT_STORAGE_KEY,
  type ObservationPageAttribution,
  type PageContextAttributableObservation,
  type PageContextResolution,
  type PageContextSessionState,
  type PageContextStore,
  type PageContextValue,
  type PageDocumentLink,
  type PageNavigationCommittedDetails,
  type PageNavigationFrame,
  type PageNavigationSameDocumentDetails,
} from './types.ts';
import {
  isActiveDocument,
  isTopLevelFrame,
  pageContextOrigin,
  requirePageContextSessionState,
} from './validation.ts';

function exactAttribution(
  status: 'exact_top_document' | 'exact_descendant',
  context: PageContextValue,
): ObservationPageAttribution {
  return freezeJsonValue({
    status,
    topDocumentId: context.topDocumentId,
    pageRevision: context.pageRevision,
  });
}

const UNATTRIBUTED = freezeJsonValue({ status: 'unattributed' } as const);
const STALE_OR_AMBIGUOUS = freezeJsonValue({ status: 'stale_or_ambiguous' } as const);

function linkFor(frame: PageNavigationFrame, topDocumentId: string): PageDocumentLink {
  return freezeJsonValue({
    documentId: frame.documentId,
    frameId: frame.frameId,
    topDocumentId,
    ...(frame.parentDocumentId === undefined ? {} : { parentDocumentId: frame.parentDocumentId }),
  });
}

function contextFor(
  active: WatchStatusActive,
  topDocumentId: string,
  url: string,
  pageRevision: Revision,
): PageContextValue {
  return freezeJsonValue({
    schemaVersion: PAGE_CONTEXT_SCHEMA_VERSION,
    watchSessionId: active.watchSessionId,
    tabId: active.tabId,
    topDocumentId,
    pageRevision,
    url,
    origin: pageContextOrigin(url),
  });
}

function stateFor(
  active: WatchStatusActive,
  context: PageContextValue | undefined,
  documents: readonly PageDocumentLink[],
): PageContextSessionState {
  return requirePageContextSessionState({
    schemaVersion: PAGE_CONTEXT_STATE_SCHEMA_VERSION,
    watchSessionId: active.watchSessionId,
    tabId: active.tabId,
    ...(context === undefined ? {} : { context }),
    documents,
  });
}

function sameActive(state: PageContextSessionState | undefined, active: WatchStatusActive): boolean {
  return state !== undefined && state.watchSessionId === active.watchSessionId && state.tabId === active.tabId;
}

function upsertLink(links: readonly PageDocumentLink[], link: PageDocumentLink): readonly PageDocumentLink[] {
  return Object.freeze([...links.filter((candidate) => candidate.documentId !== link.documentId), link]);
}

export class PageContextRegistry {
  readonly #store: PageContextStore;

  constructor(store: PageContextStore) {
    this.#store = store;
  }

  async #read(): Promise<PageContextSessionState | undefined> {
    const value = await this.#store.get(PAGE_CONTEXT_STORAGE_KEY);
    return value === undefined ? undefined : requirePageContextSessionState(value);
  }

  async #write(state: PageContextSessionState): Promise<void> {
    await this.#store.set(PAGE_CONTEXT_STORAGE_KEY, state);
  }

  async clear(): Promise<void> {
    await this.#store.remove(PAGE_CONTEXT_STORAGE_KEY);
  }

  async current(): Promise<PageContextValue | undefined> {
    return (await this.#read())?.context;
  }

  async bootstrap(active: WatchStatusActive, frames: readonly PageNavigationFrame[]): Promise<void> {
    const previous = await this.#read();
    const top = frames.find((frame) =>
      frame.tabId === active.tabId &&
      frame.frameId === 0 &&
      isTopLevelFrame(frame) &&
      isActiveDocument(frame));

    if (top === undefined) {
      await this.#write(stateFor(active, undefined, []));
      return;
    }

    const revision = sameActive(previous, active) && previous?.context?.topDocumentId === top.documentId
      ? previous.context.pageRevision
      : INITIAL_REVISION;
    const context = contextFor(active, top.documentId, top.url, revision);
    let documents: readonly PageDocumentLink[] = Object.freeze([linkFor(top, top.documentId)]);
    const unresolved = frames.filter((frame) => frame.documentId !== top.documentId && isActiveDocument(frame));
    let progressed = true;
    while (progressed) {
      progressed = false;
      for (const frame of unresolved) {
        if (documents.some((link) => link.documentId === frame.documentId)) continue;
        const parent = frame.parentDocumentId === undefined
          ? undefined
          : documents.find((link) => link.documentId === frame.parentDocumentId);
        if (parent === undefined) continue;
        documents = upsertLink(documents, linkFor(frame, parent.topDocumentId));
        progressed = true;
      }
    }
    await this.#write(stateFor(active, context, documents));
  }

  async committed(active: WatchStatusActive, details: PageNavigationCommittedDetails): Promise<void> {
    if (details.tabId !== active.tabId) return;
    const previous = await this.#read();
    const base = previous !== undefined && sameActive(previous, active)
      ? previous
      : stateFor(active, undefined, []);

    if (isTopLevelFrame(details)) {
      if (!isActiveDocument(details)) {
        if (base.context?.topDocumentId === details.documentId) {
          await this.#write(stateFor(active, undefined, base.documents));
        }
        return;
      }
      const revision = base.context?.topDocumentId === details.documentId
        ? base.context.pageRevision
        : INITIAL_REVISION;
      const context = contextFor(active, details.documentId, details.url, revision);
      await this.#write(stateFor(active, context, [linkFor(details, details.documentId)]));
      return;
    }

    if (!isActiveDocument(details) || base.context === undefined) return;
    const parent = details.parentDocumentId === undefined
      ? undefined
      : base.documents.find((link) => link.documentId === details.parentDocumentId);
    if (parent === undefined || parent.topDocumentId !== base.context.topDocumentId) return;
    await this.#write(stateFor(active, base.context, upsertLink(base.documents, linkFor(details, parent.topDocumentId))));
  }

  async sameDocumentNavigation(active: WatchStatusActive, details: PageNavigationSameDocumentDetails): Promise<void> {
    if (details.tabId !== active.tabId || !isTopLevelFrame(details) || !isActiveDocument(details)) return;
    const state = await this.#read();
    if (!sameActive(state, active) || state?.context === undefined) return;
    if (state.context.topDocumentId !== details.documentId) return;
    const context = contextFor(
      active,
      details.documentId,
      details.url,
      nextRevision(state.context.pageRevision),
    );
    await this.#write(stateFor(active, context, state.documents));
  }

  async attribute(details: {
    readonly tabId: number;
    readonly frameId: number;
    readonly documentId?: string;
    readonly parentDocumentId?: string;
  }): Promise<ObservationPageAttribution> {
    const state = await this.#read();
    if (state === undefined || state.tabId !== details.tabId || details.documentId === undefined) {
      return UNATTRIBUTED;
    }
    const context = state.context;
    if (context === undefined) return UNATTRIBUTED;

    if (details.frameId === 0) {
      return details.documentId === context.topDocumentId
        ? exactAttribution('exact_top_document', context)
        : STALE_OR_AMBIGUOUS;
    }

    const direct = state.documents.find((link) => link.documentId === details.documentId);
    if (direct !== undefined) {
      return direct.topDocumentId === context.topDocumentId
        ? exactAttribution('exact_descendant', context)
        : STALE_OR_AMBIGUOUS;
    }

    if (details.parentDocumentId !== undefined) {
      if (details.parentDocumentId === context.topDocumentId) {
        return exactAttribution('exact_descendant', context);
      }
      const parent = state.documents.find((link) => link.documentId === details.parentDocumentId);
      if (parent !== undefined && parent.topDocumentId === context.topDocumentId) {
        return exactAttribution('exact_descendant', context);
      }
    }
    return UNATTRIBUTED;
  }

  async resolveObservation(observation: PageContextAttributableObservation): Promise<PageContextResolution> {
    const exactAttributionStatus = observation.attributionStatus === 'exact_top_document' ||
      observation.attributionStatus === 'exact_descendant';
    if (!exactAttributionStatus || observation.topDocumentId === undefined || observation.pageRevision === undefined) {
      return freezeJsonValue({ status: 'unattributed' } as const);
    }
    const state = await this.#read();
    const context = state?.context;
    if (context === undefined) return freezeJsonValue({ status: 'unavailable' } as const);
    if (context.topDocumentId !== observation.topDocumentId) {
      return freezeJsonValue({ status: 'document_stale' } as const);
    }
    if (context.pageRevision !== observation.pageRevision) {
      return freezeJsonValue({ status: 'revision_stale' } as const);
    }
    return freezeJsonValue({ status: 'exact', context } as const);
  }
}
</file>

<file path="src/page-context/types.ts">
import type { JsonObject, Revision, StableId } from '../core/index.ts';
import type { WatchSessionStatePort, WatchStatusActive } from '../watch/types.ts';

export const PAGE_CONTEXT_SCHEMA_VERSION = 1 as const;
export const PAGE_CONTEXT_STATE_SCHEMA_VERSION = 1 as const;
export const PAGE_CONTEXT_STORAGE_KEY = 'pageContext.active';

export type PageDocumentLifecycle = 'prerender' | 'active' | 'cached' | 'pending_deletion';
export type PageFrameType = 'outermost_frame' | 'fenced_frame' | 'sub_frame';

export type ObservationAttributionStatus =
  | 'exact_top_document'
  | 'exact_descendant'
  | 'unattributed'
  | 'stale_or_ambiguous';

export type PageContextResolutionStatus =
  | 'exact'
  | 'unattributed'
  | 'unavailable'
  | 'document_stale'
  | 'revision_stale';

export interface PageContextValue extends JsonObject {
  readonly schemaVersion: typeof PAGE_CONTEXT_SCHEMA_VERSION;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly tabId: number;
  readonly topDocumentId: string;
