<file path="src/watch/ui-model.ts">
import { uiFormat, uiMessage as ui } from '../ui/index.ts';
import { freezeJsonValue } from '../core/index.ts';
import {
  requireResourceAdmissionFilter,
  type ResourceAdmissionFilter,
} from '../resources/index.ts';
import type { WatchConfigurationProblem, WatchTerminationReason } from './types.ts';

export interface WatchFilterDraft {
  readonly images: boolean;
  readonly videos: boolean;
  readonly includeGlobsText: string;
  readonly excludeGlobsText: string;
}

export interface WatchFilterDraftValidation {
  readonly valid: boolean;
  readonly filter?: ResourceAdmissionFilter;
  readonly error?: string;
}

export interface WatchScopeDisplay {
  readonly primary: string;
  readonly secondary: string;
}

function patternLines(value: string): readonly string[] {
  return Object.freeze(value
    .split(/\r?\n/u)
    .map((entry) => entry.trim())
    .filter((entry) => entry !== ''));
}

export function validateWatchFilterDraft(draft: WatchFilterDraft): WatchFilterDraftValidation {
  const includeGlobs = patternLines(draft.includeGlobsText);
  const excludeGlobs = patternLines(draft.excludeGlobsText);
  if (!draft.images && !draft.videos && includeGlobs.length === 0) {
    return freezeJsonValue({
      valid: false,
      error: ui('select_images_or_videos_or_add_at_least_one_include'),
    });
  }
  try {
    const filter = requireResourceAdmissionFilter({
      schemaVersion: 1,
      images: draft.images,
      videos: draft.videos,
      includeGlobs,
      excludeGlobs,
    });
    return freezeJsonValue({ valid: true, filter });
  } catch {
    return freezeJsonValue({
      valid: false,
      error: ui('check_the_advanced_url_patterns_use_for_any_characte'),
    });
  }
}

export function filterDraftFromFilter(filter: ResourceAdmissionFilter): WatchFilterDraft {
  return Object.freeze({
    images: filter.images,
    videos: filter.videos,
    includeGlobsText: filter.includeGlobs.join('\n'),
    excludeGlobsText: filter.excludeGlobs.join('\n'),
  });
}

export function watchSetupSignature(name: string, filter: ResourceAdmissionFilter): string {
  return JSON.stringify({ name: name.trim(), filter });
}

export function describeResourceFilter(filter: ResourceAdmissionFilter): string {
  const positives: string[] = [];
  if (filter.images) positives.push(ui('images'));
  if (filter.videos) positives.push(ui('videos'));
  if (filter.includeGlobs.length > 0) {
    positives.push(`${filter.includeGlobs.length} include ${filter.includeGlobs.length === 1 ? 'pattern' : 'patterns'}`);
  }
  const primary = positives.length === 0 ? ui('no_positive_matches') : positives.join(' + ');
  if (filter.excludeGlobs.length === 0) return primary;
  return `${primary}; ${filter.excludeGlobs.length} exclusion ${filter.excludeGlobs.length === 1 ? 'pattern' : 'patterns'} veto matches`;
}

export function describeWatchScope(tab: {
  readonly id?: number;
  readonly url?: string;
  readonly title?: string;
  readonly incognito?: boolean;
} | undefined): WatchScopeDisplay {
  if (tab === undefined || tab.id === undefined) {
    return Object.freeze({
      primary: ui('no_active_browser_tab'),
      secondary: ui('switch_to_the_page_you_want_to_watch'),
    });
  }
  if (tab.url === undefined) {
    return Object.freeze({
      primary: tab.title?.trim() || ui('current_tab'),
      secondary: ui('the_exact_page_address_is_shown_after_optional_site'),
    });
  }
  let host = tab.url;
  try {
    const parsed = new URL(tab.url);
    host = parsed.host || parsed.protocol;
  } catch {
    // Keep the exact URL when it is not a normal parseable URL.
  }
  return Object.freeze({
    primary: tab.title?.trim() || host,
    secondary: tab.incognito ? uiFormat('incognito_scope', [tab.url]) : tab.url,
  });
}

export function terminationMessage(reason: WatchTerminationReason): string {
  switch (reason) {
    case 'user_stop': return ui('the_last_watch_was_stopped_by_you');
    case 'target_closed': return ui('the_last_watch_ended_because_its_tab_was_closed');
    case 'permission_lost': return ui('the_last_watch_ended_because_site_access_was_removed');
    case 'runtime_session_lost': return ui('the_last_watch_ended_after_the_browser_session_resta');
    case 'target_unsupported': return ui('the_last_watch_ended_because_its_target_became_unsup');
    case 'storage_failure': return ui('the_last_watch_ended_because_local_storage_could_not_commit');
  }
}

export function configurationProblemMessage(problem: WatchConfigurationProblem | undefined): string | undefined {
  switch (problem) {
    case undefined: return undefined;
    case 'disabled': return ui('this_saved_setup_is_disabled_and_cannot_start_a_watc');
    case 'missing_resource_filter': return ui('this_saved_setup_references_a_resource_filter_that_i');
    case 'multiple_resource_filters': return ui('this_saved_setup_has_more_than_one_active_resource_f');
    case 'invalid_resource_filter': return ui('this_saved_setup_contains_an_invalid_resource_filter');
  }
}
