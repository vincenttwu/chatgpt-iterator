import type { WatchStatusActive } from '../watch/types.ts';
import type { PageContextRegistry } from './registry.ts';
import type {
  PageNavigationCommittedDetails,
  PageNavigationFrame,
  PageNavigationSameDocumentDetails,
} from './types.ts';

export interface ChromeWebNavigationEventLike<T> {
  addListener(listener: (details: T) => void): void;
  removeListener(listener: (details: T) => void): void;
}

export interface ChromeWebNavigationLike {
  getAllFrames(details: { readonly tabId: number }): Promise<readonly PageNavigationFrame[] | undefined>;
  readonly onCommitted: ChromeWebNavigationEventLike<PageNavigationCommittedDetails>;
  readonly onHistoryStateUpdated: ChromeWebNavigationEventLike<PageNavigationSameDocumentDetails>;
  readonly onReferenceFragmentUpdated: ChromeWebNavigationEventLike<PageNavigationSameDocumentDetails>;
}

export interface ChromePageContextCaptureOptions {
  readonly webNavigation: ChromeWebNavigationLike;
  readonly registry: PageContextRegistry;
  readonly onError?: (error: unknown) => void;
  readonly onBeforeContextChange?: () => void | Promise<void>;
}


export class ChromePageContextCapture {
  readonly #webNavigation: ChromeWebNavigationLike;
  readonly #registry: PageContextRegistry;
  readonly #onError: (error: unknown) => void;
  readonly #onBeforeContextChange: () => void | Promise<void>;
  #active: WatchStatusActive | undefined;
  #registered = false;
  #queue: Promise<void> = Promise.resolve();

  readonly #committed = (details: PageNavigationCommittedDetails) => {
    const active = this.#active;
    if (active === undefined || details.tabId !== active.tabId) return;
    void this.#enqueue(async () => { await this.#onBeforeContextChange(); await this.#registry.committed(active, details); });
  };

  readonly #history = (details: PageNavigationSameDocumentDetails) => {
    const active = this.#active;
    if (active === undefined || details.tabId !== active.tabId) return;
    void this.#enqueue(async () => { await this.#onBeforeContextChange(); await this.#registry.sameDocumentNavigation(active, details); });
  };

  readonly #fragment = (details: PageNavigationSameDocumentDetails) => {
    const active = this.#active;
    if (active === undefined || details.tabId !== active.tabId) return;
    void this.#enqueue(async () => { await this.#onBeforeContextChange(); await this.#registry.sameDocumentNavigation(active, details); });
  };

  constructor(options: ChromePageContextCaptureOptions) {
    this.#webNavigation = options.webNavigation;
    this.#registry = options.registry;
    this.#onError = options.onError ?? ((error) => console.error('crsniffer PageContext update failed', error));
    this.#onBeforeContextChange = options.onBeforeContextChange ?? (() => undefined);
  }

  #enqueue(operation: () => Promise<void>): Promise<void> {
    const next = this.#queue.then(operation, operation);
    this.#queue = next.catch(this.#onError);
    return next;
  }

  #register(): void {
    if (this.#registered) return;
    this.#webNavigation.onCommitted.addListener(this.#committed);
    this.#webNavigation.onHistoryStateUpdated.addListener(this.#history);
    this.#webNavigation.onReferenceFragmentUpdated.addListener(this.#fragment);
    this.#registered = true;
  }

  #unregister(): void {
    if (!this.#registered) return;
    this.#webNavigation.onCommitted.removeListener(this.#committed);
    this.#webNavigation.onHistoryStateUpdated.removeListener(this.#history);
    this.#webNavigation.onReferenceFragmentUpdated.removeListener(this.#fragment);
    this.#registered = false;
  }

  async sync(active: WatchStatusActive | undefined): Promise<void> {
    if (active === undefined) {
      this.#active = undefined;
      this.#unregister();
      await this.#enqueue(async () => { await this.#onBeforeContextChange(); await this.#registry.clear(); });
      return;
    }

    const changed = this.#active?.watchSessionId !== active.watchSessionId || this.#active.tabId !== active.tabId;
    this.#active = active;
    this.#register();
    if (!changed) return;

    await this.#enqueue(async () => {
      await this.#onBeforeContextChange();
      let frames: readonly PageNavigationFrame[] = [];
      try {
        frames = await this.#webNavigation.getAllFrames({ tabId: active.tabId }) ?? [];
      } catch {
        frames = [];
      }
      await this.#registry.bootstrap(active, frames);
    });
  }
}
