import { requireStableId, type StableId } from '../core/index.ts';
import { requireResourceObservationRecord, requireWatchSessionRecord } from './records.ts';
import { PERSISTENCE_STORES } from './schema.ts';
import type { IsoTimestamp, ResourceObservationRecord, WatchSessionRecord } from './types.ts';

export const RESOURCE_HISTORY_READ_MAX_ITEMS = 500 as const;

export interface ResourceObservationHistoryCursor {
  readonly observedAt: IsoTimestamp;
  readonly observationId: StableId<'resourceObservation'>;
}

export interface WatchSessionHistoryCursor {
  readonly createdAt: IsoTimestamp;
  readonly watchSessionId: StableId<'watchSession'>;
}

export interface ResourceObservationHistoryPage {
  readonly items: readonly ResourceObservationRecord[];
  readonly nextCursor?: ResourceObservationHistoryCursor;
}

export interface WatchSessionHistoryPage {
  readonly items: readonly WatchSessionRecord[];
  readonly nextCursor?: WatchSessionHistoryCursor;
}

export interface ResourceHistoryReader {
  listWatchSessions(limit: number, cursor?: WatchSessionHistoryCursor): Promise<WatchSessionHistoryPage>;
  listResourceObservations(
    watchSessionId: StableId<'watchSession'>,
    limit: number,
    cursor?: ResourceObservationHistoryCursor,
  ): Promise<ResourceObservationHistoryPage>;
  getResourceObservation(observationId: StableId<'resourceObservation'>): Promise<ResourceObservationRecord | undefined>;
}

function requireReadLimit(limit: number): number {
  if (!Number.isSafeInteger(limit) || limit < 1 || limit > RESOURCE_HISTORY_READ_MAX_ITEMS) {
    throw new RangeError(`history read limit must be 1..${RESOURCE_HISTORY_READ_MAX_ITEMS}`);
  }
  return limit;
}

function transactionComplete(transaction: IDBTransaction): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    transaction.oncomplete = () => resolve();
    transaction.onabort = () => reject(transaction.error ?? new Error('IndexedDB transaction aborted'));
    transaction.onerror = () => reject(transaction.error ?? new Error('IndexedDB transaction failed'));
  });
}

function requestResult<T>(request: IDBRequest<T>): Promise<T> {
  return new Promise<T>((resolve, reject) => {
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error ?? new Error('IndexedDB request failed'));
  });
}

function compareString(left: string, right: string): number {
  return left < right ? -1 : left > right ? 1 : 0;
}

function compareCursorPosition(
  key: string,
  primaryKey: string,
  targetKey: string,
  targetPrimaryKey: string,
): number {
  const byKey = compareString(key, targetKey);
  if (byKey !== 0) return byKey;
  return compareString(primaryKey, targetPrimaryKey);
}

/**
 * IndexedDB-backed bounded history reader.
 *
 * The existing v1 indexes remain authoritative. Cursor reads use index order and never call getAll(),
 * so Side Panel history hydration does not require loading the complete durable history graph.
 */
export class IndexedDbResourceHistoryReader implements ResourceHistoryReader {
  readonly #database: IDBDatabase;

  constructor(database: IDBDatabase) {
    this.#database = database;
  }

  async listWatchSessions(limitInput: number, cursor?: WatchSessionHistoryCursor): Promise<WatchSessionHistoryPage> {
    const limit = requireReadLimit(limitInput);
    const transaction = this.#database.transaction(PERSISTENCE_STORES.watchSessions, 'readonly');
    const index = transaction.objectStore(PERSISTENCE_STORES.watchSessions).index('byCreatedAt');
    const range = cursor === undefined ? undefined : IDBKeyRange.upperBound(cursor.createdAt);
    const request = index.openCursor(range, 'prev');
    const items: WatchSessionRecord[] = [];
    let hasMore = false;
    let resumePending = cursor !== undefined;

    await new Promise<void>((resolve, reject) => {
      request.onerror = () => reject(request.error ?? new Error('WatchSession cursor failed'));
      request.onsuccess = () => {
        const databaseCursor = request.result;
        if (databaseCursor === null) {
          resolve();
          return;
        }
        if (cursor !== undefined && resumePending) {
          const position = compareCursorPosition(
            String(databaseCursor.key),
            String(databaseCursor.primaryKey),
            cursor.createdAt,
            cursor.watchSessionId,
          );
          if (position > 0) {
            databaseCursor.continuePrimaryKey(cursor.createdAt, cursor.watchSessionId);
            return;
          }
          resumePending = false;
          if (position === 0) {
            databaseCursor.continue();
            return;
          }
        }
        const record = requireWatchSessionRecord(databaseCursor.value);
        if (items.length >= limit) {
          hasMore = true;
          resolve();
          return;
        }
        items.push(record);
        databaseCursor.continue();
      };
    });
    await transactionComplete(transaction);
    const last = items.at(-1);
    return Object.freeze({
      items: Object.freeze(items),
      ...(hasMore && last !== undefined ? {
        nextCursor: Object.freeze({ createdAt: last.createdAt, watchSessionId: last.id }),
      } : {}),
    });
  }

  async listResourceObservations(
    watchSessionIdInput: StableId<'watchSession'>,
    limitInput: number,
    cursor?: ResourceObservationHistoryCursor,
  ): Promise<ResourceObservationHistoryPage> {
    const watchSessionId = requireStableId(watchSessionIdInput, 'watchSession');
    const limit = requireReadLimit(limitInput);
    const transaction = this.#database.transaction(PERSISTENCE_STORES.resourceObservations, 'readonly');
    const index = transaction.objectStore(PERSISTENCE_STORES.resourceObservations).index('byWatchSessionObservedAt');
    const upper = cursor === undefined ? '\uffff' : cursor.observedAt;
    const range = IDBKeyRange.bound([watchSessionId, ''], [watchSessionId, upper]);
    const request = index.openCursor(range, 'prev');
    const items: ResourceObservationRecord[] = [];
    let hasMore = false;
    let resumePending = cursor !== undefined;

    await new Promise<void>((resolve, reject) => {
      request.onerror = () => reject(request.error ?? new Error('ResourceObservation cursor failed'));
      request.onsuccess = () => {
        const databaseCursor = request.result;
        if (databaseCursor === null) {
          resolve();
          return;
        }
        if (cursor !== undefined && resumePending) {
          const key = databaseCursor.key as unknown as readonly [string, string];
          const position = compareCursorPosition(
            String(key[1]),
            String(databaseCursor.primaryKey),
            cursor.observedAt,
            cursor.observationId,
          );
          if (position > 0) {
            databaseCursor.continuePrimaryKey([watchSessionId, cursor.observedAt], cursor.observationId);
            return;
          }
          resumePending = false;
          if (position === 0) {
            databaseCursor.continue();
            return;
          }
        }
        const record = requireResourceObservationRecord(databaseCursor.value);
        if (record.watchSessionId !== watchSessionId) {
          databaseCursor.continue();
          return;
        }
        if (items.length >= limit) {
          hasMore = true;
          resolve();
          return;
        }
        items.push(record);
        databaseCursor.continue();
      };
    });
    await transactionComplete(transaction);
    const last = items.at(-1);
    return Object.freeze({
      items: Object.freeze(items),
      ...(hasMore && last !== undefined ? {
        nextCursor: Object.freeze({ observedAt: last.observedAt, observationId: last.id }),
      } : {}),
    });
  }

  async getResourceObservation(
    observationIdInput: StableId<'resourceObservation'>,
  ): Promise<ResourceObservationRecord | undefined> {
    const observationId = requireStableId(observationIdInput, 'resourceObservation');
    const transaction = this.#database.transaction(PERSISTENCE_STORES.resourceObservations, 'readonly');
    const request = transaction.objectStore(PERSISTENCE_STORES.resourceObservations).get(observationId);
    const value = await requestResult(request);
    await transactionComplete(transaction);
    return value === undefined ? undefined : requireResourceObservationRecord(value);
  }
}
