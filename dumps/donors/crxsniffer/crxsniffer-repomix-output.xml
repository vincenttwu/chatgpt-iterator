import {
  cloneJsonValue,
  freezeJsonValue,
  nextRevision,
} from '../core/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  type DefinitionRecord,
  type JsonRecordRepository,
} from '../persistence/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from './errors.ts';
import {
  createDefinitionValue,
  createInitialDefinitionRecord,
  requireExpectedRevision,
  requireSavedDefinitionRecord,
} from './validation.ts';
import type {
  CreateDefinitionInput,
  DefinitionKind,
  SavedDefinitionRecord,
  UpdateDefinitionPatch,
} from './types.ts';

export class DefinitionCatalog {
  readonly #repository: JsonRecordRepository<DefinitionRecord>;

  constructor(repository: JsonRecordRepository<DefinitionRecord>) {
    this.#repository = repository;
  }

  async get(id: SavedDefinitionRecord['id']): Promise<SavedDefinitionRecord | undefined> {
    const record = await this.#repository.get(id);
    return record === undefined ? undefined : requireSavedDefinitionRecord(record);
  }

  async require(id: SavedDefinitionRecord['id']): Promise<SavedDefinitionRecord> {
    const record = await this.get(id);
    if (record === undefined) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.definitionNotFound,
        `Definition ${id} does not exist`,
        { id },
      );
    }
    return record;
  }

  async list(kind?: DefinitionKind): Promise<readonly SavedDefinitionRecord[]> {
    const records = (await this.#repository.list())
      .map((record) => requireSavedDefinitionRecord(record))
      .filter((record) => kind === undefined || record.definitionKind === kind);
    return Object.freeze(records);
  }

  async create(input: CreateDefinitionInput): Promise<SavedDefinitionRecord> {
    if (await this.get(input.id) !== undefined) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.invalidDefinition,
        `Definition ${input.id} already exists`,
        { id: input.id },
      );
    }
    const value = createDefinitionValue(input);
    const record = createInitialDefinitionRecord({
      id: input.id,
      kind: input.kind,
      value,
      timestamp: input.timestamp,
    });
    await this.#repository.put(record);
    return record;
  }

  async update(
    id: SavedDefinitionRecord['id'],
    expectedRevision: SavedDefinitionRecord['revision'],
    patch: UpdateDefinitionPatch,
    timestamp: SavedDefinitionRecord['updatedAt'],
  ): Promise<SavedDefinitionRecord> {
    const current = await this.require(id);
    requireExpectedRevision(current.revision, expectedRevision, id);
    const value = createDefinitionValue({
      name: patch.name ?? current.value.name,
      enabled: patch.enabled ?? current.value.enabled,
      body: patch.body ?? current.value.body,
      references: patch.references ?? current.value.references,
    });
    const updated = requireSavedDefinitionRecord({
      schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
      id: current.id,
      revision: nextRevision(current.revision),
      definitionKind: current.definitionKind,
      createdAt: current.createdAt,
      updatedAt: timestamp,
      value,
    });
    await this.#repository.put(updated);
    return freezeJsonValue(cloneJsonValue(updated));
  }

  /**
   * Remove one exact durable definition revision.
   *
   * This low-level operation exists for bounded transactional compensation and
   * orphan cleanup. User-facing delete semantics remain governed separately and
   * must perform dependency checks before calling this method.
   */
  async deleteExact(
    id: SavedDefinitionRecord['id'],
    expectedRevision: SavedDefinitionRecord['revision'],
  ): Promise<void> {
    const current = await this.require(id);
    requireExpectedRevision(current.revision, expectedRevision, id);
    await this.#repository.delete(id);
  }
}
</file>

<file path="src/definitions/composition.ts">
import {
  cloneJsonValue,
  freezeJsonValue,
  type JsonObject,
  type Revision,
  type StableId,
} from '../core/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  type DefinitionRecord,
  type JsonRecordRepository,
  type WatchSessionRecord,
} from '../persistence/index.ts';
import { DefinitionCatalog } from './catalog.ts';
import { sha256Json } from './digest.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from './errors.ts';
import {
  requireExpectedRevision,
  requireImmutableWatchSessionRecord,
} from './validation.ts';
import type {
  ComposeWatchSessionInput,
  DefinitionKind,
  DefinitionReference,
  FrozenDefinitionSnapshot,
  ImmutableWatchSessionRecord,
  SavedDefinitionRecord,
} from './types.ts';

const ALLOWED_REFERENCE_KINDS = Object.freeze({
  watch: Object.freeze(['resourceFilter', 'packagizerRule', 'template'] as const),
  resourceFilter: Object.freeze([] as const),
  packagizerRule: Object.freeze(['template', 'pageFieldMapping'] as const),
  template: Object.freeze(['pageFieldMapping'] as const),
  pageFieldMapping: Object.freeze([] as const),
}) satisfies Readonly<Record<DefinitionKind, readonly DefinitionKind[]>>;

function assertReferenceAllowed(parent: DefinitionKind, reference: DefinitionReference): void {
  const allowed = ALLOWED_REFERENCE_KINDS[parent] as readonly DefinitionKind[];
  if (!allowed.includes(reference.kind)) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidReference,
      `${parent} definitions may not reference ${reference.kind}`,
      { parentKind: parent, referenceKind: reference.kind, referenceId: reference.id },
    );
  }
}

async function freezeDefinition(record: SavedDefinitionRecord): Promise<FrozenDefinitionSnapshot> {
  const source: JsonObject = {
    id: record.id,
    kind: record.definitionKind,
    revision: record.revision,
    value: record.value,
  };
  const snapshot: FrozenDefinitionSnapshot = {
    ...source,
    id: record.id,
    kind: record.definitionKind,
    revision: record.revision,
    digest: await sha256Json(source),
    value: record.value,
  };
  return freezeJsonValue(cloneJsonValue(snapshot));
}

export class WatchSessionComposer {
  readonly #catalog: DefinitionCatalog;
  readonly #sessions: JsonRecordRepository<WatchSessionRecord>;

  constructor(
    definitions: JsonRecordRepository<DefinitionRecord>,
    sessions: JsonRecordRepository<WatchSessionRecord>,
  ) {
    this.#catalog = new DefinitionCatalog(definitions);
    this.#sessions = sessions;
  }

  async #build(input: ComposeWatchSessionInput): Promise<ImmutableWatchSessionRecord> {
    const root = await this.#catalog.require(input.watchDefinitionId);
    if (root.definitionKind !== 'watch') {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.watchDefinitionRequired,
        'WatchSession composition must start from a watch definition',
        { definitionId: root.id, actualKind: root.definitionKind },
      );
    }
    requireExpectedRevision(root.revision, input.expectedWatchRevision, root.id);
    if (!root.value.enabled) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.watchDefinitionDisabled,
        'Disabled watch definitions cannot start a WatchSession',
        { definitionId: root.id },
      );
    }

    const frozen = new Map<StableId<'definition'>, FrozenDefinitionSnapshot>();
    const active = new Set<StableId<'definition'>>();

    const visit = async (
      record: SavedDefinitionRecord,
      expectedRevision?: Revision,
      parentKind?: DefinitionKind,
    ): Promise<void> => {
      if (parentKind !== undefined) {
        const edge: DefinitionReference = {
          id: record.id,
          kind: record.definitionKind,
          ...(expectedRevision === undefined ? {} : { expectedRevision }),
        };
        assertReferenceAllowed(parentKind, edge);
      }
      requireExpectedRevision(record.revision, expectedRevision, record.id);

      if (active.has(record.id)) {
        throw new DefinitionError(
          DEFINITION_ERROR_CODES.referenceCycle,
          `Definition dependency cycle includes ${record.id}`,
          { definitionId: record.id },
        );
      }

      const existing = frozen.get(record.id);
      if (existing !== undefined) {
        if (existing.kind !== record.definitionKind || existing.revision !== record.revision) {
          throw new DefinitionError(
            DEFINITION_ERROR_CODES.revisionConflict,
            `Definition ${record.id} resolved inconsistently during composition`,
            { definitionId: record.id },
          );
        }
        return;
      }

      active.add(record.id);
      try {
        frozen.set(record.id, await freezeDefinition(record));
        if (record.id !== root.id && !record.value.enabled) return;
        for (const reference of record.value.references) {
          assertReferenceAllowed(record.definitionKind, reference);
          const dependency = await this.#catalog.require(reference.id);
          if (dependency.definitionKind !== reference.kind) {
            throw new DefinitionError(
              DEFINITION_ERROR_CODES.kindMismatch,
              `Definition ${reference.id} has kind ${dependency.definitionKind}, not ${reference.kind}`,
              {
                definitionId: reference.id,
                expectedKind: reference.kind,
                actualKind: dependency.definitionKind,
              },
            );
          }
          await visit(dependency, reference.expectedRevision, record.definitionKind);
        }
      } finally {
        active.delete(record.id);
      }
    };

    await visit(root, input.expectedWatchRevision);

    const definitions = Object.freeze(
      [...frozen.values()].sort((left, right) => left.id.localeCompare(right.id)),
    );
    const definitionSetSource: JsonObject = {
      watchDefinitionId: root.id,
      definitions,
    };
    const value = freezeJsonValue(cloneJsonValue({
      ...definitionSetSource,
      definitionSetDigest: await sha256Json(definitionSetSource),
    }));
    return requireImmutableWatchSessionRecord({
      schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
      id: input.id,
      createdAt: input.timestamp,
      updatedAt: input.timestamp,
      value,
    });
  }

  /** Build the exact immutable dependency snapshot without persisting a WatchSession. */
  async preview(input: ComposeWatchSessionInput): Promise<ImmutableWatchSessionRecord> {
    return this.#build(input);
  }

  async compose(input: ComposeWatchSessionInput): Promise<ImmutableWatchSessionRecord> {
    if (await this.#sessions.get(input.id) !== undefined) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.watchSessionExists,
        `WatchSession ${input.id} already exists and is immutable`,
        { watchSessionId: input.id },
      );
    }
    const record = await this.#build(input);
    await this.#sessions.put(record);
    return record;
  }
}
