import type { PageContextValue } from '../page-context/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from './errors.ts';
import { evaluatePageFieldMapping } from './evaluator.ts';
import type {
  PageFieldContextGuard,
  PageFieldDomReader,
  PageFieldEvaluationRequest,
  PageFieldEvaluationResult,
  PageFieldMappingBody,
} from './types.ts';

function sameContext(actual: PageContextValue | undefined, expected: PageContextValue): boolean {
  return actual !== undefined &&
    actual.watchSessionId === expected.watchSessionId &&
    actual.tabId === expected.tabId &&
    actual.topDocumentId === expected.topDocumentId &&
    actual.pageRevision === expected.pageRevision;
}

/** Exact-document guard around the pure mapping evaluator. */
export class PageFieldEvaluationService {
  readonly #context: PageFieldContextGuard;
  readonly #reader: PageFieldDomReader;

  constructor(context: PageFieldContextGuard, reader: PageFieldDomReader) {
    this.#context = context;
    this.#reader = reader;
  }

  async #requireExact(expected: PageContextValue): Promise<void> {
    const current = await this.#context.current();
    if (current === undefined) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.contextUnavailable, 'PageContext is unavailable');
    if (!sameContext(current, expected)) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.contextStale, 'PageContext changed before field evaluation completed');
  }

  async evaluateBody(context: PageContextValue, body: PageFieldMappingBody): Promise<PageFieldEvaluationResult> {
    await this.#requireExact(context);
    return evaluatePageFieldMapping(body, async (candidate) => {
      await this.#requireExact(context);
      const result = await this.#reader.read(context, candidate);
      await this.#requireExact(context);
      return result;
    });
  }

  async evaluate(request: PageFieldEvaluationRequest): Promise<PageFieldEvaluationResult> {
    return this.evaluateBody(request.context, request.mapping.body);
  }
}
