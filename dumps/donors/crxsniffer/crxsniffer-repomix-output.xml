import { requireStableId, type StableId } from '../core/index.ts';
import { DefinitionCatalog, type SavedDefinitionRecord } from '../definitions/index.ts';
import type { IsoTimestamp } from '../persistence/index.ts';

export const DEFAULT_WATCH_DEFINITION_ID = requireStableId(
  'def_00000000-0000-4000-8000-000000000001',
  'definition',
) as StableId<'definition'>;

export async function ensureDefaultWatchDefinition(
  catalog: DefinitionCatalog,
  timestamp: IsoTimestamp,
): Promise<SavedDefinitionRecord> {
  const existing = await catalog.get(DEFAULT_WATCH_DEFINITION_ID);
  if (existing !== undefined) {
    if (existing.definitionKind !== 'watch') {
      throw new TypeError('built-in default definition ID is not a Watch definition');
    }
    return existing;
  }

  return catalog.create({
    id: DEFAULT_WATCH_DEFINITION_ID,
    kind: 'watch',
    name: 'Default Watch',
    body: { role: 'default' },
    timestamp,
  });
}
