        canonical_promoted = canonical_previous.with_name("sample-project.v0.0.7")
        canonical_previous.rename(canonical_promoted)
        self.set_workspace_identity(canonical_promoted, "v0.0.7")
        kept_seal = self.run_manager(
            canonical_promoted,
            "seal",
