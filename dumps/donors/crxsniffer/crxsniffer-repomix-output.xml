import {
  CONTRACT_ERROR_CODES,
  ContractError,
  assertJsonSafe,
  freezeJsonValue,
  requireJsonObject,
  type JsonObject,
} from '../core/index.ts';
import {
  CRSNIFFER_DATABASE_NAME,
  CRSNIFFER_DATABASE_VERSION,
  LOGICAL_DATABASE_VERSION,
  META_KEYS,
  readLogicalMigrationState,
  requireIsoTimestamp,
  requireRetentionMaintenanceState,
  requireStorageQuotaSnapshot,
  type DefinitionRecord,
  type JsonRecordRepository,
  type JsonStorageTier,
  type IsoTimestamp,
  type MetaRecord,
  type PageFieldSnapshotRecord,
  type ResourceObservationRecord,
  type RetentionMaintenanceReason,
  type RetentionMaintenanceState,
  type StorageQuotaSnapshot,
  type WatchSessionRecord,
} from '../persistence/index.ts';
import type { ResourceHistoryStatusFilter } from '../resources/index.ts';
import type { DefinitionCatalog } from '../definitions/index.ts';
import { ensureDefaultWatchDefinition } from '../watch/default-definition.ts';
import type { WatchController } from '../watch/controller.ts';
import type { WatchLifecycleRepository } from '../watch/lifecycle-repository.ts';
import {
  DEFAULT_WATCH_RETENTION_POLICY,
  WATCH_RETENTION_MAX_AGE_OPTIONS,
  WATCH_RETENTION_MAX_SESSION_OPTIONS,
  type WatchRetentionMaxAgeDays,
  type WatchRetentionMaxSessions,
  type WatchRetentionPolicy,
} from '../watch/retention.ts';

export const SETTINGS_SCHEMA_VERSION = 2 as const;
export const SETTINGS_PREFERENCES_STORAGE_KEY = 'preferences' as const;
export const SETTINGS_CLEAR_SCOPES = ['history', 'all_local_data'] as const;
export type SettingsClearScope = (typeof SETTINGS_CLEAR_SCOPES)[number];
export type ResourceRowDensity = 'comfortable' | 'compact';
export type SettingsDefaultResourceKind = 'all' | 'image' | 'video';

export interface SettingsPreferences extends JsonObject {
  readonly schemaVersion: typeof SETTINGS_SCHEMA_VERSION;
  readonly resourceRowDensity: ResourceRowDensity;
  readonly defaultResourceKind: SettingsDefaultResourceKind;
  readonly defaultResourceStatus: ResourceHistoryStatusFilter;
  readonly historyRetentionDays: WatchRetentionMaxAgeDays;
  readonly historyRetentionSessions: WatchRetentionMaxSessions;
  readonly forceDirectDownloadEnabled: boolean;
  readonly forceDirectDownloadExtensions: string;
  readonly downloadPathTemplate: string;
  readonly autoDownloadMatchedResources: boolean;
  readonly maxGlobalConcurrency: number;
  readonly maxDomainConcurrency: number;
  readonly downloadCooldownIntervalMs: number;
  readonly downloadSizeGuardEnabled: boolean;
  readonly downloadMinSizeBytes: number;
  readonly downloadMaxSizeBytes: number;
  readonly downloadPreflightHeadEnabled: boolean;
  readonly webhookEnabled: boolean;
  readonly webhookEndpointUrl: string;
  readonly webhookSecretKey: string;
  readonly webhookIncludeGlobs: string;
  readonly webhookExcludeGlobs: string;
  readonly webhookMaxConcurrency: number;
  readonly webhookCooldownMs: number;
  readonly webhookPayloadMode: 'standard' | 'custom';
}

export const DEFAULT_SETTINGS_PREFERENCES: SettingsPreferences = freezeJsonValue({
  schemaVersion: SETTINGS_SCHEMA_VERSION,
  resourceRowDensity: 'comfortable',
  defaultResourceKind: 'all',
  defaultResourceStatus: 'all',
  historyRetentionDays: DEFAULT_WATCH_RETENTION_POLICY.maxAgeDays,
  historyRetentionSessions: DEFAULT_WATCH_RETENTION_POLICY.maxTerminalSessions,
  watchIncludeGlobs: '*',
  watchExcludeGlobs: '',
  downloadIncludeGlobs: '*',
  downloadExcludeGlobs: '',
  forceDirectDownloadEnabled: false,
  forceDirectDownloadExtensions: '.pdf, .mp4, .m3u8, .ts',
  downloadPathTemplate: '{origin_url::domain}/{kind}/{filename}',
  autoDownloadMatchedResources: false,
  maxGlobalConcurrency: 2,
  maxDomainConcurrency: 1,
  downloadCooldownIntervalMs: 500,
  downloadSizeGuardEnabled: true,
  downloadMinSizeBytes: 51200,
  downloadMaxSizeBytes: 2147483648,
  downloadPreflightHeadEnabled: false,
  webhookEnabled: false,
  webhookEndpointUrl: '',
  webhookSecretKey: '',
  webhookIncludeGlobs: '*',
  webhookExcludeGlobs: '',
  webhookMaxConcurrency: 2,
  webhookCooldownMs: 500,
  webhookPayloadMode: 'standard',
});

export interface SettingsDataCounts extends JsonObject {
  readonly definitions: number;
  readonly watchSessions: number;
  readonly resourceObservations: number;
  readonly pageFieldSnapshots: number;
}

export interface SettingsDiagnostics extends JsonObject {
  readonly databaseName: typeof CRSNIFFER_DATABASE_NAME;
  readonly physicalDatabaseVersion: typeof CRSNIFFER_DATABASE_VERSION;
  readonly logicalDatabaseVersion: typeof LOGICAL_DATABASE_VERSION;
  readonly migrationStatus: 'idle' | 'running' | 'failed';
  readonly migrationCurrentVersion: number;
  readonly migrationTargetVersion: number;
  readonly counts: SettingsDataCounts;
  readonly storage: StorageQuotaSnapshot;
}

export interface SettingsRetentionPolicy extends JsonObject {
  readonly mode: 'bounded_terminal_history';
  readonly automaticRetention: 'enabled';
  readonly pressureBehavior: 'configured_terminal_history_only';
  readonly historyScope: readonly ['watchSessions', 'resourceObservations', 'pageFieldSnapshots', 'watchLifecycle'];
  readonly allLocalDataAdds: readonly ['definitions', 'preferences'];
  readonly maxAgeDays: WatchRetentionMaxAgeDays;
  readonly maxTerminalSessions: WatchRetentionMaxSessions;
  readonly maintenance: RetentionMaintenanceState;
}

export interface SettingsPrivacySummary extends JsonObject {
  readonly durableAuthority: 'local_indexeddb';
  readonly preferencesAuthority: 'chrome_storage_local';
  readonly syncStorageUsed: false;
  readonly externalTelemetry: false;
  readonly diagnosticsPayloadPolicy: 'structural_redacted';
  readonly rawHeadersCookiesBodiesRetained: false;
}

export interface SettingsSnapshot extends JsonObject {
  readonly schemaVersion: typeof SETTINGS_SCHEMA_VERSION;
  readonly preferences: SettingsPreferences;
  readonly retention: SettingsRetentionPolicy;
  readonly privacy: SettingsPrivacySummary;
  readonly diagnostics: SettingsDiagnostics;
}

export interface SettingsClearSummary extends JsonObject {
  readonly scope: SettingsClearScope;
  readonly before: SettingsDataCounts;
  readonly after: SettingsDataCounts;
}

export interface SettingsRepositorySet {
  readonly meta: JsonRecordRepository<MetaRecord>;
  readonly definitions: JsonRecordRepository<DefinitionRecord>;
  readonly watchSessions: JsonRecordRepository<WatchSessionRecord>;
  readonly resourceObservations: JsonRecordRepository<ResourceObservationRecord>;
  readonly pageFieldSnapshots: JsonRecordRepository<PageFieldSnapshotRecord>;
}

export interface SettingsSessionStatePort {
  clearNamespace(): Promise<void>;
}

export interface SettingsPendingObservationPort {
  clear(): Promise<void>;
}

export interface SettingsRetentionPort {
  state(): Promise<RetentionMaintenanceState>;
  enforce(policy: WatchRetentionPolicy, reason: Exclude<RetentionMaintenanceReason, 'initial'>): Promise<RetentionMaintenanceState>;
}

export interface SettingsQuotaPort {
  snapshot(): Promise<StorageQuotaSnapshot>;
}

export interface SettingsServiceOptions {
  readonly repositories: SettingsRepositorySet;
  readonly preferences: JsonStorageTier;
  readonly sessionState: SettingsSessionStatePort;
  readonly pendingObservations: SettingsPendingObservationPort;
  readonly lifecycle: WatchLifecycleRepository;
  readonly watch: Pick<WatchController, 'status'>;
  readonly catalog: DefinitionCatalog;
  readonly retention?: SettingsRetentionPort;
  readonly quota?: SettingsQuotaPort;
  readonly now?: () => IsoTimestamp;
}

const PRIVACY_SUMMARY: SettingsPrivacySummary = freezeJsonValue({
  durableAuthority: 'local_indexeddb',
  preferencesAuthority: 'chrome_storage_local',
  syncStorageUsed: false,
  externalTelemetry: false,
  diagnosticsPayloadPolicy: 'structural_redacted',
  rawHeadersCookiesBodiesRetained: false,
});

function requireOnlyKeys(record: JsonObject, allowed: readonly string[], label: string): void {
  const accepted = new Set(allowed);
  for (const key of Object.keys(record)) {
    if (!accepted.has(key)) throw new TypeError(`${label} contains unsupported field ${key}`);
  }
}

function requireResourceRowDensity(value: unknown): ResourceRowDensity {
  if (value !== 'comfortable' && value !== 'compact') throw new TypeError('Resource row density is invalid');
  return value;
}

function requireDefaultResourceKind(value: unknown): SettingsDefaultResourceKind {
  if (value !== 'all' && value !== 'image' && value !== 'video') throw new TypeError('Default resource kind is invalid');
  return value;
}

function requireDefaultResourceStatus(value: unknown): ResourceHistoryStatusFilter {
  if (value !== 'all' && value !== 'projected' && value !== 'failed') throw new TypeError('Default resource status is invalid');
  return value;
}

function requireRetentionDays(value: unknown): WatchRetentionMaxAgeDays {
  if (!(WATCH_RETENTION_MAX_AGE_OPTIONS as readonly unknown[]).includes(value)) throw new TypeError('History retention days are unsupported');
  return value as WatchRetentionMaxAgeDays;
}

function requireRetentionSessions(value: unknown): WatchRetentionMaxSessions {
  if (!(WATCH_RETENTION_MAX_SESSION_OPTIONS as readonly unknown[]).includes(value)) throw new TypeError('History retention session count is unsupported');
  return value as WatchRetentionMaxSessions;
}

export function requireSettingsPreferences(value: unknown): SettingsPreferences {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, [
    'schemaVersion',
    'resourceRowDensity',
    'defaultResourceKind',
    'defaultResourceStatus',
    'historyRetentionDays',
    'historyRetentionSessions',
    'watchIncludeGlobs',
    'watchExcludeGlobs',
    'downloadIncludeGlobs',
    'downloadExcludeGlobs',
    'forceDirectDownloadEnabled',
    'forceDirectDownloadExtensions',
    'downloadPathTemplate',
    'autoDownloadMatchedResources',
    'maxGlobalConcurrency',
    'maxDomainConcurrency',
    'downloadCooldownIntervalMs',
    'downloadSizeGuardEnabled',
    'downloadMinSizeBytes',
    'downloadMaxSizeBytes',
    'downloadPreflightHeadEnabled',
    'webhookEnabled',
    'webhookEndpointUrl',
    'webhookSecretKey',
    'webhookIncludeGlobs',
    'webhookExcludeGlobs',
    'webhookMaxConcurrency',
    'webhookCooldownMs',
    'webhookPayloadMode',
  ], 'Settings preferences');
  if (record.schemaVersion !== SETTINGS_SCHEMA_VERSION) throw new TypeError('Settings preferences schema version is unsupported');
  return freezeJsonValue({
    schemaVersion: SETTINGS_SCHEMA_VERSION,
    resourceRowDensity: requireResourceRowDensity(record.resourceRowDensity),
    defaultResourceKind: requireDefaultResourceKind(record.defaultResourceKind),
    defaultResourceStatus: requireDefaultResourceStatus(record.defaultResourceStatus),
    historyRetentionDays: requireRetentionDays(record.historyRetentionDays),
    historyRetentionSessions: requireRetentionSessions(record.historyRetentionSessions),
    watchIncludeGlobs: typeof record.watchIncludeGlobs === 'string' ? record.watchIncludeGlobs : '*',
    watchExcludeGlobs: typeof record.watchExcludeGlobs === 'string' ? record.watchExcludeGlobs : '',
    downloadIncludeGlobs: typeof record.downloadIncludeGlobs === 'string' ? record.downloadIncludeGlobs : '*',
    downloadExcludeGlobs: typeof record.downloadExcludeGlobs === 'string' ? record.downloadExcludeGlobs : '',
    forceDirectDownloadEnabled: typeof record.forceDirectDownloadEnabled === 'boolean' ? record.forceDirectDownloadEnabled : false,
    forceDirectDownloadExtensions: typeof record.forceDirectDownloadExtensions === 'string' ? record.forceDirectDownloadExtensions : '.pdf, .mp4, .m3u8, .ts',
    downloadPathTemplate: typeof record.downloadPathTemplate === 'string' ? record.downloadPathTemplate : DEFAULT_SETTINGS_PREFERENCES.downloadPathTemplate,
    autoDownloadMatchedResources: typeof record.autoDownloadMatchedResources === 'boolean' ? record.autoDownloadMatchedResources : false,
    maxGlobalConcurrency: typeof record.maxGlobalConcurrency === 'number' ? record.maxGlobalConcurrency : 2,
    maxDomainConcurrency: typeof record.maxDomainConcurrency === 'number' ? record.maxDomainConcurrency : 1,
    downloadCooldownIntervalMs: typeof record.downloadCooldownIntervalMs === 'number' ? record.downloadCooldownIntervalMs : 500,
    downloadSizeGuardEnabled: typeof record.downloadSizeGuardEnabled === 'boolean' ? record.downloadSizeGuardEnabled : true,
    downloadMinSizeBytes: typeof record.downloadMinSizeBytes === 'number' ? record.downloadMinSizeBytes : 51200,
    downloadMaxSizeBytes: typeof record.downloadMaxSizeBytes === 'number' ? record.downloadMaxSizeBytes : 2147483648,
    downloadPreflightHeadEnabled: typeof record.downloadPreflightHeadEnabled === 'boolean' ? record.downloadPreflightHeadEnabled : false,
    webhookEnabled: typeof record.webhookEnabled === 'boolean' ? record.webhookEnabled : false,
    webhookEndpointUrl: typeof record.webhookEndpointUrl === 'string' ? record.webhookEndpointUrl : '',
    webhookSecretKey: typeof record.webhookSecretKey === 'string' ? record.webhookSecretKey : '',
    webhookIncludeGlobs: typeof record.webhookIncludeGlobs === 'string' ? record.webhookIncludeGlobs : '*',
    webhookExcludeGlobs: typeof record.webhookExcludeGlobs === 'string' ? record.webhookExcludeGlobs : '',
    webhookMaxConcurrency: typeof record.webhookMaxConcurrency === 'number' ? record.webhookMaxConcurrency : 2,
    webhookCooldownMs: typeof record.webhookCooldownMs === 'number' ? record.webhookCooldownMs : 500,
    webhookPayloadMode: record.webhookPayloadMode === 'custom' ? 'custom' : 'standard',
  });
}

function migrateLegacySettingsPreferences(value: unknown): SettingsPreferences | undefined {
  try {
    assertJsonSafe(value);
    const record = requireJsonObject(value);
    if (record.schemaVersion !== 1) return undefined;
    requireOnlyKeys(record, ['schemaVersion', 'resourceRowDensity', 'defaultResourceKind', 'defaultResourceStatus'], 'Legacy Settings preferences');
    return freezeJsonValue({
      schemaVersion: SETTINGS_SCHEMA_VERSION,
      resourceRowDensity: requireResourceRowDensity(record.resourceRowDensity),
      defaultResourceKind: requireDefaultResourceKind(record.defaultResourceKind),
      defaultResourceStatus: requireDefaultResourceStatus(record.defaultResourceStatus),
      historyRetentionDays: DEFAULT_SETTINGS_PREFERENCES.historyRetentionDays,
      historyRetentionSessions: DEFAULT_SETTINGS_PREFERENCES.historyRetentionSessions,
      watchIncludeGlobs: DEFAULT_SETTINGS_PREFERENCES.watchIncludeGlobs,
      watchExcludeGlobs: DEFAULT_SETTINGS_PREFERENCES.watchExcludeGlobs,
      downloadIncludeGlobs: DEFAULT_SETTINGS_PREFERENCES.downloadIncludeGlobs,
      downloadExcludeGlobs: DEFAULT_SETTINGS_PREFERENCES.downloadExcludeGlobs,
      forceDirectDownloadEnabled: DEFAULT_SETTINGS_PREFERENCES.forceDirectDownloadEnabled,
      forceDirectDownloadExtensions: DEFAULT_SETTINGS_PREFERENCES.forceDirectDownloadExtensions,
      downloadPathTemplate: DEFAULT_SETTINGS_PREFERENCES.downloadPathTemplate,
      autoDownloadMatchedResources: DEFAULT_SETTINGS_PREFERENCES.autoDownloadMatchedResources,
      maxGlobalConcurrency: DEFAULT_SETTINGS_PREFERENCES.maxGlobalConcurrency,
      maxDomainConcurrency: DEFAULT_SETTINGS_PREFERENCES.maxDomainConcurrency,
      downloadCooldownIntervalMs: DEFAULT_SETTINGS_PREFERENCES.downloadCooldownIntervalMs,
      downloadSizeGuardEnabled: DEFAULT_SETTINGS_PREFERENCES.downloadSizeGuardEnabled,
      downloadMinSizeBytes: DEFAULT_SETTINGS_PREFERENCES.downloadMinSizeBytes,
      downloadMaxSizeBytes: DEFAULT_SETTINGS_PREFERENCES.downloadMaxSizeBytes,
      downloadPreflightHeadEnabled: DEFAULT_SETTINGS_PREFERENCES.downloadPreflightHeadEnabled,
      webhookEnabled: DEFAULT_SETTINGS_PREFERENCES.webhookEnabled,
      webhookEndpointUrl: DEFAULT_SETTINGS_PREFERENCES.webhookEndpointUrl,
      webhookSecretKey: DEFAULT_SETTINGS_PREFERENCES.webhookSecretKey,
      webhookIncludeGlobs: DEFAULT_SETTINGS_PREFERENCES.webhookIncludeGlobs,
      webhookExcludeGlobs: DEFAULT_SETTINGS_PREFERENCES.webhookExcludeGlobs,
      webhookMaxConcurrency: DEFAULT_SETTINGS_PREFERENCES.webhookMaxConcurrency,
      webhookCooldownMs: DEFAULT_SETTINGS_PREFERENCES.webhookCooldownMs,
      webhookPayloadMode: DEFAULT_SETTINGS_PREFERENCES.webhookPayloadMode,
    } as SettingsPreferences);
  } catch {
    return undefined;
  }
}

export function watchRetentionPolicyFromSettings(preferences: SettingsPreferences): WatchRetentionPolicy {
  return Object.freeze({
    maxAgeDays: preferences.historyRetentionDays,
    maxTerminalSessions: preferences.historyRetentionSessions,
  });
}

export function requireSettingsClearScope(value: unknown): SettingsClearScope {
  if (value !== 'history' && value !== 'all_local_data') throw new TypeError('Settings Clear scope is invalid');
  return value;
}

function requireCount(value: unknown, label: string): number {
  if (!Number.isSafeInteger(value) || (value as number) < 0) throw new TypeError(`${label} must be a non-negative safe integer`);
  return value as number;
}

export function requireSettingsDataCounts(value: unknown): SettingsDataCounts {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['definitions', 'watchSessions', 'resourceObservations', 'pageFieldSnapshots'], 'Settings data counts');
  return freezeJsonValue({
    definitions: requireCount(record.definitions, 'Definitions count'),
    watchSessions: requireCount(record.watchSessions, 'Watch sessions count'),
    resourceObservations: requireCount(record.resourceObservations, 'Resource observations count'),
    pageFieldSnapshots: requireCount(record.pageFieldSnapshots, 'Page Field snapshots count'),
  });
}

function requireSettingsRetentionPolicy(value: unknown): SettingsRetentionPolicy {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, [
    'mode',
    'automaticRetention',
    'pressureBehavior',
    'historyScope',
    'allLocalDataAdds',
    'maxAgeDays',
    'maxTerminalSessions',
    'maintenance',
  ], 'Settings retention policy');
  if (record.mode !== 'bounded_terminal_history' || record.automaticRetention !== 'enabled' || record.pressureBehavior !== 'configured_terminal_history_only') {
    throw new TypeError('Settings retention policy is unsupported');
  }
  const historyScope = ['watchSessions', 'resourceObservations', 'pageFieldSnapshots', 'watchLifecycle'] as const;
  const allLocalDataAdds = ['definitions', 'preferences'] as const;
  if (JSON.stringify(record.historyScope) !== JSON.stringify(historyScope)) throw new TypeError('Settings history retention scope is invalid');
  if (JSON.stringify(record.allLocalDataAdds) !== JSON.stringify(allLocalDataAdds)) throw new TypeError('Settings all-local-data retention scope is invalid');
  return freezeJsonValue({
    mode: 'bounded_terminal_history',
    automaticRetention: 'enabled',
    pressureBehavior: 'configured_terminal_history_only',
    historyScope,
    allLocalDataAdds,
    maxAgeDays: requireRetentionDays(record.maxAgeDays),
    maxTerminalSessions: requireRetentionSessions(record.maxTerminalSessions),
    maintenance: requireRetentionMaintenanceState(record.maintenance),
  });
}

export function requireSettingsSnapshot(value: unknown): SettingsSnapshot {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['schemaVersion', 'preferences', 'retention', 'privacy', 'diagnostics'], 'Settings snapshot');
  if (record.schemaVersion !== SETTINGS_SCHEMA_VERSION) throw new TypeError('Settings snapshot schema version is unsupported');

  const privacy = requireJsonObject(record.privacy ?? null);
  requireOnlyKeys(privacy, ['durableAuthority', 'preferencesAuthority', 'syncStorageUsed', 'externalTelemetry', 'diagnosticsPayloadPolicy', 'rawHeadersCookiesBodiesRetained'], 'Settings privacy summary');
  if (
    privacy.durableAuthority !== PRIVACY_SUMMARY.durableAuthority
    || privacy.preferencesAuthority !== PRIVACY_SUMMARY.preferencesAuthority
    || privacy.syncStorageUsed !== false
    || privacy.externalTelemetry !== false
    || privacy.diagnosticsPayloadPolicy !== PRIVACY_SUMMARY.diagnosticsPayloadPolicy
    || privacy.rawHeadersCookiesBodiesRetained !== false
  ) throw new TypeError('Settings privacy summary is invalid');

  const diagnostics = requireJsonObject(record.diagnostics ?? null);
  requireOnlyKeys(diagnostics, ['databaseName', 'physicalDatabaseVersion', 'logicalDatabaseVersion', 'migrationStatus', 'migrationCurrentVersion', 'migrationTargetVersion', 'counts', 'storage'], 'Settings diagnostics');
  if (diagnostics.databaseName !== CRSNIFFER_DATABASE_NAME) throw new TypeError('Settings database name is invalid');
  if (diagnostics.physicalDatabaseVersion !== CRSNIFFER_DATABASE_VERSION) throw new TypeError('Settings physical database version is invalid');
  if (diagnostics.logicalDatabaseVersion !== LOGICAL_DATABASE_VERSION) throw new TypeError('Settings logical database version is invalid');
  if (diagnostics.migrationStatus !== 'idle' && diagnostics.migrationStatus !== 'running' && diagnostics.migrationStatus !== 'failed') throw new TypeError('Settings migration status is invalid');

  return freezeJsonValue({
    schemaVersion: SETTINGS_SCHEMA_VERSION,
    preferences: requireSettingsPreferences(record.preferences),
    retention: requireSettingsRetentionPolicy(record.retention),
    privacy: PRIVACY_SUMMARY,
    diagnostics: {
      databaseName: CRSNIFFER_DATABASE_NAME,
      physicalDatabaseVersion: CRSNIFFER_DATABASE_VERSION,
      logicalDatabaseVersion: LOGICAL_DATABASE_VERSION,
      migrationStatus: diagnostics.migrationStatus,
      migrationCurrentVersion: requireCount(diagnostics.migrationCurrentVersion, 'Migration current version'),
      migrationTargetVersion: requireCount(diagnostics.migrationTargetVersion, 'Migration target version'),
      counts: requireSettingsDataCounts(diagnostics.counts),
      storage: requireStorageQuotaSnapshot(diagnostics.storage),
    },
  });
}

export function requireSettingsClearSummary(value: unknown): SettingsClearSummary {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['scope', 'before', 'after'], 'Settings Clear summary');
  return freezeJsonValue({
    scope: requireSettingsClearScope(record.scope),
    before: requireSettingsDataCounts(record.before),
    after: requireSettingsDataCounts(record.after),
  });
}

export class SettingsService {
  readonly #repositories: SettingsRepositorySet;
  readonly #preferences: JsonStorageTier;
  readonly #sessionState: SettingsSessionStatePort;
  readonly #pendingObservations: SettingsPendingObservationPort;
  readonly #lifecycle: WatchLifecycleRepository;
  readonly #watch: Pick<WatchController, 'status'>;
  readonly #catalog: DefinitionCatalog;
  readonly #retention: SettingsRetentionPort | undefined;
  readonly #quota: SettingsQuotaPort | undefined;
  readonly #now: () => IsoTimestamp;

  constructor(options: SettingsServiceOptions) {
    this.#repositories = options.repositories;
    this.#preferences = options.preferences;
    this.#sessionState = options.sessionState;
    this.#pendingObservations = options.pendingObservations;
    this.#lifecycle = options.lifecycle;
    this.#watch = options.watch;
    this.#catalog = options.catalog;
    this.#retention = options.retention;
    this.#quota = options.quota;
    this.#now = options.now ?? (() => requireIsoTimestamp(new Date().toISOString()));
  }

  async preferences(): Promise<SettingsPreferences> {
    const stored = await this.#preferences.get(SETTINGS_PREFERENCES_STORAGE_KEY);
    if (stored === undefined) return DEFAULT_SETTINGS_PREFERENCES;
    try {
      return requireSettingsPreferences(stored);
    } catch {
      const migrated = migrateLegacySettingsPreferences(stored);
      if (migrated === undefined) throw new TypeError('Stored Settings preferences are unsupported');
      await this.#preferences.set(SETTINGS_PREFERENCES_STORAGE_KEY, migrated);
      return migrated;
    }
  }

  async savePreferences(value: unknown): Promise<SettingsSnapshot> {
    const preferences = requireSettingsPreferences(value);
    await this.#preferences.set(SETTINGS_PREFERENCES_STORAGE_KEY, preferences);
    if (this.#retention !== undefined) {
      await this.#retention.enforce(watchRetentionPolicyFromSettings(preferences), 'policy_changed');
    }
    return this.snapshot();
  }

  async maintain(): Promise<SettingsSnapshot> {
    if ((await this.#watch.status()).state === 'watching') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'Stop Watch before running retention maintenance');
    }
    const preferences = await this.preferences();
    await this.#retention?.enforce(watchRetentionPolicyFromSettings(preferences), 'manual');
    return this.snapshot();
  }

  async counts(): Promise<SettingsDataCounts> {
    const [definitions, watchSessions, resourceObservations, pageFieldSnapshots] = await Promise.all([
      this.#repositories.definitions.count(),
      this.#repositories.watchSessions.count(),
      this.#repositories.resourceObservations.count(),
      this.#repositories.pageFieldSnapshots.count(),
    ]);
    return freezeJsonValue({ definitions, watchSessions, resourceObservations, pageFieldSnapshots });
  }

  async #retentionState(): Promise<RetentionMaintenanceState> {
    if (this.#retention !== undefined) return this.#retention.state();
    const record = await this.#repositories.meta.get(META_KEYS.retentionState);
    if (record === undefined) throw new TypeError('Retention maintenance metadata is missing');
    return requireRetentionMaintenanceState(record.value);
  }

  async snapshot(): Promise<SettingsSnapshot> {
    const [preferences, counts, migration, maintenance, storage] = await Promise.all([
      this.preferences(),
      this.counts(),
      readLogicalMigrationState(this.#repositories.meta),
      this.#retentionState(),
      this.#quota?.snapshot() ?? Promise.resolve({ level: 'unknown', approximate: true } as StorageQuotaSnapshot),
    ]);
    const snapshot: SettingsSnapshot = {
      schemaVersion: SETTINGS_SCHEMA_VERSION,
      preferences,
      retention: {
        mode: 'bounded_terminal_history',
        automaticRetention: 'enabled',
        pressureBehavior: 'configured_terminal_history_only',
        historyScope: ['watchSessions', 'resourceObservations', 'pageFieldSnapshots', 'watchLifecycle'],
        allLocalDataAdds: ['definitions', 'preferences'],
        maxAgeDays: preferences.historyRetentionDays,
        maxTerminalSessions: preferences.historyRetentionSessions,
        maintenance,
      },
      privacy: PRIVACY_SUMMARY,
      diagnostics: {
        databaseName: CRSNIFFER_DATABASE_NAME,
        physicalDatabaseVersion: CRSNIFFER_DATABASE_VERSION,
        logicalDatabaseVersion: LOGICAL_DATABASE_VERSION,
        migrationStatus: migration.status,
        migrationCurrentVersion: migration.currentVersion,
        migrationTargetVersion: migration.targetVersion,
        counts,
        storage: requireStorageQuotaSnapshot(storage),
      },
    };
    return freezeJsonValue(snapshot);
  }

  async clear(scopeValue: unknown): Promise<{ readonly settings: SettingsSnapshot; readonly clear: SettingsClearSummary }> {
    const scope = requireSettingsClearScope(scopeValue);
    if ((await this.#watch.status()).state === 'watching') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'Stop Watch before clearing local data');
    }
    const before = await this.counts();
    await Promise.all([
      this.#repositories.resourceObservations.clear(),
      this.#repositories.pageFieldSnapshots.clear(),
      this.#repositories.watchSessions.clear(),
    ]);
    await this.#lifecycle.clear();
    await Promise.all([
      this.#sessionState.clearNamespace(),
      this.#pendingObservations.clear(),
    ]);

    if (scope === 'all_local_data') {
      await this.#repositories.definitions.clear();
      await this.#preferences.remove(SETTINGS_PREFERENCES_STORAGE_KEY);
      await ensureDefaultWatchDefinition(this.#catalog, this.#now());
    }

    const after = await this.counts();
    return freezeJsonValue({
      settings: await this.snapshot(),
      clear: { scope, before, after },
    });
  }
}
</file>

<file path="entrypoints/sidepanel/style.css">
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

:root {
  color-scheme: light dark;
  font-family: "Plus Jakarta Sans", "Google Sans", Roboto, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  /* Material 3 Chrome Native Settings Tonal Palette (Matching crpackagizer & Chrome Native) */
  --bg: light-dark(#f8f9fa, #202124);
  --surface: light-dark(#ffffff, #292a2d);
  --surface-soft: light-dark(#f1f3f4, #35363a);
  --surface-container-high: light-dark(#e8eaed, #3c4043);
  --text: light-dark(#202124, #e8eaed);
  --muted: light-dark(#5f6368, #9aa0a6);
  --border: light-dark(#dadce0, #3c4043);
  --border-subtle: light-dark(rgba(60, 64, 67, 0.12), rgba(255, 255, 255, 0.10));
  --border-strong: light-dark(#bdc1c6, #5f6368);

  --accent: light-dark(#1a73e8, #8ab4f8);
  --accent-strong: light-dark(#1557b0, #aecbfa);
  --accent-container: light-dark(#e8f0fe, #243859);
  --on-accent-container: light-dark(#174ea6, #d2e3fc);

  --danger: light-dark(#d93025, #f2b8b5);
  --danger-container: light-dark(#fce8e6, rgba(242, 184, 181, 0.14));
  --on-danger-container: light-dark(#c5221f, #f2b8b5);

  --success: light-dark(#1e8e3e, #81c995);
  --success-container: light-dark(#e6f4ea, rgba(129, 201, 149, 0.14));
  --on-success-container: light-dark(#137333, #81c995);

  --warning: light-dark(#e37400, #fdd663);
  --warning-container: light-dark(#fef7e0, rgba(253, 214, 99, 0.14));
  --on-warning-container: light-dark(#b06000, #fdd663);

  /* System theme compatibility aliases */
  --cr-bg: var(--bg);
  --cr-text: var(--text);
  --cr-muted: var(--muted);
  --cr-border: var(--border);
  --cr-border-strong: var(--border-strong);
  --cr-border-subtle: var(--border-subtle);
  --cr-surface: var(--surface);
  --cr-surface-subtle: var(--surface-soft);
  --cr-surface-hover: var(--surface-container-high);
  --cr-accent-surface: var(--accent-container);
  --cr-accent-container: var(--accent-container);
  --cr-on-accent-container: var(--on-accent-container);
  --cr-focus: var(--accent);

  /* Spacing Scale Tokens */
  --space-2xs: 4px;
  --space-xs: 8px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 20px;
  --space-xl: 24px;

  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

html, body, main {
  margin: 0;
  min-height: 100%;
  min-width: 0;
  max-width: 100%;
}

body {
  min-width: 0;
  overflow-x: hidden;
  background: var(--bg);
  color: var(--text);
  font-size: 13.5px;
  line-height: 1.55;
  letter-spacing: -0.006em;
}

button {
  font: inherit;
  color-scheme: inherit;
  min-height: 2.5rem;
  border-radius: 999px;
  padding: 0.5rem 1.1rem;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--accent);
  cursor: pointer;
  box-sizing: border-box;
  white-space: nowrap;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

button:hover {
  background: var(--surface-soft);
  border-color: var(--accent);
}

button.primary,
button[type="submit"] {
  border: none;
  background: var(--accent);
  color: light-dark(#ffffff, #041e49);
  box-shadow: 0 1px 3px light-dark(rgba(26, 115, 232, 0.25), rgba(0, 0, 0, 0.3));
}

button.primary:hover,
button[type="submit"]:hover {
  background: var(--accent-strong);
  box-shadow: 0 2px 5px light-dark(rgba(26, 115, 232, 0.35), rgba(0, 0, 0, 0.4));
}

input,
select,
textarea {
  font: inherit;
  color-scheme: inherit;
}

code, kbd, samp, pre {
  font-family: var(--font-mono);
}

input[type="checkbox"],
input[type="radio"],
progress {
  accent-color: var(--accent);
}

::selection {
  background: var(--accent);
  color: light-dark(#ffffff, #041e49);
}

button,
select,
input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]),
summary {
  min-height: 2.75rem;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
summary:focus-visible,
.resource-scroller:focus-visible {
  outline: 3px solid var(--cr-focus);
  outline-offset: 2px;
  scroll-margin-block: 1rem;
}

button,
summary,
select,
input[type="checkbox"] {
  cursor: pointer;
}

button:disabled,
fieldset:disabled,
select:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.shell > *,
.watch-workspace > *,
.rules-workspace > *,
.settings-workspace > *,
fieldset,
details {
  min-width: 0;
}

button,
input,
select,
textarea,
summary {
  max-width: 100%;
}

/* Material 3 App Shell & Header */
.shell, .app-shell {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1rem;
  max-width: 100%;
  min-height: 100vh;
  background: var(--bg);
  container-type: inline-size;
  container-name: app-shell;
}

.shell__header, .product-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 4px 2px;
}

.product-mark {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: light-dark(#ffffff, #041e49);
  font-weight: 700;
  font-size: 17px;
  box-shadow: 0 2px 5px light-dark(rgba(26, 115, 232, 0.25), rgba(0, 0, 0, 0.4));
}

.eyebrow,
.shell__header h1,
.empty-state h2,
.empty-state p,
.watch-card h2,
.watch-card p,
.scope-card p,
.effective-summary p,
.permission-row p,
.degraded-state p {
  margin: 0;
}

.eyebrow {
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.shell__header h1 {
  font-size: 16.5px;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}

.version, .migration-badge {
  white-space: nowrap;
  border: 1px solid var(--border-subtle);
  border-radius: 999px;
  padding: 4px 10px;
  background: var(--accent-container);
  color: var(--on-accent-container);
  font-size: 11.5px;
  font-weight: 600;
}

.control-status {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.8rem;
  color: var(--muted);
}

/* Material 3 Segmented Workspace Tabs */
.tabs, .workspace-tabs {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--border-subtle);
  border-radius: 24px;
  background: var(--surface-soft);
  width: 100%;
}

.tabs button, .workspace-tab {
  flex: 1 1 0px;
  min-width: 0;
  min-height: 40px;
  padding: 8px 10px;
  border: 0;
  border-radius: 20px;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
  transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

.tabs button span, .workspace-tab span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tabs button:hover, .workspace-tab:hover {
  color: var(--text);
  background: color-mix(in srgb, var(--surface) 60%, transparent);
}

.tabs button[aria-selected="true"], .workspace-tab.active {
  color: var(--accent);
  background: var(--surface);
  box-shadow: 0 1px 3px light-dark(rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.35));
  font-weight: 600;
  text-decoration: none;
}

/* Material 3 Surface Containers & Cards */
.watch-workspace, .rules-workspace, .settings-workspace, .context-workspace {
  display: grid;
  gap: 1.25rem;
  min-width: 0;
}

.watch-card,
.empty-state,
.context-card,
.placeholder-surface {
  display: grid;
  gap: 1.25rem;
  padding: 1.25rem;
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 1px 3px light-dark(rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.2));
  min-width: 0;
}

.empty-state p,
.watch-card p,
.status-grid {
  max-width: 65ch;
  line-height: 1.55;
  color: var(--muted);
}

.actions,
.permission-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 0.65rem;
  margin-block: 0.25rem;
}

summary.watch-card__heading {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  width: 100%;
  cursor: pointer;
  user-select: none;
  list-style: none;
}

summary.watch-card__heading > :first-child {
  flex: 1 1 auto;
  min-width: 0;
  margin-inline-end: auto;
}

summary.watch-card__heading > .state-badge,
summary.watch-card__heading > .state-pill,
summary.watch-card__heading > .draft-state {
  margin-inline-start: auto;
  flex-shrink: 0;
}

summary.watch-card__heading::-webkit-details-marker {
  display: none;
}

details.watch-card > summary.watch-card__heading::after {
  content: '›';
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--muted);
  transition: transform 0.2s ease;
  margin-inline-start: 0.75rem;
  line-height: 1;
  flex-shrink: 0;
}

details.watch-card[open] > summary.watch-card__heading::after {
  transform: rotate(90deg);
}

/* Explicit vertical spacing for slotted elements inside native details elements */
details.watch-card > summary.watch-card__heading {
  margin-bottom: 0.75rem;
}

details.watch-card > summary.watch-card__heading + *:not(summary) {
  margin-top: 0;
}

details.watch-card > *:not(summary) + *:not(summary) {
  margin-top: 1.1rem;
}

.state-badge, .state-pill, .draft-state {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 24px;
  border-radius: 999px;
  padding: 3px 10px;
  background: var(--accent-container);
  color: var(--on-accent-container);
  border: 1px solid var(--border-subtle);
  font-size: 11.5px;
  font-weight: 600;
  white-space: nowrap;
}

.shell-state-badge[data-state="loading"],
.shell-state-badge[data-state="reconnecting"] {
  border-style: dashed;
}
.shell-state-badge[data-state="error"],
.shell-state-badge[data-state="degraded"],
.shell-state-badge[data-state="stale"] {
  border-color: var(--danger);
  color: var(--danger);
  background: var(--danger-container);
}
.shell-state-badge[data-state="live"]::before {
  content: "●";
  margin-inline-end: 0.35rem;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
  gap: 0.75rem;
  margin: 0;
}

.status-grid div {
  display: grid;
  gap: 0.15rem;
  min-width: 0;
}

.status-grid dd {
  margin: 0;
  overflow-wrap: anywhere;
  color: var(--text);
}

.status-grid dt,
.field-label,
.field-stack > label,
.resource-presets legend {
  font-weight: 650;
  color: var(--text);
}

label .supporting,
.field-label .supporting {
  font-weight: 400;
  font-size: 0.75rem;
  margin-inline-start: 4px;
  color: var(--muted);
}

.supporting,
.status-grid dt,
.check-row small {
  font-size: 0.75rem;
  line-height: 1.45;
  color: var(--muted);
}

/* Material 3 Buttons */
.actions {
  justify-content: flex-start;
  gap: 8px;
}

.actions button,
.field-with-action button,
.primary-action,
.secondary-action,
.quiet-action,
.danger-action {
  min-height: 2.6rem;
  border-radius: 1.3rem;
  padding: 0.55rem 1.15rem;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.actions button:not(.secondary):not(.quiet-action):not(.danger-action),
.primary-action {
  border: none;
  background: var(--accent);
  color: light-dark(#ffffff, #041e49);
  box-shadow: 0 1px 3px light-dark(rgba(26, 115, 232, 0.25), rgba(0, 0, 0, 0.3));
}

.actions button:not(.secondary):not(.quiet-action):not(.danger-action):hover,
.primary-action:hover {
  background: var(--accent-strong);
  box-shadow: 0 2px 5px light-dark(rgba(26, 115, 232, 0.35), rgba(0, 0, 0, 0.4));
}

.actions .secondary,
.field-with-action .secondary,
.secondary-action {
  background: var(--surface);
  color: var(--accent);
  border: 1px solid var(--border);
  border-radius: 1.3rem;
}

.actions .secondary:hover,
.field-with-action .secondary:hover,
.secondary-action:hover {
  background: var(--surface-soft);
  border-color: var(--accent);
}

.quiet-action {
  border: 1px solid transparent;
  background: transparent;
  color: var(--accent);
}

.quiet-action:hover {
  background: var(--accent-container);
}

.danger-action {
  border: 1px solid var(--danger);
  background: var(--danger-container);
  color: var(--on-danger-container);
  font-weight: 700;
}

.danger-action:hover {
  background: color-mix(in srgb, var(--danger-container) 80%, var(--danger));
}

.compact-actions {
  margin-inline-start: auto;
}

.scope-card,
.effective-summary,
.degraded-state {
  display: grid;
  gap: 0.5rem;
  padding: 1rem 1.1rem;
  border-radius: 14px;
  border: 1px solid var(--border-subtle);
  border-inline-start: 0.3rem solid var(--accent);
  background: var(--surface-soft);
  margin-block: 0.35rem;
}

.scope-card p,
.effective-summary p,
.degraded-state p {
  margin: 0;
}

.scope-card strong {
  font-size: 13.5px;
  font-weight: 650;
  color: var(--text);
}

.degraded-state {
  gap: 0.5rem;
  border-inline-start-color: var(--danger);
  background: var(--danger-container);
  color: var(--on-danger-container);
}

.permission-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm, 12px);
  padding-top: var(--space-2xs, 4px);
  margin-block: 0.25rem;
}

.permission-row > div:first-child {
  display: grid;
  gap: 4px;
}

.advanced-filters {
  display: grid;
  gap: 0.85rem;
  padding: 1rem 1.1rem;
  border-radius: 14px;
  border: 1px solid var(--border-subtle);
  background: var(--surface-soft);
  margin-block: 0.35rem;
}

.technical-trace {
  display: grid;
  gap: 0.6rem;
  margin-top: 0.5rem;
  margin-block: 0.35rem;
  padding: 1rem 1.1rem;
  border-radius: 14px;
  background: var(--surface-soft);
  border: 1px solid var(--border-subtle);
}

.technical-trace p {
  margin: 0;
}

.technical-trace pre {
  margin: 0;
  margin-top: 0.35rem;
  padding: 0.75rem 1rem;
  border-radius: 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 11.5px;
  line-height: 1.5;
  overflow-x: auto;
}

/* Material 3 Form Inputs */
.field-stack {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.field-stack input:not([type="checkbox"]):not([type="radio"]),
.field-stack select,
.field-stack textarea,
.field-with-action input:not([type="checkbox"]):not([type="radio"]),
.field-with-action select,
.field-group input:not([type="checkbox"]):not([type="radio"]),
.field-group select,
.field-group textarea,
input[type="text"],
input[type="url"],
input[type="number"],
input[type="password"],
input[type="search"],
input[type="email"],
input[type="tel"] {
  width: 100%;
  min-width: 0;
  min-height: 42px;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 9px 12px;
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-size: 13px;
}

.field-stack input:not([type="checkbox"]):not([type="radio"]):focus-visible,
.field-stack select:focus-visible,
.field-stack textarea:focus-visible,
.field-with-action input:not([type="checkbox"]):not([type="radio"]):focus-visible,
.field-with-action select:focus-visible,
.field-group input:not([type="checkbox"]):not([type="radio"]):focus-visible,
.field-group select:focus-visible,
.field-group textarea:focus-visible,
input[type="text"]:focus-visible,
input[type="url"]:focus-visible,
input[type="number"]:focus-visible,
input[type="password"]:focus-visible,
input[type="search"]:focus-visible,
input[type="email"]:focus-visible,
input[type="tel"]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px light-dark(rgba(26, 115, 232, 0.2), rgba(138, 180, 248, 0.2));
}

.field-stack textarea {
  resize: vertical;
  line-height: 1.5;
}

.field-with-action {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.5rem;
  align-items: stretch;
}

.resource-presets {
  display: grid;
  gap: 0.55rem;
  margin: 0;
  padding: 0.8rem;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
}

.check-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.65rem;
  align-items: start;
  min-height: 2.75rem;
  padding-block: 0.3rem;
}

.check-row input {
  width: 1.5rem;
  height: 1.5rem;
  margin-top: 0.15rem;
}

.preset-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2xs, 4px);
  margin-top: var(--space-2xs, 4px);
}

.preset-button {
  min-height: 26px !important;
  height: 26px;
  border-radius: 999px !important;
  padding: 2px 9px !important;
  font-size: 11.5px !important;
  font-weight: 500 !important;
  border: 1px solid var(--border) !important;
  background: var(--surface) !important;
  color: var(--accent) !important;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.preset-button:hover:not(:disabled) {
  background: var(--surface-soft) !important;
  border-color: var(--accent) !important;
}

.preset-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.field-grid,
.editor-grid,
.settings-grid,
.preview-input-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.1rem;
  min-width: 0;
  margin-block: 0.35rem;
}

/* Material 3 Toggle Switch */
.switch-control {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: auto auto;
  gap: 10px;
  align-items: center;
  cursor: pointer;
}
.switch-control input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.switch-control span {
  width: 48px;
  height: 28px;
  position: relative;
  border-radius: 999px;
  background: var(--surface-container-high);
  border: 2px solid var(--border);
  transition: background .2s ease, border-color .2s ease;
}
.switch-control span::after {
  content: '';
  position: absolute;
  width: 20px;
  height: 20px;
  left: 2px;
  top: 2px;
  border-radius: 50%;
  background: var(--muted);
  transition: transform .2s cubic-bezier(0.2, 0, 0, 1), background-color .2s ease;
}
.switch-control input:checked + span {
  background: var(--accent);
  border-color: var(--accent);
}
.switch-control input:checked + span::after {
  transform: translateX(20px);
  background: light-dark(#ffffff, #041e49);
}

.advanced-filters {
  border-block: 1px solid var(--border-subtle);
  padding-block: 0.25rem 0.8rem;
}

.advanced-filters summary {
  display: flex;
  align-items: center;
  font-weight: 650;
  color: var(--text);
}

.advanced-filters[open] {
  display: grid;
  gap: 0.8rem;
}

.effective-summary.has-error,
.inline-error {
  font-weight: 600;
  color: var(--danger);
}

.inline-error,
.inline-warning {
  overflow-wrap: anywhere;
}

.inline-warning {
  font-size: 0.9rem;
  color: var(--warning);
}

.notice {
  margin: 0;
  padding: 0.65rem 0.75rem;
  border-radius: 12px;
  border-inline-start: 0.25rem solid var(--accent);
  background: var(--surface-soft);
  line-height: 1.45;
}

.quiet-notice {
  font-size: 0.9rem;
}

.break-anywhere,
code {
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* Resource History Scroller */
.resource-filters {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(7rem, 1fr) minmax(8rem, 1fr) auto;
  gap: 0.65rem;
  align-items: end;
}

.resource-scroller {
  position: relative;
  overflow: auto;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  min-height: 12rem;
  max-height: 24rem;
  contain: strict;
  background: var(--surface);
  box-shadow: 0 1px 3px light-dark(rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.2));
}

.resource-virtual-space {
  position: relative;
  width: 100%;
}

.resource-window {
  position: absolute;
  inset: 0 0 auto;
}

.batch-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: var(--surface-soft);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  margin-block-end: 0.5rem;
  font-size: 0.85rem;
  min-height: 40px;
}

.batch-toolbar__left {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.batch-toolbar__select-all {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  cursor: pointer;
  font-weight: 600;
  user-select: none;
}

.batch-toolbar__actions {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.compact-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.3rem 0.65rem !important;
  font-size: 0.8rem !important;
  min-height: 1.85rem !important;
  border-radius: 999px !important;
  white-space: nowrap;
}

.resource-row-wrapper {
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr) 28px;
  align-items: center;
  gap: 0.65rem;
  padding: 0.6rem 0.8rem;
  border-bottom: 1px solid var(--border-subtle);
  background: var(--surface);
  transition: background-color 0.12s ease;
  user-select: none;
}

.resource-row-wrapper:hover {
  background: var(--surface-soft);
}

.resource-row-wrapper.selected {
  background: var(--accent-container);
  color: var(--on-accent-container);
}

.resource-row-select {
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
  margin: 0;
}

.resource-row-select input[type="checkbox"] {
  width: 16px;
  height: 16px;
  margin: 0;
}

button.resource-row {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) !important;
  gap: 0.2rem !important;
  width: 100% !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: inherit !important;
  text-align: start !important;
  box-shadow: none !important;
  min-height: auto !important;
}

button.resource-row:hover {
  background: transparent !important;
  border-color: transparent !important;
}

.resource-row__main {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  min-width: 0;
  width: 100%;
}

.resource-row__main strong {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource-row-wrapper.selected .resource-row__main strong {
  color: var(--on-accent-container);
}

.resource-row__main .supporting {
  font-size: 0.78rem;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource-row-wrapper.selected .resource-row__main .supporting {
  color: color-mix(in srgb, var(--on-accent-container) 80%, transparent);
}

.resource-row-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  min-height: 28px !important;
  padding: 0 !important;
  border-radius: 50% !important;
  border: 1px solid var(--border-subtle);
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.resource-row-action-btn:hover {
  background: var(--accent) !important;
  border-color: var(--accent) !important;
  color: light-dark(#ffffff, #041e49) !important;
}

.resource-row-wrapper.selected .resource-row-action-btn {
  background: var(--surface);
  color: var(--text);
}

.resource-detail {
  display: grid;
  gap: 0.75rem;
  padding-block-start: 0.9rem;
  border-block-start: 1px solid var(--border-subtle);
}

.resource-detail h3,
.resource-detail p,
.compact-empty {
  margin: 0;
}

.compact-empty {
  padding: 0.8rem;
  color: var(--muted);
}

/* Rules & Editor Workspace */
.structured-section {
  display: grid;
  gap: 1rem;
  min-width: 0;
}

.structured-section h3 {
  margin: 0;
  color: var(--text);
}

.editor-grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(10rem, 1fr);
  gap: 0.75rem;
  align-items: start;
}

.structured-list {
  display: grid;
  gap: 0.65rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.structured-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.75rem;
  align-items: center;
  padding: 0.85rem;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  background: var(--surface);
  box-shadow: 0 1px 3px light-dark(rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.2));
  min-width: 0;
}

.structured-row__main {
  display: grid;
  gap: 0.2rem;
  min-width: 0;
}

.editor-row {
  align-items: end;
}

.row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  justify-content: flex-end;
}

.rule-condition-grid {
  display: grid;
  grid-template-columns: minmax(9rem, 1.25fr) minmax(9rem, 1fr) minmax(7rem, 0.75fr) minmax(9rem, 1fr);
  gap: 0.65rem;
  min-width: 0;
}

.rule-action-grid {
  display: grid;
  grid-template-columns: minmax(9rem, 1fr) minmax(10rem, 1.5fr);
  gap: 0.65rem;
  min-width: 0;
}

.token-group,
.technical-trace {
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  padding: 0.75rem;
  background: var(--surface);
}

.token-group > summary,
.technical-trace > summary {
  cursor: pointer;
  min-height: 2.75rem;
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-weight: 600;
  color: var(--text);
}

.token-list,
.trace-list,
.trace-sublist {
  list-style: none;
  margin: 0;
  padding: 0;
}

.token-list,
.trace-list {
  display: grid;
  gap: 0.65rem;
}

.token-row,
.trace-rule {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.75rem;
  align-items: start;
  padding: 0.7rem;
  border-block-start: 1px solid var(--border-subtle);
}

.token-row__main,
.trace-rule {
  min-width: 0;
}

.token-row__main {
  display: grid;
  gap: 0.25rem;
}

.token-row__heading {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.5rem;
  align-items: center;
}

.preview-input-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 0.75rem;
}

.preview-result,
.trace-rule,
.trace-sublist {
  display: grid;
  gap: 0.55rem;
}

.trace-sublist {
  padding-inline-start: 1rem;
}

.preview-outcome {
  padding: 0.85rem;
  border-radius: 12px;
  border-inline-start: 0.25rem solid var(--accent);
  background: var(--accent-container);
  color: var(--on-accent-container);
}

.editor-list-block,
.editor-list {
  display: grid;
  gap: 0.65rem;
  min-width: 0;
}

.editor-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.editor-list > .editor-row {
  display: grid;
  gap: 0.7rem;
  padding: 0.85rem;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  background: var(--surface);
  min-width: 0;
  align-items: stretch;
}

.editor-row__heading,
.field-prefix {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  min-width: 0;
}

.editor-row__heading {
  justify-content: space-between;
  flex-wrap: wrap;
}

.field-prefix > span {
  flex: 0 0 auto;
  font-family: var(--font-mono);
  color: var(--muted);
}

.field-prefix > input {
  flex: 1 1 auto;
  min-width: 0;
}

.field-span {
  grid-column: 1 / -1;
}

.compact-row {
  align-items: stretch;
}

.technical-trace pre {
  max-width: 100%;
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.settings-grid,
.clear-actions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
  gap: 0.75rem;
}

.clear-actions > div,
.clear-confirmation {
  display: grid;
}

.clear-confirmation {
  display: grid;
  gap: 0.55rem;
  padding: 0.85rem;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  background: var(--surface);
}

.rule-save-bar {
  position: sticky;
  bottom: 0;
  z-index: 2;
  margin: 12px -16px -18px;
  padding: 12px 16px 14px;
  border-top: 1px solid var(--border-subtle);
  background: light-dark(rgba(248, 249, 250, 0.92), rgba(32, 33, 36, 0.92));
  backdrop-filter: blur(12px);
}

.privacy-list {
  display: grid;
  gap: 0.5rem;
  margin: 0;
  padding-inline-start: 1.25rem;
  line-height: 1.45;
}

.resource-scroller.compact .resource-row {
  padding-block: 0.35rem;
}

/* Responsive Media Queries & Container Queries */
@media (max-width: 640px) {
  .resource-filters,
  .editor-grid,
  .rule-condition-grid,
  .rule-action-grid,
  .structured-row,
  .preview-input-grid,
  .token-row,
  .trace-rule {
    grid-template-columns: minmax(0, 1fr);
  }

  .resource-search {
    grid-column: 1 / -1;
  }

  .row-actions {
    justify-content: flex-start;
  }

  .field-span {
    grid-column: auto;
  }
}

@media (max-width: 360px) {
  .shell, .app-shell {
    padding: 0.75rem;
  }

  .shell__header,
  .permission-row,
  .watch-card__heading,
  .field-with-action,
  .resource-filters,
  .resource-row,
  .row-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .compact-actions {
    margin-inline-start: 0;
  }

  .actions button,
  .permission-row button,
  .field-with-action button,
  .row-actions button {
    width: 100%;
  }

  .resource-row__meta {
    white-space: normal;
  }
}

@media (max-width: 320px) {
  .shell, .app-shell { padding: 0.625rem; gap: 0.75rem; }
  .tabs,
  .workspace-tabs,
  .actions,
  .row-actions,
  .clear-actions,
  .settings-grid,
  .resource-filters,
  .editor-grid,
  .rule-condition-grid,
  .rule-action-grid,
  .preview-input-grid,
  .structured-row,
  .token-row,
  .trace-rule {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .actions button,
  .row-actions button,
  .clear-actions button { width: 100%; }
  .resource-row__main strong,
  .resource-row__main span { white-space: normal; overflow: visible; text-overflow: clip; }
}

@container app-shell (max-width: 380px) {
  .tabs, .workspace-tabs { gap: 2px; padding: 3px; }
  .tabs button, .workspace-tab { padding: 8px 4px; gap: 4px; font-size: 12px; }
}

@container app-shell (max-width: 310px) {
  .tabs button span, .workspace-tab span { display: none; }
  .tabs button, .workspace-tab { padding: 8px 4px; justify-content: center; }
}

@media (prefers-contrast: more) {
  :root {
    --border: var(--border-strong);
  }
}

.export-workspace {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.export-preview-summary {
  margin-top: 0.5rem;
  padding: 0.85rem 1rem;
  background: var(--surface-soft);
  border-radius: 8px;
  border: 1px solid var(--border);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

@media (forced-colors: active) {
  :root {
    --bg: Canvas;
    --surface: Canvas;
    --surface-soft: Canvas;
    --text: CanvasText;
    --muted: GrayText;
    --border: GrayText;
    --border-strong: CanvasText;
    --accent: Highlight;
  }

  .resource-row:hover,
  .resource-row.selected,
  .preview-outcome {
    color: HighlightText;
  }
}
