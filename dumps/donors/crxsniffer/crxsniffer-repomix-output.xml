#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import sys

sys.dont_write_bytecode = True
from pathlib import Path

from _manager_common import (
    current_iteration,
    next_id,
    parse_frontmatter,
    read_text,
    replace_frontmatter_scalar,
    slugify,
    utc_now,
    workspace_root,
    yaml_string,
)

ROOT = workspace_root(__file__)
AGENTS = ROOT / "agents"

RECORDS = {
    "adr": ("ADR", "adrs"),
    "audit": ("AUDIT", "audits"),
    "constraint": ("CONSTRAINT", "constraints"),
    "deferral": ("DEFERRAL", "deferrals"),
    "finding": ("FINDING", "findings"),
    "issue": ("ISSUE", "issues"),
    "matrix": ("MATRIX", "matrices"),
    "reference": ("REFERENCE", "references"),
    "roadmap": ("ROADMAP", "roadmaps"),
}


def record_files() -> list[Path]:
    return sorted((AGENTS / "records").glob("*/*.md"))


def validate() -> int:
    errors: list[str] = []
    seen: dict[str, Path] = {}
    reverse = {directory: (kind, prefix) for kind, (prefix, directory) in RECORDS.items()}
    for path in record_files():
        if path.name == "README.md":
            continue
        try:
            meta = parse_frontmatter(read_text(path))
        except Exception as exc:  # validation boundary
            errors.append(f"{path.relative_to(ROOT)}: {exc}")
            continue
        record_id = str(meta.get("record_id") or "")
        record_type = str(meta.get("record_type") or "")
        parent = path.parent.name
        if parent not in reverse:
            errors.append(f"{path.relative_to(ROOT)}: unknown record directory {parent}")
            continue
        expected_type, prefix = reverse[parent]
        if record_type != expected_type:
            errors.append(f"{path.relative_to(ROOT)}: record_type={record_type!r}, expected {expected_type!r}")
        if not record_id.startswith(prefix + "-"):
            errors.append(f"{path.relative_to(ROOT)}: record_id={record_id!r}, expected prefix {prefix}-")
        if record_id in seen:
            errors.append(f"duplicate {record_id}: {seen[record_id].relative_to(ROOT)} and {path.relative_to(ROOT)}")
        else:
            seen[record_id] = path
        if not isinstance(meta.get("revision"), int) or int(meta.get("revision") or 0) < 1:
            errors.append(f"{path.relative_to(ROOT)}: revision must be a positive integer")
        if not meta.get("status"):
            errors.append(f"{path.relative_to(ROOT)}: status is required")
        if record_type == "deferral" and meta.get("deferral.environment_only") is True:
            if meta.get("deferral.blocking") is not False:
                errors.append(f"{path.relative_to(ROOT)}: environment-only deferrals must be non-blocking")
            if meta.get("deferral.validation_status") != "deferred_environment":
                errors.append(f"{path.relative_to(ROOT)}: environment-only deferrals must use validation_status=deferred_environment")
    if errors:
        for error in errors:
            print(f"ERROR: {error}")
        return 1
    print(f"validated {len(seen)} managed record(s)")
    return 0


def render_record(kind: str, title: str, provenance: str | None, environment: bool = False, revisit_condition: str | None = None) -> tuple[Path, str]:
    prefix, directory = RECORDS[kind]
    files = record_files()
    record_id = next_id(prefix, files)
    slug = slugify(title)
    template = read_text(AGENTS / "templates" / f"{prefix}.md")
    now = utc_now()
    text = template.replace(f"{prefix}-XXXX", record_id).replace("replace-with-slug", slug)
    text = text.replace("YYYY-MM-DDTHH:MM:SSZ", now)
    text = replace_frontmatter_scalar(text, "title", yaml_string(title))
    text = re.sub(r"Replace With(?: [A-Za-z]+)* Title", title, text)
    provenance = provenance or current_iteration(ROOT)
    if provenance:
        try:
            text = replace_frontmatter_scalar(text, "provenance.created_from.type", "iteration")
            text = replace_frontmatter_scalar(text, "provenance.created_from.id", yaml_string(provenance))
        except KeyError:
            pass
    if kind == "deferral" and environment:
        text = replace_frontmatter_scalar(text, "deferral.kind", "environment")
        text = replace_frontmatter_scalar(text, "deferral.environment_only", "true")
        text = replace_frontmatter_scalar(text, "deferral.blocking", "false")
        text = replace_frontmatter_scalar(text, "deferral.validation_status", "deferred_environment")
    if kind == "deferral" and revisit_condition:
        text = replace_frontmatter_scalar(text, "revisit.condition", yaml_string(revisit_condition))
    path = AGENTS / "records" / directory / f"{record_id}--{slug}.md"
    return path, text


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage repository-governed records without maintaining hidden registry state.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("validate")
    list_parser = sub.add_parser("list")
    list_parser.add_argument("--type", choices=sorted(RECORDS))
    next_parser = sub.add_parser("next-id")
    next_parser.add_argument("type", choices=sorted(RECORDS))
    create_parser = sub.add_parser("create")
    create_parser.add_argument("type", choices=sorted(RECORDS))
    create_parser.add_argument("title")
    create_parser.add_argument("--provenance")
    create_parser.add_argument("--stdout", action="store_true")
    create_parser.add_argument("--environment", action="store_true", help="render a non-blocking environment deferral; valid only for type=deferral")
    create_parser.add_argument("--revisit-condition")
    args = parser.parse_args()

    if args.command == "validate":
        return validate()
    if args.command == "list":
        count = 0
        for path in record_files():
            if path.name == "README.md":
                continue
            meta = parse_frontmatter(read_text(path))
            if args.type and meta.get("record_type") != args.type:
                continue
            print(f"{meta.get('record_id')}\t{meta.get('status')}\t{path.relative_to(ROOT)}")
            count += 1
        return 0 if count >= 0 else 1
    if args.command == "next-id":
        prefix, _ = RECORDS[args.type]
        print(next_id(prefix, record_files()))
        return 0
    if args.command == "create":
        if args.environment and args.type != "deferral":
            print("ERROR: --environment is valid only for type=deferral", file=sys.stderr)
            return 2
        path, text = render_record(args.type, args.title, args.provenance, args.environment, args.revisit_condition)
        if args.stdout:
            sys.stdout.write(text)
            return 0
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists():
            print(f"ERROR: refusing to overwrite {path}", file=sys.stderr)
            return 2
        path.write_text(text, encoding="utf-8")
        print(path.relative_to(ROOT))
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
