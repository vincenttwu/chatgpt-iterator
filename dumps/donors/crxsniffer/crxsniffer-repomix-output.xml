<file path="src/observations/chrome-webrequest.ts">
import type { WatchStatusActive } from '../watch/types.ts';
import type { ObservationLifecycle } from './lifecycle.ts';
import type {
  WebRequestBaseDetails,
  WebRequestCompletedDetails,
  WebRequestErrorDetails,
  WebRequestHeadersReceivedDetails,
  WebRequestRedirectDetails,
} from './types.ts';

export interface ChromeWebRequestFilter {
  readonly urls: readonly string[];
  readonly tabId?: number;
}

export interface ChromeWebRequestEventLike<T> {
  addListener(listener: (details: T) => void, filter: ChromeWebRequestFilter, extraInfoSpec?: readonly string[]): void;
  removeListener(listener: (details: T) => void): void;
}

export interface ChromeWebRequestLike {
  readonly onBeforeRequest: ChromeWebRequestEventLike<WebRequestBaseDetails>;
  readonly onHeadersReceived: ChromeWebRequestEventLike<WebRequestHeadersReceivedDetails>;
  readonly onBeforeRedirect: ChromeWebRequestEventLike<WebRequestRedirectDetails>;
  readonly onCompleted: ChromeWebRequestEventLike<WebRequestCompletedDetails>;
  readonly onErrorOccurred: ChromeWebRequestEventLike<WebRequestErrorDetails>;
}

export interface ChromeWebRequestCaptureOptions {
  readonly webRequest: ChromeWebRequestLike;
  readonly lifecycle: ObservationLifecycle;
  readonly onError?: (error: unknown) => void | Promise<void>;
}

const WATCH_URLS = Object.freeze(['http://*/*', 'https://*/*'] as const);

export class ChromeWebRequestCapture {
  readonly #webRequest: ChromeWebRequestLike;
  readonly #lifecycle: ObservationLifecycle;
  readonly #onError: (error: unknown) => void | Promise<void>;
  readonly #queues = new Map<string, Promise<void>>();
  #tabId: number | undefined;

  readonly #beforeRequest = (details: WebRequestBaseDetails) => this.#enqueue(details.requestId, () => this.#lifecycle.beforeRequest(details));
  readonly #headersReceived = (details: WebRequestHeadersReceivedDetails) => this.#enqueue(details.requestId, () => this.#lifecycle.headersReceived(details));
  readonly #beforeRedirect = (details: WebRequestRedirectDetails) => this.#enqueue(details.requestId, () => this.#lifecycle.beforeRedirect(details));
  readonly #completed = (details: WebRequestCompletedDetails) => this.#enqueue(details.requestId, () => this.#lifecycle.completed(details));
  readonly #errorOccurred = (details: WebRequestErrorDetails) => this.#enqueue(details.requestId, () => this.#lifecycle.errorOccurred(details));

  constructor(options: ChromeWebRequestCaptureOptions) {
    this.#webRequest = options.webRequest;
    this.#lifecycle = options.lifecycle;
    this.#onError = options.onError ?? ((error) => console.error('crsniffer webRequest observation failed', error));
  }

  #enqueue(requestId: string, operation: () => Promise<void>): void {
    const previous = this.#queues.get(requestId) ?? Promise.resolve();
    const next = previous.then(operation, operation);
    this.#queues.set(requestId, next);
    void next.catch((error) => this.#onError(error)).finally(() => {
      if (this.#queues.get(requestId) === next) this.#queues.delete(requestId);
    });
  }

  #removeListeners(): void {
    if (this.#tabId === undefined) return;
    this.#webRequest.onBeforeRequest.removeListener(this.#beforeRequest);
    this.#webRequest.onHeadersReceived.removeListener(this.#headersReceived);
    this.#webRequest.onBeforeRedirect.removeListener(this.#beforeRedirect);
    this.#webRequest.onCompleted.removeListener(this.#completed);
    this.#webRequest.onErrorOccurred.removeListener(this.#errorOccurred);
    this.#tabId = undefined;
  }

  prepare(tabId: number): void {
    if (this.#tabId === tabId) return;
    this.#removeListeners();
    const filter: ChromeWebRequestFilter = { urls: WATCH_URLS, tabId };
    this.#webRequest.onBeforeRequest.addListener(this.#beforeRequest, filter);
    this.#webRequest.onHeadersReceived.addListener(this.#headersReceived, filter, ['responseHeaders']);
    this.#webRequest.onBeforeRedirect.addListener(this.#beforeRedirect, filter);
    this.#webRequest.onCompleted.addListener(this.#completed, filter);
    this.#webRequest.onErrorOccurred.addListener(this.#errorOccurred, filter);
    this.#tabId = tabId;
  }

  suspend(): void {
    this.#removeListeners();
  }

  async sync(active: WatchStatusActive | undefined): Promise<void> {
    if (active === undefined) {
      this.#removeListeners();
      await this.#lifecycle.discardNonTerminalPending();
      return;
    }
    this.prepare(active.tabId);
    await this.#lifecycle.resumeTerminalPending();
  }
}
</file>

