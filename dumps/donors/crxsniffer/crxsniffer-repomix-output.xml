import type { JsonObject, StableId } from '../core/index.ts';
import type { IsoTimestamp } from '../persistence/index.ts';
import type { ResourceKind } from './types.ts';

export const RESOURCE_HISTORY_SCHEMA_VERSION = 1 as const;
export const RESOURCE_HISTORY_DEFAULT_PAGE_SIZE = 40 as const;
export const RESOURCE_HISTORY_MAX_PAGE_SIZE = 100 as const;
export const RESOURCE_HISTORY_SCAN_LIMIT = 500 as const;
export const RESOURCE_HISTORY_SESSION_LIMIT = 20 as const;
export const RESOURCE_HISTORY_UI_BUFFER_LIMIT = 500 as const;

export type ResourceHistoryStatus = 'projected' | 'failed';
export type ResourceHistoryStatusFilter = 'all' | ResourceHistoryStatus;
export type ResourceHistoryKindFilter = 'all' | ResourceKind;

export interface ResourceHistoryCursor extends JsonObject {
  readonly observedAt: IsoTimestamp;
  readonly observationId: StableId<'resourceObservation'>;
}

export interface ResourceHistorySessionSummary extends JsonObject {
  readonly watchSessionId: StableId<'watchSession'>;
  readonly startedAt: IsoTimestamp;
  readonly setupName: string;
  readonly watchRevision: number;
}

export interface ResourceHistorySessionList extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_HISTORY_SCHEMA_VERSION;
  readonly items: readonly ResourceHistorySessionSummary[];
  readonly truncated: boolean;
}

export interface ResourceHistoryRow extends JsonObject {
  readonly observationId: StableId<'resourceObservation'>;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly observedAt: IsoTimestamp;
  readonly endedAt: IsoTimestamp;
  readonly canonicalUrl: string;
  readonly kind: ResourceKind;
  readonly status: ResourceHistoryStatus;
  readonly filename?: string;
  readonly group?: string;
  readonly responseStatusCode?: number;
  readonly responseMimeType?: string;
  readonly initiator?: string;
  readonly contentLength?: number;
  readonly tabTitle?: string;
  readonly userAgent?: string;
}

export interface ResourceHistoryQuery extends JsonObject {
  readonly watchSessionId: StableId<'watchSession'>;
  readonly limit: number;
  readonly cursor?: ResourceHistoryCursor;
  readonly searchText?: string;
  readonly kind?: ResourceHistoryKindFilter;
  readonly status?: ResourceHistoryStatusFilter;
}

export interface ResourceHistoryPage extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_HISTORY_SCHEMA_VERSION;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly items: readonly ResourceHistoryRow[];
  readonly scannedCount: number;
  readonly truncated: boolean;
  readonly nextCursor?: ResourceHistoryCursor;
}

export interface ResourceHistorySourceDetail extends JsonObject {
  readonly method: string;
  readonly requestType: string;
  readonly initialUrl: string;
  readonly finalUrl: string;
  readonly startedAt: IsoTimestamp;
  readonly endedAt: IsoTimestamp;
  readonly redirectCount: number;
  readonly terminal: 'completed' | 'error' | 'redirect_out_of_scope';
  readonly responseStatusCode?: number;
  readonly responseMimeType?: string;
  readonly fromCache?: boolean;
  readonly initiator?: string;
  readonly contentLength?: number;
  readonly tabTitle?: string;
  readonly userAgent?: string;
}

export interface ResourceHistoryEvaluationDetail extends JsonObject {
  readonly status: ResourceHistoryStatus;
  readonly kind: ResourceKind;
  readonly classificationReason: string;
  readonly matchedPresets: readonly ('images' | 'videos')[];
  readonly filename?: string;
  readonly group?: string;
  readonly comment?: string;
  readonly pageEnrichmentStatus: string;
  readonly evaluatedRuleCount: number;
  readonly appliedRuleCount: number;
  readonly failedRuleCount: number;
  readonly failureCode?: string;
}

export interface ResourceHistoryDetail extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_HISTORY_SCHEMA_VERSION;
  readonly observationId: StableId<'resourceObservation'>;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly observedAt: IsoTimestamp;
  readonly canonicalUrl: string;
  readonly source: ResourceHistorySourceDetail;
  readonly evaluation: ResourceHistoryEvaluationDetail;
}

export interface VirtualResourceWindow {
  readonly startIndex: number;
  readonly endIndex: number;
  readonly offsetTop: number;
  readonly totalHeight: number;
}
