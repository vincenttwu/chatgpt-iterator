class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();

  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }

  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('memory store requires id or key');
    this.values.set(key, structuredClone(value));
  }

  async delete(key: string): Promise<void> {
    this.values.delete(key);
  }

  async getAll(): Promise<readonly unknown[]> {
    return [...this.values.values()].map((value) => structuredClone(value));
  }
}

const IDS = {
  watch: createStableId('definition', () => '10000000-0000-4000-8000-000000000001'),
  filter: createStableId('definition', () => '10000000-0000-4000-8000-000000000002'),
  rule: createStableId('definition', () => '10000000-0000-4000-8000-000000000003'),
  disabledRule: createStableId('definition', () => '10000000-0000-4000-8000-000000000004'),
  template: createStableId('definition', () => '10000000-0000-4000-8000-000000000005'),
  mapping: createStableId('definition', () => '10000000-0000-4000-8000-000000000006'),
  unusedMapping: createStableId('definition', () => '10000000-0000-4000-8000-000000000007'),
  disabledMapping: createStableId('definition', () => '10000000-0000-4000-8000-000000000008'),
  session: createStableId('watchSession', () => '20000000-0000-4000-8000-000000000001'),
  session2: createStableId('watchSession', () => '20000000-0000-4000-8000-000000000002'),
  session3: createStableId('watchSession', () => '20000000-0000-4000-8000-000000000003'),
};

const T0 = '2026-08-19T13:00:00.000Z' as never;
const T1 = '2026-08-19T13:01:00.000Z' as never;

function repositories() {
  const definitionsMemory = new MemoryStore();
  const sessionsMemory = new MemoryStore();
  return {
    definitionsMemory,
    sessionsMemory,
    definitions: new JsonRecordRepository<DefinitionRecord>(
      PERSISTENCE_STORES.definitions,
      definitionsMemory,
      requireDefinitionRecord,
    ),
    sessions: new JsonRecordRepository<WatchSessionRecord>(
      PERSISTENCE_STORES.watchSessions,
      sessionsMemory,
      requireWatchSessionRecord,
    ),
  };
}

async function seedGraph() {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({ id: IDS.mapping, kind: 'pageFieldMapping', name: 'Episode', body: { field: 'episode' }, timestamp: T0 });
  await catalog.create({ id: IDS.unusedMapping, kind: 'pageFieldMapping', name: 'Unused', body: { field: 'unused' }, timestamp: T0 });
  await catalog.create({ id: IDS.disabledMapping, kind: 'pageFieldMapping', name: 'Disabled dependency', body: { field: 'disabled' }, timestamp: T0 });
  await catalog.create({
    id: IDS.template,
    kind: 'template',
    name: 'Destination',
    body: { text: '${field.episode}' },
    references: [{ id: IDS.mapping, kind: 'pageFieldMapping', expectedRevision: INITIAL_REVISION }],
    timestamp: T0,
  });
  await catalog.create({ id: IDS.filter, kind: 'resourceFilter', name: 'Video', body: { videos: true }, timestamp: T0 });
  await catalog.create({
    id: IDS.rule,
    kind: 'packagizerRule',
    name: 'Rule',
    body: { stopProcessing: false },
    references: [{ id: IDS.template, kind: 'template' }],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.disabledRule,
    kind: 'packagizerRule',
    name: 'Disabled rule',
    enabled: false,
    references: [{ id: IDS.disabledMapping, kind: 'pageFieldMapping' }],
    timestamp: T0,
  });
  await catalog.create({
    id: IDS.watch,
    kind: 'watch',
    name: 'Default Watch',
    body: { scope: 'activeTab' },
    references: [
      { id: IDS.filter, kind: 'resourceFilter' },
      { id: IDS.rule, kind: 'packagizerRule' },
      { id: IDS.disabledRule, kind: 'packagizerRule' },
    ],
    timestamp: T0,
  });
  return { ...repos, catalog, composer: new WatchSessionComposer(repos.definitions, repos.sessions) };
}

test('saved definitions keep stable identity while optimistic updates advance revisions', async () => {
  const { catalog } = await seedGraph();
  const before = await catalog.require(IDS.filter);
  const updated = await catalog.update(IDS.filter, before.revision, { body: { videos: false, images: true } }, T1);

  assert.equal(updated.id, before.id);
  assert.equal(updated.definitionKind, before.definitionKind);
  assert.equal(updated.revision, 2);
  assert.equal(updated.createdAt, before.createdAt);
  assert.equal(updated.updatedAt, T1);
  assert.deepEqual(updated.value.body, { videos: false, images: true });
  assert.equal(Object.isFrozen(updated), true);
  assert.equal(Object.isFrozen(updated.value.body), true);

  await assert.rejects(
    () => catalog.update(IDS.filter, before.revision, { name: 'stale write' }, T1),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.revisionConflict,
  );
});

test('WatchSession composition freezes exact revisions and only traverses dependencies of enabled definitions', async () => {
  const { composer } = await seedGraph();
  const session = await composer.compose({
    id: IDS.session,
    watchDefinitionId: IDS.watch,
    expectedWatchRevision: INITIAL_REVISION,
    timestamp: T0,
  });

  const frozenIds = session.value.definitions.map((definition) => definition.id);
  assert.deepEqual(frozenIds, [...frozenIds].sort());
  assert.equal(frozenIds.includes(IDS.watch), true);
  assert.equal(frozenIds.includes(IDS.filter), true);
  assert.equal(frozenIds.includes(IDS.rule), true);
  assert.equal(frozenIds.includes(IDS.template), true);
  assert.equal(frozenIds.includes(IDS.mapping), true);
  assert.equal(frozenIds.includes(IDS.disabledRule), true);
  assert.equal(frozenIds.includes(IDS.disabledMapping), false);
  assert.equal(frozenIds.includes(IDS.unusedMapping), false);
  assert.match(session.value.definitionSetDigest, /^sha256:[0-9a-f]{64}$/);
  assert.equal(Object.isFrozen(session.value.definitions), true);
});

test('WatchSession preview freezes the exact graph without persisting a session', async () => {
  const { composer, sessions } = await seedGraph();
  const preview = await composer.preview({
    id: IDS.session,
    watchDefinitionId: IDS.watch,
    expectedWatchRevision: INITIAL_REVISION,
    timestamp: T0,
  });

  assert.equal(await sessions.get(IDS.session), undefined);
  assert.equal(preview.value.watchDefinitionId, IDS.watch);
  assert.match(preview.value.definitionSetDigest, /^sha256:[0-9a-f]{64}$/);

  const persisted = await composer.compose({
    id: IDS.session,
    watchDefinitionId: IDS.watch,
    expectedWatchRevision: INITIAL_REVISION,
    timestamp: T0,
  });
  assert.deepEqual(persisted, preview);
  assert.deepEqual(await sessions.get(IDS.session), persisted);
});

test('later saved-definition edits do not reinterpret an immutable existing WatchSession', async () => {
  const { catalog, composer } = await seedGraph();
  const first = await composer.compose({ id: IDS.session, watchDefinitionId: IDS.watch, timestamp: T0 });
  const oldFilter = first.value.definitions.find((definition) => definition.id === IDS.filter);
  assert.equal(oldFilter?.revision, 1);

  await catalog.update(IDS.filter, INITIAL_REVISION, { body: { videos: false } }, T1);
  const second = await composer.compose({ id: IDS.session2, watchDefinitionId: IDS.watch, timestamp: T1 });
  const newFilter = second.value.definitions.find((definition) => definition.id === IDS.filter);

  assert.equal(oldFilter?.revision, 1);
  assert.deepEqual(oldFilter?.value.body, { videos: true });
  assert.equal(newFilter?.revision, 2);
  assert.deepEqual(newFilter?.value.body, { videos: false });
  assert.notEqual(first.value.definitionSetDigest, second.value.definitionSetDigest);

  await assert.rejects(
    () => composer.compose({ id: IDS.session, watchDefinitionId: IDS.watch, timestamp: T1 }),
    (error) => error instanceof DefinitionError && error.code === DEFINITION_ERROR_CODES.watchSessionExists,
  );
});

test('definition-set digests are canonical across object key insertion order', async () => {
  assert.equal(
    canonicalJson({ b: 2, a: { z: true, y: false } }),
    canonicalJson({ a: { y: false, z: true }, b: 2 }),
  );

  const left = await seedGraph();
  const right = await seedGraph();
  const first = await left.composer.compose({ id: IDS.session, watchDefinitionId: IDS.watch, timestamp: T0 });

  await right.catalog.update(
    IDS.filter,
    INITIAL_REVISION,
    { body: { images: false, videos: true } },
    T1,
  );
  await right.catalog.update(
    IDS.filter,
    2 as never,
    { body: { videos: true, images: false } },
    T1,
  );
  const second = await right.composer.compose({ id: IDS.session2, watchDefinitionId: IDS.watch, timestamp: T0 });

  assert.notEqual(first.value.definitionSetDigest, second.value.definitionSetDigest, 'revision is part of frozen authority');
});

test('reference kind/revision mismatches fail closed at WatchSession composition', async () => {
  const repos = repositories();
  const catalog = new DefinitionCatalog(repos.definitions);
  await catalog.create({ id: IDS.filter, kind: 'resourceFilter', name: 'Filter', timestamp: T0 });
  await catalog.create({
