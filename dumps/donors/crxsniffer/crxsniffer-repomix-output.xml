function replaceSubstitutions(message: string, substitutions: readonly UiSubstitution[]): string {
  let result = message;
  substitutions.forEach((value, index) => { result = result.replaceAll(`$${index + 1}`, String(value)); });
  return result;
}

function chromeMessage(key: string, substitutions: readonly UiSubstitution[]): string {
  const chromeApi = (globalThis as unknown as { chrome?: { i18n?: { getMessage?: (name: string, substitutions?: string | string[]) => string } } }).chrome;
  const getMessage = chromeApi?.i18n?.getMessage;
  if (getMessage === undefined) return '';
  try { return getMessage(key, substitutions.map(String)); } catch { return ''; }
}

export function uiMessage(key: string): string {
  const localized = chromeMessage(key, []);
  return localized || EN_MESSAGES[key] || key;
}

export function uiFormat(key: string, substitutions: readonly UiSubstitution[] = []): string {
  const localized = chromeMessage(key, substitutions);
  const fallback = EN_MESSAGES[key] || key;
  return localized || replaceSubstitutions(fallback, substitutions);
}

const ENGLISH_TO_KEY = new Map(Object.entries(EN_MESSAGES).map(([key, value]) => [value, key] as const));
export function localizeEnglish(value: string | undefined): string | undefined {
  if (value === undefined) return undefined;
  const key = ENGLISH_TO_KEY.get(value);
  return key === undefined ? value : uiMessage(key);
}
