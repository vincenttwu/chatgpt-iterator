import type { JsonPrimitive } from '../core/index.ts';
import {
  PAGE_FIELD_MAPPING_SCHEMA_VERSION,
  type PageFieldCandidate,
  type PageFieldCardinality,
  type PageFieldMappingBody,
  type PageFieldReadKind,
  type PageFieldSelectorFamily,
  type PageFieldTransformKind,
  type PageFieldValidationType,
  type PageFieldValue,
} from './types.ts';
import type { PageFieldMappingSummary } from './workspace.ts';
import { requirePageFieldMappingBody } from './validation.ts';

export type PageFieldDefaultMode = 'none' | 'single' | 'list';
export type PageFieldPrimitiveKind = 'string' | 'number' | 'boolean' | 'null';

export interface PageFieldNamespaceDraft {
  readonly id: string;
  prefix: string;
  uri: string;
}

export interface PageFieldTransformDraft {
  readonly id: string;
  kind: PageFieldTransformKind;
  start: string;
  end: string;
  search: string;
  replacement: string;
  separator: string;
}

export interface PageFieldCandidateDraft {
  readonly id: string;
  family: PageFieldSelectorFamily;
  query: string;
  namespaces: PageFieldNamespaceDraft[];
  readKind: PageFieldReadKind;
  readName: string;
  cardinality: PageFieldCardinality;
  transforms: PageFieldTransformDraft[];
  rejectBlank: boolean;
  rejectEmptyList: boolean;
}

export interface PageFieldDefaultEntryDraft {
  readonly id: string;
  kind: PageFieldPrimitiveKind;
  text: string;
  booleanValue: boolean;
}

export interface PageFieldMappingDraft {
  name: string;
  enabled: boolean;
  slug: string;
  candidates: PageFieldCandidateDraft[];
  defaultMode: PageFieldDefaultMode;
  defaultEntries: PageFieldDefaultEntryDraft[];
  required: boolean;
  validationType: '' | PageFieldValidationType;
  validationNonBlank: boolean;
  validationMinLength: string;
  validationMaxLength: string;
}

let sequence = 0;
function nextId(prefix: string): string { sequence += 1; return `${prefix}-${sequence}`; }

function namespaceDrafts(candidate: PageFieldCandidate): PageFieldNamespaceDraft[] {
  return Object.entries(candidate.selector.namespaces ?? {}).map(([prefix, uri]) => ({
    id: nextId('namespace'),
    prefix,
    uri: typeof uri === 'string' ? uri : '',
  }));
}

function transformDrafts(candidate: PageFieldCandidate): PageFieldTransformDraft[] {
  return candidate.transforms.map((transform) => ({
    id: nextId('transform'),
    kind: transform.kind,
    start: transform.start === undefined ? '' : String(transform.start),
    end: transform.end === undefined ? '' : String(transform.end),
    search: transform.search ?? '',
    replacement: transform.replacement ?? '',
    separator: transform.separator ?? '',
  }));
}

export function newPageFieldCandidateDraft(family: PageFieldSelectorFamily = 'css'): PageFieldCandidateDraft {
  return {
    id: nextId('candidate'),
    family,
    query: '',
    namespaces: [],
    readKind: family === 'xpath' ? 'raw' : 'text_content',
    readName: '',
    cardinality: 'first',
    transforms: [],
    rejectBlank: false,
    rejectEmptyList: false,
  };
}

export function newPageFieldTransformDraft(kind: PageFieldTransformKind = 'trim'): PageFieldTransformDraft {
  return { id: nextId('transform'), kind, start: '', end: '', search: '', replacement: '', separator: '' };
}

export function newPageFieldDefaultEntryDraft(kind: PageFieldPrimitiveKind = 'string'): PageFieldDefaultEntryDraft {
  return { id: nextId('default'), kind, text: '', booleanValue: false };
}

function candidateDraft(candidate: PageFieldCandidate): PageFieldCandidateDraft {
  return {
    id: nextId('candidate'),
    family: candidate.selector.family,
    query: candidate.selector.query,
    namespaces: namespaceDrafts(candidate),
    readKind: candidate.read.kind,
    readName: candidate.read.name ?? '',
    cardinality: candidate.cardinality,
    transforms: transformDrafts(candidate),
    rejectBlank: candidate.accept.rejectBlank === true,
    rejectEmptyList: candidate.accept.rejectEmptyList === true,
  };
}

function primitiveDraft(value: JsonPrimitive): PageFieldDefaultEntryDraft {
  if (value === null) return { id: nextId('default'), kind: 'null', text: '', booleanValue: false };
  if (typeof value === 'boolean') return { id: nextId('default'), kind: 'boolean', text: '', booleanValue: value };
  if (typeof value === 'number') return { id: nextId('default'), kind: 'number', text: String(value), booleanValue: false };
  return { id: nextId('default'), kind: 'string', text: value, booleanValue: false };
}

function defaultDraft(value: PageFieldValue | undefined): Pick<PageFieldMappingDraft, 'defaultMode' | 'defaultEntries'> {
  if (value === undefined) return { defaultMode: 'none', defaultEntries: [] };
  if (Array.isArray(value)) return { defaultMode: 'list', defaultEntries: value.map(primitiveDraft) };
  return { defaultMode: 'single', defaultEntries: [primitiveDraft(value as JsonPrimitive)] };
}

export function createPageFieldMappingDraft(summary?: PageFieldMappingSummary): PageFieldMappingDraft {
  if (summary === undefined) {
    return {
      name: '', enabled: true, slug: '', candidates: [newPageFieldCandidateDraft()],
      defaultMode: 'none', defaultEntries: [], required: false,
      validationType: '', validationNonBlank: false, validationMinLength: '', validationMaxLength: '',
    };
  }
  const body = summary.body;
  return {
    name: summary.name,
    enabled: summary.enabled,
    slug: body.slug,
    candidates: body.candidates.map(candidateDraft),
    ...defaultDraft(body.defaultValue),
    required: body.required,
    validationType: body.validation.valueType ?? '',
    validationNonBlank: body.validation.nonBlank === true,
    validationMinLength: body.validation.minLength === undefined ? '' : String(body.validation.minLength),
    validationMaxLength: body.validation.maxLength === undefined ? '' : String(body.validation.maxLength),
  };
}

function integerOrUndefined(value: string, label: string): number | undefined {
  if (value.trim() === '') return undefined;
  const parsed = Number(value);
  if (!Number.isSafeInteger(parsed)) throw new Error(`${label} must be a whole number`);
  return parsed;
}

function lengthOrUndefined(value: string, label: string): number | undefined {
  const parsed = integerOrUndefined(value, label);
  if (parsed !== undefined && parsed < 0) throw new Error(`${label} must not be negative`);
  return parsed;
}

function primitiveValue(entry: PageFieldDefaultEntryDraft): JsonPrimitive {
  if (entry.kind === 'null') return null;
  if (entry.kind === 'boolean') return entry.booleanValue;
  if (entry.kind === 'number') {
    if (entry.text.trim() === '') throw new Error('Fallback number is required');
    const parsed = Number(entry.text);
    if (!Number.isFinite(parsed) || Object.is(parsed, -0)) throw new Error('Fallback number must be finite');
    return parsed;
  }
  return entry.text;
}

function defaultValue(draft: PageFieldMappingDraft): PageFieldValue | undefined {
  if (draft.defaultMode === 'none') return undefined;
  if (draft.defaultMode === 'single') {
    const entry = draft.defaultEntries[0];
    if (entry === undefined) throw new Error('Add one fallback value');
    return primitiveValue(entry);
  }
  return Object.freeze(draft.defaultEntries.map(primitiveValue));
}

function candidateValue(draft: PageFieldCandidateDraft): PageFieldCandidate {
  const namespaces = Object.fromEntries(draft.namespaces
    .filter((row) => row.prefix.trim() !== '' || row.uri.trim() !== '')
    .map((row) => [row.prefix.trim(), row.uri.trim()]));
  const transforms = draft.transforms.map((transform) => {
    if (transform.kind === 'slice') {
      const start = integerOrUndefined(transform.start, 'Slice start');
      if (start === undefined) throw new Error('Slice start is required');
      const end = integerOrUndefined(transform.end, 'Slice end');
      return { kind: transform.kind, start, ...(end === undefined ? {} : { end }) };
    }
    if (transform.kind === 'replace') return { kind: transform.kind, search: transform.search, replacement: transform.replacement };
    if (transform.kind === 'join') return { kind: transform.kind, separator: transform.separator };
    return { kind: transform.kind };
  });
  return {
    selector: {
      family: draft.family,
      query: draft.query,
      ...(draft.family === 'xpath' && Object.keys(namespaces).length > 0 ? { namespaces } : {}),
    },
    read: {
      kind: draft.readKind,
      ...((draft.readKind === 'attribute' || draft.readKind === 'property') ? { name: draft.readName } : {}),
    },
    cardinality: draft.cardinality,
    transforms,
    accept: {
      ...(draft.rejectBlank ? { rejectBlank: true } : {}),
      ...(draft.rejectEmptyList ? { rejectEmptyList: true } : {}),
    },
  };
}

export function pageFieldBodyFromDraft(draft: PageFieldMappingDraft): PageFieldMappingBody {
  const fallback = defaultValue(draft);
  const minLength = lengthOrUndefined(draft.validationMinLength, 'Minimum length');
  const maxLength = lengthOrUndefined(draft.validationMaxLength, 'Maximum length');
  return requirePageFieldMappingBody({
    schemaVersion: PAGE_FIELD_MAPPING_SCHEMA_VERSION,
    slug: draft.slug.trim(),
    candidates: draft.candidates.map(candidateValue),
    ...(fallback === undefined ? {} : { defaultValue: fallback }),
    required: draft.required,
    validation: {
      ...(draft.validationType === '' ? {} : { valueType: draft.validationType }),
      ...(draft.validationNonBlank ? { nonBlank: true } : {}),
      ...(minLength === undefined ? {} : { minLength }),
      ...(maxLength === undefined ? {} : { maxLength }),
    },
  });
}

export function pageFieldDraftSignature(draft: PageFieldMappingDraft): string {
  try { return JSON.stringify({ name: draft.name.trim(), enabled: draft.enabled, body: pageFieldBodyFromDraft(draft) }); }
  catch { return '__invalid__'; }
}
