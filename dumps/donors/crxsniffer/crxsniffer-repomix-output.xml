import { freezeJsonValue } from '../core/index.ts';
import type { PackagizerActionType, PackagizerDerivedFields } from './types.ts';

export interface PackagizerDerivedActionDescriptor {
  readonly field: keyof PackagizerDerivedFields;
  readonly maximumLength: number;
  readonly allowEmpty: boolean;
}

/** Baseline registry is local derived metadata only; it deliberately contains no downloader-control actions. */
export const PACKAGIZER_DERIVED_ACTION_REGISTRY = freezeJsonValue({
  set_filename: { field: 'filename', maximumLength: 512, allowEmpty: false },
  set_group: { field: 'group', maximumLength: 512, allowEmpty: false },
  set_comment: { field: 'comment', maximumLength: 2048, allowEmpty: true },
}) as unknown as Readonly<Record<PackagizerActionType, PackagizerDerivedActionDescriptor>>;

export function applyPackagizerDerivedAction(
  derived: PackagizerDerivedFields,
  actionType: PackagizerActionType,
  value: string,
): PackagizerDerivedFields {
  const descriptor = PACKAGIZER_DERIVED_ACTION_REGISTRY[actionType];
  return { ...derived, [descriptor.field]: value };
}
