<file path="src/watch/messages.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  createFailureResponse,
  createSuccessResponse,
  requireRevision,
  requireStableId,
  requireMessageEnvelope,
  toContractErrorPayload,
  type JsonObject,
  type RequestEnvelope,
  type ResponseEnvelope,
} from '../core/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from '../definitions/index.ts';
import { ResourceError, requireResourceAdmissionFilter } from '../resources/index.ts';
import type { WatchConfigurationService } from './configuration.ts';
import { WatchController } from './controller.ts';

export const WATCH_OPERATIONS = Object.freeze({
  status: 'watch.status',
  start: 'watch.start',
  stop: 'watch.stop',
  configurations: 'watch.configurations',
  saveConfiguration: 'watch.configuration.save',
  deleteConfiguration: 'watch.configuration.delete',
} as const);

function requireOnlyKeys(payload: JsonObject, allowed: readonly string[]): void {
  const set = new Set(allowed);
  for (const key of Object.keys(payload)) {
    if (!set.has(key)) {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidArgument,
        `unknown Watch payload field: ${key}`,
        { field: key },
      );
    }
  }
}

function optionalTabId(payload: JsonObject): number | undefined {
  if (payload.tabId === undefined) return undefined;
  if (!Number.isSafeInteger(payload.tabId) || (payload.tabId as number) < 0) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'tabId must be a non-negative safe integer');
  }
  return payload.tabId as number;
}

function requiredTabId(payload: JsonObject): number {
  const tabId = optionalTabId(payload);
  if (tabId === undefined) {
    throw new ContractError(CONTRACT_ERROR_CODES.missingRequiredValue, 'tabId is required');
  }
  return tabId;
}

export class WatchMessageRouter {
  readonly #controller: WatchController;
  readonly #configurations: WatchConfigurationService | undefined;

  constructor(controller: WatchController, configurations?: WatchConfigurationService) {
    this.#controller = controller;
    this.#configurations = configurations;
  }

  async handle(value: unknown): Promise<ResponseEnvelope> {
    const envelope = requireMessageEnvelope(value);
    if (envelope.kind !== 'request') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Watch runtime accepts request envelopes only');
    }

    try {
      return await this.#handleRequest(envelope);
    } catch (error) {
      return createFailureResponse(envelope, this.#errorPayload(error));
    }
  }

  #errorPayload(error: unknown) {
    if (error instanceof DefinitionError) {
      return toContractErrorPayload(new ContractError(
        error.code === DEFINITION_ERROR_CODES.revisionConflict
          ? CONTRACT_ERROR_CODES.invalidRevision
          : CONTRACT_ERROR_CODES.invalidArgument,
        error.message,
        { domainCode: error.code },
      ));
    }
    if (error instanceof ResourceError) {
      return toContractErrorPayload(new ContractError(
        CONTRACT_ERROR_CODES.invalidArgument,
        error.message,
        { domainCode: error.code },
      ));
    }
    return toContractErrorPayload(error);
  }

  #requireConfigurations(): WatchConfigurationService {
    if (this.#configurations === undefined) {
      throw new ContractError(CONTRACT_ERROR_CODES.internalError, 'Watch configuration service is unavailable');
    }
    return this.#configurations;
  }

  async #handleRequest(request: RequestEnvelope): Promise<ResponseEnvelope> {
    if (request.operation === WATCH_OPERATIONS.status) {
      requireOnlyKeys(request.payload, ['tabId']);
      return createSuccessResponse(request, await this.#controller.status(optionalTabId(request.payload)));
    }
    if (request.operation === WATCH_OPERATIONS.start) {
      requireOnlyKeys(request.payload, ['tabId', 'watchDefinitionId', 'expectedWatchRevision']);
      const watchDefinitionId = request.payload.watchDefinitionId === undefined
        ? undefined
        : requireStableId(request.payload.watchDefinitionId, 'definition');
      const expectedWatchRevision = request.payload.expectedWatchRevision === undefined
        ? undefined
        : requireRevision(request.payload.expectedWatchRevision);
      return createSuccessResponse(request, await this.#controller.start({
        tabId: requiredTabId(request.payload),
        ...(watchDefinitionId === undefined ? {} : { watchDefinitionId }),
        ...(expectedWatchRevision === undefined ? {} : { expectedWatchRevision }),
      }));
    }
    if (request.operation === WATCH_OPERATIONS.stop) {
      requireOnlyKeys(request.payload, []);
      return createSuccessResponse(request, await this.#controller.stop());
    }
    if (request.operation === WATCH_OPERATIONS.configurations) {
      requireOnlyKeys(request.payload, []);
      return createSuccessResponse(request, await this.#requireConfigurations().list());
    }

    if (request.operation === WATCH_OPERATIONS.deleteConfiguration) {
      requireOnlyKeys(request.payload, ['watchDefinitionId', 'expectedWatchRevision']);
      return createSuccessResponse(request, await this.#requireConfigurations().delete(
        requireStableId(request.payload.watchDefinitionId, 'definition'),
        requireRevision(request.payload.expectedWatchRevision),
      ));
    }
    if (request.operation === WATCH_OPERATIONS.saveConfiguration) {
      const mode = request.payload.mode;
      if (mode === 'create') {
        requireOnlyKeys(request.payload, ['mode', 'name', 'filter']);
        if (typeof request.payload.name !== 'string' || request.payload.name.trim() === '') {
          throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'Watch setup name is required');
        }
        return createSuccessResponse(request, await this.#requireConfigurations().save({
          mode,
          name: request.payload.name,
          filter: requireResourceAdmissionFilter(request.payload.filter),
        }));
      }
      if (mode === 'update') {
        requireOnlyKeys(request.payload, ['mode', 'watchDefinitionId', 'expectedWatchRevision', 'name', 'filter']);
        if (typeof request.payload.name !== 'string' || request.payload.name.trim() === '') {
          throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'Watch setup name is required');
        }
        return createSuccessResponse(request, await this.#requireConfigurations().save({
          mode,
          watchDefinitionId: requireStableId(request.payload.watchDefinitionId, 'definition'),
          expectedWatchRevision: requireRevision(request.payload.expectedWatchRevision),
          name: request.payload.name,
          filter: requireResourceAdmissionFilter(request.payload.filter),
        }));
      }
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'Watch configuration save mode must be create or update');
    }
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidArgument,
      `unsupported Watch operation: ${request.operation}`,
      { operation: request.operation },
    );
  }
}
</file>

<file path="src/watch/panel-client.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  createRequestEnvelope,
  requireMessageEnvelope,
  type JsonObject,
  type JsonValue,
} from '../core/index.ts';
import {
  REQUIRED_WATCH_HOST_ORIGINS,
  type SaveWatchConfigurationInput,
  type SaveWatchConfigurationResult,
  type DeleteWatchConfigurationResult,
  type WatchConfigurationList,
  type WatchConfigurationSummary,
  type WatchStartResult,
  type WatchStatus,
  type WatchStopResult,
} from './types.ts';
import {
  requireSaveWatchConfigurationResult,
  requireWatchConfigurationList,
} from './configuration.ts';
import { WATCH_OPERATIONS } from './messages.ts';

export interface ChromePermissionsPanelLike {
  request(details: { origins?: readonly string[] }): Promise<boolean>;
  contains(details: { origins?: readonly string[] }): Promise<boolean>;
  remove(details: { origins?: readonly string[] }): Promise<boolean>;
}

export interface ChromeTabsPanelLike {
  query(queryInfo: { active: boolean; currentWindow: boolean }): Promise<readonly {
    id?: number;
    url?: string;
    title?: string;
    incognito?: boolean;
  }[]>;
}

export interface ChromeRuntimePanelLike {
  sendMessage(message: unknown): Promise<unknown>;
}

export interface ChromeWatchPanelLike {
  readonly permissions: ChromePermissionsPanelLike;
  readonly tabs: ChromeTabsPanelLike;
  readonly runtime: ChromeRuntimePanelLike;
}

export interface PanelStartOutcome {
  readonly permission: 'granted' | 'denied' | 'incomplete' | 'not_requested';
  readonly result?: WatchStartResult;
  readonly reason?: 'target_unavailable';
}

export interface PanelStartOptions {
  readonly watchDefinitionId?: import('../core/index.ts').StableId<'definition'>;
  readonly expectedWatchRevision?: import('../core/index.ts').Revision;
}

function requireWatchStatus(value: JsonValue): WatchStatus {
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Watch status response must be an object');
  }
  return value as WatchStatus;
}

async function responseValue<T extends JsonValue>(
  runtime: ChromeRuntimePanelLike,
  operation: string,
  payload: JsonObject,
): Promise<T> {
  const request = createRequestEnvelope({ operation, payload });
  const response = requireMessageEnvelope(await runtime.sendMessage(request));
  if (response.kind !== 'response' || response.requestId !== request.requestId || response.operation !== operation) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'Watch response correlation failed');
  }
  if (!response.outcome.ok) {
    throw new ContractError(
      response.outcome.error.code,
      response.outcome.error.message,
      response.outcome.error.details,
    );
  }
  return response.outcome.value as T;
}

export class WatchPanelClient {
  readonly #chrome: ChromeWatchPanelLike;

  constructor(chromeApi: ChromeWatchPanelLike) {
    this.#chrome = chromeApi;
  }

  async activeTabId(): Promise<number | undefined> {
    const [tab] = await this.#chrome.tabs.query({ active: true, currentWindow: true });
    return typeof tab?.id === 'number' ? tab.id : undefined;
  }

  async hasRequiredHostAuthority(): Promise<boolean> {
    return this.#chrome.permissions.contains({ origins: REQUIRED_WATCH_HOST_ORIGINS });
  }

  async grantHostAuthority(): Promise<'granted' | 'denied' | 'incomplete'> {
    const granted = await this.#chrome.permissions.request({ origins: REQUIRED_WATCH_HOST_ORIGINS });
    if (!granted) return 'denied';
    return await this.hasRequiredHostAuthority() ? 'granted' : 'incomplete';
  }

  async status(): Promise<WatchStatus> {
    const tabId = await this.activeTabId();
    return requireWatchStatus(await responseValue(
      this.#chrome.runtime,
      WATCH_OPERATIONS.status,
      tabId === undefined ? {} : { tabId },
    ));
  }

  async start(options: PanelStartOptions = {}): Promise<PanelStartOutcome> {
    const tabId = await this.activeTabId();
    if (tabId === undefined) {
      return { permission: 'not_requested', reason: 'target_unavailable' };
    }

    if (!await this.hasRequiredHostAuthority()) {
      const permission = await this.grantHostAuthority();
      if (permission !== 'granted') return { permission };
    }

    return {
      permission: 'granted',
      result: await responseValue<WatchStartResult>(
        this.#chrome.runtime,
        WATCH_OPERATIONS.start,
        {
          tabId,
          ...(options.watchDefinitionId === undefined ? {} : { watchDefinitionId: options.watchDefinitionId }),
          ...(options.expectedWatchRevision === undefined ? {} : { expectedWatchRevision: options.expectedWatchRevision }),
        },
      ),
    };
  }

  async stop(): Promise<WatchStopResult> {
    return responseValue<WatchStopResult>(this.#chrome.runtime, WATCH_OPERATIONS.stop, {});
  }

  async revokeHostAuthority(): Promise<boolean> {
    return this.#chrome.permissions.remove({ origins: REQUIRED_WATCH_HOST_ORIGINS });
  }

  async configurations(): Promise<WatchConfigurationList> {
    return requireWatchConfigurationList(await responseValue(
      this.#chrome.runtime,
      WATCH_OPERATIONS.configurations,
      {},
    ));
  }


  async deleteConfiguration(watchDefinitionId: WatchConfigurationSummary['watchDefinitionId'], expectedWatchRevision: WatchConfigurationSummary['watchRevision']): Promise<DeleteWatchConfigurationResult> {
    return responseValue<DeleteWatchConfigurationResult>(
      this.#chrome.runtime,
      WATCH_OPERATIONS.deleteConfiguration,
      { watchDefinitionId, expectedWatchRevision },
    );
  }

  async saveConfiguration(input: SaveWatchConfigurationInput): Promise<SaveWatchConfigurationResult> {
    return requireSaveWatchConfigurationResult(await responseValue(
      this.#chrome.runtime,
      WATCH_OPERATIONS.saveConfiguration,
      input,
    ));
  }
}
</file>

<file path="src/watch/retention.ts">
import { freezeJsonValue, type StableId } from '../core/index.ts';
import {
  META_KEYS,
  PERSISTENCE_STORES,
  PERSISTED_RECORD_SCHEMA_VERSION,
  requireIsoTimestamp,
  requireRetentionMaintenanceState,
  retentionMaintenanceRecord,
  type IsoTimestamp,
  type JsonRecordRepository,
  type MetaRecord,
  type RetentionMaintenanceReason,
  type RetentionMaintenanceState,
} from '../persistence/index.ts';
import type { WatchLifecycleRepository } from './lifecycle-repository.ts';
import { lifecycleMetaKey } from './validation.ts';

export const WATCH_RETENTION_MAX_AGE_OPTIONS = Object.freeze([7, 30, 90] as const);
export const WATCH_RETENTION_MAX_SESSION_OPTIONS = Object.freeze([25, 50, 100] as const);
export type WatchRetentionMaxAgeDays = (typeof WATCH_RETENTION_MAX_AGE_OPTIONS)[number];
export type WatchRetentionMaxSessions = (typeof WATCH_RETENTION_MAX_SESSION_OPTIONS)[number];

export interface WatchRetentionPolicy {
  readonly maxAgeDays: WatchRetentionMaxAgeDays;
  readonly maxTerminalSessions: WatchRetentionMaxSessions;
}

export const DEFAULT_WATCH_RETENTION_POLICY: WatchRetentionPolicy = Object.freeze({
  maxAgeDays: 30,
  maxTerminalSessions: 50,
});

export interface WatchRetentionDeleteSummary {
  readonly deletedSessions: number;
  readonly deletedResourceObservations: number;
  readonly deletedPageFieldSnapshots: number;
  readonly deletedLifecycleRecords: number;
}

export interface WatchRetentionStore {
  deleteTerminalSessions(sessionIds: readonly StableId<'watchSession'>[]): Promise<WatchRetentionDeleteSummary>;
}

export interface WatchRetentionServiceOptions {
  readonly lifecycle: WatchLifecycleRepository;
  readonly store: WatchRetentionStore;
  readonly meta: JsonRecordRepository<MetaRecord>;
  readonly now?: () => IsoTimestamp;
}

export function requireWatchRetentionPolicy(value: unknown): WatchRetentionPolicy {
  if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new TypeError('Watch retention policy must be an object');
  const record = value as Record<string, unknown>;
  if (!(WATCH_RETENTION_MAX_AGE_OPTIONS as readonly unknown[]).includes(record.maxAgeDays)) throw new TypeError('Watch retention max age is unsupported');
  if (!(WATCH_RETENTION_MAX_SESSION_OPTIONS as readonly unknown[]).includes(record.maxTerminalSessions)) throw new TypeError('Watch retention max session count is unsupported');
  return Object.freeze({
    maxAgeDays: record.maxAgeDays as WatchRetentionMaxAgeDays,
    maxTerminalSessions: record.maxTerminalSessions as WatchRetentionMaxSessions,
  });
}

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString());
}

export class WatchRetentionService {
  readonly #lifecycle: WatchLifecycleRepository;
  readonly #store: WatchRetentionStore;
  readonly #meta: JsonRecordRepository<MetaRecord>;
  readonly #now: () => IsoTimestamp;

  constructor(options: WatchRetentionServiceOptions) {
    this.#lifecycle = options.lifecycle;
    this.#store = options.store;
    this.#meta = options.meta;
    this.#now = options.now ?? defaultNow;
  }

  async state(): Promise<RetentionMaintenanceState> {
    const record = await this.#meta.get(META_KEYS.retentionState);
    if (record === undefined) {
      return requireRetentionMaintenanceState({
        schemaVersion: 1,
        lastReason: 'initial',
        deletedSessions: 0,
        deletedResourceObservations: 0,
        deletedPageFieldSnapshots: 0,
        deletedLifecycleRecords: 0,
      });
    }
    return requireRetentionMaintenanceState(record.value);
  }

  async enforce(policyValue: WatchRetentionPolicy, reason: Exclude<RetentionMaintenanceReason, 'initial'>): Promise<RetentionMaintenanceState> {
    const policy = requireWatchRetentionPolicy(policyValue);
    const now = this.#now();
    const cutoff = Date.parse(now) - policy.maxAgeDays * 86_400_000;
    const terminal = (await this.#lifecycle.list())
      .filter((entry) => entry.state !== 'watching' && entry.endedAt !== undefined)
      .sort((left, right) => right.endedAt!.localeCompare(left.endedAt!));
    const candidates = terminal
      .filter((entry, index) => index >= policy.maxTerminalSessions || Date.parse(entry.endedAt!) < cutoff)
      .map((entry) => entry.watchSessionId);
    const summary = candidates.length === 0
      ? { deletedSessions: 0, deletedResourceObservations: 0, deletedPageFieldSnapshots: 0, deletedLifecycleRecords: 0 }
      : await this.#store.deleteTerminalSessions(candidates);
    const state = freezeJsonValue({
      schemaVersion: 1,
      lastReason: reason,
      deletedSessions: summary.deletedSessions,
      deletedResourceObservations: summary.deletedResourceObservations,
      deletedPageFieldSnapshots: summary.deletedPageFieldSnapshots,
      deletedLifecycleRecords: summary.deletedLifecycleRecords,
      lastRunAt: now,
    }) as RetentionMaintenanceState;
    await this.#meta.put(retentionMaintenanceRecord(META_KEYS.retentionState, state));
    return state;
  }
}

function transactionComplete(transaction: IDBTransaction): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    transaction.oncomplete = () => resolve();
    transaction.onabort = () => reject(transaction.error ?? new Error('IndexedDB retention transaction aborted'));
    transaction.onerror = () => reject(transaction.error ?? new Error('IndexedDB retention transaction failed'));
  });
}

function requestDone<T>(request: IDBRequest<T>): Promise<void> {
  return new Promise<void>((resolve, reject) => {
    request.onsuccess = () => resolve();
    request.onerror = () => reject(request.error ?? new Error('IndexedDB retention request failed'));
  });
}

async function deleteIndexRange(index: IDBIndex, range: IDBKeyRange): Promise<number> {
  let deleted = 0;
  await new Promise<void>((resolve, reject) => {
    const request = index.openCursor(range);
    request.onerror = () => reject(request.error ?? new Error('IndexedDB retention cursor failed'));
    request.onsuccess = () => {
      const cursor = request.result;
      if (cursor === null) { resolve(); return; }
      const deletion = cursor.delete();
      deletion.onerror = () => reject(deletion.error ?? new Error('IndexedDB retention deletion failed'));
      deletion.onsuccess = () => { deleted += 1; cursor.continue(); };
    };
  });
  return deleted;
}

export class IndexedDbWatchRetentionStore implements WatchRetentionStore {
  readonly #database: IDBDatabase;

  constructor(database: IDBDatabase) {
    this.#database = database;
  }

  async deleteTerminalSessions(sessionIds: readonly StableId<'watchSession'>[]): Promise<WatchRetentionDeleteSummary> {
    if (sessionIds.length === 0) return Object.freeze({ deletedSessions: 0, deletedResourceObservations: 0, deletedPageFieldSnapshots: 0, deletedLifecycleRecords: 0 });
    const transaction = this.#database.transaction([
      PERSISTENCE_STORES.meta,
      PERSISTENCE_STORES.watchSessions,
      PERSISTENCE_STORES.resourceObservations,
      PERSISTENCE_STORES.pageFieldSnapshots,
    ], 'readwrite');
    const complete = transactionComplete(transaction);
    const sessions = transaction.objectStore(PERSISTENCE_STORES.watchSessions);
    const observations = transaction.objectStore(PERSISTENCE_STORES.resourceObservations).index('byWatchSessionObservedAt');
    const snapshots = transaction.objectStore(PERSISTENCE_STORES.pageFieldSnapshots).index('byWatchSessionCapturedAt');
    const meta = transaction.objectStore(PERSISTENCE_STORES.meta);
    let deletedSessions = 0;
    let deletedResourceObservations = 0;
    let deletedPageFieldSnapshots = 0;
    let deletedLifecycleRecords = 0;
    try {
      for (const sessionId of sessionIds) {
        const lower = [sessionId, ''];
        const upper = [sessionId, '\uffff'];
        deletedResourceObservations += await deleteIndexRange(observations, IDBKeyRange.bound(lower, upper));
        deletedPageFieldSnapshots += await deleteIndexRange(snapshots, IDBKeyRange.bound(lower, upper));
        await requestDone(sessions.delete(sessionId));
        deletedSessions += 1;
        await requestDone(meta.delete(lifecycleMetaKey(sessionId)));
        deletedLifecycleRecords += 1;
      }
      await complete;
    } catch (error) {
      try { transaction.abort(); } catch { /* transaction may already be inactive */ }
      throw error;
    }
    return Object.freeze({ deletedSessions, deletedResourceObservations, deletedPageFieldSnapshots, deletedLifecycleRecords });
  }
}
</file>

