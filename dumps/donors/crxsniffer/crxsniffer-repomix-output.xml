        const name = (current.localName || current.tagName || '*').toLowerCase();
        const parent: Element | null = current.parentElement;
        if (parent === null) { segments.unshift(name); break; }
        const peers = Array.from(parent.children).filter((candidate) => (candidate.localName || candidate.tagName || '').toLowerCase() === name);
        const index = peers.indexOf(current);
        segments.unshift(`${name}[${Math.max(0, index) + 1}]`);
        current = parent;
      }
      return `/${segments.join('/')}`;
    };
    const sampleFor = (element: Element): string | undefined => {
      const raw = element.getAttribute('aria-label') ?? element.getAttribute('alt') ?? element.getAttribute('title') ?? element.textContent ?? '';
      const text = raw.replace(/\s+/g, ' ').trim();
      return text.length === 0 ? undefined : text.slice(0, 160);
    };
    return await new Promise<PageFieldAssistPickExecution>((resolve) => {
      const overlay = document.createElement('div');
      overlay.id = overlayId;
      Object.assign(overlay.style, { position: 'fixed', inset: '0', pointerEvents: 'none', zIndex: '2147483647' });
      const marker = document.createElement('div');
      Object.assign(marker.style, { position: 'fixed', border: '3px solid Highlight', background: 'color-mix(in srgb, Highlight 10%, transparent)', pointerEvents: 'none', boxSizing: 'border-box' });
      const banner = document.createElement('div');
      banner.textContent = 'Crsniffer: click an element to use it, or press Esc to cancel';
      Object.assign(banner.style, { position: 'fixed', top: '8px', left: '8px', right: '8px', padding: '8px 10px', background: 'Canvas', color: 'CanvasText', border: '2px solid Highlight', borderRadius: '6px', font: '13px system-ui, sans-serif' });
      overlay.append(marker, banner);
      document.documentElement.appendChild(overlay);
      let settled = false;
      let timer = 0;
      const runtime = (globalThis as unknown as { chrome?: { runtime?: { onMessage?: { addListener(listener: (message: unknown) => void): void; removeListener?(listener: (message: unknown) => void): void } } } }).chrome?.runtime;
      const cleanup = () => {
        overlay.remove();
        document.removeEventListener('pointermove', onMove, true);
        document.removeEventListener('click', onClick, true);
        document.removeEventListener('keydown', onKey, true);
        document.removeEventListener('visibilitychange', onVisibility, true);
        window.removeEventListener('pagehide', onPageHide, true);
        runtime?.onMessage?.removeListener?.(onMessage);
        window.clearTimeout(timer);
        delete (globalThis as unknown as Record<string, unknown>)[pickKey];
      };
      const finish = (result: PageFieldAssistPickExecution) => {
        if (settled) return;
        settled = true;
        cleanup();
        resolve(result);
      };
      const cancel = () => finish(fail('PAGE_FIELD_ASSIST_CANCELLED'));
      const onMove = (event: Event) => {
        const element = event.target instanceof Element ? event.target : null;
        if (element === null || element === overlay || overlay.contains(element)) return;
        const rect = element.getBoundingClientRect();
        Object.assign(marker.style, { left: `${rect.left}px`, top: `${rect.top}px`, width: `${rect.width}px`, height: `${rect.height}px` });
      };
      const onClick = (event: Event) => {
        const element = event.target instanceof Element ? event.target : null;
        if (element === null || element === overlay || overlay.contains(element)) return;
        event.preventDefault();
        event.stopPropagation();
        (event as MouseEvent).stopImmediatePropagation?.();
        const query = family === 'css' ? cssPath(element) : xpathPath(element);
        if (query.length === 0 || query.length > 4096) { finish(fail('PAGE_FIELD_INVALID_SELECTOR')); return; }
        const sample = sampleFor(element);
        finish({ ok: true, result: { family, query, ...(sample === undefined ? {} : { sample }) } });
      };
      const onKey = (event: KeyboardEvent) => { if (event.key === 'Escape') { event.preventDefault(); cancel(); } };
      const onVisibility = () => { if (document.hidden) cancel(); };
      const onPageHide = () => cancel();
      const onMessage = (message: unknown) => {
        if (message !== null && typeof message === 'object' && (message as Record<string, unknown>).type === cancelMessageType) cancel();
      };
      document.addEventListener('pointermove', onMove, true);
      document.addEventListener('click', onClick, true);
      document.addEventListener('keydown', onKey, true);
      document.addEventListener('visibilitychange', onVisibility, true);
      window.addEventListener('pagehide', onPageHide, true);
      runtime?.onMessage?.addListener(onMessage);
      (globalThis as unknown as Record<string, unknown>)[pickKey] = { cancel };
      timer = window.setTimeout(cancel, 30_000);
    });
  } catch {
    try { document.getElementById(overlayId)?.remove(); } catch { /* best effort */ }
    return fail('PAGE_FIELD_SELECTOR_EVALUATION_FAILED');
  }
}

function executionError(code: string): PageFieldError {
  switch (code) {
    case PAGE_FIELD_ERROR_CODES.invalidSelector:
      return new PageFieldError(PAGE_FIELD_ERROR_CODES.invalidSelector, 'page-field selector syntax is invalid');
    case PAGE_FIELD_ERROR_CODES.invalidRead:
      return new PageFieldError(PAGE_FIELD_ERROR_CODES.invalidRead, 'page-field read mode is incompatible with selector result');
    case PAGE_FIELD_ERROR_CODES.propertyNotPrimitive:
      return new PageFieldError(PAGE_FIELD_ERROR_CODES.propertyNotPrimitive, 'page-field property read returned a non-primitive value');
    case PAGE_FIELD_ERROR_CODES.readFailed:
      return new PageFieldError(PAGE_FIELD_ERROR_CODES.readFailed, 'page-field DOM read failed');
    case PAGE_FIELD_ERROR_CODES.cardinalityViolation:
      return new PageFieldError(PAGE_FIELD_ERROR_CODES.cardinalityViolation, 'page-field DOM result exceeded bounded cardinality');
    default:
      return new PageFieldError(PAGE_FIELD_ERROR_CODES.selectorEvaluationFailed, 'page-field selector evaluation failed');
  }
}

export class ChromePageFieldReader implements PageFieldDocumentFactsReader {
  readonly #scripting: ChromeScriptingLike;
  readonly #messenger: ChromePageFieldAssistMessengerLike | undefined;

  constructor(scripting: ChromeScriptingLike, messenger?: ChromePageFieldAssistMessengerLike) {
    this.#scripting = scripting;
    this.#messenger = messenger;
  }

  async #executeAssist<T, A extends readonly unknown[]>(context: PageContextValue, func: (...args: A) => T | Promise<T>, args: A): Promise<T> {
    let results: readonly ChromeInjectionResultLike<T>[];
    try {
      results = await this.#scripting.executeScript({ target: { tabId: context.tabId, documentIds: [context.topDocumentId] }, world: 'ISOLATED', func, args });
    } catch {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.injectionFailed, 'exact-document authoring injection failed');
    }
    if (results.length !== 1 || results[0]?.documentId !== context.topDocumentId) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.documentMismatch, 'authoring result did not come from the exact PageContext document');
    }
    const value = results[0].result;
    if (value === undefined) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.readFailed, 'authoring script returned no result');
    return value;
  }

  async inspect(context: PageContextValue, candidate: PageFieldCandidate): Promise<PageFieldAssistInspection> {
    const execution = await this.#executeAssist(context, inspectPageFieldCandidateInDocument, [candidate] as const);
    if (!execution.ok) throw executionError(execution.code);
    return execution.result;
  }

  async highlight(context: PageContextValue, candidate: PageFieldCandidate): Promise<PageFieldAssistHighlightResult> {
    const execution = await this.#executeAssist(context, highlightPageFieldCandidateInDocument, [candidate] as const);
    if (!execution.ok) throw executionError(execution.code);
    return execution.result;
  }

  async pick(context: PageContextValue, family: PageFieldSelectorFamily): Promise<PageFieldAssistPickResult> {
    const execution = await this.#executeAssist(context, pickPageFieldSelectorInDocument, [family] as const);
    if (!execution.ok) {
      if (execution.code === 'PAGE_FIELD_ASSIST_CANCELLED') throw new PageFieldError(PAGE_FIELD_ERROR_CODES.contextUnavailable, 'page-field pick was cancelled');
      throw executionError(execution.code);
    }
    return execution.result;
  }

  async clear(context: PageContextValue): Promise<void> {
    try { await this.#messenger?.sendMessage(context.tabId, { type: PAGE_FIELD_ASSIST_CANCEL_MESSAGE }); } catch { /* receiver may already be gone */ }
    try { await this.#executeAssist(context, clearPageFieldAssistInDocument, [] as const); } catch { /* navigation/permission loss may already have removed the target */ }
  }

  async read(context: PageContextValue, candidate: PageFieldCandidate): Promise<PageFieldDomReadResult> {
    let results: readonly ChromeInjectionResultLike<PageFieldDomExecutionResult>[];
    try {
      results = await this.#scripting.executeScript({
        target: { tabId: context.tabId, documentIds: [context.topDocumentId] },
        world: 'ISOLATED',
        func: readPageFieldCandidateInDocument,
        args: [candidate],
      });
    } catch {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.injectionFailed, 'exact-document script injection failed');
    }
    if (results.length !== 1 || results[0]?.documentId !== context.topDocumentId) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.documentMismatch, 'script result did not come from the exact PageContext document');
    }
    const execution = results[0].result;
    if (execution === undefined) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.readFailed, 'script returned no page-field result');
    if (!execution.ok) throw executionError(execution.code);
    return execution.result;
  }

  async readTitle(context: PageContextValue): Promise<string> {
    let results: readonly ChromeInjectionResultLike<PageTitleExecutionResult>[];
    try {
      results = await this.#scripting.executeScript({
        target: { tabId: context.tabId, documentIds: [context.topDocumentId] },
        world: 'ISOLATED',
        func: readPageTitleInDocument,
        args: [],
      });
    } catch {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.injectionFailed, 'exact-document title injection failed');
    }
    if (results.length !== 1 || results[0]?.documentId !== context.topDocumentId) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.documentMismatch, 'title result did not come from the exact PageContext document');
    }
    const execution = results[0].result;
    if (execution === undefined) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.readFailed, 'script returned no page-title result');
    if (!execution.ok) throw executionError(execution.code);
    return execution.title;
  }
}
