import type { JsonObject, JsonValue, StableId } from '../core/index.ts';
import type { PackagizerPageContext } from '../packagizer/index.ts';
import type { PageFieldSnapshotRecord } from '../persistence/index.ts';
import type { PageContextResolutionStatus } from '../page-context/index.ts';
import type { PageFieldCandidateTrace, PageFieldValue } from './types.ts';
import type { PageFieldErrorCode } from './errors.ts';

export const PAGE_FIELD_SNAPSHOT_VALUE_SCHEMA_VERSION = 1 as const;

export interface PageFieldSnapshotTitleFact extends JsonObject {
  readonly status: 'value' | 'error';
  readonly value?: string;
  readonly errorCode?: PageFieldErrorCode;
}

export interface PageFieldSnapshotPageFacts extends JsonObject {
  readonly url: string;
  readonly origin: string;
  readonly title?: PageFieldSnapshotTitleFact;
}

export interface PageFieldSnapshotMappingAuthority extends JsonObject {
  readonly definitionId: StableId<'definition'>;
  readonly revision: number;
  readonly digest: string;
}

export interface PageFieldSnapshotFieldFact extends JsonObject {
  readonly slug: string;
  readonly mapping: PageFieldSnapshotMappingAuthority;
  readonly status: 'value' | 'missing' | 'error';
  readonly value?: PageFieldValue;
  readonly source?: 'candidate' | 'default';
  readonly selectedCandidateIndex?: number;
  readonly errorCode?: PageFieldErrorCode;
  readonly trace: readonly PageFieldCandidateTrace[];
}

export interface PageFieldSnapshotValue extends JsonObject {
  readonly schemaVersion: typeof PAGE_FIELD_SNAPSHOT_VALUE_SCHEMA_VERSION;
  readonly definitionSetDigest: string;
  readonly page: PageFieldSnapshotPageFacts;
  readonly fields: readonly PageFieldSnapshotFieldFact[];
}

export interface ImmutablePageFieldSnapshotRecord extends PageFieldSnapshotRecord {
  readonly value: PageFieldSnapshotValue;
}

export type PageFieldEnrichmentStatus =
  | 'not_required'
  | 'snapshot'
  | Exclude<PageContextResolutionStatus, 'exact'>;

export interface PageFieldEnrichmentResult {
  readonly status: PageFieldEnrichmentStatus;
  readonly page?: PackagizerPageContext;
  readonly snapshotId?: StableId<'pageFieldSnapshot'>;
  readonly snapshot?: ImmutablePageFieldSnapshotRecord;
  readonly persisted?: boolean;
}

export interface PageFieldDocumentFactsReader {
  readTitle(context: import('../page-context/index.ts').PageContextValue): Promise<string>;
}

export interface PageFieldSnapshotPersistOptions {
  readonly persist?: boolean;
}

export type PageFieldSnapshotJsonValue = JsonValue;
