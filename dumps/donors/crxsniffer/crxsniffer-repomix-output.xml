import {
  freezeJsonValue,
  requireRevision,
  requireStableId,
  type JsonObject,
  type Revision,
  type StableId,
} from '../core/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from './errors.ts';
import type { DefinitionKind, SavedDefinitionRecord } from './types.ts';
import { DefinitionCatalog } from './catalog.ts';

export interface DefinitionUsageSummary extends JsonObject {
  readonly id: StableId<'definition'>;
  readonly kind: DefinitionKind;
  readonly revision: Revision;
  readonly name: string;
}

export interface DeleteReusableDefinitionInput extends JsonObject {
  readonly definitionId: StableId<'definition'>;
  readonly expectedRevision: Revision;
  readonly kind: DefinitionKind;
}

export interface DeleteReusableDefinitionResult extends JsonObject {
  readonly deleted: true;
  readonly definitionId: StableId<'definition'>;
}

export interface DefinitionLifecycleServiceOptions {
  readonly catalog: DefinitionCatalog;
  readonly protectedDefinitionIds?: readonly StableId<'definition'>[];
}

export class DefinitionLifecycleService {
  readonly #catalog: DefinitionCatalog;
  readonly #protected: ReadonlySet<StableId<'definition'>>;

  constructor(options: DefinitionLifecycleServiceOptions) {
    this.#catalog = options.catalog;
    this.#protected = new Set(options.protectedDefinitionIds ?? []);
  }

  async usages(definitionId: StableId<'definition'>): Promise<readonly DefinitionUsageSummary[]> {
    const id = requireStableId(definitionId, 'definition');
    const dependents = (await this.#catalog.list())
      .filter((candidate) => candidate.id !== id && candidate.value.references.some((reference) => reference.id === id))
      .map((candidate) => freezeJsonValue({
        id: candidate.id,
        kind: candidate.definitionKind,
        revision: candidate.revision,
        name: candidate.value.name,
      }) as DefinitionUsageSummary)
      .sort((left, right) => left.name.localeCompare(right.name) || left.id.localeCompare(right.id));
    return Object.freeze(dependents);
  }

  async delete(input: DeleteReusableDefinitionInput): Promise<DeleteReusableDefinitionResult> {
    const id = requireStableId(input.definitionId, 'definition');
    const record: SavedDefinitionRecord = await this.#catalog.require(id);
    if (record.definitionKind !== input.kind) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.kindMismatch,
        `Expected ${input.kind} definition`,
        { definitionId: id, actualKind: record.definitionKind },
      );
    }
    if (record.revision !== requireRevision(input.expectedRevision)) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.revisionConflict,
        'This saved definition changed elsewhere. Reload the latest saved copy before deleting it. Your current draft was not changed.',
        { definitionId: id, currentRevision: record.revision },
      );
    }
    if (this.#protected.has(id)) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.invalidDefinition,
        `${record.value.name} is built in and cannot be deleted. Save a custom copy instead.`,
        { definitionId: id },
      );
    }
    const dependents = await this.usages(id);
    if (dependents.length > 0) {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.invalidReference,
        `${record.value.name} is still used by ${dependents[0]!.name}. Remove that reference before deleting it.`,
        { definitionId: id, dependentDefinitionId: dependents[0]!.id },
      );
    }
    await this.#catalog.deleteExact(record.id, record.revision);
    return freezeJsonValue({ deleted: true, definitionId: record.id });
  }
}
