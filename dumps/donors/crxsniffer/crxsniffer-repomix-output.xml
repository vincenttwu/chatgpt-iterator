<file path="src/packagizer/templates.ts">
import { MISSING, freezeJsonValue, isMissing, type MaybeJsonValue } from '../core/index.ts';
import { PACKAGIZER_ERROR_CODES, PackagizerError, type PackagizerErrorCode } from './errors.ts';
import {
  requirePackagizerTokenName,
  requireRenderableTokenValue,
  resolvePackagizerToken,
} from './tokens.ts';
import type {
  PackagizerEvaluationInput,
  PackagizerTemplateEvaluation,
  PackagizerTokenExplanation,
} from './types.ts';

const MAX_TEMPLATE_LENGTH = 4096;
const MAX_RENDERED_LENGTH = 8192;

export interface ParsedPackagizerTemplate {
  readonly text: string;
  readonly tokenNames: readonly string[];
}

interface TransformCall {
  readonly name: string;
  readonly args: readonly (string | number)[];
}

function splitOutsideStrings(value: string, delimiter: string): string[] {
  const result: string[] = [];
  let current = '';
  let quoted = false;
  let escaped = false;
  for (const char of value) {
    if (escaped) {
      current += char;
      escaped = false;
      continue;
    }
    if (char === '\\' && quoted) {
      current += char;
      escaped = true;
      continue;
    }
    if (char === '"') {
      quoted = !quoted;
      current += char;
      continue;
    }
    if (char === delimiter && !quoted) {
      result.push(current);
      current = '';
      continue;
    }
    current += char;
  }
  if (quoted || escaped) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTemplate, 'Unterminated string in template expression');
  }
  result.push(current);
  return result;
}

function parseTransform(value: string): TransformCall {
  const parts = splitOutsideStrings(value, ':');
  const name = parts.shift()?.trim() ?? '';
  if (name === '') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, 'Transform name must not be empty');
  }
  const args = parts.map((part) => {
    const trimmed = part.trim();
    if (/^-?(0|[1-9][0-9]*)$/.test(trimmed)) {
      const parsed = Number(trimmed);
      if (!Number.isSafeInteger(parsed) || Math.abs(parsed) > 1_000_000) {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, `Integer argument for ${name} is out of bounds`);
      }
      return parsed;
    }
    if (trimmed.startsWith('"')) {
      try {
        const parsed = JSON.parse(trimmed) as unknown;
        if (typeof parsed !== 'string') throw new Error('not string');
        return parsed;
      } catch {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, `Invalid string argument for ${name}`);
      }
    }
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, `Invalid argument syntax for ${name}`);
  });
  return { name, args };
}

function requireNoArgs(call: TransformCall): void {
  if (call.args.length !== 0) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, `${call.name} does not accept arguments`);
  }
}

function requireStringValue(value: MaybeJsonValue, call: TransformCall): string {
  if (isMissing(value)) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.missingToken, `Missing value before ${call.name}`);
  }
  if (typeof value !== 'string') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.tokenTypeMismatch, `${call.name} requires a string`);
  }
  return value;
}

function filenameSafe(value: string): string {
  return value
    .replace(/[\u0000-\u001f\u007f<>:"/\\|?*]/g, '_')
    .replace(/[. ]+$/g, '')
    .slice(0, 512);
}

function applyTransform(value: MaybeJsonValue, call: TransformCall): MaybeJsonValue {
  switch (call.name) {
    case 'default': {
      if (call.args.length !== 1 || typeof call.args[0] !== 'string') {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, 'default requires one string argument');
      }
      return isMissing(value) ? call.args[0] : value;
    }
    case 'trim': {
      requireNoArgs(call);
      return requireStringValue(value, call).trim();
    }
    case 'lower': {
      requireNoArgs(call);
      return requireStringValue(value, call).toLowerCase();
    }
    case 'upper': {
      requireNoArgs(call);
      return requireStringValue(value, call).toUpperCase();
    }
    case 'slice': {
      if (call.args.length < 1 || call.args.length > 2 || call.args.some((arg) => typeof arg !== 'number')) {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, 'slice requires one or two integer arguments');
      }
      const source = requireStringValue(value, call);
      return source.slice(call.args[0] as number, call.args[1] as number | undefined);
    }
    case 'replace': {
      if (call.args.length !== 2 || call.args.some((arg) => typeof arg !== 'string')) {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, 'replace requires two string arguments');
      }
      const search = call.args[0] as string;
      if (search === '') {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, 'replace search string must not be empty');
      }
      return requireStringValue(value, call).split(search).join(call.args[1] as string);
    }
    case 'urlencode': {
      requireNoArgs(call);
      return encodeURIComponent(requireStringValue(value, call));
    }
    case 'filename_safe': {
      requireNoArgs(call);
      return filenameSafe(requireStringValue(value, call));
    }
    default:
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, `Unsupported transform: ${call.name}`);
  }
}

function parseExpression(expression: string): { token: string; transforms: readonly TransformCall[] } {
  const parts = splitOutsideStrings(expression, '|').map((part) => part.trim());
  const token = requirePackagizerTokenName(parts.shift());
  return { token, transforms: Object.freeze(parts.map(parseTransform)) };
}

function scanTemplate(text: string): readonly { start: number; end: number; expression: string }[] {
  const matches: { start: number; end: number; expression: string }[] = [];
  let cursor = 0;
  while (cursor < text.length) {
    const start = text.indexOf('${', cursor);
    if (start < 0) break;
    let end = -1;
    let quoted = false;
    let escaped = false;
    for (let index = start + 2; index < text.length; index += 1) {
      const char = text[index]!;
      if (escaped) {
        escaped = false;
        continue;
      }
      if (quoted && char === '\\') {
        escaped = true;
        continue;
      }
      if (char === '"') {
        quoted = !quoted;
        continue;
      }
      if (char === '}' && !quoted) {
        end = index;
        break;
      }
    }
    if (end < 0 || quoted || escaped) {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTemplate, 'Unterminated template token');
    }
    const expression = text.slice(start + 2, end).trim();
    if (expression === '') {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTemplate, 'Template token must not be empty');
    }
    matches.push({ start, end: end + 1, expression });
    cursor = end + 1;
  }
  return matches;
}

export function parsePackagizerTemplate(text: string): ParsedPackagizerTemplate {
  if (typeof text !== 'string' || text.length > MAX_TEMPLATE_LENGTH) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTemplate, 'Template text must be at most 4096 characters');
  }
  const tokenNames: string[] = [];
  for (const match of scanTemplate(text)) {
    const parsed = parseExpression(match.expression);
    tokenNames.push(parsed.token);
    for (const transform of parsed.transforms) {
      if (!['default', 'trim', 'lower', 'upper', 'slice', 'replace', 'urlencode', 'filename_safe'].includes(transform.name)) {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTransform, `Unsupported transform: ${transform.name}`);
      }
      if (transform.name === 'default') applyTransform(MISSING, transform);
      else applyTransform('validation', transform);
    }
  }
  return Object.freeze({ text, tokenNames: Object.freeze(tokenNames) });
}

function failureCode(error: unknown, fallback: PackagizerErrorCode): PackagizerErrorCode {
  return error instanceof PackagizerError ? error.code : fallback;
}

/** Render with a value-redacted token/transform trace for Preview/live parity diagnostics. */
export function evaluatePackagizerTemplate(
  text: string,
  input: PackagizerEvaluationInput,
): PackagizerTemplateEvaluation {
  try {
    parsePackagizerTemplate(text);
  } catch (error) {
    return freezeJsonValue({
      ok: false,
      code: failureCode(error, PACKAGIZER_ERROR_CODES.invalidTemplate),
      tokens: [],
    }) as PackagizerTemplateEvaluation;
  }

  const matches = scanTemplate(text);
  const tokens: PackagizerTokenExplanation[] = [];
  let result = '';
  let cursor = 0;
  for (const match of matches) {
    result += text.slice(cursor, match.start);
    let parsed: ReturnType<typeof parseExpression>;
    try {
      parsed = parseExpression(match.expression);
    } catch (error) {
      return freezeJsonValue({
        ok: false,
        code: failureCode(error, PACKAGIZER_ERROR_CODES.invalidTemplate),
        tokens,
      }) as PackagizerTemplateEvaluation;
    }

    let value: MaybeJsonValue;
    try {
      value = resolvePackagizerToken(parsed.token, input);
    } catch (error) {
      tokens.push(freezeJsonValue({
        token: parsed.token,
        sourceState: 'missing',
        transforms: parsed.transforms.map((transform) => transform.name),
        outcome: 'failed',
        errorCode: failureCode(error, PACKAGIZER_ERROR_CODES.invalidToken),
      }));
      return freezeJsonValue({
        ok: false,
        code: failureCode(error, PACKAGIZER_ERROR_CODES.invalidToken),
        tokens,
      }) as PackagizerTemplateEvaluation;
    }
    const sourceState = isMissing(value) ? 'missing' : 'value';

    try {
      for (const transform of parsed.transforms) value = applyTransform(value, transform);
      result += requireRenderableTokenValue(value, parsed.token);
      tokens.push(freezeJsonValue({
        token: parsed.token,
        sourceState,
        transforms: parsed.transforms.map((transform) => transform.name),
        outcome: 'rendered',
      }));
    } catch (error) {
      const code = failureCode(error, PACKAGIZER_ERROR_CODES.invalidTemplate);
      tokens.push(freezeJsonValue({
        token: parsed.token,
        sourceState,
        transforms: parsed.transforms.map((transform) => transform.name),
        outcome: 'failed',
        errorCode: code,
      }));
      return freezeJsonValue({ ok: false, code, tokens }) as PackagizerTemplateEvaluation;
    }
    cursor = match.end;
  }
  result += text.slice(cursor);
  if (result.length > MAX_RENDERED_LENGTH) {
    return freezeJsonValue({
      ok: false,
      code: PACKAGIZER_ERROR_CODES.invalidTemplate,
      tokens,
    }) as PackagizerTemplateEvaluation;
  }
  return freezeJsonValue({ ok: true, value: result, tokens }) as PackagizerTemplateEvaluation;
}

export function renderPackagizerTemplate(text: string, input: PackagizerEvaluationInput): string {
  const evaluated = evaluatePackagizerTemplate(text, input);
  if (!evaluated.ok) {
    throw new PackagizerError(evaluated.code as PackagizerErrorCode, 'Packagizer template evaluation failed');
  }
  return evaluated.value;
}
