<file path="src/persistence/retention-state.ts">
import { assertJsonSafe, freezeJsonValue, requireJsonObject, type JsonObject } from '../core/index.ts';
import { PERSISTED_RECORD_SCHEMA_VERSION, type IsoTimestamp, type MetaRecord } from './types.ts';
import { requireIsoTimestamp } from './records.ts';

export const RETENTION_MAINTENANCE_SCHEMA_VERSION = 1 as const;
export const RETENTION_MAINTENANCE_REASONS = Object.freeze([
  'initial',
  'startup',
  'session_ended',
  'policy_changed',
  'quota_pressure',
  'manual',
] as const);
export type RetentionMaintenanceReason = (typeof RETENTION_MAINTENANCE_REASONS)[number];

export interface RetentionMaintenanceState extends JsonObject {
  readonly schemaVersion: typeof RETENTION_MAINTENANCE_SCHEMA_VERSION;
  readonly lastReason: RetentionMaintenanceReason;
  readonly deletedSessions: number;
  readonly deletedResourceObservations: number;
  readonly deletedPageFieldSnapshots: number;
  readonly deletedLifecycleRecords: number;
  readonly lastRunAt?: IsoTimestamp;
}

function requireCount(value: unknown, label: string): number {
  if (!Number.isSafeInteger(value) || (value as number) < 0) throw new TypeError(`${label} must be a non-negative safe integer`);
  return value as number;
}

export function requireRetentionMaintenanceState(value: unknown): RetentionMaintenanceState {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  const allowed = new Set([
    'schemaVersion',
    'lastReason',
    'deletedSessions',
    'deletedResourceObservations',
    'deletedPageFieldSnapshots',
    'deletedLifecycleRecords',
    'lastRunAt',
  ]);
  for (const key of Object.keys(record)) if (!allowed.has(key)) throw new TypeError(`Retention maintenance state contains unsupported field ${key}`);
  if (record.schemaVersion !== RETENTION_MAINTENANCE_SCHEMA_VERSION) throw new TypeError('Retention maintenance schema version is unsupported');
  if (!(RETENTION_MAINTENANCE_REASONS as readonly unknown[]).includes(record.lastReason)) throw new TypeError('Retention maintenance reason is invalid');
  const lastRunAt = record.lastRunAt === undefined ? undefined : requireIsoTimestamp(record.lastRunAt, 'lastRunAt');
  return freezeJsonValue({
    schemaVersion: RETENTION_MAINTENANCE_SCHEMA_VERSION,
    lastReason: record.lastReason as RetentionMaintenanceReason,
    deletedSessions: requireCount(record.deletedSessions, 'Deleted sessions'),
    deletedResourceObservations: requireCount(record.deletedResourceObservations, 'Deleted resource observations'),
    deletedPageFieldSnapshots: requireCount(record.deletedPageFieldSnapshots, 'Deleted Page Field snapshots'),
    deletedLifecycleRecords: requireCount(record.deletedLifecycleRecords, 'Deleted lifecycle records'),
    ...(lastRunAt === undefined ? {} : { lastRunAt }),
  });
}

export const INITIAL_RETENTION_MAINTENANCE_STATE: RetentionMaintenanceState = freezeJsonValue({
  schemaVersion: RETENTION_MAINTENANCE_SCHEMA_VERSION,
  lastReason: 'initial',
  deletedSessions: 0,
  deletedResourceObservations: 0,
  deletedPageFieldSnapshots: 0,
  deletedLifecycleRecords: 0,
});

export function retentionMaintenanceRecord(key: string, state: RetentionMaintenanceState): MetaRecord {
  return freezeJsonValue({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key,
    value: requireRetentionMaintenanceState(state),
  });
}
</file>

<file path="src/persistence/schema.ts">
import type { JsonObject } from '../core/index.ts';
import {
  LOGICAL_DATABASE_VERSION,
  PERSISTED_RECORD_SCHEMA_VERSION,
  type LogicalMigrationState,
  type MetaRecord,
} from './types.ts';
import { PERSISTENCE_ERROR_CODES, PersistenceError } from './errors.ts';
import { INITIAL_RETENTION_MAINTENANCE_STATE, retentionMaintenanceRecord } from './retention-state.ts';

export const CRSNIFFER_DATABASE_NAME = 'crsniffer';
export const CRSNIFFER_DATABASE_VERSION = 1;

export const PERSISTENCE_STORES = {
  meta: 'meta',
  definitions: 'definitions',
  watchSessions: 'watchSessions',
  resourceObservations: 'resourceObservations',
  pageFieldSnapshots: 'pageFieldSnapshots',
} as const;

export type PersistenceStoreName =
  (typeof PERSISTENCE_STORES)[keyof typeof PERSISTENCE_STORES];

export interface IndexDescriptor {
  readonly name: string;
  readonly keyPath: string | readonly string[];
  readonly unique?: boolean;
}

export interface StoreDescriptor {
  readonly name: PersistenceStoreName;
  readonly keyPath: string;
  readonly indexes: readonly IndexDescriptor[];
}

export const PERSISTENCE_SCHEMA_V1: readonly StoreDescriptor[] = Object.freeze([
  {
    name: PERSISTENCE_STORES.meta,
    keyPath: 'key',
    indexes: [],
  },
  {
    name: PERSISTENCE_STORES.definitions,
    keyPath: 'id',
    indexes: [
      { name: 'byDefinitionKind', keyPath: 'definitionKind' },
      { name: 'byUpdatedAt', keyPath: 'updatedAt' },
      { name: 'byDefinitionKindUpdatedAt', keyPath: ['definitionKind', 'updatedAt'] },
    ],
  },
  {
    name: PERSISTENCE_STORES.watchSessions,
    keyPath: 'id',
    indexes: [
      { name: 'byCreatedAt', keyPath: 'createdAt' },
      { name: 'byUpdatedAt', keyPath: 'updatedAt' },
    ],
  },
  {
    name: PERSISTENCE_STORES.resourceObservations,
    keyPath: 'id',
    indexes: [
      { name: 'byWatchSessionObservedAt', keyPath: ['watchSessionId', 'observedAt'] },
      { name: 'byObservedAt', keyPath: 'observedAt' },
    ],
  },
  {
    name: PERSISTENCE_STORES.pageFieldSnapshots,
    keyPath: 'id',
    indexes: [
      { name: 'byWatchSessionCapturedAt', keyPath: ['watchSessionId', 'capturedAt'] },
      { name: 'byDocumentCapturedAt', keyPath: ['documentId', 'capturedAt'] },
    ],
  },
]);

export const META_KEYS = {
  physicalSchema: 'schema.physical',
  logicalMigration: 'schema.logicalMigration',
  retentionState: 'retention.maintenance',
} as const;

export interface SchemaObjectStoreLike {
  createIndex(
    name: string,
    keyPath: string | string[],
    options?: IDBIndexParameters,
  ): unknown;
}

export interface SchemaDatabaseLike {
  readonly objectStoreNames: { contains(name: string): boolean };
  createObjectStore(name: string, options?: IDBObjectStoreParameters): SchemaObjectStoreLike;
}

export interface UpgradeObjectStoreLike {
  put(value: unknown): unknown;
}

export interface UpgradeTransactionLike {
  objectStore(name: string): UpgradeObjectStoreLike;
}

function createV1Stores(database: SchemaDatabaseLike): void {
  for (const descriptor of PERSISTENCE_SCHEMA_V1) {
    if (database.objectStoreNames.contains(descriptor.name)) {
      throw new PersistenceError(
        PERSISTENCE_ERROR_CODES.failed,
        `Fresh v1 upgrade found unexpected pre-existing store ${descriptor.name}`,
      );
    }
    const store = database.createObjectStore(descriptor.name, { keyPath: descriptor.keyPath });
    for (const index of descriptor.indexes) {
      const keyPath = Array.isArray(index.keyPath) ? [...index.keyPath] : index.keyPath;
      store.createIndex(index.name, keyPath as string | string[], { unique: index.unique ?? false });
    }
  }
}

function seedV1Meta(transaction: UpgradeTransactionLike): void {
  const meta = transaction.objectStore(PERSISTENCE_STORES.meta);
  const physical: MetaRecord = {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.physicalSchema,
    value: {
      databaseName: CRSNIFFER_DATABASE_NAME,
      databaseVersion: CRSNIFFER_DATABASE_VERSION,
    },
  };
  const logicalState: LogicalMigrationState = {
    currentVersion: LOGICAL_DATABASE_VERSION,
    targetVersion: LOGICAL_DATABASE_VERSION,
    status: 'idle',
  };
  const logical: MetaRecord = {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.logicalMigration,
    value: logicalState,
  };
  meta.put(physical);
  meta.put(logical);
  meta.put(retentionMaintenanceRecord(META_KEYS.retentionState, INITIAL_RETENTION_MAINTENANCE_STATE));
}

/** Apply only short physical topology changes inside the exclusive versionchange transaction. */
export function applyPhysicalUpgrade(
  database: SchemaDatabaseLike,
  transaction: UpgradeTransactionLike,
  oldVersion: number,
  newVersion: number | null,
): void {
  if (newVersion !== CRSNIFFER_DATABASE_VERSION) {
    throw new PersistenceError(
      PERSISTENCE_ERROR_CODES.unsupportedPhysicalVersion,
      `Expected IndexedDB version ${CRSNIFFER_DATABASE_VERSION}, received ${String(newVersion)}`,
    );
  }
  if (oldVersion === 0) {
    createV1Stores(database);
    seedV1Meta(transaction);
    return;
  }
  if (oldVersion === CRSNIFFER_DATABASE_VERSION) {
    return;
  }
  throw new PersistenceError(
    PERSISTENCE_ERROR_CODES.unsupportedPhysicalVersion,
    `No physical migration path from IndexedDB version ${oldVersion}`,
    { oldVersion, newVersion: CRSNIFFER_DATABASE_VERSION } as JsonObject,
  );
}
</file>

<file path="src/persistence/storage-tiers.ts">
import {
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  type JsonValue,
} from '../core/index.ts';
import { PERSISTENCE_ERROR_CODES, PersistenceError } from './errors.ts';

export interface ChromeStorageAreaLike {
  get(keys?: null | string | string[] | Record<string, unknown>): Promise<Record<string, unknown>>;
  set(items: Record<string, unknown>): Promise<void>;
  remove(keys: string | string[]): Promise<void>;
}

export interface ChromeStorageLike {
  readonly session: ChromeStorageAreaLike;
  readonly local: ChromeStorageAreaLike;
}

export class JsonStorageTier {
  readonly #area: ChromeStorageAreaLike;
  readonly #prefix: string;

  constructor(area: ChromeStorageAreaLike, prefix: string) {
    this.#area = area;
    this.#prefix = prefix;
  }

  #key(key: string): string {
    if (key.trim() === '') {
      throw new PersistenceError(
        PERSISTENCE_ERROR_CODES.storageTierFailed,
        'Storage key must be non-empty',
      );
    }
    return `${this.#prefix}${key}`;
  }

  async get(key: string): Promise<JsonValue | undefined> {
    const storageKey = this.#key(key);
    const result = await this.#area.get(storageKey);
    const value = result[storageKey];
    if (value === undefined) {
      return undefined;
    }
    assertJsonSafe(value);
    return freezeJsonValue(cloneJsonValue(value));
  }

  async set(key: string, value: JsonValue): Promise<void> {
    assertJsonSafe(value);
    await this.#area.set({ [this.#key(key)]: cloneJsonValue(value) });
  }

  async remove(key: string): Promise<void> {
    await this.#area.remove(this.#key(key));
  }

  async clearNamespace(): Promise<void> {
    const all = await this.#area.get(null);
    const keys = Object.keys(all).filter((key) => key.startsWith(this.#prefix));
    if (keys.length > 0) {
      await this.#area.remove(keys);
    }
  }
}

/** Browser-lifetime coordination + small durable preferences; canonical domain data stays in IndexedDB. */
export function createChromeStorageTiers(storage: ChromeStorageLike) {
  return Object.freeze({
    session: new JsonStorageTier(storage.session, 'crsniffer.session.'),
    local: new JsonStorageTier(storage.local, 'crsniffer.local.'),
  });
}
</file>

