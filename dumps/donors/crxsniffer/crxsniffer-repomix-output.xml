  DeleteWatchConfigurationResult,
  SaveWatchConfigurationInput,
  SaveWatchConfigurationResult,
  WatchConfigurationList,
  WatchConfigurationProblem,
  WatchConfigurationSummary,
} from './types.ts';

const CONFIGURATION_PROBLEMS = new Set<WatchConfigurationProblem>([
  'disabled',
  'missing_resource_filter',
  'multiple_resource_filters',
  'invalid_resource_filter',
]);

function requireNonEmptyString(value: unknown, label: string): string {
  if (typeof value !== 'string' || value.trim() === '') {
    throw new TypeError(`${label} must be a non-empty string`);
  }
  return value;
}

export function requireWatchConfigurationSummary(value: unknown): WatchConfigurationSummary {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  const problem = record.problem;
  if (problem !== undefined && (typeof problem !== 'string' || !CONFIGURATION_PROBLEMS.has(problem as WatchConfigurationProblem))) {
    throw new TypeError('Watch configuration problem is invalid');
  }
  if (typeof record.builtIn !== 'boolean' || typeof record.enabled !== 'boolean') {
    throw new TypeError('Watch configuration booleans are invalid');
  }
  return freezeJsonValue(cloneJsonValue({
    watchDefinitionId: requireStableId(record.watchDefinitionId, 'definition'),
    watchRevision: requireRevision(record.watchRevision),
    name: requireNonEmptyString(record.name, 'Watch configuration name'),
    builtIn: record.builtIn,
    enabled: record.enabled,
    filter: requireResourceAdmissionFilter(record.filter),
    ...(problem === undefined ? {} : { problem: problem as WatchConfigurationProblem }),
  }));
}

export function requireWatchConfigurationList(value: unknown): WatchConfigurationList {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (!Array.isArray(record.configurations)) throw new TypeError('Watch configurations must be an array');
  return freezeJsonValue({
    configurations: Object.freeze(record.configurations.map((entry) => requireWatchConfigurationSummary(entry))),
  });
}

export function requireSaveWatchConfigurationResult(value: unknown): SaveWatchConfigurationResult {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (typeof record.created !== 'boolean') throw new TypeError('Watch configuration save result created flag is invalid');
  return freezeJsonValue({
    created: record.created,
    configuration: requireWatchConfigurationSummary(record.configuration),
  });
}

export interface WatchConfigurationServiceOptions {
  readonly catalog: DefinitionCatalog;
  readonly sessions: JsonRecordRepository<WatchSessionRecord>;
  readonly now?: () => IsoTimestamp;
  readonly createDefinitionId?: () => StableId<'definition'>;
}

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString());
}

function resourceFilterReferences(record: SavedDefinitionRecord): readonly DefinitionReference[] {
  return record.value.references.filter((reference) => reference.kind === 'resourceFilter');
}

function withFilterReference(
  record: SavedDefinitionRecord,
  filter: SavedDefinitionRecord,
): readonly DefinitionReference[] {
  return Object.freeze([
    ...record.value.references.filter((reference) => reference.kind !== 'resourceFilter'),
    {
      id: filter.id,
      kind: 'resourceFilter' as const,
      expectedRevision: filter.revision,
    },
  ]);
}

/**
 * Bounded Watch-setup publication service.
 *
 * It deliberately does not become a generic definition-library API. STEP-07 owns
 * whole-product reusable-definition lifecycle semantics. This service only gives
 * the Watch workspace the explicit Save as / Update boundary required by ADR-0006.
 */
export class WatchConfigurationService {
  readonly #catalog: DefinitionCatalog;
  readonly #sessions: JsonRecordRepository<WatchSessionRecord>;
  readonly #now: () => IsoTimestamp;
  readonly #createDefinitionId: () => StableId<'definition'>;
  readonly #lifecycle: DefinitionLifecycleService;

  constructor(options: WatchConfigurationServiceOptions) {
    this.#catalog = options.catalog;
    this.#lifecycle = new DefinitionLifecycleService({ catalog: options.catalog, protectedDefinitionIds: [DEFAULT_WATCH_DEFINITION_ID] });
    this.#sessions = options.sessions;
    this.#now = options.now ?? defaultNow;
    this.#createDefinitionId = options.createDefinitionId ?? (() => createStableId('definition'));
  }

  async #summary(record: SavedDefinitionRecord): Promise<WatchConfigurationSummary> {
    if (record.definitionKind !== 'watch') {
      throw new DefinitionError(
        DEFINITION_ERROR_CODES.kindMismatch,
        'Watch configuration projection requires a Watch definition',
        { definitionId: record.id, actualKind: record.definitionKind },
      );
    }

    const references = resourceFilterReferences(record);
    let filter = DEFAULT_RESOURCE_ADMISSION_FILTER;
    let problem: WatchConfigurationProblem | undefined;

    if (!record.value.enabled) problem = 'disabled';
    if (references.length > 1) {
      problem = 'multiple_resource_filters';
    } else if (references.length === 1) {
      const reference = references[0]!;
      const filterRecord = await this.#catalog.get(reference.id);
      if (filterRecord === undefined || filterRecord.definitionKind !== 'resourceFilter') {
        problem = 'missing_resource_filter';
      } else {
        try {
          if (reference.expectedRevision !== undefined && filterRecord.revision !== reference.expectedRevision) {
            problem = 'missing_resource_filter';
          } else if (filterRecord.value.enabled) {
            filter = requireResourceAdmissionFilter(filterRecord.value.body);
          }
        } catch {
          problem = 'invalid_resource_filter';
        }
      }
    }

    const summary: WatchConfigurationSummary = {
      watchDefinitionId: record.id,
      watchRevision: record.revision,
      name: record.value.name,
      builtIn: record.id === DEFAULT_WATCH_DEFINITION_ID,
      enabled: record.value.enabled,
      filter,
      ...(problem === undefined ? {} : { problem }),
    };
    return freezeJsonValue(summary);
  }

  async list(): Promise<WatchConfigurationList> {
    await ensureDefaultWatchDefinition(this.#catalog, this.#now());
    const watches = (await this.#catalog.list('watch'))
      .slice()
      .sort((left, right) => {
        if (left.id === DEFAULT_WATCH_DEFINITION_ID) return -1;
        if (right.id === DEFAULT_WATCH_DEFINITION_ID) return 1;
        return left.value.name.localeCompare(right.value.name);
      });
    const configurations = await Promise.all(watches.map((watch) => this.#summary(watch)));
    return freezeJsonValue({ configurations: Object.freeze(configurations) });
  }

  async save(input: SaveWatchConfigurationInput): Promise<SaveWatchConfigurationResult> {
    const filter = requireResourceAdmissionFilter(input.filter);
    const timestamp = this.#now();
    const filterRecord = await this.#catalog.create({
      id: this.#createDefinitionId(),
      kind: 'resourceFilter',
      name: `${input.name} resource filter`,
      body: resourceFilterBody(filter),
      timestamp,
    });

    try {
      if (input.mode === 'create') {
        const watch = await this.#catalog.create({
          id: this.#createDefinitionId(),
          kind: 'watch',
          name: input.name,
          references: [{
            id: filterRecord.id,
            kind: 'resourceFilter',
            expectedRevision: filterRecord.revision,
          }],
          timestamp,
        });
        return freezeJsonValue({ created: true, configuration: await this.#summary(watch) });
      }

      if (input.watchDefinitionId === DEFAULT_WATCH_DEFINITION_ID) {
        throw new DefinitionError(
          DEFINITION_ERROR_CODES.invalidDefinition,
          'The built-in Default Watch cannot be updated; save a custom setup instead',
        );
      }

      const current = await this.#catalog.require(input.watchDefinitionId);
      if (current.definitionKind !== 'watch') {
        throw new DefinitionError(
          DEFINITION_ERROR_CODES.kindMismatch,
          'Only Watch definitions can be updated from the Watch workspace',
          { definitionId: current.id, actualKind: current.definitionKind },
        );
      }
      const updated = await this.#catalog.update(
        current.id,
        input.expectedWatchRevision,
        {
          name: input.name,
          references: withFilterReference(current, filterRecord),
        },
        timestamp,
      );
      return freezeJsonValue({ created: false, configuration: await this.#summary(updated) });
    } catch (error) {
      await this.#catalog.deleteExact(filterRecord.id, filterRecord.revision).catch(() => undefined);
      throw error;
    }
  }


  async delete(watchDefinitionId: StableId<'definition'>, expectedWatchRevision: Revision): Promise<DeleteWatchConfigurationResult> {
    const watch = await this.#catalog.require(watchDefinitionId);
    if (watch.definitionKind !== 'watch') {
      throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, 'Only Watch definitions can be deleted from the Watch workspace');
    }
    const filterReferences = resourceFilterReferences(watch);
    await this.#lifecycle.delete({ definitionId: watch.id, expectedRevision: expectedWatchRevision, kind: 'watch' });
    const cleaned: StableId<'definition'>[] = [];
    for (const reference of filterReferences) {
      if (reference.expectedRevision === undefined) continue;
      if ((await this.#lifecycle.usages(reference.id)).length > 0) continue;
      const candidate = await this.#catalog.get(reference.id);
      if (candidate === undefined || candidate.definitionKind !== 'resourceFilter' || candidate.revision !== reference.expectedRevision) continue;
      await this.#catalog.deleteExact(candidate.id, candidate.revision);
      cleaned.push(candidate.id);
    }
    return freezeJsonValue({ deleted: true, watchDefinitionId: watch.id, cleanedResourceFilterIds: Object.freeze(cleaned) });
  }

  async activeContext(watchSessionId: StableId<'watchSession'>): Promise<ActiveWatchContext | undefined> {
    const stored = await this.#sessions.get(watchSessionId);
    if (stored === undefined) return undefined;
    const session: ImmutableWatchSessionRecord = requireImmutableWatchSessionRecord(stored);
    const watch = session.value.definitions.find(
      (definition) => definition.id === session.value.watchDefinitionId && definition.kind === 'watch',
    );
    if (watch === undefined) return undefined;
    return freezeJsonValue({
      watchSessionId,
      watchDefinitionId: watch.id,
      watchRevision: watch.revision,
      setupName: watch.value.name,
      filter: resolveWatchSessionResourceFilter(session),
    });
  }
}
</file>

<file path="src/watch/controller.ts">
import {
  createStableId,
  freezeJsonValue,
  type Revision,
  type StableId,
} from '../core/index.ts';
import {
  DefinitionCatalog,
  WatchSessionComposer,
} from '../definitions/index.ts';
import {
  requireIsoTimestamp,
  type IsoTimestamp,
  type JsonRecordRepository,
  type WatchSessionRecord,
} from '../persistence/index.ts';
import { validateWatchSessionResourceFilter } from '../resources/filter.ts';
import { validateWatchSessionPackagizer } from '../packagizer/index.ts';
import {
  validateWatchSessionPageFieldDependencies,
  validateWatchSessionPageFieldMappings,
} from '../page-fields/index.ts';
import { ensureDefaultWatchDefinition } from './default-definition.ts';
import { WatchLifecycleRepository } from './lifecycle-repository.ts';
import {
  WATCH_ACTIVE_STATE_SCHEMA_VERSION,
  WATCH_LIFECYCLE_SCHEMA_VERSION,
  WATCH_SESSION_STORAGE_KEY,
  type ActiveWatchAuthority,
  type StartWatchInput,
  type WatchHostAuthorityPort,
  type WatchSessionStatePort,
  type WatchStartReason,
  type WatchStartResult,
  type WatchStatus,
  type WatchStopResult,
  type WatchTab,
  type WatchTabPort,
  type WatchTerminationReason,
  type WatchTerminationSummary,
} from './types.ts';
import {
  isSupportedWatchUrl,
  requireActiveWatchAuthority,
} from './validation.ts';

export interface WatchControllerOptions {
  readonly catalog: DefinitionCatalog;
  readonly composer: WatchSessionComposer;
  readonly sessions: JsonRecordRepository<WatchSessionRecord>;
  readonly lifecycle: WatchLifecycleRepository;
  readonly sessionState: WatchSessionStatePort;
  readonly permissions: WatchHostAuthorityPort;
  readonly tabs: WatchTabPort;
  readonly now?: () => IsoTimestamp;
  readonly createWatchSessionId?: () => StableId<'watchSession'>;
  readonly onTerminated?: (reason: WatchTerminationReason, watchSessionId: StableId<'watchSession'>) => void | Promise<void>;
}

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString()) as IsoTimestamp;
}

function targetReadiness(tab: WatchTab | undefined): 'ready' | 'target_unavailable' | 'target_unsupported' {
  if (tab === undefined) return 'target_unavailable';
  if (tab.incognito === true || !isSupportedWatchUrl(tab.url)) return 'target_unsupported';
  return 'ready';
}

export class WatchController {
  readonly #catalog: DefinitionCatalog;
  readonly #composer: WatchSessionComposer;
  readonly #sessions: JsonRecordRepository<WatchSessionRecord>;
  readonly #lifecycle: WatchLifecycleRepository;
  readonly #sessionState: WatchSessionStatePort;
  readonly #permissions: WatchHostAuthorityPort;
  readonly #tabs: WatchTabPort;
  readonly #now: () => IsoTimestamp;
  readonly #createWatchSessionId: () => StableId<'watchSession'>;
  readonly #onTerminated: ((reason: WatchTerminationReason, watchSessionId: StableId<'watchSession'>) => void | Promise<void>) | undefined;

  constructor(options: WatchControllerOptions) {
    this.#catalog = options.catalog;
    this.#composer = options.composer;
    this.#sessions = options.sessions;
    this.#lifecycle = options.lifecycle;
    this.#sessionState = options.sessionState;
    this.#permissions = options.permissions;
    this.#tabs = options.tabs;
    this.#now = options.now ?? defaultNow;
    this.#createWatchSessionId = options.createWatchSessionId ?? (() => createStableId('watchSession'));
    this.#onTerminated = options.onTerminated;
  }

  async #active(): Promise<ActiveWatchAuthority | undefined> {
    const value = await this.#sessionState.get(WATCH_SESSION_STORAGE_KEY);
    return value === undefined ? undefined : requireActiveWatchAuthority(value);
  }

  async #setActive(value: ActiveWatchAuthority): Promise<void> {
    await this.#sessionState.set(WATCH_SESSION_STORAGE_KEY, value);
  }

  async #clearActive(): Promise<void> {
    await this.#sessionState.remove(WATCH_SESSION_STORAGE_KEY);
  }

  async #terminationSummary(): Promise<WatchTerminationSummary | undefined> {
    const terminal = await this.#lifecycle.latestTerminal();
    if (terminal?.endedAt === undefined || terminal.terminationReason === undefined) return undefined;
    return freezeJsonValue({
      watchSessionId: terminal.watchSessionId,
      tabId: terminal.tabId,
      endedAt: terminal.endedAt,
      reason: terminal.terminationReason,
    });
  }

  async #statusWithoutReconcile(tabId?: number): Promise<WatchStatus> {
    const active = await this.#active();
    const hostCoverage = await this.#permissions.hasRequiredHosts() ? 'full' : 'required';
    const lastTermination = await this.#terminationSummary();

    if (active !== undefined) {
      const status: WatchStatus = {
        state: 'watching',
        readiness: 'watching',
        hostCoverage,
        active: {
          watchSessionId: active.watchSessionId,
          tabId: active.tabId,
          startedAt: active.startedAt,
        },
        ...(lastTermination === undefined ? {} : { lastTermination }),
      };
      return freezeJsonValue(status);
    }

    let readiness: WatchStatus['readiness'];
    if (hostCoverage !== 'full') {
      readiness = 'permission_required';
    } else if (tabId === undefined) {
      readiness = 'target_unavailable';
    } else {
      readiness = targetReadiness(await this.#tabs.get(tabId));
    }

    const status: WatchStatus = {
      state: 'idle',
      readiness,
      hostCoverage,
      ...(lastTermination === undefined ? {} : { lastTermination }),
    };
    return freezeJsonValue(status);
  }

  async status(tabId?: number): Promise<WatchStatus> {
    await this.reconcileActive();
    return this.#statusWithoutReconcile(tabId);
  }

  async start(input: StartWatchInput): Promise<WatchStartResult> {
    await this.reconcileActive();
    if (await this.#active() !== undefined) {
      const result: WatchStartResult = {
        started: false,
        reason: 'already_watching',
        status: await this.#statusWithoutReconcile(input.tabId),
      };
      return freezeJsonValue(result);
    }

    if (!await this.#permissions.hasRequiredHosts()) {
      return this.#notStarted('permission_required', input.tabId);
    }

    const tab = await this.#tabs.get(input.tabId);
    const readiness = targetReadiness(tab);
    if (readiness !== 'ready') {
      return this.#notStarted(readiness, input.tabId);
    }

    const timestamp = this.#now();
    const requestedWatch = input.watchDefinitionId === undefined
      ? await ensureDefaultWatchDefinition(this.#catalog, timestamp)
      : await this.#catalog.require(input.watchDefinitionId);
    if (requestedWatch.definitionKind !== 'watch') {
      throw new TypeError('Watch start requires a Watch definition');
    }

    const watchSessionId = this.#createWatchSessionId();
    let composed = false;
    let lifecycleWritten = false;
    try {
      const session = await this.#composer.compose({
        id: watchSessionId,
        watchDefinitionId: requestedWatch.id,
        ...(input.expectedWatchRevision === undefined
          ? {}
          : { expectedWatchRevision: input.expectedWatchRevision as Revision }),
        timestamp,
      });
      composed = true;
      validateWatchSessionResourceFilter(session);
      validateWatchSessionPackagizer(session);
      validateWatchSessionPageFieldMappings(session);
      validateWatchSessionPageFieldDependencies(session);

      await this.#lifecycle.put({
        schemaVersion: WATCH_LIFECYCLE_SCHEMA_VERSION,
        watchSessionId,
        tabId: input.tabId,
        state: 'watching',
        startedAt: timestamp,
      });
      lifecycleWritten = true;

      await this.#setActive({
        schemaVersion: WATCH_ACTIVE_STATE_SCHEMA_VERSION,
        watchSessionId,
        tabId: input.tabId,
        startedAt: timestamp,
      });
    } catch (error) {
      if (lifecycleWritten) await this.#lifecycle.delete(watchSessionId).catch(() => undefined);
      if (composed) await this.#sessions.delete(watchSessionId).catch(() => undefined);
      throw error;
    }

    const result: WatchStartResult = {
      started: true,
      reason: 'started',
      status: await this.#statusWithoutReconcile(input.tabId),
    };
    return freezeJsonValue(result);
  }

  async #notStarted(
    reason: Exclude<WatchStartReason, 'started' | 'already_watching'>,
    tabId: number,
  ): Promise<WatchStartResult> {
    const result: WatchStartResult = {
      started: false,
      reason,
      status: await this.#statusWithoutReconcile(tabId),
    };
    return freezeJsonValue(result);
  }

  async stop(): Promise<WatchStopResult> {
    const stopped = await this.#terminateActive('user_stop');
    return freezeJsonValue({
      stopped,
      status: await this.#statusWithoutReconcile(),
    });
  }

  async handleTabClosed(tabId: number): Promise<boolean> {
    const active = await this.#active();
    if (active === undefined || active.tabId !== tabId) return false;
    return this.#terminateActive('target_closed');
  }

  async handlePermissionChange(): Promise<boolean> {
    if (await this.#permissions.hasRequiredHosts()) return false;
    return this.#terminateActive('permission_lost');
  }

  async handleStorageFailure(): Promise<boolean> {
    const active = await this.#active();
    if (active === undefined) return false;
    await this.#clearActive().catch(() => undefined);
    try {
      const current = await this.#lifecycle.get(active.watchSessionId);
      if (current !== undefined && current.state === 'watching') {
        await this.#lifecycle.put({
          ...current,
          state: 'terminated',
          endedAt: this.#now(),
          terminationReason: 'storage_failure',
        });
      }
    } catch {
      // The storage failure itself may prevent lifecycle metadata from being updated.
      // Browser-lifetime active authority is still cleared first so capture cannot continue silently.
    }
    try { await this.#onTerminated?.('storage_failure', active.watchSessionId); } catch { /* maintenance is best effort after a storage failure */ }
    return true;
  }

  async reconcileOnStartup(): Promise<void> {
    const active = await this.#active();
    if (active === undefined) {
      const orphaned = await this.#lifecycle.listWatching();
      for (const value of orphaned) {
        await this.#lifecycle.put({
          ...value,
          state: 'terminated',
          endedAt: this.#now(),
          terminationReason: 'runtime_session_lost',
        });
        try { await this.#onTerminated?.('runtime_session_lost', value.watchSessionId); } catch { /* retention maintenance must not compromise startup reconciliation */ }
      }
      return;
    }
    await this.reconcileActive();
  }

  async reconcileActive(): Promise<void> {
    const active = await this.#active();
    if (active === undefined) return;
    if (!await this.#permissions.hasRequiredHosts()) {
      await this.#terminateActive('permission_lost');
      return;
    }
    const tab = await this.#tabs.get(active.tabId);
    if (tab === undefined) {
      await this.#terminateActive('target_closed');
      return;
    }
    if (targetReadiness(tab) !== 'ready') {
      await this.#terminateActive('target_unsupported');
    }
  }

  async #terminateActive(reason: WatchTerminationReason): Promise<boolean> {
    const active = await this.#active();
    if (active === undefined) return false;

    await this.#clearActive();
    const current = await this.#lifecycle.get(active.watchSessionId);
    if (current !== undefined && current.state === 'watching') {
      await this.#lifecycle.put({
        ...current,
        state: reason === 'user_stop' ? 'stopped' : 'terminated',
        endedAt: this.#now(),
        terminationReason: reason,
      });
    }
    try { await this.#onTerminated?.(reason, active.watchSessionId); } catch { /* retention maintenance must not compromise Watch termination */ }
    return true;
  }
}
