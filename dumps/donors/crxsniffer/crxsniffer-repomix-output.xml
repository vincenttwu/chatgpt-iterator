import {
  cloneJsonValue,
  freezeJsonValue,
  type StableId,
} from '../core/index.ts';
import type { FrozenDefinitionSnapshot } from '../definitions/index.ts';
import { requireResourceObservationRecord } from '../persistence/index.ts';
import { requireResourceObservationValue } from '../observations/index.ts';
import { PACKAGIZER_DERIVED_ACTION_REGISTRY, applyPackagizerDerivedAction } from './actions.ts';
import { PACKAGIZER_ERROR_CODES, PackagizerError } from './errors.ts';
import { evaluatePackagizerConditionDetailed } from './conditions.ts';
import { evaluatePackagizerTemplate } from './templates.ts';
import {
  requirePackagizerTemplateBody,
  resolveWatchSessionPackagizerRules,
} from './validation.ts';
import type {
  PackagizerAction,
  PackagizerActionExplanation,
  PackagizerConditionExplanation,
  PackagizerDerivedFields,
  PackagizerDetailedEvaluation,
  PackagizerEvaluationFailure,
  PackagizerEvaluationInput,
  PackagizerEvaluationResult,
  PackagizerRuleBody,
  PackagizerRuleExplanation,
  PackagizerStructuralExplanation,
  PackagizerTemplateEvaluation,
} from './types.ts';

function frozenDefinitionById(input: PackagizerEvaluationInput, id: StableId<'definition'>) {
  return input.session.value.definitions.find((definition) => definition.id === id);
}

function watchDefinition(input: PackagizerEvaluationInput): FrozenDefinitionSnapshot {
  const watch = input.session.value.definitions.find(
    (definition) => definition.id === input.session.value.watchDefinitionId && definition.kind === 'watch',
  );
  if (watch === undefined) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'WatchSession is missing its frozen Watch definition');
  }
  return watch;
}

function renderActionDetailed(
  action: PackagizerAction,
  input: PackagizerEvaluationInput,
): PackagizerTemplateEvaluation {
  const template = frozenDefinitionById(input, action.templateId);
  if (template === undefined || template.kind !== 'template' || !template.value.enabled) {
    return freezeJsonValue({
      ok: false,
      code: PACKAGIZER_ERROR_CODES.templateNotFrozen,
      tokens: [],
    }) as PackagizerTemplateEvaluation;
  }
  const body = requirePackagizerTemplateBody(template.value.body);
  const evaluated = evaluatePackagizerTemplate(body.text, input);
  if (!evaluated.ok) return evaluated;
  const descriptor = PACKAGIZER_DERIVED_ACTION_REGISTRY[action.type];
  if (!descriptor.allowEmpty && evaluated.value.trim() === '') {
    return freezeJsonValue({
      ok: false,
      code: PACKAGIZER_ERROR_CODES.invalidActionValue,
      tokens: evaluated.tokens,
    }) as PackagizerTemplateEvaluation;
  }
  if (evaluated.value.length > descriptor.maximumLength) {
    return freezeJsonValue({
      ok: false,
      code: PACKAGIZER_ERROR_CODES.invalidActionValue,
      tokens: evaluated.tokens,
    }) as PackagizerTemplateEvaluation;
  }
  return evaluated;
}

function requireCoherentInput(input: PackagizerEvaluationInput): void {
  const observation = requireResourceObservationRecord(input.observation);
  const observationValue = requireResourceObservationValue(observation.value);
  if (input.session.id !== input.occurrence.watchSessionId || input.session.id !== observation.watchSessionId) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'Packagizer input must belong to one WatchSession');
  }
  if (input.occurrence.observationId !== observation.id || input.occurrence.requestId !== observationValue.requestId) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'Packagizer occurrence must match its immutable observation');
  }
}

function notEvaluatedConditions(body: PackagizerRuleBody, start: number): PackagizerConditionExplanation[] {
  return body.conditions.slice(start).map((condition) => freezeJsonValue({
    id: condition.id,
    token: condition.token,
    operator: condition.operator,
    outcome: 'not_evaluated',
  }) as PackagizerConditionExplanation);
}

function notEvaluatedActions(body: PackagizerRuleBody): PackagizerActionExplanation[] {
  return body.actions.map((action) => freezeJsonValue({
    id: action.id,
    type: action.type,
    templateId: action.templateId,
    field: PACKAGIZER_DERIVED_ACTION_REGISTRY[action.type].field,
    outcome: 'not_evaluated',
    tokens: [],
  }) as PackagizerActionExplanation);
}

function resultValue(
  derived: PackagizerDerivedFields,
  appliedRuleIds: readonly StableId<'definition'>[],
  options: { readonly stoppedByRuleId?: StableId<'definition'>; readonly failure?: PackagizerEvaluationFailure } = {},
): PackagizerEvaluationResult {
  return freezeJsonValue(cloneJsonValue({
    schemaVersion: 1,
    derived,
    appliedRuleIds,
    ...(options.stoppedByRuleId === undefined ? {} : { stoppedByRuleId: options.stoppedByRuleId }),
    ...(options.failure === undefined ? {} : { failure: options.failure }),
  })) as PackagizerEvaluationResult;
}

function explanationValue(
  rules: readonly PackagizerRuleExplanation[],
  failure?: PackagizerEvaluationFailure,
): PackagizerStructuralExplanation {
  return freezeJsonValue(cloneJsonValue({
    schemaVersion: 1,
    rules,
    ...(failure === undefined ? {} : { failure }),
  })) as PackagizerStructuralExplanation;
}

/**
 * Single Packagizer semantic engine for live evaluation and Preview/Test.
 * Explanation is structural and intentionally excludes resolved token/template values.
 */
export function evaluatePackagizerDetailed(input: PackagizerEvaluationInput): PackagizerDetailedEvaluation {
  requireCoherentInput(input);
  const enabledRules = resolveWatchSessionPackagizerRules(input.session);
  const enabledById = new Map(enabledRules.map((rule) => [rule.definition.id, rule]));
  const watch = watchDefinition(input);
  let derived: PackagizerDerivedFields = {};
  const appliedRuleIds: StableId<'definition'>[] = [];
  const explanations: PackagizerRuleExplanation[] = [];

  for (const reference of watch.value.references) {
    if (reference.kind !== 'packagizerRule') continue;
    const snapshot = frozenDefinitionById(input, reference.id);
    if (snapshot === undefined || snapshot.kind !== 'packagizerRule') {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `Frozen Packagizer rule ${reference.id} is missing`);
    }
    if (!snapshot.value.enabled) {
      explanations.push(freezeJsonValue({
        ruleId: snapshot.id,
        enabled: false,
        stopAfterSuccess: false,
        outcome: 'disabled',
        conditions: [],
        actions: [],
      }) as PackagizerRuleExplanation);
      continue;
    }

    const resolved = enabledById.get(snapshot.id);
    if (resolved === undefined) {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `Enabled Packagizer rule ${snapshot.id} is unavailable`);
    }
    const body = resolved.body;
    const conditionExplanations: PackagizerConditionExplanation[] = [];
    let matched = true;

    for (let index = 0; index < body.conditions.length; index += 1) {
      const condition = body.conditions[index]!;
      try {
        const evaluated = evaluatePackagizerConditionDetailed(condition, input);
        conditionExplanations.push(freezeJsonValue({
          id: condition.id,
          token: condition.token,
          operator: condition.operator,
          outcome: evaluated.matched ? 'matched' : 'not_matched',
          sourceState: evaluated.sourceState,
        }) as PackagizerConditionExplanation);
        if (!evaluated.matched) {
          matched = false;
          conditionExplanations.push(...notEvaluatedConditions(body, index + 1));
          break;
        }
      } catch (error) {
        const code = error instanceof PackagizerError ? error.code : PACKAGIZER_ERROR_CODES.invalidCondition;
        conditionExplanations.push(freezeJsonValue({
          id: condition.id,
          token: condition.token,
          operator: condition.operator,
          outcome: 'failed',
          errorCode: code,
        }) as PackagizerConditionExplanation);
        conditionExplanations.push(...notEvaluatedConditions(body, index + 1));
        const failure: PackagizerEvaluationFailure = { ruleId: snapshot.id, code };
        explanations.push(freezeJsonValue({
          ruleId: snapshot.id,
          enabled: true,
          stopAfterSuccess: body.stopAfterSuccess,
          outcome: 'failed',
          conditions: conditionExplanations,
          actions: notEvaluatedActions(body),
        }) as PackagizerRuleExplanation);
        return {
          result: resultValue(derived, appliedRuleIds, { failure }),
          explanation: explanationValue(explanations, failure),
        };
      }
    }

    if (!matched) {
      explanations.push(freezeJsonValue({
        ruleId: snapshot.id,
        enabled: true,
        stopAfterSuccess: body.stopAfterSuccess,
        outcome: 'not_matched',
        conditions: conditionExplanations,
        actions: notEvaluatedActions(body),
      }) as PackagizerRuleExplanation);
      continue;
    }

    const rendered: { action: PackagizerAction; value: string; tokens: PackagizerActionExplanation['tokens'] }[] = [];
    let actionFailure: PackagizerEvaluationFailure | undefined;
    const actionExplanations: PackagizerActionExplanation[] = [];
    for (let index = 0; index < body.actions.length; index += 1) {
      const action = body.actions[index]!;
      const evaluated = renderActionDetailed(action, input);
      if (!evaluated.ok) {
        actionFailure = { ruleId: snapshot.id, code: evaluated.code };
        for (const prior of rendered) {
          actionExplanations.push(freezeJsonValue({
            id: prior.action.id,
            type: prior.action.type,
            templateId: prior.action.templateId,
            field: PACKAGIZER_DERIVED_ACTION_REGISTRY[prior.action.type].field,
            outcome: 'rolled_back',
            tokens: prior.tokens,
          }) as PackagizerActionExplanation);
        }
        actionExplanations.push(freezeJsonValue({
          id: action.id,
          type: action.type,
          templateId: action.templateId,
          field: PACKAGIZER_DERIVED_ACTION_REGISTRY[action.type].field,
          outcome: 'failed',
          tokens: evaluated.tokens,
          errorCode: evaluated.code,
        }) as PackagizerActionExplanation);
        for (const later of body.actions.slice(index + 1)) {
          actionExplanations.push(freezeJsonValue({
            id: later.id,
            type: later.type,
            templateId: later.templateId,
            field: PACKAGIZER_DERIVED_ACTION_REGISTRY[later.type].field,
            outcome: 'not_evaluated',
            tokens: [],
          }) as PackagizerActionExplanation);
        }
        break;
      }
      rendered.push({ action, value: evaluated.value, tokens: evaluated.tokens });
    }

    if (actionFailure !== undefined) {
      explanations.push(freezeJsonValue({
        ruleId: snapshot.id,
        enabled: true,
        stopAfterSuccess: body.stopAfterSuccess,
        outcome: 'failed',
        conditions: conditionExplanations,
        actions: actionExplanations,
      }) as PackagizerRuleExplanation);
      return {
        result: resultValue(derived, appliedRuleIds, { failure: actionFailure }),
        explanation: explanationValue(explanations, actionFailure),
      };
    }

    let candidate = derived;
    for (const entry of rendered) {
      const descriptor = PACKAGIZER_DERIVED_ACTION_REGISTRY[entry.action.type];
      const overwrote = candidate[descriptor.field] !== undefined;
      candidate = applyPackagizerDerivedAction(candidate, entry.action.type, entry.value);
      actionExplanations.push(freezeJsonValue({
        id: entry.action.id,
        type: entry.action.type,
        templateId: entry.action.templateId,
        field: descriptor.field,
        outcome: 'applied',
        overwrote,
        tokens: entry.tokens,
      }) as PackagizerActionExplanation);
    }
    derived = candidate;
    appliedRuleIds.push(snapshot.id);

    if (body.stopAfterSuccess) {
      explanations.push(freezeJsonValue({
        ruleId: snapshot.id,
        enabled: true,
        stopAfterSuccess: true,
        outcome: 'stopped',
        conditions: conditionExplanations,
        actions: actionExplanations,
      }) as PackagizerRuleExplanation);
      return {
        result: resultValue(derived, appliedRuleIds, { stoppedByRuleId: snapshot.id }),
        explanation: explanationValue(explanations),
      };
    }

    explanations.push(freezeJsonValue({
      ruleId: snapshot.id,
      enabled: true,
      stopAfterSuccess: false,
      outcome: 'applied',
      conditions: conditionExplanations,
      actions: actionExplanations,
    }) as PackagizerRuleExplanation);
  }

  return {
    result: resultValue(derived, appliedRuleIds),
    explanation: explanationValue(explanations),
  };
}

export function evaluatePackagizer(input: PackagizerEvaluationInput): PackagizerEvaluationResult {
  return evaluatePackagizerDetailed(input).result;
}
