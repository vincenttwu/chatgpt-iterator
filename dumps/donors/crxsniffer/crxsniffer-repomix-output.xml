export const PACKAGIZER_ERROR_CODES = {
  invalidRule: 'PACKAGIZER_INVALID_RULE',
  invalidCondition: 'PACKAGIZER_INVALID_CONDITION',
  invalidTemplate: 'PACKAGIZER_INVALID_TEMPLATE',
  invalidAction: 'PACKAGIZER_INVALID_ACTION',
  invalidToken: 'PACKAGIZER_INVALID_TOKEN',
  invalidTransform: 'PACKAGIZER_INVALID_TRANSFORM',
  templateNotFrozen: 'PACKAGIZER_TEMPLATE_NOT_FROZEN',
  templateNotReferenced: 'PACKAGIZER_TEMPLATE_NOT_REFERENCED',
  missingToken: 'PACKAGIZER_MISSING_TOKEN',
  tokenTypeMismatch: 'PACKAGIZER_TOKEN_TYPE_MISMATCH',
  invalidActionValue: 'PACKAGIZER_INVALID_ACTION_VALUE',
} as const;

export type PackagizerErrorCode = (typeof PACKAGIZER_ERROR_CODES)[keyof typeof PACKAGIZER_ERROR_CODES];

export class PackagizerError extends Error {
  readonly code: PackagizerErrorCode;

  constructor(code: PackagizerErrorCode, message: string) {
    super(message);
    this.name = 'PackagizerError';
    this.code = code;
  }
}
