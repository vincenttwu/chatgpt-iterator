import assert from 'node:assert/strict';
import test from 'node:test';

import {
  DownloadQueueEngine,
  DownloadQueueStore,
} from '../../src/downloads/index.ts';
import { convertSizeToBytes } from '../../src/downloads/queue-types.ts';
import type { ChromeStorageAreaLike } from '../../src/persistence/storage-tiers.ts';

class MockStorageArea implements ChromeStorageAreaLike {
  #store = new Map<string, unknown>();

  async get(keys?: null | string | string[] | Record<string, unknown>): Promise<Record<string, unknown>> {
    if (keys === null || keys === undefined) {
      return Object.fromEntries(this.#store.entries());
    }
    if (typeof keys === 'string') {
      return { [keys]: this.#store.get(keys) };
    }
    if (Array.isArray(keys)) {
      const result: Record<string, unknown> = {};
      for (const k of keys) {
        result[k] = this.#store.get(k);
      }
      return result;
    }
    return {};
  }

  async set(items: Record<string, unknown>): Promise<void> {
    for (const [k, v] of Object.entries(items)) {
      this.#store.set(k, v);
    }
  }

  async remove(keys: string | string[]): Promise<void> {
    const list = Array.isArray(keys) ? keys : [keys];
    for (const k of list) {
      this.#store.delete(k);
    }
  }
}

test('DownloadQueueStore saves and loads queue state across restarts', async () => {
  const storage = new MockStorageArea();
  const store = new DownloadQueueStore(storage);

  const sampleJobs = [
    {
      id: 'job_1',
      url: 'https://vimeo.com/video1.mp4',
      targetPath: 'vimeo.com/video/video1.mp4',
      originUrl: 'https://vimeo.com',
      domain: 'vimeo.com',
      kind: 'video' as const,
      status: 'queued' as const,
      bytesReceived: 0,
      totalBytes: 10485760,
      speedBytesPerSec: 0,
      retryCount: 0,
      enqueuedAt: Date.now(),
    },
  ];

  await store.saveQueueState(sampleJobs, false);
  const loaded = await store.loadQueueState();

  assert.equal(loaded.isPaused, false);
  assert.equal(loaded.jobs.length, 1);
  assert.equal(loaded.jobs[0]?.id, 'job_1');
  assert.equal(loaded.jobs[0]?.domain, 'vimeo.com');
});

test('DownloadQueueEngine respects per-domain round-robin scheduling and max concurrency', async () => {
  const storage = new MockStorageArea();
  const downloadedUrls: string[] = [];

  const mockDownloads = {
    async download(options: { url: string; filename?: string }): Promise<number> {
      downloadedUrls.push(options.url);
      return downloadedUrls.length;
    },
  };

  const engine = new DownloadQueueEngine(storage, mockDownloads);
  await engine.init({
    maxGlobalConcurrency: 2,
    maxDomainConcurrency: 1,
    downloadCooldownIntervalMs: 0,
  });

  // Enqueue 2 jobs for domain A (vimeo) and 1 for domain B (github)
  await engine.enqueue({
    url: 'https://vimeo.com/clip1.mp4',
    targetPath: 'vimeo.com/video/clip1.mp4',
    originUrl: 'https://vimeo.com',
    kind: 'video',
  });

  await engine.enqueue({
    url: 'https://vimeo.com/clip2.mp4',
    targetPath: 'vimeo.com/video/clip2.mp4',
    originUrl: 'https://vimeo.com',
    kind: 'video',
  });

  await engine.enqueue({
    url: 'https://github.com/archive.zip',
    targetPath: 'github.com/other/archive.zip',
    originUrl: 'https://github.com',
    kind: 'other',
  });

  const snapshot = engine.getSnapshot();
  assert.equal(snapshot.activeCount, 2); // 1 from Vimeo, 1 from GitHub
  assert.equal(downloadedUrls.length, 2);
  assert.ok(downloadedUrls.includes('https://vimeo.com/clip1.mp4'));
  assert.ok(downloadedUrls.includes('https://github.com/archive.zip'));
});

test('convertSizeToBytes converts B, KB, MB, GB accurately', () => {
  assert.equal(convertSizeToBytes(100, 'B'), 100);
  assert.equal(convertSizeToBytes(50, 'KB'), 51200);
  assert.equal(convertSizeToBytes(5, 'MB'), 5242880);
  assert.equal(convertSizeToBytes(2, 'GB'), 2147483648);
});

test('DownloadQueueEngine filters out jobs violating min/max size bounds', async () => {
  const storage = new MockStorageArea();
  const downloadedUrls: string[] = [];

  const mockDownloads = {
    async download(options: { url: string }): Promise<number> {
      downloadedUrls.push(options.url);
      return downloadedUrls.length;
    },
  };

  const engine = new DownloadQueueEngine(storage, mockDownloads);
  await engine.init({
    downloadSizeGuardEnabled: true,
    downloadMinSizeBytes: 50 * 1024, // 50 KB
    downloadMaxSizeBytes: 10 * 1024 * 1024, // 10 MB
  });

  // Enqueue 1 tiny tracking pixel (10 KB) -> Should be filtered out
  const pixelJob = await engine.enqueue({
    url: 'https://analytics.com/pixel.png',
    targetPath: 'analytics.com/image/pixel.png',
    originUrl: 'https://analytics.com',
    kind: 'image',
    contentLength: 10 * 1024, // 10 KB
  });

  // Enqueue 1 valid file (500 KB) -> Should pass & be downloaded
  const validJob = await engine.enqueue({
    url: 'https://cdn.example.com/photo.jpg',
    targetPath: 'example.com/image/photo.jpg',
    originUrl: 'https://cdn.example.com',
    kind: 'image',
    contentLength: 500 * 1024, // 500 KB
  });

  // Enqueue 1 giant raw file (50 MB) -> Should be filtered out
  const giantJob = await engine.enqueue({
    url: 'https://cdn.example.com/raw.dump',
    targetPath: 'example.com/other/raw.dump',
    originUrl: 'https://cdn.example.com',
    kind: 'other',
    contentLength: 50 * 1024 * 1024, // 50 MB
  });

  assert.equal(pixelJob.status, 'filtered');
  assert.equal(pixelJob.filterReason, 'size_below_min');

  assert.equal(validJob.status, 'queued');

  assert.equal(giantJob.status, 'filtered');
  assert.equal(giantJob.filterReason, 'size_above_max');

  const snap = engine.getSnapshot();
  assert.equal(snap.filteredCount, 2);
  assert.equal(downloadedUrls.length, 1);
  assert.equal(downloadedUrls[0], 'https://cdn.example.com/photo.jpg');
});

test('DownloadQueueEngine Layer 2 filters out non-matching extensions before size check', async () => {
  const storage = new MockStorageArea();
  const downloadedUrls: string[] = [];

  const mockDownloads = {
    async download(options: { url: string }): Promise<number> {
      downloadedUrls.push(options.url);
      return downloadedUrls.length;
    },
  };

  const engine = new DownloadQueueEngine(storage, mockDownloads);
  await engine.init({
    forceDirectDownloadEnabled: true,
    forceDirectDownloadExtensions: '.mp4, .pdf, .zip',
    downloadSizeGuardEnabled: true,
    downloadMinSizeBytes: 50 * 1024,
    downloadMaxSizeBytes: 10 * 1024 * 1024,
  });

  // Enqueue .exe file (1 MB) -> Disallowed extension -> Should be filtered at Layer 2 instantly
  const exeJob = await engine.enqueue({
    url: 'https://cdn.example.com/installer.exe',
    targetPath: 'example.com/other/installer.exe',
    originUrl: 'https://cdn.example.com',
    kind: 'other',
    contentLength: 1 * 1024 * 1024,
  });

  // Enqueue .mp4 file (1 MB) -> Allowed extension -> Passes Layer 2 and Layer 3
  const mp4Job = await engine.enqueue({
    url: 'https://cdn.example.com/video.mp4',
    targetPath: 'example.com/video/video.mp4',
    originUrl: 'https://cdn.example.com',
    kind: 'video',
    contentLength: 1 * 1024 * 1024,
  });

  assert.equal(exeJob.status, 'filtered');
  assert.equal(exeJob.filterReason, 'extension_blocked');

  assert.equal(mp4Job.status, 'queued');
  assert.equal(downloadedUrls.length, 1);
  assert.equal(downloadedUrls[0], 'https://cdn.example.com/video.mp4');
});

test('DownloadQueueEngine Layer 2 filters out URLs matching downloadExcludeGlobs or missing downloadIncludeGlobs', async () => {
  const storage = new MockStorageArea();
  const downloadedUrls: string[] = [];

  const mockDownloads = {
    async download(options: { url: string }): Promise<number> {
      downloadedUrls.push(options.url);
      return downloadedUrls.length;
    },
  };

  const engine = new DownloadQueueEngine(storage, mockDownloads);
  await engine.init({
    downloadIncludeGlobs: 'https://cdn.example.com/*',
    downloadExcludeGlobs: '*analytics*, *ad_banner*',
    forceDirectDownloadEnabled: false,
  });

  // URL matching exclude pattern -> Should be filtered with rule_mismatch
  const adJob = await engine.enqueue({
    url: 'https://cdn.example.com/media/ad_banner_1080p.mp4',
    targetPath: 'example.com/video/ad_banner_1080p.mp4',
    originUrl: 'https://cdn.example.com',
    kind: 'video',
  });

  // URL from un-included host -> Should be filtered with rule_mismatch
  const externalJob = await engine.enqueue({
    url: 'https://untrusted.com/media/movie.mp4',
    targetPath: 'untrusted.com/video/movie.mp4',
    originUrl: 'https://untrusted.com',
    kind: 'video',
  });

  // Valid URL matching include and not matching exclude -> Should pass
  const validJob = await engine.enqueue({
    url: 'https://cdn.example.com/media/legit_video.mp4',
    targetPath: 'example.com/video/legit_video.mp4',
    originUrl: 'https://cdn.example.com',
    kind: 'video',
  });

  assert.equal(adJob.status, 'filtered');
  assert.equal(adJob.filterReason, 'rule_mismatch');

  assert.equal(externalJob.status, 'filtered');
  assert.equal(externalJob.filterReason, 'rule_mismatch');

  assert.equal(validJob.status, 'queued');
  assert.equal(downloadedUrls.length, 1);
  assert.equal(downloadedUrls[0], 'https://cdn.example.com/media/legit_video.mp4');
});
