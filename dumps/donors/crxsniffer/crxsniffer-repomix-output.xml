<file path="src/page-fields/evaluator.ts">
import { freezeJsonValue } from '../core/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError, type PageFieldErrorCode } from './errors.ts';
import { applyPageFieldTransforms } from './transforms.ts';
import type {
  PageFieldCandidate,
  PageFieldCandidateTrace,
  PageFieldDomReadResult,
  PageFieldEvaluationResult,
  PageFieldMappingBody,
  PageFieldScalar,
  PageFieldValidation,
  PageFieldValue,
} from './types.ts';

const MISSING = Symbol('page-field-missing');
type CandidateValue = PageFieldValue | typeof MISSING;

function failureCode(error: unknown, fallback: PageFieldErrorCode): PageFieldErrorCode {
  return error instanceof PageFieldError ? error.code : fallback;
}

function cardinality(result: PageFieldDomReadResult, candidate: PageFieldCandidate): CandidateValue {
  if (result.kind === 'scalar') {
    return candidate.cardinality === 'many' ? Object.freeze([result.value]) : result.value;
  }
  const values = result.values;
  let selected: readonly typeof values[number][];
  switch (candidate.cardinality) {
    case 'first':
      if (values.length === 0) return MISSING;
      selected = [values[0]!];
      break;
    case 'optional_one':
      if (values.length === 0) return MISSING;
      if (values.length > 1) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.cardinalityViolation, 'optional_one matched more than one node');
      selected = [values[0]!];
      break;
    case 'exact_one':
      if (values.length !== 1) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.cardinalityViolation, 'exact_one requires exactly one node');
      selected = [values[0]!];
      break;
    case 'many':
      selected = values;
      break;
  }

  if (selected.some((item) => item.state === 'missing')) return MISSING;
  const concrete = selected.map((item) => item.value as PageFieldScalar);
  return candidate.cardinality === 'many' ? Object.freeze(concrete) : concrete[0]!;
}


function requireBoundedValue(value: PageFieldValue): PageFieldValue {
  if (typeof value === 'string' && value.length > 8192) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.transformFailed, 'page-field string exceeds 8192 characters');
  }
  if (Array.isArray(value)) {
    if (value.length > 256) throw new PageFieldError(PAGE_FIELD_ERROR_CODES.transformFailed, 'page-field list exceeds 256 entries');
    for (const item of value) if (typeof item === 'string' && item.length > 8192) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.transformFailed, 'page-field list item exceeds 8192 characters');
    }
  }
  return value;
}

function rejected(value: PageFieldValue, candidate: PageFieldCandidate): boolean {
  if (candidate.accept.rejectBlank === true && typeof value === 'string' && value.trim() === '') return true;
  if (candidate.accept.rejectEmptyList === true && Array.isArray(value) && value.length === 0) return true;
  return false;
}

function validateValue(value: PageFieldValue, validation: PageFieldValidation): void {
  if (validation.valueType !== undefined) {
    const actual = Array.isArray(value) ? 'list' : value === null ? 'null' : typeof value;
    if (actual !== validation.valueType) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.validationFailed, `field value type ${actual} does not satisfy ${validation.valueType}`);
    }
  }
  if (validation.nonBlank === true && (typeof value !== 'string' || value.trim() === '')) {
    throw new PageFieldError(PAGE_FIELD_ERROR_CODES.validationFailed, 'field value must be a non-blank string');
  }
  if (validation.minLength !== undefined || validation.maxLength !== undefined) {
    if (typeof value !== 'string' && !Array.isArray(value)) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.validationFailed, 'length validation requires string or list');
    }
    const length = value.length;
    if (validation.minLength !== undefined && length < validation.minLength) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.validationFailed, 'field value is shorter than minLength');
    }
    if (validation.maxLength !== undefined && length > validation.maxLength) {
      throw new PageFieldError(PAGE_FIELD_ERROR_CODES.validationFailed, 'field value is longer than maxLength');
    }
  }
}

function errorResult(code: PageFieldErrorCode, trace: readonly PageFieldCandidateTrace[], candidateIndex?: number): PageFieldEvaluationResult {
  return freezeJsonValue({
    status: 'error',
    code,
    ...(candidateIndex === undefined ? {} : { candidateIndex }),
    trace,
  });
}

export async function evaluatePageFieldMapping(
  mapping: PageFieldMappingBody,
  read: (candidate: PageFieldCandidate, candidateIndex: number) => Promise<PageFieldDomReadResult>,
): Promise<PageFieldEvaluationResult> {
  const trace: PageFieldCandidateTrace[] = [];
  for (let index = 0; index < mapping.candidates.length; index += 1) {
    const candidate = mapping.candidates[index]!;
    let raw: PageFieldDomReadResult;
    try {
      raw = await read(candidate, index);
    } catch (error) {
      const code = failureCode(error, PAGE_FIELD_ERROR_CODES.readFailed);
      trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'error', errorCode: code }));
      return errorResult(code, trace, index);
    }

    let value: CandidateValue;
    try {
      value = cardinality(raw, candidate);
    } catch (error) {
      const code = failureCode(error, PAGE_FIELD_ERROR_CODES.cardinalityViolation);
      trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'error', errorCode: code }));
      return errorResult(code, trace, index);
    }
    if (value === MISSING) {
      trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'missing' }));
      continue;
    }

    try {
      value = requireBoundedValue(applyPageFieldTransforms(value, candidate.transforms));
    } catch (error) {
      const code = failureCode(error, PAGE_FIELD_ERROR_CODES.transformFailed);
      trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'error', errorCode: code }));
      return errorResult(code, trace, index);
    }
    if (rejected(value, candidate)) {
      trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'rejected' }));
      continue;
    }
    try {
      validateValue(value, mapping.validation);
    } catch (error) {
      const code = failureCode(error, PAGE_FIELD_ERROR_CODES.validationFailed);
      trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'error', errorCode: code }));
      return errorResult(code, trace, index);
    }
    trace.push(freezeJsonValue({ candidateIndex: index, selectorFamily: candidate.selector.family, outcome: 'value' }));
    return freezeJsonValue({ status: 'value', value, source: 'candidate', selectedCandidateIndex: index, trace } as const) as PageFieldEvaluationResult;
  }

  if (mapping.defaultValue !== undefined) {
    try {
      validateValue(mapping.defaultValue, mapping.validation);
    } catch (error) {
      return errorResult(failureCode(error, PAGE_FIELD_ERROR_CODES.validationFailed), trace);
    }
    return freezeJsonValue({ status: 'value', value: mapping.defaultValue, source: 'default', trace } as const) as PageFieldEvaluationResult;
  }
  if (mapping.required) return errorResult(PAGE_FIELD_ERROR_CODES.requiredMissing, trace);
  return freezeJsonValue({ status: 'missing', trace } as const) as PageFieldEvaluationResult;
}
