const PRESENTATION: Readonly<Record<ReusableDefinitionKind, ReusableDefinitionPresentation>> = Object.freeze({
  watch: Object.freeze({ singular: ui('watch_setup'), savedLabel: ui('saved_watch_setup') }),
  packagizerRule: Object.freeze({ singular: ui('rule'), savedLabel: ui('saved_rule_30278bfd') }),
  template: Object.freeze({ singular: ui('template'), savedLabel: ui('saved_template_697bce9e') }),
  pageFieldMapping: Object.freeze({ singular: ui('page_field'), savedLabel: ui('saved_page_field') }),
});

export function reusableDefinitionPresentation(kind: ReusableDefinitionKind): ReusableDefinitionPresentation {
  return PRESENTATION[kind];
}

export function reusableDefinitionDraftState(sourceLoaded: boolean, modified: boolean): ReusableDefinitionDraftState {
