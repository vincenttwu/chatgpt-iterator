import assert from 'node:assert/strict';
import test from 'node:test';

import {
  createRequestEnvelope,
  createSuccessResponse,
  requireMessageEnvelope,
  type JsonObject,
} from '../../src/core/index.ts';
import {
  CONTROL_PLANE_OPERATIONS,
  ControlPlaneMessageRouter,
  ControlPlaneProjector,
  DEFAULT_SETTINGS_PREFERENCES,
  SETTINGS_SCHEMA_VERSION,
  SettingsService,
  SidePanelControlClient,
  requireSettingsResult,
} from '../../src/control-plane/index.ts';
import { DefinitionCatalog } from '../../src/definitions/index.ts';
import {
  LOGICAL_DATABASE_VERSION,
  META_KEYS,
  PERSISTED_RECORD_SCHEMA_VERSION,
  PERSISTENCE_STORES,
  JsonRecordRepository,
  JsonStorageTier,
  requireDefinitionRecord,
  requireMetaRecord,
  requirePageFieldSnapshotRecord,
  requireResourceObservationRecord,
  requireWatchSessionRecord,
  type ChromeStorageAreaLike,
  type RepositoryStorePort,
} from '../../src/persistence/index.ts';
import { WatchLifecycleRepository } from '../../src/watch/lifecycle-repository.ts';
import type { WatchStatus } from '../../src/watch/index.ts';

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();
  async get(key: string): Promise<unknown> { return structuredClone(this.values.get(key)); }
  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('memory store requires id or key');
    this.values.set(key, structuredClone(value));
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async count(): Promise<number> { return this.values.size; }
  async clear(): Promise<void> { this.values.clear(); }
  async getAll(): Promise<readonly unknown[]> { return [...this.values.values()].map((value) => structuredClone(value)); }
}

class MemoryStorageArea implements ChromeStorageAreaLike {
  readonly values = new Map<string, unknown>();
  async get(keys?: null | string | readonly string[] | Record<string, unknown>): Promise<Record<string, unknown>> {
    if (keys === null || keys === undefined) return Object.fromEntries(this.values);
    const names = typeof keys === 'string' ? [keys] : Array.isArray(keys) ? [...keys] : Object.keys(keys);
    return Object.fromEntries(names.flatMap((key) => this.values.has(key) ? [[key, this.values.get(key)]] : []));
  }
  async set(items: Record<string, unknown>): Promise<void> {
    for (const [key, value] of Object.entries(items)) this.values.set(key, structuredClone(value));
  }
  async remove(keys: string | readonly string[]): Promise<void> {
    for (const key of typeof keys === 'string' ? [keys] : keys) this.values.delete(key);
  }
}

async function harness(watchStatus: WatchStatus = { state: 'idle', readiness: 'ready', hostCoverage: 'full' }) {
  const stores = {
    meta: new MemoryStore(),
    definitions: new MemoryStore(),
    watchSessions: new MemoryStore(),
    resourceObservations: new MemoryStore(),
    pageFieldSnapshots: new MemoryStore(),
  };
  const repositories = {
    meta: new JsonRecordRepository(PERSISTENCE_STORES.meta, stores.meta, requireMetaRecord),
    definitions: new JsonRecordRepository(PERSISTENCE_STORES.definitions, stores.definitions, requireDefinitionRecord),
    watchSessions: new JsonRecordRepository(PERSISTENCE_STORES.watchSessions, stores.watchSessions, requireWatchSessionRecord),
    resourceObservations: new JsonRecordRepository(PERSISTENCE_STORES.resourceObservations, stores.resourceObservations, requireResourceObservationRecord),
    pageFieldSnapshots: new JsonRecordRepository(PERSISTENCE_STORES.pageFieldSnapshots, stores.pageFieldSnapshots, requirePageFieldSnapshotRecord),
  };
  await repositories.meta.put({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.logicalMigration,
    value: { currentVersion: LOGICAL_DATABASE_VERSION, targetVersion: LOGICAL_DATABASE_VERSION, status: 'idle' },
  });
  await repositories.meta.put({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.retentionState,
    value: { schemaVersion: 1, lastReason: 'initial', deletedSessions: 0, deletedResourceObservations: 0, deletedPageFieldSnapshots: 0, deletedLifecycleRecords: 0 },
  });
  const localArea = new MemoryStorageArea();
  const sessionArea = new MemoryStorageArea();
  const preferences = new JsonStorageTier(localArea, 'crsniffer.local.');
  const sessionState = new JsonStorageTier(sessionArea, 'crsniffer.session.');
  let pendingClearCount = 0;
  const service = new SettingsService({
    repositories,
    preferences,
    sessionState,
    pendingObservations: { clear: async () => { pendingClearCount += 1; } },
    lifecycle: new WatchLifecycleRepository(repositories.meta),
    watch: { status: async () => watchStatus },
    catalog: new DefinitionCatalog(repositories.definitions),
    now: () => '2026-08-20T06:00:00.000Z' as never,
  });
  return { stores, repositories, localArea, sessionArea, preferences, sessionState, service, pendingClearCount: () => pendingClearCount };
}

function seedHistory(stores: Awaited<ReturnType<typeof harness>>['stores']): void {
  stores.definitions.values.set('def_custom', { id: 'def_custom' });
  stores.watchSessions.values.set('ws_old', { id: 'ws_old' });
  stores.resourceObservations.values.set('obs_old', { id: 'obs_old' });
  stores.pageFieldSnapshots.values.set('pfs_old', { id: 'pfs_old' });
}

test('Settings snapshot uses typed local preferences and structural redacted diagnostics', async () => {
  const { service } = await harness();
  const initial = await service.snapshot();
  assert.deepEqual(initial.preferences, DEFAULT_SETTINGS_PREFERENCES);
  assert.equal(initial.retention.mode, 'bounded_terminal_history');
  assert.equal(initial.retention.automaticRetention, 'enabled');
  assert.equal(initial.retention.maxAgeDays, 30);
  assert.equal(initial.retention.maxTerminalSessions, 50);
  assert.equal(initial.diagnostics.storage.level, 'unknown');
  assert.equal(initial.privacy.externalTelemetry, false);
  assert.equal(initial.privacy.rawHeadersCookiesBodiesRetained, false);
  assert.equal(initial.diagnostics.logicalDatabaseVersion, LOGICAL_DATABASE_VERSION);

  const saved = await service.savePreferences({
    ...DEFAULT_SETTINGS_PREFERENCES,
    schemaVersion: SETTINGS_SCHEMA_VERSION,
    resourceRowDensity: 'compact',
    defaultResourceKind: 'video',
    defaultResourceStatus: 'failed',
    historyRetentionDays: 90,
    historyRetentionSessions: 100,
  });
  assert.equal(saved.preferences.resourceRowDensity, 'compact');
  assert.equal(saved.preferences.defaultResourceKind, 'video');
  assert.equal(saved.preferences.historyRetentionDays, 90);
  assert.equal(saved.retention.maxTerminalSessions, 100);
  await assert.rejects(() => service.savePreferences({ ...saved.preferences, surprise: true } as never));
});

test('legacy v1 preferences migrate in place to bounded v2 retention defaults', async () => {
  const h = await harness();
