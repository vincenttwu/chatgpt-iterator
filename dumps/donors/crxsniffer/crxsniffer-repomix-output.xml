import type {
  JsonObject,
  JsonPrimitive,
  StableId,
} from '../core/index.ts';
import type {
  FrozenDefinitionSnapshot,
  ImmutableWatchSessionRecord,
} from '../definitions/index.ts';
import type { PageContextValue } from '../page-context/index.ts';
import type { PageFieldErrorCode } from './errors.ts';

export const PAGE_FIELD_MAPPING_SCHEMA_VERSION = 1 as const;
export const PAGE_FIELD_MAX_CANDIDATES = 16;
export const PAGE_FIELD_MAX_TRANSFORMS = 16;
export const PAGE_FIELD_MAX_LIST_VALUES = 256;
export const PAGE_FIELD_MAX_STRING_LENGTH = 8192;

export type PageFieldScalar = JsonPrimitive;
export type PageFieldValue = PageFieldScalar | readonly PageFieldScalar[];
export type PageFieldSelectorFamily = 'css' | 'xpath';
export type PageFieldCardinality = 'first' | 'optional_one' | 'exact_one' | 'many';
export type PageFieldReadKind = 'text_content' | 'inner_text' | 'attribute' | 'property' | 'raw';
export type PageFieldTransformKind = 'trim' | 'lower' | 'upper' | 'slice' | 'replace' | 'to_string' | 'join';

export interface PageFieldSelector extends JsonObject {
  readonly family: PageFieldSelectorFamily;
  readonly query: string;
  readonly namespaces?: JsonObject;
}

export interface PageFieldRead extends JsonObject {
  readonly kind: PageFieldReadKind;
  readonly name?: string;
}

export interface PageFieldTransform extends JsonObject {
  readonly kind: PageFieldTransformKind;
  readonly start?: number;
  readonly end?: number;
  readonly search?: string;
  readonly replacement?: string;
  readonly separator?: string;
}

export interface PageFieldAcceptance extends JsonObject {
  readonly rejectBlank?: boolean;
  readonly rejectEmptyList?: boolean;
}

export interface PageFieldCandidate extends JsonObject {
  readonly selector: PageFieldSelector;
  readonly read: PageFieldRead;
  readonly cardinality: PageFieldCardinality;
  readonly transforms: readonly PageFieldTransform[];
  readonly accept: PageFieldAcceptance;
}

export type PageFieldValidationType = 'string' | 'number' | 'boolean' | 'null' | 'list';

export interface PageFieldValidation extends JsonObject {
  readonly valueType?: PageFieldValidationType;
  readonly nonBlank?: boolean;
  readonly minLength?: number;
  readonly maxLength?: number;
}

export interface PageFieldMappingBody extends JsonObject {
  readonly schemaVersion: typeof PAGE_FIELD_MAPPING_SCHEMA_VERSION;
  readonly slug: string;
  readonly candidates: readonly PageFieldCandidate[];
  readonly defaultValue?: PageFieldValue;
  readonly required: boolean;
  readonly validation: PageFieldValidation;
}

export interface PageFieldMappingDefinition {
  readonly snapshot: FrozenDefinitionSnapshot;
  readonly body: PageFieldMappingBody;
}

export interface PageFieldNodeReadValue extends JsonObject {
  readonly state: 'value' | 'missing';
  readonly value?: PageFieldScalar;
}

export interface PageFieldDomNodesResult extends JsonObject {
  readonly kind: 'nodes';
  readonly values: readonly PageFieldNodeReadValue[];
}

export interface PageFieldDomScalarResult extends JsonObject {
  readonly kind: 'scalar';
  readonly value: PageFieldScalar;
}

export type PageFieldDomReadResult = PageFieldDomNodesResult | PageFieldDomScalarResult;

export interface PageFieldCandidateTrace extends JsonObject {
  readonly candidateIndex: number;
  readonly selectorFamily: PageFieldSelectorFamily;
  readonly outcome: 'value' | 'missing' | 'rejected' | 'error';
  readonly errorCode?: PageFieldErrorCode;
}

export interface PageFieldValueResult extends JsonObject {
  readonly status: 'value';
  readonly value: PageFieldValue;
  readonly source: 'candidate' | 'default';
  readonly selectedCandidateIndex?: number;
  readonly trace: readonly PageFieldCandidateTrace[];
}

export interface PageFieldMissingResult extends JsonObject {
  readonly status: 'missing';
  readonly trace: readonly PageFieldCandidateTrace[];
}

export interface PageFieldFailureResult extends JsonObject {
  readonly status: 'error';
  readonly code: PageFieldErrorCode;
  readonly candidateIndex?: number;
  readonly trace: readonly PageFieldCandidateTrace[];
}

export type PageFieldEvaluationResult = PageFieldValueResult | PageFieldMissingResult | PageFieldFailureResult;

export interface PageFieldDomReader {
  read(context: PageContextValue, candidate: PageFieldCandidate): Promise<PageFieldDomReadResult>;
}


export interface PageFieldAssistInspection extends JsonObject {
  readonly matchCount: number;
  readonly resultKind: 'nodes' | 'scalar';
  readonly sample?: string;
}

export interface PageFieldAssistHighlightResult extends JsonObject {
  readonly matchCount: number;
  readonly highlightedCount: number;
  readonly highlightable: boolean;
}

export interface PageFieldAssistPickResult extends JsonObject {
  readonly family: PageFieldSelectorFamily;
  readonly query: string;
  readonly sample?: string;
}

export interface PageFieldAuthoringAssistPort {
  inspect(context: PageContextValue, candidate: PageFieldCandidate): Promise<PageFieldAssistInspection>;
  highlight(context: PageContextValue, candidate: PageFieldCandidate): Promise<PageFieldAssistHighlightResult>;
  pick(context: PageContextValue, family: PageFieldSelectorFamily): Promise<PageFieldAssistPickResult>;
  clear(context: PageContextValue): Promise<void>;
}

export interface PageFieldEvaluationRequest {
  readonly context: PageContextValue;
  readonly mapping: PageFieldMappingDefinition;
}

export interface PageFieldContextGuard {
  current(): Promise<PageContextValue | undefined>;
}

export interface WatchSessionPageFieldMappingSet {
  readonly session: ImmutableWatchSessionRecord;
  readonly mappings: ReadonlyMap<StableId<'definition'>, PageFieldMappingDefinition>;
}
