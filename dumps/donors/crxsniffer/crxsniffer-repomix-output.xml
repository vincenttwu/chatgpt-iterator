  }
  if (exportGlobFilter.value.trim() !== '') {
    rows = rows.filter((r) => matchesGlobPattern(r.canonicalUrl, r.filename, exportGlobFilter.value));
  }
  if (exportDeduplicate.value) {
    const seen = new Set<string>();
    rows = rows.filter((r) => {
      if (seen.has(r.canonicalUrl)) return false;
      seen.add(r.canonicalUrl);
      return true;
    });
  }
  return rows;
});

function formatBytes(bytes?: number): string | undefined {
  if (bytes === undefined || bytes < 0) return undefined;
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  if (bytes < 1024 * 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
}

function generateJsonExport(rows: readonly ResourceHistoryRow[]): string {
  const payload = {
    exportedAt: new Date().toISOString(),
    recordCount: rows.length,
    resources: rows.map((r) => ({
      observationId: r.observationId,
      canonicalUrl: r.canonicalUrl,
      filename: r.filename ?? null,
      kind: r.kind,
      status: r.status,
      responseStatusCode: r.responseStatusCode ?? null,
      contentLength: r.contentLength ?? null,
      tabTitle: r.tabTitle ?? null,
      userAgent: r.userAgent ?? null,
      initiator: r.initiator ?? null,
      observedAt: r.observedAt,
    })),
  };
  return JSON.stringify(payload, null, 2);
}

function generateCsvExport(rows: readonly ResourceHistoryRow[]): string {
  const headers = [
    'Observation ID', 'Canonical URL', 'Filename', 'Kind', 'Status',
    'HTTP Status Code', 'Content Length (Bytes)', 'Tab Title', 'User Agent', 'Initiator / Referer', 'Observed At',
  ];
  const lines = [headers.join(',')];
  for (const r of rows) {
    const rowValues = [
      `"${r.observationId}"`,
      `"${r.canonicalUrl.replace(/"/g, '""')}"`,
      `"${(r.filename ?? '').replace(/"/g, '""')}"`,
      `"${r.kind}"`,
      `"${r.status}"`,
      `"${r.responseStatusCode ?? ''}"`,
      `"${r.contentLength ?? ''}"`,
      `"${(r.tabTitle ?? '').replace(/"/g, '""')}"`,
      `"${(r.userAgent ?? '').replace(/"/g, '""')}"`,
      `"${(r.initiator ?? '').replace(/"/g, '""')}"`,
      `"${r.observedAt}"`,
    ];
    lines.push(rowValues.join(','));
  }
  return lines.join('\n');
}

function generateTxtExport(rows: readonly ResourceHistoryRow[]): string {
  return rows.map((r) => r.canonicalUrl).join('\n');
}

function triggerFileDownload(content: string, filename: string, mimeType: string): void {
  const blob = new Blob([content], { type: mimeType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function runExport(): void {
  const rows = filteredExportRows.value;
  if (rows.length === 0) return;
  const dateStr = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
  const ext = exportFormat.value === 'json' ? 'json' : exportFormat.value === 'csv' ? 'csv' : 'txt';
  const mime = exportFormat.value === 'json' ? 'application/json' : exportFormat.value === 'csv' ? 'text/csv' : 'text/plain';
  const filename = `crsniffer-export-${dateStr}.${ext}`;

  let content = '';
  if (exportFormat.value === 'json') content = generateJsonExport(rows);
  else if (exportFormat.value === 'csv') content = generateCsvExport(rows);
  else content = generateTxtExport(rows);

  triggerFileDownload(content, filename, mime);
  exportStatus.value = uiFormat('export_finished', [rows.length, filename]);
}

async function copyExportedUrls(): Promise<void> {
  const rows = filteredExportRows.value;
  if (rows.length === 0) return;
  const text = generateTxtExport(rows);
  try {
    await navigator.clipboard.writeText(text);
    exportStatus.value = uiFormat('copied_urls', [rows.length]);
  } catch {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    document.body.removeChild(textarea);
    exportStatus.value = uiFormat('copied_urls', [rows.length]);
  }
}

