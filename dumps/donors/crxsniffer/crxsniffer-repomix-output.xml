test('a non-matching condition short-circuits later conditions and skips actions structurally', async () => {
  const seeded = await session({ nonMatchingFirstCondition: true });
  const result = evaluateResourceCandidate({ session: seeded.session, observation: observation() });
  const rule = result.explanation.packagizer?.rules.find((entry) => entry.ruleId === IDS.ruleA);
