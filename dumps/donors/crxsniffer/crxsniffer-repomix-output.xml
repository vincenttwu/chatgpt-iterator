    def test_iteration_manager_seals_and_verifies_reconstructable_diff(self) -> None:
        repo = self.make_repo()
        created = self.run_manager(repo, "create", "testing", "v0.1.0", "--base", "HEAD", "--summary", "Change app")
        self.assertEqual(created.returncode, 0, created.stdout + created.stderr)
        iteration = repo / "iterations" / "testing.v0.1.0"
        change_path = iteration / "change.md"
        self.assertTrue(change_path.is_file())
        change = change_path.read_text(encoding="utf-8").replace(
            "- Describe the bounded implementation change.",
            "- Changed the app payload.",
        ).replace(
            "- Record validation performed, or state that validation is pending.",
            "- Verified the iteration replay path.",
        )
        change_path.write_text(change, encoding="utf-8")
        (repo / "app.txt").write_text("result\n", encoding="utf-8")

        rendered = self.run_manager(repo, "changelog", "testing", "v0.1.0")
        self.assertEqual(rendered.returncode, 0, rendered.stdout + rendered.stderr)
        changelog = (repo / "CHANGELOG.md").read_text(encoding="utf-8")
