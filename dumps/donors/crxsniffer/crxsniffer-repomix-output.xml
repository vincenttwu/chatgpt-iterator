<file path="src/core/envelope.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  CONTRACT_ERROR_SCHEMA_VERSION,
  type ContractErrorCode,
  type ContractErrorPayload,
} from './errors.ts';
import {
  createStableId,
  isStableId,
  requireStableId,
  type StableId,
  type StableIdKind,
} from './ids.ts';
import { assertJsonSafe, cloneJsonValue, freezeJsonValue } from './json.ts';
import type { JsonObject, JsonValue } from './types.ts';
import {
  MESSAGE_PROTOCOL_VERSION,
  MESSAGE_SCHEMA_VERSION,
} from './versions.ts';

const OPERATION_PATTERN = /^[a-z][a-z0-9]*(?:\.[a-z][a-z0-9]*)*$/;

export interface MessageContext extends JsonObject {
  readonly watchSessionId?: StableId<'watchSession'>;
  readonly tabId?: number;
  readonly documentId?: string;
}

export interface RequestEnvelope<P extends JsonObject = JsonObject> extends JsonObject {
  readonly kind: 'request';
  readonly schemaVersion: number;
  readonly protocolVersion: number;
  readonly messageId: StableId<'message'>;
  readonly requestId: StableId<'request'>;
  readonly operation: string;
  readonly context: MessageContext;
  readonly payload: P;
}

export interface SuccessOutcome<R extends JsonValue = JsonValue> extends JsonObject {
  readonly ok: true;
  readonly value: R;
}

export interface FailureOutcome extends JsonObject {
  readonly ok: false;
  readonly error: ContractErrorPayload;
}

export type ResponseOutcome<R extends JsonValue = JsonValue> = SuccessOutcome<R> | FailureOutcome;

export interface ResponseEnvelope<R extends JsonValue = JsonValue> extends JsonObject {
  readonly kind: 'response';
  readonly schemaVersion: number;
  readonly protocolVersion: number;
  readonly messageId: StableId<'message'>;
  readonly requestId: StableId<'request'>;
  readonly operation: string;
  readonly context: MessageContext;
  readonly outcome: ResponseOutcome<R>;
}

export type MessageEnvelope = RequestEnvelope | ResponseEnvelope;

export type IdFactory = <K extends StableIdKind>(kind: K) => StableId<K>;

const defaultIdFactory: IdFactory = <K extends StableIdKind>(kind: K): StableId<K> =>
  createStableId(kind);

function requireOnlyKeys(
  value: JsonObject,
  allowed: readonly string[],
  path: string,
): void {
  const allowedSet = new Set(allowed);
  for (const key of Object.keys(value)) {
    if (!allowedSet.has(key)) {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidMessage,
        `unknown field at ${path}: ${key}`,
        { path, field: key },
      );
    }
  }
}

function requireOperation(value: unknown): string {
  if (typeof value !== 'string' || !OPERATION_PATTERN.test(value)) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidMessage,
      'operation must be dot-separated lowercase identifiers',
    );
  }
  return value;
}

function requireContext(value: unknown): MessageContext {
  assertJsonSafe(value, '$.context');
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'context must be an object');
  }

  const candidate = value as JsonObject;
  requireOnlyKeys(candidate, ['watchSessionId', 'tabId', 'documentId'], '$.context');

  const context: {
    watchSessionId?: StableId<'watchSession'>;
    tabId?: number;
    documentId?: string;
  } = {};

  if (candidate.watchSessionId !== undefined) {
    context.watchSessionId = requireStableId(candidate.watchSessionId, 'watchSession');
  }
  if (candidate.tabId !== undefined) {
    if (!Number.isSafeInteger(candidate.tabId) || (candidate.tabId as number) < 0) {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidMessage,
        'context.tabId must be a non-negative safe integer',
      );
    }
    context.tabId = candidate.tabId as number;
  }
  if (candidate.documentId !== undefined) {
    if (
      typeof candidate.documentId !== 'string'
      || candidate.documentId.length === 0
      || candidate.documentId.length > 256
    ) {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidMessage,
        'context.documentId must be a non-empty string of at most 256 characters',
      );
    }
    context.documentId = candidate.documentId;
  }

  return Object.freeze(context) as MessageContext;
}

function requireCurrentVersions(candidate: JsonObject): void {
  if (candidate.protocolVersion !== MESSAGE_PROTOCOL_VERSION) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.unsupportedProtocolVersion,
      `Unsupported protocolVersion: ${String(candidate.protocolVersion)}`,
      { supported: MESSAGE_PROTOCOL_VERSION },
    );
  }
  if (candidate.schemaVersion !== MESSAGE_SCHEMA_VERSION) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.unsupportedSchemaVersion,
      `Unsupported message schemaVersion: ${String(candidate.schemaVersion)}`,
      { supported: MESSAGE_SCHEMA_VERSION },
    );
  }
}

function freezeEnvelope<T extends MessageEnvelope>(envelope: T): T {
  freezeJsonValue(envelope);
  return envelope;
}

export function createRequestEnvelope<P extends JsonObject>(input: {
  readonly operation: string;
  readonly payload: P;
  readonly context?: MessageContext;
  readonly idFactory?: IdFactory;
}): RequestEnvelope<P> {
  const idFactory = input.idFactory ?? defaultIdFactory;
  const payload = cloneJsonValue(input.payload);
  const context = requireContext(input.context ?? {});

  return freezeEnvelope({
    kind: 'request',
    schemaVersion: MESSAGE_SCHEMA_VERSION,
    protocolVersion: MESSAGE_PROTOCOL_VERSION,
    messageId: idFactory('message'),
    requestId: idFactory('request'),
    operation: requireOperation(input.operation),
    context,
    payload,
  });
}

export function createSuccessResponse<R extends JsonValue>(
  request: RequestEnvelope,
  value: R,
  idFactory: IdFactory = defaultIdFactory,
): ResponseEnvelope<R> {
  const result = cloneJsonValue(value);
  return freezeEnvelope({
    kind: 'response',
    schemaVersion: MESSAGE_SCHEMA_VERSION,
    protocolVersion: MESSAGE_PROTOCOL_VERSION,
    messageId: idFactory('message'),
    requestId: request.requestId,
    operation: request.operation,
    context: request.context,
    outcome: { ok: true, value: result },
  });
}

export function createFailureResponse(
  request: RequestEnvelope,
  error: ContractErrorPayload,
  idFactory: IdFactory = defaultIdFactory,
): ResponseEnvelope {
  assertJsonSafe(error, '$.outcome.error');
  const validatedError = requireErrorPayload(error);
  return freezeEnvelope({
    kind: 'response',
    schemaVersion: MESSAGE_SCHEMA_VERSION,
    protocolVersion: MESSAGE_PROTOCOL_VERSION,
    messageId: idFactory('message'),
    requestId: request.requestId,
    operation: request.operation,
    context: request.context,
    outcome: { ok: false, error: cloneJsonValue(validatedError) },
  });
}

function requireErrorPayload(value: JsonValue): ContractErrorPayload {
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'error payload must be an object');
  }
  const candidate = value as JsonObject;
  requireOnlyKeys(candidate, ['schemaVersion', 'code', 'message', 'details'], '$.outcome.error');
  if (candidate.schemaVersion !== CONTRACT_ERROR_SCHEMA_VERSION) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.unsupportedSchemaVersion,
      `Unsupported error schemaVersion: ${String(candidate.schemaVersion)}`,
      { supported: CONTRACT_ERROR_SCHEMA_VERSION },
    );
  }
  if (typeof candidate.code !== 'string' || typeof candidate.message !== 'string') {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidMessage,
      'error payload requires string code and message',
    );
  }

  const validCodes = new Set<string>(Object.values(CONTRACT_ERROR_CODES));
  if (!validCodes.has(candidate.code)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'unknown error code');
  }
  if (candidate.details !== undefined) {
    if (candidate.details === null || Array.isArray(candidate.details) || typeof candidate.details !== 'object') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'error details must be an object');
    }
  }

  return candidate as ContractErrorPayload;
}

/** Validate an unknown cross-context value and return a frozen current-version envelope. */
export function requireMessageEnvelope(value: unknown): MessageEnvelope {
  assertJsonSafe(value);
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'message envelope must be an object');
  }

  const candidate = value as JsonObject;
  requireOnlyKeys(
    candidate,
    ['kind', 'schemaVersion', 'protocolVersion', 'messageId', 'requestId', 'operation', 'context', 'payload', 'outcome'],
    '$',
  );
  requireCurrentVersions(candidate);
  const messageId = requireStableId(candidate.messageId, 'message');
  const requestId = requireStableId(candidate.requestId, 'request');
  const operation = requireOperation(candidate.operation);
  const context = requireContext(candidate.context);

  if (candidate.kind === 'request') {
    if (candidate.payload === undefined) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'request payload is required');
    }
    if (candidate.payload === null || Array.isArray(candidate.payload) || typeof candidate.payload !== 'object') {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidMessage,
        'request payload must be a JSON object',
      );
    }
    return freezeEnvelope({
      kind: 'request',
      schemaVersion: MESSAGE_SCHEMA_VERSION,
      protocolVersion: MESSAGE_PROTOCOL_VERSION,
      messageId,
      requestId,
      operation,
      context,
      payload: cloneJsonValue(candidate.payload as JsonObject),
    });
  }

  if (candidate.kind === 'response') {
    const outcomeValue = candidate.outcome;
    if (outcomeValue === null || Array.isArray(outcomeValue) || typeof outcomeValue !== 'object') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'response outcome must be an object');
    }

    const outcome = outcomeValue as JsonObject;
    if (outcome.ok === true) {
      requireOnlyKeys(outcome, ['ok', 'value'], '$.outcome');
    } else if (outcome.ok === false) {
      requireOnlyKeys(outcome, ['ok', 'error'], '$.outcome');
    }
    if (outcome.ok === true && outcome.value !== undefined) {
      return freezeEnvelope({
        kind: 'response',
        schemaVersion: MESSAGE_SCHEMA_VERSION,
        protocolVersion: MESSAGE_PROTOCOL_VERSION,
        messageId,
        requestId,
        operation,
        context,
        outcome: { ok: true, value: cloneJsonValue(outcome.value) },
      });
    }

    if (outcome.ok === false && outcome.error !== undefined) {
      return freezeEnvelope({
        kind: 'response',
        schemaVersion: MESSAGE_SCHEMA_VERSION,
        protocolVersion: MESSAGE_PROTOCOL_VERSION,
        messageId,
        requestId,
        operation,
        context,
        outcome: { ok: false, error: requireErrorPayload(outcome.error) },
      });
    }

    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'invalid response outcome');
  }

  throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'unknown message kind');
}

/** Convenience builder for a bounded error payload. */
export function createErrorPayload(
  code: ContractErrorCode,
  message: string,
  details?: JsonObject,
): ContractErrorPayload {
  const payload = details === undefined
    ? { schemaVersion: CONTRACT_ERROR_SCHEMA_VERSION, code, message }
    : { schemaVersion: CONTRACT_ERROR_SCHEMA_VERSION, code, message, details };
  assertJsonSafe(payload);
  return freezeJsonValue(cloneJsonValue(payload)) as ContractErrorPayload;
}
</file>

