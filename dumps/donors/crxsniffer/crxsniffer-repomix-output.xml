/** Primitive values that survive a strict JSON round trip without coercion. */
export type JsonPrimitive = null | boolean | number | string;

/** Strict JSON object shape used at persistence and cross-context boundaries. */
export type JsonObject = { readonly [key: string]: JsonValue };

/** Strict JSON value shape used at persistence and cross-context boundaries. */
export type JsonValue = JsonPrimitive | readonly JsonValue[] | JsonObject;
