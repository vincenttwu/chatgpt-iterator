<file path="src/packagizer/conditions.ts">
import {
  freezeJsonValue,
  isMissing,
  type JsonPrimitive,
  type MaybeJsonValue,
} from '../core/index.ts';
import { compileResourceGlob } from '../resources/index.ts';
import { PACKAGIZER_ERROR_CODES, PackagizerError } from './errors.ts';
import { resolvePackagizerToken } from './tokens.ts';
import type {
  PackagizerCondition,
  PackagizerConditionOperator,
  PackagizerEvaluationInput,
  PackagizerTokenState,
} from './types.ts';

function samePrimitive(left: MaybeJsonValue, right: JsonPrimitive): boolean {
  return !isMissing(left)
    && (left === null || typeof left === 'string' || typeof left === 'number' || typeof left === 'boolean')
    && left === right;
}

function requireString(value: MaybeJsonValue, token: string): string | undefined {
  if (isMissing(value)) return undefined;
  if (typeof value !== 'string') {
    throw new PackagizerError(
      PACKAGIZER_ERROR_CODES.tokenTypeMismatch,
      `Condition token ${token} must resolve to a string`,
    );
  }
  return value;
}

function requireNumber(value: MaybeJsonValue, token: string): number | undefined {
  if (isMissing(value)) return undefined;
  if (typeof value !== 'number') {
    throw new PackagizerError(
      PACKAGIZER_ERROR_CODES.tokenTypeMismatch,
      `Condition token ${token} must resolve to a number`,
    );
  }
  return value;
}

function evaluateResolvedCondition(
  condition: PackagizerCondition,
  actual: MaybeJsonValue,
): boolean {
  const operator: PackagizerConditionOperator = condition.operator;
  switch (operator) {
    case 'exists': return !isMissing(actual);
    case 'missing': return isMissing(actual);
    case 'equals': return samePrimitive(actual, condition.value!);
    case 'not_equals': return !isMissing(actual) && !samePrimitive(actual, condition.value!);
    case 'contains': {
      const value = requireString(actual, condition.token);
      return value !== undefined && value.includes(condition.value as string);
    }
    case 'starts_with': {
      const value = requireString(actual, condition.token);
      return value !== undefined && value.startsWith(condition.value as string);
    }
    case 'ends_with': {
      const value = requireString(actual, condition.token);
      return value !== undefined && value.endsWith(condition.value as string);
    }
    case 'glob': {
      const value = requireString(actual, condition.token);
      return value !== undefined && compileResourceGlob(condition.value as string).test(value);
    }
    case 'lt': {
      const value = requireNumber(actual, condition.token);
      return value !== undefined && value < (condition.value as number);
    }
    case 'lte': {
      const value = requireNumber(actual, condition.token);
      return value !== undefined && value <= (condition.value as number);
    }
    case 'gt': {
      const value = requireNumber(actual, condition.token);
      return value !== undefined && value > (condition.value as number);
    }
    case 'gte': {
      const value = requireNumber(actual, condition.token);
      return value !== undefined && value >= (condition.value as number);
    }
  }
}

export interface PackagizerConditionEvaluation {
  readonly matched: boolean;
  readonly sourceState: PackagizerTokenState;
}

/** Evaluate once and retain only structural token state, never the resolved token value. */
export function evaluatePackagizerConditionDetailed(
  condition: PackagizerCondition,
  input: PackagizerEvaluationInput,
): PackagizerConditionEvaluation {
  const actual = resolvePackagizerToken(condition.token, input);
  const sourceState: PackagizerTokenState = isMissing(actual) ? 'missing' : 'value';
  return freezeJsonValue({
    matched: evaluateResolvedCondition(condition, actual),
    sourceState,
  });
}

export function evaluatePackagizerCondition(
  condition: PackagizerCondition,
  input: PackagizerEvaluationInput,
): boolean {
  return evaluatePackagizerConditionDetailed(condition, input).matched;
}
</file>

