import { freezeJsonValue } from '../core/index.ts';

export interface DownloadTemplateContext {
  readonly originUrl?: string;
  readonly pageUrl?: string;
  readonly refererUrl?: string;
  readonly canonicalUrl?: string;
  readonly resourceUrl?: string;
  readonly kind?: string;
  readonly mimeType?: string;
  readonly title?: string;
  readonly filename?: string;
}

export const DEFAULT_DOWNLOAD_SAMPLE_CONTEXT: Required<DownloadTemplateContext> = freezeJsonValue({
  originUrl: 'https://example.com',
  pageUrl: 'https://example.com/videos/nature-clip',
  refererUrl: 'https://example.com/watch',
  canonicalUrl: 'https://example.com/videos/nature-clip',
  resourceUrl: 'https://cdn.example.com/media/sample_video.mp4',
  kind: 'video',
  mimeType: 'video/mp4',
  title: 'Nature Clip Sample',
  filename: 'sample_video.mp4',
});

function sanitizePathSegment(value: string): string {
  return value
    .replaceAll(/[\u0000-\u001f\u007f<>:"/\\|?*]/gu, '_')
    .replaceAll(/\s+/gu, ' ')
    .trim();
}

function parseUrl(urlStr: string | undefined): URL | null {
  if (urlStr === undefined || urlStr.trim() === '') return null;
  try {
    return new URL(urlStr);
  } catch {
    return null;
  }
}

function extractUrlMetadata(
  urlStr: string | undefined,
  extractor: string,
  indexStr?: string,
): string | null {
  const parsed = parseUrl(urlStr);
  if (parsed === null) return null;

  const pathname = parsed.pathname;
  const segments = pathname
    .split('/')
    .map((segment) => {
      try {
        return decodeURIComponent(segment).trim();
      } catch {
        return segment.trim();
      }
    })
    .filter((segment) => segment.length > 0);

  const lastSegment = segments.length > 0 ? segments[segments.length - 1]! : '';
  const dotIndex = lastSegment.lastIndexOf('.');
  const basename = dotIndex > 0 ? lastSegment.slice(0, dotIndex) : lastSegment;
  const ext = dotIndex > 0 && dotIndex < lastSegment.length - 1 ? lastSegment.slice(dotIndex + 1) : '';

  switch (extractor) {
    case 'domain':
    case 'host':
      return parsed.hostname;
    case 'path':
      return pathname;
    case 'slug': {
      if (indexStr !== undefined) {
        const parsedIndex = Number.parseInt(indexStr, 10);
        if (Number.isNaN(parsedIndex)) return null;
        const targetIndex = parsedIndex < 0 ? segments.length + parsedIndex : parsedIndex;
        if (targetIndex < 0 || targetIndex >= segments.length) return null;
        return segments[targetIndex] ?? null;
      }
      return segments.join('/');
    }
    case 'filename':
      return lastSegment !== '' ? lastSegment : null;
    case 'basename':
      return basename !== '' ? basename : null;
    case 'ext':
      return ext !== '' ? ext : null;
    default:
      return null;
  }
}

export function resolveDownloadPathTemplate(
  template: string,
  context: DownloadTemplateContext = DEFAULT_DOWNLOAD_SAMPLE_CONTEXT,
): string {
  if (typeof template !== 'string' || template.trim() === '') {
    return 'example.com/video/sample_video.mp4';
  }

  const sample = { ...DEFAULT_DOWNLOAD_SAMPLE_CONTEXT, ...context };

  const resolved = template.replaceAll(/\{([^}]+)\}/g, (match, rawToken: string) => {
    const trimmed = rawToken.trim();
    if (trimmed === '') return match;

    // Pattern: <url_source>::<extractor>[<index>]
    const doubleColonMatch = /^([a-z0-9_]+)::([a-z0-9_]+)(?:\[(-?\d+)\])?$/i.exec(trimmed);
    if (doubleColonMatch !== null) {
      const sourceName = doubleColonMatch[1]!.toLowerCase();
      const extractor = doubleColonMatch[2]!.toLowerCase();
      const indexStr = doubleColonMatch[3];

      let targetUrl: string | undefined;
      switch (sourceName) {
        case 'origin_url':
        case 'origin':
          targetUrl = sample.originUrl;
          break;
        case 'page_url':
        case 'page':
          targetUrl = sample.pageUrl;
          break;
        case 'referer_url':
        case 'referer':
          targetUrl = sample.refererUrl;
          break;
        case 'canonical_url':
        case 'canonical':
          targetUrl = sample.canonicalUrl;
          break;
        case 'resource_url':
        case 'resource':
          targetUrl = sample.resourceUrl;
          break;
        default:
          break;
      }

      if (targetUrl !== undefined) {
        const extracted = extractUrlMetadata(targetUrl, extractor, indexStr);
        if (extracted !== null && extracted.trim() !== '') {
          return sanitizePathSegment(extracted);
        }
      }
    }

    // Direct token fallbacks
    const normalized = trimmed.toLowerCase();

    if (normalized === 'domain' || normalized === 'host') {
      const domain = extractUrlMetadata(sample.originUrl ?? sample.pageUrl, 'domain');
      return sanitizePathSegment(domain ?? 'unknown_domain');
    }

    if (normalized === 'kind' || normalized === 'type') {
      return sanitizePathSegment(sample.kind ?? 'other');
    }

    if (normalized === 'mime' || normalized === 'mime_type') {
      return sanitizePathSegment((sample.mimeType ?? 'other').replaceAll('/', '_'));
    }

    if (normalized === 'title') {
      return sanitizePathSegment(sample.title ?? 'untitled');
    }

    if (normalized === 'filename') {
      return sanitizePathSegment(sample.filename ?? 'file');
    }

    if (normalized === 'basename') {
      const fn = sample.filename ?? 'file';
      const idx = fn.lastIndexOf('.');
      return sanitizePathSegment(idx > 0 ? fn.slice(0, idx) : fn);
    }

    if (normalized === 'ext') {
      const fn = sample.filename ?? 'file';
      const idx = fn.lastIndexOf('.');
      return sanitizePathSegment(idx > 0 && idx < fn.length - 1 ? fn.slice(idx + 1) : '');
    }

    return match;
  });

  // Normalize multiple slashes and collapse empty segments
  return resolved
    .replaceAll(/\\+/g, '/')
    .replaceAll(/\/+/g, '/')
    .replaceAll(/^\/|\/$/g, '')
    .trim();
}
