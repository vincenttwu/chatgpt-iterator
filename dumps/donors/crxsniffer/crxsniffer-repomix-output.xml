<file path="src/observations/validation.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  freezeJsonValue,
  requireJsonObject,
  requireRevision,
  requireStableId,
  type JsonObject,
  type JsonValue,
} from '../core/index.ts';
import { requireIsoTimestamp, type IsoTimestamp } from '../persistence/index.ts';
import {
  OBSERVATION_PENDING_SCHEMA_VERSION,
  OBSERVATION_VALUE_SCHEMA_VERSION,
  type ObservationHop,
  type ObservationTerminal,
  type PendingObservationTrace,
  type ResourceObservationValue,
  type WebRequestHeader,
} from './types.ts';

const MIME_ESSENCE = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+\/[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;

function requiredString(value: unknown, label: string): string {
  if (typeof value !== 'string' || value.length === 0) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be a non-empty string`, { label });
  }
  return value;
}

function requiredInteger(value: unknown, label: string, minimum = 0): number {
  if (!Number.isSafeInteger(value) || (value as number) < minimum) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, `${label} must be a safe integer >= ${minimum}`, { label });
  }
  return value as number;
}

export function webRequestTimestamp(value: number): IsoTimestamp {
  if (!Number.isFinite(value)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'webRequest timeStamp must be finite');
  }
  let iso: string;
  try {
    iso = new Date(value).toISOString();
  } catch {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'webRequest timeStamp is outside the supported Date range');
  }
  return requireIsoTimestamp(iso);
}

export function isHttpUrl(value: string): boolean {
  try {
    const url = new URL(value);
    return url.protocol === 'http:' || url.protocol === 'https:';
  } catch {
    return false;
  }
}

export function contentTypeMimeEssence(headers: readonly WebRequestHeader[] | undefined): string | undefined {
  if (headers === undefined) return undefined;
  for (const header of headers) {
    if (header.name.toLowerCase() !== 'content-type' || typeof header.value !== 'string') continue;
    const essence = header.value.split(';', 1)[0]?.trim().toLowerCase();
    if (essence !== undefined && MIME_ESSENCE.test(essence)) return essence;
  }
  return undefined;
}

export function contentLengthFromHeaders(headers: readonly WebRequestHeader[] | undefined): number | undefined {
  if (headers === undefined) return undefined;
  for (const header of headers) {
    if (header.name.toLowerCase() !== 'content-length' || typeof header.value !== 'string') continue;
    const bytes = parseInt(header.value.trim(), 10);
    if (Number.isSafeInteger(bytes) && bytes >= 0) return bytes;
  }
  return undefined;
}

function requireHop(value: JsonValue): ObservationHop {
  const hop = requireJsonObject(value);
  const kind = requiredString(hop.kind, 'hop.kind');
  requiredString(hop.url, 'hop.url');
  requireIsoTimestamp(hop.at, 'hop.at');
  requiredInteger(hop.statusCode, 'hop.statusCode', 100);
  if (kind === 'redirect') {
    requiredString(hop.redirectUrl, 'hop.redirectUrl');
    return freezeJsonValue(hop) as unknown as ObservationHop;
  }
  if (kind === 'auth_challenge' && (hop.statusCode === 401 || hop.statusCode === 407)) {
    return freezeJsonValue(hop) as unknown as ObservationHop;
  }
  throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'unsupported observation hop');
}

function requireTerminal(value: JsonValue): ObservationTerminal {
  const terminal = requireJsonObject(value);
  const kind = requiredString(terminal.kind, 'terminal.kind');
  requireIsoTimestamp(terminal.at, 'terminal.at');
  if (kind === 'completed') {
    requiredInteger(terminal.statusCode, 'terminal.statusCode', 100);
    return freezeJsonValue(terminal) as unknown as ObservationTerminal;
  }
  if (kind === 'error') {
    requiredString(terminal.error, 'terminal.error');
    return freezeJsonValue(terminal) as unknown as ObservationTerminal;
  }
  if (kind === 'redirect_out_of_scope') {
    requiredInteger(terminal.statusCode, 'terminal.statusCode', 100);
    requiredString(terminal.redirectUrl, 'terminal.redirectUrl');
    return freezeJsonValue(terminal) as unknown as ObservationTerminal;
  }
  throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'unsupported observation terminal');
}


function requireAttribution(record: JsonObject): void {
  const status = record.attributionStatus;
  if (status === undefined) {
    if (record.topDocumentId !== undefined || record.pageRevision !== undefined) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'observation attribution identity requires attributionStatus');
    }
    return;
  }
  if (status !== 'exact_top_document' && status !== 'exact_descendant' &&
      status !== 'unattributed' && status !== 'stale_or_ambiguous') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'unsupported observation attributionStatus');
  }
  const exact = status === 'exact_top_document' || status === 'exact_descendant';
  if (exact) {
    requiredString(record.topDocumentId, 'topDocumentId');
    requireRevision(record.pageRevision);
    return;
  }
  if (record.topDocumentId !== undefined || record.pageRevision !== undefined) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidArgument,
      'non-exact observation attribution must not carry topDocumentId/pageRevision',
    );
  }
}

function requireCommon(record: JsonObject): void {
  requiredString(record.requestId, 'requestId');
  requiredInteger(record.tabId, 'tabId');
  requiredString(record.method, 'method');
  requiredString(record.requestType, 'requestType');
  requireIsoTimestamp(record.startedAt, 'startedAt');
  if (typeof record.startedWithBeforeRequest !== 'boolean') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'startedWithBeforeRequest must be boolean');
  }
  requiredString(record.initialUrl, 'initialUrl');
  if (record.initiator !== undefined) requiredString(record.initiator, 'initiator');
  requiredInteger(record.frameId, 'frameId', -1);
  if (record.parentFrameId !== undefined) requiredInteger(record.parentFrameId, 'parentFrameId', -1);
  if (record.documentId !== undefined) requiredString(record.documentId, 'documentId');
  if (record.parentDocumentId !== undefined) requiredString(record.parentDocumentId, 'parentDocumentId');
  requireAttribution(record);
  if (!Array.isArray(record.hops)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'hops must be an array');
  }
  for (const hop of record.hops) requireHop(hop as JsonValue);
  if (record.responseStatusCode !== undefined) requiredInteger(record.responseStatusCode, 'responseStatusCode', 100);
  if (record.responseMimeType !== undefined) {
    const mime = requiredString(record.responseMimeType, 'responseMimeType');
    if (!MIME_ESSENCE.test(mime)) throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'invalid responseMimeType');
  }
  if (record.contentLength !== undefined) requiredInteger(record.contentLength, 'contentLength', 0);
  if (record.tabTitle !== undefined) requiredString(record.tabTitle, 'tabTitle');
  if (record.userAgent !== undefined) requiredString(record.userAgent, 'userAgent');
  if (record.fromCache !== undefined && typeof record.fromCache !== 'boolean') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, 'fromCache must be boolean');
  }
}

export function requirePendingObservationTrace(value: unknown): PendingObservationTrace {
  const record = requireJsonObject(value as JsonValue);
  if (record.schemaVersion !== OBSERVATION_PENDING_SCHEMA_VERSION) {
    throw new ContractError(CONTRACT_ERROR_CODES.unsupportedSchemaVersion, 'unsupported pending observation schemaVersion');
  }
  requireStableId(record.observationId, 'resourceObservation');
  requireStableId(record.watchSessionId, 'watchSession');
  requireCommon(record);
  requiredString(record.currentUrl, 'currentUrl');
  if (record.terminal !== undefined) requireTerminal(record.terminal as JsonValue);
  return freezeJsonValue(record) as unknown as PendingObservationTrace;
}

export function requireResourceObservationValue(value: unknown): ResourceObservationValue {
  const record = requireJsonObject(value as JsonValue);
  if (record.schemaVersion !== OBSERVATION_VALUE_SCHEMA_VERSION) {
    throw new ContractError(CONTRACT_ERROR_CODES.unsupportedSchemaVersion, 'unsupported observation schemaVersion');
  }
  requireCommon(record);
  requireIsoTimestamp(record.endedAt, 'endedAt');
  requiredString(record.finalUrl, 'finalUrl');
  if (record.terminal === undefined) {
    throw new ContractError(CONTRACT_ERROR_CODES.missingRequiredValue, 'terminal is required');
  }
  requireTerminal(record.terminal as JsonValue);
  return freezeJsonValue(record) as unknown as ResourceObservationValue;
}
