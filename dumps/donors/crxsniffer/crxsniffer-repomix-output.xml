import { freezeJsonValue } from '../core/index.ts';
import type { ResourceObservationValue } from '../observations/index.ts';
import { canonicalizeResourceUrl } from './canonical-url.ts';
import type {
  ResourceClassification,
  ResourceClassificationReason,
  ResourceKind,
} from './types.ts';

const STREAM_MANIFEST_MIME_TYPES = new Set([
  'application/vnd.apple.mpegurl',
  'audio/mpegurl',
  'application/dash+xml',
]);

const GENERIC_MIME_TYPES = new Set([
  'application/octet-stream',
  'application/mp4',
]);

const EXTENSION_KINDS: Readonly<Record<string, ResourceKind>> = Object.freeze({
  '.m3u': 'stream_manifest',
  '.m3u8': 'stream_manifest',
  '.mpd': 'stream_manifest',
  '.apng': 'image',
  '.avif': 'image',
  '.bmp': 'image',
  '.gif': 'image',
  '.ico': 'image',
  '.jpeg': 'image',
  '.jpg': 'image',
  '.png': 'image',
  '.svg': 'image',
  '.webp': 'image',
  '.3g2': 'video',
  '.3gp': 'video',
  '.m4v': 'video',
  '.mkv': 'video',
  '.mov': 'video',
  '.mp4': 'video',
  '.mpeg': 'video',
  '.mpg': 'video',
  '.ogv': 'video',
  '.webm': 'video',
  '.aac': 'audio',
  '.flac': 'audio',
  '.m4a': 'audio',
  '.mp3': 'audio',
  '.oga': 'audio',
  '.ogg': 'audio',
  '.opus': 'audio',
  '.wav': 'audio',
  '.weba': 'audio',
});

function mimeKind(mimeType: string | undefined): ResourceKind | undefined {
  if (mimeType === undefined || GENERIC_MIME_TYPES.has(mimeType)) return undefined;
  if (STREAM_MANIFEST_MIME_TYPES.has(mimeType)) return 'stream_manifest';
  if (mimeType.startsWith('image/')) return 'image';
  if (mimeType.startsWith('video/')) return 'video';
  if (mimeType.startsWith('audio/')) return 'audio';
  if (mimeType.includes('/')) return 'other';
  return undefined;
}

function reasonForMime(kind: ResourceKind): ResourceClassificationReason {
  if (kind === 'stream_manifest') return 'mime_stream_manifest';
  if (kind === 'image') return 'mime_image';
  if (kind === 'video') return 'mime_video';
  if (kind === 'audio') return 'mime_audio';
  return 'mime_other';
}

function reasonForExtension(kind: ResourceKind): ResourceClassificationReason {
  if (kind === 'stream_manifest') return 'extension_stream_manifest';
  if (kind === 'image') return 'extension_image';
  if (kind === 'video') return 'extension_video';
  return 'extension_audio';
}

export function classifyResource(value: ResourceObservationValue): ResourceClassification {
  const canonical = canonicalizeResourceUrl(value.finalUrl);
  const extension = canonical.extension;
  const byMime = mimeKind(value.responseMimeType);
  const byExtension = extension === undefined ? undefined : EXTENSION_KINDS[extension];
  const conflict = byMime !== undefined && byExtension !== undefined && byMime !== byExtension;

  let kind: ResourceKind;
  let reason: ResourceClassificationReason;
  if (byMime !== undefined) {
    kind = byMime;
    reason = reasonForMime(byMime);
  } else if (value.requestType === 'image') {
    kind = 'image';
    reason = 'request_type_image';
  } else if (byExtension !== undefined) {
    kind = byExtension;
    reason = reasonForExtension(byExtension);
  } else if (value.requestType === 'media') {
    kind = 'unknown';
    reason = 'ambiguous_media';
  } else {
    kind = 'unknown';
    reason = 'no_decisive_evidence';
  }

  return freezeJsonValue({
    schemaVersion: 1,
    kind,
    reason,
    evidence: {
      requestType: value.requestType,
      ...(value.responseMimeType === undefined ? {} : { mimeType: value.responseMimeType }),
      ...(extension === undefined ? {} : { extension }),
      ...(byMime === undefined ? {} : { mimeKind: byMime }),
      ...(byExtension === undefined ? {} : { extensionKind: byExtension }),
      conflict,
    },
  }) as ResourceClassification;
}
</file>

