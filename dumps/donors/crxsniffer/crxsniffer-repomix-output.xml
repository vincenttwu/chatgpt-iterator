import { CONTRACT_ERROR_CODES, ContractError } from '../core/index.ts';

export interface ChromeExtensionSenderLike {
  readonly id?: string;
  readonly url?: string;
  readonly origin?: string;
}

function extensionOrigin(extensionId: string): string {
  return `chrome-extension://${extensionId}`;
}

/**
 * Privileged Crsniffer request/Port callers must be the current packaged extension itself.
 * Web pages and other extensions are never trusted even when they can reach Chrome's
 * external-connectable boundary in a future manifest or test harness.
 */
export function isTrustedExtensionSender(value: unknown, extensionId: string): boolean {
  if (typeof extensionId !== 'string' || extensionId.length === 0) return false;
  if (value === null || typeof value !== 'object') return false;
  const sender = value as ChromeExtensionSenderLike;
  if (sender.id !== extensionId) return false;
  const expectedOrigin = extensionOrigin(extensionId);
  if (sender.origin !== undefined && sender.origin !== expectedOrigin) return false;
  if (sender.url !== undefined) {
    try {
      const url = new URL(sender.url);
      if (url.protocol !== 'chrome-extension:' || url.host !== extensionId) return false;
    } catch {
      return false;
    }
  }
  return sender.origin === expectedOrigin || sender.url !== undefined;
}

export function requireTrustedExtensionSender(value: unknown, extensionId: string): ChromeExtensionSenderLike {
  if (!isTrustedExtensionSender(value, extensionId)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'untrusted Chrome extension sender');
  }
  return value as ChromeExtensionSenderLike;
}

/**
 * HTTP(S) resource identity keeps path/query semantics, but URL userinfo is never product
 * identity and may contain credentials. Non-HTTP(S) URLs are outside capture authority; retain
 * only the scheme so payload-bearing forms such as data: URLs cannot enter durable state.
 */
export function sanitizeObservedUrl(value: string): string {
  try {
    const url = new URL(value);
    if (url.protocol !== 'http:' && url.protocol !== 'https:') return url.protocol;
    if (url.username.length === 0 && url.password.length === 0) return value;
    url.username = '';
    url.password = '';
    return url.href;
  } catch {
    return 'invalid:';
  }
}
