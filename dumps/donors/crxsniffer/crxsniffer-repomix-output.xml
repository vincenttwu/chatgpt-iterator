import {
  MISSING,
  isMissing,
  type JsonValue,
  type MaybeJsonValue,
} from '../core/index.ts';
import { requireResourceObservationValue } from '../observations/index.ts';
import type { PackagizerEvaluationInput } from './types.ts';
import { PACKAGIZER_ERROR_CODES, PackagizerError } from './errors.ts';

const STATIC_TOKENS = new Set([
  'resource.url',
  'resource.host',
  'resource.path',
  'resource.filename',
  'resource.basename',
  'resource.extension',
  'resource.mime',
  'resource.kind',
  'resource.chrome_type',
  'resource.status',
  'resource.initiator',
  'resource.observed_at',
  'watch.started_at',
  'page.url',
  'page.title',
  'page.origin',
]);

const FIELD_TOKEN_PATTERN = /^field\.([a-z][a-z0-9_]{0,63})$/;

export function requirePackagizerTokenName(value: unknown): string {
  if (typeof value !== 'string') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidToken, 'Packagizer token must be a string');
  }
  if (STATIC_TOKENS.has(value) || FIELD_TOKEN_PATTERN.test(value)) return value;
  throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidToken, `Unsupported Packagizer token: ${value}`);
}

function decodedFilename(pathname: string): string {
  const raw = pathname.slice(pathname.lastIndexOf('/') + 1);
  if (raw === '') return '';
  try {
    return decodeURIComponent(raw);
  } catch {
    return raw;
  }
}

function filenameParts(filename: string): { basename: string; extension: string | typeof MISSING } {
  const index = filename.lastIndexOf('.');
  if (index <= 0 || index === filename.length - 1) {
    return { basename: filename, extension: MISSING };
  }
  return { basename: filename.slice(0, index), extension: filename.slice(index + 1) };
}

function optional(value: JsonValue | undefined): MaybeJsonValue {
  return value === undefined ? MISSING : value;
}

export function resolvePackagizerToken(
  tokenInput: string,
  input: PackagizerEvaluationInput,
): MaybeJsonValue {
  const token = requirePackagizerTokenName(tokenInput);
  const observation = requireResourceObservationValue(input.observation.value);
  const url = new URL(input.occurrence.canonicalUrl);
  const filename = decodedFilename(url.pathname);
  const parts = filenameParts(filename);

  switch (token) {
    case 'resource.url': return input.occurrence.canonicalUrl;
    case 'resource.host': return url.host;
    case 'resource.path': return url.pathname;
    case 'resource.filename': return filename;
    case 'resource.basename': return parts.basename;
    case 'resource.extension': return parts.extension;
    case 'resource.mime': return optional(observation.responseMimeType);
    case 'resource.kind': return input.occurrence.classification.kind;
    case 'resource.chrome_type': return observation.requestType;
    case 'resource.status': return optional(observation.responseStatusCode);
    case 'resource.initiator': return optional(observation.initiator);
    case 'resource.observed_at': return observation.endedAt;
    case 'watch.started_at': return input.watchStartedAt;
    case 'page.url': return input.page?.url === undefined ? MISSING : input.page.url;
    case 'page.title': return input.page?.title === undefined ? MISSING : input.page.title;
    case 'page.origin': return input.page?.origin === undefined ? MISSING : input.page.origin;
    default: {
      const match = FIELD_TOKEN_PATTERN.exec(token);
      if (match === null) {
        throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidToken, `Unsupported Packagizer token: ${token}`);
      }
      const fieldValue = input.page?.fields?.[match[1]!];
      return fieldValue === undefined ? MISSING : fieldValue;
    }
  }
}

export function requireRenderableTokenValue(value: MaybeJsonValue, token: string): string {
  if (isMissing(value)) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.missingToken, `Token ${token} is Missing`);
  }
  if (typeof value === 'string') return value;
  if (typeof value === 'number' || typeof value === 'boolean' || value === null) return String(value);
  throw new PackagizerError(
    PACKAGIZER_ERROR_CODES.tokenTypeMismatch,
    `Token ${token} is not a scalar value and cannot be rendered`,
  );
}
