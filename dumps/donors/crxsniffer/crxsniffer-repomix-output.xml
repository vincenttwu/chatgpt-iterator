    def test_top_level_guides_have_stable_yaml_and_content_ids(self) -> None:
        guides = ROOT / "agents" / "guides"
        registry = {
            "README.md": "GUID",
            "architecture.md": "ARCH",
            "topology.md": "TOPO",
            "boundaries.md": "BNDR",
            "flow.md": "FLOW",
            "workflows.md": "WKFL",
            "storage.md": "STOR",
            "persistence.md": "PERS",
            "configuration.md": "CONF",
            "coordination.md": "CORD",
            "security.md": "SECU",
            "observability.md": "OBSV",
            "testing.md": "TEST",
            "portability.md": "PORT",
            "naming.md": "NAME",
            "terminology.md": "TERM",
            "api.md": "API",
        }
        self.assertEqual(len(set(registry.values())), len(registry))
        all_ids: set[str] = set()
        artifact_ids: set[str] = set()
        for filename, prefix in registry.items():
            path = guides / filename
            text = path.read_text(encoding="utf-8")
            self.assertTrue(text.startswith("---\n"), filename)
            header_end = text.find("\n---\n", 4)
            self.assertGreater(header_end, 0, filename)
            header = text[4:header_end]
            self.assertRegex(header, rf"(?m)^artifact_id: GUIDE-(?:INDEX|{re.escape(prefix)})$")
            self.assertRegex(header, r"(?m)^artifact_type: guide$")
            self.assertRegex(header, rf"(?m)^  prefix: {re.escape(prefix)}$")
            artifact_id = re.search(r"(?m)^artifact_id: (\S+)$", header).group(1)
            self.assertNotIn(artifact_id, artifact_ids)
            artifact_ids.add(artifact_id)

            body = text[header_end + 5:]
            self.assertRegex(body, r"^\n?# [^\n]+\n\n\| ID \| Topic \| Summary \|", filename)
            table_ids = re.findall(rf"(?m)^\| `({re.escape(prefix)}-\d{{4}})` \|", body)
            section_ids = re.findall(rf"(?m)^## ({re.escape(prefix)}-\d{{4}}) - ", body)
            self.assertTrue(table_ids, filename)
            self.assertEqual(table_ids, section_ids, filename)
            self.assertEqual(len(table_ids), len(set(table_ids)), filename)
            for content_id in table_ids:
                self.assertNotIn(content_id, all_ids)
                all_ids.add(content_id)

            highest = max(int(value.rsplit("-", 1)[1]) for value in table_ids)
            next_match = re.search(rf"(?m)^  next_content_id: {re.escape(prefix)}-(\d{{4}})$", header)
            self.assertIsNotNone(next_match, filename)
            self.assertEqual(int(next_match.group(1)), highest + 1, filename)

        inbox = (guides / "conventions" / "README.md").read_text(encoding="utf-8")
        self.assertTrue(inbox.startswith("---\n"))
        self.assertIn("artifact_type: guide_inbox", inbox)
        self.assertIn("record_prefix: CONVENTION", inbox)

