import assert from 'node:assert/strict';
import test from 'node:test';

import { createStableId, type JsonObject } from '../../src/core/index.ts';
import {
  DefinitionCatalog,
  WatchSessionComposer,
  type ImmutableWatchSessionRecord,
} from '../../src/definitions/index.ts';
import {
  evaluateResourceCandidate,
  previewResourceCandidate,
  PackagizerResourcePreviewService,
  ResourceEvaluationService,
} from '../../src/evaluation/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  PERSISTENCE_STORES,
  JsonRecordRepository,
  requireDefinitionRecord,
  requireResourceObservationRecord,
  requireWatchSessionRecord,
  type DefinitionRecord,
  type RepositoryStorePort,
  type ResourceObservationRecord,
  type WatchSessionRecord,
} from '../../src/persistence/index.ts';
import {
  ObservationLifecycle,
  type PendingObservationStore,
  type PendingObservationTrace,
