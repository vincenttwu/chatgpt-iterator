from __future__ import annotations

import datetime as dt
import hashlib
import json
import re
from pathlib import Path
from typing import Any, Iterable

FRONTMATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n", re.DOTALL)
ID_RE = re.compile(r"\b([A-Z]+)-(\d{4})\b")


def workspace_root(script_file: str) -> Path:
    return Path(script_file).resolve().parents[2]


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def current_iteration(root: Path) -> str | None:
    """Resolve active version from the root manifest, with directory name only as fallback."""
    manifest = root / "iteration_manifest.json"
    if manifest.is_file():
        try:
            value = json.loads(manifest.read_text(encoding="utf-8")).get("iteration")
        except (OSError, json.JSONDecodeError):
            value = None
        if value:
            return str(value)
    match = re.search(r"(v\d+\.\d+\.\d+)$", root.name)
    return match.group(1) if match else None


def yaml_string(value: str) -> str:
    """Return a JSON-quoted string, which is also a valid YAML scalar."""
    return json.dumps(value, ensure_ascii=False)


def slugify(value: str) -> str:
    value = value.strip().lower()
    value = re.sub(r"[^a-z0-9]+", "-", value)
    return value.strip("-") or "untitled"


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def split_frontmatter(text: str) -> tuple[str, str]:
    match = FRONTMATTER_RE.match(text)
    if not match:
        raise ValueError("missing YAML frontmatter")
    return match.group(1), text[match.end() :]


def _parse_scalar(value: str) -> Any:
    value = value.strip()
    if value in {"null", "~"}:
        return None
    if value == "true":
        return True
    if value == "false":
        return False
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    if value.startswith("[") and value.endswith("]"):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return value
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        return value[1:-1]
    return value


def parse_frontmatter(text: str) -> dict[str, Any]:
    frontmatter, _ = split_frontmatter(text)
    parsed: dict[str, Any] = {}
    stack: list[tuple[int, str]] = []
    for raw in frontmatter.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#") or raw.lstrip().startswith("-"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        match = re.match(r"\s*([A-Za-z0-9_-]+):(?:\s*(.*))?$", raw)
        if not match:
            continue
        key, raw_value = match.group(1), match.group(2) or ""
        while stack and stack[-1][0] >= indent:
            stack.pop()
        prefix = ".".join(item[1] for item in stack)
        dotted = f"{prefix}.{key}" if prefix else key
        if raw_value.strip():
            parsed[dotted] = _parse_scalar(raw_value)
        else:
            stack.append((indent, key))
    return parsed


def replace_frontmatter_scalar(text: str, dotted_key: str, value: str) -> str:
    frontmatter, body = split_frontmatter(text)
    parts = dotted_key.split(".")
    lines = frontmatter.splitlines()
    stack: list[tuple[int, str]] = []
    replaced = False
    for index, raw in enumerate(lines):
        if not raw.strip() or raw.lstrip().startswith("#") or raw.lstrip().startswith("-"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        match = re.match(r"(\s*)([A-Za-z0-9_-]+):(?:\s*(.*))?$", raw)
        if not match:
            continue
        key = match.group(2)
        while stack and stack[-1][0] >= indent:
            stack.pop()
        current = [item[1] for item in stack] + [key]
        if current == parts:
            lines[index] = f"{match.group(1)}{key}: {value}"
            replaced = True
            break
        if not (match.group(3) or "").strip():
            stack.append((indent, key))
    if not replaced:
        raise KeyError(f"frontmatter key not found: {dotted_key}")
    return "---\n" + "\n".join(lines) + "\n---\n" + body


def next_id(prefix: str, files: Iterable[Path]) -> str:
    highest = 0
    for path in files:
        try:
            record_id = parse_frontmatter(read_text(path)).get("record_id")
        except (OSError, ValueError):
            continue
        match = re.fullmatch(rf"{re.escape(prefix)}-(\d{{4}})", str(record_id or ""))
        if match:
            highest = max(highest, int(match.group(1)))
    return f"{prefix}-{highest + 1:04d}"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        relative = path.relative_to(root).as_posix().encode("utf-8")
        digest.update(relative)
        digest.update(b"\0")
        digest.update(bytes.fromhex(sha256_file(path)))
    return digest.hexdigest()
