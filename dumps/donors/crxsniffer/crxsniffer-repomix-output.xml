  const result = await h.service.clear('all_local_data');
  assert.deepEqual(result.clear.after, { definitions: 1, watchSessions: 0, resourceObservations: 0, pageFieldSnapshots: 0 });
  assert.deepEqual(result.settings.preferences, DEFAULT_SETTINGS_PREFERENCES);
  const definitions = await h.repositories.definitions.list();
  assert.equal(definitions.length, 1);
  assert.equal(definitions[0]?.definitionKind, 'watch');
