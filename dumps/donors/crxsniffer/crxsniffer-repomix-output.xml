import {
  CONTRACT_ERROR_CODES,
  ContractError,
  createFailureResponse,
  createRequestEnvelope,
  createSuccessResponse,
  requireJsonObject,
  requireMessageEnvelope,
  requireRevision,
  requireStableId,
  toContractErrorPayload,
  type JsonObject,
  type RequestEnvelope,
  type ResponseEnvelope,
} from '../core/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from '../definitions/index.ts';
import type { ChromeRuntimePanelLike } from '../watch/index.ts';
import {
  PACKAGIZER_WORKSPACE_SCHEMA_VERSION,
  type DeletePackagizerDefinitionInput,
  type PackagizerDeleteResult,
  type PackagizerPreviewInput,
  type PackagizerPreviewResult,
  type PackagizerRuleOrderResult,
  type PackagizerTokenBrowserInput,
  type PackagizerTokenBrowserResult,
  type PackagizerRuleSummary,
  type PackagizerSaveResult,
  type PackagizerTemplateSummary,
  type PackagizerWorkspaceSnapshot,
