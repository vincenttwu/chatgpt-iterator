export const PAGE_FIELD_ERROR_CODES = {
  invalidMapping: 'PAGE_FIELD_INVALID_MAPPING',
  invalidSelector: 'PAGE_FIELD_INVALID_SELECTOR',
  selectorEvaluationFailed: 'PAGE_FIELD_SELECTOR_EVALUATION_FAILED',
  invalidRead: 'PAGE_FIELD_INVALID_READ',
  readFailed: 'PAGE_FIELD_READ_FAILED',
  propertyNotPrimitive: 'PAGE_FIELD_PROPERTY_NOT_PRIMITIVE',
  cardinalityViolation: 'PAGE_FIELD_CARDINALITY_VIOLATION',
  transformFailed: 'PAGE_FIELD_TRANSFORM_FAILED',
  validationFailed: 'PAGE_FIELD_VALIDATION_FAILED',
  requiredMissing: 'PAGE_FIELD_REQUIRED_MISSING',
  contextUnavailable: 'PAGE_FIELD_CONTEXT_UNAVAILABLE',
  contextStale: 'PAGE_FIELD_CONTEXT_STALE',
  documentMismatch: 'PAGE_FIELD_DOCUMENT_MISMATCH',
  injectionFailed: 'PAGE_FIELD_INJECTION_FAILED',
  dependencyMissing: 'PAGE_FIELD_DEPENDENCY_MISSING',
  snapshotConflict: 'PAGE_FIELD_SNAPSHOT_CONFLICT',
} as const;

export type PageFieldErrorCode = (typeof PAGE_FIELD_ERROR_CODES)[keyof typeof PAGE_FIELD_ERROR_CODES];

export class PageFieldError extends Error {
  readonly code: PageFieldErrorCode;

  constructor(code: PageFieldErrorCode, message: string) {
    super(message);
    this.name = 'PageFieldError';
    this.code = code;
  }
}
