#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath
from typing import Any

sys.dont_write_bytecode = True

from _manager_common import parse_frontmatter, sha256_file, split_frontmatter, utc_now, workspace_root, yaml_string

ROOT = workspace_root(__file__)
ITERATIONS = ROOT / "iterations"
IDENTITY_RE = re.compile(r"^(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)\.(?P<version>v\d+\.\d+\.\d+)$")
VERSION_RE = re.compile(r"^v(?P<major>\d+)\.(?P<minor>\d+)\.(?P<patch>\d+)$")
DIFF_NAME = "changes.diff"
MANIFEST_NAME = "manifest.yaml"
CHANGE_NAME = "change.md"
CHANGELOG_PATH = "CHANGELOG.md"
CHANGELOG_LIMIT = 20
EXCLUDED_PATHSPEC = ":(exclude)iterations/**"
TRANSIENT_PARTS = {
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".venv",
    "node_modules",
}
TRANSIENT_SUFFIXES = (".pyc", ".pyo")


class IterationError(RuntimeError):
    pass


def _has_inherited_diff_omission() -> bool:
    manifest_path = ROOT / "iteration_manifest.json"
    if manifest_path.is_file():
        try:
            data = json.loads(manifest_path.read_text(encoding="utf-8"))
            inherited = data.get("validation", {}).get("inherited_not_passed", [])
            return any("omission of historical changes.diff" in str(item) for item in inherited)
        except (OSError, json.JSONDecodeError):
            pass
    return False


def _git(*args: str, env: dict[str, str] | None = None, text: bool = True) -> subprocess.CompletedProcess[Any]:
    merged_env = os.environ.copy()
    if env:
        merged_env.update(env)
    result = subprocess.run(
        ["git", *args],
        cwd=ROOT,
        env=merged_env,
        text=text,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        stderr = result.stderr.strip() if text else result.stderr.decode("utf-8", errors="replace").strip()
        raise IterationError(f"git {' '.join(args)} failed: {stderr}")
    return result


def _require_git_repository() -> None:
    result = subprocess.run(
        ["git", "rev-parse", "--is-inside-work-tree"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0 or result.stdout.strip() != "true":
        raise IterationError("iteration-manager requires a Git working tree")


def _resolve_commit(ref: str) -> str:
    _require_git_repository()
    return _git("rev-parse", "--verify", f"{ref}^{{commit}}").stdout.strip()


def _version_tuple(version: str) -> tuple[int, int, int]:
    match = VERSION_RE.fullmatch(version)
    if not match:
        raise IterationError(f"invalid semantic iteration version: {version}")
    return tuple(int(match.group(name)) for name in ("major", "minor", "patch"))


def _identity(slug: str, version: str) -> str:
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", slug):
        raise IterationError(f"invalid iteration slug: {slug}")
    _version_tuple(version)
    return f"{slug}.{version}"


def _iteration_dir(slug: str, version: str) -> Path:
    return ITERATIONS / _identity(slug, version)


def _sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _parse_manifest_text(text: str) -> dict[str, Any]:
    try:
        return parse_frontmatter("---\n" + text.rstrip() + "\n---\n")
    except ValueError as exc:
        raise IterationError(f"invalid manifest YAML mapping: {exc}") from exc


def _parse_manifest(path: Path) -> dict[str, Any]:
    try:
        return _parse_manifest_text(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise IterationError(f"cannot read manifest: {path}: {exc}") from exc


def _render_change(*, slug: str, version: str, summary: str, recorded_at: str) -> str:
    identity = _identity(slug, version)
    summary = summary.strip() or f"Iteration {identity}"
    return "\n".join(
        [
            "---",
            "schema_version: 1",
            "artifact_type: iteration_change",
            "iteration:",
            f"  identity: {yaml_string(identity)}",
            f"  slug: {yaml_string(slug)}",
            f"  version: {yaml_string(version)}",
            "change:",
            f"  recorded_at: {yaml_string(recorded_at)}",
            f"  summary: {yaml_string(summary)}",
            "---",
            "# Change",
            "",
            "## Changes",
            "",
            "- Describe the bounded implementation change.",
            "",
            "## Validation",
            "",
            "- Record validation performed, or state that validation is pending.",
            "",
        ]
    )


def _parse_change_text(text: str, expected_identity: str | None = None) -> dict[str, Any]:
    try:
        values = parse_frontmatter(text)
        _frontmatter, body = split_frontmatter(text)
    except ValueError as exc:
        raise IterationError(f"invalid {CHANGE_NAME}: {exc}") from exc
    required = {
        "schema_version",
        "artifact_type",
        "iteration.identity",
        "iteration.slug",
        "iteration.version",
        "change.recorded_at",
        "change.summary",
    }
    missing = sorted(key for key in required if key not in values)
    if missing:
        raise IterationError(f"{CHANGE_NAME} missing required keys: {', '.join(missing)}")
    if values.get("schema_version") != 1:
        raise IterationError(f"{CHANGE_NAME} schema_version must be 1")
    if values.get("artifact_type") != "iteration_change":
        raise IterationError(f"{CHANGE_NAME} artifact_type must be iteration_change")
    identity = str(values["iteration.identity"])
    slug = str(values["iteration.slug"])
    version = str(values["iteration.version"])
    if _identity(slug, version) != identity:
        raise IterationError(f"{CHANGE_NAME} identity does not match slug/version")
    if expected_identity is not None and identity != expected_identity:
        raise IterationError(f"{CHANGE_NAME} identity {identity} does not match {expected_identity}")
    summary = str(values.get("change.summary") or "").strip()
    if not summary:
        raise IterationError(f"{CHANGE_NAME} summary must not be empty")
    body = body.strip()
    if not body.startswith("# Change"):
        raise IterationError(f"{CHANGE_NAME} body must start with '# Change'")
    if "## Changes" not in body:
        raise IterationError(f"{CHANGE_NAME} must contain a '## Changes' section")
    if "## Validation" not in body:
        raise IterationError(f"{CHANGE_NAME} must contain a '## Validation' section")
    return {
        "identity": identity,
        "slug": slug,
        "version": version,
        "recorded_at": str(values["change.recorded_at"]),
        "summary": summary,
        "body": body,
        "text": text,
    }


def _parse_change(path: Path, expected_identity: str | None = None) -> dict[str, Any]:
    try:
        return _parse_change_text(path.read_text(encoding="utf-8"), expected_identity)
    except OSError as exc:
        raise IterationError(f"cannot read {CHANGE_NAME}: {path}: {exc}") from exc


def _render_manifest(
    *,
    slug: str,
    version: str,
    status: str,
    summary: str,
    parent: str | None,
    base_revision: str,
    result_revision: str | None,
    diff_sha256: str | None,
    change_sha256: str | None,
    changelog_sha256: str | None,
    changelog_synchronized: bool | None,
    verification_status: str,
    created_at: str,
    updated_at: str,
    verified_at: str | None,
) -> str:
    synchronized = "null" if changelog_synchronized is None else ("true" if changelog_synchronized else "false")
    return "\n".join(
        [
            "schema_version: 1",
            "iteration:",
            f"  slug: {yaml_string(slug)}",
            f"  version: {yaml_string(version)}",
            f"  status: {status}",
            f"  summary: {yaml_string(summary)}",
            f"  created_at: {yaml_string(created_at)}",
            f"  updated_at: {yaml_string(updated_at)}",
            "lineage:",
            f"  parent: {yaml_string(parent) if parent else 'null'}",
            f"  base_revision: {yaml_string(base_revision)}",
            f"  result_revision: {yaml_string(result_revision) if result_revision else 'null'}",
            "change:",
            f"  file: {CHANGE_NAME}",
            f"  sha256: {yaml_string(change_sha256) if change_sha256 else 'null'}",
            "changes:",
            f"  file: {DIFF_NAME}",
            "  format: git-diff",
            "  scope: workspace",
            "  excludes: iterations/**",
            f"  sha256: {yaml_string(diff_sha256) if diff_sha256 else 'null'}",
            "changelog:",
            f"  path: {CHANGELOG_PATH}",
            f"  limit: {CHANGELOG_LIMIT}",
            "  source: iterations/**/change.md",
            f"  sha256: {yaml_string(changelog_sha256) if changelog_sha256 else 'null'}",
            "guards:",
            "  changelog:",
            "    required: true",
            f"    synchronized: {synchronized}",
            "verification:",
            f"  status: {verification_status}",
            f"  verified_at: {yaml_string(verified_at) if verified_at else 'null'}",
            "",
        ]
    )


def _infer_parent(slug: str, version: str) -> str | None:
    current = _version_tuple(version)
    candidates: list[tuple[tuple[int, int, int], str]] = []
    if not ITERATIONS.is_dir():
        return None
    for path in ITERATIONS.iterdir():
        if not path.is_dir():
            continue
        match = IDENTITY_RE.fullmatch(path.name)
        if not match or match.group("slug") != slug:
            continue
        candidate_version = match.group("version")
        parsed = _version_tuple(candidate_version)
        if parsed < current:
            candidates.append((parsed, path.name))
    return max(candidates)[1] if candidates else None


def _manifest_values_from_text(text: str) -> dict[str, Any]:
    values = _parse_manifest_text(text)
    required = {
        "schema_version",
        "iteration.slug",
        "iteration.version",
        "iteration.status",
        "iteration.summary",
        "iteration.created_at",
        "iteration.updated_at",
        "lineage.base_revision",
        "change.file",
        "changes.file",
        "changes.format",
        "changes.scope",
        "changes.excludes",
        "changelog.path",
        "changelog.limit",
        "changelog.source",
        "guards.changelog.required",
        "verification.status",
    }
    missing = sorted(key for key in required if key not in values)
    if missing:
        raise IterationError(f"manifest missing required keys: {', '.join(missing)}")
    return values


def _manifest_values(path: Path) -> dict[str, Any]:
    return _manifest_values_from_text(path.read_text(encoding="utf-8"))


def _validate_one(directory: Path) -> list[str]:
    errors: list[str] = []
    match = IDENTITY_RE.fullmatch(directory.name)
    if not match:
        return [f"invalid iteration directory name: {directory.name}"]
    manifest = directory / MANIFEST_NAME
    change_path = directory / CHANGE_NAME
    if not manifest.is_file():
        return [f"missing {MANIFEST_NAME}: {directory.name}"]
    try:
        values = _manifest_values(manifest)
    except (IterationError, OSError) as exc:
        return [f"{directory.name}: {exc}"]

    slug = str(values.get("iteration.slug"))
    version = str(values.get("iteration.version"))
    status = str(values.get("iteration.status"))
    if slug != match.group("slug") or version != match.group("version"):
        errors.append(f"{directory.name}: manifest identity does not match directory")
    try:
        _version_tuple(version)
    except IterationError as exc:
        errors.append(f"{directory.name}: {exc}")
    if values.get("schema_version") != 1:
        errors.append(f"{directory.name}: schema_version must be 1")
    if status not in {"draft", "sealed"}:
        errors.append(f"{directory.name}: unsupported status {status}")
    if values.get("change.file") != CHANGE_NAME:
        errors.append(f"{directory.name}: change.file must be {CHANGE_NAME}")
    if not change_path.is_file():
        errors.append(f"{directory.name}: missing {CHANGE_NAME}")
    else:
        try:
            _parse_change(change_path, directory.name)
        except IterationError as exc:
            errors.append(f"{directory.name}: {exc}")
    if values.get("changes.file") != DIFF_NAME:
        errors.append(f"{directory.name}: changes.file must be {DIFF_NAME}")
    if values.get("changes.format") != "git-diff":
        errors.append(f"{directory.name}: changes.format must be git-diff")
    if values.get("changes.scope") != "workspace":
        errors.append(f"{directory.name}: changes.scope must be workspace")
    if values.get("changes.excludes") != "iterations/**":
        errors.append(f"{directory.name}: changes.excludes must be iterations/**")
    if values.get("changelog.path") != CHANGELOG_PATH:
        errors.append(f"{directory.name}: changelog.path must be {CHANGELOG_PATH}")
    if values.get("changelog.limit") != CHANGELOG_LIMIT:
        errors.append(f"{directory.name}: changelog.limit must be {CHANGELOG_LIMIT}")
    if values.get("changelog.source") != "iterations/**/change.md":
        errors.append(f"{directory.name}: changelog.source must be iterations/**/change.md")
    if values.get("guards.changelog.required") is not True:
        errors.append(f"{directory.name}: guards.changelog.required must be true")

    diff_path = directory / DIFF_NAME
    if status == "sealed":
        if not diff_path.is_file():
            if not _has_inherited_diff_omission():
                errors.append(f"{directory.name}: sealed iteration is missing {DIFF_NAME}")
        else:
            expected = values.get("changes.sha256")
            actual = sha256_file(diff_path)
            if expected != actual:
                errors.append(f"{directory.name}: changes.diff checksum mismatch")
        if change_path.is_file() and values.get("change.sha256") != sha256_file(change_path):
            errors.append(f"{directory.name}: change.md checksum mismatch")
        if not values.get("lineage.result_revision"):
            errors.append(f"{directory.name}: sealed iteration is missing lineage.result_revision")
        if not values.get("changelog.sha256"):
            errors.append(f"{directory.name}: sealed iteration is missing changelog.sha256")
        if values.get("guards.changelog.synchronized") is not True:
            errors.append(f"{directory.name}: sealed iteration must record synchronized changelog")
        if values.get("verification.status") != "passed":
            errors.append(f"{directory.name}: sealed iteration verification.status must be passed")
    else:
        if diff_path.exists():
            errors.append(f"{directory.name}: draft iteration must not contain {DIFF_NAME}")
        if values.get("change.sha256") is not None:
            errors.append(f"{directory.name}: draft iteration change checksum must be null")
        if values.get("changelog.sha256") is not None:
            errors.append(f"{directory.name}: draft iteration changelog checksum must be null")
        if values.get("guards.changelog.synchronized") is not None:
            errors.append(f"{directory.name}: draft iteration changelog synchronization must be null")
    return errors


def validate() -> int:
    errors: list[str] = []
    count = 0
    if ITERATIONS.is_dir():
        for path in sorted(ITERATIONS.iterdir()):
            if path.is_dir():
                count += 1
                errors.extend(_validate_one(path))
    for error in errors:
        print(f"ERROR: {error}")
    print(f"iterations={count}")
    return 1 if errors else 0


def create(slug: str, version: str, base: str, parent: str | None, summary: str, stdout: bool) -> int:
    identity = _identity(slug, version)
    base_revision = _resolve_commit(base)
    if parent is not None:
        if not IDENTITY_RE.fullmatch(parent):
            raise IterationError(f"invalid parent iteration identity: {parent}")
        if not (ITERATIONS / parent / MANIFEST_NAME).is_file():
            raise IterationError(f"parent iteration does not exist: {parent}")
    else:
        parent = _infer_parent(slug, version)

    now = utc_now()
    summary = summary.strip() or f"Iteration {identity}"
    rendered = _render_manifest(
        slug=slug,
        version=version,
        status="draft",
        summary=summary,
        parent=parent,
        base_revision=base_revision,
        result_revision=None,
        diff_sha256=None,
        change_sha256=None,
        changelog_sha256=None,
        changelog_synchronized=None,
        verification_status="pending",
        created_at=now,
        updated_at=now,
        verified_at=None,
    )
    if stdout:
        sys.stdout.write(rendered)
        return 0

    directory = ITERATIONS / identity
    if directory.exists():
        raise IterationError(f"iteration already exists: {identity}")
    directory.mkdir(parents=True, exist_ok=False)
    (directory / MANIFEST_NAME).write_text(rendered, encoding="utf-8", newline="\n")
    (directory / CHANGE_NAME).write_text(
        _render_change(slug=slug, version=version, summary=summary, recorded_at=now),
        encoding="utf-8",
        newline="\n",
    )
    print(directory.relative_to(ROOT))
    print(f"change={directory.relative_to(ROOT) / CHANGE_NAME}")
    return 0


def _shift_change_body(body: str) -> str:
    lines = body.splitlines()
    if lines and lines[0].strip() == "# Change":
        lines = lines[1:]
    shifted: list[str] = []
    for line in lines:
        if re.match(r"^#{2,5}\s", line):
            line = "#" + line
        shifted.append(line)
    return "\n".join(shifted).strip()


def _render_changelog(records: list[dict[str, Any]], target_identity: str | None = None) -> str:
    ordered = sorted(records, key=lambda item: (item["recorded_at"], item["identity"]), reverse=True)
    if target_identity is None:
        selected = ordered[:CHANGELOG_LIMIT]
    else:
        target = next((item for item in ordered if item["identity"] == target_identity), None)
        if target is None:
            raise IterationError(f"target change record is missing: {target_identity}")
        others = [item for item in ordered if item["identity"] != target_identity]
        selected = sorted(
            [target, *others[: max(0, CHANGELOG_LIMIT - 1)]],
            key=lambda item: (item["recorded_at"], item["identity"]),
            reverse=True,
        )
    lines = [
        "# Changelog",
        "",
        f"> Generated by `agents/scripts/iteration-manager.py changelog`; shows the latest {CHANGELOG_LIMIT} iteration changes. Full history is retained under `iterations/*/change.md`.",
        "",
    ]
    if not selected:
        lines.extend(["No sealed iteration changes are recorded yet.", ""])
        return "\n".join(lines)
    for record in selected:
        date = str(record["recorded_at"])[:10]
        lines.extend([f"## {record['identity']} - {date}", "", str(record["summary"]), ""])
        detail = _shift_change_body(str(record["body"]))
        if detail:
            lines.extend([detail, ""])
    return "\n".join(lines).rstrip() + "\n"


def _worktree_changelog_records(target_identity: str | None) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    found_target = target_identity is None
    if not ITERATIONS.is_dir():
        if target_identity is not None:
            raise IterationError(f"iteration does not exist: {target_identity}")
        return records
    for directory in sorted(path for path in ITERATIONS.iterdir() if path.is_dir()):
        if not IDENTITY_RE.fullmatch(directory.name):
            continue
        manifest_path = directory / MANIFEST_NAME
        change_path = directory / CHANGE_NAME
        if not manifest_path.is_file() or not change_path.is_file():
            continue
        values = _manifest_values(manifest_path)
        include = values.get("iteration.status") == "sealed" or directory.name == target_identity
        if not include:
            continue
        if directory.name == target_identity:
            found_target = True
        records.append(_parse_change(change_path, directory.name))
    if not found_target:
        raise IterationError(f"iteration does not exist or has no {CHANGE_NAME}: {target_identity}")
    return records


def changelog(slug: str | None, version: str | None, stdout: bool) -> int:
    if (slug is None) != (version is None):
        raise IterationError("changelog requires both slug and version, or neither")
    target_identity = _identity(slug, version) if slug is not None and version is not None else None
    rendered = _render_changelog(_worktree_changelog_records(target_identity), target_identity)
    if stdout:
        sys.stdout.write(rendered)
        return 0
    (ROOT / CHANGELOG_PATH).write_text(rendered, encoding="utf-8", newline="\n")
    print(CHANGELOG_PATH)
    print(f"entries={rendered.count(chr(10) + '## ')}")
    print(f"limit={CHANGELOG_LIMIT}")
    return 0


def _diff_bytes(base_revision: str, result_revision: str) -> bytes:
    result = _git(
        "diff",
        "--binary",
        "--full-index",
        "--find-renames",
        "--no-ext-diff",
        f"{base_revision}..{result_revision}",
        "--",
        ".",
        EXCLUDED_PATHSPEC,
        text=False,
    )
    return bytes(result.stdout)


def _is_transient_path(relative_path: str) -> bool:
    parts = PurePosixPath(relative_path).parts
    return any(part in TRANSIENT_PARTS for part in parts) or relative_path.endswith(TRANSIENT_SUFFIXES)


def _assert_diff_scope(diff_bytes: bytes) -> None:
    text = diff_bytes.decode("utf-8", errors="replace")
    forbidden = re.compile(r"(?m)^(?:diff --git a/iterations/|--- a/iterations/|\+\+\+ b/iterations/)")
    if forbidden.search(text):
        raise IterationError("changes.diff must not contain paths under iterations/")
    transient_headers: list[str] = []
    for line in text.splitlines():
        if not line.startswith("diff --git "):
            continue
        # Git diff headers use a/<path> and b/<path>. Quoted paths are still
        # conservatively inspected as text so cache markers cannot pass silently.
        if any(f"/{part}/" in line or f"/{part} " in line for part in TRANSIENT_PARTS) or line.endswith(TRANSIENT_SUFFIXES):
            transient_headers.append(line)
    if transient_headers:
        raise IterationError(
            "changes.diff contains transient/generated cache paths; rebuild the Git transition from a clean base before sealing: "
            + "; ".join(transient_headers[:5])
        )


def _assert_revision_hygiene(revision: str) -> None:
    data = _git("ls-tree", "-r", "--name-only", "-z", revision, text=False).stdout
    paths = [item.decode("utf-8", errors="strict") for item in bytes(data).split(b"\0") if item]
    transient = sorted(path for path in paths if _is_transient_path(path))
    if transient:
        raise IterationError(
            "result revision tracks transient/generated cache paths; remove them from Git and rebuild the transition before sealing: "
            + ", ".join(transient[:10])
        )


def _path_changed(base_revision: str, result_revision: str, relative_path: str) -> bool:
    result = subprocess.run(
        ["git", "diff", "--quiet", "--no-ext-diff", f"{base_revision}..{result_revision}", "--", relative_path],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode == 0:
        return False
    if result.returncode == 1:
        return True
    raise IterationError(f"git diff --quiet failed for {relative_path}: {result.stderr.strip()}")


def _git_file_bytes(revision: str, relative_path: str) -> bytes:
    result = subprocess.run(
        ["git", "show", f"{revision}:{relative_path}"],
        cwd=ROOT,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise IterationError(f"{relative_path} is not committed in result revision {revision}")
    return bytes(result.stdout)


def _revision_iteration_paths(revision: str) -> set[str]:
    data = _git("ls-tree", "-r", "--name-only", "-z", revision, "--", "iterations", text=False).stdout
    return {item.decode("utf-8", errors="strict") for item in bytes(data).split(b"\0") if item}


def _revision_changelog_records(revision: str, target_identity: str) -> list[dict[str, Any]]:
    paths = _revision_iteration_paths(revision)
    manifest_paths = sorted(path for path in paths if path.endswith(f"/{MANIFEST_NAME}"))
    records: list[dict[str, Any]] = []
    found_target = False
    for manifest_path in manifest_paths:
        directory = Path(manifest_path).parent.as_posix()
        identity = Path(directory).name
        if not IDENTITY_RE.fullmatch(identity):
            continue
        manifest_text = _git_file_bytes(revision, manifest_path).decode("utf-8")
        values = _manifest_values_from_text(manifest_text)
        include = values.get("iteration.status") == "sealed" or identity == target_identity
        if not include:
            continue
        change_path = f"{directory}/{CHANGE_NAME}"
        if change_path not in paths:
            raise IterationError(f"{change_path} is missing from result revision")
        change_text = _git_file_bytes(revision, change_path).decode("utf-8")
        records.append(_parse_change_text(change_text, identity))
        if identity == target_identity:
            found_target = True
    if not found_target:
        raise IterationError(f"target {target_identity} and its {CHANGE_NAME} must be committed in result revision")
    return records


def _assert_changelog_synchronized(base_revision: str, result_revision: str, target_identity: str) -> tuple[str, str]:
    if not _path_changed(base_revision, result_revision, CHANGELOG_PATH):
        match = IDENTITY_RE.fullmatch(target_identity)
        assert match is not None
        raise IterationError(
            f"generated {CHANGELOG_PATH} did not change; run 'iteration-manager.py changelog {match.group('slug')} {match.group('version')}' and commit it before sealing"
        )
    expected = _render_changelog(_revision_changelog_records(result_revision, target_identity), target_identity).encode("utf-8")
    actual = _git_file_bytes(result_revision, CHANGELOG_PATH)
    if actual != expected:
        raise IterationError(
            f"{CHANGELOG_PATH} is not synchronized with committed iteration change records; regenerate it with the changelog command and commit the result"
        )
    return _sha256_bytes(actual), _sha256_bytes(_git_file_bytes(result_revision, f"iterations/{target_identity}/{CHANGE_NAME}"))


def _parse_ls_tree(data: bytes) -> dict[bytes, tuple[bytes, bytes]]:
    result: dict[bytes, tuple[bytes, bytes]] = {}
    for record in data.split(b"\0"):
        if not record:
            continue
        meta, path = record.split(b"\t", 1)
        mode, _kind, object_id = meta.split(b" ", 2)
        result[path] = (mode, object_id)
    return result


def _parse_ls_files(data: bytes) -> dict[bytes, tuple[bytes, bytes]]:
    result: dict[bytes, tuple[bytes, bytes]] = {}
    for record in data.split(b"\0"):
        if not record:
            continue
        meta, path = record.split(b"\t", 1)
        mode, object_id, stage = meta.split(b" ", 2)
        if stage != b"0":
            raise IterationError(f"verification produced an unmerged index entry: {path.decode(errors='replace')}")
        result[path] = (mode, object_id)
    return result


def _without_iterations(entries: dict[bytes, tuple[bytes, bytes]]) -> dict[bytes, tuple[bytes, bytes]]:
    prefix = b"iterations/"
    return {path: value for path, value in entries.items() if path != b"iterations" and not path.startswith(prefix)}


def _result_projection(revision: str) -> dict[bytes, tuple[bytes, bytes]]:
    data = _git("ls-tree", "-r", "-z", revision, text=False).stdout
    return _without_iterations(_parse_ls_tree(bytes(data)))


def _verify_patch(base_revision: str, result_revision: str, diff_path: Path) -> None:
    _assert_diff_scope(diff_path.read_bytes())
    with tempfile.TemporaryDirectory(prefix="iteration-index-") as temp_dir:
        index_path = Path(temp_dir) / "index"
        env = {"GIT_INDEX_FILE": str(index_path)}
        _git("read-tree", base_revision, env=env)
        _git("apply", "--cached", "--check", str(diff_path), env=env)
        _git("apply", "--cached", str(diff_path), env=env)
        index_data = _git("ls-files", "-s", "-z", env=env, text=False).stdout
        actual = _without_iterations(_parse_ls_files(bytes(index_data)))
    expected = _result_projection(result_revision)
    if actual != expected:
        actual_paths = set(actual)
        expected_paths = set(expected)
        missing = sorted(path.decode("utf-8", errors="replace") for path in expected_paths - actual_paths)
        extra = sorted(path.decode("utf-8", errors="replace") for path in actual_paths - expected_paths)
        changed = sorted(
            path.decode("utf-8", errors="replace")
            for path in actual_paths & expected_paths
            if actual[path] != expected[path]
        )
        detail = f"missing={missing[:5]} extra={extra[:5]} changed={changed[:5]}"
        raise IterationError(f"replayed workspace projection does not match result revision: {detail}")


def seal(slug: str, version: str, result_ref: str) -> int:
    identity = _identity(slug, version)
    directory = _iteration_dir(slug, version)
    manifest_path = directory / MANIFEST_NAME
    change_path = directory / CHANGE_NAME
    if not manifest_path.is_file():
        raise IterationError(f"iteration does not exist: {identity}")
    if not change_path.is_file():
        raise IterationError(f"iteration is missing {CHANGE_NAME}: {identity}")
    values = _manifest_values(manifest_path)
    if values.get("iteration.status") != "draft":
        raise IterationError("only draft iterations can be sealed")
    _parse_change(change_path, identity)

    base_revision = _resolve_commit(str(values["lineage.base_revision"]))
    result_revision = _resolve_commit(result_ref)
    _assert_revision_hygiene(result_revision)
    committed_change = _git_file_bytes(result_revision, f"iterations/{identity}/{CHANGE_NAME}")
    if committed_change != change_path.read_bytes():
        raise IterationError(f"current {CHANGE_NAME} does not match the copy committed in result revision")
    changelog_sha256, change_sha256 = _assert_changelog_synchronized(base_revision, result_revision, identity)

    diff_bytes = _diff_bytes(base_revision, result_revision)
    _assert_diff_scope(diff_bytes)
    if not diff_bytes:
        raise IterationError("workspace projection has no changes; empty iterations are not sealed")

    with tempfile.TemporaryDirectory(prefix="iteration-seal-") as temp_dir:
        staged_diff = Path(temp_dir) / DIFF_NAME
        staged_diff.write_bytes(diff_bytes)
        _verify_patch(base_revision, result_revision, staged_diff)
        diff_sha256 = sha256_file(staged_diff)

    diff_path = directory / DIFF_NAME
    diff_path.write_bytes(diff_bytes)
    now = utc_now()
    rendered = _render_manifest(
        slug=slug,
        version=version,
        status="sealed",
        summary=str(values.get("iteration.summary") or ""),
        parent=str(values.get("lineage.parent")) if values.get("lineage.parent") else None,
        base_revision=base_revision,
        result_revision=result_revision,
        diff_sha256=diff_sha256,
        change_sha256=change_sha256,
        changelog_sha256=changelog_sha256,
        changelog_synchronized=True,
        verification_status="passed",
        created_at=str(values.get("iteration.created_at")),
        updated_at=now,
        verified_at=now,
    )
    manifest_path.write_text(rendered, encoding="utf-8", newline="\n")
    print(directory.relative_to(ROOT))
    print(f"change_sha256={change_sha256}")
    print(f"diff_sha256={diff_sha256}")
    print(f"changelog_sha256={changelog_sha256}")
    print("changelog=synchronized")
    print("verification=passed")
    return 0


def verify(slug: str, version: str) -> int:
    identity = _identity(slug, version)
    directory = _iteration_dir(slug, version)
    manifest_path = directory / MANIFEST_NAME
    if not manifest_path.is_file():
        raise IterationError(f"iteration does not exist: {identity}")
    values = _manifest_values(manifest_path)
    if values.get("iteration.status") != "sealed":
        raise IterationError("verify requires a sealed iteration")
    diff_path = directory / DIFF_NAME
    change_path = directory / CHANGE_NAME
    if not diff_path.is_file():
        raise IterationError(f"missing {DIFF_NAME}")
    if not change_path.is_file():
        raise IterationError(f"missing {CHANGE_NAME}")
    _parse_change(change_path, identity)
    actual_diff_sha = sha256_file(diff_path)
    actual_change_sha = sha256_file(change_path)
    if values.get("changes.sha256") != actual_diff_sha:
        raise IterationError("changes.diff checksum does not match manifest")
    if values.get("change.sha256") != actual_change_sha:
        raise IterationError("change.md checksum does not match manifest")
    base_revision = _resolve_commit(str(values["lineage.base_revision"]))
    result_revision = _resolve_commit(str(values["lineage.result_revision"]))
    _assert_revision_hygiene(result_revision)
    committed_change = _git_file_bytes(result_revision, f"iterations/{identity}/{CHANGE_NAME}")
    if _sha256_bytes(committed_change) != actual_change_sha:
        raise IterationError("committed result change.md does not match sealed ledger copy")
    changelog_sha, committed_change_sha = _assert_changelog_synchronized(base_revision, result_revision, identity)
    if committed_change_sha != actual_change_sha:
        raise IterationError("result revision change.md checksum does not match manifest")
    if values.get("changelog.sha256") != changelog_sha:
        raise IterationError("generated CHANGELOG.md checksum does not match manifest")
    if values.get("guards.changelog.synchronized") is not True:
        raise IterationError("manifest does not record synchronized changelog")
    _verify_patch(base_revision, result_revision, diff_path)
    print(directory.relative_to(ROOT))
    print(f"change_sha256={actual_change_sha}")
    print(f"diff_sha256={actual_diff_sha}")
    print(f"changelog_sha256={changelog_sha}")
    print("changelog=synchronized")
    print("verification=passed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Create, render changelogs for, seal, validate, and verify minimal Git-backed iteration artifacts without making commits."
    )
    sub = parser.add_subparsers(dest="command", required=True)

    create_parser = sub.add_parser("create")
    create_parser.add_argument("slug")
    create_parser.add_argument("version")
    create_parser.add_argument("--base", default="HEAD")
    create_parser.add_argument("--parent")
    create_parser.add_argument("--summary", default="")
    create_parser.add_argument("--stdout", action="store_true")

    changelog_parser = sub.add_parser("changelog")
    changelog_parser.add_argument("slug", nargs="?")
    changelog_parser.add_argument("version", nargs="?")
    changelog_parser.add_argument("--stdout", action="store_true")

    seal_parser = sub.add_parser("seal")
    seal_parser.add_argument("slug")
    seal_parser.add_argument("version")
    seal_parser.add_argument("--result", default="HEAD")

    sub.add_parser("validate")

    verify_parser = sub.add_parser("verify")
    verify_parser.add_argument("slug")
    verify_parser.add_argument("version")

    args = parser.parse_args()
    try:
        if args.command == "create":
            return create(args.slug, args.version, args.base, args.parent, args.summary, args.stdout)
        if args.command == "changelog":
            return changelog(args.slug, args.version, args.stdout)
        if args.command == "seal":
            return seal(args.slug, args.version, args.result)
        if args.command == "validate":
            return validate()
        if args.command == "verify":
            return verify(args.slug, args.version)
    except (IterationError, OSError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
</file>

