import {
  CONTRACT_ERROR_CODES,
  ContractError,
  freezeJsonValue,
  requireJsonObject,
  requireStableId,
  type JsonObject,
  type StableId,
} from '../core/index.ts';
import { requireImmutableWatchSessionRecord } from '../definitions/index.ts';
import {
  type ResourceHistoryReader,
  type ResourceObservationHistoryCursor,
} from '../persistence/index.ts';
import { requireResourceObservationValue } from '../observations/index.ts';
import { canonicalizeResourceUrl } from './canonical-url.ts';
import {
  RESOURCE_KINDS,
  type ResourceKind,
} from './types.ts';
import {
  RESOURCE_HISTORY_DEFAULT_PAGE_SIZE,
  RESOURCE_HISTORY_MAX_PAGE_SIZE,
  RESOURCE_HISTORY_SCAN_LIMIT,
  RESOURCE_HISTORY_SCHEMA_VERSION,
  RESOURCE_HISTORY_SESSION_LIMIT,
  type ResourceHistoryCursor,
  type ResourceHistoryDetail,
  type ResourceHistoryEvaluationDetail,
  type ResourceHistoryKindFilter,
  type ResourceHistoryPage,
  type ResourceHistoryQuery,
  type ResourceHistoryRow,
  type ResourceHistorySessionList,
  type ResourceHistorySessionSummary,
  type ResourceHistoryStatus,
  type ResourceHistoryStatusFilter,
} from './history-types.ts';

const HISTORY_STATUSES = new Set<ResourceHistoryStatus>(['projected', 'failed']);
const HISTORY_STATUS_FILTERS = new Set<ResourceHistoryStatusFilter>(['all', 'projected', 'failed']);
const HISTORY_KIND_FILTERS = new Set<ResourceHistoryKindFilter>(['all', ...RESOURCE_KINDS]);

function invalid(message: string): never {
  throw new ContractError(CONTRACT_ERROR_CODES.invalidArgument, message);
}

function requireLimit(value: unknown): number {
  if (!Number.isSafeInteger(value) || (value as number) < 1 || (value as number) > RESOURCE_HISTORY_MAX_PAGE_SIZE) {
    invalid(`resource history limit must be 1..${RESOURCE_HISTORY_MAX_PAGE_SIZE}`);
  }
  return value as number;
}

function requireSearchText(value: unknown): string | undefined {
  if (value === undefined) return undefined;
  if (typeof value !== 'string') invalid('resource history searchText must be a string');
  const normalized = value.trim();
  if (normalized.length > 256) invalid('resource history searchText must be at most 256 characters');
  return normalized === '' ? undefined : normalized;
}

function requireKindFilter(value: unknown): ResourceHistoryKindFilter {
  if (value === undefined) return 'all';
  if (typeof value !== 'string' || !HISTORY_KIND_FILTERS.has(value as ResourceHistoryKindFilter)) {
    invalid('resource history kind filter is invalid');
  }
  return value as ResourceHistoryKindFilter;
}

function requireStatusFilter(value: unknown): ResourceHistoryStatusFilter {
  if (value === undefined) return 'all';
  if (typeof value !== 'string' || !HISTORY_STATUS_FILTERS.has(value as ResourceHistoryStatusFilter)) {
    invalid('resource history status filter is invalid');
  }
  return value as ResourceHistoryStatusFilter;
}

export function requireResourceHistoryCursor(value: unknown): ResourceHistoryCursor {
  const record = requireJsonObject(value as never);
  if (typeof record.observedAt !== 'string') invalid('resource history cursor observedAt must be a string');
  return freezeJsonValue({
    observedAt: record.observedAt as ResourceHistoryCursor['observedAt'],
    observationId: requireStableId(record.observationId, 'resourceObservation'),
  });
}

export function requireResourceHistoryQuery(value: unknown): ResourceHistoryQuery {
  const record = requireJsonObject(value as never);
  const allowed = new Set(['watchSessionId', 'limit', 'cursor', 'searchText', 'kind', 'status']);
  for (const key of Object.keys(record)) if (!allowed.has(key)) invalid(`unknown resource history query field: ${key}`);
  const searchText = requireSearchText(record.searchText);
  const result: ResourceHistoryQuery = {
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    limit: requireLimit(record.limit ?? RESOURCE_HISTORY_DEFAULT_PAGE_SIZE),
    ...(record.cursor === undefined ? {} : { cursor: requireResourceHistoryCursor(record.cursor) }),
    ...(searchText === undefined ? {} : { searchText }),
    kind: requireKindFilter(record.kind),
    status: requireStatusFilter(record.status),
  };
  return freezeJsonValue(result);
}

interface ParsedEvaluation {
  readonly status: ResourceHistoryStatus | 'rejected';
  readonly canonicalUrl: string;
  readonly kind: ResourceKind;
  readonly classificationReason: string;
  readonly matchedPresets: readonly ('images' | 'videos')[];
  readonly filename?: string;
  readonly group?: string;
  readonly comment?: string;
  readonly pageEnrichmentStatus: string;
  readonly evaluatedRuleCount: number;
  readonly appliedRuleCount: number;
  readonly failedRuleCount: number;
  readonly failureCode?: string;
}

function stringArray(value: unknown): readonly string[] {
  return Array.isArray(value) && value.every((entry) => typeof entry === 'string') ? Object.freeze([...value]) : Object.freeze([]);
}

function optionalString(record: JsonObject, key: string): string | undefined {
  const value = record[key];
  return typeof value === 'string' ? value : undefined;
}

function parseEvaluation(record: { readonly id: string; readonly watchSessionId: string; readonly evaluation?: JsonObject; readonly value: JsonObject }): ParsedEvaluation {
  if (record.evaluation === undefined) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'persisted resource observation is missing evaluation authority');
  }
  const evaluation = requireJsonObject(record.evaluation as never);
  if (evaluation.schemaVersion !== 2 || typeof evaluation.status !== 'string' || !['projected', 'failed', 'rejected'].includes(evaluation.status)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'persisted resource evaluation shape is invalid');
  }
  if (evaluation.observationId !== record.id || evaluation.watchSessionId !== record.watchSessionId) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'persisted resource evaluation identity mismatch');
  }
  const explanation = requireJsonObject(evaluation.explanation as never);
  const classification = requireJsonObject(explanation.classification as never);
  if (typeof classification.kind !== 'string' || !(RESOURCE_KINDS as readonly string[]).includes(classification.kind)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'persisted resource classification kind is invalid');
  }
  if (typeof classification.reason !== 'string') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'persisted resource classification reason is invalid');
  }
  const admission = requireJsonObject(explanation.admission as never);
  const matchedPresets = stringArray(admission.matchedPresets).filter(
    (value): value is 'images' | 'videos' => value === 'images' || value === 'videos',
  );
  const pageEnrichment = requireJsonObject(explanation.pageEnrichment as never);
  const pageEnrichmentStatus = typeof pageEnrichment.status === 'string' ? pageEnrichment.status : 'unknown';

  let canonicalUrl: string;
  let filename: string | undefined;
  let group: string | undefined;
  let comment: string | undefined;
  if (evaluation.status === 'projected') {
    const projection = requireJsonObject(evaluation.projection as never);
    if (typeof projection.canonicalUrl !== 'string') {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'projected resource canonicalUrl is invalid');
    }
    canonicalUrl = projection.canonicalUrl;
    const derived = requireJsonObject(projection.derived as never);
    filename = optionalString(derived, 'filename');
    group = optionalString(derived, 'group');
    comment = optionalString(derived, 'comment');
  } else {
    const observation = requireResourceObservationValue(record.value);
    canonicalUrl = canonicalizeResourceUrl(observation.finalUrl).href;
  }

  let evaluatedRuleCount = 0;
  let appliedRuleCount = 0;
  let failedRuleCount = 0;
  if (explanation.packagizer !== undefined) {
    const packagizer = requireJsonObject(explanation.packagizer as never);
    if (Array.isArray(packagizer.rules)) {
      evaluatedRuleCount = packagizer.rules.length;
      for (const ruleValue of packagizer.rules) {
        const rule = requireJsonObject(ruleValue as never);
        if (rule.outcome === 'applied' || rule.outcome === 'stopped') appliedRuleCount += 1;
        if (rule.outcome === 'failed') failedRuleCount += 1;
      }
    }
  }
  let failureCode: string | undefined;
  if (evaluation.failure !== undefined) {
    const failure = requireJsonObject(evaluation.failure as never);
    failureCode = optionalString(failure, 'code');
  }
  return Object.freeze({
    status: evaluation.status as ParsedEvaluation['status'],
    canonicalUrl,
    kind: classification.kind as ResourceKind,
    classificationReason: classification.reason,
    matchedPresets: Object.freeze(matchedPresets),
    ...(filename === undefined ? {} : { filename }),
    ...(group === undefined ? {} : { group }),
    ...(comment === undefined ? {} : { comment }),
    pageEnrichmentStatus,
    evaluatedRuleCount,
    appliedRuleCount,
    failedRuleCount,
    ...(failureCode === undefined ? {} : { failureCode }),
  });
}

function rowFromObservation(record: Parameters<typeof parseEvaluation>[0] & { readonly observedAt: ResourceHistoryRow['observedAt'] }): ResourceHistoryRow | undefined {
  const evaluation = parseEvaluation(record);
  if (!HISTORY_STATUSES.has(evaluation.status as ResourceHistoryStatus)) return undefined;
  const observation = requireResourceObservationValue(record.value);
  return freezeJsonValue({
    observationId: requireStableId(record.id, 'resourceObservation'),
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    observedAt: record.observedAt,
    endedAt: observation.endedAt,
    canonicalUrl: evaluation.canonicalUrl,
    kind: evaluation.kind,
    status: evaluation.status as ResourceHistoryStatus,
    ...(evaluation.filename === undefined ? {} : { filename: evaluation.filename }),
    ...(evaluation.group === undefined ? {} : { group: evaluation.group }),
    ...(observation.responseStatusCode === undefined ? {} : { responseStatusCode: observation.responseStatusCode }),
    ...(observation.responseMimeType === undefined ? {} : { responseMimeType: observation.responseMimeType }),
    ...(observation.initiator === undefined ? {} : { initiator: observation.initiator }),
    ...(observation.contentLength === undefined ? {} : { contentLength: observation.contentLength }),
    ...(observation.tabTitle === undefined ? {} : { tabTitle: observation.tabTitle }),
    ...(observation.userAgent === undefined ? {} : { userAgent: observation.userAgent }),
  });
}

function rowMatches(row: ResourceHistoryRow, query: ResourceHistoryQuery): boolean {
  const kind = query.kind ?? 'all';
  const status = query.status ?? 'all';
  if (kind !== 'all' && row.kind !== kind) return false;
  if (status !== 'all' && row.status !== status) return false;
  const searchText = query.searchText?.toLocaleLowerCase();
  if (searchText === undefined) return true;
  return [row.canonicalUrl, row.filename, row.group]
    .some((value) => value?.toLocaleLowerCase().includes(searchText) ?? false);
}

function cursorFromRecord(record: { readonly observedAt: ResourceHistoryCursor['observedAt']; readonly id: ResourceHistoryCursor['observationId'] }): ResourceHistoryCursor {
  return freezeJsonValue({ observedAt: record.observedAt, observationId: record.id });
}

function sessionSummary(value: unknown): ResourceHistorySessionSummary {
  const session = requireImmutableWatchSessionRecord(value);
  const watch = session.value.definitions.find(
    (definition) => definition.id === session.value.watchDefinitionId && definition.kind === 'watch',
  );
  if (watch === undefined) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'WatchSession history is missing its frozen Watch definition');
  }
  return freezeJsonValue({
    watchSessionId: session.id,
    startedAt: session.createdAt,
    setupName: watch.value.name,
    watchRevision: watch.revision,
  });
}

/** Bounded query/projection service for the primary Watch results experience. */
export class ResourceHistoryService {
  readonly #reader: ResourceHistoryReader;

  constructor(reader: ResourceHistoryReader) {
    this.#reader = reader;
  }

  async sessions(limitInput: number = RESOURCE_HISTORY_SESSION_LIMIT): Promise<ResourceHistorySessionList> {
    const limit = Math.min(requireLimit(limitInput), RESOURCE_HISTORY_SESSION_LIMIT);
    const page = await this.#reader.listWatchSessions(limit);
    return freezeJsonValue({
      schemaVersion: RESOURCE_HISTORY_SCHEMA_VERSION,
      items: Object.freeze(page.items.map(sessionSummary)),
      truncated: page.nextCursor !== undefined,
    });
  }

  async page(input: ResourceHistoryQuery): Promise<ResourceHistoryPage> {
    const query = requireResourceHistoryQuery(input);
    const persistenceCursor: ResourceObservationHistoryCursor | undefined = query.cursor === undefined
      ? undefined
      : { observedAt: query.cursor.observedAt, observationId: query.cursor.observationId };
    const rawPage = await this.#reader.listResourceObservations(
      query.watchSessionId,
      RESOURCE_HISTORY_SCAN_LIMIT,
      persistenceCursor,
    );
    const items: ResourceHistoryRow[] = [];
    let scannedCount = 0;
    let nextCursor: ResourceHistoryCursor | undefined;

    for (let index = 0; index < rawPage.items.length; index += 1) {
      const record = rawPage.items[index]!;
      scannedCount += 1;
      const row = rowFromObservation(record);
      if (row !== undefined && rowMatches(row, query)) items.push(row);
      if (items.length >= query.limit) {
        const moreInCurrentScan = index < rawPage.items.length - 1;
        if (moreInCurrentScan || rawPage.nextCursor !== undefined) nextCursor = cursorFromRecord(record);
        break;
      }
    }
    if (items.length < query.limit && rawPage.nextCursor !== undefined) {
      nextCursor = freezeJsonValue({
        observedAt: rawPage.nextCursor.observedAt,
        observationId: rawPage.nextCursor.observationId,
      });
    }
    return freezeJsonValue({
      schemaVersion: RESOURCE_HISTORY_SCHEMA_VERSION,
      watchSessionId: query.watchSessionId,
      items: Object.freeze(items),
      scannedCount,
      truncated: nextCursor !== undefined,
      ...(nextCursor === undefined ? {} : { nextCursor }),
    });
  }

  async detail(observationIdInput: StableId<'resourceObservation'>): Promise<ResourceHistoryDetail | undefined> {
    const observationId = requireStableId(observationIdInput, 'resourceObservation');
    const record = await this.#reader.getResourceObservation(observationId);
    if (record === undefined) return undefined;
    const observation = requireResourceObservationValue(record.value);
    const evaluation = parseEvaluation(record);
    if (!HISTORY_STATUSES.has(evaluation.status as ResourceHistoryStatus)) return undefined;
    const evaluationDetail: ResourceHistoryEvaluationDetail = freezeJsonValue({
      status: evaluation.status as ResourceHistoryStatus,
      kind: evaluation.kind,
      classificationReason: evaluation.classificationReason,
      matchedPresets: evaluation.matchedPresets,
      ...(evaluation.filename === undefined ? {} : { filename: evaluation.filename }),
      ...(evaluation.group === undefined ? {} : { group: evaluation.group }),
      ...(evaluation.comment === undefined ? {} : { comment: evaluation.comment }),
      pageEnrichmentStatus: evaluation.pageEnrichmentStatus,
      evaluatedRuleCount: evaluation.evaluatedRuleCount,
      appliedRuleCount: evaluation.appliedRuleCount,
      failedRuleCount: evaluation.failedRuleCount,
      ...(evaluation.failureCode === undefined ? {} : { failureCode: evaluation.failureCode }),
    });
    return freezeJsonValue({
      schemaVersion: RESOURCE_HISTORY_SCHEMA_VERSION,
      observationId: record.id,
      watchSessionId: record.watchSessionId,
      observedAt: record.observedAt,
      canonicalUrl: evaluation.canonicalUrl,
      source: {
        method: observation.method,
        requestType: observation.requestType,
        initialUrl: observation.initialUrl,
        finalUrl: observation.finalUrl,
        startedAt: observation.startedAt,
        endedAt: observation.endedAt,
        redirectCount: observation.hops.filter((hop) => hop.kind === 'redirect').length,
        terminal: observation.terminal.kind,
        ...(observation.responseStatusCode === undefined ? {} : { responseStatusCode: observation.responseStatusCode }),
        ...(observation.responseMimeType === undefined ? {} : { responseMimeType: observation.responseMimeType }),
        ...(observation.fromCache === undefined ? {} : { fromCache: observation.fromCache }),
        ...(observation.initiator === undefined ? {} : { initiator: observation.initiator }),
        ...(observation.contentLength === undefined ? {} : { contentLength: observation.contentLength }),
        ...(observation.tabTitle === undefined ? {} : { tabTitle: observation.tabTitle }),
        ...(observation.userAgent === undefined ? {} : { userAgent: observation.userAgent }),
      },
      evaluation: evaluationDetail,
    });
  }
}
