        )
        self.assertEqual(kept_seal.returncode, 0, kept_seal.stdout + kept_seal.stderr)
        self.assertIn("pre_cleanup=kept", kept_seal.stdout)
        self.assertTrue((keep_root / "snapshots" / pre_identity).exists())


