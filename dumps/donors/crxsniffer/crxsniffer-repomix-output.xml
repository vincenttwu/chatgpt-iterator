import math
import struct
import zlib
import os

def create_png_rgba(width, height, draw_func):
    pixels = bytearray()
    for y in range(height):
        pixels.append(0) # Filter type 0 (None)
        for x in range(width):
            r, g, b, a = draw_func(x, y, width, height)
            pixels.extend([r, g, b, a])
            
    compressed = zlib.compress(pixels, 9)
    
    def chunk(tag, data):
        length = len(data)
        checksum = zlib.crc32(tag + data) & 0xffffffff
        return struct.pack('>I', length) + tag + data + struct.pack('>I', checksum)
        
    header = b'\x89PNG\r\n\x1a\n'
    ihdr_data = struct.pack('>IIBBBBB', width, height, 8, 6, 0, 0, 0)
    ihdr = chunk(b'IHDR', ihdr_data)
    idat = chunk(b'IDAT', compressed)
    iend = chunk(b'IEND', b'')
    
    return header + ihdr + idat + iend

def render_sniffer_icon(x, y, w, h):
    # Center and normalized coordinates (-1 to 1)
    cx, cy = w / 2.0, h / 2.0
    dx, dy = (x - cx) / (w / 2.0), (y - cy) / (h / 2.0)
    dist = math.hypot(dx, dy)
    angle = math.atan2(dy, dx) # -pi to pi
    
    # Base colors (Cyan #38bdf8: 56, 189, 248; Teal #2dd4bf: 45, 212, 191)
    r_cyan, g_cyan, b_cyan = 56, 189, 248
    r_teal, g_teal, b_teal = 45, 212, 191
    
    # Outer radar ring (radius ~ 0.85, line width ~ 0.08)
    r_outer = 0.85
    width_outer = 0.07
    dist_outer = abs(dist - r_outer)
    
    # Middle ring (radius ~ 0.58, line width ~ 0.065)
    r_mid = 0.58
    width_mid = 0.065
    dist_mid = abs(dist - r_mid)
    
    # Center dot (radius ~ 0.22)
    r_center = 0.22
    
    # Radar sweep gap (open quarter top-left)
    angle_norm = (angle + math.pi) / (2 * math.pi)
    
    # Anti-aliasing helper
    def aa_step(d, r, thickness):
        half = thickness / 2.0
        edge = 0.015
        if d < half - edge:
            return 1.0
        elif d > half + edge:
            return 0.0
        else:
            return 1.0 - (d - (half - edge)) / (2 * edge)

    def aa_circle(d, radius):
        edge = 0.015
        if d < radius - edge:
            return 1.0
        elif d > radius + edge:
            return 0.0
        else:
            return 1.0 - (d - (radius - edge)) / (2 * edge)

    alpha_outer = aa_step(dist_outer, r_outer, width_outer)
    alpha_mid = aa_step(dist_mid, r_mid, width_mid)
    alpha_center = aa_circle(dist, r_center)

    # Radar crosshair accents
    is_crosshair_x = abs(dy) < 0.04 and 0.4 < abs(dx) < 0.95
    is_crosshair_y = abs(dx) < 0.04 and 0.4 < abs(dy) < 0.95
    alpha_crosshair = 1.0 if (is_crosshair_x or is_crosshair_y) else 0.0
    
    # Combine layers
    total_alpha = max(alpha_outer, alpha_mid, alpha_center, alpha_crosshair)
    
    if total_alpha <= 0:
        return 0, 0, 0, 0
        
    # Interpolate color (Outer/Mid: Cyan, Center: Teal)
    c_weight = alpha_center / (total_alpha + 1e-5)
    r = int(r_cyan * (1 - c_weight) + r_teal * c_weight)
    g = int(g_cyan * (1 - c_weight) + g_teal * c_weight)
    b = int(b_cyan * (1 - c_weight) + b_teal * c_weight)
    a = int(min(255, max(0, total_alpha * 255)))
    
    return r, g, b, a

def generate_all():
    sizes = [16, 32, 48, 128, 512]
    public_dir = r'c:\Users\vincent\Documents\GitHub\crsniffer\public'
    icon_dir = os.path.join(public_dir, 'icon')
    os.makedirs(icon_dir, exist_ok=True)
    
    for s in sizes:
        png_data = create_png_rgba(s, s, render_sniffer_icon)
        if s == 512 or s == 128:
            filepath = os.path.join(public_dir, 'icon.png')
            with open(filepath, 'wb') as f:
                f.write(png_data)
        filepath_sized = os.path.join(icon_dir, f'{s}.png')
        with open(filepath_sized, 'wb') as f:
            f.write(png_data)
        print(f"Generated {s}x{s} transparent PNG: {filepath_sized}")

if __name__ == '__main__':
    generate_all()
