  const globRegex = compileSmartPattern('*.mp4');
  assert.equal(globRegex.test('https://example.com/video.mp4'), true);
  assert.equal(globRegex.test('https://example.com/video.mp4?query=1'), true);

  // re: regex test
  const reRegex = compileSmartPattern('re:^https://cdn\\d+\\.example\\.com/.*\\.mp4$');
  assert.equal(reRegex.test('https://cdn12.example.com/video.mp4'), true);
  assert.equal(reRegex.test('https://other.example.com/video.mp4'), false);

  // Pattern list parsing & matching
  const parsed = parseSmartPatternList('*.mp4, *.pdf \n *.zip ; re:.*stream.*');
  assert.deepEqual(parsed, ['*.mp4', '*.pdf', '*.zip', 're:.*stream.*']);

  assert.equal(matchSmartPatternList('*.mp4, *.pdf', 'https://example.com/file.pdf'), true);
  assert.equal(matchSmartPatternList('*.mp4, *.pdf', 'https://example.com/file.exe'), false);
  assert.equal(matchSmartPatternList('', 'https://example.com/file.exe', true), true);
  assert.equal(matchSmartPatternList('', 'https://example.com/file.exe', false), false);
});

