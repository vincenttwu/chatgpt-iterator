import assert from 'node:assert/strict';
import test from 'node:test';

import {
  DEFAULT_DOWNLOAD_SAMPLE_CONTEXT,
  resolveDownloadPathTemplate,
} from '../../src/packagizer/path-template.ts';

test('resolveDownloadPathTemplate evaluates default sensible template', () => {
  const result = resolveDownloadPathTemplate('{origin_url::domain}/{kind}/{filename}');
  assert.equal(result, 'example.com/video/sample_video.mp4');
});

test('resolveDownloadPathTemplate resolves universal URL sub-extractors', () => {
  const context = {
    originUrl: 'https://vimeo.com',
    pageUrl: 'https://vimeo.com/categories/nature/clip-123',
    refererUrl: 'https://vimeo.com/watch',
    canonicalUrl: 'https://vimeo.com/canonical-clip',
    resourceUrl: 'https://cdn.vimeo.com/media/hd_video.mp4',
    kind: 'video',
    mimeType: 'video/mp4',
    title: 'Sunset Nature Video',
    filename: 'hd_video.mp4',
  };

  assert.equal(
    resolveDownloadPathTemplate('{origin_url::domain}/{page_url::slug[0]}/{filename}', context),
    'vimeo.com/categories/hd_video.mp4',
  );

  assert.equal(
    resolveDownloadPathTemplate('{origin_url::domain}/{page_url::slug[-1]}/{title}.{ext}', context),
    'vimeo.com/clip-123/Sunset Nature Video.mp4',
  );

  assert.equal(
    resolveDownloadPathTemplate('{resource_url::domain}/{kind}/{mime}/{filename}', context),
    'cdn.vimeo.com/video/video_mp4/hd_video.mp4',
  );
});

test('resolveDownloadPathTemplate handles missing tokens and sanitizes OS illegal chars', () => {
  const context = {
    originUrl: 'https://test-site.org',
    pageUrl: 'https://test-site.org/docs',
    kind: 'document',
    title: 'Illegal <Tag>: "Quote" / Slash?',
    filename: 'file:name.pdf',
  };

  const result = resolveDownloadPathTemplate('{origin_url::domain}/{kind}/{title}', context);
  assert.equal(result, 'test-site.org/document/Illegal _Tag__ _Quote_ _ Slash_');
});
