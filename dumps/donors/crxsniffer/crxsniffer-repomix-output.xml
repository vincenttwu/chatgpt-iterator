export class PackagizerWorkspaceService {
  readonly #catalog: DefinitionCatalog;
  readonly #preview: PackagizerPreviewPort | undefined;
  readonly #lifecycle: DefinitionLifecycleService;
  readonly #now: () => IsoTimestamp;
  readonly #createDefinitionId: () => StableId<'definition'>;

  constructor(options: PackagizerWorkspaceServiceOptions) {
    this.#catalog = options.catalog;
    this.#lifecycle = new DefinitionLifecycleService({ catalog: options.catalog });
    this.#preview = options.preview;
    this.#now = options.now ?? defaultNow;
    this.#createDefinitionId = options.createDefinitionId ?? (() => createStableId('definition'));
  }

  async #fieldMappings(): Promise<Map<string, SavedDefinitionRecord>> {
    const candidates = (await this.#catalog.list('pageFieldMapping')).filter((record) => record.value.enabled);
    const bySlug = new Map<string, SavedDefinitionRecord>();
    const ambiguous = new Set<string>();
    for (const record of candidates) {
      const slug = record.value.body.slug;
      if (typeof slug !== 'string' || !FIELD_SLUG_PATTERN.test(slug)) continue;
      if (bySlug.has(slug)) ambiguous.add(slug); else bySlug.set(slug, record);
    }
    for (const slug of ambiguous) bySlug.delete(slug);
    return bySlug;
  }

  async #pageFieldReferences(tokens: readonly string[], current?: SavedDefinitionRecord): Promise<readonly DefinitionReference[]> {
    const slugs = [...new Set(tokens.flatMap((token) => {
      const match = FIELD_TOKEN_PATTERN.exec(token);
      return match === null ? [] : [match[1]!];
    }))];
    if (slugs.length === 0) return Object.freeze([]);
    const mappings = await this.#fieldMappings();
    return Object.freeze(slugs.map((slug) => {
      const mapping = mappings.get(slug);
      if (mapping === undefined) {
        throw new DefinitionError(DEFINITION_ERROR_CODES.invalidReference, `Page Field ${slug} is unavailable or ambiguous; edit Page Fields before using field.${slug}`, { slug });
      }
      const expectedRevision = referencedExpectedRevision(current, mapping.id, 'pageFieldMapping');
      return { id: mapping.id, kind: 'pageFieldMapping' as const, ...(expectedRevision === undefined ? {} : { expectedRevision }) };
    }));
  }

  async #selectedWatch(input: PackagizerTokenBrowserInput | PackagizerPreviewInput): Promise<SavedDefinitionRecord> {
    const watch = await this.#catalog.require(input.watchDefinitionId);
    if (watch.definitionKind !== 'watch') throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('preview_and_token_browser_require_a_watch_setup'));
    if (watch.revision !== requireRevision(input.expectedWatchRevision)) {
      throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('this_watch_setup_changed_elsewhere_reload_i_352fc9de'));
    }
    return watch;
  }

  async #usedTokensForWatch(watch: SavedDefinitionRecord): Promise<Set<string>> {
    const used = new Set<string>();
    const templateIds = new Set<StableId<'definition'>>();
    for (const reference of watch.value.references) {
      if (reference.kind === 'template') templateIds.add(reference.id);
      if (reference.kind !== 'packagizerRule') continue;
      const rule = await this.#catalog.require(reference.id);
      if (rule.definitionKind !== 'packagizerRule') {
        throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('watch_rule_references_must_resolve_to_packagizer_rul'));
      }
      if (reference.expectedRevision !== undefined && rule.revision !== reference.expectedRevision) {
        throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('a_rule_used_by_this_watch_changed_elsewhere_reload_t'));
      }
      if (!rule.value.enabled) continue;
      for (const dependency of rule.value.references) {
        const current = await this.#catalog.require(dependency.id);
        if (current.definitionKind !== dependency.kind) {
          throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('a_rule_dependency_changed_kind_unexpectedly'));
        }
        if (dependency.expectedRevision !== undefined && current.revision !== dependency.expectedRevision) {
          throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('a_rule_dependency_changed_elsewhere_reload_before_us'));
        }
      }
      const body = requirePackagizerRuleBody(rule.value.body);
      for (const condition of body.conditions) used.add(condition.token);
      for (const action of body.actions) templateIds.add(action.templateId);
    }
    for (const templateId of templateIds) {
      const template = await this.#catalog.require(templateId);
      if (template.definitionKind !== 'template') {
        throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('rule_actions_must_resolve_to_templates'));
      }
      for (const dependency of template.value.references) {
        const current = await this.#catalog.require(dependency.id);
        if (current.definitionKind !== dependency.kind) {
          throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('a_template_dependency_changed_kind_unexpectedly'));
        }
        if (dependency.expectedRevision !== undefined && current.revision !== dependency.expectedRevision) {
          throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('a_template_dependency_changed_elsewhere_reload_befor'));
        }
      }
      if (!template.value.enabled) continue;
      const body = requirePackagizerTemplateBody(template.value.body);
      for (const token of parsePackagizerTemplate(body.text).tokenNames) used.add(token);
    }
    return used;
  }

  async snapshot(): Promise<PackagizerWorkspaceSnapshot> {
    const [ruleRecords, templateRecords, watchRecords, mappings] = await Promise.all([
      this.#catalog.list('packagizerRule'), this.#catalog.list('template'), this.#catalog.list('watch'), this.#fieldMappings(),
    ]);
    const rules = ruleRecords.map(ruleSummary).sort((left, right) => left.name.localeCompare(right.name));
    const templates = templateRecords.map(templateSummary).sort((left, right) => left.name.localeCompare(right.name));
    const watches = watchRecords.map(watchSummary).sort((left, right) => left.name.localeCompare(right.name));
    return freezeJsonValue({
      schemaVersion: PACKAGIZER_WORKSPACE_SCHEMA_VERSION,
      rules: Object.freeze(rules), templates: Object.freeze(templates), watches: Object.freeze(watches),
      conditionTokens: Object.freeze([...PACKAGIZER_STATIC_CONDITION_TOKENS, ...[...mappings.keys()].sort().map((slug) => `field.${slug}`)]),
    }) as PackagizerWorkspaceSnapshot;
  }

  async tokenBrowser(input: PackagizerTokenBrowserInput): Promise<PackagizerTokenBrowserResult> {
    const watch = await this.#selectedWatch(input);
    const [used, mappings] = await Promise.all([this.#usedTokensForWatch(watch), this.#fieldMappings()]);
    const descriptors: PackagizerTokenDescriptor[] = STATIC_TOKEN_METADATA.map((meta) => {
      const usedBySelectedWatch = used.has(meta.token);
      const availability: PackagizerTokenAvailability = meta.namespace === 'page' && usedBySelectedWatch ? 'contextual' : 'available';
      return freezeJsonValue({ ...meta, availability, usedBySelectedWatch }) as PackagizerTokenDescriptor;
    });
    for (const [slug, mapping] of [...mappings.entries()].sort(([left], [right]) => left.localeCompare(right))) {
      const token = `field.${slug}`;
      const usedBySelectedWatch = used.has(token);
      descriptors.push(freezeJsonValue({
        token,
        namespace: 'field',
        label: mapping.value.name,
        description: `Value produced by the enabled Page Field mapping “${mapping.value.name}”.`,
        example: `value from ${slug}`,
        missingBehavior: ui('missing_when_the_exact_document_is_stale_unavailable'),
        availability: usedBySelectedWatch ? 'contextual' : 'not_in_selected_watch',
        usedBySelectedWatch,
      }) as PackagizerTokenDescriptor);
    }
    const groups = TOKEN_GROUPS.map((group) => freezeJsonValue({
      ...group,
      tokens: Object.freeze(descriptors.filter((descriptor) => descriptor.namespace === group.namespace)),
    }) as PackagizerTokenGroup);
    return freezeJsonValue({
      schemaVersion: PACKAGIZER_TOKEN_BROWSER_SCHEMA_VERSION,
      watchDefinitionId: watch.id,
      watchRevision: watch.revision,
      groups: Object.freeze(groups),
    }) as PackagizerTokenBrowserResult;
  }

  async preview(input: PackagizerPreviewInput): Promise<PackagizerPreviewResult> {
    await this.#selectedWatch(input);
    if (this.#preview === undefined) {
      throw new DefinitionError(DEFINITION_ERROR_CODES.invalidDefinition, ui('preview_is_unavailable_in_this_runtime'));
    }
    return this.#preview.preview(input);
  }

  async saveTemplate(input: SavePackagizerTemplateInput): Promise<PackagizerSaveResult<PackagizerTemplateSummary>> {
    const body: PackagizerTemplateBody = requirePackagizerTemplateBody({ schemaVersion: 1, text: input.text });
    const name = requireName(input.name);
    const current = input.mode === 'update' ? await this.#requireForUpdate(input.definitionId, input.expectedRevision, 'template') : undefined;
    const references = await this.#pageFieldReferences(parsePackagizerTemplate(body.text).tokenNames, current);
    const timestamp = this.#now();
    const record = current === undefined
      ? await this.#catalog.create({ id: this.#createDefinitionId(), kind: 'template', name, enabled: input.enabled, body, references, timestamp })
      : await this.#catalog.update(current.id, current.revision, { name, enabled: input.enabled, body, references }, timestamp);
    return freezeJsonValue({ created: current === undefined, definition: templateSummary(record) }) as PackagizerSaveResult<PackagizerTemplateSummary>;
  }

  async saveRule(input: SavePackagizerRuleInput): Promise<PackagizerSaveResult<PackagizerRuleSummary>> {
    const body = requirePackagizerRuleBody(input.body);
    const name = requireName(input.name);
    const current = input.mode === 'update' ? await this.#requireForUpdate(input.definitionId, input.expectedRevision, 'packagizerRule') : undefined;
    const templateIds = [...new Set(body.actions.map((action) => action.templateId))];
    const templateReferences: DefinitionReference[] = [];
    for (const templateId of templateIds) {
      const template = await this.#catalog.require(templateId);
      if (template.definitionKind !== 'template') throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('rule_actions_must_reference_template_definitions'));
      const expectedRevision = referencedExpectedRevision(current, template.id, 'template');
      templateReferences.push({ id: template.id, kind: 'template', ...(expectedRevision === undefined ? {} : { expectedRevision }) });
    }
    const fieldReferences = await this.#pageFieldReferences(body.conditions.map((condition) => condition.token), current);
    const references = uniqueReferences([...templateReferences, ...fieldReferences]);
    const timestamp = this.#now();
    const record = current === undefined
      ? await this.#catalog.create({ id: this.#createDefinitionId(), kind: 'packagizerRule', name, enabled: input.enabled, body, references, timestamp })
      : await this.#catalog.update(current.id, current.revision, { name, enabled: input.enabled, body, references }, timestamp);
    return freezeJsonValue({ created: current === undefined, definition: ruleSummary(record) }) as PackagizerSaveResult<PackagizerRuleSummary>;
  }

  async saveRuleOrder(input: SavePackagizerRuleOrderInput): Promise<PackagizerRuleOrderResult> {
    const watch = await this.#catalog.require(input.watchDefinitionId);
    if (watch.definitionKind !== 'watch') throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('rules_can_only_be_assigned_to_a_watch_setup'));
    if (watch.id === ('def_00000000-0000-4000-8000-000000000001' as StableId<'definition'>)) {
      throw new DefinitionError(DEFINITION_ERROR_CODES.invalidDefinition, ui('default_watch_is_built_in_save_a_custom_wat_40eeb3bc'));
    }
    if (watch.revision !== requireRevision(input.expectedWatchRevision)) throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('this_watch_setup_changed_elsewhere_reload_it_before'));
    const ids = input.ruleIds.map((id) => requireStableId(id, 'definition'));
    if (new Set(ids).size !== ids.length) throw new DefinitionError(DEFINITION_ERROR_CODES.invalidDefinition, ui('a_rule_may_appear_only_once_in_a_watch_setup'));
    for (const id of ids) {
      const rule = await this.#catalog.require(id);
      if (rule.definitionKind !== 'packagizerRule') throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, ui('watch_rule_order_may_contain_only_packagizer_rules'));
    }
    const nonRuleReferences = watch.value.references.filter((reference) => reference.kind !== 'packagizerRule');
    const updated = await this.#catalog.update(watch.id, watch.revision, {
      references: Object.freeze([...nonRuleReferences, ...ids.map((id) => ({ id, kind: 'packagizerRule' as const }))]),
    }, this.#now());
    return freezeJsonValue({ watch: watchSummary(updated) });
  }

  async deleteDefinition(input: DeletePackagizerDefinitionInput): Promise<PackagizerDeleteResult> {
    const record = await this.#catalog.require(input.definitionId);
    if (record.definitionKind !== input.kind) throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, `Expected ${input.kind} definition`);
    if (record.revision !== requireRevision(input.expectedRevision)) throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('this_definition_changed_elsewhere_reload_before_dele'));
    return freezeJsonValue(await this.#lifecycle.delete({
      definitionId: record.id,
      expectedRevision: record.revision,
      kind: input.kind,
    })) as PackagizerDeleteResult;
  }

  async #requireForUpdate(definitionId: StableId<'definition'> | undefined, expectedRevision: Revision | undefined, kind: 'packagizerRule' | 'template'): Promise<SavedDefinitionRecord> {
    if (definitionId === undefined || expectedRevision === undefined) throw new DefinitionError(DEFINITION_ERROR_CODES.invalidDefinition, ui('update_requires_an_exact_saved_definition_revision'));
    const record = await this.#catalog.require(requireStableId(definitionId, 'definition'));
    if (record.definitionKind !== kind) throw new DefinitionError(DEFINITION_ERROR_CODES.kindMismatch, `Expected ${kind} definition`);
    if (record.revision !== requireRevision(expectedRevision)) throw new DefinitionError(DEFINITION_ERROR_CODES.revisionConflict, ui('this_saved_definition_changed_elsewhere_reload_befor'));
    return cloneJsonValue(record) as SavedDefinitionRecord;
  }
}
