import type { JsonObject } from '../core/index.ts';

export type DownloadJobStatus = 'queued' | 'scheduled' | 'downloading' | 'completed' | 'failed' | 'paused' | 'filtered';

export interface DownloadQueueJob extends JsonObject {
  readonly id: string;
  readonly url: string;
  readonly targetPath: string;
  readonly originUrl: string;
  readonly domain: string;
  readonly kind: 'video' | 'image' | 'audio' | 'stream' | 'document' | 'other';
  readonly mimeType?: string;
  readonly status: DownloadJobStatus;
  readonly filterReason?: 'size_below_min' | 'size_above_max' | 'extension_blocked' | 'rule_mismatch';
  readonly chromeDownloadId?: number;
  readonly bytesReceived: number;
  readonly totalBytes: number;
  readonly speedBytesPerSec: number;
  readonly retryCount: number;
  readonly enqueuedAt: number;
  readonly startedAt?: number;
  readonly endedAt?: number;
  readonly lastError?: string;
}

export type SizeUnit = 'B' | 'KB' | 'MB' | 'GB';

export interface DownloadSizePreset extends JsonObject {
  readonly id: string;
  readonly name: string;
  readonly minSizeValue: number;
  readonly minSizeUnit: SizeUnit;
  readonly maxSizeValue: number;
  readonly maxSizeUnit: SizeUnit;
  readonly isBuiltIn?: boolean;
}

export const BUILTIN_DOWNLOAD_SIZE_PRESETS: readonly DownloadSizePreset[] = [
  {
    id: 'no_junk',
    name: 'Strict No-Junk (Default)',
    minSizeValue: 50,
    minSizeUnit: 'KB',
    maxSizeValue: 2,
    maxSizeUnit: 'GB',
    isBuiltIn: true,
  },
  {
    id: 'video_media',
    name: 'Video & Media (5MB+)',
    minSizeValue: 5,
    minSizeUnit: 'MB',
    maxSizeValue: 0,
    maxSizeUnit: 'GB',
    isBuiltIn: true,
  },
  {
    id: 'hd_images',
    name: 'HD Images (200KB - 50MB)',
    minSizeValue: 200,
    minSizeUnit: 'KB',
    maxSizeValue: 50,
    maxSizeUnit: 'MB',
    isBuiltIn: true,
  },
  {
    id: 'documents',
    name: 'Documents & Archives (50KB - 500MB)',
    minSizeValue: 50,
    minSizeUnit: 'KB',
    maxSizeValue: 500,
    maxSizeUnit: 'MB',
    isBuiltIn: true,
  },
];

export function convertSizeToBytes(value: number, unit: SizeUnit): number {
  if (value <= 0) return 0;
  switch (unit) {
    case 'B': return value;
    case 'KB': return value * 1024;
    case 'MB': return value * 1024 * 1024;
    case 'GB': return value * 1024 * 1024 * 1024;
  }
}

export interface QueueEngineSettings extends JsonObject {
