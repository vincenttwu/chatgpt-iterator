        self.commit_all(repo, "result")

        sealed = self.run_manager(repo, "seal", "testing", "v0.1.0", "--result", "HEAD")
        self.assertEqual(sealed.returncode, 0, sealed.stdout + sealed.stderr)
        self.assertIn("changelog=synchronized", sealed.stdout)
        manifest = (iteration / "manifest.yaml").read_text(encoding="utf-8")
