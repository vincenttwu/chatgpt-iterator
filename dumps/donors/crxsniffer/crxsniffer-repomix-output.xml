  assert.equal(rule?.conditions[0]?.outcome, 'not_matched');
  assert.equal(rule?.conditions[1]?.outcome, 'not_evaluated');
  assert.equal(rule?.actions[0]?.outcome, 'not_evaluated');
});

test('Packagizer failure is visible and fail-closed: raw observation can persist but no projection is materialized', async () => {
  const seeded = await session({ failingRule: true });
  const result = evaluateResourceCandidate({ session: seeded.session, observation: observation() });
  assert.equal(result.status, 'failed');
  assert.equal(result.projection, undefined);
  assert.equal(result.failure?.stage, 'packagizer');
  const failedRule = result.explanation.packagizer?.rules.find((entry) => entry.ruleId === IDS.ruleB);
  assert.equal(failedRule?.outcome, 'failed');
  assert.equal(failedRule?.actions[0]?.outcome, 'rolled_back');
  assert.equal(failedRule?.actions[1]?.outcome, 'failed');
  assert.equal(failedRule?.actions[1]?.tokens[0]?.sourceState, 'missing');
