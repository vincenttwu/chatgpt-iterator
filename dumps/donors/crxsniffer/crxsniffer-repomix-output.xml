import type { JsonObject } from './types.ts';

/** Stable error codes that may cross extension execution contexts. */
export const CONTRACT_ERROR_CODES = {
  invalidArgument: 'invalid_argument',
  invalidId: 'invalid_id',
  invalidRevision: 'invalid_revision',
  invalidSchemaVersion: 'invalid_schema_version',
  invalidProtocolVersion: 'invalid_protocol_version',
  invalidJson: 'invalid_json',
  missingRequiredValue: 'missing_required_value',
  unsupportedSchemaVersion: 'unsupported_schema_version',
  unsupportedProtocolVersion: 'unsupported_protocol_version',
  invalidMessage: 'invalid_message',
  internalError: 'internal_error',
} as const;

export type ContractErrorCode =
  (typeof CONTRACT_ERROR_CODES)[keyof typeof CONTRACT_ERROR_CODES];

export const CONTRACT_ERROR_SCHEMA_VERSION = 1 as const;

/** JSON-safe error representation. Stack traces and Error objects never cross contexts. */
export interface ContractErrorPayload extends JsonObject {
  readonly schemaVersion: typeof CONTRACT_ERROR_SCHEMA_VERSION;
  readonly code: ContractErrorCode;
  readonly message: string;
  readonly details?: JsonObject;
}

/** Local typed error used by strict contract constructors and validators. */
export class ContractError extends Error {
  readonly code: ContractErrorCode;
  readonly details: JsonObject | undefined;

  constructor(code: ContractErrorCode, message: string, details?: JsonObject) {
    super(message);
    this.name = 'ContractError';
    this.code = code;
    this.details = details;
  }

  toPayload(): ContractErrorPayload {
    return this.details === undefined
      ? { schemaVersion: CONTRACT_ERROR_SCHEMA_VERSION, code: this.code, message: this.message }
      : {
          schemaVersion: CONTRACT_ERROR_SCHEMA_VERSION,
          code: this.code,
          message: this.message,
          details: this.details,
        };
  }
}

/** Convert an unknown local failure to the bounded wire-safe error shape. */
export function toContractErrorPayload(
  error: unknown,
  fallbackCode: ContractErrorCode = CONTRACT_ERROR_CODES.internalError,
): ContractErrorPayload {
  if (error instanceof ContractError) {
    return error.toPayload();
  }

  if (error instanceof Error) {
    return {
      schemaVersion: CONTRACT_ERROR_SCHEMA_VERSION,
      code: fallbackCode,
      message: error.message || 'Unexpected error',
    };
  }

  return {
    schemaVersion: CONTRACT_ERROR_SCHEMA_VERSION,
    code: fallbackCode,
    message: 'Unexpected error',
  };
}
