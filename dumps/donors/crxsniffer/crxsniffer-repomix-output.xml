<file path="tests/page-fields/page-fields.test.ts">
import assert from 'node:assert/strict';
import test from 'node:test';

import { createStableId, type JsonObject } from '../../src/core/index.ts';
import type { FrozenDefinitionSnapshot } from '../../src/definitions/index.ts';
import type { PageContextValue } from '../../src/page-context/index.ts';
import {
  PAGE_FIELD_ERROR_CODES,
  ChromePageFieldReader,
  PageFieldEvaluationService,
  evaluatePageFieldMapping,
  readPageFieldCandidateInDocument,
  requirePageFieldMappingBody,
  requirePageFieldMappingDefinition,
  type ChromeScriptingLike,
  type PageFieldCandidate,
  type PageFieldDomReadResult,
  type PageFieldMappingBody,
} from '../../src/page-fields/index.ts';

const WATCH_ID = createStableId('watchSession', () => '60000000-0000-4000-8000-000000000001');
const MAPPING_ID = createStableId('definition', () => '80000000-0000-4000-8000-000000000001');
const CONTEXT: PageContextValue = {
  schemaVersion: 1,
  watchSessionId: WATCH_ID,
  tabId: 7,
  topDocumentId: 'top-doc-a',
  pageRevision: 1 as never,
  url: 'https://example.test/page',
  origin: 'https://example.test',
};

function candidate(overrides: JsonObject = {}): JsonObject {
  return {
    selector: { family: 'css', query: '.title' },
    read: { kind: 'text_content' },
    cardinality: 'first',
    transforms: [],
    accept: {},
    ...overrides,
  };
}

function mapping(overrides: JsonObject = {}): PageFieldMappingBody {
  return requirePageFieldMappingBody({
    schemaVersion: 1,
    slug: 'episode',
    candidates: [candidate()],
    required: false,
    validation: {},
    ...overrides,
  });
}

function definition(body: JsonObject): ReturnType<typeof requirePageFieldMappingDefinition> {
  const snapshot: FrozenDefinitionSnapshot = {
    id: MAPPING_ID,
    kind: 'pageFieldMapping',
    revision: 1 as never,
    digest: `sha256:${'a'.repeat(64)}`,
    value: {
      name: 'Episode',
      enabled: true,
      body,
      references: [],
    },
  };
  return requirePageFieldMappingDefinition(snapshot);
}

async function withDomGlobals<T>(documentValue: unknown, xpathResultValue: unknown, fn: () => T | Promise<T>): Promise<T> {
  const hadDocument = Object.hasOwn(globalThis, 'document');
  const oldDocument = Reflect.get(globalThis, 'document');
  const hadXPath = Object.hasOwn(globalThis, 'XPathResult');
  const oldXPath = Reflect.get(globalThis, 'XPathResult');
  Reflect.set(globalThis, 'document', documentValue);
  Reflect.set(globalThis, 'XPathResult', xpathResultValue);
  try {
    return await fn();
  } finally {
    if (hadDocument) Reflect.set(globalThis, 'document', oldDocument); else Reflect.deleteProperty(globalThis, 'document');
    if (hadXPath) Reflect.set(globalThis, 'XPathResult', oldXPath); else Reflect.deleteProperty(globalThis, 'XPathResult');
  }
}

test('mapping validation accepts bounded CSS/XPath contracts and rejects unsafe read/transform shapes', () => {
  const valid = requirePageFieldMappingBody({
    schemaVersion: 1,
    slug: 'episode_title',
    candidates: [
      candidate({
        selector: { family: 'xpath', query: 'string(//h1)', namespaces: { x: 'urn:test' } },
        read: { kind: 'raw' },
        transforms: [{ kind: 'trim' }, { kind: 'slice', start: 0, end: 40 }],
      }),
    ],
    defaultValue: '',
    required: false,
    validation: { valueType: 'string', maxLength: 80 },
  });
  assert.equal(valid.candidates[0]?.selector.family, 'xpath');
  assert.throws(() => mapping({ candidates: [candidate({ read: { kind: 'raw' } })] }), /raw read is only valid/);
  assert.throws(() => mapping({ candidates: [candidate({ read: { kind: 'property', name: 'location.href' } })] }), /direct primitive property/);
  assert.throws(() => mapping({ candidates: [candidate({ transforms: [{ kind: 'eval' }] })] }), /transform.kind/);
  assert.throws(() => mapping({ defaultValue: { nested: 'object' } }), /primitive or bounded primitive list/);
  assert.throws(() => mapping({ surprise: true }), /unsupported mapping field/);
  assert.throws(() => mapping({ slug: 'episode-title' }), /lowercase token slug/);
});

test('CSS execution uses static selection order and preserves absent attribute as Missing', async () => {
  const nodes = [
    { textContent: 'first', innerText: 'First', getAttribute: () => null },
    { textContent: 'second', innerText: 'Second', getAttribute: (name: string) => name === 'data-id' ? '2' : null },
  ];
  const doc = { querySelectorAll: (query: string) => query === '.item' ? nodes : [] };
  const xpath = { ANY_TYPE: 0, NUMBER_TYPE: 1, STRING_TYPE: 2, BOOLEAN_TYPE: 3, ORDERED_NODE_SNAPSHOT_TYPE: 7 };
  await withDomGlobals(doc, xpath, async () => {
    const text = readPageFieldCandidateInDocument(requirePageFieldMappingBody({
      schemaVersion: 1,
      slug: 'x',
      candidates: [candidate({ selector: { family: 'css', query: '.item' }, cardinality: 'many' })],
      required: false,
      validation: {},
    }).candidates[0]!);
    assert.equal(text.ok, true);
    if (text.ok) assert.deepEqual(text.result, { kind: 'nodes', values: [{ state: 'value', value: 'first' }, { state: 'value', value: 'second' }] });

    const attrCandidate = requirePageFieldMappingBody({
      schemaVersion: 1,
      slug: 'y',
      candidates: [candidate({ selector: { family: 'css', query: '.item' }, read: { kind: 'attribute', name: 'data-id' } })],
      required: false,
      validation: {},
    }).candidates[0]!;
    const attr = readPageFieldCandidateInDocument(attrCandidate);
    assert.equal(attr.ok, true);
    if (attr.ok && attr.result.kind === 'nodes') assert.equal(attr.result.values[0]?.state, 'missing');
  });
});

test('DOM boundary rejects unbounded many-node payloads before crossing into extension state', async () => {
  const nodes = Array.from({ length: 257 }, (_, index) => ({ textContent: String(index) }));
  const doc = { querySelectorAll: () => nodes };
  const xpath = { ANY_TYPE: 0, NUMBER_TYPE: 1, STRING_TYPE: 2, BOOLEAN_TYPE: 3, ORDERED_NODE_SNAPSHOT_TYPE: 7 };
  await withDomGlobals(doc, xpath, async () => {
    const many = mapping({ candidates: [candidate({ cardinality: 'many' })] }).candidates[0]!;
    assert.deepEqual(readPageFieldCandidateInDocument(many), { ok: false, code: PAGE_FIELD_ERROR_CODES.cardinalityViolation });
  });
});

test('XPath preserves typed falsey scalars and re-evaluates node sets as ordered snapshots', async () => {
  const xpath = { ANY_TYPE: 0, NUMBER_TYPE: 1, STRING_TYPE: 2, BOOLEAN_TYPE: 3, UNORDERED_NODE_ITERATOR_TYPE: 4, ORDERED_NODE_SNAPSHOT_TYPE: 7 };
  let scalar = true;
  const nodeA = { textContent: 'A' };
  const nodeB = { textContent: 'B' };
  const doc = {
    querySelectorAll: () => [],
    evaluate: (_query: string, _doc: unknown, _resolver: unknown, resultType: number) => {
      if (scalar) return { resultType: xpath.NUMBER_TYPE, numberValue: 0 };
      if (resultType === xpath.ANY_TYPE) return { resultType: xpath.UNORDERED_NODE_ITERATOR_TYPE };
      return { resultType: xpath.ORDERED_NODE_SNAPSHOT_TYPE, snapshotLength: 2, snapshotItem: (index: number) => [nodeA, nodeB][index] ?? null };
    },
  };
  await withDomGlobals(doc, xpath, async () => {
    const raw = mapping({ candidates: [candidate({ selector: { family: 'xpath', query: 'count(//x)' }, read: { kind: 'raw' } })] }).candidates[0]!;
    const scalarResult = readPageFieldCandidateInDocument(raw);
    assert.deepEqual(scalarResult, { ok: true, result: { kind: 'scalar', value: 0 } });

    scalar = false;
    const nodes = mapping({ candidates: [candidate({ selector: { family: 'xpath', query: '//x' }, read: { kind: 'text_content' }, cardinality: 'many' })] }).candidates[0]!;
    const nodeResult = readPageFieldCandidateInDocument(nodes);
    assert.equal(nodeResult.ok, true);
    if (nodeResult.ok) assert.deepEqual(nodeResult.result, { kind: 'nodes', values: [{ state: 'value', value: 'A' }, { state: 'value', value: 'B' }] });
  });
});

test('selector syntax failures are structural errors rather than fallback Missing', async () => {
  const doc = { querySelectorAll: () => { const error = new Error('bad selector'); error.name = 'SyntaxError'; throw error; } };
  const xpath = { ANY_TYPE: 0, NUMBER_TYPE: 1, STRING_TYPE: 2, BOOLEAN_TYPE: 3, ORDERED_NODE_SNAPSHOT_TYPE: 7 };
  await withDomGlobals(doc, xpath, async () => {
    const result = readPageFieldCandidateInDocument(mapping().candidates[0]!);
    assert.deepEqual(result, { ok: false, code: PAGE_FIELD_ERROR_CODES.invalidSelector });
  });
});

test('candidate fallback occurs only on Missing or explicit rejection', async () => {
  const body = mapping({
    candidates: [
      candidate({ read: { kind: 'attribute', name: 'data-title' } }),
      candidate({ selector: { family: 'css', query: '.fallback' }, transforms: [{ kind: 'trim' }], accept: { rejectBlank: true } }),
      candidate({ selector: { family: 'xpath', query: 'string(//title)' }, read: { kind: 'raw' } }),
    ],
  });
  const reads: PageFieldDomReadResult[] = [
    { kind: 'nodes', values: [{ state: 'missing' }] },
    { kind: 'nodes', values: [{ state: 'value', value: '   ' }] },
    { kind: 'scalar', value: 'Episode 7' },
  ];
  const result = await evaluatePageFieldMapping(body, async (_candidate, index) => reads[index]!);
  assert.equal(result.status, 'value');
  if (result.status === 'value') {
    assert.equal(result.value, 'Episode 7');
    assert.equal(result.selectedCandidateIndex, 2);
  }
  assert.deepEqual(result.trace.map((item) => item.outcome), ['missing', 'rejected', 'value']);
});

test('cardinality, transform and validation errors stop instead of silently falling through', async () => {
  const cardinalityResult = await evaluatePageFieldMapping(mapping({
    candidates: [candidate({ cardinality: 'exact_one' }), candidate({ selector: { family: 'css', query: '.fallback' } })],
  }), async () => ({ kind: 'nodes', values: [{ state: 'value', value: 'a' }, { state: 'value', value: 'b' }] }));
  assert.equal(cardinalityResult.status, 'error');
  if (cardinalityResult.status === 'error') assert.equal(cardinalityResult.code, PAGE_FIELD_ERROR_CODES.cardinalityViolation);
  assert.equal(cardinalityResult.trace.length, 1);

  const transformResult = await evaluatePageFieldMapping(mapping({ candidates: [candidate({ transforms: [{ kind: 'trim' }] })] }), async () => ({ kind: 'nodes', values: [{ state: 'value', value: 5 }] }));
  assert.equal(transformResult.status, 'error');
  if (transformResult.status === 'error') assert.equal(transformResult.code, PAGE_FIELD_ERROR_CODES.transformFailed);

  const validationResult = await evaluatePageFieldMapping(mapping({ validation: { valueType: 'string', nonBlank: true } }), async () => ({ kind: 'nodes', values: [{ state: 'value', value: '' }] }));
  assert.equal(validationResult.status, 'error');
  if (validationResult.status === 'error') assert.equal(validationResult.code, PAGE_FIELD_ERROR_CODES.validationFailed);
});

test('many preserves typed order; join and to_string scalarize explicitly', async () => {
  const joined = await evaluatePageFieldMapping(mapping({ candidates: [candidate({ cardinality: 'many', transforms: [{ kind: 'join', separator: '|' }] })] }), async () => ({
    kind: 'nodes', values: [
      { state: 'value', value: 1 },
      { state: 'value', value: null },
      { state: 'value', value: false },
    ],
  }));
  assert.equal(joined.status, 'value');
  if (joined.status === 'value') assert.equal(joined.value, '1|null|false');

  const stringified = await evaluatePageFieldMapping(mapping({ candidates: [candidate({ selector: { family: 'xpath', query: 'count(//x)' }, read: { kind: 'raw' }, transforms: [{ kind: 'to_string' }] })] }), async () => ({ kind: 'scalar', value: 0 }));
  assert.equal(stringified.status, 'value');
  if (stringified.status === 'value') assert.equal(stringified.value, '0');
});

test('default applies only to Missing; false, zero and empty string remain real values', async () => {
  for (const value of [false, 0, ''] as const) {
    const result = await evaluatePageFieldMapping(mapping({
      candidates: [candidate({ selector: { family: 'xpath', query: 'x' }, read: { kind: 'raw' } })],
      defaultValue: 'fallback',
    }), async () => ({ kind: 'scalar', value }));
    assert.equal(result.status, 'value');
    if (result.status === 'value') assert.equal(result.value, value);
  }
  const fallback = await evaluatePageFieldMapping(mapping({ defaultValue: 'fallback' }), async () => ({ kind: 'nodes', values: [] }));
  assert.equal(fallback.status, 'value');
  if (fallback.status === 'value') assert.equal(fallback.value, 'fallback');
  const required = await evaluatePageFieldMapping(mapping({ required: true }), async () => ({ kind: 'nodes', values: [] }));
  assert.equal(required.status, 'error');
  if (required.status === 'error') assert.equal(required.code, PAGE_FIELD_ERROR_CODES.requiredMissing);
});

test('Chrome reader targets one exact document in ISOLATED world and rejects document mismatch', async () => {
  const calls: unknown[] = [];
  const scripting: ChromeScriptingLike = {
    async executeScript<T>(injection: Parameters<ChromeScriptingLike['executeScript']>[0]) {
      calls.push(injection);
      return [{ documentId: CONTEXT.topDocumentId, frameId: 0, result: { ok: true, result: { kind: 'nodes', values: [{ state: 'value', value: 'ok' }] } } as T }];
    },
  };
  const reader = new ChromePageFieldReader(scripting);
  const result = await reader.read(CONTEXT, mapping().candidates[0]!);
  assert.equal(result.kind, 'nodes');
  const call = calls[0] as { target: { tabId: number; documentIds: readonly string[] }; world: string };
  assert.deepEqual(call.target, { tabId: 7, documentIds: ['top-doc-a'] });
  assert.equal(call.world, 'ISOLATED');

  const mismatch = new ChromePageFieldReader({
    async executeScript<T>() { return [{ documentId: 'other-doc', frameId: 0, result: { ok: true, result: { kind: 'nodes', values: [] } } as T }]; },
  });
  await assert.rejects(() => mismatch.read(CONTEXT, mapping().candidates[0]!), (error) => (error as { code?: string }).code === PAGE_FIELD_ERROR_CODES.documentMismatch);
});

test('exact-context service rechecks pageRevision around each candidate and fails closed on navigation race', async () => {
  let calls = 0;
  const staleContext: PageContextValue = { ...CONTEXT, pageRevision: 2 as never, url: 'https://example.test/spa' };
  const guard = {
    async current() {
      calls += 1;
      return calls >= 3 ? staleContext : CONTEXT;
    },
  };
  const reader = { async read(): Promise<PageFieldDomReadResult> { return { kind: 'nodes', values: [{ state: 'value', value: 'Episode' }] }; } };
  const service = new PageFieldEvaluationService(guard, reader);
  const result = await service.evaluate({ context: CONTEXT, mapping: definition(mapping()) });
  assert.equal(result.status, 'error');
  if (result.status === 'error') assert.equal(result.code, PAGE_FIELD_ERROR_CODES.contextStale);
});

test('page-field explanation trace is structural and omits selector queries and extracted values', async () => {
  const body = mapping({ candidates: [candidate({ selector: { family: 'css', query: '#secret-token' } })] });
  const result = await evaluatePageFieldMapping(body, async () => ({ kind: 'nodes', values: [{ state: 'value', value: 'private-page-value' }] }));
  const trace = JSON.stringify(result.trace);
  assert.equal(trace.includes('#secret-token'), false);
  assert.equal(trace.includes('private-page-value'), false);
  assert.match(trace, /candidateIndex/);
});
