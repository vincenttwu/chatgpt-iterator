import type { JsonObject, StableId } from '../core/index.ts';
import type { FrozenDefinitionSnapshot, ImmutableWatchSessionRecord } from '../definitions/index.ts';
import type { IsoTimestamp, ResourceObservationRecord } from '../persistence/index.ts';

export const RESOURCE_FILTER_SCHEMA_VERSION = 1 as const;
export const RESOURCE_CLASSIFICATION_SCHEMA_VERSION = 1 as const;
export const RESOURCE_OCCURRENCE_SCHEMA_VERSION = 1 as const;
export const RESOURCE_DEDUP_GROUP_SCHEMA_VERSION = 1 as const;

export const RESOURCE_KINDS = [
  'image',
  'video',
  'stream_manifest',
  'audio',
  'other',
  'unknown',
] as const;
export type ResourceKind = (typeof RESOURCE_KINDS)[number];

export type ResourceClassificationReason =
  | 'mime_stream_manifest'
  | 'mime_image'
  | 'mime_video'
  | 'mime_audio'
  | 'mime_other'
  | 'request_type_image'
  | 'extension_stream_manifest'
  | 'extension_image'
  | 'extension_video'
  | 'extension_audio'
  | 'ambiguous_media'
  | 'no_decisive_evidence';

export interface CanonicalResourceUrl extends JsonObject {
  readonly href: string;
  readonly pathname: string;
  readonly extension?: string;
}

export interface ResourceClassificationEvidence extends JsonObject {
  readonly requestType: string;
  readonly mimeType?: string;
  readonly extension?: string;
  readonly mimeKind?: ResourceKind;
  readonly extensionKind?: ResourceKind;
  readonly conflict: boolean;
}

export interface ResourceClassification extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_CLASSIFICATION_SCHEMA_VERSION;
  readonly kind: ResourceKind;
  readonly reason: ResourceClassificationReason;
