import { freezeJsonValue, type StableId } from '../core/index.ts';
import type { FrozenDefinitionSnapshot, ImmutableWatchSessionRecord } from '../definitions/index.ts';
import {
  parsePackagizerTemplate,
  requirePackagizerTemplateBody,
  resolveWatchSessionPackagizerRules,
} from '../packagizer/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from './errors.ts';
import type { PageFieldMappingDefinition } from './types.ts';
import {
  requirePageFieldMappingDefinition,
  validateWatchSessionPageFieldMappings,
} from './validation.ts';

export const PAGE_FIELD_PAGE_TOKENS = [
  'page.url',
  'page.origin',
  'page.title',
] as const;

export type PageFieldPageToken = (typeof PAGE_FIELD_PAGE_TOKENS)[number];

const PAGE_TOKEN_SET = new Set<string>(PAGE_FIELD_PAGE_TOKENS);
const FIELD_TOKEN_PATTERN = /^field\.([a-z][a-z0-9_]{0,63})$/;

export interface PageFieldDependencyPlan {
  readonly pageTokens: readonly PageFieldPageToken[];
  readonly fieldSlugs: readonly string[];
  readonly mappings: readonly PageFieldMappingDefinition[];
  readonly required: boolean;
}

function collectToken(
  token: string,
  pageTokens: Set<PageFieldPageToken>,
  fieldSlugs: Set<string>,
): void {
  if (PAGE_TOKEN_SET.has(token)) {
    pageTokens.add(token as PageFieldPageToken);
    return;
  }
  const match = FIELD_TOKEN_PATTERN.exec(token);
  if (match !== null) fieldSlugs.add(match[1]!);
}

function enabledFrozenTemplates(session: ImmutableWatchSessionRecord): readonly FrozenDefinitionSnapshot[] {
  return session.value.definitions.filter(
    (definition) => definition.kind === 'template' && definition.value.enabled,
  );
}

/**
 * Resolve the exact frozen page/field token dependency set for one WatchSession.
 * Only tokens reachable through enabled frozen Packagizer rules/templates participate.
 */
export function resolveWatchSessionPageFieldDependencies(
  session: ImmutableWatchSessionRecord,
): PageFieldDependencyPlan {
  validateWatchSessionPageFieldMappings(session);
  const pageTokens = new Set<PageFieldPageToken>();
  const fieldSlugs = new Set<string>();

  for (const rule of resolveWatchSessionPackagizerRules(session)) {
    for (const condition of rule.body.conditions) collectToken(condition.token, pageTokens, fieldSlugs);
  }

  for (const template of enabledFrozenTemplates(session)) {
    const body = requirePackagizerTemplateBody(template.value.body);
    for (const token of parsePackagizerTemplate(body.text).tokenNames) {
      collectToken(token, pageTokens, fieldSlugs);
    }
  }

  const mappingBySlug = new Map<string, PageFieldMappingDefinition>();
  for (const definition of session.value.definitions) {
    if (definition.kind !== 'pageFieldMapping' || !definition.value.enabled) continue;
    const mapping = requirePageFieldMappingDefinition(definition);
    mappingBySlug.set(mapping.body.slug, mapping);
  }

  const sortedSlugs = [...fieldSlugs].sort();
  const mappings = sortedSlugs.map((slug) => {
    const mapping = mappingBySlug.get(slug);
    if (mapping === undefined) {
      throw new PageFieldError(
        PAGE_FIELD_ERROR_CODES.dependencyMissing,
        `Frozen PageFieldMapping dependency is missing for field.${slug}`,
      );
    }
    return mapping;
  });

  return Object.freeze({
    pageTokens: Object.freeze([...pageTokens].sort() as PageFieldPageToken[]),
    fieldSlugs: Object.freeze(sortedSlugs),
    mappings: Object.freeze(mappings),
    required: pageTokens.size > 0 || fieldSlugs.size > 0,
  });
}

export function validateWatchSessionPageFieldDependencies(session: ImmutableWatchSessionRecord): void {
  resolveWatchSessionPageFieldDependencies(session);
}

export function pageFieldMappingById(
  plan: PageFieldDependencyPlan,
  id: StableId<'definition'>,
): PageFieldMappingDefinition | undefined {
  return plan.mappings.find((mapping) => mapping.snapshot.id === id);
}
