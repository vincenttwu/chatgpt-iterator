<file path="scripts/check_browser_indexeddb_performance.py">
#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import tempfile
import threading
import time
import urllib.request
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

import websocket

ROOT = Path(__file__).resolve().parents[1]
CONTRACT = json.loads((ROOT / 'performance-readiness.json').read_text())
WORKLOAD = CONTRACT['workloads']['browserIndexedDb']

class QuietHandler(SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        return

def free_port() -> int:
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        return sock.getsockname()[1]

def wait_json(url: str, timeout: float = 10.0):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=0.5) as response:
                return json.loads(response.read().decode('utf-8'))
        except Exception as exc:
            last = exc
            time.sleep(0.1)
    raise RuntimeError(f'DevTools endpoint unavailable: {last}')

def cdp_evaluate(ws_url: str, expression: str):
    ws = websocket.create_connection(ws_url, timeout=20, origin='http://127.0.0.1')
    try:
        ws.send(json.dumps({
            'id': 1,
            'method': 'Runtime.evaluate',
            'params': {
                'expression': expression,
                'awaitPromise': True,
                'returnByValue': True,
                'userGesture': True,
            },
        }))
        while True:
            message = json.loads(ws.recv())
            if message.get('id') != 1:
                continue
            if 'error' in message:
                raise RuntimeError(message['error'])
            payload = message['result']
            if payload.get('exceptionDetails') is not None:
                details = payload['exceptionDetails']
                raise RuntimeError(details.get('text') or details.get('exception', {}).get('description') or str(details))
            result = payload['result']
            if result.get('subtype') == 'error':
                raise RuntimeError(result.get('description', 'browser evaluation failed'))
            return result.get('value')
    finally:
        ws.close()

def run(chromium: str) -> dict:
    record_count = int(WORKLOAD['recordCount'])
    read_count = int(WORKLOAD['readCount'])
    payload_bytes = int(WORKLOAD['payloadBytes'])
    budget_ms = float(WORKLOAD['regressionBudgetMs'])
    with tempfile.TemporaryDirectory(prefix='crsniffer-browser-idb-') as temp_dir:
        root = Path(temp_dir)
        (root / 'index.html').write_text('<!doctype html><meta charset="utf-8"><title>crsniffer-idb-perf</title>')
        server = ThreadingHTTPServer(('127.0.0.1', 0), QuietHandler)
        server.RequestHandlerClass.directory = str(root)
        # SimpleHTTPRequestHandler's directory class attribute is not portable across Python versions;
        # run the server from the temporary root instead.
        previous_cwd = os.getcwd()
        os.chdir(root)
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        debug_port = free_port()
        profile = root / 'profile'
        proc = subprocess.Popen([
            chromium,
            '--headless=new', '--no-sandbox', '--disable-gpu', '--no-first-run',
            f'--remote-debugging-port={debug_port}', '--remote-allow-origins=http://127.0.0.1', f'--user-data-dir={profile}',
            f'http://127.0.0.1:{server.server_port}/',
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            targets = wait_json(f'http://127.0.0.1:{debug_port}/json/list')
            page = next((target for target in targets if target.get('type') == 'page'), None)
            if page is None:
                raise RuntimeError('Chromium page target unavailable')
            expression = f'''(async () => {{ try {{
              const recordCount = {record_count};
              const readCount = {read_count};
              const payload = 'x'.repeat({payload_bytes});
              const open = indexedDB.open('crsniffer-step12-capacity', 1);
              open.onupgradeneeded = () => {{
