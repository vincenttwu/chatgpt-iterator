import { freezeJsonValue } from '../core/index.ts';
import { RESOURCE_ERROR_CODES, ResourceError } from './errors.ts';
import type { CanonicalResourceUrl } from './types.ts';

const EXTENSION_PATTERN = /\.([A-Za-z0-9][A-Za-z0-9+_-]{0,15})$/;

export function resourcePathExtension(pathname: string): string | undefined {
  const segment = pathname.slice(pathname.lastIndexOf('/') + 1);
  const match = EXTENSION_PATTERN.exec(segment);
  return match?.[1] === undefined ? undefined : `.${match[1].toLowerCase()}`;
}

/** WHATWG URL serialization, retaining query serialization/order and removing only the fragment. */
export function canonicalizeResourceUrl(input: string): CanonicalResourceUrl {
  let url: URL;
  try {
    url = new URL(input);
  } catch {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidUrl, 'resource URL must be an absolute URL');
  }
  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidUrl, 'resource URL must use HTTP or HTTPS');
  }
  url.hash = '';
  const extension = resourcePathExtension(url.pathname);
  return freezeJsonValue({
    href: url.href,
    pathname: url.pathname,
    ...(extension === undefined ? {} : { extension }),
  }) as CanonicalResourceUrl;
}
</file>

