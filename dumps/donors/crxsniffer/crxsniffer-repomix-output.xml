        data["status"] = "sealed"
        json_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        yaml_path = workspace / "iteration_manifest.yaml"
        text = yaml_path.read_text(encoding="utf-8")
        text = re.sub(r'(?m)^iteration:.*$', 'iteration: "v0.1.1"', text, count=1)
        text = re.sub(r'(?m)^previous_iteration:.*$', 'previous_iteration: "v0.1.0"', text, count=1)
        text = re.sub(r'(?m)^status:.*$', 'status: "sealed"', text, count=1)
        yaml_path.write_text(text, encoding="utf-8")
        validated = self.run_manager(workspace, "validate")
        self.assertEqual(validated.returncode, 0, validated.stdout + validated.stderr)


class WorkspaceRecoveryTests(unittest.TestCase):
    PROJECT = "sample-project"

    def make_recovery_fixture(self, temp_root: Path, name: str, version: str) -> Path:
        """Build the smallest realistic repository needed to exercise recovery semantics."""
        workspace = temp_root / name
        workspace.mkdir(parents=True)
        for relative in (".gitignore", "CHANGELOG.md", "iteration_manifest.json", "iteration_manifest.yaml"):
            source = ROOT / relative
            target = workspace / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
        shutil.copytree(ROOT / "agents", workspace / "agents", ignore=COPY_IGNORE)
        for relative in ("docs/README.md", "iterations/README.md"):
            source = ROOT / relative
            target = workspace / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
        (workspace / "src").mkdir()
        (workspace / "src" / "recovery-fixture.txt").write_text("bounded recovery fixture\n", encoding="utf-8")
        self.set_workspace_identity(workspace, version)
        return workspace

    def set_workspace_identity(self, workspace: Path, version: str) -> None:
        json_path = workspace / "iteration_manifest.json"
        data = json.loads(json_path.read_text(encoding="utf-8"))
        data["project"] = self.PROJECT
        data["iteration"] = version
        json_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        yaml_path = workspace / "iteration_manifest.yaml"
        text = yaml_path.read_text(encoding="utf-8")
        text = re.sub(r"(?m)^project:.*$", f"project: {self.PROJECT}", text, count=1)
        text = re.sub(r"(?m)^iteration:.*$", f"iteration: {version}", text, count=1)
        yaml_path.write_text(text, encoding="utf-8")

    def run_manager(self, workspace: Path, *args: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["python3", str(workspace / "agents" / "scripts" / "workspace-manager.py"), *args],
            cwd=workspace,
            text=True,
            capture_output=True,
            check=False,
        )

    def test_recovery_governance_and_singular_iteration_authority_are_present(self) -> None:
        governance = ROOT / "agents" / "governance"
        iteration = (governance / "iteration.md").read_text(encoding="utf-8")
        recovery = (governance / "recovery.md").read_text(encoding="utf-8")
        self.assertFalse((governance / "iterations.md").exists())
        self.assertIn("sole repository governance authority", iteration)
        self.assertIn("workspace-manager.py", recovery)
        self.assertIn("/mnt/data/snapshots/", recovery)
        self.assertIn("{project}.vN.N.N.zip.sha256", recovery)
        self.assertIn("{project}.vN.N.N.snapshot.json", recovery)
        self.assertIn("workspace-manager.py` owns recoverable **state**", recovery)
        self.assertIn("iteration-manager.py` owns reconstructable **transitions**", recovery)
        self.assertIn("{project}.vN.N.N-pre", recovery)
        self.assertIn("promoted: false", recovery)
        self.assertIn("{project}.vN.N.N-{kind}.YYYYMMDDTHHMMSSZ", recovery)
        self.assertIn("Promotion cleanup is **transactional**", recovery)
        management = (governance / "management.md").read_text(encoding="utf-8")
        self.assertIn("| Capability | Owner | Canonical command | Use when | Governing document |", management)
        self.assertIn("workspace-manager.py seal --version vN.N.N", management)
        self.assertIn("workspace-manager.py cleanup --version vN.N.N --kind checkpoint --retain 3", management)
        self.assertIn("iteration-manager.py seal <slug> vN.N.N --result HEAD", management)
        self.assertIn("record-manager.py next-id <type>", management)
        self.assertIn("knowledge-manager.py next-id", management)

    def test_workspace_manager_seals_and_verifies_external_recovery_state(self) -> None:
        temp_root = Path(tempfile.mkdtemp(prefix="workspace-recovery-test-"))
        self.addCleanup(shutil.rmtree, temp_root, ignore_errors=True)
        workspace = self.make_recovery_fixture(temp_root, "sample-project.v0.0.5", "v0.0.5")
        (workspace / ".git").mkdir()
        (workspace / ".git" / "ignored").write_text("transient\n", encoding="utf-8")
        (workspace / "node_modules").mkdir()
        (workspace / "node_modules" / "ignored").write_text("transient\n", encoding="utf-8")
        donor_dir = workspace / "dumps" / "donors" / "sample"
        donor_dir.mkdir(parents=True)
        (donor_dir / "sample.v0.0.1.zip").write_bytes(b"donor-archive" * 1024)
        (donor_dir / "sample.v0.0.1.zip.sha256").write_text("deadbeef  sample.v0.0.1.zip\n", encoding="utf-8")
        iteration_dir = workspace / "iterations" / "sample.v0.0.1"
        iteration_dir.mkdir(parents=True)
        (iteration_dir / "changes.diff").write_text("binary-patch-evidence\n" * 1024, encoding="utf-8")
        (iteration_dir / "manifest.yaml").write_text("status: passed\n", encoding="utf-8")
        (workspace / "src" / "compressible.txt").write_text("compress-me\n" * 10000, encoding="utf-8")
        recovery_root = temp_root / "recovery"

        sealed = self.run_manager(
            workspace,
            "seal",
            "--version",
            "v0.0.5",
            "--recovery-root",
            str(recovery_root),
        )
        self.assertEqual(sealed.returncode, 0, sealed.stdout + sealed.stderr)
        self.assertIn("seal=passed", sealed.stdout)

        identity = "sample-project.v0.0.5"
        snapshot = recovery_root / "snapshots" / identity
        bundle = recovery_root / f"{identity}.zip"
        checksum = recovery_root / f"{identity}.zip.sha256"
        metadata_path = recovery_root / f"{identity}.snapshot.json"
        for path in (snapshot, bundle, checksum, metadata_path):
            self.assertTrue(path.exists(), path)
        self.assertFalse((snapshot / ".git").exists())
        self.assertFalse((snapshot / "node_modules").exists())
        self.assertFalse((snapshot / "dumps" / "donors" / "sample" / "sample.v0.0.1.zip").exists())
        self.assertTrue((snapshot / "dumps" / "donors" / "sample" / "sample.v0.0.1.zip.sha256").exists())
        self.assertFalse((snapshot / "iterations" / "sample.v0.0.1" / "changes.diff").exists())
        self.assertTrue((snapshot / "iterations" / "sample.v0.0.1" / "manifest.yaml").exists())
        with zipfile.ZipFile(bundle, "r") as archive:
            compressed = archive.getinfo(f"{identity}/src/compressible.txt")
            self.assertEqual(compressed.compress_type, zipfile.ZIP_DEFLATED)
            self.assertLess(compressed.compress_size, compressed.file_size)

        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        self.assertEqual(metadata["artifact_type"], "workspace_recovery_snapshot")
        self.assertEqual(metadata["version"], "v0.0.5")
        self.assertEqual(metadata["validation"]["status"], "passed")
        self.assertEqual(metadata["validation"]["deterministic_zip"], "byte-identical reproduction passed")
        self.assertEqual(checksum.read_text(encoding="utf-8").strip().split()[0], metadata["bundle"]["sha256"])

        verified = self.run_manager(
            workspace,
            "verify",
            "--version",
            "v0.0.5",
            "--recovery-root",
            str(recovery_root),
        )
        self.assertEqual(verified.returncode, 0, verified.stdout + verified.stderr)
        self.assertIn("verification=passed", verified.stdout)

        repeated = self.run_manager(
            workspace,
            "seal",
            "--version",
            "v0.0.5",
            "--recovery-root",
            str(recovery_root),
        )
        self.assertEqual(repeated.returncode, 2, repeated.stdout + repeated.stderr)
        self.assertIn("refusing to overwrite existing recovery artifact", repeated.stderr)

    def test_workspace_manager_captures_and_verifies_non_promoted_pre_state(self) -> None:
        temp_root = Path(tempfile.mkdtemp(prefix="workspace-pre-recovery-test-"))
