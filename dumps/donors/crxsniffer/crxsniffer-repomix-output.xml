<file path="src/webhooks/webhook-engine.ts">
import { assertJsonSafe, cloneJsonValue, freezeJsonValue, type JsonObject, type JsonValue } from '../core/index.ts';
import { matchSmartPatternList } from '../resources/glob.ts';
import type { WebhookEngineSettings, WebhookJob, WebhookJobStatus, WebhookStateSnapshot } from './webhook-types.ts';
import type { WebhookQueueStore } from './webhook-store.ts';

export const DEFAULT_WEBHOOK_SETTINGS: WebhookEngineSettings = {
  webhookEnabled: false,
  webhookEndpointUrl: '',
  webhookSecretKey: '',
  webhookIncludeGlobs: '*',
  webhookExcludeGlobs: '',
  maxGlobalConcurrency: 2,
  maxDomainConcurrency: 1,
  webhookCooldownIntervalMs: 500,
  webhookPayloadMode: 'standard',
};

export async function generateHmacSignature(secretKey: string, payloadText: string, timestamp: number): Promise<string> {
  if (secretKey.trim() === '') return '';
  const encoder = new TextEncoder();
  const keyData = encoder.encode(secretKey);
  const messageData = encoder.encode(`${timestamp}.${payloadText}`);
  const cryptoKey = await crypto.subtle.importKey(
    'raw',
    keyData,
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign'],
  );
  const signatureBuffer = await crypto.subtle.sign('HMAC', cryptoKey, messageData);
  const hashArray = Array.from(new Uint8Array(signatureBuffer));
  return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
}

export function evaluateWebhookResourceGuard(
  url: string,
  settings: WebhookEngineSettings,
): { admitted: boolean; filterReason?: 'disabled' | 'invalid_endpoint' | 'rule_mismatch' } {
  if (!settings.webhookEnabled) {
    return { admitted: false, filterReason: 'disabled' };
  }

  const endpoint = settings.webhookEndpointUrl.trim();
  if (endpoint === '') {
    return { admitted: false, filterReason: 'invalid_endpoint' };
  }

  const excludeGlobs = settings.webhookExcludeGlobs ?? '';
  const includeGlobs = settings.webhookIncludeGlobs ?? '*';

  if (excludeGlobs.trim() !== '' && matchSmartPatternList(excludeGlobs, url)) {
    return { admitted: false, filterReason: 'rule_mismatch' };
  }

  if (includeGlobs.trim() !== '' && !matchSmartPatternList(includeGlobs, url)) {
    return { admitted: false, filterReason: 'rule_mismatch' };
  }

  return { admitted: true };
}

export type WebhookStateListener = (snapshot: WebhookStateSnapshot) => void;

export class WebhookQueueEngine {
  readonly #store: WebhookQueueStore;
  #settings: WebhookEngineSettings;
  #jobs: WebhookJob[] = [];
  #isPaused = false;
  #listeners = new Set<WebhookStateListener>();
  #domainLastDispatchedAt = new Map<string, number>();
  #activeDispatches = new Set<string>();
  #timer: ReturnType<typeof setTimeout> | null = null;

  constructor(store: WebhookQueueStore, settings: WebhookEngineSettings = DEFAULT_WEBHOOK_SETTINGS) {
    this.#store = store;
    this.#settings = settings;
  }

  async initialize(): Promise<void> {
    const { jobs, isPaused } = await this.#store.loadQueueState();
    this.#jobs = jobs;
    this.#isPaused = isPaused;
    this.#notify();
    this.#scheduleNextLoop();
  }

  updateSettings(settings: WebhookEngineSettings): void {
    this.#settings = settings;
    this.#notify();
    this.#scheduleNextLoop();
  }

  subscribe(listener: WebhookStateListener): () => void {
    this.#listeners.add(listener);
    listener(this.getSnapshot());
    return () => {
      this.#listeners.delete(listener);
    };
  }

  getSnapshot(): WebhookStateSnapshot {
    const activeCount = this.#jobs.filter((j) => j.status === 'dispatching').length;
    const queuedCount = this.#jobs.filter((j) => j.status === 'queued').length;
    const completedCount = this.#jobs.filter((j) => j.status === 'completed').length;
    const failedCount = this.#jobs.filter((j) => j.status === 'failed').length;
    const filteredCount = this.#jobs.filter((j) => j.status === 'filtered').length;

    return freezeJsonValue({
      isPaused: this.#isPaused,
      activeCount,
      queuedCount,
      completedCount,
      failedCount,
      filteredCount,
      jobs: this.#jobs,
      settings: this.#settings,
    }) as WebhookStateSnapshot;
  }

  enqueueJob(jobInput: {
    url: string;
    originUrl: string;
    domain: string;
    kind: 'video' | 'image' | 'audio' | 'stream' | 'document' | 'other';
    mimeType?: string;
    payload: JsonObject;
  }): WebhookJob {
    const id = `wh_job_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    const guard = evaluateWebhookResourceGuard(jobInput.url, this.#settings);
    const initialStatus: WebhookJobStatus = guard.admitted ? 'queued' : 'filtered';

    const jobRecord: Record<string, unknown> = {
      id,
      url: jobInput.url,
      originUrl: jobInput.originUrl,
      domain: jobInput.domain,
      kind: jobInput.kind,
      status: initialStatus,
      retryCount: 0,
      enqueuedAt: Date.now(),
      payload: cloneJsonValue(jobInput.payload),
    };

    if (jobInput.mimeType !== undefined) {
      jobRecord.mimeType = jobInput.mimeType;
    }
    if (guard.filterReason !== undefined) {
      jobRecord.filterReason = guard.filterReason;
    }

    const job: WebhookJob = freezeJsonValue(jobRecord as unknown as JsonValue) as unknown as WebhookJob;

    this.#jobs = [job, ...this.#jobs];
    void this.#persist();
    this.#notify();
    this.#scheduleNextLoop();
    return job;
  }

  pause(): void {
    this.#isPaused = true;
    void this.#persist();
    this.#notify();
  }

  resume(): void {
    this.#isPaused = false;
    void this.#persist();
    this.#notify();
    this.#scheduleNextLoop();
  }

  retryJob(jobId: string): void {
    this.#jobs = this.#jobs.map((job) => {
      if (job.id === jobId && (job.status === 'failed' || job.status === 'filtered')) {
        const next: Record<string, unknown> = { ...job, status: 'queued' };
        delete next.filterReason;
        delete next.lastError;
        return freezeJsonValue(next as unknown as JsonValue) as unknown as WebhookJob;
      }
      return job;
    });
    void this.#persist();
    this.#notify();
    this.#scheduleNextLoop();
  }

  clearCompleted(): void {
    this.#jobs = this.#jobs.filter((j) => j.status !== 'completed' && j.status !== 'filtered');
    void this.#persist();
    this.#notify();
  }

  clearAll(): void {
    this.#jobs = [];
    void this.#persist();
    this.#notify();
  }

  #scheduleNextLoop(): void {
    if (this.#timer !== null) {
      clearTimeout(this.#timer);
      this.#timer = null;
    }
    this.#timer = setTimeout(() => {
      this.#timer = null;
      void this.#processQueue();
    }, 50);
  }

  async #processQueue(): Promise<void> {
    if (this.#isPaused) return;

    const activeCount = this.#jobs.filter((j) => j.status === 'dispatching').length;
    const availableSlots = this.#settings.maxGlobalConcurrency - activeCount;
    if (availableSlots <= 0) return;

    const queuedJobs = this.#jobs.filter((j) => j.status === 'queued');
    if (queuedJobs.length === 0) return;

    const now = Date.now();

    for (const job of queuedJobs) {
      if (this.#activeDispatches.size >= this.#settings.maxGlobalConcurrency) break;

      const domainActive = this.#jobs.filter((j) => j.domain === job.domain && j.status === 'dispatching').length;
      if (domainActive >= this.#settings.maxDomainConcurrency) continue;

      const lastDispatched = this.#domainLastDispatchedAt.get(job.domain) ?? 0;
      if (now - lastDispatched < this.#settings.webhookCooldownIntervalMs) continue;

      this.#dispatchJob(job);
    }
  }

  async #dispatchJob(targetJob: WebhookJob): Promise<void> {
    this.#domainLastDispatchedAt.set(targetJob.domain, Date.now());
    this.#activeDispatches.add(targetJob.id);

    this.#jobs = this.#jobs.map((j) => {
      if (j.id === targetJob.id) {
        return freezeJsonValue({
          ...j,
          status: 'dispatching',
          startedAt: Date.now(),
        }) as WebhookJob;
      }
      return j;
    });
    this.#notify();

    try {
      const endpoint = this.#settings.webhookEndpointUrl.trim();
      const payloadText = JSON.stringify(targetJob.payload);
      const timestamp = Date.now();
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
        'Idempotency-Key': targetJob.id,
      };

      if (this.#settings.webhookSecretKey.trim() !== '') {
        const signature = await generateHmacSignature(this.#settings.webhookSecretKey, payloadText, timestamp);
        headers['X-Sniffer-Signature'] = `sha256=${signature}`;
        headers['X-Sniffer-Timestamp'] = String(timestamp);
      }

      const response = await fetch(endpoint, {
        method: 'POST',
        headers,
        body: payloadText,
        redirect: 'follow',
      });

      const statusCode = response.status;
      if (response.ok) {
        this.#updateJobState(targetJob.id, 'completed', { responseStatusCode: statusCode });
      } else {
        this.#updateJobState(targetJob.id, 'failed', {
          responseStatusCode: statusCode,
          lastError: `HTTP Error ${statusCode}: ${response.statusText}`,
        });
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Network failure dispatching webhook';
      this.#updateJobState(targetJob.id, 'failed', { lastError: message });
    } finally {
      this.#activeDispatches.delete(targetJob.id);
      this.#scheduleNextLoop();
    }
  }

  #updateJobState(jobId: string, status: WebhookJobStatus, updates: Partial<WebhookJob>): void {
    this.#jobs = this.#jobs.map((j) => {
      if (j.id === jobId) {
        return freezeJsonValue({
          ...j,
          ...updates,
          status,
          endedAt: Date.now(),
        }) as WebhookJob;
      }
      return j;
    });
    void this.#persist();
    this.#notify();
  }

  async #persist(): Promise<void> {
    await this.#store.saveQueueState(this.#jobs, this.#isPaused);
  }

  #notify(): void {
    const snapshot = this.getSnapshot();
    for (const listener of this.#listeners) {
      try {
        listener(snapshot);
      } catch {
        /* ignore consumer errors */
      }
    }
  }
}

export async function sendTestWebhook(settings: WebhookEngineSettings): Promise<{ ok: boolean; statusCode?: number; error?: string }> {
  const endpoint = settings.webhookEndpointUrl.trim();
  if (endpoint === '') {
    return { ok: false, error: 'Target webhook endpoint URL is empty' };
  }

  try {
    const timestamp = Date.now();
    const testPayload = {
      event: 'ping',
      test: true,
      timestamp,
      message: 'crsniffer webhook connection test',
    };
    const payloadText = JSON.stringify(testPayload);
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      'Idempotency-Key': `test_ping_${timestamp}`,
    };

    if (settings.webhookSecretKey.trim() !== '') {
      const signature = await generateHmacSignature(settings.webhookSecretKey, payloadText, timestamp);
      headers['X-Sniffer-Signature'] = `sha256=${signature}`;
      headers['X-Sniffer-Timestamp'] = String(timestamp);
    }

    const response = await fetch(endpoint, {
      method: 'POST',
      headers,
      body: payloadText,
      redirect: 'follow',
    });

    if (response.ok) {
      return { ok: true, statusCode: response.status };
    }
    return { ok: false, statusCode: response.status, error: `HTTP ${response.status}: ${response.statusText}` };
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Failed to connect to webhook endpoint';
    return { ok: false, error: message };
  }
}
