<file path="src/page-fields/transforms.ts">
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from './errors.ts';
import type { PageFieldTransform, PageFieldValue } from './types.ts';

function fail(message: string): never {
  throw new PageFieldError(PAGE_FIELD_ERROR_CODES.transformFailed, message);
}

function canonicalScalar(value: Exclude<PageFieldValue, readonly unknown[]>): string {
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  return String(value);
}

export function applyPageFieldTransform(value: PageFieldValue, transform: PageFieldTransform): PageFieldValue {
  switch (transform.kind) {
    case 'trim':
      if (typeof value !== 'string') return fail('trim requires string');
      return value.trim();
    case 'lower':
      if (typeof value !== 'string') return fail('lower requires string');
      return value.toLowerCase();
    case 'upper':
      if (typeof value !== 'string') return fail('upper requires string');
      return value.toUpperCase();
    case 'slice': {
      const start = transform.start!;
      if (typeof value === 'string') return value.slice(start, transform.end);
      if (Array.isArray(value)) return Object.freeze(value.slice(start, transform.end));
      return fail('slice requires string or list');
    }
    case 'replace':
      if (typeof value !== 'string') return fail('replace requires string');
      if (transform.search === '') return fail('replace search must not be empty');
      return value.split(transform.search!).join(transform.replacement!);
    case 'to_string':
      if (Array.isArray(value)) return fail('to_string does not scalarize lists');
      return canonicalScalar(value as Exclude<PageFieldValue, readonly unknown[]>);
    case 'join':
      if (!Array.isArray(value)) return fail('join requires list');
      return value.map((item) => canonicalScalar(item)).join(transform.separator!);
    default:
      return fail('unsupported page-field transform');
  }
}

export function applyPageFieldTransforms(value: PageFieldValue, transforms: readonly PageFieldTransform[]): PageFieldValue {
  let current = value;
  for (const transform of transforms) current = applyPageFieldTransform(current, transform);
  return current;
}
