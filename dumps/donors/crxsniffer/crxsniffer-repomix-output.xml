import {
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  requireJsonObject,
  requireStableId,
  type JsonPrimitive,
} from '../core/index.ts';
import type {
  DefinitionReference,
  FrozenDefinitionSnapshot,
  ImmutableWatchSessionRecord,
} from '../definitions/index.ts';
import { compileResourceGlob } from '../resources/index.ts';
import { PACKAGIZER_ERROR_CODES, PackagizerError } from './errors.ts';
import { parsePackagizerTemplate } from './templates.ts';
import { requirePackagizerTokenName } from './tokens.ts';
import {
  PACKAGIZER_ACTION_TYPES,
  PACKAGIZER_CONDITION_OPERATORS,
  type PackagizerAction,
  type PackagizerCondition,
  type PackagizerRuleBody,
  type PackagizerTemplateBody,
} from './types.ts';

const LOCAL_ID_PATTERN = /^[a-z][a-z0-9_-]{0,63}$/;
const MAX_CONDITIONS = 64;
const MAX_ACTIONS = 32;
const RULE_KEYS = new Set(['schemaVersion', 'conditions', 'actions', 'stopAfterSuccess']);
const TEMPLATE_KEYS = new Set(['schemaVersion', 'text']);
const CONDITION_KEYS = new Set(['id', 'token', 'operator', 'value']);
const ACTION_KEYS = new Set(['id', 'type', 'templateId']);

function rejectUnknownKeys(record: Readonly<Record<string, unknown>>, allowed: ReadonlySet<string>, label: string): void {
  for (const key of Object.keys(record)) {
    if (!allowed.has(key)) {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `Unsupported ${label} field: ${key}`);
    }
  }
}

function requireLocalId(value: unknown, label: string): string {
  if (typeof value !== 'string' || !LOCAL_ID_PATTERN.test(value)) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `${label} must match ${LOCAL_ID_PATTERN.source}`);
  }
  return value;
}

function requireJsonPrimitive(value: unknown, label: string): JsonPrimitive {
  if (value === null || typeof value === 'string' || typeof value === 'boolean') return value;
  if (typeof value === 'number' && Number.isFinite(value) && !Object.is(value, -0)) return value;
  throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, `${label} must be a JSON primitive`);
}

export function requirePackagizerCondition(value: unknown): PackagizerCondition {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, CONDITION_KEYS, 'condition');
  const operator = record.operator;
  if (typeof operator !== 'string' || !(PACKAGIZER_CONDITION_OPERATORS as readonly string[]).includes(operator)) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, 'Unsupported Packagizer condition operator');
  }
  const token = requirePackagizerTokenName(record.token);
  const noValue = operator === 'exists' || operator === 'missing';
  if (noValue && record.value !== undefined) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, `${operator} must not include value`);
  }
  if (!noValue && record.value === undefined) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, `${operator} requires value`);
  }
  const normalized: PackagizerCondition = {
    id: requireLocalId(record.id, 'condition.id'),
    token,
    operator: operator as PackagizerCondition['operator'],
    ...(noValue ? {} : { value: requireJsonPrimitive(record.value, 'condition.value') }),
  };
  if (['contains', 'starts_with', 'ends_with', 'glob'].includes(operator) && typeof normalized.value !== 'string') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, `${operator} requires a string value`);
  }
  if (['lt', 'lte', 'gt', 'gte'].includes(operator) && typeof normalized.value !== 'number') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, `${operator} requires a number value`);
  }
  if (operator === 'glob') {
    try {
      compileResourceGlob(normalized.value as string);
    } catch {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidCondition, 'glob condition uses an invalid glob pattern');
    }
  }
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function requirePackagizerAction(value: unknown): PackagizerAction {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  rejectUnknownKeys(record, ACTION_KEYS, 'action');
  if (typeof record.type !== 'string' || !(PACKAGIZER_ACTION_TYPES as readonly string[]).includes(record.type)) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidAction, 'Unsupported Packagizer action type');
  }
  const normalized: PackagizerAction = {
    id: requireLocalId(record.id, 'action.id'),
    type: record.type as PackagizerAction['type'],
    templateId: requireStableId(record.templateId, 'definition'),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function requirePackagizerRuleBody(value: unknown): PackagizerRuleBody {
  assertJsonSafe(value);
  const body = requireJsonObject(value);
  rejectUnknownKeys(body, RULE_KEYS, 'rule');
  if (body.schemaVersion !== 1) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'Packagizer rule schemaVersion must be 1');
  }
  if (!Array.isArray(body.conditions) || body.conditions.length > MAX_CONDITIONS) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `conditions must be an array of at most ${MAX_CONDITIONS}`);
  }
  if (!Array.isArray(body.actions) || body.actions.length === 0 || body.actions.length > MAX_ACTIONS) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `actions must contain 1..${MAX_ACTIONS} entries`);
  }
  if (typeof body.stopAfterSuccess !== 'boolean') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'stopAfterSuccess must be boolean');
  }
  const conditions = body.conditions.map(requirePackagizerCondition);
  const actions = body.actions.map(requirePackagizerAction);
  if (new Set(conditions.map((condition) => condition.id)).size !== conditions.length) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'condition IDs must be unique within a rule');
  }
  if (new Set(actions.map((action) => action.id)).size !== actions.length) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'action IDs must be unique within a rule');
  }
  return freezeJsonValue(cloneJsonValue({
    schemaVersion: 1,
    conditions,
    actions,
    stopAfterSuccess: body.stopAfterSuccess,
  })) as PackagizerRuleBody;
}

export function requirePackagizerTemplateBody(value: unknown): PackagizerTemplateBody {
  assertJsonSafe(value);
  const body = requireJsonObject(value);
  rejectUnknownKeys(body, TEMPLATE_KEYS, 'template');
  if (body.schemaVersion !== 1 || typeof body.text !== 'string') {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidTemplate, 'Packagizer template requires schemaVersion 1 and string text');
  }
  parsePackagizerTemplate(body.text);
  return freezeJsonValue(cloneJsonValue({ schemaVersion: 1, text: body.text })) as PackagizerTemplateBody;
}

function frozenById(session: ImmutableWatchSessionRecord): Map<string, FrozenDefinitionSnapshot> {
  return new Map(session.value.definitions.map((definition) => [definition.id, definition]));
}

function requireWatchSnapshot(session: ImmutableWatchSessionRecord): FrozenDefinitionSnapshot {
  const watch = session.value.definitions.find(
    (definition) => definition.id === session.value.watchDefinitionId && definition.kind === 'watch',
  );
  if (watch === undefined) {
    throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, 'WatchSession is missing its frozen Watch definition');
  }
  return watch;
}

function referencedTemplateIds(references: readonly DefinitionReference[]): Set<string> {
  return new Set(references.filter((reference) => reference.kind === 'template').map((reference) => reference.id));
}

export interface FrozenPackagizerRule {
  readonly definition: FrozenDefinitionSnapshot;
  readonly body: PackagizerRuleBody;
}

export function resolveWatchSessionPackagizerRules(
  session: ImmutableWatchSessionRecord,
): readonly FrozenPackagizerRule[] {
  const byId = frozenById(session);
  const watch = requireWatchSnapshot(session);
  const rules: FrozenPackagizerRule[] = [];
  for (const reference of watch.value.references) {
    if (reference.kind !== 'packagizerRule') continue;
    const rule = byId.get(reference.id);
    if (rule === undefined || rule.kind !== 'packagizerRule') {
      throw new PackagizerError(PACKAGIZER_ERROR_CODES.invalidRule, `Frozen Packagizer rule ${reference.id} is missing`);
    }
    if (!rule.value.enabled) continue;
    const body = requirePackagizerRuleBody(rule.value.body);
    const allowedTemplates = referencedTemplateIds(rule.value.references);
    for (const action of body.actions) {
      if (!allowedTemplates.has(action.templateId)) {
        throw new PackagizerError(
          PACKAGIZER_ERROR_CODES.templateNotReferenced,
          `Action ${action.id} template is not referenced by rule ${rule.id}`,
        );
      }
      const template = byId.get(action.templateId);
      if (template === undefined || template.kind !== 'template' || !template.value.enabled) {
        throw new PackagizerError(
          PACKAGIZER_ERROR_CODES.templateNotFrozen,
          `Action ${action.id} template ${action.templateId} is unavailable in the frozen WatchSession`,
        );
      }
      requirePackagizerTemplateBody(template.value.body);
    }
    rules.push(Object.freeze({ definition: rule, body }));
  }
  return Object.freeze(rules);
}

export function validateWatchSessionPackagizer(session: ImmutableWatchSessionRecord): void {
  const byId = frozenById(session);
  // Validate enabled directly frozen templates as well so invalid template definitions fail before Watch.
  for (const definition of byId.values()) {
    if (definition.kind === 'template' && definition.value.enabled) {
      requirePackagizerTemplateBody(definition.value.body);
    }
  }
  resolveWatchSessionPackagizerRules(session);
}
