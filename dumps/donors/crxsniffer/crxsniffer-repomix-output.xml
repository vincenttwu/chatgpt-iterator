        self.assertFalse((recovery_root / f"{old_identity}.zip").exists())
        for stamp in stamps[1:]:
            identity = f"sample-project.v0.0.6-checkpoint.{stamp}"
            self.assertTrue((recovery_root / "snapshots" / identity).exists())

    def test_successful_seal_cleans_matching_pre_unless_kept(self) -> None:
        temp_root = Path(tempfile.mkdtemp(prefix="workspace-pre-cleanup-test-"))
