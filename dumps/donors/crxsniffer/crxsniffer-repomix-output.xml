#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import sys

sys.dont_write_bytecode = True
from pathlib import Path

from _manager_common import current_iteration, next_id, parse_frontmatter, read_text, replace_frontmatter_scalar, slugify, utc_now, workspace_root, yaml_string

ROOT = workspace_root(__file__)
AGENTS = ROOT / "agents"
KNOWLEDGE = AGENTS / "knowledge"


def note_files() -> list[Path]:
    return sorted(KNOWLEDGE.glob("**/NOTE-*.md"))


def _parse_time(value: object) -> dt.datetime | None:
    if value in {None, "", "null"}:
        return None
    try:
        parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def validate() -> int:
    errors: list[str] = []
    seen: dict[str, Path] = {}
    for path in note_files():
        try:
            meta = parse_frontmatter(read_text(path))
        except Exception as exc:
            errors.append(f"{path.relative_to(ROOT)}: {exc}")
            continue
        record_id = str(meta.get("record_id") or "")
        if meta.get("record_type") != "note":
            errors.append(f"{path.relative_to(ROOT)}: record_type must be 'note'")
        if not record_id.startswith("NOTE-"):
            errors.append(f"{path.relative_to(ROOT)}: record_id must use NOTE-XXXX")
        if record_id in seen:
            errors.append(f"duplicate {record_id}: {seen[record_id].relative_to(ROOT)} and {path.relative_to(ROOT)}")
        else:
            seen[record_id] = path
        for key in ("knowledge.topic", "knowledge.source_kind", "knowledge.freshness", "knowledge.last_verified_at"):
            if meta.get(key) in {None, ""}:
                errors.append(f"{path.relative_to(ROOT)}: {key} is required")
        if meta.get("knowledge.freshness") not in {"current", "historical", "unknown"}:
            errors.append(f"{path.relative_to(ROOT)}: invalid knowledge.freshness")
        if _parse_time(meta.get("knowledge.last_verified_at")) is None:
            errors.append(f"{path.relative_to(ROOT)}: knowledge.last_verified_at must be an ISO-8601 timestamp")
        review = meta.get("knowledge.review_after")
        if review is not None and _parse_time(review) is None:
            errors.append(f"{path.relative_to(ROOT)}: knowledge.review_after must be null or ISO-8601")
    if errors:
        for error in errors:
            print(f"ERROR: {error}")
        return 1
    print(f"validated {len(seen)} knowledge note(s)")
    return 0


def render_note(topic: str, title: str, source_kind: str, freshness: str, provenance: str | None) -> tuple[Path, str]:
    note_id = next_id("NOTE", note_files())
    slug = slugify(title)
    topic_slug = slugify(topic)
    now = utc_now()
    text = read_text(AGENTS / "templates" / "NOTE.md")
    text = text.replace("NOTE-XXXX", note_id).replace("replace-with-slug", slug).replace("Replace With Knowledge Note Title", title)
    text = text.replace("replace-with-topic", topic_slug).replace("YYYY-MM-DDTHH:MM:SSZ", now)
    text = replace_frontmatter_scalar(text, "title", yaml_string(title))
    text = replace_frontmatter_scalar(text, "knowledge.source_kind", source_kind)
    text = replace_frontmatter_scalar(text, "knowledge.freshness", freshness)
    provenance = provenance or current_iteration(ROOT)
    if provenance:
        text = replace_frontmatter_scalar(text, "provenance.created_from.id", yaml_string(provenance))
    path = KNOWLEDGE / topic_slug / f"{note_id}--{slug}.md"
    return path, text


def stale_notes() -> int:
    now = dt.datetime.now(dt.timezone.utc)
    stale = 0
    for path in note_files():
        meta = parse_frontmatter(read_text(path))
        review = _parse_time(meta.get("knowledge.review_after"))
        freshness = meta.get("knowledge.freshness")
        if freshness == "unknown" or (review is not None and review <= now):
            print(f"{meta.get('record_id')}\t{freshness}\t{path.relative_to(ROOT)}")
            stale += 1
    print(f"stale_or_review_due={stale}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage repository-governed knowledge notes.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("validate")
    sub.add_parser("list")
    sub.add_parser("stale")
    sub.add_parser("next-id")
    create = sub.add_parser("create")
    create.add_argument("topic")
    create.add_argument("title")
    create.add_argument("--source-kind", choices=["official", "source", "experiment", "secondary", "mixed"], default="mixed")
    create.add_argument("--freshness", choices=["current", "historical", "unknown"], default="current")
    create.add_argument("--provenance")
    create.add_argument("--stdout", action="store_true")
    args = parser.parse_args()

    if args.command == "validate":
        return validate()
    if args.command == "list":
        for path in note_files():
            meta = parse_frontmatter(read_text(path))
            print(f"{meta.get('record_id')}\t{meta.get('knowledge.topic')}\t{meta.get('knowledge.freshness')}\t{path.relative_to(ROOT)}")
        return 0
    if args.command == "stale":
        return stale_notes()
    if args.command == "next-id":
        print(next_id("NOTE", note_files()))
        return 0
    if args.command == "create":
        path, text = render_note(args.topic, args.title, args.source_kind, args.freshness, args.provenance)
        if args.stdout:
            sys.stdout.write(text)
            return 0
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists():
            print(f"ERROR: refusing to overwrite {path}", file=sys.stderr)
            return 2
        path.write_text(text, encoding="utf-8")
        print(path.relative_to(ROOT))
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
