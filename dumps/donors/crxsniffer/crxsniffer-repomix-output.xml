import assert from 'node:assert/strict';
import test from 'node:test';

import { createStableId, type JsonObject } from '../../src/core/index.ts';
import {
  ChromePageContextCapture,
  PageContextRegistry,
  type ChromeWebNavigationEventLike,
  type ChromeWebNavigationLike,
  type PageNavigationCommittedDetails,
  type PageNavigationFrame,
  type PageNavigationSameDocumentDetails,
} from '../../src/page-context/index.ts';
import {
  JsonRecordRepository,
  PERSISTENCE_STORES,
  requireResourceObservationRecord,
  type RepositoryStorePort,
  type ResourceObservationRecord,
} from '../../src/persistence/index.ts';
import {
  ObservationLifecycle,
  type PendingObservationStore,
  type PendingObservationTrace,
  type WebRequestBaseDetails,
} from '../../src/observations/index.ts';
import {
  WATCH_SESSION_STORAGE_KEY,
  type WatchSessionStatePort,
  type WatchStatusActive,
} from '../../src/watch/index.ts';

class MemorySession implements WatchSessionStatePort {
  readonly values = new Map<string, JsonObject>();
  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }
  async set(key: string, value: JsonObject): Promise<void> { this.values.set(key, structuredClone(value)); }
  async remove(key: string): Promise<void> { this.values.delete(key); }
}

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();
  async get(key: string): Promise<unknown> { return structuredClone(this.values.get(key)); }
  async put(value: JsonObject): Promise<void> {
    if (typeof value.id !== 'string') throw new Error('id required');
    this.values.set(value.id, structuredClone(value));
  }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async getAll(): Promise<readonly unknown[]> { return [...this.values.values()].map((value) => structuredClone(value)); }
}

class MemoryPending implements PendingObservationStore {
  readonly values = new Map<string, PendingObservationTrace>();
  async get(key: string): Promise<PendingObservationTrace | undefined> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }
  async put(key: string, value: PendingObservationTrace): Promise<void> { this.values.set(key, structuredClone(value)); }
  async delete(key: string): Promise<void> { this.values.delete(key); }
  async list(): Promise<readonly PendingObservationTrace[]> { return [...this.values.values()].map((value) => structuredClone(value)); }
  async clear(): Promise<void> { this.values.clear(); }
}

class FakeEvent<T> implements ChromeWebNavigationEventLike<T> {
  readonly listeners = new Set<(details: T) => void>();
  addListener(listener: (details: T) => void): void { this.listeners.add(listener); }
  removeListener(listener: (details: T) => void): void { this.listeners.delete(listener); }
  emit(details: T): void { for (const listener of this.listeners) listener(details); }
}

class FakeWebNavigation implements ChromeWebNavigationLike {
  frames: readonly PageNavigationFrame[] = [];
  readonly onCommitted = new FakeEvent<PageNavigationCommittedDetails>();
  readonly onHistoryStateUpdated = new FakeEvent<PageNavigationSameDocumentDetails>();
  readonly onReferenceFragmentUpdated = new FakeEvent<PageNavigationSameDocumentDetails>();
  async getAllFrames(): Promise<readonly PageNavigationFrame[]> { return structuredClone(this.frames); }
}

const WATCH_ID = createStableId('watchSession', () => '60000000-0000-4000-8000-000000000001');
const OBS_ID = createStableId('resourceObservation', () => '70000000-0000-4000-8000-000000000001');
const ACTIVE: WatchStatusActive = {
  watchSessionId: WATCH_ID,
  tabId: 7,
  startedAt: '2026-08-19T14:00:00.000Z',
};

function frame(overrides: Partial<PageNavigationFrame> = {}): PageNavigationFrame {
  return {
    tabId: 7,
    frameId: 0,
    parentFrameId: -1,
    url: 'https://example.test/page',
    documentId: 'top-a',
    documentLifecycle: 'active',
    frameType: 'outermost_frame',
    ...overrides,
  };
}

function request(overrides: Partial<WebRequestBaseDetails> = {}): WebRequestBaseDetails {
  return {
    requestId: 'request-1',
    url: 'https://cdn.example.test/a.js',
    method: 'GET',
    tabId: 7,
    type: 'script',
    timeStamp: Date.parse('2026-08-19T14:01:00.000Z'),
    frameId: 0,
    parentFrameId: -1,
    documentId: 'top-a',
    ...overrides,
  };
}

async function flush(): Promise<void> {
  await new Promise<void>((resolve) => setTimeout(resolve, 0));
}

function observationHarness(session: MemorySession, registry: PageContextRegistry) {
  session.values.set(WATCH_SESSION_STORAGE_KEY, {
    schemaVersion: 1,
    watchSessionId: WATCH_ID,
    tabId: 7,
    startedAt: ACTIVE.startedAt,
  });
  const raw = new MemoryStore();
  const observations = new JsonRecordRepository<ResourceObservationRecord>(
    PERSISTENCE_STORES.resourceObservations,
    raw,
    requireResourceObservationRecord,
  );
  const pending = new MemoryPending();
  const lifecycle = new ObservationLifecycle({
    observations,
    pending,
    sessionState: session,
    createObservationId: () => OBS_ID,
    attribute: (details) => registry.attribute(details),
  });
  return { observations, pending, lifecycle };
}

test('bootstrap establishes active top document and reliable descendant ancestry', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [
    frame(),
    frame({ frameId: 2, parentFrameId: 0, documentId: 'child-a', parentDocumentId: 'top-a', frameType: 'sub_frame' }),
    frame({ frameId: 3, parentFrameId: 2, documentId: 'grandchild-a', parentDocumentId: 'child-a', frameType: 'sub_frame' }),
  ]);

  const context = await registry.current();
  assert.equal(context?.topDocumentId, 'top-a');
  assert.equal(context?.pageRevision, 1);
  assert.equal(context?.origin, 'https://example.test');
  assert.deepEqual(await registry.attribute({ tabId: 7, frameId: 0, documentId: 'top-a' }), {
    status: 'exact_top_document', topDocumentId: 'top-a', pageRevision: 1,
  });
  assert.equal((await registry.attribute({ tabId: 7, frameId: 3, documentId: 'grandchild-a', parentDocumentId: 'child-a' })).status, 'exact_descendant');
});

test('History and fragment updates keep document identity while advancing pageRevision', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [frame()]);
  const oldAttribution = await registry.attribute({ tabId: 7, frameId: 0, documentId: 'top-a' });

  await registry.sameDocumentNavigation(ACTIVE, frame({ url: 'https://example.test/page?spa=1' }));
  assert.equal((await registry.current())?.pageRevision, 2);
  await registry.sameDocumentNavigation(ACTIVE, frame({ url: 'https://example.test/page?spa=1#section' }));
  const current = await registry.current();
  assert.equal(current?.pageRevision, 3);
  assert.equal(current?.url, 'https://example.test/page?spa=1#section');
  assert.equal((await registry.resolveObservation({
    attributionStatus: oldAttribution.status,
    topDocumentId: oldAttribution.topDocumentId,
    pageRevision: oldAttribution.pageRevision,
  })).status, 'revision_stale');
});

test('new active top-level commit is a hard document boundary and resets revision', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [frame()]);
  const old = await registry.attribute({ tabId: 7, frameId: 0, documentId: 'top-a' });
  await registry.committed(ACTIVE, frame({ documentId: 'top-b', url: 'https://example.test/next' }));

  assert.equal((await registry.current())?.topDocumentId, 'top-b');
  assert.equal((await registry.current())?.pageRevision, 1);
  assert.equal((await registry.attribute({ tabId: 7, frameId: 0, documentId: 'top-a' })).status, 'stale_or_ambiguous');
  assert.equal((await registry.resolveObservation({
    attributionStatus: old.status,
    topDocumentId: old.topDocumentId,
    pageRevision: old.pageRevision,
  })).status, 'document_stale');
});

test('direct parent document evidence can attribute a child even before its navigation event is seen', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [frame()]);

  const directChild = await registry.attribute({ tabId: 7, frameId: 8, documentId: 'child-late', parentDocumentId: 'top-a' });
  assert.equal(directChild.status, 'exact_descendant');
  const unknown = await registry.attribute({ tabId: 7, frameId: 9, documentId: 'nested-late', parentDocumentId: 'unknown-parent' });
  assert.deepEqual(unknown, { status: 'unattributed' });
});

test('prerender/non-active top-level events never replace the active PageContext', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [frame()]);
  await registry.committed(ACTIVE, frame({
    frameId: 9,
    documentId: 'top-prerender',
    url: 'https://example.test/future',
    documentLifecycle: 'prerender',
    frameType: 'outermost_frame',
  }));
  assert.equal((await registry.current())?.topDocumentId, 'top-a');
});

test('bootstrap without an accessible active top frame fails closed instead of inventing current-tab identity', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [frame({ documentLifecycle: 'cached' })]);
  assert.equal(await registry.current(), undefined);
  assert.deepEqual(await registry.attribute({ tabId: 7, frameId: 0, documentId: 'top-a' }), { status: 'unattributed' });
});

test('Chrome adapter registers only while Watch is active, filters by tab in-process, and clears on stop', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  const chrome = new FakeWebNavigation();
  chrome.frames = [frame()];
  const capture = new ChromePageContextCapture({ webNavigation: chrome, registry });

  await capture.sync(ACTIVE);
  assert.equal(chrome.onCommitted.listeners.size, 1);
  assert.equal((await registry.current())?.topDocumentId, 'top-a');
  chrome.onHistoryStateUpdated.emit(frame({ tabId: 99, url: 'https://wrong.test/' }));
  await flush();
  assert.equal((await registry.current())?.pageRevision, 1);

  await capture.sync(undefined);
  assert.equal(chrome.onCommitted.listeners.size, 0);
  assert.equal(await registry.current(), undefined);
});

test('context-change hook runs before navigation/stop replacement so page assistance can clear the old exact document', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  const chrome = new FakeWebNavigation();
  chrome.frames = [frame()];
  const seen: Array<string | undefined> = [];
  const capture = new ChromePageContextCapture({
    webNavigation: chrome,
    registry,
    onBeforeContextChange: async () => { seen.push((await registry.current())?.topDocumentId); },
  });
  await capture.sync(ACTIVE);
  seen.length = 0;
  chrome.onHistoryStateUpdated.emit(frame({ url: 'https://example.test/spa' }));
  await flush();
  assert.deepEqual(seen, ['top-a']);
  assert.equal((await registry.current())?.pageRevision, 2);
  seen.length = 0;
  await capture.sync(undefined);
  assert.deepEqual(seen, ['top-a']);
  assert.equal(await registry.current(), undefined);
});

test('service-worker replacement rehydrates frame ancestry without resetting same-document revision', async () => {
  const session = new MemorySession();
  const registry1 = new PageContextRegistry(session);
  const chrome1 = new FakeWebNavigation();
  chrome1.frames = [frame()];
  const capture1 = new ChromePageContextCapture({ webNavigation: chrome1, registry: registry1 });
  await capture1.sync(ACTIVE);
  chrome1.onHistoryStateUpdated.emit(frame({ url: 'https://example.test/spa' }));
  await flush();
  assert.equal((await registry1.current())?.pageRevision, 2);

  const registry2 = new PageContextRegistry(session);
  const chrome2 = new FakeWebNavigation();
  chrome2.frames = [frame({ url: 'https://example.test/spa' })];
  const capture2 = new ChromePageContextCapture({ webNavigation: chrome2, registry: registry2 });
  await capture2.sync(ACTIVE);
  assert.equal((await registry2.current())?.pageRevision, 2);
});

test('observation freezes first-event pageRevision and becomes stale after same-document navigation', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, [frame()]);
  const h = observationHarness(session, registry);

  await h.lifecycle.beforeRequest(request());
  await registry.sameDocumentNavigation(ACTIVE, frame({ url: 'https://example.test/spa' }));
  await h.lifecycle.completed({ ...request({ timeStamp: Date.parse('2026-08-19T14:01:00.100Z') }), statusCode: 200 });
  const [record] = await h.observations.list();
  assert.equal(record?.value.attributionStatus, 'exact_top_document');
  assert.equal(record?.value.topDocumentId, 'top-a');
  assert.equal(record?.value.pageRevision, 1);
  assert.equal((await registry.resolveObservation(record!.value)).status, 'revision_stale');
});

test('undefined webRequest/webNavigation ordering fails closed and never backfills attribution', async () => {
  const session = new MemorySession();
  const registry = new PageContextRegistry(session);
  await registry.bootstrap(ACTIVE, []);
  const h = observationHarness(session, registry);

  await h.lifecycle.beforeRequest(request());
  assert.equal([...h.pending.values.values()][0]?.attributionStatus, 'unattributed');
  await registry.committed(ACTIVE, frame());
  await h.lifecycle.completed({ ...request({ timeStamp: Date.parse('2026-08-19T14:01:00.100Z') }), statusCode: 200 });
  const [record] = await h.observations.list();
  assert.equal(record?.value.attributionStatus, 'unattributed');
  assert.equal(record?.value.topDocumentId, undefined);
});
