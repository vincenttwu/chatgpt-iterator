        self.assertIn("status: sealed", manifest)
        self.assertIn("synchronized: true", manifest)
        self.assertIn("limit: 20", manifest)
        self.assertIn("change.md", manifest)
        self.assertNotIn("a/iterations/", diff)
        self.assertIn("a/CHANGELOG.md", diff)
        self.assertIn("a/app.txt", diff)

        verified = self.run_manager(repo, "verify", "testing", "v0.1.0")
        self.assertEqual(verified.returncode, 0, verified.stdout + verified.stderr)
        self.assertIn("verification=passed", verified.stdout)
        validated = self.run_manager(repo, "validate")
        self.assertEqual(validated.returncode, 0, validated.stdout + validated.stderr)
        self.assertIn("iterations=1", validated.stdout)

