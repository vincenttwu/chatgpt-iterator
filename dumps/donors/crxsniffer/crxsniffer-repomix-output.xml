<file path="src/control-plane/validation.ts">
import {
  CONTRACT_ERROR_CODES,
  ContractError,
  assertJsonSafe,
  freezeJsonValue,
  requireJsonObject,
  requireRevision,
  requireStableId,
  type JsonObject,
} from '../core/index.ts';
import { requireIsoTimestamp } from '../persistence/index.ts';
import {
  requireResourceAdmissionFilter,
  requireResourceHistoryDetail,
  requireResourceHistoryPage,
  requireResourceHistorySessionList,
} from '../resources/index.ts';
import type { WatchReadiness, WatchStatus, WatchTerminationReason } from '../watch/index.ts';
import { requireSettingsClearSummary, requireSettingsSnapshot } from './settings.ts';
import {
  CONTROL_PLANE_SCHEMA_VERSION,
  type ControlPlaneInvalidationHint,
  type ControlPlaneInvalidationReason,
  type ControlPlaneRuntimeHealth,
  type ControlPlaneSnapshot,
  type ResourceDetailResult,
  type ResourcePageResult,
  type ResourceSessionsResult,
  type RuntimeHealthArea,
  type SelectedTabProjection,
  type SettingsResult,
} from './types.ts';

const INVALIDATION_REASONS = new Set<ControlPlaneInvalidationReason>([
  'connected',
  'watch_changed',
  'observation_persisted',
  'configuration_changed',
  'packagizer_changed',
  'settings_changed',
  'history_cleared',
  'runtime_degraded',
  'runtime_recovered',
]);

const RUNTIME_HEALTH_AREAS = new Set<RuntimeHealthArea>([
  'storage',
  'evaluation',
  'capture',
]);

function requireOnlyKeys(value: JsonObject, allowed: readonly string[], path: string): void {
  const allowedSet = new Set(allowed);
  for (const key of Object.keys(value)) {
    if (!allowedSet.has(key)) {
      throw new ContractError(
        CONTRACT_ERROR_CODES.invalidMessage,
        `unknown control-plane field at ${path}: ${key}`,
        { path, field: key },
      );
    }
  }
}

export function requireRequestSequence(value: unknown): number {
  if (!Number.isSafeInteger(value) || (value as number) < 1) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidArgument,
      'requestSequence must be a positive safe integer',
    );
  }
  return value as number;
}

export function requireOptionalTabId(value: unknown): number | undefined {
  if (value === undefined) return undefined;
  if (!Number.isSafeInteger(value) || (value as number) < 0) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.invalidArgument,
      'tabId must be a non-negative safe integer',
    );
  }
  return value as number;
}

const WATCH_READINESS = new Set<WatchReadiness>([
  'watching',
  'ready',
  'permission_required',
  'target_unavailable',
  'target_unsupported',
]);

const WATCH_TERMINATION_REASONS = new Set<WatchTerminationReason>([
  'user_stop',
  'target_closed',
  'permission_lost',
  'runtime_session_lost',
  'target_unsupported',
]);

function requireTabId(value: unknown, path: string): number {
  if (!Number.isSafeInteger(value) || (value as number) < 0) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, `${path} must be a non-negative safe integer`);
  }
  return value as number;
}

function requireWatchStatus(value: unknown): WatchStatus {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['state', 'readiness', 'hostCoverage', 'active', 'lastTermination'], '$.watch');
  if (record.state !== 'idle' && record.state !== 'watching') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control-plane Watch state is invalid');
  }
  if (typeof record.readiness !== 'string' || !WATCH_READINESS.has(record.readiness as WatchReadiness)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control-plane Watch readiness is invalid');
  }
  if (record.hostCoverage !== 'full' && record.hostCoverage !== 'required') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control-plane Watch host coverage is invalid');
  }

  let active: WatchStatus['active'];
  if (record.active !== undefined) {
    const candidate = requireJsonObject(record.active);
    requireOnlyKeys(candidate, ['watchSessionId', 'tabId', 'startedAt'], '$.watch.active');
    active = {
      watchSessionId: requireStableId(candidate.watchSessionId, 'watchSession'),
      tabId: requireTabId(candidate.tabId, 'watch.active.tabId'),
      startedAt: requireIsoTimestamp(candidate.startedAt, 'watch.active.startedAt'),
    };
  }
  if ((record.state === 'watching') !== (active !== undefined)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'watching state and active Watch identity must agree');
  }

  let lastTermination: WatchStatus['lastTermination'];
  if (record.lastTermination !== undefined) {
    const candidate = requireJsonObject(record.lastTermination);
    requireOnlyKeys(candidate, ['watchSessionId', 'tabId', 'endedAt', 'reason'], '$.watch.lastTermination');
    if (typeof candidate.reason !== 'string' || !WATCH_TERMINATION_REASONS.has(candidate.reason as WatchTerminationReason)) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'control-plane termination reason is invalid');
    }
    lastTermination = {
      watchSessionId: requireStableId(candidate.watchSessionId, 'watchSession'),
      tabId: requireTabId(candidate.tabId, 'watch.lastTermination.tabId'),
      endedAt: requireIsoTimestamp(candidate.endedAt, 'watch.lastTermination.endedAt'),
      reason: candidate.reason as WatchTerminationReason,
    };
  }

  return freezeJsonValue({
    state: record.state,
    readiness: record.readiness as WatchReadiness,
    hostCoverage: record.hostCoverage,
    ...(active === undefined ? {} : { active }),
    ...(lastTermination === undefined ? {} : { lastTermination }),
  });
}

function requireSelectedTab(value: unknown): SelectedTabProjection {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['id', 'url', 'title', 'incognito'], '$.selectedTab');
  const id = requireTabId(record.id, 'selectedTab.id');
  if (record.url !== undefined && typeof record.url !== 'string') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'selectedTab.url must be a string');
  }
  if (record.title !== undefined && typeof record.title !== 'string') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'selectedTab.title must be a string');
  }
  if (record.incognito !== undefined && typeof record.incognito !== 'boolean') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'selectedTab.incognito must be boolean');
  }
  return freezeJsonValue({
    id,
    ...(record.url === undefined ? {} : { url: record.url }),
    ...(record.title === undefined ? {} : { title: record.title }),
    ...(record.incognito === undefined ? {} : { incognito: record.incognito }),
  });
}

function requireRuntimeHealth(value: unknown): ControlPlaneRuntimeHealth {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['state', 'area', 'message', 'occurredAt'], '$.runtimeHealth');
  if (record.state === 'healthy') {
    if (record.area !== undefined || record.message !== undefined || record.occurredAt !== undefined) {
      throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'healthy runtimeHealth may not carry degraded details');
    }
    return freezeJsonValue({ state: 'healthy' });
  }
  if (record.state !== 'degraded') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'runtimeHealth.state is invalid');
  }
  if (typeof record.area !== 'string' || !RUNTIME_HEALTH_AREAS.has(record.area as RuntimeHealthArea)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'runtimeHealth.area is invalid');
  }
  if (typeof record.message !== 'string' || record.message.trim() === '') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'runtimeHealth.message is invalid');
  }
  return freezeJsonValue({
    state: 'degraded',
    area: record.area as RuntimeHealthArea,
    message: record.message,
    occurredAt: requireIsoTimestamp(record.occurredAt, 'runtimeHealth.occurredAt'),
  });
}

function requireActiveWatch(value: unknown): NonNullable<ControlPlaneSnapshot['activeWatch']> {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(
    record,
    ['watchSessionId', 'watchDefinitionId', 'watchRevision', 'setupName', 'filter'],
    '$.activeWatch',
  );
  if (typeof record.setupName !== 'string' || record.setupName.trim() === '') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'activeWatch.setupName is invalid');
  }
  return freezeJsonValue({
    watchSessionId: requireStableId(record.watchSessionId, 'watchSession'),
    watchDefinitionId: requireStableId(record.watchDefinitionId, 'definition'),
    watchRevision: requireRevision(record.watchRevision),
    setupName: record.setupName,
    filter: requireResourceAdmissionFilter(record.filter),
  });
}

export function requireControlPlaneSnapshot(value: unknown): ControlPlaneSnapshot {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(
    record,
    ['schemaVersion', 'requestSequence', 'generatedAt', 'selectedTabId', 'selectedTab', 'watch', 'activeWatch', 'activeTab', 'runtimeHealth'],
    '$',
  );
  if (record.schemaVersion !== CONTROL_PLANE_SCHEMA_VERSION) {
    throw new ContractError(
      CONTRACT_ERROR_CODES.unsupportedSchemaVersion,
      `Unsupported control-plane schemaVersion ${String(record.schemaVersion)}`,
      { supported: CONTROL_PLANE_SCHEMA_VERSION },
    );
  }
  const requestSequence = requireRequestSequence(record.requestSequence);
  const generatedAt = requireIsoTimestamp(record.generatedAt, 'generatedAt');
  const selectedTabId = requireOptionalTabId(record.selectedTabId);
  const selectedTab = record.selectedTab === undefined ? undefined : requireSelectedTab(record.selectedTab);
  if (selectedTab !== undefined && selectedTabId !== undefined && selectedTab.id !== selectedTabId) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'selectedTab and selectedTabId must agree');
  }
  const watch = requireWatchStatus(record.watch);
  const activeWatch = record.activeWatch === undefined ? undefined : requireActiveWatch(record.activeWatch);
  if (watch.active !== undefined && activeWatch !== undefined && watch.active.watchSessionId !== activeWatch.watchSessionId) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'active Watch session identity mismatch');
  }
  const activeTab = record.activeTab === undefined ? undefined : requireSelectedTab(record.activeTab);
  if (watch.active !== undefined && activeTab !== undefined && watch.active.tabId !== activeTab.id) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'active Watch tab projection mismatch');
  }
  const runtimeHealth = requireRuntimeHealth(record.runtimeHealth);
  return freezeJsonValue({
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    requestSequence,
    generatedAt,
    ...(selectedTabId === undefined ? {} : { selectedTabId }),
    ...(selectedTab === undefined ? {} : { selectedTab }),
    watch,
    ...(activeWatch === undefined ? {} : { activeWatch }),
    ...(activeTab === undefined ? {} : { activeTab }),
    runtimeHealth,
  }) as ControlPlaneSnapshot;
}

export function requireControlPlaneInvalidationHint(value: unknown): ControlPlaneInvalidationHint {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, ['kind', 'schemaVersion', 'sequence', 'reason'], '$');
  if (record.kind !== 'invalidate' || record.schemaVersion !== CONTROL_PLANE_SCHEMA_VERSION) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'invalid control-plane invalidation hint');
  }
  const sequence = requireRequestSequence(record.sequence);
  if (typeof record.reason !== 'string' || !INVALIDATION_REASONS.has(record.reason as ControlPlaneInvalidationReason)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'unknown control-plane invalidation reason');
  }
  return freezeJsonValue({
    kind: 'invalidate',
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    sequence,
    reason: record.reason as ControlPlaneInvalidationReason,
  });
}


function requireResourceResultBase(value: unknown, allowed: readonly string[]): { readonly record: JsonObject; readonly requestSequence: number } {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  requireOnlyKeys(record, allowed, '$');
  if (record.schemaVersion !== CONTROL_PLANE_SCHEMA_VERSION) {
    throw new ContractError(CONTRACT_ERROR_CODES.unsupportedSchemaVersion, 'resource control-plane schemaVersion is invalid');
  }
  return { record, requestSequence: requireRequestSequence(record.requestSequence) };
}

export function requireResourceSessionsResult(value: unknown): ResourceSessionsResult {
  const { record, requestSequence } = requireResourceResultBase(value, ['schemaVersion', 'requestSequence', 'sessions']);
  return freezeJsonValue({
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    requestSequence,
    sessions: requireResourceHistorySessionList(record.sessions),
  }) as ResourceSessionsResult;
}

export function requireResourcePageResult(value: unknown): ResourcePageResult {
  const { record, requestSequence } = requireResourceResultBase(value, ['schemaVersion', 'requestSequence', 'page']);
  return freezeJsonValue({
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    requestSequence,
    page: requireResourceHistoryPage(record.page),
  }) as ResourcePageResult;
}

export function requireResourceDetailResult(value: unknown): ResourceDetailResult {
  const { record, requestSequence } = requireResourceResultBase(value, ['schemaVersion', 'requestSequence', 'found', 'detail']);
  if (typeof record.found !== 'boolean') {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'resource detail found must be boolean');
  }
  const detail = record.detail === undefined ? undefined : requireResourceHistoryDetail(record.detail);
  if (record.found !== (detail !== undefined)) {
    throw new ContractError(CONTRACT_ERROR_CODES.invalidMessage, 'resource detail found flag and detail must agree');
  }
  return freezeJsonValue({
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    requestSequence,
    found: record.found,
    ...(detail === undefined ? {} : { detail }),
  }) as ResourceDetailResult;
}


export function requireSettingsResult(value: unknown): SettingsResult {
  const { record, requestSequence } = requireResourceResultBase(value, ['schemaVersion', 'requestSequence', 'settings', 'clear']);
  const settings = requireSettingsSnapshot(record.settings);
  const clear = record.clear === undefined ? undefined : requireSettingsClearSummary(record.clear);
  return freezeJsonValue({
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    requestSequence,
    settings,
    ...(clear === undefined ? {} : { clear }),
  }) as SettingsResult;
}
