import type { ControlPlaneInvalidationReason } from './types.ts';

export const CONTROL_PLANE_INVALIDATION_BATCH_DELAY_MS = 50 as const;

export type InvalidationBatchScheduler = (callback: () => void) => void;
export type InvalidationBatchFlush = (reasons: readonly ControlPlaneInvalidationReason[]) => void;

const defaultScheduler: InvalidationBatchScheduler = (callback) => {
  globalThis.setTimeout(callback, CONTROL_PLANE_INVALIDATION_BATCH_DELAY_MS);
};

/**
 * Presentation-only invalidation coalescer.
 *
 * Ports remain latency hints, never correctness authority. A burst of hints is
 * collapsed into one bounded refresh wave; authoritative one-shot queries still
 * decide the resulting Side Panel state.
 */
export class ControlPlaneInvalidationBatcher {
  readonly #flush: InvalidationBatchFlush;
  readonly #schedule: InvalidationBatchScheduler;
  readonly #pending = new Set<ControlPlaneInvalidationReason>();
  #scheduled = false;
  #stopped = false;
  #generation = 0;

  constructor(flush: InvalidationBatchFlush, schedule: InvalidationBatchScheduler = defaultScheduler) {
    this.#flush = flush;
    this.#schedule = schedule;
  }

  enqueue(reason: ControlPlaneInvalidationReason): void {
    if (this.#stopped) return;
    this.#pending.add(reason);
    if (this.#scheduled) return;
    this.#scheduled = true;
    const generation = this.#generation;
    this.#schedule(() => {
      if (this.#stopped || generation !== this.#generation) return;
      this.#scheduled = false;
      if (this.#pending.size === 0) return;
      const reasons = Object.freeze([...this.#pending]);
      this.#pending.clear();
      this.#flush(reasons);
    });
  }

  stop(): void {
    if (this.#stopped) return;
    this.#stopped = true;
    this.#generation += 1;
    this.#scheduled = false;
    this.#pending.clear();
  }
}
