function globToRegex(glob: string): RegExp {
  const trimmed = glob.trim();
  if (!trimmed) return /.*/;
  const escaped = trimmed
    .replace(/[.+^${}()|[\]\\]/g, '\\$&')
    .replace(/\*\*/g, '.*')
    .replace(/\*/g, '[^/]*')
    .replace(/\?/g, '.');
  return new RegExp(`^${escaped}$`, 'i');
}

function matchesGlobPattern(url: string, filename: string | null | undefined, glob: string): boolean {
  if (!glob.trim()) return true;
  const regex = globToRegex(glob);
  return regex.test(url) || (filename ? regex.test(filename) : false);
}

const filteredExportRows = computed(() => {
  let rows = resourceRows.value;
  if (exportKindFilter.value !== 'all') {
