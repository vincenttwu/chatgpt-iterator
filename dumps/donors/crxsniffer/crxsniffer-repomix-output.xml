import {
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  requireJsonObject,
  type JsonObject,
} from '../core/index.ts';
import type { ImmutableWatchSessionRecord } from '../definitions/index.ts';
import { RESOURCE_ERROR_CODES, ResourceError } from './errors.ts';
import { compileSmartPattern } from './glob.ts';
import type {
  ResourceAdmissionDecision,
  ResourceAdmissionFilter,
  ResourceClassification,
} from './types.ts';

const FILTER_KEYS = new Set(['schemaVersion', 'images', 'videos', 'includeGlobs', 'excludeGlobs']);

export const DEFAULT_RESOURCE_ADMISSION_FILTER: ResourceAdmissionFilter = freezeJsonValue({
  schemaVersion: 1,
  images: true,
  videos: true,
  includeGlobs: [],
  excludeGlobs: [],
}) as ResourceAdmissionFilter;

function requireBoolean(value: unknown, label: string): boolean {
  if (typeof value !== 'boolean') {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidFilter, `${label} must be boolean`);
  }
  return value;
}

function requireGlobArray(value: unknown, label: string): readonly string[] {
  if (!Array.isArray(value)) {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidFilter, `${label} must be an array`);
  }
  const patterns = value.map((entry) => {
    if (typeof entry !== 'string') {
      throw new ResourceError(RESOURCE_ERROR_CODES.invalidFilter, `${label} entries must be strings`);
    }
    compileSmartPattern(entry);
    return entry;
  });
  return Object.freeze(patterns);
}

export function requireResourceAdmissionFilter(value: unknown): ResourceAdmissionFilter {
  assertJsonSafe(value);
  const body = requireJsonObject(value);
  for (const key of Object.keys(body)) {
    if (!FILTER_KEYS.has(key)) {
      throw new ResourceError(RESOURCE_ERROR_CODES.invalidFilter, `unsupported resource filter field ${key}`);
    }
  }
  if (body.schemaVersion !== 1) {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidFilter, 'resource filter schemaVersion must be 1');
  }
  const normalized: ResourceAdmissionFilter = {
    schemaVersion: 1,
    images: requireBoolean(body.images, 'images'),
    videos: requireBoolean(body.videos, 'videos'),
    includeGlobs: requireGlobArray(body.includeGlobs, 'includeGlobs'),
    excludeGlobs: requireGlobArray(body.excludeGlobs, 'excludeGlobs'),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

/** Resolve the single enabled frozen filter. Historical/no-filter sessions use the immutable v1 default. */
export function resolveWatchSessionResourceFilter(
  session: ImmutableWatchSessionRecord,
): ResourceAdmissionFilter {
  const filters = session.value.definitions.filter(
    (definition) => definition.kind === 'resourceFilter' && definition.value.enabled,
  );
  if (filters.length === 0) return DEFAULT_RESOURCE_ADMISSION_FILTER;
  if (filters.length > 1) {
    throw new ResourceError(RESOURCE_ERROR_CODES.invalidFilter, 'a WatchSession may have at most one enabled resourceFilter');
  }
  return requireResourceAdmissionFilter(filters[0]!.value.body);
}

/** Called by Watch start so invalid globs never become active Watch authority. */
export function validateWatchSessionResourceFilter(session: ImmutableWatchSessionRecord): void {
  resolveWatchSessionResourceFilter(session);
}

export function evaluateResourceAdmission(
  classification: ResourceClassification,
  canonicalUrl: string,
  filter: ResourceAdmissionFilter,
): ResourceAdmissionDecision {
  const matchedPresets: ('images' | 'videos')[] = [];
  if (filter.images && classification.kind === 'image') matchedPresets.push('images');
  if (filter.videos && (classification.kind === 'video' || classification.kind === 'stream_manifest')) {
    matchedPresets.push('videos');
  }
  const matchedIncludeGlobs = filter.includeGlobs.filter((pattern) => compileSmartPattern(pattern).test(canonicalUrl));
  const matchedExcludeGlobs = filter.excludeGlobs.filter((pattern) => compileSmartPattern(pattern).test(canonicalUrl));
  const positive = matchedPresets.length > 0 || matchedIncludeGlobs.length > 0;
  return freezeJsonValue({
    admitted: positive && matchedExcludeGlobs.length === 0,
    positive,
    matchedPresets,
    matchedIncludeGlobs,
    matchedExcludeGlobs,
  }) as ResourceAdmissionDecision;
}

export function resourceFilterBody(filter: ResourceAdmissionFilter): JsonObject {
  return freezeJsonValue(cloneJsonValue(filter)) as JsonObject;
}
