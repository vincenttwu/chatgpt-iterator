<file path="tests/persistence/persistence.test.ts">
import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import test from 'node:test';

import {
  createStableId,
  INITIAL_REVISION,
  type JsonObject,
} from '../../src/core/index.ts';
import {
  CRSNIFFER_DATABASE_NAME,
  CRSNIFFER_DATABASE_VERSION,
  LOGICAL_DATABASE_VERSION,
  META_KEYS,
  PERSISTED_RECORD_SCHEMA_VERSION,
  PERSISTENCE_ERROR_CODES,
  PERSISTENCE_SCHEMA_V1,
  PERSISTENCE_STORES,
  JsonRecordRepository,
  PersistenceError,
  applyPhysicalUpgrade,
  createCrSnifferLogicalMigrationSteps,
  createChromeStorageTiers,
  openCrSnifferDatabase,
  readLogicalMigrationState,
  requireRetentionMaintenanceState,
  requireDefinitionRecord,
  requireMetaRecord,
  runLogicalMigrations,
  StorageQuotaMonitor,
  type ChromeStorageAreaLike,
  type LogicalMigrationStep,
  type MetaRecord,
  type RepositoryStorePort,
  type SchemaDatabaseLike,
  type SchemaObjectStoreLike,
  type UpgradeTransactionLike,
} from '../../src/persistence/index.ts';

const IDS = {
  definition: createStableId('definition', () => '11111111-1111-4111-8111-111111111111'),
  watchSession: createStableId('watchSession', () => '22222222-2222-4222-8222-222222222222'),
};

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();

  async get(key: string): Promise<unknown> {
    return this.values.get(key);
  }

  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') {
      throw new Error('memory store requires id or key');
    }
    this.values.set(key, structuredClone(value));
  }

  async delete(key: string): Promise<void> {
    this.values.delete(key);
  }

  async count(): Promise<number> {
    return this.values.size;
  }

  async clear(): Promise<void> {
    this.values.clear();
  }

  async getAll(): Promise<readonly unknown[]> {
    return [...this.values.values()].map((value) => structuredClone(value));
  }
}

class FakeSchemaStore implements SchemaObjectStoreLike {
  readonly indexes: Array<{ name: string; keyPath: string | string[]; unique: boolean }> = [];

  createIndex(
    name: string,
    keyPath: string | string[],
    options?: IDBIndexParameters,
  ): unknown {
    this.indexes.push({ name, keyPath, unique: options?.unique ?? false });
    return {};
  }
}

class FakeSchemaDatabase implements SchemaDatabaseLike {
  readonly stores = new Map<string, { keyPath: string; store: FakeSchemaStore }>();
  readonly objectStoreNames = {
    contains: (name: string) => this.stores.has(name),
  };

  createObjectStore(name: string, options?: IDBObjectStoreParameters): FakeSchemaStore {
    const store = new FakeSchemaStore();
    const keyPath = options?.keyPath;
    if (typeof keyPath !== 'string') {
      throw new Error('test schema expects string keyPath');
    }
    this.stores.set(name, { keyPath, store });
    return store;
  }
}

class FakeUpgradeTransaction implements UpgradeTransactionLike {
  readonly puts: unknown[] = [];

  objectStore(name: string) {
    assert.equal(name, PERSISTENCE_STORES.meta);
    return {
      put: (value: unknown) => {
        this.puts.push(structuredClone(value));
        return {};
      },
    };
  }
}

class MemoryChromeStorageArea implements ChromeStorageAreaLike {
  readonly values = new Map<string, unknown>();

  async get(keys?: null | string | readonly string[] | Record<string, unknown>): Promise<Record<string, unknown>> {
    if (keys === null || keys === undefined) {
      return Object.fromEntries(this.values);
    }
    const names = typeof keys === 'string'
      ? [keys]
      : Array.isArray(keys)
        ? [...keys]
        : Object.keys(keys);
    return Object.fromEntries(names.flatMap((key) => this.values.has(key) ? [[key, this.values.get(key)]] : []));
  }

  async set(items: Record<string, unknown>): Promise<void> {
    for (const [key, value] of Object.entries(items)) {
      this.values.set(key, structuredClone(value));
    }
  }

  async remove(keys: string | readonly string[]): Promise<void> {
    for (const key of typeof keys === 'string' ? [keys] : keys) {
      this.values.delete(key);
    }
  }
}

test('IndexedDB v1 creates only the five accepted authority stores and bounded indexes', () => {
  const database = new FakeSchemaDatabase();
  const transaction = new FakeUpgradeTransaction();

  applyPhysicalUpgrade(database, transaction, 0, CRSNIFFER_DATABASE_VERSION);

  assert.equal(CRSNIFFER_DATABASE_NAME, 'crsniffer');
  assert.equal(CRSNIFFER_DATABASE_VERSION, 1);
  assert.deepEqual([...database.stores.keys()], PERSISTENCE_SCHEMA_V1.map((store) => store.name));
  assert.equal(database.stores.get(PERSISTENCE_STORES.meta)?.keyPath, 'key');
  assert.equal(database.stores.get(PERSISTENCE_STORES.definitions)?.keyPath, 'id');
  assert.deepEqual(
    database.stores.get(PERSISTENCE_STORES.resourceObservations)?.store.indexes.map((index) => index.name),
    ['byWatchSessionObservedAt', 'byObservedAt'],
  );
  assert.deepEqual(
    database.stores.get(PERSISTENCE_STORES.pageFieldSnapshots)?.store.indexes.map((index) => index.name),
    ['byWatchSessionCapturedAt', 'byDocumentCapturedAt'],
  );

  const seeded = transaction.puts as MetaRecord[];
  assert.deepEqual(seeded.map((row) => row.key), [META_KEYS.physicalSchema, META_KEYS.logicalMigration, META_KEYS.retentionState]);
  assert.deepEqual(seeded[0]?.value, { databaseName: 'crsniffer', databaseVersion: 1 });
  assert.deepEqual(seeded[1]?.value, {
    currentVersion: LOGICAL_DATABASE_VERSION,
    targetVersion: LOGICAL_DATABASE_VERSION,
    status: 'idle',
  });
  assert.deepEqual(requireRetentionMaintenanceState(seeded[2]?.value), {
    schemaVersion: 1,
    lastReason: 'initial',
    deletedSessions: 0,
    deletedResourceObservations: 0,
    deletedPageFieldSnapshots: 0,
    deletedLifecycleRecords: 0,
  });
});

test('physical migration authority rejects unknown topology versions instead of guessing', () => {
  const database = new FakeSchemaDatabase();
  const transaction = new FakeUpgradeTransaction();
  assert.throws(
    () => applyPhysicalUpgrade(database, transaction, 2, 3),
    (error) => error instanceof PersistenceError
      && error.code === PERSISTENCE_ERROR_CODES.unsupportedPhysicalVersion,
  );
});

test('repositories validate writes and persisted reads while returning detached frozen records', async () => {
  const memory = new MemoryStore();
  const repository = new JsonRecordRepository(
    PERSISTENCE_STORES.definitions,
    memory,
    requireDefinitionRecord,
  );
  const record = {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: IDS.definition,
    revision: INITIAL_REVISION,
    definitionKind: 'watchProfile',
    createdAt: '2026-08-19T12:00:00.000Z',
    updatedAt: '2026-08-19T12:00:00.000Z',
    value: { enabled: true },
  } as const;

  await repository.put(record);
  const loaded = await repository.get(IDS.definition);
  assert.deepEqual(loaded, record);
  assert.equal(Object.isFrozen(loaded), true);
  assert.equal(Object.isFrozen(loaded?.value), true);

  memory.values.set(IDS.definition, {
    ...record,
    revision: 0,
  });
  await assert.rejects(() => repository.get(IDS.definition));

  await assert.rejects(() => repository.put({
    ...record,
    createdAt: '2026-99-99T12:00:00.000Z' as never,
  }));
});

test('repository count and clear support bounded Settings diagnostics and explicit Clear operations', async () => {
  const memory = new MemoryStore();
  const repository = new JsonRecordRepository(PERSISTENCE_STORES.definitions, memory, requireDefinitionRecord);
  await repository.put({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: IDS.definition,
    revision: INITIAL_REVISION,
    definitionKind: 'watchProfile',
    createdAt: '2026-08-19T12:00:00.000Z',
    updatedAt: '2026-08-19T12:00:00.000Z',
    value: { enabled: true },
  });
  assert.equal(await repository.count(), 1);
  await repository.clear();
  assert.equal(await repository.count(), 0);
  assert.deepEqual(await repository.list(), []);
});

test('storage.session and storage.local use separate namespaces and strict JSON boundaries', async () => {
  const sessionArea = new MemoryChromeStorageArea();
  const localArea = new MemoryChromeStorageArea();
  const tiers = createChromeStorageTiers({ session: sessionArea, local: localArea });

  await tiers.session.set('activeWatch', { watchSessionId: IDS.watchSession });
  await tiers.local.set('preferences', { compactRows: true });

  assert.deepEqual(await tiers.session.get('activeWatch'), { watchSessionId: IDS.watchSession });
  assert.deepEqual(await tiers.local.get('preferences'), { compactRows: true });
  assert.equal(sessionArea.values.has('crsniffer.session.activeWatch'), true);
  assert.equal(localArea.values.has('crsniffer.local.preferences'), true);

  sessionArea.values.set('foreign.key', { keep: true });
  await tiers.session.clearNamespace();
  assert.equal(sessionArea.values.has('crsniffer.session.activeWatch'), false);
  assert.equal(sessionArea.values.has('foreign.key'), true);

  await assert.rejects(() => tiers.local.set('bad', { value: Number.NaN } as never));
});

test('logical migrations checkpoint failure and resume from the last completed version', async () => {
  const memory = new MemoryStore();
  const meta = new JsonRecordRepository(PERSISTENCE_STORES.meta, memory, requireMetaRecord);
  await meta.put({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.logicalMigration,
    value: { currentVersion: 1, targetVersion: 1, status: 'idle' },
  });

  let failFirstStep = true;
  const calls: string[] = [];
  const steps: LogicalMigrationStep[] = [
    {
      id: 'v1-to-v2',
      fromVersion: 1,
      toVersion: 2,
      run: async () => {
        calls.push('1-2');
        if (failFirstStep) {
          failFirstStep = false;
          throw new Error('interrupted');
        }
      },
    },
    {
      id: 'v2-to-v3',
      fromVersion: 2,
      toVersion: 3,
      run: async () => {
        calls.push('2-3');
      },
    },
  ];

  await assert.rejects(
    () => runLogicalMigrations(meta, steps, 3),
    (error) => error instanceof PersistenceError
      && error.code === PERSISTENCE_ERROR_CODES.logicalMigrationFailed,
  );
  assert.deepEqual(await readLogicalMigrationState(meta), {
    currentVersion: 1,
    targetVersion: 3,
    status: 'failed',
    activeStepId: 'v1-to-v2',
    error: { code: 'logical_migration_failed', message: 'interrupted' },
  });

  const completed = await runLogicalMigrations(meta, steps, 3);
  assert.deepEqual(completed, {
    currentVersion: 3,
    targetVersion: 3,
    status: 'idle',
    lastCompletedStepId: 'v2-to-v3',
  });
  assert.deepEqual(calls, ['1-2', '1-2', '2-3']);
});

test('canonical logical v1 to v2 migration seeds retention recovery authority and is resumable', async () => {
  const memory = new MemoryStore();
  const meta = new JsonRecordRepository(PERSISTENCE_STORES.meta, memory, requireMetaRecord);
  await meta.put({
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    key: META_KEYS.logicalMigration,
    value: { currentVersion: 1, targetVersion: 1, status: 'idle' },
  });

  const completed = await runLogicalMigrations(meta, createCrSnifferLogicalMigrationSteps(meta));
  assert.deepEqual(completed, {
    currentVersion: 2,
    targetVersion: 2,
    status: 'idle',
    lastCompletedStepId: 'logical-v1-to-v2-retention-recovery-authority',
  });
  const retention = await meta.get(META_KEYS.retentionState);
  assert.deepEqual(requireRetentionMaintenanceState(retention?.value), {
    schemaVersion: 1,
    lastReason: 'initial',
    deletedSessions: 0,
    deletedResourceObservations: 0,
    deletedPageFieldSnapshots: 0,
    deletedLifecycleRecords: 0,
  });

  assert.deepEqual(await runLogicalMigrations(meta, createCrSnifferLogicalMigrationSteps(meta)), completed);
});

test('storage quota monitor treats estimates as approximate advisory pressure only', async () => {
  const normal = await new StorageQuotaMonitor({
    estimate: async () => ({ usage: 79, quota: 100 }),
    persisted: async () => true,
  }).snapshot();
  assert.deepEqual(normal, { level: 'normal', approximate: true, usageBytes: 79, quotaBytes: 100, usageRatio: 0.79, persistent: true });

  const warning = await new StorageQuotaMonitor({ estimate: async () => ({ usage: 80, quota: 100 }) }).snapshot();
  assert.equal(warning.level, 'warning');
  assert.equal(warning.approximate, true);
  const critical = await new StorageQuotaMonitor({ estimate: async () => ({ usage: 95, quota: 100 }) }).snapshot();
  assert.equal(critical.level, 'critical');

  const unavailable = await new StorageQuotaMonitor({ estimate: async () => { throw new Error('estimate unavailable'); } }).snapshot();
  assert.deepEqual(unavailable, { level: 'unknown', approximate: true });
});

test('runtime open fails clearly when IndexedDB is unavailable instead of using volatile fallback state', async () => {
  await assert.rejects(
    () => openCrSnifferDatabase({ factory: undefined }),
    (error) => error instanceof PersistenceError
      && error.code === PERSISTENCE_ERROR_CODES.unavailable,
  );
});


test('STEP-03 history reader pages through existing v1 indexes without getAll history hydration', async () => {
  const source = await readFile(new URL('../../src/persistence/history-reader.ts', import.meta.url), 'utf8');
  assert.match(source, /index\('byCreatedAt'\)/);
  assert.match(source, /index\('byWatchSessionObservedAt'\)/);
  assert.match(source, /openCursor/);
  assert.match(source, /continuePrimaryKey/);
  assert.doesNotMatch(source, /\.getAll\(/);
  assert.equal(CRSNIFFER_DATABASE_VERSION, 1);
  assert.equal(PERSISTENCE_SCHEMA_V1.length, 5);
  assert.equal(PERSISTENCE_SCHEMA_V1.some((store) => store.name === 'resourceHistory'), false);
});
