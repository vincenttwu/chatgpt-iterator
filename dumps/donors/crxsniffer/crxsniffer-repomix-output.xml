import {
  assertJsonSafe,
  cloneJsonValue,
  type JsonValue,
} from '../core/index.ts';
import type { ChromeStorageAreaLike } from '../persistence/index.ts';
import { OBSERVATION_PENDING_PREFIX, type PendingObservationTrace } from './types.ts';
import { requirePendingObservationTrace } from './validation.ts';

export interface PendingObservationStore {
  get(key: string): Promise<PendingObservationTrace | undefined>;
  put(key: string, value: PendingObservationTrace): Promise<void>;
  delete(key: string): Promise<void>;
  list(): Promise<readonly PendingObservationTrace[]>;
  clear(): Promise<void>;
}

function storageKey(key: string): string {
  return `${OBSERVATION_PENDING_PREFIX}${encodeURIComponent(key)}`;
}

export class ChromePendingObservationStore implements PendingObservationStore {
  readonly #area: ChromeStorageAreaLike;

  constructor(area: ChromeStorageAreaLike) {
    this.#area = area;
  }

  async get(key: string): Promise<PendingObservationTrace | undefined> {
    const fullKey = storageKey(key);
    const result = await this.#area.get(fullKey);
    const value = result[fullKey];
    return value === undefined ? undefined : requirePendingObservationTrace(value);
  }

  async put(key: string, value: PendingObservationTrace): Promise<void> {
    const validated = requirePendingObservationTrace(value);
    assertJsonSafe(validated);
    await this.#area.set({ [storageKey(key)]: cloneJsonValue(validated as JsonValue) });
  }

  async delete(key: string): Promise<void> {
    await this.#area.remove(storageKey(key));
  }

  async list(): Promise<readonly PendingObservationTrace[]> {
    const all = await this.#area.get(null);
    return Object.freeze(Object.entries(all)
      .filter(([key]) => key.startsWith(OBSERVATION_PENDING_PREFIX))
      .map(([, value]) => requirePendingObservationTrace(value)));
  }

  async clear(): Promise<void> {
    const all = await this.#area.get(null);
    const keys = Object.keys(all).filter((key) => key.startsWith(OBSERVATION_PENDING_PREFIX));
    if (keys.length > 0) await this.#area.remove(keys);
  }
}
</file>

