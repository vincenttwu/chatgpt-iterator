});

test('Settings retention and quota ports expose bounded maintenance without widening deletion authority', async () => {
  const h = await harness();
  const calls: Array<{ reason: string; maxAgeDays: number; maxTerminalSessions: number }> = [];
  let state = { schemaVersion: 1 as const, lastReason: 'initial' as const, deletedSessions: 0, deletedResourceObservations: 0, deletedPageFieldSnapshots: 0, deletedLifecycleRecords: 0 };
  const service = new SettingsService({
    repositories: h.repositories,
    preferences: h.preferences,
    sessionState: h.sessionState,
    pendingObservations: { clear: async () => undefined },
    lifecycle: new WatchLifecycleRepository(h.repositories.meta),
    watch: { status: async () => ({ state: 'idle', readiness: 'ready', hostCoverage: 'full' }) },
    catalog: new DefinitionCatalog(h.repositories.definitions),
    retention: {
      state: async () => state,
      enforce: async (policy, reason) => {
        calls.push({ reason, ...policy });
        state = { ...state, lastReason: reason, lastRunAt: '2026-08-20T06:30:00.000Z' as never };
        return state;
      },
    },
    quota: { snapshot: async () => ({ level: 'critical', approximate: true, usageBytes: 95, quotaBytes: 100, usageRatio: 0.95 }) },
  });

  const saved = await service.savePreferences({ ...DEFAULT_SETTINGS_PREFERENCES, historyRetentionDays: 90, historyRetentionSessions: 100 });
  assert.deepEqual(calls[0], { reason: 'policy_changed', maxAgeDays: 90, maxTerminalSessions: 100 });
  assert.equal(saved.diagnostics.storage.level, 'critical');
  assert.equal(saved.retention.pressureBehavior, 'configured_terminal_history_only');

  await service.maintain();
  assert.deepEqual(calls[1], { reason: 'manual', maxAgeDays: 90, maxTerminalSessions: 100 });
});

test('Clear history removes only history/session coordination and preserves definitions/preferences', async () => {
  const h = await harness();
