from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import sys
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True

from _manager_common import utc_now, workspace_root

ROOT = workspace_root(__file__)
JSON_MANIFEST = ROOT / "iteration_manifest.json"
YAML_MANIFEST = ROOT / "iteration_manifest.yaml"
README = ROOT / "README.md"
CHANGELOG = ROOT / "CHANGELOG.md"
ITERATIONS = ROOT / "iterations"
VERSION_RE = re.compile(r"v\d+\.\d+\.\d+")
PROJECT_RE = re.compile(r"[a-z0-9][a-z0-9._-]*")
IDENTITY_START = "<!-- initialization:identity:start -->"
IDENTITY_END = "<!-- initialization:identity:end -->"
EXCLUDED_PARTS = {
    ".git", ".hg", ".svn", "__pycache__", ".pytest_cache", ".mypy_cache",
    ".ruff_cache", ".tox", ".nox", ".venv", "venv", "node_modules", "dist", "build",
}


class InitializationError(RuntimeError):
    pass


def _load_manifest() -> dict[str, Any]:
    try:
        data = json.loads(JSON_MANIFEST.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise InitializationError(f"cannot read {JSON_MANIFEST.name}: {exc}") from exc
    if not isinstance(data, dict):
        raise InitializationError("root manifest must be a mapping")
    return data


def _yaml_scalar(value: Any) -> str:
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, (int, float)):
        return str(value)
    return json.dumps(str(value), ensure_ascii=False)


def _emit_yaml(value: Any, indent: int = 0) -> list[str]:
    prefix = " " * indent
    if isinstance(value, dict):
        lines: list[str] = []
        for key, child in value.items():
            if isinstance(child, dict):
                if child:
                    lines.append(f"{prefix}{key}:")
                    lines.extend(_emit_yaml(child, indent + 2))
                else:
                    lines.append(f"{prefix}{key}: {{}}")
            elif isinstance(child, list):
                if child:
                    lines.append(f"{prefix}{key}:")
                    lines.extend(_emit_yaml(child, indent + 2))
                else:
                    lines.append(f"{prefix}{key}: []")
            else:
                lines.append(f"{prefix}{key}: {_yaml_scalar(child)}")
        return lines
    if isinstance(value, list):
        lines = []
        for child in value:
            if isinstance(child, dict):
                items = list(child.items())
                if not items:
                    lines.append(f"{prefix}- {{}}")
                    continue
                first_key, first_value = items[0]
                if isinstance(first_value, (dict, list)):
                    lines.append(f"{prefix}- {first_key}:")
                    lines.extend(_emit_yaml(first_value, indent + 4))
                else:
                    lines.append(f"{prefix}- {first_key}: {_yaml_scalar(first_value)}")
                for key, item in items[1:]:
                    if isinstance(item, (dict, list)):
                        lines.append(f"{prefix}  {key}:")
                        lines.extend(_emit_yaml(item, indent + 4))
                    else:
                        lines.append(f"{prefix}  {key}: {_yaml_scalar(item)}")
            else:
                lines.append(f"{prefix}- {_yaml_scalar(child)}")
        return lines
    raise TypeError(f"unsupported YAML value: {type(value)!r}")


def _write_manifests(data: dict[str, Any]) -> None:
    JSON_MANIFEST.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    YAML_MANIFEST.write_text("\n".join(_emit_yaml(data)) + "\n", encoding="utf-8")


def _manifest_yaml_identity() -> tuple[str | None, str | None, str | None]:
    try:
        text = YAML_MANIFEST.read_text(encoding="utf-8")
    except OSError as exc:
        raise InitializationError(f"cannot read {YAML_MANIFEST.name}: {exc}") from exc
    project = re.search(r"(?m)^project:\s*[\"']?([^\"'\n]+?)[\"']?\s*$", text)
    version = re.search(r"(?m)^iteration:\s*[\"']?(v\d+\.\d+\.\d+)[\"']?\s*$", text)
    state = re.search(r"(?m)^  state:\s*[\"']?([a-z_]+)[\"']?\s*$", text)
    return (
        project.group(1).strip() if project else None,
        version.group(1) if version else None,
        state.group(1) if state else None,
    )


def _included_file(path: Path) -> bool:
    relative = path.relative_to(ROOT)
    return not any(part in EXCLUDED_PARTS for part in relative.parts)


def _source_tree_digest() -> str:
    digest = hashlib.sha256()
    for path in sorted(p for p in ROOT.rglob("*") if p.is_file() and _included_file(p)):
        relative = path.relative_to(ROOT).as_posix().encode("utf-8")
        digest.update(relative)
        digest.update(b"\0")
        digest.update(hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()


def _title_from_project(project: str) -> str:
    words = [word for word in re.split(r"[-_.]+", project) if word]
    return " ".join(word[:1].upper() + word[1:] for word in words) or project


def _replace_readme_identity(title: str, project: str, version: str, source_project: str, source_version: str) -> None:
    text = README.read_text(encoding="utf-8")
    lines = text.splitlines()
    if not lines or not lines[0].startswith("# "):
        raise InitializationError("README.md must start with a level-1 title")
    lines[0] = f"# {title}"
    text = "\n".join(lines) + ("\n" if text.endswith("\n") else "")
    start = text.find(IDENTITY_START)
    end = text.find(IDENTITY_END)
    if start < 0 or end < 0 or end < start:
        raise InitializationError("README.md is missing the managed initialization identity block")
    end += len(IDENTITY_END)
    replacement = "\n".join([
        IDENTITY_START,
        "## Project identity",
        "",
        f"**Project:** `{project}`  ",
        f"**Initial version:** `{version}`  ",
        f"**Initialized from:** `{source_project}` `{source_version}`",
        "",
        "Starter provenance is retained here and in the root manifest; it is not operational project identity.",
        IDENTITY_END,
    ])
    README.write_text(text[:start] + replacement + text[end:], encoding="utf-8")


def _reset_iterations() -> int:
    removed = 0
    ITERATIONS.mkdir(parents=True, exist_ok=True)
    for path in list(ITERATIONS.iterdir()):
        if path.name == "README.md":
            continue
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
        removed += 1
    return removed


def _reset_changelog() -> None:
    CHANGELOG.write_text(
        "# Changelog\n\n"
        "This file is generated from sealed `iterations/*/change.md` records and is limited to the latest 20 entries.\n\n"
        "No sealed project iterations yet.\n",
        encoding="utf-8",
    )


def status() -> int:
    try:
        data = _load_manifest()
        initialization = data.get("initialization") if isinstance(data.get("initialization"), dict) else {}
        state = initialization.get("state", "legacy")
        print(f"state={state}")
        print(f"project={data.get('project', '')}")
        print(f"version={data.get('iteration', '')}")
        source = initialization.get("source") if isinstance(initialization.get("source"), dict) else {}
        if source:
            print(f"source_project={source.get('project', '')}")
            print(f"source_version={source.get('version', '')}")
        return 0
    except InitializationError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2


def validate() -> int:
    errors: list[str] = []
    try:
        data = _load_manifest()
        y_project, y_version, y_state = _manifest_yaml_identity()
        project = str(data.get("project") or "")
        version = str(data.get("iteration") or "")
        initialization = data.get("initialization") if isinstance(data.get("initialization"), dict) else {}
        state = str(initialization.get("state") or "")
        if not PROJECT_RE.fullmatch(project):
            errors.append("project identity must be a lowercase path-safe slug")
        if not VERSION_RE.fullmatch(version):
            errors.append("version must use vN.N.N")
        if state not in {"starter", "initialized"}:
            errors.append("initialization.state must be starter or initialized")
        if y_project != project or y_version != version or y_state != state:
            errors.append("JSON/YAML root manifest identity is not synchronized")
        if state == "initialized":
            source = initialization.get("source") if isinstance(initialization.get("source"), dict) else {}
            if not source.get("project") or not source.get("version") or not source.get("tree_sha256"):
                errors.append("initialized workspace must preserve source project/version/tree provenance")
            target = initialization.get("target") if isinstance(initialization.get("target"), dict) else {}
            if target.get("project") != project or not VERSION_RE.fullmatch(str(target.get("version") or "")):
                errors.append("initialized workspace must preserve its initialization target project/version")
        readme = README.read_text(encoding="utf-8")
        if IDENTITY_START not in readme or IDENTITY_END not in readme:
            errors.append("README.md managed initialization identity block is missing")
    except (OSError, InitializationError) as exc:
        errors.append(str(exc))
    for error in errors:
        print(f"ERROR: {error}")
    if errors:
        return 1
    print("initialization=valid")
    return 0


def initialize(project: str, version: str, title: str | None) -> int:
    try:
        if not PROJECT_RE.fullmatch(project):
            raise InitializationError("--project must be a lowercase path-safe slug")
        if not VERSION_RE.fullmatch(version):
            raise InitializationError("--version must use vN.N.N")
        data = _load_manifest()
        initialization = data.get("initialization") if isinstance(data.get("initialization"), dict) else {}
        state = initialization.get("state")
        if state != "starter":
            raise InitializationError(f"initialization is one-shot; current state is {state or 'legacy'}")
        source_project = str(data.get("project") or "")
        source_version = str(data.get("iteration") or "")
        if not PROJECT_RE.fullmatch(source_project) or not VERSION_RE.fullmatch(source_version):
            raise InitializationError("starter source identity is invalid")
        source_tree = _source_tree_digest()
        initialized_at = utc_now()
        display_title = title.strip() if title and title.strip() else _title_from_project(project)
        removed = _reset_iterations()
        _reset_changelog()
        _replace_readme_identity(display_title, project, version, source_project, source_version)
        new_data: dict[str, Any] = {
            "schema_version": data.get("schema_version", 1),
            "project": project,
            "iteration": version,
            "previous_iteration": None,
            "status": "initialized",
            "created_at": initialized_at,
            "scope": "project-initialization",
            "initialization": {
                "state": "initialized",
                "source": {
                    "project": source_project,
                    "version": source_version,
                    "tree_sha256": source_tree,
                },
                "target": {
                    "project": project,
                    "version": version,
                },
                "initialized_at": initialized_at,
            },
            "changes": ["initialize project identity from reusable starter"],
            "validation": {
                "status": "pending",
                "checks": [],
            },
            "artifacts": {},
        }
        _write_manifests(new_data)
        if validate() != 0:
            raise InitializationError("post-initialization validation failed")
        print("initialization=passed")
        print(f"project={project}")
        print(f"version={version}")
        print(f"source_project={source_project}")
        print(f"source_version={source_version}")
        print(f"source_tree_sha256={source_tree}")
        print(f"reset_iterations={removed}")
        print(f"recommended_workspace_name={project}.{version}")
        return 0
    except (OSError, InitializationError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Initialize a reusable starter as a new project identity.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="show starter/initialized state")
    sub.add_parser("validate", help="validate initialization metadata and managed identity surfaces")
    init = sub.add_parser("init", help="perform the one-time starter-to-project initialization")
    init.add_argument("--project", required=True, help="lowercase path-safe project slug")
    init.add_argument("--version", required=True, help="initial project version using vN.N.N")
    init.add_argument("--title", help="optional README display title; derived from project slug when omitted")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "status":
        return status()
    if args.command == "validate":
        return validate()
    if args.command == "init":
        return initialize(args.project, args.version, args.title)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
