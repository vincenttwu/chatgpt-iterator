<file path="src/watch/lifecycle-repository.ts">
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  type JsonRecordRepository,
  type MetaRecord,
} from '../persistence/index.ts';
import {
  WATCH_LIFECYCLE_META_PREFIX,
  type WatchLifecycleValue,
} from './types.ts';
import { lifecycleMetaKey, requireWatchLifecycleValue } from './validation.ts';

export class WatchLifecycleRepository {
  readonly #meta: JsonRecordRepository<MetaRecord>;

  constructor(meta: JsonRecordRepository<MetaRecord>) {
    this.#meta = meta;
  }

  async get(watchSessionId: WatchLifecycleValue['watchSessionId']): Promise<WatchLifecycleValue | undefined> {
    const record = await this.#meta.get(lifecycleMetaKey(watchSessionId));
    return record === undefined ? undefined : requireWatchLifecycleValue(record.value);
  }

  async put(value: WatchLifecycleValue): Promise<void> {
    const validated = requireWatchLifecycleValue(value);
    await this.#meta.put({
      schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
      key: lifecycleMetaKey(validated.watchSessionId),
      value: validated,
    });
  }

  async delete(watchSessionId: WatchLifecycleValue['watchSessionId']): Promise<void> {
    await this.#meta.delete(lifecycleMetaKey(watchSessionId));
  }

  async list(): Promise<readonly WatchLifecycleValue[]> {
    const records = await this.#meta.list();
    const values = records
      .filter((record) => record.key.startsWith(WATCH_LIFECYCLE_META_PREFIX))
      .map((record) => requireWatchLifecycleValue(record.value));
    return Object.freeze(values);
  }

  async clear(): Promise<void> {
    const records = await this.#meta.list();
    await Promise.all(records
      .filter((record) => record.key.startsWith(WATCH_LIFECYCLE_META_PREFIX))
      .map((record) => this.#meta.delete(record.key)));
  }

  async listWatching(): Promise<readonly WatchLifecycleValue[]> {
    return Object.freeze((await this.list()).filter((value) => value.state === 'watching'));
  }

  async latestTerminal(): Promise<WatchLifecycleValue | undefined> {
    const terminal = (await this.list())
      .filter((value) => value.state !== 'watching' && value.endedAt !== undefined)
      .sort((left, right) => right.endedAt!.localeCompare(left.endedAt!));
    return terminal[0];
  }
}
