<file path="src/definitions/validation.ts">
import {
  INITIAL_REVISION,
  assertJsonSafe,
  cloneJsonValue,
  freezeJsonValue,
  requireJsonObject,
  requireRevision,
  requireStableId,
  type JsonObject,
  type Revision,
} from '../core/index.ts';
import {
  PERSISTED_RECORD_SCHEMA_VERSION,
  requireDefinitionRecord,
  requireIsoTimestamp,
  requireWatchSessionRecord,
  type DefinitionRecord,
  type WatchSessionRecord,
} from '../persistence/index.ts';
import { DEFINITION_ERROR_CODES, DefinitionError } from './errors.ts';
import {
  DEFINITION_KINDS,
  type DefinitionKind,
  type DefinitionReference,
  type FrozenDefinitionSnapshot,
  type ImmutableWatchSessionRecord,
  type SavedDefinitionRecord,
  type SavedDefinitionValue,
  type WatchSessionSnapshotValue,
} from './types.ts';

const SHA256_DIGEST_PATTERN = /^sha256:[0-9a-f]{64}$/;

export function isDefinitionKind(value: unknown): value is DefinitionKind {
  return typeof value === 'string' && (DEFINITION_KINDS as readonly string[]).includes(value);
}

export function requireDefinitionKind(value: unknown, label = 'definitionKind'): DefinitionKind {
  if (!isDefinitionKind(value)) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidDefinition,
      `${label} must be a supported definition kind`,
      { label },
    );
  }
  return value;
}

function requireNonEmptyName(value: unknown): string {
  if (typeof value !== 'string' || value.trim() === '') {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidDefinition,
      'definition name must be a non-empty string',
    );
  }
  return value;
}

function requireBoolean(value: unknown, label: string): boolean {
  if (typeof value !== 'boolean') {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidDefinition,
      `${label} must be boolean`,
      { label },
    );
  }
  return value;
}

export function requireDefinitionReference(value: unknown): DefinitionReference {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  const reference: DefinitionReference = {
    id: requireStableId(record.id, 'definition'),
    kind: requireDefinitionKind(record.kind, 'reference.kind'),
    ...(record.expectedRevision === undefined
      ? {}
      : { expectedRevision: requireRevision(record.expectedRevision) }),
  };
  return freezeJsonValue(cloneJsonValue(reference));
}

export function requireSavedDefinitionValue(value: unknown): SavedDefinitionValue {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (!Array.isArray(record.references)) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidDefinition,
      'definition references must be an array',
    );
  }
  const references = record.references.map((reference) => requireDefinitionReference(reference));
  const body = record.body === undefined ? {} : requireJsonObject(record.body);
  const normalized: SavedDefinitionValue = {
    name: requireNonEmptyName(record.name),
    enabled: requireBoolean(record.enabled, 'enabled'),
    body: freezeJsonValue(cloneJsonValue(body)),
    references: Object.freeze(references),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function requireSavedDefinitionRecord(value: unknown): SavedDefinitionRecord {
  const base = requireDefinitionRecord(value) as DefinitionRecord;
  const normalized: SavedDefinitionRecord = {
    schemaVersion: base.schemaVersion,
    id: base.id,
    revision: base.revision,
    definitionKind: requireDefinitionKind(base.definitionKind),
    createdAt: base.createdAt,
    updatedAt: base.updatedAt,
    value: requireSavedDefinitionValue(base.value),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

function requireDigest(value: unknown, label: string): string {
  if (typeof value !== 'string' || !SHA256_DIGEST_PATTERN.test(value)) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidDefinition,
      `${label} must be a canonical sha256 digest`,
      { label },
    );
  }
  return value;
}

export function requireFrozenDefinitionSnapshot(value: unknown): FrozenDefinitionSnapshot {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  const normalized: FrozenDefinitionSnapshot = {
    id: requireStableId(record.id, 'definition'),
    kind: requireDefinitionKind(record.kind, 'snapshot.kind'),
    revision: requireRevision(record.revision),
    digest: requireDigest(record.digest, 'snapshot.digest'),
    value: requireSavedDefinitionValue(record.value),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function requireWatchSessionSnapshotValue(value: unknown): WatchSessionSnapshotValue {
  assertJsonSafe(value);
  const record = requireJsonObject(value);
  if (!Array.isArray(record.definitions) || record.definitions.length === 0) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.invalidDefinition,
      'WatchSession definitions must be a non-empty array',
    );
  }
  const definitions = record.definitions.map((definition) => requireFrozenDefinitionSnapshot(definition));
  const watchDefinitionId = requireStableId(record.watchDefinitionId, 'definition');
  if (!definitions.some((definition) => definition.id === watchDefinitionId && definition.kind === 'watch')) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.watchDefinitionRequired,
      'WatchSession snapshot must include its watch definition',
    );
  }
  const normalized: WatchSessionSnapshotValue = {
    watchDefinitionId,
    definitions: Object.freeze(definitions),
    definitionSetDigest: requireDigest(record.definitionSetDigest, 'definitionSetDigest'),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function requireImmutableWatchSessionRecord(value: unknown): ImmutableWatchSessionRecord {
  const base = requireWatchSessionRecord(value) as WatchSessionRecord;
  const normalized: ImmutableWatchSessionRecord = {
    schemaVersion: base.schemaVersion,
    id: base.id,
    createdAt: requireIsoTimestamp(base.createdAt, 'createdAt'),
    updatedAt: requireIsoTimestamp(base.updatedAt, 'updatedAt'),
    value: requireWatchSessionSnapshotValue(base.value),
  };
  return freezeJsonValue(cloneJsonValue(normalized));
}

export function createDefinitionValue(input: {
  readonly name: string;
  readonly enabled?: boolean;
  readonly body?: JsonObject;
  readonly references?: readonly DefinitionReference[];
}): SavedDefinitionValue {
  const value: SavedDefinitionValue = {
    name: input.name,
    enabled: input.enabled ?? true,
    body: input.body ?? {},
    references: input.references ?? [],
  };
  return requireSavedDefinitionValue(value);
}

export function createInitialDefinitionRecord(input: {
  readonly id: SavedDefinitionRecord['id'];
  readonly kind: DefinitionKind;
  readonly value: SavedDefinitionValue;
  readonly timestamp: SavedDefinitionRecord['createdAt'];
}): SavedDefinitionRecord {
  const record: SavedDefinitionRecord = {
    schemaVersion: PERSISTED_RECORD_SCHEMA_VERSION,
    id: input.id,
    revision: INITIAL_REVISION,
    definitionKind: input.kind,
    createdAt: input.timestamp,
    updatedAt: input.timestamp,
    value: input.value,
  };
  return requireSavedDefinitionRecord(record);
}

export function requireExpectedRevision(
  actual: Revision,
  expected: Revision | undefined,
  id: SavedDefinitionRecord['id'],
): void {
  if (expected !== undefined && actual !== expected) {
    throw new DefinitionError(
      DEFINITION_ERROR_CODES.revisionConflict,
      `Definition ${id} revision changed`,
      { id, expectedRevision: expected, actualRevision: actual },
    );
  }
}
</file>

