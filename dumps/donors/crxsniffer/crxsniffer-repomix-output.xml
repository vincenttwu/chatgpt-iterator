  assert.equal(serialized.includes('My Video'), false);
  assert.equal(serialized.includes('CDN.EXAMPLE.TEST'), false);
});

test('admission explanation stores matched glob indexes rather than raw patterns', async () => {
  const seeded = await session({ exclude: ['https://cdn.example.test/media/*'] });
  const result = evaluateResourceCandidate({ session: seeded.session, observation: observation() });
  assert.equal(result.status, 'rejected');
  assert.deepEqual(result.explanation.admission.matchedPresets, ['videos']);
