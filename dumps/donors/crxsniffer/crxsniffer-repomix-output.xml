import fs from 'node:fs';
import { performance } from 'node:perf_hooks';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

import { createStableId } from '../src/core/index.ts';
import { requireIsoTimestamp } from '../src/persistence/index.ts';
import { ControlPlaneInvalidationBatcher, SidePanelConnection } from '../src/control-plane/index.ts';
import { ResourceHistoryService, mergeResourceHistoryRows, virtualResourceWindow } from '../src/resources/index.ts';
import { WatchRetentionService } from '../src/watch/index.ts';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
export const PERFORMANCE_CONTRACT = JSON.parse(fs.readFileSync(path.join(ROOT, 'performance-readiness.json'), 'utf8'));
const W = PERFORMANCE_CONTRACT.workloads;

function measured(name, fn, budgetMs) {
  const started = performance.now();
  return Promise.resolve(fn()).then((value) => {
    const elapsedMs = performance.now() - started;
    return { name, status: elapsedMs <= budgetMs ? 'passed' : 'failed', elapsedMs, budgetMs, value };
  });
}

function uuid(index) {
  return `00000000-0000-4000-8000-${index.toString(16).padStart(12, '0')}`;
}

const WATCH_ID = createStableId('watchSession', () => '00000000-0000-4000-8000-000000000001');

function resourceRecord(index) {
  const id = createStableId('resourceObservation', () => uuid(index + 1));
  const observedAt = requireIsoTimestamp(new Date(Date.UTC(2026, 7, 20, 0, 0, 0) - index).toISOString());
  const url = `https://cdn.example.test/assets/${index}.jpg?slot=${index % 17}`;
  const filename = index % 50 === 0 ? `match-marker-${index}.jpg` : `asset-${index}.jpg`;
  return Object.freeze({
    schemaVersion: 1,
    id,
    watchSessionId: WATCH_ID,
    observedAt,
    value: Object.freeze({
      schemaVersion: 1,
      requestId: `request-${index}`,
      tabId: 7,
      method: 'GET',
      requestType: 'image',
      startedAt: observedAt,
      endedAt: observedAt,
      startedWithBeforeRequest: true,
      initialUrl: url,
      finalUrl: url,
      frameId: 0,
      hops: Object.freeze([]),
      responseStatusCode: 200,
      responseMimeType: 'image/jpeg',
      terminal: Object.freeze({ kind: 'completed', at: observedAt, statusCode: 200 }),
    }),
    evaluation: Object.freeze({
      schemaVersion: 2,
      observationId: id,
      watchSessionId: WATCH_ID,
      status: 'projected',
      projection: Object.freeze({ canonicalUrl: url, derived: Object.freeze({ filename }) }),
      explanation: Object.freeze({
        classification: Object.freeze({ kind: 'image', reason: 'mime_image' }),
        admission: Object.freeze({ matchedPresets: Object.freeze(['images']) }),
        pageEnrichment: Object.freeze({ status: 'not_requested' }),
        packagizer: Object.freeze({ rules: Object.freeze([]) }),
      }),
    }),
  });
}

class SyntheticHistoryReader {
  constructor(records) {
    this.records = records;
    this.byId = new Map(records.map((record, index) => [record.id, index]));
  }
  async listWatchSessions() { return { items: [] }; }
  async listResourceObservations(_watchSessionId, limit, cursor) {
    const start = cursor === undefined ? 0 : (this.byId.get(cursor.observationId) ?? -1) + 1;
    const items = this.records.slice(start, start + limit);
    const last = items.at(-1);
    return {
      items,
      ...(start + items.length < this.records.length && last !== undefined
        ? { nextCursor: { observedAt: last.observedAt, observationId: last.id } }
        : {}),
    };
  }
  async getResourceObservation(id) { return this.records[this.byId.get(id)] ?? undefined; }
}

function historyRows(count) {
  return Array.from({ length: count }, (_, index) => ({
    observationId: createStableId('resourceObservation', () => uuid(index + 20000)),
    watchSessionId: WATCH_ID,
    observedAt: requireIsoTimestamp(new Date(Date.UTC(2026, 7, 20, 1, 0, 0) - index).toISOString()),
    endedAt: requireIsoTimestamp(new Date(Date.UTC(2026, 7, 20, 1, 0, 0) - index).toISOString()),
    canonicalUrl: `https://cdn.example.test/${index}.jpg`,
    kind: 'image',
    status: 'projected',
    filename: `asset-${index}.jpg`,
  }));
}

class ListenerEvent {
  listeners = [];
  addListener(listener) { this.listeners.push(listener); }
  emit(...args) { for (const listener of [...this.listeners]) listener(...args); }
}
class PerfPort {
  name = 'crsniffer.panel.v2';
  onMessage = new ListenerEvent();
  onDisconnect = new ListenerEvent();
  postMessage() {}
  disconnect() { this.onDisconnect.emit(); }
}

export async function runRepositoryPerformanceWorkloads() {
  const records = Array.from({ length: W.largeResourceHistory.recordCount }, (_, index) => resourceRecord(index));
  const history = new ResourceHistoryService(new SyntheticHistoryReader(records));
  const results = [];

  results.push(await measured('largeResourceHistory', async () => {
    let cursor;
    let pages = 0;
    let totalScanned = 0;
    let totalMatches = 0;
    do {
      const page = await history.page({
        watchSessionId: WATCH_ID,
        limit: W.largeResourceHistory.queryLimit,
        ...(cursor === undefined ? {} : { cursor }),
        searchText: 'match-marker',
        kind: 'all',
        status: 'all',
      });
      if (page.scannedCount > W.largeResourceHistory.scanCap) throw new Error('resource scan cap exceeded');
      totalScanned += page.scannedCount;
      totalMatches += page.items.length;
      cursor = page.nextCursor;
      pages += 1;
    } while (cursor !== undefined && pages < 100);
    if (totalScanned !== W.largeResourceHistory.recordCount || totalMatches !== 200) {
      throw new Error(`unexpected history result scanned=${totalScanned} matches=${totalMatches}`);
    }
    return { pages, totalScanned, totalMatches };
  }, W.largeResourceHistory.regressionBudgetMs));

  const current = historyRows(W.resourceBurstMerge.currentCount);
  const incoming = historyRows(W.resourceBurstMerge.incomingCount).map((row, index) => ({
    ...row,
    observationId: createStableId('resourceObservation', () => uuid(index + 40000)),
    observedAt: requireIsoTimestamp(new Date(Date.UTC(2026, 7, 20, 2, 0, 0) - index).toISOString()),
  }));
  results.push(await measured('resourceBurstMerge', () => {
    const merged = mergeResourceHistoryRows({
      current,
      incoming,
      limit: W.resourceBurstMerge.bufferLimit,
      preserveObservationId: current.at(-1)?.observationId,
    });
    if (merged.length !== W.resourceBurstMerge.bufferLimit) throw new Error('resource buffer is not bounded');
    if (!merged.some((row) => row.observationId === current.at(-1)?.observationId)) throw new Error('selected row was not preserved');
    return { mountedBuffer: merged.length };
  }, W.resourceBurstMerge.regressionBudgetMs));

  results.push(await measured('virtualWindow', () => {
    let maxMounted = 0;
    for (let index = 0; index < W.virtualWindow.iterations; index += 1) {
      const window = virtualResourceWindow({
        itemCount: W.virtualWindow.itemCount,
        rowHeight: W.virtualWindow.rowHeight,
        viewportHeight: W.virtualWindow.viewportHeight,
        scrollTop: (index * 997) % (W.virtualWindow.itemCount * W.virtualWindow.rowHeight),
        overscan: W.virtualWindow.overscan,
      });
      maxMounted = Math.max(maxMounted, window.endIndex - window.startIndex);
    }
    const visible = Math.ceil(W.virtualWindow.viewportHeight / W.virtualWindow.rowHeight);
    const expectedMax = visible + W.virtualWindow.overscan * 2;
    if (maxMounted > expectedMax) throw new Error(`virtual window mounted ${maxMounted} > ${expectedMax}`);
    return { maxMounted, expectedMax };
  }, W.virtualWindow.regressionBudgetMs));

  results.push(await measured('invalidationBurst', () => {
    const scheduled = [];
    const flushed = [];
    const batcher = new ControlPlaneInvalidationBatcher(
      (reasons) => flushed.push(reasons),
      (callback) => scheduled.push(callback),
    );
    for (let index = 0; index < W.invalidationBurst.hintCount; index += 1) batcher.enqueue('observation_persisted');
    batcher.enqueue('runtime_degraded');
    batcher.enqueue('observation_persisted');
    if (scheduled.length !== 1) throw new Error(`expected one scheduled refresh wave, got ${scheduled.length}`);
    scheduled[0]();
    if (flushed.length !== W.invalidationBurst.expectedRefreshWaves) throw new Error('unexpected invalidation flush count');
    if (flushed[0].length !== 2) throw new Error('invalidation reasons were not deduplicated');
    batcher.stop();
    return { refreshWaves: flushed.length, reasons: flushed[0] };
  }, W.invalidationBurst.regressionBudgetMs));

  results.push(await measured('retentionPressure', async () => {
    const nowMs = Date.UTC(2026, 7, 20, 3, 0, 0);
    const terminal = Array.from({ length: W.retentionPressure.terminalSessionCount }, (_, index) => ({
      watchSessionId: createStableId('watchSession', () => uuid(index + 60000)),
      state: 'stopped',
      endedAt: requireIsoTimestamp(new Date(nowMs - index * 1000).toISOString()),
    }));
    let deleted = 0;
    const lifecycle = { list: async () => terminal };
    const store = { deleteTerminalSessions: async (ids) => {
      deleted = ids.length;
      return { deletedSessions: ids.length, deletedResourceObservations: 0, deletedPageFieldSnapshots: 0, deletedLifecycleRecords: ids.length };
    } };
    let state;
    const meta = { get: async () => undefined, put: async (value) => { state = value; } };
    const service = new WatchRetentionService({ lifecycle, store, meta, now: () => requireIsoTimestamp(new Date(nowMs).toISOString()) });
    await service.enforce({ maxAgeDays: 90, maxTerminalSessions: W.retentionPressure.retainedSessionCount }, 'manual');
    const expectedDeleted = W.retentionPressure.terminalSessionCount - W.retentionPressure.retainedSessionCount;
    if (deleted !== expectedDeleted) throw new Error(`retention deleted ${deleted}, expected ${expectedDeleted}`);
    if (state === undefined) throw new Error('retention state was not persisted');
    return { deleted, retained: W.retentionPressure.retainedSessionCount };
  }, W.retentionPressure.regressionBudgetMs));

  results.push(await measured('reconnectSoak', () => {
    const ports = [];
    const scheduled = [];
    let invalidations = 0;
    const runtime = {
      connect() { const port = new PerfPort(); ports.push(port); return port; },
      sendMessage: async () => undefined,
    };
    const connection = new SidePanelConnection(runtime, { onInvalidation: () => { invalidations += 1; } }, (callback) => scheduled.push(callback));
    connection.start();
    for (let cycle = 0; cycle < W.reconnectSoak.cycles; cycle += 1) {
      const current = ports.at(-1);
      current.onDisconnect.emit();
      const reconnect = scheduled.shift();
      if (reconnect === undefined) throw new Error('reconnect was not scheduled');
      reconnect();
      current.onMessage.emit({ kind: 'invalidate', schemaVersion: 2, sequence: cycle + 1, reason: 'watch_changed' });
    }
    if (ports.length !== W.reconnectSoak.cycles + 1) throw new Error('reconnect count mismatch');
    if (invalidations !== 0) throw new Error('stale disconnected ports retained presentation ownership');
    connection.stop();
    return { cycles: W.reconnectSoak.cycles, openedPorts: ports.length };
  }, W.reconnectSoak.regressionBudgetMs));

  return {
    schemaVersion: 1,
    packageVersion: PERFORMANCE_CONTRACT.packageVersion,
    measuredAt: new Date().toISOString(),
    clock: PERFORMANCE_CONTRACT.measurement.clock,
    portableTimingClaim: PERFORMANCE_CONTRACT.measurement.portableTimingClaim,
    productHardLimitsAdded: PERFORMANCE_CONTRACT.productHardLimitsAdded,
    certifiedMinimumsAreNotMaxima: PERFORMANCE_CONTRACT.certifiedMinimumsAreNotMaxima,
    workloads: results,
    result: results.every((entry) => entry.status === 'passed') ? 'passed' : 'failed',
  };
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const report = await runRepositoryPerformanceWorkloads();
  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
  if (report.result !== 'passed') process.exitCode = 1;
}
