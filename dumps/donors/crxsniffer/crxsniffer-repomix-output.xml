import type { JsonObject, StableId } from '../core/index.ts';
import type { PageFieldEnrichmentStatus } from '../page-fields/index.ts';
import type { ImmutableWatchSessionRecord } from '../definitions/index.ts';
import type {
  PackagizerDerivedFields,
  PackagizerPageContext,
  PackagizerStructuralExplanation,
} from '../packagizer/index.ts';
import type { IsoTimestamp, ResourceObservationRecord } from '../persistence/index.ts';
import type { ResourceClassification } from '../resources/index.ts';

export const RESOURCE_EVALUATION_SCHEMA_VERSION = 2 as const;
export const RESOURCE_PROJECTION_SCHEMA_VERSION = 2 as const;
export const RESOURCE_EXPLANATION_SCHEMA_VERSION = 2 as const;

export type ResourceEvaluationStatus = 'rejected' | 'projected' | 'failed';

export interface ResourceProjectionAdmission extends JsonObject {
  readonly matchedPresets: readonly ('images' | 'videos')[];
  readonly matchedIncludeGlobIndexes: readonly number[];
}

export interface ResourceProjectionAuthority extends JsonObject {
  readonly evaluatorSchemaVersion: typeof RESOURCE_EVALUATION_SCHEMA_VERSION;
  readonly definitionSetDigest: string;
  readonly pageFieldSnapshotId?: StableId<'pageFieldSnapshot'>;
}

export interface ResourceProjection extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_PROJECTION_SCHEMA_VERSION;
  readonly observationId: StableId<'resourceObservation'>;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly requestId: string;
  readonly documentKey: string;
  readonly canonicalUrl: string;
  readonly startedAt: IsoTimestamp;
  readonly endedAt: IsoTimestamp;
  readonly classification: ResourceClassification;
  readonly admission: ResourceProjectionAdmission;
  readonly derived: PackagizerDerivedFields;
  readonly authority: ResourceProjectionAuthority;
}

export interface ResourceClassificationExplanation extends JsonObject {
  readonly kind: ResourceClassification['kind'];
  readonly reason: ResourceClassification['reason'];
  readonly requestType: string;
  readonly mimePresent: boolean;
  readonly extensionPresent: boolean;
  readonly conflict: boolean;
  readonly mimeKind?: ResourceClassification['kind'];
  readonly extensionKind?: ResourceClassification['kind'];
}

export interface ResourceAdmissionExplanation extends JsonObject {
  readonly admitted: boolean;
  readonly positive: boolean;
  readonly matchedPresets: readonly ('images' | 'videos')[];
  readonly matchedIncludeGlobIndexes: readonly number[];
  readonly matchedExcludeGlobIndexes: readonly number[];
}


export type ResourcePageEnrichmentStatus = PageFieldEnrichmentStatus | 'provided' | 'not_provided';

export interface ResourcePageEnrichmentExplanation extends JsonObject {
  readonly status: ResourcePageEnrichmentStatus;
  readonly snapshotId?: StableId<'pageFieldSnapshot'>;
  readonly persisted?: boolean;
}

export interface ResourceEvaluationFailure extends JsonObject {
  readonly stage: 'packagizer';
  readonly code: string;
  readonly ruleId?: StableId<'definition'>;
}

export interface ResourceEvaluationExplanation extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_EXPLANATION_SCHEMA_VERSION;
  readonly classification: ResourceClassificationExplanation;
  readonly admission: ResourceAdmissionExplanation;
  readonly packagizerStatus: 'not_evaluated_admission' | 'evaluated';
  readonly pageEnrichment: ResourcePageEnrichmentExplanation;
  readonly packagizer?: PackagizerStructuralExplanation;
  readonly failure?: ResourceEvaluationFailure;
}

export interface ResourceEvaluationResult extends JsonObject {
  readonly schemaVersion: typeof RESOURCE_EVALUATION_SCHEMA_VERSION;
  readonly status: ResourceEvaluationStatus;
  readonly observationId: StableId<'resourceObservation'>;
  readonly watchSessionId: StableId<'watchSession'>;
  readonly projection?: ResourceProjection;
  readonly explanation: ResourceEvaluationExplanation;
  readonly failure?: ResourceEvaluationFailure;
}

export interface ResourceEvaluationInput {
  readonly session: ImmutableWatchSessionRecord;
  readonly observation: ResourceObservationRecord;
  readonly page?: PackagizerPageContext;
  readonly pageEnrichment?: ResourcePageEnrichmentExplanation;
}
