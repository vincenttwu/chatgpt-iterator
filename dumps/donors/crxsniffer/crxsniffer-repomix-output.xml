  const states: PanelConnectionState[] = [];
  const runtime = {
    sendMessage: async () => ({}),
    connect({ name }: { name: string }): ChromeRuntimePortPanelLike {
      const port = new PanelPort(name);
      ports.push(port);
      return port;
    },
  };
  const connection = new SidePanelConnection(
    runtime,
    {
      onInvalidation: (hint) => invalidations.push(hint),
      onStateChange: (state) => states.push(state),
    },
    (callback) => scheduled.push(callback),
  );

  connection.start();
  assert.equal(ports.length, 1);
  ports[0]!.onMessage.emit({ kind: 'junk' });
  assert.equal(invalidations.length, 0);
  ports[0]!.onMessage.emit({
    kind: 'invalidate',
    schemaVersion: CONTROL_PLANE_SCHEMA_VERSION,
    sequence: 1,
    reason: 'connected',
  });
  assert.equal(invalidations.length, 1);

  ports[0]!.onDisconnect.emit();
  assert.equal(scheduled.length, 1);
  scheduled.shift()!();
  assert.equal(ports.length, 2);
  assert.deepEqual(states, ['connecting', 'connected', 'reconnecting', 'reconnecting', 'connected']);

  connection.stop();
  assert.equal(ports[1]!.disconnected, true);
  assert.equal(states.at(-1), 'stopped');
});

