import { freezeJsonValue } from '../core/index.ts';
import { requireIsoTimestamp, type IsoTimestamp } from '../persistence/index.ts';
import type { ControlPlaneRuntimeHealth, RuntimeHealthArea } from './types.ts';

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString());
}

/** Advisory recent-runtime health. It never changes Watch/capture authority. */
export class ControlPlaneHealthTracker {
  readonly #now: () => IsoTimestamp;
  #state: ControlPlaneRuntimeHealth = freezeJsonValue({ state: 'healthy' });

  constructor(now: () => IsoTimestamp = defaultNow) {
    this.#now = now;
  }

  snapshot(): ControlPlaneRuntimeHealth {
    return this.#state;
  }

  degrade(area: RuntimeHealthArea, message: string): boolean {
    const next: ControlPlaneRuntimeHealth = freezeJsonValue({
      state: 'degraded',
      area,
      message: message.trim() === '' ? 'A background Watch operation failed.' : message,
      occurredAt: this.#now(),
    });
    const changed = JSON.stringify(next) !== JSON.stringify(this.#state);
    this.#state = next;
    return changed;
  }

  recover(): boolean {
    if (this.#state.state === 'healthy') return false;
    this.#state = freezeJsonValue({ state: 'healthy' });
    return true;
  }
}
