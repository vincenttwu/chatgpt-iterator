<file path="tests/watch/watch.test.ts">
import assert from 'node:assert/strict';
import test from 'node:test';

import {
  createRequestEnvelope,
  createStableId,
  createSuccessResponse,
  requireMessageEnvelope,
  type JsonObject,
} from '../../src/core/index.ts';
import {
  DEFINITION_ERROR_CODES,
  DefinitionCatalog,
  DefinitionError,
  WatchSessionComposer,
} from '../../src/definitions/index.ts';
import {
  META_KEYS,
  PERSISTENCE_STORES,
  JsonRecordRepository,
  requireDefinitionRecord,
  requireMetaRecord,
  requireWatchSessionRecord,
  type DefinitionRecord,
  type MetaRecord,
  type RepositoryStorePort,
  type WatchSessionRecord,
} from '../../src/persistence/index.ts';
import {
  PACKAGIZER_ERROR_CODES,
  PackagizerError,
} from '../../src/packagizer/index.ts';
import { PAGE_FIELD_ERROR_CODES, PageFieldError } from '../../src/page-fields/index.ts';
import {
  REQUIRED_WATCH_HOST_ORIGINS,
  WATCH_OPERATIONS,
  WATCH_SESSION_STORAGE_KEY,
  ChromeHostAuthority,
  WatchConfigurationService,
  WatchController,
  WatchLifecycleRepository,
  WatchMessageRouter,
  WatchPanelClient,
  WatchRetentionService,
  type ChromePermissionsPanelLike,
  type ChromeRuntimePanelLike,
  type ChromeTabsPanelLike,
  type WatchHostAuthorityPort,
  type WatchSessionStatePort,
  type WatchTab,
  type WatchTabPort,
} from '../../src/watch/index.ts';

import {
  configurationProblemMessage,
  describeResourceFilter,
  describeWatchScope,
  filterDraftFromFilter,
  terminationMessage,
  validateWatchFilterDraft,
  watchSetupSignature,
} from '../../src/watch/ui-model.ts';

class MemoryStore implements RepositoryStorePort {
  readonly values = new Map<string, JsonObject>();

  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }

  async put(value: JsonObject): Promise<void> {
    const key = typeof value.id === 'string' ? value.id : value.key;
    if (typeof key !== 'string') throw new Error('memory store requires id or key');
    this.values.set(key, structuredClone(value));
  }

  async delete(key: string): Promise<void> {
    this.values.delete(key);
  }

  async getAll(): Promise<readonly unknown[]> {
    return [...this.values.values()].map((value) => structuredClone(value));
  }
}

class MemorySessionState implements WatchSessionStatePort {
  readonly values = new Map<string, JsonObject>();

  async get(key: string): Promise<unknown> {
    const value = this.values.get(key);
    return value === undefined ? undefined : structuredClone(value);
  }

  async set(key: string, value: JsonObject): Promise<void> {
    this.values.set(key, structuredClone(value));
  }

  async remove(key: string): Promise<void> {
    this.values.delete(key);
  }

  clear(): void {
    this.values.clear();
  }
}

class MutablePermissions implements WatchHostAuthorityPort {
  granted = false;
  async hasRequiredHosts(): Promise<boolean> {
    return this.granted;
  }
}

class MutableTabs implements WatchTabPort {
  readonly tabs = new Map<number, WatchTab>();
  async get(tabId: number): Promise<WatchTab | undefined> {
    const tab = this.tabs.get(tabId);
    return tab === undefined ? undefined : { ...tab };
  }
}

const SESSION_IDS = [
  createStableId('watchSession', () => '20000000-0000-4000-8000-000000000010'),
  createStableId('watchSession', () => '20000000-0000-4000-8000-000000000011'),
  createStableId('watchSession', () => '20000000-0000-4000-8000-000000000012'),
];

const T0 = '2026-08-19T13:10:00.000Z' as never;
const T1 = '2026-08-19T13:11:00.000Z' as never;
const T2 = '2026-08-19T13:12:00.000Z' as never;

function harness() {
  const definitionMemory = new MemoryStore();
  const sessionMemory = new MemoryStore();
  const metaMemory = new MemoryStore();
  const definitions = new JsonRecordRepository<DefinitionRecord>(
    PERSISTENCE_STORES.definitions,
    definitionMemory,
    requireDefinitionRecord,
  );
  const sessions = new JsonRecordRepository<WatchSessionRecord>(
    PERSISTENCE_STORES.watchSessions,
    sessionMemory,
    requireWatchSessionRecord,
  );
  const meta = new JsonRecordRepository<MetaRecord>(
    PERSISTENCE_STORES.meta,
    metaMemory,
    requireMetaRecord,
  );
  const catalog = new DefinitionCatalog(definitions);
  const lifecycle = new WatchLifecycleRepository(meta);
  const sessionState = new MemorySessionState();
  const permissions = new MutablePermissions();
  const tabs = new MutableTabs();
  tabs.tabs.set(7, { id: 7, url: 'https://example.com/page' });
  let timeIndex = 0;
  const times = [T0, T1, T2];
  let idIndex = 0;
  const controller = new WatchController({
    catalog,
    composer: new WatchSessionComposer(definitions, sessions),
    sessions,
    lifecycle,
    sessionState,
    permissions,
    tabs,
    now: () => times[Math.min(timeIndex++, times.length - 1)]!,
    createWatchSessionId: () => SESSION_IDS[Math.min(idIndex++, SESSION_IDS.length - 1)]!,
  });
  return {
    controller,
    catalog,
    definitions,
    sessions,
    meta,
    lifecycle,
    sessionState,
    permissions,
    tabs,
    makeController: () => new WatchController({
      catalog,
      composer: new WatchSessionComposer(definitions, sessions),
      sessions,
      lifecycle,
      sessionState,
      permissions,
      tabs,
      now: () => T2,
      createWatchSessionId: () => SESSION_IDS[2]!,
    }),
  };
}

test('Watch does not create durable state before optional host authority is granted', async () => {
  const h = harness();
  const result = await h.controller.start({ tabId: 7 });

  assert.equal(result.started, false);
  assert.equal(result.reason, 'permission_required');
  assert.equal(result.status.hostCoverage, 'required');
  assert.equal((await h.definitions.list()).length, 0);
  assert.equal((await h.sessions.list()).length, 0);
  assert.equal((await h.lifecycle.list()).length, 0);
  assert.equal(await h.sessionState.get(WATCH_SESSION_STORAGE_KEY), undefined);
});

test('Watch rejects unsupported and incognito targets before session composition', async () => {
  const h = harness();
  h.permissions.granted = true;
  h.tabs.tabs.set(7, { id: 7, url: 'chrome://settings/' });
  assert.equal((await h.controller.start({ tabId: 7 })).reason, 'target_unsupported');

  h.tabs.tabs.set(7, { id: 7, url: 'https://example.com/', incognito: true });
  assert.equal((await h.controller.start({ tabId: 7 })).reason, 'target_unsupported');
  assert.equal((await h.sessions.list()).length, 0);
});

test('invalid frozen Packagizer definitions fail Watch start and roll back the composed session', async () => {
  const h = harness();
  h.permissions.granted = true;
