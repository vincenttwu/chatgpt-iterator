import {
  cloneJsonValue,
  createStableId,
  freezeJsonValue,
  type StableId,
} from '../core/index.ts';
import { WatchSessionComposer } from '../definitions/index.ts';
import {
  requireIsoTimestamp,
  requireResourceObservationRecord,
  type IsoTimestamp,
  type JsonRecordRepository,
  type ResourceObservationRecord,
} from '../persistence/index.ts';
import type {
  PackagizerPreviewInput,
  PackagizerPreviewResult,
} from '../packagizer/index.ts';
import { RESOURCE_EVALUATION_ERROR_CODES, ResourceEvaluationError } from './errors.ts';
import { ResourceEvaluationService } from './service.ts';

export interface PackagizerResourcePreviewServiceOptions {
  readonly composer: WatchSessionComposer;
  readonly observations: JsonRecordRepository<ResourceObservationRecord>;
  readonly evaluation: ResourceEvaluationService;
  readonly now?: () => IsoTimestamp;
  readonly createWatchSessionId?: () => StableId<'watchSession'>;
  readonly createObservationId?: () => StableId<'resourceObservation'>;
}

function defaultNow(): IsoTimestamp {
  return requireIsoTimestamp(new Date().toISOString());
}

/**
 * Re-evaluate one captured observation against the currently saved Watch graph without
 * persisting a WatchSession, observation, PageFieldSnapshot, or preview explanation.
 */
export class PackagizerResourcePreviewService {
  readonly #composer: WatchSessionComposer;
  readonly #observations: JsonRecordRepository<ResourceObservationRecord>;
  readonly #evaluation: ResourceEvaluationService;
  readonly #now: () => IsoTimestamp;
  readonly #createWatchSessionId: () => StableId<'watchSession'>;
  readonly #createObservationId: () => StableId<'resourceObservation'>;

  constructor(options: PackagizerResourcePreviewServiceOptions) {
    this.#composer = options.composer;
    this.#observations = options.observations;
    this.#evaluation = options.evaluation;
    this.#now = options.now ?? defaultNow;
    this.#createWatchSessionId = options.createWatchSessionId ?? (() => createStableId('watchSession'));
    this.#createObservationId = options.createObservationId ?? (() => createStableId('resourceObservation'));
  }

  async preview(input: PackagizerPreviewInput): Promise<PackagizerPreviewResult> {
    const source = await this.#observations.get(input.observationId);
    if (source === undefined) {
      throw new ResourceEvaluationError(
        RESOURCE_EVALUATION_ERROR_CODES.invalidInput,
        'The selected Preview resource is no longer available',
      );
    }
    const timestamp = this.#now();
    const previewSession = await this.#composer.preview({
      id: this.#createWatchSessionId(),
      watchDefinitionId: input.watchDefinitionId,
      expectedWatchRevision: input.expectedWatchRevision,
      timestamp,
    });
    const { evaluation: _discardedEvaluation, ...sourceWithoutEvaluation } = requireResourceObservationRecord(source);
    const previewObservation = requireResourceObservationRecord({
      ...cloneJsonValue(sourceWithoutEvaluation),
      id: this.#createObservationId(),
      watchSessionId: previewSession.id,
      observedAt: source.observedAt,
    });
    const evaluated = await this.#evaluation.previewWithSession(previewSession, previewObservation);
    const explanation = evaluated.explanation;
    return freezeJsonValue({
      schemaVersion: 1,
      sourceObservationId: input.observationId,
      watchDefinitionId: input.watchDefinitionId,
      watchRevision: input.expectedWatchRevision,
      status: evaluated.status,
      classification: explanation.classification,
      admission: explanation.admission,
      pageEnrichmentStatus: explanation.pageEnrichment.status,
      derived: evaluated.projection?.derived ?? {},
      rules: explanation.packagizer?.rules ?? [],
      ...(evaluated.failure?.code === undefined ? {} : { failureCode: evaluated.failure.code }),
      ...(evaluated.failure?.ruleId === undefined ? {} : { failureRuleId: evaluated.failure.ruleId }),
    }) as PackagizerPreviewResult;
  }
}
</file>

<file path="src/evaluation/service.ts">
import { freezeJsonValue } from '../core/index.ts';
import { requireImmutableWatchSessionRecord, type ImmutableWatchSessionRecord } from '../definitions/index.ts';
import type { PageFieldSnapshotService } from '../page-fields/index.ts';
import type { PackagizerPageContext } from '../packagizer/index.ts';
import type {
  JsonRecordRepository,
  ResourceObservationRecord,
  WatchSessionRecord,
} from '../persistence/index.ts';
import { RESOURCE_EVALUATION_ERROR_CODES, ResourceEvaluationError } from './errors.ts';
import { evaluateResourceCandidate } from './evaluator.ts';
import type { ResourceEvaluationResult, ResourcePageEnrichmentExplanation } from './types.ts';

/** Load durable authority, prepare exact page enrichment when configured, then delegate to the shared pure evaluator. */
export class ResourceEvaluationService {
  readonly #sessions: JsonRecordRepository<WatchSessionRecord>;
  readonly #pageFields: PageFieldSnapshotService | undefined;

  constructor(
    sessions: JsonRecordRepository<WatchSessionRecord>,
    pageFields?: PageFieldSnapshotService,
  ) {
    this.#sessions = sessions;
    this.#pageFields = pageFields;
  }

  async #session(observation: ResourceObservationRecord) {
    const stored = await this.#sessions.get(observation.watchSessionId);
    if (stored === undefined) {
      throw new ResourceEvaluationError(
        RESOURCE_EVALUATION_ERROR_CODES.sessionNotFound,
        `WatchSession ${observation.watchSessionId} is unavailable for resource evaluation`,
      );
    }
    return requireImmutableWatchSessionRecord(stored);
  }

  async #evaluate(
    observation: ResourceObservationRecord,
    options: { readonly persistPageSnapshot: boolean; readonly page?: PackagizerPageContext },
  ): Promise<ResourceEvaluationResult> {
    const session = await this.#session(observation);
    if (options.page !== undefined || this.#pageFields === undefined) {
      return evaluateResourceCandidate({
        session,
        observation,
        ...(options.page === undefined ? {} : { page: options.page }),
      });
    }
    const enrichment = await this.#pageFields.prepare(
      session,
      observation,
      { persist: options.persistPageSnapshot },
    );
    const pageEnrichment: ResourcePageEnrichmentExplanation = freezeJsonValue({
      status: enrichment.status,
      ...(enrichment.snapshotId === undefined ? {} : { snapshotId: enrichment.snapshotId }),
      ...(enrichment.persisted === undefined ? {} : { persisted: enrichment.persisted }),
    });
    return evaluateResourceCandidate({
      session,
      observation,
      ...(enrichment.page === undefined ? {} : { page: enrichment.page }),
      pageEnrichment,
    });
  }

  async evaluateObservation(
    observation: ResourceObservationRecord,
    page?: PackagizerPageContext,
  ): Promise<ResourceEvaluationResult> {
    return this.#evaluate(observation, { persistPageSnapshot: true, ...(page === undefined ? {} : { page }) });
  }

  /** Preview uses the same PageFieldSnapshot builder and pure evaluator, but does not create new durable page-value history. */
  async previewObservation(observation: ResourceObservationRecord): Promise<ResourceEvaluationResult> {
    return this.#evaluate(observation, { persistPageSnapshot: false });
  }

  /** Preview an observation against an explicitly supplied transient frozen WatchSession. */
  async previewWithSession(
    sessionInput: ImmutableWatchSessionRecord,
    observation: ResourceObservationRecord,
  ): Promise<ResourceEvaluationResult> {
    const session = requireImmutableWatchSessionRecord(sessionInput);
    if (session.id !== observation.watchSessionId) {
      throw new ResourceEvaluationError(
        RESOURCE_EVALUATION_ERROR_CODES.sessionMismatch,
        'Preview observation must be rebound to the supplied transient WatchSession',
      );
    }
    if (this.#pageFields === undefined) return evaluateResourceCandidate({ session, observation });
    const enrichment = await this.#pageFields.prepare(session, observation, { persist: false });
    const pageEnrichment: ResourcePageEnrichmentExplanation = freezeJsonValue({
      status: enrichment.status,
      ...(enrichment.snapshotId === undefined ? {} : { snapshotId: enrichment.snapshotId }),
      ...(enrichment.persisted === undefined ? {} : { persisted: enrichment.persisted }),
    });
    return evaluateResourceCandidate({
      session,
      observation,
      ...(enrichment.page === undefined ? {} : { page: enrichment.page }),
      pageEnrichment,
    });
  }
}
